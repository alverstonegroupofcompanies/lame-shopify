{%- liquid
  assign section_bg = section.settings.background_color_code | strip
  if section_bg == blank
    assign section_bg = section.settings.background_color
  endif
  if section_bg == blank or section_bg == 'transparent' or section_bg == 'rgba(0,0,0,0)'
    assign section_bg = 'linear-gradient(180deg, #2b0354 0%, #3d0873 50%, #240246 100%)'
  endif

  assign container_bg = section.settings.container_background_code | default: section.settings.container_background
  if container_bg == blank or container_bg == 'transparent' or container_bg == 'rgba(0,0,0,0)'
    assign container_bg = ''
  endif

  assign heading_image = section.settings.heading_image
  assign heading_image_mobile = section.settings.heading_image_mobile
  assign heading_image_asset = section.settings.heading_image_asset | strip
  assign heading_alt = section.settings.heading | default: 'Diwali Sales - Exclusive Offer'

  assign show_heading_mobile = true
  if section.settings.show_heading_image_mobile == false
    assign show_heading_mobile = false
  endif

  assign use_heading_image = false
  if heading_image != blank or heading_image_mobile != blank or heading_image_asset != blank
    assign use_heading_image = true
  endif

  assign title_full_width = true
  if section.settings.heading_image_full_width == false
    assign title_full_width = false
  endif

  assign title_mobile_full_width = true
  if section.settings.heading_image_mobile_full_width == false
    assign title_mobile_full_width = false
  endif

  assign animated_border = true
  if section.settings.enable_animated_border == false
    assign animated_border = false
  endif
  assign border_width = section.settings.border_width | default: 3

  assign products_url = '/collections/all'
  if routes.all_products_collection_url != blank
    assign products_url = routes.all_products_collection_url
  endif
  if section.settings.products_collection != blank and section.settings.products_collection.url != blank
    assign products_url = section.settings.products_collection.url
  endif

  assign block_count = section.blocks.size | at_least: 1 | at_most: 4
  assign mobile_layout = section.settings.mobile_layout | default: 'grid-2'
-%}

{{ 'lame-diwali-posters.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}" style="background: {{ section_bg }} !important;"></div>
<section
  class="section section--full-width color-{{ section.settings.color_scheme }} lame-diwali-posters{% if title_full_width %} lame-diwali-posters--title-full-width{% endif %}{% if title_mobile_full_width %} lame-diwali-posters--title-mobile-full-width{% endif %}{% if animated_border %} lame-diwali-posters--animated{% endif %}"
  style="--diwali-section-bg: {{ section_bg }}; --poster-cols: {{ block_count }}; --poster-border-width: {{ border_width }}px;"
  {{ section.shopify_attributes }}
>
  {%- if use_heading_image or section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.subheading != blank -%}
    <header class="lame-diwali-posters__header force-full-width{% if use_heading_image %} lame-diwali-posters__header--has-banner{% endif %}{% if title_full_width %} lame-diwali-posters__header--full-width{% endif %}{% if title_mobile_full_width %} lame-diwali-posters__header--mobile-full-width{% endif %}">
      {%- if use_heading_image -%}
        <div class="lame-diwali-posters__title-banner{% unless show_heading_mobile %} lame-diwali-posters__title-banner--hide-mobile{% endunless %}{% if title_full_width %} lame-diwali-posters__title-banner--full-width{% endif %}{% if title_mobile_full_width %} lame-diwali-posters__title-banner--mobile-full-width{% endif %}">
          {%- if section.settings.title_banner_link != blank -%}
            <a
              href="{{ section.settings.title_banner_link }}"
              class="lame-diwali-posters__title-link"
              aria-label="{{ heading_alt | escape }}"
            >
          {%- endif -%}

          <picture class="lame-diwali-posters__title-picture">
            {%- if heading_image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ heading_image_mobile | image_url: width: 750 }} 1x, {{ heading_image_mobile | image_url: width: 1500 }} 2x"
              >
            {%- endif -%}

            {%- if heading_image != blank -%}
              {{
                heading_image
                | image_url: width: 3840
                | image_tag:
                  class: 'lame-diwali-posters__title-img',
                  loading: 'lazy',
                  widths: '750, 990, 1200, 1600, 1920, 2560, 3840',
                  sizes: '100vw',
                  alt: heading_alt
              }}
            {%- elsif heading_image_asset != blank -%}
              <img
                class="lame-diwali-posters__title-img"
                src="{{ heading_image_asset | asset_url }}"
                alt="{{ heading_alt | escape }}"
                width="1920"
                height="auto"
                loading="lazy"
                decoding="async"
              >
            {%- elsif heading_image_mobile != blank -%}
              {{
                heading_image_mobile
                | image_url: width: 1500
                | image_tag:
                  class: 'lame-diwali-posters__title-img',
                  loading: 'lazy',
                  widths: '375, 550, 750, 990, 1200, 1500',
                  sizes: '100vw',
                  alt: heading_alt
              }}
            {%- endif -%}
          </picture>

          {%- if section.settings.title_banner_link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="lame-diwali-posters__header-text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="lame-diwali-posters__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            {% render 'lame-section-heading',
              title: section.settings.heading,
              subtitle: section.settings.subheading,
              alignment: 'center',
              size: 'large'
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>
  {%- endif -%}

  <div class="lame-diwali-posters__body force-full-width" style="background: {{ section_bg }};">
    <div class="lame-diwali-posters__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
      <div
        class="lame-diwali-posters__container{% if container_bg != blank %} lame-diwali-posters__container--boxed{% endif %}"
        style="{% if container_bg != blank %}background-color: {{ container_bg }};{% endif %}{% if section.settings.container_radius > 0 %}border-radius: {{ section.settings.container_radius }}px;{% endif %}"
      >
        <div
          class="lame-diwali-posters__grid lame-diwali-posters__grid--mobile-{{ mobile_layout }}"
          data-posters-grid
          style="--poster-radius: {{ section.settings.card_radius | default: 14 }}px;"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign poster_image = block.settings.image
              assign poster_image_mobile = block.settings.image_mobile
              assign fallback_asset = block.settings.fallback_asset | strip
              assign poster_alt = block.settings.alt | default: block.settings.title | default: section.settings.heading | default: 'Diwali Sale Offer'
              assign poster_link = block.settings.link
              assign poster_badge = block.settings.badge | strip
              assign poster_title = block.settings.title | strip
              assign poster_subtitle = block.settings.subtitle | strip
              assign poster_cta = block.settings.button_label | strip

              assign brand_other = block.settings.brand_other | strip
              assign brand_name = block.settings.brand | strip
              if brand_name == 'other'
                assign brand_name = ''
              endif
              if brand_other != blank
                assign brand_name = brand_other
              endif

              assign discount_keys = ''
              if block.settings.discount_0_10
                assign discount_keys = discount_keys | append: '|0-10'
              endif
              if block.settings.discount_10_20
                assign discount_keys = discount_keys | append: '|10-20'
              endif
              if block.settings.discount_20_30
                assign discount_keys = discount_keys | append: '|20-30'
              endif
              if block.settings.discount_30_40
                assign discount_keys = discount_keys | append: '|30-40'
              endif
              if block.settings.discount_40_50
                assign discount_keys = discount_keys | append: '|40-50'
              endif
              if block.settings.discount_50_60
                assign discount_keys = discount_keys | append: '|50-60'
              endif

              assign discount_param = discount_keys | remove_first: '|' | replace: '|', ','

              assign brand_slug = ''
              if brand_name != blank
                capture brand_slug_capture
                  render 'lame-vendor-slug', vendor: brand_name
                endcapture
                assign brand_slug = brand_slug_capture | strip
              endif

              if brand_name != blank and discount_param != blank
                assign poster_link = products_url | append: '?brand=' | append: brand_slug | append: '&discount=' | append: discount_param
              elsif brand_name != blank
                assign poster_link = products_url | append: '?brand=' | append: brand_slug
              elsif discount_param != blank
                assign poster_link = products_url | append: '?discount=' | append: discount_param
              else
                assign poster_link = block.settings.link
              endif

              assign raw_label = block.settings.alt
              if raw_label == blank
                assign raw_label = block.settings.title
              endif
              if raw_label == blank
                assign raw_label = section.settings.heading
              endif
              if raw_label == blank
                assign raw_label = 'Diwali Sale Offer'
              endif

              assign card_aria_label = raw_label | strip
              assign label_prefix = card_aria_label | slice: 0, 5 | downcase

              if label_prefix == 'shop '
                assign card_aria_label = card_aria_label
              elsif card_aria_label contains 'offer on '
                assign category_name = card_aria_label | split: 'offer on ' | last | strip
                assign card_aria_label = 'Shop ' | append: category_name | append: ' offers'
              elsif card_aria_label contains 'Offer on '
                assign category_name = card_aria_label | split: 'Offer on ' | last | strip
                assign card_aria_label = 'Shop ' | append: category_name | append: ' offers'
              elsif card_aria_label contains ' - '
                assign category_name = card_aria_label | split: ' - ' | last | strip
                assign card_aria_label = 'Shop ' | append: category_name
              else
                assign card_aria_label = 'Shop ' | append: card_aria_label
              endif
            -%}

            {%- if poster_link != blank -%}
              <a
                href="{{ poster_link }}"
                class="lame-diwali-poster-card{% if animated_border %} lame-diwali-poster-card--animated-border{% endif %}"
                {{ block.shopify_attributes }}
                aria-label="{{ card_aria_label | escape }}"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
              >
            {%- else -%}
              <article
                class="lame-diwali-poster-card{% if animated_border %} lame-diwali-poster-card--animated-border{% endif %}"
                {{ block.shopify_attributes }}
              >
            {%- endif -%}

              <div class="lame-diwali-poster-card__media">
                {%- if poster_badge != blank -%}
                  <span class="lame-diwali-poster-card__badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {{ poster_badge }}
                  </span>
                {%- endif -%}

                <picture class="lame-diwali-poster-card__picture">
                  {%- if poster_image_mobile != blank -%}
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ poster_image_mobile | image_url: width: 550 }} 1x, {{ poster_image_mobile | image_url: width: 900 }} 2x"
                    >
                  {%- endif -%}

                  {%- if poster_image != blank -%}
                    {{
                      poster_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'lame-diwali-poster-card__img',
                        loading: 'lazy',
                        widths: '360,540,720,900',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        alt: poster_alt
                    }}
                  {%- elsif fallback_asset != blank -%}
                    <img
                      class="lame-diwali-poster-card__img"
                      src="{{ fallback_asset | asset_url }}"
                      alt="{{ poster_alt | escape }}"
                      loading="lazy"
                      width="819"
                      height="1024"
                    >
                  {%- elsif poster_image_mobile != blank -%}
                    {{
                      poster_image_mobile
                      | image_url: width: 900
                      | image_tag:
                        class: 'lame-diwali-poster-card__img',
                        loading: 'lazy',
                        widths: '360,540,720,900',
                        sizes: '50vw',
                        alt: poster_alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'lame-diwali-poster-card__img' }}
                  {%- endif -%}
                </picture>
              </div>

              {%- if poster_title != blank or poster_subtitle != blank or poster_cta != blank -%}
                <div class="lame-diwali-poster-card__overlay">
                  {%- if poster_title != blank -%}
                    <h3 class="lame-diwali-poster-card__title">{{ poster_title }}</h3>
                  {%- endif -%}
                  {%- if poster_subtitle != blank -%}
                    <p class="lame-diwali-poster-card__subtitle">{{ poster_subtitle }}</p>
                  {%- endif -%}
                  {%- if poster_cta != blank -%}
                    <span class="lame-diwali-poster-card__cta">{{ poster_cta }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- if poster_link != blank -%}
              </a>
            {%- else -%}
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 and mobile_layout == 'carousel' -%}
          <div class="lame-diwali-posters__dots" aria-hidden="true" data-posters-dots>
            {%- for block in section.blocks -%}
              <span class="lame-diwali-posters__dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const grid = section.querySelector('[data-posters-grid]');
    const dots = section.querySelectorAll('[data-posters-dots] .lame-diwali-posters__dot');
    if (!grid || !dots.length) return;

    const updateDots = () => {
      const scrollLeft = grid.scrollLeft;
      const cardWidth = grid.querySelector('.lame-diwali-poster-card')?.offsetWidth || 1;
      const activeIdx = Math.round(scrollLeft / (cardWidth + 12));
      dots.forEach((dot, idx) => {
        dot.classList.toggle('is-active', idx === activeIdx);
      });
    };

    grid.addEventListener('scroll', updateDots, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Diwali Sale Posters",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Title Banner (Desktop & Mobile)"
    },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "Desktop banner image",
      "info": "Wide horizontal title banner (~1920×237px). Leave empty to use the default Diwali Sales banner."
    },
    {
      "type": "image_picker",
      "id": "heading_image_mobile",
      "label": "Mobile banner image",
      "info": "Upload a different banner image specifically for mobile screens (up to 749px). If empty, the desktop banner is shown."
    },
    {
      "type": "checkbox",
      "id": "show_heading_image_mobile",
      "label": "Show title banner on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "heading_image_full_width",
      "label": "Full width on desktop (edge-to-edge)",
      "info": "Stretches banner edge-to-edge across the full screen width.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "heading_image_mobile_full_width",
      "label": "Full width on mobile (edge-to-edge)",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_image_asset",
      "label": "Default theme asset filename",
      "info": "Optional theme asset filename."
    },
    {
      "type": "url",
      "id": "title_banner_link",
      "label": "Title banner link (optional)"
    },
    {
      "type": "header",
      "content": "Fallback Text Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Banner alt text / Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "header",
      "content": "Diwali Sale Animated Border & Cards"
    },
    {
      "type": "checkbox",
      "id": "enable_animated_border",
      "label": "Enable animated festive border on cards",
      "info": "Adds a small animated golden festive shimmer border around the Diwali Sale cards.",
      "default": true
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Animated border thickness",
      "default": 3
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 14
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile cards layout",
      "options": [
        { "value": "grid-2", "label": "2 per row (2×2 grid)" },
        { "value": "grid-4", "label": "All in 1 row" },
        { "value": "carousel", "label": "Swipeable carousel" }
      ],
      "default": "grid-2"
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Products page for brand/discount links",
      "info": "Cards with a vendor or discount filter open this collection. Defaults to Our Products."
    },
    {
      "type": "header",
      "content": "Layout & Colors"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Cards container width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#2b0354"
    },
    {
      "type": "text",
      "id": "background_color_code",
      "label": "Custom section background code (hex/rgb/gradient)",
      "default": "linear-gradient(180deg, #2b0354 0%, #3d0873 50%, #240246 100%)",
      "info": "Overrides the color picker if specified. E.g. #2b0354 or a CSS gradient."
    },
    {
      "type": "color",
      "id": "container_background",
      "label": "Boxed container background"
    },
    {
      "type": "text",
      "id": "container_background_code",
      "label": "Custom container background code (hex/rgb)",
      "info": "E.g. #5a4b81 or rgba(90,75,129,0.15) for a framed backdrop"
    },
    {
      "type": "range",
      "id": "container_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Container corner radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section spacing (below title banner)"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "poster",
      "name": "Diwali Offer Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Offer card image (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Offer card image (Mobile, optional)",
          "info": "Optional dedicated mobile image for this card. Leave empty to use the main card image."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Theme asset filename",
