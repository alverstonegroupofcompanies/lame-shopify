{%- liquid
  assign use_theme_asset = false
  if section.settings.video == blank
    assign use_theme_asset = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-home-video-spotlight"
  {{ section.shopify_attributes }}
>
  <div class="lame-home-video-spotlight__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="lame-home-video-spotlight__header" data-lame-reveal>
        {% if section.settings.eyebrow != blank %}
          <p class="lame-home-video-spotlight__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="lame-home-video-spotlight__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div
      class="lame-home-video-spotlight__card"
      data-lame-reveal
      style="--lame-video-spotlight-max-width: {{ section.settings.max_width }}px;"
    >
      <div
        class="lame-home-video-spotlight__frame"
        style="--lame-video-spotlight-aspect: {{ section.settings.aspect_ratio }};"
      >
        {%- if use_theme_asset -%}
          <video
            class="lame-home-video-spotlight__video"
            src="{{ 'lame-home-spotlight.mp4' | asset_url }}"
            playsinline
            muted
            loop
            autoplay
            preload="metadata"
            {% if section.settings.video_description != blank %}
              aria-label="{{ section.settings.video_description | escape }}"
            {% endif %}
          ></video>
        {%- else -%}
          {{
            section.settings.video
            | video_tag:
              class: 'lame-home-video-spotlight__video',
              image_size: '600x',
              autoplay: true,
              loop: true,
              muted: true,
              controls: false,
              playsinline: true,
              preload: 'metadata'
          }}
        {%- endif -%}

        <button
          type="button"
          class="lame-home-video-spotlight__sound"
          aria-label="{{ 'accessibility.play_video' | t | default: 'Unmute video' }}"
          hidden
        >
          <span class="lame-home-video-spotlight__sound-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" width="18" height="18">
              <path d="M11 5 6 9H3v6h3l5 4V5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M15.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M18 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
        </button>
      </div>

      {% if section.settings.caption != blank %}
        <p class="lame-home-video-spotlight__caption">{{ section.settings.caption | escape }}</p>
      {% endif %}

      {% if section.settings.link != blank and section.settings.link_label != blank %}
        <a
          class="lame-home-video-spotlight__link"
          href="{{ section.settings.link }}"
          {% if section.settings.open_in_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {{ section.settings.link_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if (revealNodes.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }

    const video = section.querySelector('.lame-home-video-spotlight__video');
    const soundBtn = section.querySelector('.lame-home-video-spotlight__sound');
    if (!video || !soundBtn) return;

    const syncSoundButton = () => {
      soundBtn.hidden = !video.muted;
    };

    soundBtn.addEventListener('click', () => {
      video.muted = false;
      video.volume = 1;
      syncSoundButton();
    });

    video.addEventListener('volumechange', syncSoundButton);
    syncSoundButton();
  })();
</script>

{% stylesheet %}
  .lame-home-video-spotlight__wrap {
    padding-inline: var(--page-margin);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .lame-home-video-spotlight__header {
    text-align: center;
    max-width: 28rem;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .lame-home-video-spotlight__header.is-visible {
    opacity: 1;
    transform: none;
  }

  .lame-home-video-spotlight__eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .lame-home-video-spotlight__heading {
    margin: 0;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-home-video-spotlight__card {
    width: min(100%, var(--lame-video-spotlight-max-width, 280px));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.55s ease 0.05s, transform 0.55s ease 0.05s;
  }

  .lame-home-video-spotlight__card.is-visible {
    opacity: 1;
    transform: none;
  }

  .lame-home-video-spotlight__frame {
    position: relative;
    width: 100%;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.08);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    aspect-ratio: var(--lame-video-spotlight-aspect, 9 / 16);
  }

  .lame-home-video-spotlight__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    vertical-align: middle;
  }

  .lame-home-video-spotlight__sound {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 999px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: #fff;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(6px);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .lame-home-video-spotlight__sound:hover {
    background: rgb(0 0 0 / 0.62);
    transform: scale(1.04);
  }

  .lame-home-video-spotlight__caption {
    margin: 0;
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.62);
    max-width: 22rem;
  }

  .lame-home-video-spotlight__link {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb));
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    padding-bottom: 0.1rem;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .lame-home-video-spotlight__link:hover {
    border-color: currentColor;
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home video spotlight",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Behind the brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A glimpse of LAMÉ"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Optional. Leave empty to use the built-in homepage spotlight video."
    },
    {
      "type": "text",
      "id": "video_description",
      "label": "Video description (accessibility)",
      "default": "LAMÉ brand spotlight video"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": ""
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the collection"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Video max width",
      "min": 200,
      "max": 480,
      "step": 20,
      "unit": "px",
      "default": 280
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "value": "9 / 16", "label": "Vertical (9:16)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Home video spotlight",
      "category": "Media"
    }
  ]
}
{% endschema %}
