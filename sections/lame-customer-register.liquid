{%- liquid
  capture return_url
    render 'lame-customer-auth-return-url'
  endcapture

  assign encoded_return = return_url | url_encode
  assign register_return = routes.account_register_url | append: '?registered=1&return_url=' | append: encoded_return
  assign address_step_return = register_return | append: '&step=address'

  capture login_url
    render 'lame-customer-auth-url', type: 'login'
  endcapture

  assign page_title = section.settings.heading
  if page_title == blank
    assign page_title = 'lame_customer.auth_register_title' | t
  endif

  assign page_subtitle = section.settings.subheading

  assign completing_registration = false
  if customer
    if request.params.registered == '1' or request.params.step == 'address'
      assign completing_registration = true
    endif
  endif
-%}

{% if routes.account_login_url contains 'customer_authentication' and request.design_mode == false %}
  {%- capture register_redirect_url -%}{%- render 'lame-customer-auth-url', type: 'register' -%}{%- endcapture -%}
  <script>window.location.replace({{ register_redirect_url | json }});</script>
{% elsif customer and customer.addresses.size > 0 and request.design_mode == false %}
  <script>window.location.replace({{ return_url | json }});</script>
{% else %}

{%- capture auth_body -%}
  {% if completing_registration %}
    <div class="lame-auth__completing" data-lame-registration-complete aria-live="polite">
      <div class="lame-auth__spinner" aria-hidden="true"></div>
      <p class="lame-auth__completing-text">{{ 'lame_customer.auth_completing' | t }}</p>
    </div>

    <div hidden data-lame-registration-forms>
      {%- form 'customer', id: 'LameRegistrationPhoneForm', class: 'lame-profile__form', return_to: address_step_return -%}
        <input type="hidden" name="customer[first_name]" value="{{ customer.first_name | escape }}">
        <input type="hidden" name="customer[last_name]" value="{{ customer.last_name | escape }}">
        <input type="hidden" name="customer[email]" value="{{ customer.email | escape }}">
        <input type="tel" name="customer[phone]" id="LameRegPhone" class="lame-profile__input">
      {%- endform -%}

      {%- form 'customer_address', customer.new_address, id: 'LameRegistrationAddressForm', class: 'lame-profile__form', return_to: return_url -%}
        <input type="hidden" name="address[first_name]" id="LameRegAddrFirstName" value="{{ customer.first_name | escape }}">
        <input type="hidden" name="address[last_name]" id="LameRegAddrLastName" value="{{ customer.last_name | escape }}">
        <input type="hidden" name="address[address1]" id="LameRegAddrAddress1">
        <input type="hidden" name="address[address2]" id="LameRegAddrAddress2">
        <input type="hidden" name="address[city]" id="LameRegAddrCity">
        <input type="hidden" name="address[zip]" id="LameRegAddrZip">
        <input type="hidden" name="address[country]" id="LameRegAddrCountry">
        <input type="hidden" name="address[province]" id="LameRegAddrProvince">
        <input type="hidden" name="address[phone]" id="LameRegAddrPhone">
        <input type="hidden" name="address[default]" id="LameRegAddrDefault" value="1">
      {%- endform -%}
    </div>

    <script>
      window.LameAuthConfig = window.LameAuthConfig || {};
      window.LameAuthConfig.returnUrl = {{ return_url | json }};
      window.LameAuthConfig.completeRegistration = true;
    </script>
  {% else %}
    <div data-lame-register-step>
      {%- form 'create_customer', return_to: register_return, class: 'lame-profile__form lame-auth__form', id: 'LameCreateCustomerForm' -%}
        {%- if form.errors -%}
          <div class="lame-profile__message lame-profile__message--error" tabindex="-1" autofocus role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="lame-profile__message lame-profile__message--error" data-lame-register-errors hidden role="alert"></div>

        <fieldset class="lame-auth__fieldset">
          <legend class="lame-auth__legend">{{ 'lame_customer.auth_account_heading' | t }}</legend>

          <div class="lame-profile__field-row">
            <div class="lame-profile__field">
              <label for="RegisterFirstName">{{ 'customer.addresses.first_name' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="RegisterFirstName"
                name="customer[first_name]"
                value="{{ form.first_name }}"
                autocomplete="given-name"
                class="lame-profile__input"
                required
                aria-required="true"
              >
            </div>
            <div class="lame-profile__field">
              <label for="RegisterLastName">{{ 'customer.addresses.last_name' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="RegisterLastName"
                name="customer[last_name]"
                value="{{ form.last_name }}"
                autocomplete="family-name"
                class="lame-profile__input"
                required
                aria-required="true"
              >
            </div>
          </div>

          <div class="lame-profile__field">
            <label for="RegisterEmail">{{ 'customer.login_page.email' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="RegisterEmail"
              name="customer[email]"
              value="{{ form.email }}"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              class="lame-profile__input"
              required
              aria-required="true"
            >
          </div>

          <div class="lame-profile__field">
            <label for="RegisterPhone">{{ 'customer.addresses.phone' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="RegisterPhone"
              data-lame-reg-field="phone"
              autocomplete="tel"
              class="lame-profile__input"
              required
              aria-required="true"
            >
          </div>

          <div class="lame-profile__field">
            <label for="RegisterPassword">{{ 'lame_customer.auth_password' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
            <input
              type="password"
              id="RegisterPassword"
              name="customer[password]"
              autocomplete="new-password"
              class="lame-profile__input"
              minlength="5"
              required
              aria-required="true"
              aria-describedby="RegisterPasswordHint"
            >
            <p id="RegisterPasswordHint" class="lame-auth__hint">{{ 'lame_customer.auth_password_hint' | t }}</p>
          </div>
        </fieldset>

        {% render 'lame-customer-register-address-fields', prefix: 'Signup' %}

        <div class="lame-profile__form-actions lame-auth__actions">
          <button type="submit" class="button lame-profile__btn-primary lame-auth__submit">
            {{ 'lame_customer.auth_create_account' | t }}
          </button>
        </div>
      {%- endform -%}

      <p class="lame-auth__footer">
        {{ 'lame_customer.auth_have_account_html' | t: link: login_url }}
      </p>
    </div>

    <script>
      window.LameAuthConfig = window.LameAuthConfig || {};
      window.LameAuthConfig.returnUrl = {{ return_url | json }};
    </script>
  {% endif %}
{%- endcapture -%}

{% render 'lame-customer-auth-shell',
  page_title: page_title,
  page_subtitle: page_subtitle,
  body: auth_body,
  section: section
%}

{% endif %}

{% schema %}
{
  "name": "Customer register",
  "tag": "section",
  "class": "lame-customer-register-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create your account"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join us to manage orders, saved addresses, and your profile."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-golden"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Customer register"
    }
  ]
}
{% endschema %}
