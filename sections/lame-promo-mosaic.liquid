<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="lame-promo-mosaic spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <header class="lame-promo-mosaic__header" data-lame-reveal>
        <h2 class="lame-promo-mosaic__title">{{ section.settings.heading }}</h2>
      </header>
    {% endif %}
    <div class="lame-promo-mosaic__grid">
      {% for block in section.blocks %}
        {% liquid
          assign tile_image = block.settings.image
          assign tile_link = block.settings.link
        %}
        <a
          class="lame-promo-mosaic__tile"
          href="{{ tile_link | default: routes.collections_url }}"
          data-lame-reveal
          data-lame-delay="{{ forloop.index0 | modulo: 3 }}"
          {{ block.shopify_attributes }}
        >
          {% if tile_image %}
            {{
              tile_image
              | image_url: width: 1200
              | image_tag:
                class: 'lame-promo-mosaic__image',
                loading: 'lazy',
                widths: '300,480,720,960,1200',
                sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 45vw, 90vw'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'lame-promo-mosaic__image placeholder-svg' }}
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if (!revealNodes.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -10% 0px' }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-promo-mosaic {
    width: 100%;
  }

  .lame-promo-mosaic__header {
    text-align: center;
    margin-bottom: clamp(0.65rem, 1.6vw, 1rem);
  }

  .lame-promo-mosaic__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-promo-mosaic__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .lame-promo-mosaic__tile {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(var(--brand-gold) / 0.08);
    border: 1px solid rgb(var(--brand-gold) / 0.35);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    text-decoration: none;
    color: inherit;
  }

  .lame-promo-mosaic__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .lame-promo-mosaic .lame-promo-mosaic__tile:is(:hover, :focus-visible) {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgb(18 18 18 / 0.1);
    border-color: rgb(var(--brand-gold) / 0.62);
  }

  .lame-promo-mosaic .lame-promo-mosaic__tile:is(:hover, :focus-visible) .lame-promo-mosaic__image {
    transform: scale(1.03);
  }

  @media screen and (min-width: 750px) {
    .lame-promo-mosaic__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-promo-mosaic__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Promo Mosaic",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Signature Collection"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "image_tile",
      "name": "Image tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Promo Mosaic",
      "blocks": [
        { "type": "image_tile" },
        { "type": "image_tile" },
        { "type": "image_tile" }
      ]
    }
  ]
}
{% endschema %}
