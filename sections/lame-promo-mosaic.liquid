<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="lame-promo-mosaic spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="lame-promo-mosaic__grid">
      {% for i in (1..7) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign link_key = 'link_' | append: i
          assign tile_image = section.settings[image_key]
          assign tile_link = section.settings[link_key]
        %}
        <a
          class="lame-promo-mosaic__tile"
          href="{{ tile_link | default: routes.collections_url }}"
          data-lame-reveal
          data-lame-delay="{{ forloop.index0 | modulo: 3 }}"
        >
          {% if tile_image %}
            {{
              tile_image
              | image_url: width: 1200
              | image_tag:
                class: 'lame-promo-mosaic__image',
                loading: 'lazy',
                widths: '300,480,720,960,1200',
                sizes: '(min-width: 1200px) 28vw, (min-width: 750px) 45vw, 90vw'
            }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'lame-promo-mosaic__image placeholder-svg' }}
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if (!revealNodes.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -10% 0px' }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-promo-mosaic {
    max-width: var(--page-width);
    margin-inline: auto;
  }

  .lame-promo-mosaic__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .lame-promo-mosaic__tile {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: rgb(var(--brand-gold) / 0.08);
    border: 1px solid rgb(var(--brand-gold) / 0.35);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
    text-decoration: none;
    color: inherit;
  }

  .lame-promo-mosaic__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .lame-promo-mosaic .lame-promo-mosaic__tile:is(:hover, :focus-visible) {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgb(18 18 18 / 0.1);
    border-color: rgb(var(--brand-gold) / 0.62);
  }

  .lame-promo-mosaic .lame-promo-mosaic__tile:is(:hover, :focus-visible) .lame-promo-mosaic__image {
    transform: scale(1.03);
  }

  @media screen and (min-width: 750px) {
    .lame-promo-mosaic__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-promo-mosaic__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Promo Mosaic",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "url", "id": "link_1", "label": "Image 1 link" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "url", "id": "link_2", "label": "Image 2 link" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "url", "id": "link_3", "label": "Image 3 link" },
    { "type": "image_picker", "id": "image_4", "label": "Image 4" },
    { "type": "url", "id": "link_4", "label": "Image 4 link" },
    { "type": "image_picker", "id": "image_5", "label": "Image 5" },
    { "type": "url", "id": "link_5", "label": "Image 5 link" },
    { "type": "image_picker", "id": "image_6", "label": "Image 6" },
    { "type": "url", "id": "link_6", "label": "Image 6 link" },
    { "type": "image_picker", "id": "image_7", "label": "Image 7" },
    { "type": "url", "id": "link_7", "label": "Image 7 link" },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Lame Promo Mosaic"
    }
  ]
}
{% endschema %}
