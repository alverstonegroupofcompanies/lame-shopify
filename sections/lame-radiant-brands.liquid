{%- comment -%}
  Lamé Radiant Top Brands Section
  Matches the luxury organic aesthetic: botanical leaf header dividers,
  floating pill brand logo strip with vertical dividers, and bottom leaf motif.
{%- endcomment -%}

<section
  id="LameRadiantBrands-{{ section.id }}"
  class="section lame-radiant-brands color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  style="
    {% render 'spacing-padding', settings: section.settings %}
  "
  {{ section.shopify_attributes }}
>
  <div class="lame-radiant-brands__container">
    <!-- Header with Botanical Leaf Accents & Dividers -->
    <div class="lame-radiant-brands__header">
      <div class="lame-radiant-brands__header-line" aria-hidden="true"></div>
      <div class="lame-radiant-brands__header-badge">
        <span class="lame-radiant-brands__header-leaf" aria-hidden="true">
          <svg viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 11C4 11 5.5 5 11 3C11 3 10.5 8 6 10.5C5.2 11 4.5 11 4 11Z" fill="#245437"/>
            <path d="M9 7C11 4.5 15 2 18 3C18 3 17 8 13 9.5C11.5 10 10.2 9.5 9 7Z" fill="#3D7D54"/>
          </svg>
        </span>
        <h2 class="lame-radiant-brands__title">
          {{ section.settings.heading | default: 'TOP BRANDS' }}
        </h2>
        <span class="lame-radiant-brands__header-leaf" aria-hidden="true">
          <svg viewBox="0 0 20 14" fill="none" xmlns="http://www.w3.org/2000/svg" style="transform: scaleX(-1);">
            <path d="M4 11C4 11 5.5 5 11 3C11 3 10.5 8 6 10.5C5.2 11 4.5 11 4 11Z" fill="#245437"/>
            <path d="M9 7C11 4.5 15 2 18 3C18 3 17 8 13 9.5C11.5 10 10.2 9.5 9 7Z" fill="#3D7D54"/>
          </svg>
        </span>
      </div>
      <div class="lame-radiant-brands__header-line" aria-hidden="true"></div>
    </div>

    <!-- Floating Pill Brand Container -->
    <div class="lame-radiant-brands__pill-card">
      <!-- Left Arrow -->
      <button
        type="button"
        class="lame-radiant-brands__arrow lame-radiant-brands__arrow--prev"
        data-radiant-brand-prev
        aria-label="Previous brands"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <!-- Scrollable Brands Viewport -->
      <div class="lame-radiant-brands__viewport" data-radiant-brand-viewport>
        <div class="lame-radiant-brands__track" data-radiant-brand-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign brand_title = block.settings.title
              assign brand_link = block.settings.link
              if brand_link == blank and brand_title != blank
                assign brand_link = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: brand_title | url_encode
              endif
            -%}
            <div class="lame-radiant-brands__item" {{ block.shopify_attributes }}>
              {%- if brand_link != blank -%}
                <a href="{{ brand_link }}" class="lame-radiant-brands__link" aria-label="{{ brand_title }}">
                  {% render 'lame-radiant-brand-logos', brand: brand_title, image: block.settings.image %}
                </a>
              {%- else -%}
                <div class="lame-radiant-brands__link">
                  {% render 'lame-radiant-brand-logos', brand: brand_title, image: block.settings.image %}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Right Arrow -->
      <button
        type="button"
        class="lame-radiant-brands__arrow lame-radiant-brands__arrow--next"
        data-radiant-brand-next
        aria-label="Next brands"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- if section.settings.show_bottom_flourish -%}
      <!-- Bottom Botanical Leaf Accent & Hairline Divider -->
      <div class="lame-radiant-brands__bottom-flourish" aria-hidden="true">
        <span class="lame-radiant-brands__flourish-line"></span>
        <span class="lame-radiant-brands__flourish-leaf">
          <svg viewBox="0 0 28 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M14 2C11 5.5 11 11 14 14C17 11 17 5.5 14 2Z" fill="#245437"/>
            <path d="M9 7C6.5 8 5 10.5 6 12.5C7.5 12 10 10.5 10.5 9L9 7Z" fill="#3D7D54"/>
            <path d="M19 7C21.5 8 23 10.5 22 12.5C20.5 12 18 10.5 17.5 9L19 7Z" fill="#3D7D54"/>
          </svg>
        </span>
        <span class="lame-radiant-brands__flourish-line"></span>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lame-radiant-brands {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .lame-radiant-brands__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (min-width: 1200px) {
    .lame-radiant-brands__container {
      padding: 0 2.5rem;
    }
  }

  /* Header with Dividers & Leaves */
  .lame-radiant-brands__header {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 900px;
    margin-bottom: 1.4rem;
    gap: 1.25rem;
  }

  .lame-radiant-brands__header-line {
    flex: 1;
    height: 1px;
    background: #D9D3C7;
  }

  .lame-radiant-brands__header-badge {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex: 0 0 auto;
  }

  .lame-radiant-brands__header-leaf {
    display: flex;
    align-items: center;
    width: 18px;
    height: 14px;
  }

  .lame-radiant-brands__header-leaf svg {
    width: 100%;
    height: 100%;
  }

  .lame-radiant-brands__title {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #153828;
    line-height: 1;
  }

  /* Floating Pill Brand Card */
  .lame-radiant-brands__pill-card {
    background: #ffffff;
    border-radius: 9999px;
    box-shadow: 0 10px 32px rgba(22, 45, 33, 0.07), 0 2px 8px rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(222, 218, 209, 0.7);
    display: flex;
    align-items: center;
    width: 100%;
    padding: 0.75rem 1.25rem;
    position: relative;
  }

  @media screen and (min-width: 990px) {
    .lame-radiant-brands__pill-card {
      padding: 0.85rem 1.8rem;
    }
  }

  /* Circular Arrow Buttons */
  .lame-radiant-brands__arrow {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid rgba(215, 210, 200, 0.85);
    color: #4A554E;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    z-index: 3;
    padding: 0;
  }

  .lame-radiant-brands__arrow svg {
    width: 18px;
    height: 18px;
  }

  .lame-radiant-brands__arrow:hover {
    transform: scale(1.08);
    background: #FAF8F5;
    border-color: #245437;
    color: #153828;
    box-shadow: 0 4px 14px rgba(21, 56, 40, 0.12);
  }

  /* Viewport & Track */
  .lame-radiant-brands__viewport {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    padding: 0 0.5rem;
  }

  .lame-radiant-brands__viewport::-webkit-scrollbar {
    display: none;
  }

  .lame-radiant-brands__track {
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
    margin: 0;
    padding: 0.25rem 0.5rem;
    min-width: max-content;
  }

  @media screen and (min-width: 990px) {
    .lame-radiant-brands__track {
      min-width: 100%;
      justify-content: space-around;
    }
  }

  /* Brand Item with Vertical Dividers */
  .lame-radiant-brands__item {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 1.25rem;
    position: relative;
    min-width: 130px;
  }

  @media screen and (min-width: 990px) {
    .lame-radiant-brands__item {
      padding: 0.5rem 1.8rem;
    }
  }

  /* Vertical Hairline Divider between items */
  .lame-radiant-brands__item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 20%;
    height: 60%;
    width: 1px;
    background: #E5DFC8;
    opacity: 0.85;
  }

  .lame-radiant-brands__link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    width: 100%;
    height: 100%;
    min-height: 48px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .lame-radiant-brands__link:hover {
    transform: translateY(-2px);
    opacity: 0.88;
  }

  .lame-radiant-brand__img {
    max-height: 44px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.02));
  }

  .lame-radiant-brand__text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #245437;
    white-space: nowrap;
  }

  /* Bottom Botanical Flourish */
  .lame-radiant-brands__bottom-flourish {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 280px;
    margin-top: 2rem;
    color: #245437;
  }

  .lame-radiant-brands__flourish-line {
    flex: 1;
    height: 1px;
    background: #D9D3C7;
  }

  .lame-radiant-brands__flourish-leaf {
    padding: 0 0.75rem;
    display: flex;
    align-items: center;
  }

  .lame-radiant-brands__flourish-leaf svg {
    width: 24px;
    height: 16px;
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('LameRadiantBrands-{{ section.id }}');
    if (!section) return;

    const viewport = section.querySelector('[data-radiant-brand-viewport]');
    const prevBtn = section.querySelector('[data-radiant-brand-prev]');
    const nextBtn = section.querySelector('[data-radiant-brand-next]');
    if (!viewport) return;

    const getScrollStep = () => {
      return viewport.clientWidth * 0.65 || 260;
    };

    prevBtn?.addEventListener('click', () => {
      viewport.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', () => {
      viewport.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Radiant Top Brands",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TOP BRANDS"
    },
    {
      "type": "checkbox",
      "id": "show_bottom_flourish",
      "label": "Show bottom leaf flourish divider",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Brand name",
          "default": "Dove",
          "info": "Used for alt text and default icon matching (Dove, Ponds, Pears, FemiSafe, Jovees, Sebamed)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom logo image (optional override)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand collection URL (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Radiant Top Brands",
      "category": "Brand",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "title": "Dove"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "POND'S"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "Pears"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "FemiSafe"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "JOVEES"
          }
        },
        {
          "type": "brand",
          "settings": {
            "title": "sebamed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
