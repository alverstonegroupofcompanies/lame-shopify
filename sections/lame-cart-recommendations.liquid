{% liquid
  assign rec_collection = collections[section.settings.collection]
  if rec_collection == blank
    assign rec_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cart-recommendations"
  data-cart-rec-carousel
  {{ section.shopify_attributes }}
>
  <div class="lame-cart-recommendations__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-cart-recommendations__header">
      <h2 class="lame-cart-recommendations__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_view_all and rec_collection != blank -%}
        <a href="{{ rec_collection.url }}" class="lame-cart-recommendations__view-all">
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </header>

    <div class="lame-cart-rec-carousel">
      <button
        type="button"
        class="lame-cart-rec-carousel__nav lame-cart-rec-carousel__nav--prev"
        data-cart-rec-prev
        aria-label="{{ 'lame_cart.carousel_prev' | t }}"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>

      <div class="lame-cart-rec-carousel__viewport" data-cart-rec-viewport>
        <ul class="lame-cart-rec-carousel__track" role="list" data-cart-rec-track>
          {%- for product in rec_collection.products limit: section.settings.products_to_show -%}
            {%- liquid
              assign badge_type = ''
              if forloop.first and section.settings.mark_first_bestseller
                assign badge_type = 'bestseller'
              endif
            -%}
            <li class="lame-cart-rec-carousel__slide">
              {% render 'lame-cart-rec-card',
                product: product,
                badge_type: badge_type,
                add_to_cart_label: section.settings.add_to_cart_label
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <button
        type="button"
        class="lame-cart-rec-carousel__nav lame-cart-rec-carousel__nav--next"
        data-cart-rec-next
        aria-label="{{ 'lame_cart.carousel_next' | t }}"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </div>
</section>

{% render 'lame-cart-trust-bar' %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const viewport = section.querySelector('[data-cart-rec-viewport]');
    const track = section.querySelector('[data-cart-rec-track]');
    const prev = section.querySelector('[data-cart-rec-prev]');
    const next = section.querySelector('[data-cart-rec-next]');
    if (!viewport || !track) return;

    const scrollBySlide = (dir) => {
      const slide = track.querySelector('.lame-cart-rec-carousel__slide');
      if (!slide) return;
      const gap = parseFloat(getComputedStyle(track).gap) || 16;
      viewport.scrollBy({ left: dir * (slide.offsetWidth + gap), behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => scrollBySlide(-1));
    next?.addEventListener('click', () => scrollBySlide(1));

    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          window.location.href = '{{ routes.cart_url }}';
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cart recommendations",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "mark_first_bestseller",
      "label": "Mark first product as Bestseller",
      "default": true
    },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": false },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding-block-start", "label": "Top padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Cart recommendations", "category": "Products" }]
}
{% endschema %}
