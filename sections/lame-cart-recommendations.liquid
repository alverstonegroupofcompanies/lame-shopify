{% liquid
  assign rec_collection = collections[section.settings.collection]
  if rec_collection == blank
    assign rec_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cart-recommendations"
  {{ section.shopify_attributes }}
>
  <div class="lame-cart-recommendations__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-cart-recommendations__header">
      <h2 class="lame-cart-recommendations__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.show_view_all and rec_collection != blank -%}
        <a href="{{ rec_collection.url }}" class="lame-cart-recommendations__view-all">
          {{ section.settings.view_all_label }}
        </a>
      {%- endif -%}
    </header>

    <ul class="lame-cart-recommendations__grid" role="list">
      {%- for product in rec_collection.products limit: section.settings.products_to_show -%}
        <li class="lame-cart-recommendations__item">
          {% render 'lame-home-product-card',
            product: product,
            card_style: 'grid',
            show_sale_badge: true,
            show_type: true,
            show_rating: false,
            show_add_to_cart: section.settings.show_add_to_cart,
            add_to_cart_label: section.settings.add_to_cart_label
          %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', { bubbles: true, detail: { resource: cartData, sourceId: '{{ section.id }}' } })
          );
          window.location.href = '{{ routes.cart_url }}';
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cart recommendations",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_add_to_cart",
      "label": "Show add to cart",
      "default": true
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Cart recommendations",
      "category": "Products"
    }
  ]
}
{% endschema %}
