<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div
    class="lame-brand-logos spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --brand-logo-height: {{ section.settings.logo_height }}px;
      --brand-logo-gap: {{ section.settings.logo_gap }}px;
      --brand-logo-speed: {{ section.settings.scroll_speed }}s;
      --brand-logo-direction: {{ section.settings.scroll_direction }};
    "
  >
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-brand-logos__header">
        {% if section.settings.heading != blank %}
          <h2 class="lame-brand-logos__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lame-brand-logos__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="lame-brand-logos__track-outer">
      <div class="lame-brand-logos__track">
        {% for i in (1..2) %}
          <div class="lame-brand-logos__group" aria-hidden="{% if i == 2 %}true{% else %}false{% endif %}">
            {% for block in section.blocks %}
              {% assign logo_image = block.settings.image %}
              {% assign logo_alt = block.settings.alt | default: shop.name %}
              <div class="lame-brand-logos__item" {{ block.shopify_attributes }}>
                {% if logo_image %}
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}" class="lame-brand-logos__logo-link">
                      {{
                        logo_image
                        | image_url: width: 480
                        | image_tag:
                          class: 'lame-brand-logos__logo-image',
                          loading: 'lazy',
                          widths: '140,200,280,360,480',
                          sizes: '(min-width: 990px) 180px, (min-width: 750px) 140px, 110px',
                          alt: logo_alt
                      }}
                    </a>
                  {% else %}
                    {{
                      logo_image
                      | image_url: width: 480
                      | image_tag:
                        class: 'lame-brand-logos__logo-image',
                        loading: 'lazy',
                        widths: '140,200,280,360,480',
                        sizes: '(min-width: 990px) 180px, (min-width: 750px) 140px, 110px',
                        alt: logo_alt
                    }}
                  {% endif %}
                {% elsif request.design_mode %}
                  <div class="lame-brand-logos__placeholder">Add Logo</div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-brand-logos__header {
    text-align: center;
    margin-bottom: var(--padding-md);
  }

  .lame-brand-logos__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-brand-logos__subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 60ch;
    margin-inline: auto;
  }

  .lame-brand-logos__track-outer {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, black 8%, black 92%, transparent 100%);
  }

  .lame-brand-logos__track {
    display: flex;
    width: max-content;
    gap: var(--brand-logo-gap);
  }

  .lame-brand-logos__group {
    display: flex;
    align-items: center;
    gap: var(--brand-logo-gap);
    min-width: max-content;
  }

  .lame-brand-logos__item {
    width: clamp(100px, 16vw, 190px);
    height: var(--brand-logo-height);
    display: grid;
    place-items: center;
  }

  .lame-brand-logos__logo-link {
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .lame-brand-logos__logo-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: saturate(0.95);
    opacity: 0.95;
    transition: opacity 180ms ease;
  }

  .lame-brand-logos__logo-link:hover .lame-brand-logos__logo-image {
    opacity: 1;
  }

  .lame-brand-logos__placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed rgb(var(--color-border-rgb) / 0.4);
    color: rgb(var(--color-foreground-rgb) / 0.65);
    font-size: 0.72rem;
    display: grid;
    place-items: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lame-brand-logos__track {
      animation: lame-brand-logos-loop var(--brand-logo-speed) linear infinite var(--brand-logo-direction);
    }

    .lame-brand-logos__track-outer:hover .lame-brand-logos__track {
      animation-play-state: paused;
    }
  }

  @keyframes lame-brand-logos-loop {
    to {
      transform: translateX(calc(-50% - (var(--brand-logo-gap) / 2)));
    }
  }

  @media screen and (max-width: 749px) {
    .lame-brand-logos {
      --brand-logo-height: calc(var(--brand-logo-height) * 0.8);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Brand Logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands We Work With"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted brand partners whose products we proudly sell."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 8,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "s",
      "default": 36
    },
    {
      "type": "select",
      "id": "scroll_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "normal", "label": "Right to left" },
        { "value": "reverse", "label": "Left to right" }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Brand Logos",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
