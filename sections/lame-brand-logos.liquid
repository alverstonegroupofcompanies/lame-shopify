<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div
    class="lame-brand-logos spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --brand-logo-height: {{ section.settings.logo_height }}px;
      --brand-logo-gap: {{ section.settings.logo_gap }}px;
    "
  >
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-brand-logos__header">
        {% if section.settings.heading != blank %}
          <h2 class="lame-brand-logos__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lame-brand-logos__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="lame-brand-logos__row">
      {% for block in section.blocks %}
        {% assign logo_image = block.settings.image %}
        {% assign logo_alt = block.settings.alt | default: shop.name %}
        {% comment %} Skip empty slots on the storefront so the grid stays a clean 3-per-row {% endcomment %}
        {% if logo_image == blank and request.design_mode == false %}
          {% continue %}
        {% endif %}
        <div class="lame-brand-logos__item" {{ block.shopify_attributes }}>
          {% if logo_image %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="lame-brand-logos__logo-link">
                {{
                  logo_image
                  | image_url: width: 480
                  | image_tag:
                    class: 'lame-brand-logos__logo-image',
                    loading: 'lazy',
                    widths: '120,160,200,280,360,480',
                    sizes: '(min-width: 750px) 20vw, 28vw',
                    alt: logo_alt
                }}
              </a>
            {% else %}
              <span class="lame-brand-logos__logo-wrap">
                {{
                  logo_image
                  | image_url: width: 480
                  | image_tag:
                    class: 'lame-brand-logos__logo-image',
                    loading: 'lazy',
                    widths: '120,160,200,280,360,480',
                    sizes: '(min-width: 750px) 20vw, 28vw',
                    alt: logo_alt
                }}
              </span>
            {% endif %}
          {% elsif request.design_mode %}
            <div class="lame-brand-logos__placeholder">Add Logo</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-brand-logos {
    width: 100%;
    overflow: hidden;
  }

  .lame-brand-logos__header {
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .lame-brand-logos__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(0.82rem, 1.6vw, 1.05rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .lame-brand-logos__subtitle {
    margin: 0.25rem 0 0;
    font-size: 0.72rem;
    line-height: 1.35;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 42ch;
    margin-inline: auto;
  }

  .lame-brand-logos__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: center;
    align-items: center;
    gap: var(--brand-logo-gap);
    width: 100%;
    max-width: min(640px, 100%);
    margin-inline: auto;
    padding-inline: clamp(4px, 2vw, 12px);
  }

  .lame-brand-logos__item {
    width: 100%;
    max-width: 100%;
    height: var(--brand-logo-height);
    max-height: var(--brand-logo-height);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px 4px;
    overflow: hidden;
    box-sizing: border-box;
  }

  .lame-brand-logos__logo-link,
  .lame-brand-logos__logo-wrap {
    display: flex;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    align-items: center;
    justify-content: center;
  }

  .lame-brand-logos__logo-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    object-position: center;
    filter: saturate(0.95);
    opacity: 0.95;
    transition: opacity 180ms ease;
  }

  .lame-brand-logos__logo-link:hover .lame-brand-logos__logo-image {
    opacity: 1;
  }

  .lame-brand-logos__placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed rgb(var(--color-border-rgb) / 0.4);
    color: rgb(var(--color-foreground-rgb) / 0.65);
    font-size: 0.72rem;
    display: grid;
    place-items: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media screen and (max-width: 749px) {
    .lame-brand-logos__row {
      gap: clamp(6px, 2vw, var(--brand-logo-gap));
    }

    .lame-brand-logos {
      --brand-logo-height: min(var(--brand-logo-height), clamp(32px, 9vw, 44px));
    }

    .lame-brand-logos__item {
      padding: 2px;
    }
  }
{% endstylesheet %}

{% style %}
  #shopify-section-{{ section.id }} {
    flex-grow: 0;
  }
{% endstyle %}

{% schema %}
{
  "name": "Lame Brand Logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands We Work With"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted brand partners whose products we proudly sell."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 8,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Brand Logos",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
