<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div
    class="lame-brand-logos spacing-style"
    style="
      {% render 'spacing-padding', settings: section.settings %}
      --brand-logo-height: {{ section.settings.logo_height }}px;
      --brand-logo-gap: {{ section.settings.logo_gap }}px;
      --brand-header-gap: clamp(0.85rem, 2.2vw, 1.35rem);
    "
  >
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-brand-logos__header">
        {% if section.settings.heading != blank %}
          <h2 class="lame-brand-logos__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lame-brand-logos__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="lame-brand-logos__row">
      {% for block in section.blocks %}
        {% assign logo_image = block.settings.image %}
        {% assign logo_alt = block.settings.alt | default: shop.name %}
        {% comment %} Skip empty slots on the storefront so the grid stays a clean 3-per-row {% endcomment %}
        {% if logo_image == blank and request.design_mode == false %}
          {% continue %}
        {% endif %}
        <div class="lame-brand-logos__item" {{ block.shopify_attributes }}>
          {% if logo_image %}
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="lame-brand-logos__logo-link">
                {{
                  logo_image
                  | image_url: width: 480
                  | image_tag:
                    class: 'lame-brand-logos__logo-image',
                    loading: 'lazy',
                    widths: '120,160,200,280,360,480',
                    sizes: '(min-width: 750px) 28vw, 30vw',
                    alt: logo_alt
                }}
              </a>
            {% else %}
              {{
                logo_image
                | image_url: width: 480
                | image_tag:
                  class: 'lame-brand-logos__logo-image',
                  loading: 'lazy',
                  widths: '120,160,200,280,360,480',
                  sizes: '(min-width: 750px) 28vw, 30vw',
                  alt: logo_alt
              }}
            {% endif %}
          {% elsif request.design_mode %}
            <div class="lame-brand-logos__placeholder">Add Logo</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-brand-logos {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--brand-header-gap, clamp(0.85rem, 2.2vw, 1.35rem));
  }

  .lame-brand-logos__header {
    text-align: center;
    margin-bottom: 0;
  }

  .lame-brand-logos__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-brand-logos__subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 60ch;
    margin-inline: auto;
  }

  .lame-brand-logos__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: stretch;
    align-items: center;
    gap: var(--brand-logo-gap);
    row-gap: clamp(12px, 2.5vw, var(--brand-logo-gap));
    width: 100%;
    max-width: min(920px, 100%);
    margin-inline: auto;
    padding-inline: clamp(0px, 2vw, 8px);
  }

  .lame-brand-logos__item {
    width: 100%;
    max-width: none;
    min-height: var(--brand-logo-height);
    height: var(--brand-logo-height);
    display: grid;
    place-items: center;
    padding: 4px 6px;
    border: none;
    border-radius: 0;
    background: transparent;
    box-sizing: border-box;
  }

  .lame-brand-logos__logo-link {
    display: inline-flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .lame-brand-logos__logo-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: saturate(0.95);
    opacity: 0.95;
    transition: opacity 180ms ease;
  }

  .lame-brand-logos__logo-link:hover .lame-brand-logos__logo-image {
    opacity: 1;
  }

  .lame-brand-logos__placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed rgb(var(--color-border-rgb) / 0.4);
    color: rgb(var(--color-foreground-rgb) / 0.65);
    font-size: 0.72rem;
    display: grid;
    place-items: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media screen and (max-width: 749px) {
    .lame-brand-logos__row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(8px, 2.5vw, 16px);
    }

    .lame-brand-logos {
      --brand-logo-height: clamp(36px, 11vw, calc(var(--brand-logo-height) * 0.55));
    }

    .lame-brand-logos__item {
      padding: 4px 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Brand Logos",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Brands We Work With"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Trusted brand partners whose products we proudly sell."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Gap between logos",
      "min": 8,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Brand link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Brand Logos",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
