{%- liquid
  assign banner_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign banner_alt = section.settings.image_alt | default: shop.name | escape
  assign mobile_ratio = section.settings.mobile_ratio | default: '2/1'
  assign mobile_focus_x = section.settings.mobile_focus_x | default: 50
  assign use_theme_asset = false

  if banner_image == blank
    assign use_theme_asset = true
  endif

  assign img_loading = 'lazy'
  if section.index == 1
    assign img_loading = 'eager'
  endif
-%}

<section
  id="lame-trust-banner-{{ section.id }}"
  class="section section--full-width lame-trust-banner lame-trust-banner--{{ section.id }}{% if section.settings.full_bleed %} lame-trust-banner--bleed{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-trust-banner__wrap">
    {%- if section.settings.link != blank -%}
      <a
        href="{{ section.settings.link }}"
        class="lame-trust-banner__link"
        {% if section.settings.open_in_new_tab %}
          target="_blank"
          rel="noopener"
        {% endif %}
      >
    {%- endif -%}

    {%- if use_theme_asset -%}
      {%- if mobile_image != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 360 }} 360w,
              {{ mobile_image | image_url: width: 540 }} 540w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1080 }} 1080w
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
          <img
            src="{{ 'lame-trust-banner.png' | asset_url }}"
            class="lame-trust-banner__image"
            alt="{{ banner_alt }}"
            width="1920"
            height="auto"
            loading="{{ img_loading }}"
            decoding="async"
          >
        </picture>
      {%- else -%}
        <img
          src="{{ 'lame-trust-banner.png' | asset_url }}"
          class="lame-trust-banner__image"
          alt="{{ banner_alt }}"
          width="1920"
          height="auto"
          loading="{{ img_loading }}"
          decoding="async"
        >
      {%- endif -%}
    {%- else -%}
      {%- if mobile_image != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 360 }} 360w,
              {{ mobile_image | image_url: width: 540 }} 540w,
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1080 }} 1080w
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
          {{
            banner_image
            | image_url: width: 3840
            | image_tag:
              class: 'lame-trust-banner__image',
              loading: img_loading,
              widths: '750, 990, 1200, 1600, 1920, 2560, 3840',
              sizes: '100vw',
              alt: banner_alt
          }}
        </picture>
      {%- else -%}
        {{
          banner_image
          | image_url: width: 3840
          | image_tag:
            class: 'lame-trust-banner__image',
            loading: img_loading,
            widths: '750, 990, 1200, 1600, 1920, 2560, 3840',
            sizes: '100vw',
            alt: banner_alt
        }}
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.link != blank -%}
      </a>
    {%- endif -%}
  </div>
</section>

{%- if mobile_image == blank and mobile_ratio != 'original' -%}
  <style>
    @media screen and (max-width: 749px) {
      .lame-trust-banner--{{ section.id }} .lame-trust-banner__image {
        width: 100%;
        aspect-ratio: {{ mobile_ratio }};
        object-fit: cover;
        object-position: {{ mobile_focus_x }}% center;
      }
    }
  </style>
{%- endif -%}

{% stylesheet %}
  .shopify-section:has(.lame-trust-banner) {
    width: 100%;
    max-width: none;
  }

  .lame-trust-banner {
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .lame-trust-banner__wrap {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    line-height: 0;
    overflow: hidden;
  }

  .lame-trust-banner__link {
    display: block;
    width: 100%;
    line-height: 0;
    text-decoration: none;
  }

  .lame-trust-banner__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    border: none;
    border-radius: 0;
    box-shadow: none;
    object-fit: contain;
    object-position: center center;
  }

  .shopify-section:has(.lame-trust-banner--bleed) {
    width: 100%;
    max-width: none;
    padding: 0;
    margin-inline: 0;
  }

  .lame-trust-banner--bleed .lame-trust-banner__wrap,
  .lame-trust-banner--bleed .lame-trust-banner__image {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding: 0;
    border-radius: 0;
  }

  @media screen and (min-width: 990px) {
    body.template-index .lame-trust-banner.lame-trust-banner--bleed.section--full-width > .lame-trust-banner__wrap {
      width: 100% !important;
      max-width: none !important;
      margin-inline: 0 !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust banner (full width)",
  "tag": "section",
  "class": "section-wrapper section-wrapper--full-width",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Leave empty to use the built-in LAMÉ trust banner. Recommended: wide image (~1920×400px or similar)."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner image",
      "info": "Optional. Recommended 1080x720 px. Shown on phones instead of the desktop image."
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Mobile height (when no mobile image)",
      "default": "2/1",
      "options": [
        {
          "value": "original",
          "label": "Original"
        },
        {
          "value": "2/1",
          "label": "2:1"
        },
        {
          "value": "16/9",
          "label": "16:9"
        },
        {
          "value": "4/3",
          "label": "4:3"
        }
      ]
    },
    {
      "type": "range",
      "id": "mobile_focus_x",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Mobile focus (left to right)",
      "default": 50
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Optional. Describe the banner for accessibility."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link",
      "info": "Optional. Makes the whole banner clickable."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full width",
      "info": "Stretch the image to both edges of the screen.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Trust banner (full width)",
      "category": "Banners"
    }
  ]
}
{% endschema %}
