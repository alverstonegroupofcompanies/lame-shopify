{% liquid
  assign col_handle = section.settings.collection
  if col_handle == blank or col_handle == 'all'
    assign col_handle = 'our-products'
  endif

  assign bestseller_collection = collections[col_handle]
  if bestseller_collection == blank or bestseller_collection.products.size == 0
    if collections['our-products'] != blank and collections['our-products'].products.size > 0
      assign bestseller_collection = collections['our-products']
    elsif collections['all'] != blank and collections['all'].products.size > 0
      assign bestseller_collection = collections['all']
    endif
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank
    assign view_all_url = bestseller_collection.url
  endif
  if view_all_url == blank
    assign view_all_url = routes.all_products_collection_url
  endif

  assign products_limit = section.settings.products_to_show | default: 8
  assign pool_limit = 32

  assign brand_filter_str = section.settings.brand_filter | downcase | strip
  assign brand_filters = brand_filter_str | split: ','

  assign candidate_products = bestseller_collection.products
  if section.settings.sort_by == 'price_desc' and section.settings.randomize_on_refresh != true
    assign candidate_products = candidate_products | sort: 'price' | reverse
  elsif section.settings.sort_by == 'price_asc' and section.settings.randomize_on_refresh != true
    assign candidate_products = candidate_products | sort: 'price'
  endif
%}

{% capture pool_markup %}
  {% assign pool_count = 0 %}
  {% assign seen_ids = '||' %}

  {%- comment -%} 1. Merchant-selected manual product blocks {%- endcomment -%}
  {% for block in section.blocks %}
    {% if block.settings.product != blank %}
      {% assign p = block.settings.product %}
      {% assign p_token = '||' | append: p.id | append: '||' %}
      {% unless seen_ids contains p_token %}
        {% assign seen_ids = seen_ids | append: p.id | append: '||' %}
        <li class="lame-flash-deal__item" data-lame-reveal data-best-seller-item {{ block.shopify_attributes }}>
          {% render 'lame-flash-deal-card',
            product: p,
            badge_label: section.settings.offer_badge_text,
            add_to_cart_label: section.settings.add_to_cart_label,
            sold_out_label: section.settings.sold_out_label
          %}
        </li>
        {% assign pool_count = pool_count | plus: 1 %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {%- comment -%} 2. Real products from collection (with brand filter if configured) {%- endcomment -%}
  {% for product in candidate_products %}
    {% if pool_count >= pool_limit %}{% break %}{% endif %}
    {% assign p_token = '||' | append: product.id | append: '||' %}
    {% if seen_ids contains p_token %}{% continue %}{% endif %}

    {% assign matches_brand = true %}
    {% if brand_filter_str != blank %}
      {% assign matches_brand = false %}
      {% assign p_vendor = product.vendor | downcase | strip %}
      {% assign p_title = product.title | downcase %}
      {% for brand_token in brand_filters %}
        {% assign b_clean = brand_token | strip %}
        {% if b_clean != blank %}
          {% if p_vendor contains b_clean or p_title contains b_clean %}
            {% assign matches_brand = true %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if matches_brand %}
      {% assign seen_ids = seen_ids | append: product.id | append: '||' %}
      <li class="lame-flash-deal__item" data-lame-reveal data-best-seller-item>
        {% render 'lame-flash-deal-card',
          product: product,
          badge_label: section.settings.offer_badge_text,
          add_to_cart_label: section.settings.add_to_cart_label,
          sold_out_label: section.settings.sold_out_label
        %}
      </li>
      {% assign pool_count = pool_count | plus: 1 %}
    {% endif %}
  {% endfor %}

  {%- comment -%} 3. Fallback to all products from candidate collection if brand filter yielded no products {%- endcomment -%}
  {% if pool_count == 0 and candidate_products.size > 0 %}
    {% for product in candidate_products %}
      {% if pool_count >= pool_limit %}{% break %}{% endif %}
      {% assign p_token = '||' | append: product.id | append: '||' %}
      {% if seen_ids contains p_token %}{% continue %}{% endif %}
      {% assign seen_ids = seen_ids | append: product.id | append: '||' %}
      <li class="lame-flash-deal__item" data-lame-reveal data-best-seller-item>
        {% render 'lame-flash-deal-card',
          product: product,
          badge_label: section.settings.offer_badge_text,
          add_to_cart_label: section.settings.add_to_cart_label,
          sold_out_label: section.settings.sold_out_label
        %}
      </li>
      {% assign pool_count = pool_count | plus: 1 %}
    {% endfor %}
  {% endif %}

  {%- comment -%} 4. Fill from our-products collection if pool is small {%- endcomment -%}
  {% if pool_count < pool_limit and collections['our-products'] != blank and collections['our-products'].products.size > 0 %}
    {% for product in collections['our-products'].products %}
      {% if pool_count >= pool_limit %}{% break %}{% endif %}
      {% assign p_token = '||' | append: product.id | append: '||' %}
      {% if seen_ids contains p_token %}{% continue %}{% endif %}
      {% assign seen_ids = seen_ids | append: product.id | append: '||' %}
      <li class="lame-flash-deal__item" data-lame-reveal data-best-seller-item>
        {% render 'lame-flash-deal-card',
          product: product,
          badge_label: section.settings.offer_badge_text,
          add_to_cart_label: section.settings.add_to_cart_label,
          sold_out_label: section.settings.sold_out_label
        %}
      </li>
      {% assign pool_count = pool_count | plus: 1 %}
    {% endfor %}
  {% endif %}
{% endcapture %}

{{ 'lame-flash-deal.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal lame-best-sellers"
  data-flash-deal-carousel
  style="--lame-flash-visible-count: {{ products_limit | at_least: 1 }};"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-flash-deal__header" data-lame-reveal>
        {% render 'lame-section-heading',
          title: section.settings.heading,
          subtitle: section.settings.subheading,
          alignment: 'center',
          size: 'large'
        %}
      </header>
    {% endif %}

    <div class="lame-flash-deal__carousel">
      <button
        type="button"
        class="lame-flash-deal__nav lame-flash-deal__nav--prev"
        data-flash-prev
        aria-label="{{ section.settings.prev_label | default: 'Previous products' }}"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>

      <div class="lame-flash-deal__viewport" data-flash-viewport>
        <ul class="lame-flash-deal__track" role="list" data-flash-track>
          {% if pool_count > 0 %}
            {{ pool_markup }}
          {% else %}
            {%- comment -%} Catalog placeholder fallback if store has 0 products {%- endcomment -%}
            {% for i in (1..products_limit) %}
              <li class="lame-flash-deal__item" data-lame-reveal>
                <article class="lame-flash-card">
                  <div class="lame-flash-card__media">
                    <span class="lame-flash-card__badge">BESTSELLER</span>
                    <a href="#" class="lame-flash-card__media-link" tabindex="-1" aria-hidden="true">
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-flash-card__image placeholder-svg' }}
                    </a>
                  </div>
                  <div class="lame-flash-card__body">
                    <h3 class="lame-flash-card__title">
                      <a href="#">Featured Product</a>
                    </h3>
                    <div class="lame-flash-card__price-row">
                      <span class="lame-flash-card__price">₹899</span>
                    </div>
                    <div class="lame-flash-card__actions">
                      <button type="button" class="lame-flash-card__atc" disabled>
                        {{ section.settings.add_to_cart_label | default: 'Add to cart' }}
                      </button>
                    </div>
                  </div>
                </article>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <button
        type="button"
        class="lame-flash-deal__nav lame-flash-deal__nav--next"
        data-flash-next
        aria-label="{{ section.settings.next_label | default: 'Next products' }}"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>

    {% if section.settings.view_all_label != blank and view_all_url != blank %}
      <p class="lame-best-sellers__view-all">
        <a href="{{ view_all_url }}" class="lame-best-sellers__view-all-link">
          {{ section.settings.view_all_label }} &rarr;
        </a>
      </p>
    {% endif %}
  </div>
</section>

<style>
  .lame-best-sellers [data-lame-reveal] {
    opacity: 1 !important;
    transform: none !important;
    visibility: visible !important;
  }
  .lame-best-sellers .lame-flash-deal__carousel {
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
  }
  .lame-best-sellers__view-all {
    margin: 1.5rem 0 0;
    text-align: center;
  }
  .lame-best-sellers__view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--lame-flash-sale-accent, #ff5722);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .lame-best-sellers__view-all-link:hover {
    color: var(--lame-flash-sale-accent-dark, #e64a19);
    transform: translateX(3px);
  }
</style>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}') || document.querySelector('.lame-best-sellers');
    if (!section) return;

    const track = section.querySelector('[data-flash-track]');
    const viewport = section.querySelector('[data-flash-viewport]');
    const prevBtn = section.querySelector('[data-flash-prev]');
    const nextBtn = section.querySelector('[data-flash-next]');
    if (!track) return;

    const shouldRandomize = {{ section.settings.randomize_on_refresh | default: true }};
    const maxToShow = {{ products_limit | default: 8 }};

    const shuffleProducts = () => {
      const items = Array.from(track.querySelectorAll('[data-best-seller-item]'));
      if (items.length <= 1) return;

      // Fisher-Yates true random shuffle on every refresh / page load
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const temp = items[i];
        items[i] = items[j];
        items[j] = temp;
      }

      const selected = items.slice(0, maxToShow);
      const discarded = items.slice(maxToShow);

      // Re-order selected items in the track
      selected.forEach((item) => {
        track.appendChild(item);
      });

      // Remove surplus items from track so carousel displays exactly maxToShow items
      discarded.forEach((item) => {
        item.remove();
      });
    };

    if (shouldRandomize) {
      shuffleProducts();
    }

    // Reveal elements with IntersectionObserver + instant failsafe
    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.05 }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }
    setTimeout(() => {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }, 300);

    // Carousel arrow navigation
    if (viewport && prevBtn && nextBtn) {
      const getScrollAmount = () => {
        const card = track.querySelector('.lame-flash-deal__item');
        return card ? card.offsetWidth + 16 : 240;
      };
      prevBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: -getScrollAmount() * 2, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        viewport.scrollBy({ left: getScrollAmount() * 2, behavior: 'smooth' });
      });
    }

    // Ajax add to cart handler (matches lame-flash-deal & lame-new-products)
    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        const formData = new FormData(form);
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { resource: cartData, sourceId: '{{ section.id }}', data: { source: 'best-sellers-atc' } },
            })
          );
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Best sellers",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index", "collection"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select collection to draw best sellers from. Defaults to All Products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "randomize_on_refresh",
      "label": "Randomize products on each page refresh",
      "default": true,
      "info": "Picks and shuffles random products from the store on every refresh."
    },
    {
      "type": "text",
      "id": "brand_filter",
      "label": "Filter by brand / vendor (optional)",
      "info": "Optional comma-separated list of brand names. Leave blank to show all brands."
    },
    {
      "type": "select",
      "id": "sort_by",
      "label": "Sort products by (when randomization is disabled)",
      "options": [
        { "value": "default", "label": "Collection default order" },
        { "value": "price_desc", "label": "Price: High to low" },
        { "value": "price_asc", "label": "Price: Low to high" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "offer_badge_text",
      "label": "Offer badge text override",
      "info": "Leave blank to automatically show item discount percentage."
    },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All Best Sellers" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "prev_label", "label": "Previous arrow label", "default": "Previous products" },
    { "type": "text", "id": "next_label", "label": "Next arrow label", "default": "Next products" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Featured Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best sellers",
      "category": "Products",
      "settings": {
        "heading": "",
        "subheading": "",
        "collection": "our-products",
        "products_to_show": 8,
        "randomize_on_refresh": true
      }
    }
  ]
}
{% endschema %}
