<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="lame-premium-split spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="lame-premium-split__card" data-lame-reveal>
      <div class="lame-premium-split__media" data-lame-reveal data-lame-delay="1">
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'lame-premium-split__image',
              loading: 'lazy',
              widths: '400,700,960,1200,1400',
              sizes: '(min-width: 990px) 42vw, 94vw'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'lame-premium-split__image placeholder-svg' }}
        {% endif %}
      </div>

      <div
        class="lame-premium-split__content"
        data-lame-reveal
        data-lame-delay="2"
        style="
          --split-panel-bg: {{ section.settings.panel_background }};
          --split-accent: {{ section.settings.accent_color }};
        "
      >
        {% if section.settings.eyebrow != blank %}
          <p class="lame-premium-split__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="lame-premium-split__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="lame-premium-split__description rte">{{ section.settings.description }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a
            class="lame-premium-split__button"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if (!revealNodes.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.2, rootMargin: '0px 0px -10% 0px' }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-premium-split__card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgb(var(--brand-gold) / 0.28);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 14px 30px rgb(20 20 20 / 0.08);
    transition: transform 420ms cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 420ms ease;
    background: rgb(var(--color-background-rgb));
  }

  .lame-premium-split__media {
    min-height: clamp(220px, 36vw, 380px);
  }

  .lame-premium-split__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .lame-premium-split__content {
    background: var(--split-panel-bg);
    padding: clamp(1rem, 2.8vw, 1.65rem);
    display: grid;
    align-content: center;
    gap: 0.68rem;
  }

  .lame-premium-split__eyebrow {
    margin: 0;
    font-size: 0.68rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--split-accent);
    font-weight: 600;
  }

  .lame-premium-split__heading {
    margin: 0;
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    line-height: 1.08;
    color: rgb(var(--color-foreground-rgb));
    max-width: 16ch;
  }

  .lame-premium-split__description {
    margin: 0;
    font-size: 0.9rem;
    color: rgb(var(--color-foreground-rgb) / 0.78);
    max-width: 42ch;
  }

  .lame-premium-split__description p {
    margin: 0;
  }

  .lame-premium-split__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 0.54rem 1rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--brand-gold) / 0.52);
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--color-foreground-rgb));
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .lame-premium-split__button:is(:hover, :focus-visible) {
    transform: translateY(-1px);
    border-color: rgb(var(--brand-gold));
  }

  .lame-premium-split__card:is(:hover, :focus-within) {
    transform: translateY(-4px);
    box-shadow: 0 18px 34px rgb(20 20 20 / 0.11);
  }

  .lame-premium-split__card:is(:hover, :focus-within) .lame-premium-split__image {
    transform: scale(1.03);
  }

  @media screen and (min-width: 990px) {
    .lame-premium-split__card {
      grid-template-columns: 1.05fr 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Premium Split Promo",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium Care Edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feel Beautiful, Feel Confident."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>This daily ritual combines care and comfort for a naturally radiant look.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#d6eddc"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c1971f"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Lame Premium Split Promo"
    }
  ]
}
{% endschema %}
