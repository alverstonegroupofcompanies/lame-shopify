{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
  assign slide_count = slide_blocks.size

  assign panel_heading = section.settings.heading
  if panel_heading == blank and section.settings.use_collection_title and collection != blank
    assign panel_heading = collection.title
  endif

  assign panel_link = section.settings.button_link
  if panel_link == blank and collection != blank
    assign panel_link = collection.url
  endif

  assign show_banner = false
  if slide_count > 0 or request.design_mode
    assign show_banner = true
  endif
%}

{% if show_banner %}
  <div
    class="lame-collection-banner section-wrapper"
    data-lame-collection-banner
    data-autoplay="{{ section.settings.autoplay }}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
    {{ section.shopify_attributes }}
  >
    <div class="lame-collection-banner__frame section section--{{ section.settings.section_width }}">
      <div
        class="lame-collection-banner__hero spacing-style"
        style="{% render 'spacing-style', settings: section.settings %}"
      >
        <div class="lame-collection-banner__split">
          <div class="lame-collection-banner__visual">
            {% if slide_count > 0 %}
              <div class="lame-collection-banner__carousel" data-carousel>
                <div class="lame-collection-banner__track" data-carousel-track>
                  {% for block in slide_blocks %}
                    <div
                      class="lame-collection-banner__slide{% if forloop.first %} is-active{% endif %}"
                      data-carousel-slide
                      data-slide-index="{{ forloop.index0 }}"
                      {{ block.shopify_attributes }}
                    >
                      {% if block.settings.image != blank %}
                        {% liquid
                          assign slide_alt = block.settings.image_alt
                          if slide_alt == blank and collection != blank
                            assign slide_alt = collection.title
                          endif
                          if forloop.first
                            assign slide_loading = 'eager'
                            assign slide_fetchpriority = 'high'
                          else
                            assign slide_loading = 'lazy'
                            assign slide_fetchpriority = 'low'
                          endif
                        %}
                        {{
                          block.settings.image
                          | image_url: width: 1600
                          | image_tag:
                            class: 'lame-collection-banner__slide-image',
                            loading: slide_loading,
                            fetchpriority: slide_fetchpriority,
                            widths: '600, 900, 1200, 1600',
                            sizes: '(min-width: 1200px) 700px, 55vw',
                            alt: slide_alt
                        }}
                      {% elsif request.design_mode %}
                        <div class="lame-collection-banner__slide-placeholder">
                          {{ 'collection-apparel-2' | placeholder_svg_tag }}
                          <span>Add slide image</span>
                        </div>
                      {% endif %}

                      {% if block.settings.image_tagline != blank or block.settings.image_subtext != blank %}
                        <div class="lame-collection-banner__slide-caption">
                          {% if block.settings.image_tagline != blank %}
                            <p class="lame-collection-banner__slide-tagline">{{ block.settings.image_tagline }}</p>
                          {% endif %}
                          {% if block.settings.image_subtext != blank %}
                            <p class="lame-collection-banner__slide-subtext">{{ block.settings.image_subtext }}</p>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>

                {% if slide_count > 1 %}
                  <button
                    type="button"
                    class="lame-collection-banner__arrow lame-collection-banner__arrow--prev"
                    data-carousel-prev
                    aria-label="Previous banner slide"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button
                    type="button"
                    class="lame-collection-banner__arrow lame-collection-banner__arrow--next"
                    data-carousel-next
                    aria-label="Next banner slide"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <div class="lame-collection-banner__dots" data-carousel-dots>
                    {% for block in slide_blocks %}
                      <button
                        type="button"
                        class="lame-collection-banner__dot{% if forloop.first %} is-active{% endif %}"
                        data-carousel-dot="{{ forloop.index0 }}"
                        aria-label="Go to slide {{ forloop.index }}"
                      ></button>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            {% elsif request.design_mode %}
              <div class="lame-collection-banner__carousel lame-collection-banner__carousel--empty">
                <div class="lame-collection-banner__slide-placeholder">
                  {{ 'collection-apparel-2' | placeholder_svg_tag }}
                  <span>Add a “Slide” block with banner images</span>
                </div>
              </div>
            {% endif %}
          </div>

          <div
            class="lame-collection-banner__panel"
            style="--lame-collection-panel-bg: {{ section.settings.panel_background }};"
          >
            {% if section.settings.eyebrow != blank %}
              <p class="lame-collection-banner__eyebrow">{{ section.settings.eyebrow }}</p>
            {% endif %}

            {% if panel_heading != blank %}
              <h1 class="lame-collection-banner__title">{{ panel_heading }}</h1>
            {% elsif request.design_mode %}
              <h1 class="lame-collection-banner__title">Collection heading</h1>
            {% endif %}

            {% if section.settings.description != blank %}
              <p class="lame-collection-banner__description">{{ section.settings.description }}</p>
            {% endif %}

            {% if section.settings.button_label != blank %}
              <a href="{{ panel_link }}" class="lame-collection-banner__button button">
                {{ section.settings.button_label }}
              </a>
            {% endif %}
          </div>
        </div>
      </div>

      {% if section.settings.show_trust_bar and trust_blocks.size > 0 %}
        <div class="lame-collection-banner__trust">
          <ul class="lame-collection-banner__trust-list" role="list">
            {% for block in trust_blocks %}
              <li class="lame-collection-banner__trust-item" {{ block.shopify_attributes }}>
                <span class="lame-collection-banner__trust-icon" aria-hidden="true">
                  {% case block.settings.icon %}
                    {% when 'shipping' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M3 8.5h11v8H3zM14 10.5h3l2 2.5v3.5h-5z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6.5 18a1.5 1.5 0 1 0 0 .1M17.5 18a1.5 1.5 0 1 0 0 .1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% when 'guarantee' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M12 3l7 3v5c0 4.2-2.8 7.8-7 9-4.2-1.2-7-4.8-7-9V6z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 12l2 2 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% when 'support' %}
                      <svg viewBox="0 0 24 24" focusable="false"><path d="M4 11a8 8 0 0 1 16 0v2a3 3 0 0 1-3 3h-1.2l-1.3 2.6a1 1 0 0 1-1.8-.6l.3-2H9a3 3 0 0 1-3-3z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% else %}
                      <svg viewBox="0 0 24 24" focusable="false"><rect x="3" y="6" width="18" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M3 10h18" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                  {% endcase %}
                </span>
                <span class="lame-collection-banner__trust-copy">
                  {% if block.settings.title != blank %}
                    <strong>{{ block.settings.title }}</strong>
                  {% endif %}
                  {% if block.settings.subtitle != blank %}
                    <span>{{ block.settings.subtitle }}</span>
                  {% endif %}
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-lame-collection-banner]');
    if (!root) return;

    const track = root.querySelector('[data-carousel-track]');
    const slides = [...root.querySelectorAll('[data-carousel-slide]')];
    if (!track || slides.length === 0) return;

    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const dots = [...root.querySelectorAll('[data-carousel-dot]')];
    let index = slides.findIndex((slide) => slide.classList.contains('is-active'));
    if (index < 0) index = 0;

    const autoplay = root.dataset.autoplay === 'true';
    const autoplaySpeed = Number(root.dataset.autoplaySpeed) || 5000;
    let timer;

    const setSlide = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
    };

    const next = () => setSlide(index + 1);
    const prev = () => setSlide(index - 1);

    const restartAutoplay = () => {
      if (!autoplay || slides.length < 2) return;
      clearInterval(timer);
      timer = setInterval(next, autoplaySpeed);
    };

    prevBtn?.addEventListener('click', () => {
      prev();
      restartAutoplay();
    });
    nextBtn?.addEventListener('click', () => {
      next();
      restartAutoplay();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setSlide(Number(dot.dataset.carouselDot));
        restartAutoplay();
      });
    });

    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', restartAutoplay);

    restartAutoplay();
  })();
</script>

{% stylesheet %}
  .lame-collection-banner {
    width: 100%;
  }

  .lame-collection-banner__frame {
    padding-inline: var(--page-margin);
  }

  .lame-collection-banner__hero {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
  }

  .lame-collection-banner__split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    min-height: 250px;
    border: 1px solid #e8e8e8;
    overflow: hidden;
    background: #fff;
  }

  .lame-collection-banner__visual {
    position: relative;
    min-height: 250px;
    background: #f7f7f7;
  }

  .lame-collection-banner__carousel {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 250px;
  }

  .lame-collection-banner__track {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 250px;
  }

  .lame-collection-banner__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s ease;
  }

  .lame-collection-banner__slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .lame-collection-banner__slide-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lame-collection-banner__slide-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    min-height: 250px;
    color: #666;
    font-size: 0.875rem;
    background: #f0f0f0;
  }

  .lame-collection-banner__slide-placeholder svg {
    width: min(50%, 220px);
    opacity: 0.35;
  }

  .lame-collection-banner__slide-caption {
    position: absolute;
    left: 8%;
    bottom: 14%;
    z-index: 2;
    max-width: 55%;
    color: #1f4d2c;
    pointer-events: none;
  }

  .lame-collection-banner__slide-tagline {
    margin: 0;
    font-family: var(--lame-font-display, Georgia, serif);
    font-size: clamp(1.25rem, 2.4vw, 2rem);
    line-height: 1.1;
    font-weight: 600;
  }

  .lame-collection-banner__slide-subtext {
    margin: 6px 0 0;
    font-size: 0.8125rem;
    opacity: 0.85;
  }

  .lame-collection-banner__arrow {
    position: absolute;
    top: 50%;
    z-index: 3;
    transform: translateY(-50%);
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 1px solid rgb(0 0 0 / 12%);
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    color: #111;
    cursor: pointer;
    box-shadow: 0 2px 10px rgb(0 0 0 / 10%);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .lame-collection-banner__arrow:hover {
    box-shadow: 0 4px 14px rgb(0 0 0 / 14%);
  }

  .lame-collection-banner__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .lame-collection-banner__arrow--prev {
    left: 12px;
  }

  .lame-collection-banner__arrow--next {
    right: 12px;
  }

  .lame-collection-banner__dots {
    position: absolute;
    left: 50%;
    bottom: 10px;
    z-index: 3;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
  }

  .lame-collection-banner__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 55%);
    cursor: pointer;
  }

  .lame-collection-banner__dot.is-active {
    background: #fff;
    width: 18px;
  }

  .lame-collection-banner__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    padding: clamp(20px, 3vw, 36px) clamp(20px, 3.5vw, 40px);
    background: var(--lame-collection-panel-bg, #f3f3f3);
  }

  .lame-collection-banner__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8a8a;
    font-weight: 500;
  }

  .lame-collection-banner__title {
    margin: 0;
    font-size: clamp(1.125rem, 2.2vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111;
    font-weight: 700;
  }

  .lame-collection-banner__description {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #666;
    max-width: 36ch;
  }

  .lame-collection-banner__button {
    align-self: flex-start;
    margin-top: 6px;
    min-height: 2.5rem;
    padding: 0.55rem 1.35rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    background: #111;
    color: #fff;
    border-radius: 2px;
  }

  .lame-collection-banner__button:hover {
    background: #333;
    color: #fff;
  }

  .lame-collection-banner__trust {
    max-width: 1200px;
    margin-inline: auto;
    margin-top: 0;
    background: #ececec;
    border: 1px solid #e0e0e0;
    border-top: 0;
  }

  .lame-collection-banner__trust-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 14px clamp(12px, 2vw, 24px);
  }

  .lame-collection-banner__trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .lame-collection-banner__trust-icon {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    color: #333;
  }

  .lame-collection-banner__trust-icon svg {
    width: 100%;
    height: 100%;
  }

  .lame-collection-banner__trust-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: #444;
    min-width: 0;
  }

  .lame-collection-banner__trust-copy strong {
    font-size: 0.75rem;
    color: #111;
    font-weight: 600;
  }

  @media screen and (max-width: 989px) {
    .lame-collection-banner__split {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .lame-collection-banner__visual,
    .lame-collection-banner__carousel,
    .lame-collection-banner__track {
      min-height: 200px;
    }

    .lame-collection-banner__trust-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 549px) {
    .lame-collection-banner__trust-list {
      grid-template-columns: 1fr;
    }

    .lame-collection-banner__slide-caption {
      max-width: 75%;
      left: 6%;
      bottom: 10%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection page banner",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Collection-only split banner with image carousel (not the homepage). Open each collection in the theme editor preview to set slides and text for that collection only. Recommended slide size: 1200 × 250 px."
    },
    {
      "type": "header",
      "content": "Right panel text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium beauty"
    },
    {
      "type": "checkbox",
      "id": "use_collection_title",
      "label": "Use collection title as heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Custom heading",
      "info": "Used when collection title is turned off."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover salon-quality care and styling essentials curated for every hair type."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave blank to link to this collection."
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#f3f3f3"
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust bar below banner",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "image_tagline",
          "label": "Image tagline (optional)",
          "info": "Shown over the image, e.g. Glow Your Skin Every Day"
        },
        {
          "type": "text",
          "id": "image_subtext",
          "label": "Image subtext (optional)"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "support", "label": "Support" },
            { "value": "payment", "label": "Payment" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free worldwide shipping"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On qualifying orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection page banner",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "shipping",
            "title": "Free Worldwide Shipping",
            "subtitle": "On qualifying orders"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "guarantee",
            "title": "Money Back Guarantee",
            "subtitle": "30 day returns"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "support",
            "title": "24/7 Customer Support",
            "subtitle": "We are here to help"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "payment",
            "title": "Secure Online Payment",
            "subtitle": "Protected checkout"
          }
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
