{%- liquid
  assign video_id = ''
  if section.settings.youtube_url != blank
    assign video_id = section.settings.youtube_url.id
  endif

  assign cover_image = section.settings.cover_image
  assign poster_alt = section.settings.heading | default: 'Blow Dry Brush demo'

  assign watch_url = section.settings.watch_link
  if watch_url == blank and video_id != blank
    assign watch_url = 'https://www.youtube.com/watch?v=' | append: video_id
  endif
-%}

{%- if video_id != blank or section.settings.heading != blank -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-home-youtube"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-youtube__wrap spacing-style"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      <div class="lame-home-youtube__grid">
        <div class="lame-home-youtube__media">
          {%- if video_id != blank -%}
            <div
              class="lame-home-youtube__player"
              style="--lame-yt-aspect: {{ section.settings.aspect_ratio }};"
              data-lame-youtube
              data-video-id="{{ video_id | escape }}"
            >
              <button
                type="button"
                class="lame-home-youtube__poster"
                aria-label="{{ section.settings.play_label | default: 'Play video' | escape }}"
              >
                {%- if cover_image != blank -%}
                  {{
                    cover_image
                    | image_url: width: 1600
                    | image_tag:
                      class: 'lame-home-youtube__poster-img',
                      loading: 'lazy',
                      widths: '480,720,960,1200,1600',
                      sizes: '(min-width: 750px) 55vw, 94vw',
                      alt: poster_alt
                  }}
                {%- else -%}
                  <img
                    class="lame-home-youtube__poster-img"
                    src="{{ 'lame-blow-dry-brush-youtube-thumb.png' | asset_url }}"
                    alt="{{ poster_alt | escape }}"
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
                <span class="lame-home-youtube__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                    <path d="M8.5 6.8v10.4L18 12 8.5 6.8Z"/>
                  </svg>
                </span>
              </button>
            </div>
          {%- else -%}
            <div class="lame-home-youtube__player lame-home-youtube__player--empty" style="--lame-yt-aspect: {{ section.settings.aspect_ratio }};">
              <p>Add a YouTube URL in the theme editor.</p>
            </div>
          {%- endif -%}
        </div>

        <div class="lame-home-youtube__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="lame-home-youtube__eyebrow">
              <span class="lame-home-youtube__eyebrow-mark" aria-hidden="true"></span>
              {{ section.settings.eyebrow | escape }}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="lame-home-youtube__heading">
              {%- if section.settings.heading contains 'Salon-smooth' -%}
                {{ section.settings.heading | escape | replace: 'Salon-smooth', '<span class="lame-home-youtube__highlight">Salon-smooth</span>' }}
              {%- else -%}
                <span class="lame-home-youtube__highlight">{{ section.settings.heading | escape }}</span>
              {%- endif -%}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="lame-home-youtube__description rte">{{ section.settings.description }}</div>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="lame-home-youtube__features list-unstyled" role="list">
              {%- for block in section.blocks -%}
                <li class="lame-home-youtube__feature" {{ block.shopify_attributes }}>
                  <span class="lame-home-youtube__feature-mark" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="12" height="12" focusable="false">
                      <path fill="currentColor" d="M6.2 11.4 2.8 8l1.1-1.1 2.3 2.3 5-5L12.3 5.3z"/>
                    </svg>
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="lame-home-youtube__actions">
            {%- if section.settings.button_label != blank -%}
              <a
                class="lame-home-youtube__btn lame-home-youtube__btn--primary"
                href="{{ section.settings.button_link | default: routes.root_url }}"
              >
                {{ section.settings.button_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.watch_label != blank and watch_url != blank -%}
              <a
                class="lame-home-youtube__btn lame-home-youtube__btn--ghost"
                href="{{ watch_url }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8ZM9.8 15.5v-7l6.3 3.5-6.3 3.5Z"/>
                </svg>
                {{ section.settings.watch_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;

      const player = section.querySelector('[data-lame-youtube]');
      if (!player) return;
      const poster = player.querySelector('.lame-home-youtube__poster');
      const videoId = player.getAttribute('data-video-id');
      if (!poster || !videoId) return;

      poster.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.className = 'lame-home-youtube__iframe';
        iframe.src =
          'https://www.youtube-nocookie.com/embed/' +
          encodeURIComponent(videoId) +
          '?autoplay=1&rel=0&modestbranding=1';
        iframe.title = {{ section.settings.heading | default: 'Product video' | json }};
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.setAttribute('loading', 'lazy');
        player.replaceChildren(iframe);
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .lame-home-youtube__wrap {
    padding-inline: var(--page-margin);
  }

  .lame-home-youtube__grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    align-items: center;
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  .lame-home-youtube__player {
    position: relative;
    width: 100%;
    aspect-ratio: var(--lame-yt-aspect, 16 / 9);
    border-radius: 12px;
    overflow: hidden;
    background: #111;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
  }

  .lame-home-youtube__player--empty {
    display: grid;
    place-items: center;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font-size: 0.95rem;
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .lame-home-youtube__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: #111;
  }

  .lame-home-youtube__poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease;
  }

  .lame-home-youtube__poster:hover .lame-home-youtube__poster-img {
    transform: scale(1.03);
  }

  .lame-home-youtube__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: clamp(3.75rem, 5vw, 4.5rem);
    height: clamp(3.75rem, 5vw, 4.5rem);
    border-radius: 999px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgb(200 40 40 / 0.92);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.3);
    transition: transform 0.25s ease, background 0.25s ease;
  }

  .lame-home-youtube__play svg {
    width: 1.85rem;
    height: 1.85rem;
  }

  .lame-home-youtube__poster:hover .lame-home-youtube__play {
    transform: scale(1.06);
    background: rgb(220 45 45 / 0.96);
  }

  .lame-home-youtube__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lame-home-youtube__content {
    display: grid;
    gap: clamp(0.95rem, 1.8vw, 1.25rem);
    align-content: center;
    max-width: 38rem;
  }

  .lame-home-youtube__eyebrow {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    padding: 0.35rem 0.75rem 0.35rem 0.55rem;
    border-radius: 999px;
    background: rgb(20 63 46 / 0.08);
    border: 1px solid rgb(20 63 46 / 0.12);
    font-family: 'Jost', var(--font-body--family), sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #154230;
  }

  .lame-home-youtube__eyebrow-mark {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: #c5a059;
    box-shadow: 0 0 0 3px rgb(197 160 89 / 0.22);
  }

  .lame-home-youtube__heading {
    margin: 0;
    font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    font-size: clamp(2.05rem, 4.2vw, 3.15rem);
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: #122018;
  }

  .lame-home-youtube__highlight {
    display: inline;
    padding: 0.05em 0.18em;
    border-radius: 0.18em;
    background: linear-gradient(
      180deg,
      transparent 55%,
      rgb(197 160 89 / 0.42) 55%,
      rgb(197 160 89 / 0.42) 92%,
      transparent 92%
    );
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .lame-home-youtube__description {
    margin: 0;
    font-family: 'Jost', var(--font-body--family), sans-serif;
    font-size: clamp(1.02rem, 1.55vw, 1.14rem);
    font-weight: 400;
    line-height: 1.65;
    color: rgb(18 32 24 / 0.78);
  }

  .lame-home-youtube__description p {
    margin: 0;
  }

  .lame-home-youtube__description strong,
  .lame-home-youtube__description b {
    color: #154230;
    font-weight: 600;
  }

  .lame-home-youtube__features {
    display: grid;
    gap: 0;
    margin: 0.15rem 0 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    list-style: none;
  }

  .lame-home-youtube__feature {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(20 63 46 / 0.1);
    font-family: 'Jost', var(--font-body--family), sans-serif;
    font-size: clamp(0.98rem, 1.3vw, 1.08rem);
    font-weight: 500;
    line-height: 1.4;
    color: #1a2c22;
  }

  .lame-home-youtube__feature:first-child {
    border-top: 1px solid rgb(20 63 46 / 0.1);
  }

  .lame-home-youtube__feature-mark {
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    background: linear-gradient(145deg, #e6d0a0, #c5a059);
    box-shadow: 0 2px 8px rgb(197 160 89 / 0.28);
    color: #fff;
  }

  .lame-home-youtube__feature-mark svg {
    width: 0.7rem;
    height: 0.7rem;
    display: block;
  }

  .lame-home-youtube__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.85rem;
  }

  .lame-home-youtube__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.15rem;
    padding: 0.8rem 1.55rem;
    border-radius: 999px;
    font-family: 'Jost', var(--font-body--family), sans-serif;
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .lame-home-youtube__btn--primary {
    color: #fff;
    background: #154230;
    border: 1.5px solid #154230;
    box-shadow: 0 12px 28px rgb(21 66 48 / 0.2);
  }

  .lame-home-youtube__btn--primary:hover {
    background: #1c5640;
    border-color: #1c5640;
    transform: translateY(-1px);
  }

  .lame-home-youtube__btn--ghost {
    color: #154230;
    border: 1.5px solid rgb(21 66 48 / 0.22);
    background: transparent;
  }

  .lame-home-youtube__btn--ghost:hover {
    border-color: #c5a059;
    background: rgb(197 160 89 / 0.08);
    color: #154230;
    box-shadow: none;
  }

  @media screen and (max-width: 749px) {
    .lame-home-youtube__wrap {
      padding-inline: 0.65rem;
    }

    .lame-home-youtube__grid {
      gap: 1rem;
    }

    .lame-home-youtube__player {
      border-radius: 10px;
      box-shadow: 0 8px 22px rgb(0 0 0 / 0.1);
    }

    .lame-home-youtube__content {
      padding-inline: 0.15rem;
      max-width: none;
    }

    .lame-home-youtube__features {
      margin-top: 0.1rem;
    }

    .lame-home-youtube__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.65rem;
      margin-top: 0.75rem;
    }

    .lame-home-youtube__btn {
      width: 100%;
    }
  }

  /* Tablet — stacked: full-bleed thumbnail on top, content below */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .lame-home-youtube {
      overflow-x: clip;
    }

    .lame-home-youtube__wrap {
      padding-inline: 0;
    }

    .lame-home-youtube__grid {
      grid-template-columns: 1fr;
      gap: 1.35rem;
      justify-items: stretch;
    }

    .lame-home-youtube__media {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
    }

    .lame-home-youtube__player {
      border-radius: 0;
      box-shadow: none;
    }

    .lame-home-youtube__content {
      max-width: none;
      width: 100%;
      margin-inline: 0;
      padding-inline: var(--page-margin, 1.25rem);
      text-align: left;
      box-sizing: border-box;
      gap: 1.1rem;
    }

    .lame-home-youtube__actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 28rem;
      gap: 0.7rem;
    }

    .lame-home-youtube__btn {
      width: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-home-youtube__grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: clamp(2rem, 3.5vw, 3rem);
    }

    .lame-home-youtube__player {
      border-radius: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home YouTube spotlight",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Watch & learn"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Salon-smooth hair at home"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>See how the Blow Dry Brush dries and styles in one pass — for smoother, fuller-looking hair with less effort.</p>"
    },
    {
      "type": "video_url",
      "id": "youtube_url",
      "label": "YouTube URL",
      "accept": ["youtube"],
      "info": "Use a YouTube watch or Shorts link."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Custom thumbnail",
      "info": "Optional. Leave empty to use the Blow Dry Brush thumbnail asset."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "options": [
        { "value": "16 / 9", "label": "Landscape (16:9)" },
        { "value": "9 / 16", "label": "Vertical (9:16)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "text",
      "id": "play_label",
      "label": "Play button label",
      "default": "Play Blow Dry Brush video"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Shop haircare"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "watch_label",
      "label": "YouTube button label",
      "default": "Watch on YouTube"
    },
    {
      "type": "url",
      "id": "watch_link",
      "label": "YouTube button link",
      "info": "Optional. Defaults to the video URL above."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Dry + style in one tool"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home YouTube spotlight",
      "category": "Media",
      "blocks": [
        { "type": "feature", "settings": { "text": "Dry and style in one pass" } },
        { "type": "feature", "settings": { "text": "Smooth, voluminous finish" } },
        { "type": "feature", "settings": { "text": "360° swivel cord for easy movement" } }
      ]
    }
  ]
}
{% endschema %}
