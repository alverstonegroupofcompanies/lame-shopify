{% liquid
  assign ig = section.settings.instagram_url | default: 'https://www.instagram.com'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-social-gallery lame-luxury-glow-root"
  {{ section.shopify_attributes }}
>
  <div class="lame-social-gallery__wrap lame-luxury-glow spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-social-gallery__header">
      {% if section.settings.eyebrow != blank %}
        <p class="lame-social-gallery__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="lame-social-gallery__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.follow_label != blank %}
        <a class="lame-social-gallery__follow" href="{{ ig }}" rel="noopener noreferrer" target="_blank">
          {{ section.settings.follow_label | escape }}
        </a>
      {% endif %}
    </header>

    <ul class="lame-social-gallery__mosaic" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign tile_link = block.settings.link | default: ig
          assign mod = forloop.index0 | modulo: 7
          assign span_class = ''
          case mod
            when 0
              assign span_class = 'lame-social-gallery__tile--wide'
            when 3
              assign span_class = 'lame-social-gallery__tile--tall'
            else
              assign span_class = ''
          endcase
        %}
        <li class="lame-social-gallery__tile {{ span_class }}" {{ block.shopify_attributes }}>
          <a class="lame-social-gallery__tile-link" href="{{ tile_link }}" {% if tile_link contains 'http' %}rel="noopener noreferrer" target="_blank"{% endif %}>
            {% if block.settings.image != blank %}
              {% liquid
                assign gal_img_alt = block.settings.image.alt | default: section.settings.heading | default: ''
              %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'lame-social-gallery__img',
                  loading: 'lazy',
                  widths: '200,360,540,720,900',
                  sizes: '(min-width: 990px) 22vw, (min-width: 750px) 33vw, 50vw',
                  alt: gal_img_alt
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'lame-social-gallery__img placeholder-svg' }}
            {% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-social-gallery__wrap {
    position: relative;
    padding-inline: var(--page-margin);
  }

  .lame-social-gallery__header {
    text-align: center;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    align-items: center;
  }

  .lame-social-gallery__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb));
  }

  .lame-social-gallery__heading {
    margin: 0;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-weight: 500;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-social-gallery__follow {
    margin-top: 0.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.48rem 1.35rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
    color: rgb(var(--color-foreground-heading-rgb));
    background: rgb(var(--color-background-rgb) / 0.65);
    backdrop-filter: blur(10px);
    transition:
      transform 0.3s ease,
      border-color 0.25s ease,
      box-shadow 0.3s ease;
  }

  .lame-social-gallery__follow:hover {
    transform: translateY(-2px);
    border-color: rgb(var(--color-primary-rgb) / 0.35);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.08);
  }

  .lame-social-gallery__mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
    grid-auto-rows: minmax(110px, 28vw);
  }

  @media screen and (min-width: 750px) {
    .lame-social-gallery__mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(140px, 12vw);
      gap: 0.65rem;
    }
  }

  .lame-social-gallery__tile {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgb(0 0 0 / 0.07);
    min-height: 0;
  }

  .lame-social-gallery__tile--wide {
    grid-column: span 2;
  }

  .lame-social-gallery__tile--tall {
    grid-row: span 2;
  }

  @media screen and (max-width: 749px) {
    .lame-social-gallery__tile--wide {
      grid-column: span 2;
    }

    .lame-social-gallery__tile--tall {
      grid-row: span 1;
    }
  }

  .lame-social-gallery__tile-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .lame-social-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lame-social-gallery__tile-link:hover .lame-social-gallery__img {
    transform: scale(1.06);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social gallery",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Upload lifestyle or product shots. Tiles link to each block’s URL, or Instagram when left blank."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "@yourbrand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram profile URL"
    },
    {
      "type": "text",
      "id": "follow_label",
      "label": "Follow button label",
      "default": "Follow us"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to Instagram URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social gallery",
      "category": "Storytelling",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
