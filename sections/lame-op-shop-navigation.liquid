{%- doc -%}
  LAME OP SHOP NAVIGATION — 3-Band Full-Width Navigation & Filters
  Band 1: Soft Blush Categories Arch Row (#fbe9ee)
  Band 2: Deep Plum Top Brands Carousel (#4a1f46)
  Band 3: Off-White Sticky Filter Bar (#fdfaf8)
{%- enddoc -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

{{ 'lame-op-shop-navigation.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign products_base = routes.all_products_collection_url
  if collection != blank and collection.url != blank
    assign products_base = collection.url
  elsif collections['our-products'] != blank
    assign products_base = collections['our-products'].url
  elsif collections['all'] != blank
    assign products_base = collections['all'].url
  endif

  assign current_handle = collection.handle | default: ''
-%}

<section
  class="lame-op-shop-nav"
  data-lame-op-shop-nav
  data-products-base="{{ products_base }}"
  {{ section.shopify_attributes }}
>
  <!-- ======================================================================
       BAND 1: CATEGORIES (Soft Blush Strip)
       ====================================================================== -->
  <div class="lame-op-categories-band">
    <div class="lame-op-grid-container">
      <nav class="lame-op-categories-nav" aria-label="Product categories">
        <ul class="lame-op-categories-list" role="list">
          {%- liquid
            assign cat_names = "All products,Skincare,Makeup,Haircare,Bath & body,Fragrance,Baby care,Wellness" | split: ","
            assign cat_handles = "all,skin-care,make-up,hair-care,bath-body,fragrance,baby-mom,wellness" | split: ","
            assign cat_classes = "all,skincare,makeup,haircare,bath-body,fragrance,baby-care,wellness" | split: ","
          -%}
          {%- for cat_name in cat_names -%}
            {%- liquid
              assign c_handle = cat_handles[forloop.index0]
              assign c_class = cat_classes[forloop.index0]
              assign is_active = false
              assign cat_url = routes.all_products_collection_url

              if c_handle == 'all'
                if collections['our-products'] != blank
                  assign cat_url = collections['our-products'].url
                else
                  assign cat_url = routes.all_products_collection_url
                endif
                if current_handle == 'all' or current_handle == 'our-products' or current_handle == ''
                  assign is_active = true
                endif
              else
                if collections[c_handle] != blank
                  assign cat_url = collections[c_handle].url
                else
                  assign cat_url = '/collections/' | append: c_handle
                endif
                if current_handle == c_handle
                  assign is_active = true
                endif
              endif
            -%}
            <li class="lame-op-cat-item-wrap">
              <a
                href="{{ cat_url }}"
                class="lame-op-cat-item lame-op-cat-item--{{ c_class }}{% if is_active %} is-selected{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
                data-category-slug="{{ c_handle }}"
              >
                <div class="lame-op-cat-arch lame-op-cat-arch--{{ c_class }}">
                  <span class="lame-op-cat-icon">
                    {%- case c_class -%}
                      {%- when 'all' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 2l2.4 6.6L21 11l-6.6 2.4L12 20l-2.4-6.6L3 11l6.6-2.4L12 2z"/>
                          <path d="M19 3l1 2 2 1-2 1-1 2-1-2-2-1 2-1 1-2z"/>
                        </svg>
                      {%- when 'skincare' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M10 2h4M12 2v3M8 9h8a2 2 0 0 1 2 2v8a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-8a2 2 0 0 1 2-2zM9 5h6v4H9z"/>
                          <path d="M12 13v3"/>
                        </svg>
                      {%- when 'makeup' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M9 11h6v10a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V11z"/>
                          <path d="M10 11V6.5l4-3.5v8"/>
                          <path d="M8 15h8"/>
                        </svg>
                      {%- when 'haircare' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M4 6h16a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
                          <path d="M6 12v6M9 12v6M12 12v6M15 12v6M18 12v6"/>
                        </svg>
                      {%- when 'bath-body' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M8 9h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2z"/>
                          <path d="M12 5v4M10 5h4M10 5l-2-2"/>
                          <circle cx="19" cy="5" r="1.8"/>
                          <circle cx="21" cy="9" r="1"/>
                        </svg>
                      {%- when 'fragrance' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect x="6" y="9" width="12" height="12" rx="2"/>
                          <path d="M9 9V6h6v3M12 6V3M10 3h4"/>
                          <circle cx="12" cy="15" r="2"/>
                          <path d="M19 5l2-1M20 7l2 1"/>
                        </svg>
                      {%- when 'baby-care' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M9 7h6M10 7V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3M8 10h8a1 1 0 0 1 1 1v9a3 3 0 0 1-3 3H10a3 3 0 0 1-3-3v-9a1 1 0 0 1 1-1z"/>
                          <path d="M7 14h3M7 17h4"/>
                        </svg>
                      {%- when 'wellness' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M12 21c-4-4-7-8-7-12a7 7 0 0 1 14 0c0 4-3 8-7 12z"/>
                          <path d="M12 12c-2.5-3-3.5-5.5-3.5-7.5a3.5 3.5 0 0 1 7 0c0 2-1 4.5-3.5 7.5z"/>
                          <path d="M5 15c2.5 1 4.5 1 7 0s4.5-1 7 0"/>
                        </svg>
                    {%- endcase -%}
                  </span>
                </div>
                <span class="lame-op-cat-label">{{ cat_name }}</span>
                <span class="lame-op-cat-dot" aria-hidden="true"></span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  </div>

  <!-- ======================================================================
       BAND 2: TOP BRANDS (Deep Plum Band)
       ====================================================================== -->
  <div class="lame-op-brands-band">
    <div class="lame-op-grid-container">
      <div class="lame-op-brands-header">
        <div class="lame-op-brands-heading-wrap">
          <h2 class="lame-op-brands-title">{{ section.settings.brands_heading | default: 'Top brands' }}</h2>
          <p class="lame-op-brands-sub">{{ section.settings.brands_subtitle | default: 'Discover beloved beauty and wellness essentials from leading houses' }}</p>
        </div>
        <div class="lame-op-brands-nav-btns" aria-label="Brand carousel controls">
          <button
            type="button"
            class="lame-op-brands-arrow lame-op-brands-arrow--prev"
            data-brands-arrow-prev
            aria-label="Previous brands"
          >
            <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button
            type="button"
            class="lame-op-brands-arrow lame-op-brands-arrow--next"
            data-brands-arrow-next
            aria-label="Next brands"
          >
            <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Full-bleed carousel running past screen edge -->
    <div class="lame-op-brands-viewport" data-brands-viewport>
      <div class="lame-op-brands-track" data-brands-track>
        {%- liquid
          assign default_brands = "Plum,Dot & Key,Cetaphil,Beauty of Joseon,Dove,Ponds,Pears,Femisafe,Jovees Herbal,SebaMed,Nykaa,Himalaya,Vaseline" | split: ","
          assign block_brands_count = 0
          for block in section.blocks
            if block.type == 'brand' and block.settings.image != blank
              assign block_brands_count = block_brands_count | plus: 1
            endif
          endfor
        -%}

        {%- if block_brands_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'brand' %}{% continue %}{% endif -%}
            {%- liquid
              assign vendor_name = block.settings.vendor | default: block.settings.alt | default: 'Brand'
              if vendor_name == blank or vendor_name == 'Brand'
                assign vendor_name = default_brands[forloop.index0] | default: 'Brand'
              endif
            -%}
            <div
              class="lame-brand-tile"
              data-brand-tile
              data-vendor="{{ vendor_name | escape }}"
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label="Filter by {{ vendor_name | escape }}"
              {{ block.shopify_attributes }}
            >
              <div class="lame-brand-tile__img-wrap">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 360
                    | image_tag:
                      class: 'lame-brand-tile__img',
                      loading: 'lazy',
                      widths: '140,180,240,360',
                      sizes: '160px',
                      alt: vendor_name
                  }}
                {%- else -%}
                  <span class="lame-brand-tile__wordmark">{{ vendor_name }}</span>
                {%- endif -%}
              </div>
              <span class="lame-brand-tile__shop-now">Shop now</span>
              <span class="lame-brand-tile__check" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback to complete list of real brands {%- endcomment -%}
          {%- for brand_name in default_brands -%}
            <div
              class="lame-brand-tile"
              data-brand-tile
              data-vendor="{{ brand_name | escape }}"
              role="button"
              tabindex="0"
              aria-pressed="false"
              aria-label="Filter by {{ brand_name | escape }}"
            >
              <div class="lame-brand-tile__img-wrap">
                {%- liquid
                  assign b_lower = brand_name | downcase
                  assign asset_name = ''
                  case b_lower
                    when 'dove'
                      assign asset_name = 'brand-logo-dove.png'
                    when 'ponds'
                      assign asset_name = 'brand-logo-ponds.png'
                    when 'pears'
                      assign asset_name = 'brand-logo-pears.png'
                    when 'femisafe'
                      assign asset_name = 'brand-logo-femisafe.png'
                    when 'jovees herbal'
                      assign asset_name = 'brand-logo-jovees.png'
                    when 'sebamed'
                      assign asset_name = 'brand-logo-sebamed.png'
                  endcase
                -%}
                {%- if asset_name != '' -%}
                  <img
                    src="{{ asset_name | asset_url }}"
                    alt="{{ brand_name | escape }}"
                    class="lame-brand-tile__img"
                    loading="lazy"
                    width="140"
                    height="60"
                  >
                {%- else -%}
                  <span class="lame-brand-tile__wordmark">{{ brand_name }}</span>
                {%- endif -%}
              </div>
              <span class="lame-brand-tile__shop-now">Shop now</span>
              <span class="lame-brand-tile__check" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- ======================================================================
       BAND 3: FILTERS (Full-Width Sticky Bar in Off-White)
       ====================================================================== -->
  {%- liquid
    assign brand_filter = null
    assign availability_filter = null
    assign price_filter = null
    assign discount_filter = null

    if collection.filters != blank
      for filter in collection.filters
        assign p_param = filter.param_name | downcase
        assign p_label = filter.label | downcase
        if p_param contains 'vendor' or p_label contains 'brand' or p_label contains 'vendor'
          assign brand_filter = filter
        elsif p_param contains 'availability' or p_label contains 'availability' or p_label contains 'stock'
          assign availability_filter = filter
        elsif filter.type == 'price_range' or p_param contains 'price' or p_label contains 'price'
          assign price_filter = filter
        elsif p_param contains 'discount' or p_label contains 'discount'
          assign discount_filter = filter
        endif
      endfor
    endif

    assign fallback_brands = "Plum,Dot & Key,Cetaphil,Beauty of Joseon,Dove,Ponds,Pears,Femisafe,Jovees Herbal,SebaMed,Nykaa,Himalaya,Vaseline,Sirona,NIVEA,Bombay Shaving Company,DR.RASHEL" | split: ","
    if collection.all_vendors != blank and collection.all_vendors.size > 0
      assign fallback_brands = collection.all_vendors
    endif

    assign current_sort = collection.sort_by | default: collection.default_sort_by

    assign price_min_param = 'filter.v.price.gte'
    assign price_max_param = 'filter.v.price.lte'
    assign price_min_val = ''
    assign price_max_val = ''
    assign price_ceiling = ''

    if price_filter != null
      assign price_min_param = price_filter.min_value.param_name | default: 'filter.v.price.gte'
      assign price_max_param = price_filter.max_value.param_name | default: 'filter.v.price.lte'
      if price_filter.min_value.value != null
        assign price_min_val = price_filter.min_value.value | money_without_currency | replace: ',', ''
      endif
      if price_filter.max_value.value != null
        assign price_max_val = price_filter.max_value.value | money_without_currency | replace: ',', ''
      endif
      if price_filter.range_max != null
        assign price_ceiling = price_filter.range_max | money_without_currency | replace: ',', ''
      endif
    endif
  -%}

  <div class="lame-op-filters-band" data-lame-filters-bar>
    <div class="lame-op-grid-container">
      <div class="lame-op-filters-inner">
        <!-- Desktop Filters Row -->
        <div class="lame-op-filters-desktop">
          <div class="lame-op-filters-pills" role="toolbar" aria-label="Product filters">
            <!-- 1. Brand Pill Dropdown -->
            <div class="lame-filter-dropdown" data-filter-dropdown="brand">
              <button
                type="button"
                class="lame-filter-pill"
                data-pill-btn="brand"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span class="lame-filter-pill__title">Brand</span>
                <span class="lame-filter-pill__count" hidden></span>
                <svg class="lame-filter-pill__chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="lame-filter-popover" role="dialog" aria-label="Filter by brand">
                <input
                  type="search"
                  class="lame-filter-popover__search"
                  placeholder="Search brands..."
                  aria-label="Search brands"
                  data-brand-search
                >
                <div class="lame-filter-popover__options" data-brand-options-list>
                  {%- if brand_filter != null and brand_filter.values.size > 0 -%}
                    {%- for val in brand_filter.values -%}
                      <label class="lame-filter-option" data-option-value="{{ val.label | escape }}">
                        <input
                          type="checkbox"
                          class="lame-filter-checkbox"
                          name="{{ val.param_name }}"
                          value="{{ val.value | escape }}"
                          data-filter-key="vendor"
                          {% if val.active %}checked{% endif %}
                        >
                        <span class="lame-filter-option__text">{{ val.label }}</span>
                        <span class="lame-filter-option__count">({{ val.count }})</span>
                      </label>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for b in fallback_brands -%}
                      <label class="lame-filter-option" data-option-value="{{ b | escape }}">
                        <input
                          type="checkbox"
                          class="lame-filter-checkbox"
                          name="filter.p.vendor"
                          value="{{ b | escape }}"
                          data-filter-key="vendor"
                        >
                        <span class="lame-filter-option__text">{{ b }}</span>
                      </label>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- 2. Discount Pill Dropdown -->
            <div class="lame-filter-dropdown" data-filter-dropdown="discount">
              <button
                type="button"
                class="lame-filter-pill"
                data-pill-btn="discount"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span class="lame-filter-pill__title">Discount</span>
                <span class="lame-filter-pill__count" hidden></span>
                <svg class="lame-filter-pill__chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="lame-filter-popover" role="dialog" aria-label="Filter by discount">
                <div class="lame-filter-popover__options">
                  <label class="lame-filter-option">
                    <input type="checkbox" class="lame-filter-checkbox" name="discount" value="40" data-filter-key="discount">
                    <span class="lame-filter-option__text">40% or more</span>
                  </label>
                  <label class="lame-filter-option">
                    <input type="checkbox" class="lame-filter-checkbox" name="discount" value="30" data-filter-key="discount">
                    <span class="lame-filter-option__text">30% or more</span>
                  </label>
                  <label class="lame-filter-option">
                    <input type="checkbox" class="lame-filter-checkbox" name="discount" value="20" data-filter-key="discount">
                    <span class="lame-filter-option__text">20% or more</span>
                  </label>
                  <label class="lame-filter-option">
                    <input type="checkbox" class="lame-filter-checkbox" name="discount" value="10" data-filter-key="discount">
                    <span class="lame-filter-option__text">10% or more</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- 3. Availability Pill Dropdown -->
            <div class="lame-filter-dropdown" data-filter-dropdown="availability">
              <button
                type="button"
                class="lame-filter-pill"
                data-pill-btn="availability"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span class="lame-filter-pill__title">Availability</span>
                <span class="lame-filter-pill__count" hidden></span>
                <svg class="lame-filter-pill__chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="lame-filter-popover" role="dialog" aria-label="Filter by availability">
                <div class="lame-filter-popover__options">
                  {%- if availability_filter != null and availability_filter.values.size > 0 -%}
                    {%- for val in availability_filter.values -%}
                      <label class="lame-filter-option">
                        <input
                          type="checkbox"
                          class="lame-filter-checkbox"
                          name="{{ val.param_name }}"
                          value="{{ val.value | escape }}"
                          data-filter-key="availability"
                          {% if val.active %}checked{% endif %}
                        >
                        <span class="lame-filter-option__text">{{ val.label }}</span>
                        <span class="lame-filter-option__count">({{ val.count }})</span>
                      </label>
                    {%- endfor -%}
                  {%- else -%}
                    <label class="lame-filter-option">
                      <input type="checkbox" class="lame-filter-checkbox" name="filter.v.availability" value="1" data-filter-key="availability">
                      <span class="lame-filter-option__text">In stock</span>
                    </label>
                    <label class="lame-filter-option">
                      <input type="checkbox" class="lame-filter-checkbox" name="filter.v.availability" value="0" data-filter-key="availability">
                      <span class="lame-filter-option__text">Out of stock</span>
                    </label>
                  {%- endif -%}
                </div>
              </div>
            </div>

            <!-- 4. Price Pill Dropdown -->
            <div class="lame-filter-dropdown" data-filter-dropdown="price">
              <button
                type="button"
                class="lame-filter-pill"
                data-pill-btn="price"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span class="lame-filter-pill__title">Price</span>
                <span class="lame-filter-pill__count" hidden></span>
                <svg class="lame-filter-pill__chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="lame-filter-popover" role="dialog" aria-label="Filter by price">
                <div class="lame-filter-price-wrap">
                  <div class="lame-filter-price-inputs">
                    <input
                      type="number"
                      class="lame-filter-price-input"
                      name="{{ price_min_param }}"
                      placeholder="Min ₹"
                      min="0"
                      {% if price_ceiling != '' %}max="{{ price_ceiling }}"{% endif %}
                      value="{{ price_min_val }}"
                      data-price-min
                    >
                    <span>–</span>
                    <input
                      type="number"
                      class="lame-filter-price-input"
                      name="{{ price_max_param }}"
                      placeholder="Max ₹"
                      min="0"
                      {% if price_ceiling != '' %}max="{{ price_ceiling }}"{% endif %}
                      value="{{ price_max_val }}"
                      data-price-max
                    >
                  </div>
                  <button type="button" class="lame-filter-price-btn" data-price-apply>Apply price</button>
                </div>
              </div>
            </div>

            <!-- 5. Sort By Dropdown -->
            <div class="lame-filter-dropdown lame-filter-dropdown--sort" data-filter-dropdown="sort">
              <button
                type="button"
                class="lame-filter-pill"
                data-pill-btn="sort"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span class="lame-filter-pill__title">Sort by</span>
                <span class="lame-filter-pill__sort-label" data-sort-current-label>
                  {%- liquid
                    case current_sort
                      when 'recommended'
                        echo '· For you'
                      when 'random'
                        echo '· Random'
                      when 'price-ascending'
                        echo '· Price: Low to high'
                      when 'price-descending'
                        echo '· Price: High to low'
                      when 'created-descending'
                        echo '· Newest'
                      when 'best-selling'
                        echo '· Best selling'
                      else
                        echo '· For you'
                    endcase
                  -%}
                </span>
                <svg class="lame-filter-pill__chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="lame-filter-popover lame-filter-popover--sort" role="dialog" aria-label="Sort by">
                <div class="lame-filter-popover__options">
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="recommended" {% if current_sort == 'recommended' or current_sort == 'manual' or current_sort == blank or current_sort == 'title-ascending' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Recommended for you</span>
                  </label>
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="random" {% if current_sort == 'random' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Random shuffle</span>
                  </label>
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="best-selling" {% if current_sort == 'best-selling' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Best selling</span>
                  </label>
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="price-ascending" {% if current_sort == 'price-ascending' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Price: Low to high</span>
                  </label>
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="price-descending" {% if current_sort == 'price-descending' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Price: High to low</span>
                  </label>
                  <label class="lame-filter-option lame-filter-option--sort">
                    <input type="radio" class="lame-filter-sort-radio" name="sort_by" value="created-descending" {% if current_sort == 'created-descending' %}checked{% endif %}>
                    <span class="lame-filter-option__text">Newest</span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <div class="lame-op-filters-desktop-right" style="display: flex; align-items: center; gap: 0.85rem;">
            <!-- Shuffle / Surprise Me button -->
            <button
              type="button"
              class="lame-filter-shuffle-btn"
              data-filter-shuffle
              title="Shuffle products to see fresh & different recommendations"
              aria-label="Shuffle products"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 3 21 3 21 8"></polyline>
                <line x1="4" y1="20" x2="21" y2="3"></line>
                <polyline points="21 16 21 21 16 21"></polyline>
                <line x1="15" y1="15" x2="21" y2="21"></line>
                <line x1="4" y1="4" x2="9" y2="9"></line>
              </svg>
              <span>Shuffle</span>
            </button>

            <!-- Live Results Count -->
            <span class="lame-filter-results-count" data-results-count>{{ collection.products_count | default: 0 }} products</span>

            <!-- Clear all button -->
            <button
              type="button"
              class="lame-filter-clear-all"
              data-filter-clear-all
              disabled
            >
              Clear all
            </button>
          </div>
        </div>

        <!-- Mobile Filter Header Bar -->
        <div class="lame-op-filters-mobile">
          <button
            type="button"
            class="lame-mobile-filter-trigger"
            data-mobile-sheet-open
            aria-label="Open filter sheet"
          >
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16M7 12h10M10 18h4"/>
            </svg>
            <span>Filters</span>
            <span class="lame-mobile-count-badge" data-mobile-total-count hidden>0</span>
          </button>

          <button
            type="button"
            class="lame-filter-shuffle-btn lame-filter-shuffle-btn--mobile"
            data-filter-shuffle
            title="Shuffle products"
            aria-label="Shuffle products"
          >
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 3 21 3 21 8"></polyline>
              <line x1="4" y1="20" x2="21" y2="3"></line>
              <polyline points="21 16 21 21 16 21"></polyline>
              <line x1="15" y1="15" x2="21" y2="21"></line>
              <line x1="4" y1="4" x2="9" y2="9"></line>
            </svg>
            <span>Shuffle</span>
          </button>

          <span class="lame-filter-results-count" data-results-count>{{ collection.products_count | default: 0 }} products</span>

          <button
            type="button"
            class="lame-filter-clear-all"
            data-filter-clear-all
            disabled
          >
            Clear all
          </button>
        </div>

        <!-- Applied Filters Removable Chips -->
        <div class="lame-op-active-chips" data-active-chips role="region" aria-label="Active filters"></div>
      </div>
    </div>
  </div>

  <!-- ======================================================================
       MOBILE BOTTOM SHEET MODAL
       ====================================================================== -->
  <div class="lame-bottom-sheet-backdrop" data-sheet-backdrop aria-hidden="true">
    <div class="lame-bottom-sheet" role="dialog" aria-modal="true" aria-label="Filters">
      <div class="lame-sheet-header">
        <h3 class="lame-sheet-title">Filters</h3>
        <button type="button" class="lame-sheet-close" data-sheet-close aria-label="Close filters">×</button>
      </div>

      <div class="lame-sheet-body">
        <!-- Sort Accordion -->
        <div class="lame-sheet-accordion">
          <div class="lame-sheet-accordion-header">
            <span>Sort by</span>
          </div>
          <div class="lame-sheet-accordion-options" style="display: flex; flex-direction: column; gap: 0.35rem; padding: 0.5rem 0.2rem;">
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="recommended" {% if current_sort == 'recommended' or current_sort == 'manual' or current_sort == blank or current_sort == 'title-ascending' %}checked{% endif %}>
              <span class="lame-filter-option__text">Recommended for you</span>
            </label>
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="random" {% if current_sort == 'random' %}checked{% endif %}>
              <span class="lame-filter-option__text">Random shuffle</span>
            </label>
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="best-selling" {% if current_sort == 'best-selling' %}checked{% endif %}>
              <span class="lame-filter-option__text">Best selling</span>
            </label>
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="price-ascending" {% if current_sort == 'price-ascending' %}checked{% endif %}>
              <span class="lame-filter-option__text">Price: Low to high</span>
            </label>
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="price-descending" {% if current_sort == 'price-descending' %}checked{% endif %}>
              <span class="lame-filter-option__text">Price: High to low</span>
            </label>
            <label class="lame-filter-option">
              <input type="radio" class="lame-filter-sort-radio" name="sheet.sort_by" value="created-descending" {% if current_sort == 'created-descending' %}checked{% endif %}>
              <span class="lame-filter-option__text">Newest</span>
            </label>
          </div>
        </div>

        <!-- Brand Accordion -->
        <div class="lame-sheet-accordion">
          <div class="lame-sheet-accordion-header">
            <span>Brand</span>
          </div>
          <div class="lame-sheet-accordion-options" data-sheet-brand-options>
            {%- if brand_filter != null and brand_filter.values.size > 0 -%}
              {%- for val in brand_filter.values -%}
                <label class="lame-filter-option">
                  <input type="checkbox" class="lame-filter-checkbox" name="sheet.filter.p.vendor" value="{{ val.value | escape }}" {% if val.active %}checked{% endif %}>
                  <span class="lame-filter-option__text">{{ val.label }}</span>
                  <span class="lame-filter-option__count">({{ val.count }})</span>
                </label>
              {%- endfor -%}
            {%- else -%}
              {%- for b in fallback_brands -%}
                <label class="lame-filter-option">
                  <input type="checkbox" class="lame-filter-checkbox" name="sheet.filter.p.vendor" value="{{ b | escape }}">
                  <span class="lame-filter-option__text">{{ b }}</span>
                </label>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>

        <!-- Discount Accordion -->
        <div class="lame-sheet-accordion">
          <div class="lame-sheet-accordion-header">
            <span>Discount</span>
          </div>
          <div class="lame-sheet-accordion-options">
            <label class="lame-filter-option">
              <input type="checkbox" class="lame-filter-checkbox" name="sheet.discount" value="40">
              <span class="lame-filter-option__text">40% or more</span>
            </label>
            <label class="lame-filter-option">
              <input type="checkbox" class="lame-filter-checkbox" name="sheet.discount" value="30">
              <span class="lame-filter-option__text">30% or more</span>
            </label>
            <label class="lame-filter-option">
              <input type="checkbox" class="lame-filter-checkbox" name="sheet.discount" value="20">
              <span class="lame-filter-option__text">20% or more</span>
            </label>
            <label class="lame-filter-option">
              <input type="checkbox" class="lame-filter-checkbox" name="sheet.discount" value="10">
              <span class="lame-filter-option__text">10% or more</span>
            </label>
          </div>
        </div>

        <!-- Availability Accordion -->
        <div class="lame-sheet-accordion">
          <div class="lame-sheet-accordion-header">
            <span>Availability</span>
          </div>
          <div class="lame-sheet-accordion-options">
            {%- if availability_filter != null and availability_filter.values.size > 0 -%}
              {%- for val in availability_filter.values -%}
                <label class="lame-filter-option">
                  <input type="checkbox" class="lame-filter-checkbox" name="sheet.filter.v.availability" value="{{ val.value | escape }}" {% if val.active %}checked{% endif %}>
                  <span class="lame-filter-option__text">{{ val.label }}</span>
                </label>
              {%- endfor -%}
            {%- else -%}
              <label class="lame-filter-option">
                <input type="checkbox" class="lame-filter-checkbox" name="sheet.filter.v.availability" value="1">
                <span class="lame-filter-option__text">In stock</span>
              </label>
              <label class="lame-filter-option">
                <input type="checkbox" class="lame-filter-checkbox" name="sheet.filter.v.availability" value="0">
                <span class="lame-filter-option__text">Out of stock</span>
              </label>
            {%- endif -%}
          </div>
        </div>

        <!-- Price Range Accordion -->
        <div class="lame-sheet-accordion">
          <div class="lame-sheet-accordion-header">
            <span>Price</span>
          </div>
          <div class="lame-filter-price-wrap">
            <div class="lame-filter-price-inputs">
              <input
                type="number"
                class="lame-filter-price-input"
                placeholder="Min ₹"
                value="{{ price_min_val }}"
                data-sheet-price-min
              >
              <span>–</span>
              <input
                type="number"
                class="lame-filter-price-input"
                placeholder="Max ₹"
                value="{{ price_max_val }}"
                data-sheet-price-max
              >
            </div>
          </div>
        </div>
      </div>

      <div class="lame-sheet-footer">
        <button type="button" class="lame-filter-clear-all" data-sheet-clear-all>Clear all</button>
        <button type="button" class="lame-sheet-apply-btn" data-sheet-apply>Apply{% if collection.products_count %} ({{ collection.products_count }} products){% endif %}</button>
      </div>
    </div>
  </div>
</section>

<!-- ======================================================================
     INTERACTIVE SCRIPT: AJAX SECTION RENDERING API, STOREFRONT FILTERS, URL SYNC
     ====================================================================== -->
<script>
  (() => {
    const root = document.querySelector('[data-lame-op-shop-nav]');
    if (!root) return;

    /* ------------------------------------------------------------------------
       1. Top Brands Carousel
       ------------------------------------------------------------------------ */
    const track = root.querySelector('[data-brands-track]');
    const viewport = root.querySelector('[data-brands-viewport]');
    const prevBtn = root.querySelector('[data-brands-arrow-prev]');
    const nextBtn = root.querySelector('[data-brands-arrow-next]');

    if (viewport && track) {
      const scrollAmount = () => Math.max(200, viewport.clientWidth * 0.6);
      nextBtn?.addEventListener('click', () => {
        viewport.scrollBy({ left: scrollAmount(), behavior: 'smooth' });
      });
      prevBtn?.addEventListener('click', () => {
        viewport.scrollBy({ left: -scrollAmount(), behavior: 'smooth' });
      });
    }

    /* ------------------------------------------------------------------------
       2. Filter State Management & Normalization
       ------------------------------------------------------------------------ */
    const state = {
      vendors: new Set(),
      discounts: new Set(),
      availability: new Set(),
      priceMin: '',
      priceMax: '',
      sortBy: ''
    };

    const norm = (str) => (str || '').trim().toLowerCase();

    const hasVendor = (v) => {
      const target = norm(v);
      for (const item of state.vendors) {
        if (norm(item) === target) return true;
      }
      return false;
    };

    const toggleVendor = (v) => {
      const target = norm(v);
      let found = null;
      for (const item of state.vendors) {
        if (norm(item) === target) {
          found = item;
          break;
        }
      }
      if (found) {
        state.vendors.delete(found);
      } else {
        state.vendors.add(v);
      }
    };

    const parseUrlParams = () => {
      const params = new URLSearchParams(window.location.search);
      state.vendors.clear();
      state.discounts.clear();
      state.availability.clear();
      state.priceMin = params.get('filter.v.price.gte') || '';
      state.priceMax = params.get('filter.v.price.lte') || '';
      state.sortBy = params.get('sort_by') || 'manual';

      params.getAll('filter.p.vendor').forEach(v => state.vendors.add(v));
      params.getAll('discount').forEach(d => state.discounts.add(d));
      params.getAll('filter.v.availability').forEach(a => state.availability.add(a));
    };

    parseUrlParams();

    /* ------------------------------------------------------------------------
       3. DOM Elements & Dropdowns
       ------------------------------------------------------------------------ */
    const brandTiles = root.querySelectorAll('[data-brand-tile]');
    const desktopDropdowns = root.querySelectorAll('[data-filter-dropdown]');
    const clearAllBtns = root.querySelectorAll('[data-filter-clear-all]');
    const activeChipsContainer = root.querySelector('[data-active-chips]');
    const mobileTriggerCount = root.querySelector('[data-mobile-total-count]');

    // Desktop pill buttons & popovers
    desktopDropdowns.forEach(dd => {
      const btn = dd.querySelector('.lame-filter-pill');
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dd.classList.contains('is-open');
        desktopDropdowns.forEach(d => {
          d.classList.remove('is-open');
          d.querySelector('.lame-filter-pill')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          dd.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('.lame-filter-dropdown')) {
        desktopDropdowns.forEach(dd => {
          dd.classList.remove('is-open');
          dd.querySelector('.lame-filter-pill')?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    // Keyboard escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        desktopDropdowns.forEach(dd => {
          dd.classList.remove('is-open');
          dd.querySelector('.lame-filter-pill')?.setAttribute('aria-expanded', 'false');
        });
        closeMobileSheet();
      }
    });

    // Brand search filter in popover
    const brandSearchInput = root.querySelector('[data-brand-search]');
    brandSearchInput?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      const options = root.querySelectorAll('[data-brand-options-list] .lame-filter-option');
      options.forEach(opt => {
        const val = (opt.dataset.optionValue || opt.textContent).toLowerCase();
        opt.style.display = val.includes(q) ? 'flex' : 'none';
      });
    });

    /* ------------------------------------------------------------------------
       4. Render UI from State
       ------------------------------------------------------------------------ */
    const updateUI = () => {
      // 1. Brand Tiles
      brandTiles.forEach(tile => {
        const v = tile.dataset.vendor;
        if (hasVendor(v)) {
          tile.classList.add('is-selected');
          tile.setAttribute('aria-pressed', 'true');
        } else {
          tile.classList.remove('is-selected');
          tile.setAttribute('aria-pressed', 'false');
        }
      });

      // 2. Desktop Dropdown Checkboxes
      root.querySelectorAll('.lame-filter-popover .lame-filter-checkbox').forEach(cb => {
        const name = cb.name;
        const val = cb.value;
        const key = cb.dataset.filterKey || '';
        if (key === 'vendor' || name.includes('vendor')) cb.checked = hasVendor(val);
        else if (key === 'discount' || name === 'discount') cb.checked = state.discounts.has(val);
        else if (key === 'availability' || name.includes('availability')) cb.checked = state.availability.has(val);
      });

      // 3. Desktop Sort Radios
      root.querySelectorAll('.lame-filter-popover--sort input[name="sort_by"]').forEach(radio => {
        radio.checked = (radio.value === state.sortBy) || (state.sortBy === 'manual' && radio.value === 'manual');
      });

      const sortLabelEl = root.querySelector('[data-sort-current-label]');
      if (sortLabelEl) {
        const labels = {
          'recommended': '· For you',
          'random': '· Random',
          'manual': '· For you',
          'best-selling': '· Best selling',
          'price-ascending': '· Price: Low to high',
          'price-descending': '· Price: High to low',
          'created-descending': '· Newest'
        };
        sortLabelEl.textContent = labels[state.sortBy] || '· For you';
      }

      // 4. Price inputs in popover
      const pMin = root.querySelector('[data-price-min]');
      const pMax = root.querySelector('[data-price-max]');
      if (pMin) pMin.value = state.priceMin;
      if (pMax) pMax.value = state.priceMax;

      // 5. Pill counts & active states
      updatePill('brand', state.vendors.size);
      updatePill('discount', state.discounts.size);
      updatePill('availability', state.availability.size);
      const hasPrice = (state.priceMin !== '' || state.priceMax !== '') ? 1 : 0;
      updatePill('price', hasPrice);

      // 6. Total active count
      const totalCount = state.vendors.size + state.discounts.size + state.availability.size + hasPrice;

      // 7. Clear all buttons
      clearAllBtns.forEach(btn => {
        btn.disabled = totalCount === 0;
        if (totalCount > 0) btn.classList.add('is-enabled');
        else btn.classList.remove('is-enabled');
      });

      // 8. Mobile count badge
      if (mobileTriggerCount) {
        if (totalCount > 0) {
          mobileTriggerCount.textContent = totalCount;
          mobileTriggerCount.hidden = false;
        } else {
          mobileTriggerCount.hidden = true;
        }
      }

      // 9. Removable chips
      renderChips();

      // 10. Sync Mobile Sheet
      syncMobileSheet();
    };

    const updatePill = (filterName, count) => {
      const pill = root.querySelector(`[data-pill-btn="${filterName}"]`);
      if (!pill) return;
      const countEl = pill.querySelector('.lame-filter-pill__count');

      if (count > 0) {
        pill.classList.add('has-active');
        if (countEl) {
          countEl.textContent = `· ${count}`;
          countEl.hidden = false;
        }
      } else {
        pill.classList.remove('has-active');
        if (countEl) countEl.hidden = true;
      }
    };

    const renderChips = () => {
      if (!activeChipsContainer) return;
      activeChipsContainer.innerHTML = '';

      state.vendors.forEach(v => {
        activeChipsContainer.appendChild(createChip(v, 'vendor', v));
      });

      state.discounts.forEach(d => {
        activeChipsContainer.appendChild(createChip(`${d}%+ off`, 'discount', d));
      });

      state.availability.forEach(a => {
        const txt = a === '1' ? 'In stock' : 'Out of stock';
        activeChipsContainer.appendChild(createChip(txt, 'availability', a));
      });

      if (state.priceMin || state.priceMax) {
        let pTxt = '';
        if (state.priceMin && state.priceMax) pTxt = `₹${state.priceMin} – ₹${state.priceMax}`;
        else if (state.priceMin) pTxt = `From ₹${state.priceMin}`;
        else if (state.priceMax) pTxt = `Up to ₹${state.priceMax}`;
        activeChipsContainer.appendChild(createChip(pTxt, 'price', 'price'));
      }
    };

    const createChip = (label, type, val) => {
      const chip = document.createElement('span');
      chip.className = 'lame-active-chip';
      chip.innerHTML = `${label} <button type="button" class="lame-active-chip__remove" aria-label="Remove ${label}">×</button>`;
      chip.querySelector('button').addEventListener('click', () => {
        if (type === 'vendor') {
          const target = norm(val);
          for (const item of state.vendors) {
            if (norm(item) === target) state.vendors.delete(item);
          }
        } else if (type === 'discount') state.discounts.delete(val);
        else if (type === 'availability') state.availability.delete(val);
        else if (type === 'price') {
          state.priceMin = '';
          state.priceMax = '';
        }
        updateUI();
        applyFiltersToPage();
      });
      return chip;
    };

    /* ------------------------------------------------------------------------
       5. Interaction Listeners
       ------------------------------------------------------------------------ */
    // Clicking Brand Tile in Band 2
    brandTiles.forEach(tile => {
      tile.addEventListener('click', (e) => {
        e.preventDefault();
        const vendor = tile.dataset.vendor;
        if (!vendor) return;
        toggleVendor(vendor);
        updateUI();
        applyFiltersToPage();
      });

      tile.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          tile.click();
        }
      });
    });

    // Checkboxes in Popovers
    root.querySelectorAll('.lame-filter-popover .lame-filter-checkbox').forEach(cb => {
      cb.addEventListener('change', () => {
        const name = cb.name;
        const val = cb.value;
        const key = cb.dataset.filterKey || '';
        if (key === 'vendor' || name.includes('vendor')) {
          toggleVendor(val);
        } else if (key === 'discount' || name === 'discount') {
          if (cb.checked) state.discounts.add(val);
          else state.discounts.delete(val);
        } else if (key === 'availability' || name.includes('availability')) {
          if (cb.checked) state.availability.add(val);
          else state.availability.delete(val);
        }
        updateUI();
        applyFiltersToPage();
      });
    });

    // Sort Radios in Popover
    root.querySelectorAll('.lame-filter-popover--sort input[name="sort_by"]').forEach(radio => {
      radio.addEventListener('change', () => {
        state.sortBy = radio.value;
        updateUI();
        desktopDropdowns.forEach(dd => dd.classList.remove('is-open'));
        applyFiltersToPage();
      });
    });

    // Price Apply button
    root.querySelector('[data-price-apply]')?.addEventListener('click', () => {
      const pMin = root.querySelector('[data-price-min]')?.value || '';
      const pMax = root.querySelector('[data-price-max]')?.value || '';
      state.priceMin = pMin;
      state.priceMax = pMax;
      updateUI();
      desktopDropdowns.forEach(dd => dd.classList.remove('is-open'));
      applyFiltersToPage();
    });

    // Clear all
    clearAllBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        state.vendors.clear();
        state.discounts.clear();
        state.availability.clear();
        state.priceMin = '';
        state.priceMax = '';
        updateUI();
        applyFiltersToPage();
      });
    });

    /* ------------------------------------------------------------------------
       6. Section Rendering API AJAX Fetch & URL State
       ------------------------------------------------------------------------ */
    let isFetching = false;

    const fetchAndSwapResults = async (url) => {
      if (isFetching) return;
      isFetching = true;

      const resultsList = document.querySelector('results-list');
      const resultsContainer = resultsList || document.querySelector('.product-grid-container') || document.querySelector('#ResultsList')?.parentElement;
      if (resultsContainer) {
        resultsContainer.style.transition = 'opacity 0.2s ease';
        resultsContainer.style.opacity = '0.4';
        resultsContainer.style.pointerEvents = 'none';
      }

      try {
        const sectionId = resultsList?.getAttribute('section-id') || document.querySelector('[section-id]')?.getAttribute('section-id') || document.querySelector('.product-grid-container')?.closest('.shopify-section')?.id?.replace('shopify-section-', '');
        let fetchUrl = url;
        if (sectionId) {
          fetchUrl += (fetchUrl.includes('?') ? '&' : '?') + `section_id=${encodeURIComponent(sectionId)}`;
        }

        const res = await fetch(fetchUrl, {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const htmlText = await res.text();
        const doc = new DOMParser().parseFromString(htmlText, 'text/html');

        // Swap product grid
        const newGrid = doc.querySelector('#ResultsList') || doc.querySelector('.product-grid');
        const curGrid = document.querySelector('#ResultsList') || document.querySelector('.product-grid');
        if (newGrid && curGrid) {
          curGrid.innerHTML = newGrid.innerHTML;
        } else if (newGrid && resultsContainer) {
          const target = resultsContainer.querySelector('.product-grid') || resultsContainer;
          target.innerHTML = newGrid.innerHTML;
        }

        // Swap pagination
        const newPagination = doc.querySelector('.pagination-wrapper, pagination-controls, [data-pagination]');
        const curPagination = document.querySelector('.pagination-wrapper, pagination-controls, [data-pagination]');
        if (newPagination && curPagination) {
          curPagination.replaceWith(newPagination);
        } else if (curPagination && !newPagination) {
          curPagination.innerHTML = '';
        }

        // Filter cards in DOM to ensure immediate client accuracy & live counts
        filterCardsInDOM();
        if (window.LameSmartCollection && typeof window.LameSmartCollection.sort === 'function') {
          window.LameSmartCollection.sort();
        }
      } catch (err) {
        console.error('Error fetching collection results, falling back to full reload:', err);
        try {
          const resFull = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
          if (!resFull.ok) throw new Error(`HTTP ${resFull.status}`);
          const htmlText = await resFull.text();
          const doc = new DOMParser().parseFromString(htmlText, 'text/html');
          const newGrid = doc.querySelector('#ResultsList') || doc.querySelector('.product-grid');
          const curGrid = document.querySelector('#ResultsList') || document.querySelector('.product-grid');
          if (newGrid && curGrid) curGrid.innerHTML = newGrid.innerHTML;
          filterCardsInDOM();
          if (window.LameSmartCollection && typeof window.LameSmartCollection.sort === 'function') {
            window.LameSmartCollection.sort();
          }
        } catch (fullErr) {
          window.location.href = url;
        }
      } finally {
        if (resultsContainer) {
          resultsContainer.style.opacity = '1';
          resultsContainer.style.pointerEvents = '';
        }
        isFetching = false;
      }
    };

    const filterCardsInDOM = () => {
      const curGrid = document.querySelector('#ResultsList') || document.querySelector('.product-grid') || document.querySelector('[data-testid="product-grid"]');
      const cards = document.querySelectorAll('.product-grid > li:not([data-lame-empty-notice]), [data-testid="product-grid"] > li:not([data-lame-empty-notice]), .product-grid .product-grid__item, .product-grid .lame-category-shop__item');
      const hasActiveFilters = state.vendors.size > 0 || state.discounts.size > 0 || state.availability.size > 0 || Boolean(state.priceMin) || Boolean(state.priceMax);

      if (!cards.length) {
        if (hasActiveFilters && curGrid) {
          let emptyNotice = document.querySelector('[data-lame-empty-notice]');
          if (!emptyNotice) {
            emptyNotice = document.createElement('li');
            emptyNotice.className = 'lame-filter-empty-state';
            emptyNotice.setAttribute('data-lame-empty-notice', 'true');
            emptyNotice.style.cssText = 'grid-column: 1 / -1; width: 100%; text-align: center; padding: 4rem 1.5rem; list-style: none;';
            emptyNotice.innerHTML = `
              <p style="font-size: 1.25rem; color: #4a1f46; font-weight: 700; margin: 0 0 0.5rem;">No products found</p>
              <p style="font-size: 0.95rem; color: #666; margin: 0 0 1.5rem;">No products match your selected filters. Try clearing some filters to see more results.</p>
              <button type="button" style="padding: 0.6rem 1.6rem; background: #4a1f46; color: #fff; border-radius: 999px; cursor: pointer; border: none; font-weight: 600; font-size: 0.9rem;" onclick="document.querySelector('[data-filter-clear-all]')?.click()">Clear all filters</button>
            `;
            curGrid.appendChild(emptyNotice);
          }
          const countEls = root.querySelectorAll('[data-results-count]');
          countEls.forEach(el => el.textContent = `0 products`);
        }
        return;
      }

      let visibleCount = 0;

      cards.forEach(card => {
        let show = true;

        // 1. Vendor
        if (state.vendors.size > 0) {
          const v = (card.dataset.vendor || card.dataset.brand || '').trim();
          if (!hasVendor(v)) show = false;
        }

        // 2. Discount
        if (show && state.discounts.size > 0) {
          const d = parseFloat(card.dataset.discountPercent || '0');
          let matchDiscount = false;
          state.discounts.forEach(minD => {
            if (d >= parseFloat(minD)) matchDiscount = true;
          });
          if (!matchDiscount) show = false;
        }

        // 3. Availability
        if (show && state.availability.size > 0) {
          const isAvail = card.dataset.available === 'true';
          let matchAvail = false;
          if (state.availability.has('1') && isAvail) matchAvail = true;
          if (state.availability.has('0') && !isAvail) matchAvail = true;
          if (!matchAvail) show = false;
        }

        // 4. Price
        if (show) {
          const p = parseFloat(card.dataset.price || '0');
          if (state.priceMin && p < parseFloat(state.priceMin)) show = false;
          if (state.priceMax && p > parseFloat(state.priceMax)) show = false;
        }

        card.style.display = show ? '' : 'none';
        if (show) visibleCount++;
      });

      // Sort visible cards if requested
      if (state.sortBy && state.sortBy !== 'manual' && cards[0]?.parentElement) {
        const grid = cards[0].parentElement;
        const cardArray = Array.from(cards);
        if (state.sortBy === 'price-ascending') {
          cardArray.sort((a, b) => parseFloat(a.dataset.price || 0) - parseFloat(b.dataset.price || 0));
        } else if (state.sortBy === 'price-descending') {
          cardArray.sort((a, b) => parseFloat(b.dataset.price || 0) - parseFloat(a.dataset.price || 0));
        }
        cardArray.forEach(c => grid.appendChild(c));
      }

      // Empty state notice when 0 cards match
      let emptyNotice = document.querySelector('[data-lame-empty-notice]');
      if (visibleCount === 0) {
        if (!emptyNotice && curGrid) {
          emptyNotice = document.createElement('li');
          emptyNotice.className = 'lame-filter-empty-state';
          emptyNotice.setAttribute('data-lame-empty-notice', 'true');
          emptyNotice.style.cssText = 'grid-column: 1 / -1; width: 100%; text-align: center; padding: 4rem 1.5rem; list-style: none;';
          emptyNotice.innerHTML = `
            <p style="font-size: 1.25rem; color: #4a1f46; font-weight: 700; margin: 0 0 0.5rem;">No products found</p>
            <p style="font-size: 0.95rem; color: #666; margin: 0 0 1.5rem;">No products match your selected filters. Try clearing some filters to see more results.</p>
            <button type="button" style="padding: 0.6rem 1.6rem; background: #4a1f46; color: #fff; border-radius: 999px; cursor: pointer; border: none; font-weight: 600; font-size: 0.9rem;" onclick="document.querySelector('[data-filter-clear-all]')?.click()">Clear all filters</button>
          `;
          curGrid.appendChild(emptyNotice);
        }
      } else if (emptyNotice) {
        emptyNotice.remove();
      }

      // Update count indicators
      const countEls = root.querySelectorAll('[data-results-count]');
      countEls.forEach(el => el.textContent = `${visibleCount} products`);

      const sheetApplyBtn = root.querySelector('[data-sheet-apply]');
      if (sheetApplyBtn) {
        sheetApplyBtn.textContent = `Apply (${visibleCount} products)`;
      }
    };

    const applyFiltersToPage = () => {
      const params = new URLSearchParams(window.location.search);

      // Reset filter params
      params.delete('filter.p.vendor');
      params.delete('discount');
      params.delete('filter.v.availability');
      params.delete('filter.v.price.gte');
      params.delete('filter.v.price.lte');
      params.delete('sort_by');
      params.delete('page');

      state.vendors.forEach(v => params.append('filter.p.vendor', v));
      state.discounts.forEach(d => params.append('discount', d));
      state.availability.forEach(a => params.append('filter.v.availability', a));
      if (state.priceMin) params.set('filter.v.price.gte', state.priceMin);
      if (state.priceMax) params.set('filter.v.price.lte', state.priceMax);
      if (state.sortBy && state.sortBy !== 'manual') params.set('sort_by', state.sortBy);

      const newQuery = params.toString();
      const newUrl = `${window.location.pathname}${newQuery ? '?' + newQuery : ''}`;

      window.history.pushState({ path: newUrl }, '', newUrl);
      fetchAndSwapResults(newUrl);
    };

    // Popstate event listener for browser Back/Forward navigation
    window.addEventListener('popstate', () => {
      parseUrlParams();
      updateUI();
      fetchAndSwapResults(window.location.href);
    });

    /* ------------------------------------------------------------------------
       7. Mobile Bottom Sheet
       ------------------------------------------------------------------------ */
    const sheetBackdrop = root.querySelector('[data-sheet-backdrop]');
    const mobileTrigger = root.querySelector('[data-mobile-sheet-open]');
    const sheetCloseBtn = root.querySelector('[data-sheet-close]');
    const sheetApplyBtn = root.querySelector('[data-sheet-apply]');
    const sheetClearBtn = root.querySelector('[data-sheet-clear-all]');

    const openMobileSheet = () => {
      if (!sheetBackdrop) return;
      sheetBackdrop.classList.add('is-visible');
      sheetBackdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      syncMobileSheet();
    };

    const closeMobileSheet = () => {
      if (!sheetBackdrop) return;
      sheetBackdrop.classList.remove('is-visible');
      sheetBackdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    mobileTrigger?.addEventListener('click', openMobileSheet);
    sheetCloseBtn?.addEventListener('click', closeMobileSheet);
    sheetBackdrop?.addEventListener('click', (e) => {
      if (e.target === sheetBackdrop) closeMobileSheet();
    });

    const syncMobileSheet = () => {
      if (!sheetBackdrop) return;
      sheetBackdrop.querySelectorAll('input[type="checkbox"]').forEach(cb => {
        const name = cb.name;
        const val = cb.value;
        if (name === 'sheet.filter.p.vendor') cb.checked = hasVendor(val);
        else if (name === 'sheet.discount') cb.checked = state.discounts.has(val);
        else if (name === 'sheet.filter.v.availability') cb.checked = state.availability.has(val);
      });
      sheetBackdrop.querySelectorAll('input[name="sheet.sort_by"]').forEach(radio => {
        radio.checked = (radio.value === state.sortBy) || (state.sortBy === 'manual' && radio.value === 'manual');
      });
      const pMin = sheetBackdrop.querySelector('[data-sheet-price-min]');
      const pMax = sheetBackdrop.querySelector('[data-sheet-price-max]');
      if (pMin) pMin.value = state.priceMin;
      if (pMax) pMax.value = state.priceMax;
    };

    sheetApplyBtn?.addEventListener('click', () => {
      if (!sheetBackdrop) return;
      state.vendors.clear();
      state.discounts.clear();
      state.availability.clear();

      sheetBackdrop.querySelectorAll('input[type="checkbox"]:checked').forEach(cb => {
        const name = cb.name;
        const val = cb.value;
        if (name === 'sheet.filter.p.vendor') state.vendors.add(val);
        else if (name === 'sheet.discount') state.discounts.add(val);
        else if (name === 'sheet.filter.v.availability') state.availability.add(val);
      });

      const checkedSort = sheetBackdrop.querySelector('input[name="sheet.sort_by"]:checked');
      if (checkedSort) state.sortBy = checkedSort.value;

      const pMin = sheetBackdrop.querySelector('[data-sheet-price-min]')?.value || '';
      const pMax = sheetBackdrop.querySelector('[data-sheet-price-max]')?.value || '';
      state.priceMin = pMin;
      state.priceMax = pMax;

      closeMobileSheet();
      updateUI();
      applyFiltersToPage();
    });

    sheetClearBtn?.addEventListener('click', () => {
      state.vendors.clear();
      state.discounts.clear();
      state.availability.clear();
      state.priceMin = '';
      state.priceMax = '';
      closeMobileSheet();
      updateUI();
      applyFiltersToPage();
    });

    /* ------------------------------------------------------------------------
       8. Global Delegated AJAX Add to Cart
       ------------------------------------------------------------------------ */
    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('form[data-ajax-cart-form]');
      if (!form) return;
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.disabled) return;

      const labelEl = btn.querySelector('.lame-cat-card__btn-label');
      const originalText = labelEl ? labelEl.textContent : 'Add to cart';
      btn.disabled = true;

      const checkIcon = btn.querySelector('.lame-cat-card__btn-check');
      const btnIcon = btn.querySelector('.lame-cat-card__btn-icon');

      try {
        const formData = new FormData(form);
        const res = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });

        if (res.ok) {
          if (checkIcon) checkIcon.style.display = 'inline-flex';
          if (btnIcon) btnIcon.style.display = 'none';
          if (labelEl) labelEl.textContent = 'Added';

          // Update cart count
          fetch('/cart.js')
            .then(r => r.json())
            .then(cart => {
              document.querySelectorAll('[data-cart-count], .cart-count, #cart-icon-bubble span').forEach(el => {
                el.textContent = cart.item_count;
              });
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail: cart }));
              document.dispatchEvent(new CustomEvent('theme:cart:update', { bubbles: true, detail: cart }));
            });

          setTimeout(() => {
            btn.disabled = false;
            if (checkIcon) checkIcon.style.display = 'none';
            if (btnIcon) btnIcon.style.display = '';
            if (labelEl) labelEl.textContent = originalText;
          }, 1500);
        } else {
          throw new Error('Failed to add product to cart');
        }
      } catch (err) {
        btn.disabled = false;
        alert('Could not add to cart. Please try again.');
      }
    });

    // Initial UI render & active card filtering (wait for DOM ready so main-collection products are parsed)
    const initNavigation = () => {
      updateUI();
      filterCardsInDOM();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initNavigation);
    } else {
      initNavigation();
    }
  })();
</script>

