{%- comment -%}
  More Beauty To Love — horizontal promo image cards (brand + offer).
{%- endcomment -%}

{%- liquid
  assign open_new_tab = section.settings.open_in_new_tab
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-beauty-love"
  aria-label="{{ section.settings.heading | default: 'More beauty to love' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-beauty-love__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <header class="lame-beauty-love__header">
        <h2 class="lame-beauty-love__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="lame-beauty-love__scroller" data-beauty-love-scroller>
        <ul class="lame-beauty-love__track" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_image = block.settings.image
              assign card_alt = block.settings.alt | strip
              if card_alt == blank and card_image != blank
                assign card_alt = card_image.alt
              endif
              if card_alt == blank
                assign card_alt = block.settings.title | default: shop.name
              endif
              assign card_link = block.settings.link
              assign brand_logo = block.settings.brand_logo
              assign badge_text = block.settings.badge_text | strip
              assign badge_bg = block.settings.badge_color | default: '#c47a5a'
              assign title = block.settings.title | strip
              assign subtitle = block.settings.subtitle | strip
            -%}

            <li class="lame-beauty-love__slide" {{ block.shopify_attributes }}>
              {%- if card_link != blank -%}
                <a
                  class="lame-beauty-love__card"
                  href="{{ card_link }}"
                  {% if open_new_tab %}target="_blank" rel="noopener"{% endif %}
                >
              {%- else -%}
                <div class="lame-beauty-love__card">
              {%- endif -%}

                <div class="lame-beauty-love__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 900
                      | image_tag:
                        class: 'lame-beauty-love__image',
                        loading: 'lazy',
                        widths: '280, 360, 480, 640, 800, 900',
                        sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 70vw, 78vw',
                        alt: card_alt
                    }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'lame-beauty-love__image placeholder-svg' }}
                  {%- endif -%}

                  {%- if brand_logo != blank -%}
                    <span class="lame-beauty-love__brand">
                      {{
                        brand_logo
                        | image_url: width: 240
                        | image_tag:
                          class: 'lame-beauty-love__brand-image',
                          loading: 'lazy',
                          widths: '80, 120, 160, 240',
                          sizes: '72px',
                          alt: ''
                      }}
                    </span>
                  {%- endif -%}

                  {%- if badge_text != blank -%}
                    <span class="lame-beauty-love__badge" style="--lame-bl-badge: {{ badge_bg }}">
                      {{ badge_text | escape }}
                    </span>
                  {%- endif -%}
                </div>

                {%- if title != blank or subtitle != blank -%}
                  <div class="lame-beauty-love__copy">
                    {%- if title != blank -%}
                      <p class="lame-beauty-love__title">{{ title | escape }}</p>
                    {%- endif -%}
                    {%- if subtitle != blank -%}
                      <p class="lame-beauty-love__subtitle">{{ subtitle | escape }}</p>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- if card_link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif request.design_mode -%}
      <p class="lame-beauty-love__empty">Add promo cards with images in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lame-beauty-love {
    --lame-bl-gap: clamp(0.65rem, 1.4vw, 1rem);
    --lame-bl-radius: 12px;
    --lame-bl-ink: #1a1614;
    --lame-bl-muted: #6b6460;
    --lame-bl-card-w: clamp(11.5rem, 22vw, 15.5rem);
  }

  .lame-beauty-love__wrap {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
  }

  .section--full-width .lame-beauty-love__wrap {
    max-width: 100%;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
  }

  .lame-beauty-love__header {
    text-align: left;
    margin-bottom: clamp(0.85rem, 1.8vw, 1.25rem);
  }

  .lame-beauty-love__heading {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--lame-bl-ink);
  }

  .lame-beauty-love__scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin-inline: calc(var(--lame-bl-gap) * -0.15);
    padding-inline: calc(var(--lame-bl-gap) * 0.15);
    padding-bottom: 0.15rem;
  }

  .lame-beauty-love__scroller::-webkit-scrollbar {
    display: none;
  }

  .lame-beauty-love__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--lame-bl-gap);
    width: max-content;
    min-width: 100%;
  }

  .lame-beauty-love__slide {
    flex: 0 0 var(--lame-bl-card-w);
    width: var(--lame-bl-card-w);
    max-width: var(--lame-bl-card-w);
    scroll-snap-align: start;
  }

  .lame-beauty-love__card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .lame-beauty-love__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--lame-bl-radius);
    background: #f0ebe6;
    aspect-ratio: 3 / 4;
  }

  .lame-beauty-love__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .lame-beauty-love__brand {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 42%;
    min-height: 1.6rem;
    padding: 0.35rem 0.55rem 0.4rem;
    background: rgb(255 255 255 / 0.96);
    border-radius: 0 0 0.55rem 0;
    box-shadow: 0 1px 4px rgb(26 22 20 / 0.08);
  }

  .lame-beauty-love__brand-image {
    display: block;
    width: auto;
    max-width: 4.5rem;
    max-height: 1.35rem;
    height: auto;
    object-fit: contain;
  }

  .lame-beauty-love__badge {
    position: absolute;
    left: 50%;
    bottom: 0.65rem;
    z-index: 1;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100% - 1rem);
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: var(--lame-bl-badge, #c47a5a);
    color: #fff;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.58rem, 1.1vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 4px 12px rgb(26 22 20 / 0.18);
  }

  .lame-beauty-love__copy {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    min-width: 0;
    padding-inline: 0.1rem;
  }

  .lame-beauty-love__title {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.92rem, 1.5vw, 1.05rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--lame-bl-ink);
  }

  .lame-beauty-love__subtitle {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.78rem, 1.2vw, 0.88rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--lame-bl-muted);
  }

  .lame-beauty-love__empty {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--lame-bl-muted);
    border: 1px dashed rgb(26 22 20 / 0.18);
    border-radius: var(--lame-bl-radius);
  }

  /* Tablet: match top discount tile footprint (large swipe cards) */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .section--page-width .lame-beauty-love__wrap,
    .section--full-width .lame-beauty-love__wrap {
      max-width: none;
      padding-inline: 0.5rem;
    }

    .lame-beauty-love {
      --lame-bl-gap: 0.75rem;
      --lame-bl-radius: 12px;
      --lame-bl-card-w: 100%;
    }

    .lame-beauty-love__scroller {
      margin-inline: 0;
      padding-inline: 0;
    }

    .lame-beauty-love__track {
      min-width: 0;
      width: 100%;
    }

    .lame-beauty-love__slide {
      flex: 0 0 100%;
      width: 100%;
      max-width: 100%;
    }

    .lame-beauty-love__media {
      aspect-ratio: unset;
      height: auto;
      background: transparent;
    }

    .lame-beauty-love__image {
      width: 100%;
      height: auto !important;
      max-height: none;
      object-fit: contain;
      object-position: center;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-beauty-love {
      --lame-bl-card-w: min(78vw, 16.5rem);
      --lame-bl-radius: 10px;
    }

    .section--full-width .lame-beauty-love__wrap,
    .section--page-width .lame-beauty-love__wrap {
      padding-inline: 0.75rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .lame-beauty-love__card:hover .lame-beauty-love__image {
      transform: scale(1.03);
    }

    .lame-beauty-love__image {
      transition: transform 0.35s ease;
    }

    .lame-beauty-love__media {
      overflow: hidden;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "More beauty to love",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "More Beauty To Love"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand logo (optional)"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional)",
          "default": "Brighten & De-Tan"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge color",
          "default": "#c47a5a"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upto 20% off"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "On Entire Range!"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "More beauty to love",
      "category": "Banners",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "badge_text": "Brighten & De-Tan",
            "badge_color": "#c47a5a",
            "title": "Upto 20% off",
            "subtitle": "On Entire Range!"
          }
        },
        {
          "type": "card",
          "settings": {
            "badge_text": "Health & Vitality",
            "badge_color": "#2f6f7a",
            "title": "Upto 30% off",
            "subtitle": "On Entire Range!"
          }
        },
        {
          "type": "card",
          "settings": {
            "badge_text": "Body Mists",
            "badge_color": "#4a4a4a",
            "title": "Upto 15% off",
            "subtitle": "on Bestsellers!"
          }
        },
        {
          "type": "card",
          "settings": {
            "badge_text": "",
            "title": "New Launch!",
            "subtitle": "Discover more"
          }
        }
      ]
    }
  ]
}
{% endschema %}
