{%- comment -%}
  Discover Beauty — spotlight-style promo cards (4:5 media + overlays).
  All cards render in one grid. Same-brand cards merge into one tile with an internal slide.
{%- endcomment -%}

{%- liquid
  assign open_new_tab = section.settings.open_in_new_tab
  assign products_url = routes.all_products_collection_url
  if collections['our-products'] != blank and collections['our-products'].url != blank
    assign products_url = collections['our-products'].url
  endif
  if section.settings.products_collection != blank
    assign products_url = section.settings.products_collection.url
  endif

  assign autoplay_ms = section.settings.autoplay_seconds | default: 5 | times: 1000
  assign fade_ms = section.settings.fade_ms | default: 900
  assign category_filter = section.settings.category_filter | strip | downcase
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-beauty-love{% if category_filter != blank %} lame-beauty-love--category{% endif %}"
  aria-label="{{ section.settings.heading | default: 'Discover Beauty' | escape }}"
  data-beauty-sync
  data-autoplay="{{ autoplay_ms }}"
  data-fade="{{ fade_ms }}"
  style="--lame-bl-fade: {{ fade_ms }}ms;"
  {{ section.shopify_attributes }}
>
  <div class="lame-beauty-love__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <header class="lame-beauty-love__header">
        {% render 'lame-section-heading',
          title: section.settings.heading,
          alignment: 'center',
          size: 'large'
        %}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="lame-beauty-love__viewport" data-beauty-row>
      <ul class="lame-beauty-love__grid" data-beauty-track role="list">
        {%- liquid
          assign rendered_brands = '|'
        -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_image = block.settings.image
                    assign fallback_asset = block.settings.fallback_asset | strip
                    unless card_image != blank or fallback_asset != blank
                      continue
                    endunless
                    if category_filter != blank
                      assign card_category = block.settings.category | strip | downcase
                      unless card_category == category_filter
                        continue
                      endunless
                    endif

                    assign brand_key = block.settings.brand_text | strip | downcase
                    if brand_key == blank
                      assign brand_key = 'id-' | append: block.id
                    endif
                    assign brand_token = '|' | append: brand_key | append: '|'
                    if rendered_brands contains brand_token
                      continue
                    endif
                    assign rendered_brands = rendered_brands | append: brand_key | append: '|'

                    assign brand_logo = block.settings.brand_logo
                    assign brand_text = block.settings.brand_text | strip

                    assign slide_count = 0
                    for slide_block in section.blocks
                      unless slide_block.settings.image != blank or slide_block.settings.fallback_asset != blank
                        continue
                      endunless
                      if category_filter != blank
                        assign slide_category = slide_block.settings.category | strip | downcase
                        unless slide_category == category_filter
                          continue
                        endunless
                      endif
                      assign slide_brand = slide_block.settings.brand_text | strip | downcase
                      if slide_brand == blank
                        assign slide_brand = 'id-' | append: slide_block.id
                      endif
                      if slide_brand == brand_key
                        assign slide_count = slide_count | plus: 1
                      endif
                    endfor

                    assign link_type = block.settings.link_type | default: 'brand'
                    assign card_link = blank

                    case link_type
                      when 'product'
                        if block.settings.product != blank
                          assign card_link = block.settings.product.url
                        endif
                      when 'collection'
                        if block.settings.collection != blank
                          assign card_link = block.settings.collection.url
                        endif
                      when 'brand'
                        assign brand_name = block.settings.link_brand | strip
                        if brand_name == blank or brand_name == 'other'
                          if block.settings.link_brand_other != blank
                            assign brand_name = block.settings.link_brand_other | strip
                          else
                            assign brand_name = brand_text
                          endif
                        endif
                        if brand_name != blank
                          assign brand_slug = brand_name | handleize
                          assign brand_name_down = brand_name | downcase
                          if brand_name_down contains 'lamstone'
                            assign brand_slug = 'lamstone-healthcare'
                          endif
                          if brand_name_down == 'jovees'
                            assign brand_slug = 'jovees-herbal'
                          endif
                          if brand_name_down == 'sebamed'
                            assign brand_slug = 'sebamed'
                          endif
                          assign card_link = products_url | append: '?brand=' | append: brand_slug
                        endif
                      when 'custom'
                        assign card_link = block.settings.link
                    endcase

                    if card_link == blank and block.settings.link != blank
                      assign card_link = block.settings.link
                    endif
                  -%}

                  <li
                    class="lame-beauty-love__item{% if slide_count > 1 %} lame-beauty-love__item--slider{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if slide_count > 1 -%}
                      <article
                        class="lame-beauty-love__card lame-beauty-love__card--slider"
                        data-beauty-slider
                        aria-roledescription="carousel"
                        aria-label="{{ brand_text | default: 'Brand' | escape }} products"
                      >
                        <div class="lame-beauty-love__media">
                          {%- if brand_logo != blank or brand_text != blank -%}
                            <span class="lame-beauty-love__brand">
                              {%- if brand_logo != blank -%}
                                {{
                                  brand_logo
                                  | image_url: width: 240
                                  | image_tag:
                                    class: 'lame-beauty-love__brand-image',
                                    loading: 'lazy',
                                    widths: '80, 120, 160, 240',
                                    sizes: '80px',
                                    alt: ''
                                }}
                              {%- else -%}
                                <span class="lame-beauty-love__brand-text">{{ brand_text | escape }}</span>
                              {%- endif -%}
                            </span>
                          {%- endif -%}

                          <div class="lame-beauty-love__slides">
                            {%- assign slide_index = 0 -%}
                            {%- for slide_block in section.blocks -%}
                              {%- liquid
                                unless slide_block.settings.image != blank or slide_block.settings.fallback_asset != blank
                                  continue
                                endunless
                                if category_filter != blank
                                  assign slide_category = slide_block.settings.category | strip | downcase
                                  unless slide_category == category_filter
                                    continue
                                  endunless
                                endif
                                assign slide_brand = slide_block.settings.brand_text | strip | downcase
                                if slide_brand == blank
                                  assign slide_brand = 'id-' | append: slide_block.id
                                endif
                                unless slide_brand == brand_key
                                  continue
                                endunless

                                assign slide_image = slide_block.settings.image
                                assign slide_fallback = slide_block.settings.fallback_asset | strip
                                assign slide_alt = slide_block.settings.alt | strip
                                if slide_alt == blank and slide_image != blank
                                  assign slide_alt = slide_image.alt
                                endif
                                if slide_alt == blank
                                  assign slide_alt = slide_block.settings.title | default: shop.name
                                endif
                                assign slide_badge = slide_block.settings.badge_text | strip
                                assign slide_badge_bg = slide_block.settings.badge_color | default: '#8b6b5a'
                                assign slide_title = slide_block.settings.title | strip
                                assign slide_subtitle = slide_block.settings.subtitle | strip

                                assign slide_link_type = slide_block.settings.link_type | default: 'brand'
                                assign slide_link = blank
                                case slide_link_type
                                  when 'product'
                                    if slide_block.settings.product != blank
                                      assign slide_link = slide_block.settings.product.url
                                    endif
                                  when 'collection'
                                    if slide_block.settings.collection != blank
                                      assign slide_link = slide_block.settings.collection.url
                                    endif
                                  when 'brand'
                                    assign slide_brand_name = slide_block.settings.link_brand | strip
                                    if slide_brand_name == blank or slide_brand_name == 'other'
                                      if slide_block.settings.link_brand_other != blank
                                        assign slide_brand_name = slide_block.settings.link_brand_other | strip
                                      else
                                        assign slide_brand_name = slide_block.settings.brand_text | strip
                                      endif
                                    endif
                                    if slide_brand_name != blank
                                      assign slide_brand_slug = slide_brand_name | handleize
                                      assign slide_brand_down = slide_brand_name | downcase
                                      if slide_brand_down contains 'lamstone'
                                        assign slide_brand_slug = 'lamstone-healthcare'
                                      endif
                                      if slide_brand_down == 'jovees'
                                        assign slide_brand_slug = 'jovees-herbal'
                                      endif
                                      if slide_brand_down == 'sebamed'
                                        assign slide_brand_slug = 'sebamed'
                                      endif
                                      assign slide_link = products_url | append: '?brand=' | append: slide_brand_slug
                                    endif
                                  when 'custom'
                                    assign slide_link = slide_block.settings.link
                                endcase
                                if slide_link == blank and slide_block.settings.link != blank
                                  assign slide_link = slide_block.settings.link
                                endif
                                if slide_link == blank
                                  assign slide_link = card_link
                                endif
                              -%}

                              {%- if slide_link != blank -%}
                                <a
                                  class="lame-beauty-love__slide{% if slide_index == 0 %} is-active{% endif %}"
                                  href="{{ slide_link }}"
                                  data-beauty-slide
                                  data-index="{{ slide_index }}"
                                  aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                                  {% if open_new_tab %}target="_blank" rel="noopener"{% endif %}
                                  {{ slide_block.shopify_attributes }}
                                >
                              {%- else -%}
                                <div
                                  class="lame-beauty-love__slide{% if slide_index == 0 %} is-active{% endif %}"
                                  data-beauty-slide
                                  data-index="{{ slide_index }}"
                                  aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                                  {{ slide_block.shopify_attributes }}
                                >
                              {%- endif -%}

                                {%- if slide_image != blank -%}
                                  {{
                                    slide_image
                                    | image_url: width: 900
                                    | image_tag:
                                      class: 'lame-beauty-love__image',
                                      loading: 'lazy',
                                      widths: '280, 360, 480, 640, 800, 900',
                                      sizes: '(min-width: 1100px) 18vw, (min-width: 990px) 24vw, 30vw',
                                      alt: slide_alt
                                  }}
                                {%- elsif slide_fallback != blank -%}
                                  <img
                                    class="lame-beauty-love__image"
                                    src="{{ slide_fallback | asset_url }}"
                                    alt="{{ slide_alt | escape }}"
                                    width="720"
                                    height="900"
                                    loading="lazy"
                                    decoding="async"
                                  >
                                {%- endif -%}

                                {%- if slide_badge != blank -%}
                                  <span class="lame-beauty-love__badge" style="--lame-bl-badge: {{ slide_badge_bg }}">
                                    {{ slide_badge | escape }}
                                  </span>
                                {%- endif -%}

                              {%- if slide_link != blank -%}
                                </a>
                              {%- else -%}
                                </div>
                              {%- endif -%}

                              {%- assign slide_index = slide_index | plus: 1 -%}
                            {%- endfor -%}
                          </div>

                        </div>

                        <div class="lame-beauty-love__dots" role="tablist" aria-label="{{ brand_text | escape }} slides">
                          {%- for i in (1..slide_count) -%}
                            <button
                              type="button"
                              class="lame-beauty-love__dot{% if forloop.first %} is-active{% endif %}"
                              data-beauty-dot
                              data-index="{{ forloop.index0 }}"
                              role="tab"
                              aria-label="Slide {{ forloop.index }} of {{ slide_count }}"
                              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                            ></button>
                          {%- endfor -%}
                        </div>

                        <div class="lame-beauty-love__copy-stack">
                          {%- assign slide_index = 0 -%}
                          {%- for slide_block in section.blocks -%}
                            {%- liquid
                              unless slide_block.settings.image != blank or slide_block.settings.fallback_asset != blank
                                continue
                              endunless
                              if category_filter != blank
                                assign slide_category = slide_block.settings.category | strip | downcase
                                unless slide_category == category_filter
                                  continue
                                endunless
                              endif
                              assign slide_brand = slide_block.settings.brand_text | strip | downcase
                              if slide_brand == blank
                                assign slide_brand = 'id-' | append: slide_block.id
                              endif
                              unless slide_brand == brand_key
                                continue
                              endunless
                              assign slide_title = slide_block.settings.title | strip
                              assign slide_subtitle = slide_block.settings.subtitle | strip
                            -%}
                            {%- if slide_title != blank or slide_subtitle != blank -%}
                              <div
                                class="lame-beauty-love__copy{% if slide_index == 0 %} is-active{% endif %}"
                                data-beauty-copy
                                data-index="{{ slide_index }}"
                                aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                              >
                                {%- if slide_title != blank -%}
                                  <p class="lame-beauty-love__title">{{ slide_title | escape }}</p>
                                {%- endif -%}
                                {%- if slide_subtitle != blank -%}
                                  <p class="lame-beauty-love__subtitle">{{ slide_subtitle | escape }}</p>
                                {%- endif -%}
                              </div>
                            {%- else -%}
                              <div
                                class="lame-beauty-love__copy lame-beauty-love__copy--empty{% if slide_index == 0 %} is-active{% endif %}"
                                data-beauty-copy
                                data-index="{{ slide_index }}"
                                aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                              ></div>
                            {%- endif -%}
                            {%- assign slide_index = slide_index | plus: 1 -%}
                          {%- endfor -%}
                        </div>
                      </article>
                    {%- else -%}
                      {%- liquid
                        assign card_alt = block.settings.alt | strip
                        if card_alt == blank and card_image != blank
                          assign card_alt = card_image.alt
                        endif
                        if card_alt == blank
                          assign card_alt = block.settings.title | default: shop.name
                        endif
                        assign badge_text = block.settings.badge_text | strip
                        assign badge_bg = block.settings.badge_color | default: '#8b6b5a'
                        assign title = block.settings.title | strip
                        assign subtitle = block.settings.subtitle | strip
                      -%}

                      {%- if card_link != blank -%}
                        <a
                          class="lame-beauty-love__card lame-beauty-love__card--link"
                          href="{{ card_link }}"
                          {% if open_new_tab %}target="_blank" rel="noopener"{% endif %}
                        >
                      {%- else -%}
                        <div class="lame-beauty-love__card">
                      {%- endif -%}

                        <div class="lame-beauty-love__media">
                          {%- if card_image != blank -%}
                            {{
                              card_image
                              | image_url: width: 900
                              | image_tag:
                                class: 'lame-beauty-love__image',
                                loading: 'lazy',
                                widths: '280, 360, 480, 640, 800, 900',
                                sizes: '(min-width: 1100px) 18vw, (min-width: 990px) 24vw, 30vw',
                                alt: card_alt
                            }}
                          {%- elsif fallback_asset != blank -%}
                            <img
                              class="lame-beauty-love__image"
                              src="{{ fallback_asset | asset_url }}"
                              alt="{{ card_alt | escape }}"
                              width="720"
                              height="900"
                              loading="lazy"
                              decoding="async"
                            >
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag: 'lame-beauty-love__image placeholder-svg' }}
                          {%- endif -%}

                          {%- if brand_logo != blank or brand_text != blank -%}
                            <span class="lame-beauty-love__brand">
                              {%- if brand_logo != blank -%}
                                {{
                                  brand_logo
                                  | image_url: width: 240
                                  | image_tag:
                                    class: 'lame-beauty-love__brand-image',
                                    loading: 'lazy',
                                    widths: '80, 120, 160, 240',
                                    sizes: '80px',
                                    alt: ''
                                }}
                              {%- else -%}
                                <span class="lame-beauty-love__brand-text">{{ brand_text | escape }}</span>
                              {%- endif -%}
                            </span>
                          {%- endif -%}

                          {%- if badge_text != blank -%}
                            <span class="lame-beauty-love__badge" style="--lame-bl-badge: {{ badge_bg }}">
                              {{ badge_text | escape }}
                            </span>
                          {%- endif -%}
                        </div>

                        {%- if title != blank or subtitle != blank -%}
                          <div class="lame-beauty-love__copy">
                            {%- if title != blank -%}
                              <p class="lame-beauty-love__title">{{ title | escape }}</p>
                            {%- endif -%}
                            {%- if subtitle != blank -%}
                              <p class="lame-beauty-love__subtitle">{{ subtitle | escape }}</p>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                      {%- if card_link != blank -%}
                        </a>
                      {%- else -%}
                        </div>
                      {%- endif -%}
                    {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      </div>
    {%- elsif request.design_mode -%}
      <p class="lame-beauty-love__empty">Add promo cards with images in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    if (window.__lameBeautyLoveBoot) return;
    window.__lameBeautyLoveBoot = true;

    const DEFAULT_INTERVAL = 5000;
    const SWIPE_THRESHOLD = 36;
    const sliders = [];
    let sharedTimer = null;
    let intervalMs = DEFAULT_INTERVAL;
    let pausedByHover = 0;

    class BeautyBrandSlider {
      constructor(root) {
        this.root = root;
        this.media = root.querySelector('.lame-beauty-love__media');
        this.slides = [...root.querySelectorAll('[data-beauty-slide]')];
        this.copies = [...root.querySelectorAll('[data-beauty-copy]')];
        this.dots = [...root.querySelectorAll('[data-beauty-dot]')];
        this.index = 0;
        this.suppressClick = false;
        if (this.slides.length < 2) return;

        this.dots.forEach((dot) => {
          dot.addEventListener('click', (event) => {
            event.preventDefault();
            event.stopPropagation();
            this.goTo(Number(dot.dataset.index) || 0);
            restartShared();
          });
        });

        this.bindGestures();
        this.goTo(0);
      }

      bindGestures() {
        if (!this.media) return;

        let tracking = false;
        let axis = null;
        let dragged = false;
        let startX = 0;
        let startY = 0;
        let pointerId = null;

        const endGesture = (event) => {
          if (!tracking) return;
          tracking = false;
          this.media.classList.remove('is-dragging');

          if (pointerId != null && this.media.hasPointerCapture?.(pointerId)) {
            try {
              this.media.releasePointerCapture(pointerId);
            } catch (_) {
              /* ignore */
            }
          }
          pointerId = null;

          const dx = event.clientX - startX;
          if (axis === 'x' && Math.abs(dx) >= SWIPE_THRESHOLD) {
            if (dx < 0) this.next();
            else this.prev();
            this.suppressClick = true;
          } else {
            this.suppressClick = dragged;
          }

          axis = null;
          dragged = false;
          restartShared();
        };

        this.media.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          if (event.target.closest('[data-beauty-dot]')) return;

          tracking = true;
          axis = null;
          dragged = false;
          this.suppressClick = false;
          startX = event.clientX;
          startY = event.clientY;
          pointerId = event.pointerId;
          this.media.classList.add('is-dragging');
          stopShared();

          try {
            this.media.setPointerCapture(event.pointerId);
          } catch (_) {
            /* ignore */
          }
        });

        this.media.addEventListener(
          'pointermove',
          (event) => {
            if (!tracking) return;

            const dx = event.clientX - startX;
            const dy = event.clientY - startY;

            if (!axis) {
              if (Math.abs(dx) < 8 && Math.abs(dy) < 8) return;
              axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
              if (axis === 'y') {
                tracking = false;
                this.media.classList.remove('is-dragging');
                if (pointerId != null && this.media.hasPointerCapture?.(pointerId)) {
                  try {
                    this.media.releasePointerCapture(pointerId);
                  } catch (_) {
                    /* ignore */
                  }
                }
                pointerId = null;
                restartShared();
                return;
              }
            }

            if (axis === 'x') {
              if (event.cancelable) event.preventDefault();
              if (Math.abs(dx) > 10) dragged = true;
            }
          },
          { passive: false }
        );

        this.media.addEventListener('pointerup', endGesture);
        this.media.addEventListener('pointercancel', endGesture);

        this.root.addEventListener(
          'click',
          (event) => {
            if (!this.suppressClick) return;
            event.preventDefault();
            event.stopPropagation();
            this.suppressClick = false;
          },
          true
        );
      }

      goTo(next) {
        const total = this.slides.length;
        if (total < 2) return;
        this.index = ((next % total) + total) % total;

        this.slides.forEach((slide, i) => {
          const active = i === this.index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          if (slide.tagName === 'A') {
            slide.tabIndex = active ? 0 : -1;
          }
        });

        this.copies.forEach((copy, i) => {
          const active = i === this.index;
          copy.classList.toggle('is-active', active);
          copy.setAttribute('aria-hidden', active ? 'false' : 'true');
        });

        this.dots.forEach((dot, i) => {
          const active = i === this.index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
      }

      next() {
        this.goTo(this.index + 1);
      }

      prev() {
        this.goTo(this.index - 1);
      }
    }

    function stopShared() {
      if (sharedTimer) {
        window.clearInterval(sharedTimer);
        sharedTimer = null;
      }
    }

    function startShared() {
      stopShared();
      if (intervalMs <= 0 || sliders.length === 0 || pausedByHover > 0) return;
      if (document.hidden) return;
      sharedTimer = window.setInterval(() => {
        sliders.forEach((slider) => slider.next());
      }, intervalMs);
    }

    function restartShared() {
      stopShared();
      startShared();
    }

    function bindSectionPause(section) {
      if (!section || section.dataset.beautyPauseBound) return;
      section.dataset.beautyPauseBound = '1';

      const refreshPause = () => {
        const anyHovered = [...document.querySelectorAll('[data-beauty-slider]')].some((card) => {
          return card.matches(':hover') || card.contains(document.activeElement);
        });
        if (anyHovered) {
          pausedByHover = 1;
          stopShared();
        } else {
          pausedByHover = 0;
          startShared();
        }
      };

      section.querySelectorAll('[data-beauty-slider]').forEach((card) => {
        card.addEventListener('mouseenter', refreshPause);
        card.addEventListener('mouseleave', refreshPause);
        card.addEventListener('focusin', refreshPause);
        card.addEventListener('focusout', () => {
          window.requestAnimationFrame(refreshPause);
        });
      });
    }

    function init() {
      const sections = [...document.querySelectorAll('[data-beauty-sync]')];
      if (!sections.length) return;

      const rawInterval = Number(sections[0].dataset.autoplay);
      intervalMs = Number.isFinite(rawInterval) ? rawInterval : DEFAULT_INTERVAL;

      sections.forEach((section) => {
        section.querySelectorAll('[data-beauty-slider]').forEach((el) => {
          if (el.dataset.beautySliderReady) return;
          el.dataset.beautySliderReady = '1';
          const slider = new BeautyBrandSlider(el);
          if (slider.slides.length >= 2) sliders.push(slider);
        });
        bindSectionPause(section);
      });

      startShared();
    }

    const rowMedia = window.matchMedia('(min-width: 750px) and (max-width: 1199px)');
    const reduceRowMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const rowLoops = [];

    function bindRow(viewport) {
      if (!viewport || viewport.dataset.beautyRowReady) return;
      const track = viewport.querySelector('[data-beauty-track]');
      if (!track) return;
      viewport.dataset.beautyRowReady = '1';

      let timer = null;
      let paused = false;
      let inView = false;
      let busy = false;

      const cards = () => [...track.querySelectorAll(':scope > .lame-beauty-love__item')];

      const gapOf = () => {
        const styles = getComputedStyle(track);
        return parseFloat(styles.columnGap || styles.gap) || 0;
      };

      const overflows = () => rowMedia.matches && track.scrollWidth > viewport.clientWidth + 4;

      const release = () => {
        busy = false;
      };

      const afterScroll = (done) => {
        let settled = false;
        const finish = () => {
          if (settled) return;
          settled = true;
          viewport.removeEventListener('scrollend', finish);
          done();
        };
        if ('onscrollend' in window) {
          viewport.addEventListener('scrollend', finish, { once: true });
        }
        window.setTimeout(finish, 700);
      };

      const step = () => {
        const items = cards();
        if (busy || !overflows() || items.length < 2) return;
        const card = items[0];
        const delta = card.offsetWidth + gapOf();
        if (delta <= 1) return;
        busy = true;
        viewport.scrollBy({ left: delta, behavior: reduceRowMotion.matches ? 'auto' : 'smooth' });
        afterScroll(() => {
          const previousBehavior = viewport.style.scrollBehavior;
          const previousSnap = viewport.style.scrollSnapType;
          viewport.style.scrollBehavior = 'auto';
          viewport.style.scrollSnapType = 'none';
          track.appendChild(card);
          viewport.scrollLeft = Math.max(0, viewport.scrollLeft - delta);
          requestAnimationFrame(() => {
            viewport.style.scrollBehavior = previousBehavior;
            viewport.style.scrollSnapType = previousSnap;
            release();
          });
        });
      };

      const stop = () => {
        if (timer) {
          window.clearInterval(timer);
          timer = null;
        }
      };

      const syncTimer = () => {
        stop();
        const canScroll = overflows();
        viewport.classList.toggle('is-centered', rowMedia.matches && !canScroll);
        if (!canScroll) {
          viewport.scrollLeft = 0;
          return;
        }
        if (paused || !inView || reduceRowMotion.matches || document.hidden) return;
        timer = window.setInterval(() => {
          if (document.hidden) return;
          step();
        }, 4500);
      };

      viewport.addEventListener('mouseenter', () => {
        paused = true;
        stop();
      });
      viewport.addEventListener('mouseleave', () => {
        paused = false;
        syncTimer();
      });
      viewport.addEventListener('focusin', () => {
        paused = true;
        stop();
      });
      viewport.addEventListener('focusout', () => {
        paused = false;
        syncTimer();
      });
      viewport.addEventListener(
        'touchstart',
        () => {
          paused = true;
          stop();
        },
        { passive: true }
      );
      viewport.addEventListener(
        'touchend',
        () => {
          window.setTimeout(() => {
            paused = false;
            syncTimer();
          }, 4500);
        },
        { passive: true }
      );

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              inView = entry.isIntersecting;
              syncTimer();
            });
          },
          { threshold: 0.4 }
        );
        observer.observe(viewport);
      } else {
        inView = true;
      }

      rowLoops.push({ sync: syncTimer, stop });
      syncTimer();
      window.setTimeout(syncTimer, 400);
    }

    function bootRows() {
      document.querySelectorAll('[data-beauty-row]').forEach(bindRow);
      rowLoops.forEach((loop) => loop.sync());
    }

    function boot() {
      /* Start as soon as DOM is ready so slides advance before the section is scrolled into view */
      init();
      bootRows();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopShared();
      else if (pausedByHover === 0) startShared();
      rowLoops.forEach((loop) => loop.sync());
    });

    window.addEventListener('resize', () => {
      rowLoops.forEach((loop) => loop.sync());
    });

    if (rowMedia.addEventListener) {
      rowMedia.addEventListener('change', () => {
        rowLoops.forEach((loop) => loop.sync());
      });
    }

    document.addEventListener('shopify:section:load', (event) => {
      if (!event.target.querySelector?.('[data-beauty-sync], [data-beauty-slider]')) return;
      stopShared();
      sliders.length = 0;
      pausedByHover = 0;
      document.querySelectorAll('[data-beauty-slider]').forEach((el) => {
        delete el.dataset.beautySliderReady;
      });
      document.querySelectorAll('[data-beauty-sync]').forEach((section) => {
        delete section.dataset.beautyPauseBound;
      });
      rowLoops.forEach((loop) => loop.stop());
      document.querySelectorAll('[data-beauty-row]').forEach((row) => {
        delete row.dataset.beautyRowReady;
      });
      rowLoops.length = 0;
      boot();
    });
  })();
</script>

{% stylesheet %}
  .lame-beauty-love {
    --lame-bl-gap: 0.75rem;
    --lame-bl-col-gap: clamp(0.4rem, 1.2vw, 0.75rem);
    --lame-bl-radius: 10px;
    --lame-bl-ink: #1a1a1a;
    --lame-bl-muted: #5c5c5c;
    --lame-bl-max-cols: 2;
    --lame-bl-fade: 900ms;
  }

  .lame-beauty-love__wrap {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: clamp(0.85rem, 2.5vw, 1.25rem);
    container-type: inline-size;
    container-name: lame-beauty;
  }

  .section--full-width .lame-beauty-love__wrap {
    max-width: 100%;
  }

  .lame-beauty-love__header {
    text-align: center;
    margin-bottom: clamp(1rem, 2.2vw, 1.5rem);
  }

  .lame-beauty-love__header .lame-section-heading {
    margin: 0;
  }

  .lame-beauty-love__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--lame-bl-max-cols), minmax(0, 1fr));
    gap: var(--lame-bl-gap) var(--lame-bl-col-gap);
    width: 100%;
  }

  .lame-beauty-love__item {
    width: auto;
    max-width: none;
    min-width: 0;
    box-sizing: border-box;
  }

  .lame-beauty-love__card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .lame-beauty-love__card--link {
    cursor: pointer;
  }

  .lame-beauty-love__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--lame-bl-radius);
    background: #f3f1ef;
    line-height: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
  }

  .lame-beauty-love__card--slider .lame-beauty-love__media {
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }

  .lame-beauty-love__card--slider .lame-beauty-love__media.is-dragging {
    cursor: grabbing;
  }

  .lame-beauty-love__card--slider .lame-beauty-love__slide {
    -webkit-user-drag: none;
  }

  .lame-beauty-love__slides {
    position: absolute;
    inset: 0;
    transform: translateZ(0);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lame-beauty-love__slide {
    position: absolute;
    inset: 0;
    display: block;
    margin: 0;
    padding: 0;
    border: 0;
    text-decoration: none;
    color: inherit;
    opacity: 0;
    z-index: 0;
    pointer-events: none;
    backface-visibility: hidden;
    transform: translateZ(0);
    transition: opacity var(--lame-bl-fade, 900ms) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lame-beauty-love__slide.is-active {
    opacity: 1;
    z-index: 1;
    pointer-events: auto;
  }

  .lame-beauty-love__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }

  .lame-beauty-love__brand {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(92%, 11rem);
    min-height: 1.35rem;
    padding: 0.28rem 0.45rem 0.32rem;
    background: rgb(255 255 255 / 0.78);
    border-radius: 0 0 0.4rem 0;
    backdrop-filter: blur(1.5px);
    box-sizing: border-box;
    overflow: hidden;
  }

  .lame-beauty-love__brand-image {
    display: block;
    width: auto;
    max-width: 4.25rem;
    max-height: 1.05rem;
    height: auto;
    object-fit: contain;
  }

  .lame-beauty-love__brand-text {
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-transform: uppercase;
    color: #1a2a4a;
    white-space: normal;
    overflow-wrap: anywhere;
    word-break: break-word;
    text-align: left;
  }

  .lame-beauty-love__badge {
    position: absolute;
    left: 50%;
    bottom: 0.55rem;
    z-index: 1;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100% - 0.9rem);
    padding: 0.28rem 0.65rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--lame-bl-badge, #8b6b5a) 88%, transparent);
    color: #fff;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.56rem, 1vw, 0.68rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(2px);
  }

  @supports not (background: color-mix(in srgb, red 50%, transparent)) {
    .lame-beauty-love__badge {
      background: var(--lame-bl-badge, #8b6b5a);
    }
  }

  .lame-beauty-love__card--slider {
    gap: 0.4rem;
  }

  .lame-beauty-love__dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    margin: 0;
    padding: 0;
  }

  .lame-beauty-love__dot {
    width: 0.38rem;
    height: 0.38rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(26 26 26 / 0.22);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .lame-beauty-love__dot.is-active {
    background: rgb(26 26 26 / 0.75);
    transform: scale(1.15);
  }

  .lame-beauty-love__copy,
  .lame-beauty-love__copy-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    text-align: center;
    padding-inline: 0.15rem;
  }

  .lame-beauty-love__copy-stack {
    position: relative;
    min-height: 2.6em;
  }

  .lame-beauty-love__copy-stack .lame-beauty-love__copy {
    position: absolute;
    inset-inline: 0;
    top: 0;
    width: 100%;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--lame-bl-fade, 900ms) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .lame-beauty-love__copy-stack .lame-beauty-love__copy.is-active {
    opacity: 1;
    pointer-events: auto;
    z-index: 1;
  }

  .lame-beauty-love__title {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.82rem, 1.35vw, 0.95rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--lame-bl-ink);
  }

  .lame-beauty-love__subtitle {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.7rem, 1.1vw, 0.8rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--lame-bl-muted);
  }

  .lame-beauty-love__empty {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--lame-bl-muted);
    border: 1px dashed rgb(26 22 20 / 0.18);
    border-radius: var(--lame-bl-radius);
  }

  @media screen and (min-width: 750px) {
    .lame-beauty-love {
      --lame-bl-gap: 0.9rem;
      --lame-bl-radius: 10px;
      --lame-bl-max-cols: 3;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-beauty-love {
      --lame-bl-max-cols: 3;
    }
  }

  @media screen and (min-width: 1200px) {
    .lame-beauty-love--category .lame-beauty-love__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: calc((100% - 2 * var(--lame-bl-col-gap)) * 2 / 3 + var(--lame-bl-col-gap));
      margin-inline: auto;
    }
  }

  /* Tablet: one row, three cards visible, the rest scroll in */
  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .lame-beauty-love__viewport {
      overflow-x: auto;
      overflow-y: hidden;
      container-type: inline-size;
      container-name: beauty-row;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .lame-beauty-love__viewport::-webkit-scrollbar {
      display: none;
    }

    .lame-beauty-love__grid,
    .lame-beauty-love--category .lame-beauty-love__grid {
      display: flex;
      flex-wrap: nowrap;
      width: max-content;
      max-width: none;
      margin-inline: 0;
      grid-template-columns: none;
    }

    .lame-beauty-love__item {
      flex: 0 0 calc((100cqi - (2 * var(--lame-bl-col-gap))) / 3);
      width: calc((100cqi - (2 * var(--lame-bl-col-gap))) / 3);
      max-width: none;
      scroll-snap-align: start;
    }

    .lame-beauty-love__viewport.is-centered .lame-beauty-love__grid {
      width: 100%;
      justify-content: center;
    }
  }

  @media screen and (min-width: 1100px) {
    .lame-beauty-love {
      --lame-bl-gap: 1rem;
      --lame-bl-max-cols: 3;
    }

    .lame-beauty-love__brand {
      min-height: 1.45rem;
      padding: 0.32rem 0.5rem 0.36rem;
      max-width: min(90%, 12rem);
    }

    .lame-beauty-love__brand-image {
      max-width: 4.75rem;
      max-height: 1.15rem;
    }

    .lame-beauty-love__brand-text {
      font-size: 0.58rem;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-beauty-love {
      --lame-bl-radius: 14px;
      --lame-bl-gap: 0.55rem;
      --lame-bl-col-gap: 0.7rem;
      --lame-bl-max-cols: 2;
    }

    .lame-beauty-love__wrap {
      padding-inline: 0.85rem;
      overflow: visible;
    }

    .lame-beauty-love__card,
    .lame-beauty-love__card--slider {
      gap: 0.45rem;
    }

    .lame-beauty-love__brand {
      max-width: min(92%, 9rem);
      min-height: 1.35rem;
      padding: 0.22rem 0.45rem 0.24rem;
    }

    .lame-beauty-love__brand-image {
      max-width: 3.6rem;
      max-height: 0.95rem;
    }

    .lame-beauty-love__brand-text {
      font-size: 0.62rem;
      letter-spacing: 0.04em;
    }

    .lame-beauty-love__badge {
      bottom: 0.45rem;
      max-width: calc(100% - 0.7rem);
      padding: 0.22rem 0.45rem;
      font-size: 0.62rem;
      line-height: 1.2;
      white-space: normal;
      text-align: center;
    }

    .lame-beauty-love__dot {
      width: 0.38rem;
      height: 0.38rem;
    }

    .lame-beauty-love__copy-stack {
      min-height: 3.6rem;
    }

    .lame-beauty-love__title {
      font-size: 0.92rem;
      line-height: 1.25;
    }

    .lame-beauty-love__subtitle {
      font-size: 0.75rem;
      line-height: 1.3;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .lame-beauty-love__card:hover .lame-beauty-love__slides,
    .lame-beauty-love__card:hover > .lame-beauty-love__media > .lame-beauty-love__image {
      transform: scale(1.03);
    }

    .lame-beauty-love__media > .lame-beauty-love__image {
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .lame-beauty-love__media {
      overflow: hidden;
    }

    .lame-beauty-love__dot:hover {
      background: rgb(26 26 26 / 0.55);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lame-beauty-love {
      --lame-bl-fade: 1ms;
    }

    .lame-beauty-love__slide,
    .lame-beauty-love__copy-stack .lame-beauty-love__copy,
    .lame-beauty-love__slides,
    .lame-beauty-love__media > .lame-beauty-love__image {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Discover Beauty",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Beauty"
    },
    {
      "type": "text",
      "id": "category_filter",
      "label": "Only show this category",
      "info": "Leave blank to show every card. Use baby-mom to show only the Gentle Baby Care cards."
    },
    {
      "type": "paragraph",
      "content": "All promo cards show in one grid. Matching brand names combine into one card with a slideshow. Each promo card can open a product page, a brand filter on the shop/collection page, a collection, or a custom URL."
    },
    {
      "type": "collection",
      "id": "products_collection",
      "label": "Shop / products page",
      "info": "Used when a card links brand-wise. Defaults to Our Products if available, otherwise All products."
    },
    {
      "type": "range",
      "id": "autoplay_seconds",
      "label": "Brand slide autoplay",
      "info": "All brand cards advance together on this interval from page load (even before you scroll to the section). Set to 0 to disable.",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "fade_ms",
      "label": "Slide fade duration",
      "info": "Crossfade length between products inside a brand card.",
      "min": 400,
      "max": 1400,
      "step": 100,
      "unit": "ms",
      "default": 900
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "Upload or replace this card’s promo image in the theme editor. Recommended: portrait ~4:5."
        },
        {
          "type": "text",
          "id": "fallback_asset",
          "label": "Fallback asset filename",
          "info": "Theme asset used only when Card image is empty (e.g. lame-beauty-love-01-sebamed.png)"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Brand logo",
          "info": "Optional. Replaceable in the theme editor for each card."
        },
        {
          "type": "text",
          "id": "brand_text",
          "label": "Brand name",
          "info": "Shown in the top-left badge when no logo is uploaded. Matching brand names become slides in one card."
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text"
        },
        {
          "type": "color",
          "id": "badge_color",
          "label": "Badge color",
          "default": "#8b6b5a"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "info": "Used when the section is set to show only one category, such as baby care above Gentle Baby Care.",
          "options": [
