{%- comment -%}
  Discover Beauty — spotlight-style promo cards (4:5 media + overlays).
  Each card can link product-wise, brand-wise (shop filter), collection, or custom URL.
{%- endcomment -%}

{%- liquid
  assign open_new_tab = section.settings.open_in_new_tab
  assign products_url = routes.all_products_collection_url
  if collections['our-products'] != blank and collections['our-products'].url != blank
    assign products_url = collections['our-products'].url
  endif
  if section.settings.products_collection != blank
    assign products_url = section.settings.products_collection.url
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-beauty-love"
  aria-label="{{ section.settings.heading | default: 'Discover Beauty' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-beauty-love__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <header class="lame-beauty-love__header">
        {% render 'lame-section-heading',
          title: section.settings.heading,
          alignment: 'left',
          size: 'large'
        %}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="lame-beauty-love__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_image = block.settings.image
            assign fallback_asset = block.settings.fallback_asset | strip
            assign card_alt = block.settings.alt | strip
            if card_alt == blank and card_image != blank
              assign card_alt = card_image.alt
            endif
            if card_alt == blank
              assign card_alt = block.settings.title | default: shop.name
            endif

            assign brand_logo = block.settings.brand_logo
            assign brand_text = block.settings.brand_text | strip
            assign badge_text = block.settings.badge_text | strip
            assign badge_bg = block.settings.badge_color | default: '#8b6b5a'
            assign title = block.settings.title | strip
            assign subtitle = block.settings.subtitle | strip

            assign link_type = block.settings.link_type | default: 'brand'
            assign card_link = blank

            case link_type
              when 'product'
                if block.settings.product != blank
                  assign card_link = block.settings.product.url
                endif
              when 'collection'
                if block.settings.collection != blank
                  assign card_link = block.settings.collection.url
                endif
              when 'brand'
                assign brand_name = block.settings.link_brand | strip
                if brand_name == blank or brand_name == 'other'
                  if block.settings.link_brand_other != blank
                    assign brand_name = block.settings.link_brand_other | strip
                  else
                    assign brand_name = brand_text
                  endif
                endif
                if brand_name != blank
                  assign brand_slug = brand_name | handleize
                  assign brand_name_down = brand_name | downcase
                  if brand_name_down contains 'lamstone'
                    assign brand_slug = 'lamstone-healthcare'
                  endif
                  if brand_name_down == 'jovees'
                    assign brand_slug = 'jovees-herbal'
                  endif
                  if brand_name_down == 'sebamed'
                    assign brand_slug = 'sebamed'
                  endif
                  assign card_link = products_url | append: '?brand=' | append: brand_slug
                endif
              when 'custom'
                assign card_link = block.settings.link
            endcase

            if card_link == blank and block.settings.link != blank
              assign card_link = block.settings.link
            endif
          -%}

          <li class="lame-beauty-love__item" {{ block.shopify_attributes }}>
            {%- if card_link != blank -%}
              <a
                class="lame-beauty-love__card lame-beauty-love__card--link"
                href="{{ card_link }}"
                {% if open_new_tab %}target="_blank" rel="noopener"{% endif %}
              >
            {%- else -%}
              <div class="lame-beauty-love__card">
            {%- endif -%}

              <div class="lame-beauty-love__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'lame-beauty-love__image',
                      loading: 'lazy',
                      widths: '280, 360, 480, 640, 800, 900',
                      sizes: '(min-width: 1100px) 18vw, (min-width: 990px) 24vw, 30vw',
                      alt: card_alt
                  }}
                {%- elsif fallback_asset != blank -%}
                  <img
                    class="lame-beauty-love__image"
                    src="{{ fallback_asset | asset_url }}"
                    alt="{{ card_alt | escape }}"
                    width="720"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'lame-beauty-love__image placeholder-svg' }}
                {%- endif -%}

                {%- if brand_logo != blank or brand_text != blank -%}
                  <span class="lame-beauty-love__brand">
                    {%- if brand_logo != blank -%}
                      {{
                        brand_logo
                        | image_url: width: 240
                        | image_tag:
                          class: 'lame-beauty-love__brand-image',
                          loading: 'lazy',
                          widths: '80, 120, 160, 240',
                          sizes: '80px',
                          alt: ''
                      }}
                    {%- else -%}
                      <span class="lame-beauty-love__brand-text">{{ brand_text | escape }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- if badge_text != blank -%}
                  <span class="lame-beauty-love__badge" style="--lame-bl-badge: {{ badge_bg }}">
                    {{ badge_text | escape }}
                  </span>
                {%- endif -%}
              </div>

              {%- if title != blank or subtitle != blank -%}
                <div class="lame-beauty-love__copy">
                  {%- if title != blank -%}
                    <p class="lame-beauty-love__title">{{ title | escape }}</p>
                  {%- endif -%}
                  {%- if subtitle != blank -%}
                    <p class="lame-beauty-love__subtitle">{{ subtitle | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <p class="lame-beauty-love__empty">Add promo cards with images in the theme editor.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lame-beauty-love {
    --lame-bl-gap: 0.75rem;
    --lame-bl-radius: 10px;
    --lame-bl-ink: #1a1a1a;
    --lame-bl-muted: #5c5c5c;
  }

  .lame-beauty-love__wrap {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: clamp(0.85rem, 2.5vw, 1.25rem);
  }

  .section--full-width .lame-beauty-love__wrap {
    max-width: 100%;
  }

  .lame-beauty-love__header {
    text-align: left;
    margin-bottom: clamp(1rem, 2.2vw, 1.5rem);
  }

  .lame-beauty-love__header .lame-section-heading {
    margin: 0;
  }

  .lame-beauty-love__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--lame-bl-gap) clamp(0.4rem, 1.2vw, 0.75rem);
    width: 100%;
  }

  .lame-beauty-love__item {
    min-width: 0;
  }

  .lame-beauty-love__card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .lame-beauty-love__card--link {
    cursor: pointer;
  }

  .lame-beauty-love__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--lame-bl-radius);
    background: #f3f1ef;
    line-height: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
  }

  .lame-beauty-love__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .lame-beauty-love__brand {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 55%;
    min-height: 1.85rem;
    padding: 0.42rem 0.7rem 0.48rem;
    background: rgb(255 255 255 / 0.72);
    border-radius: 0 0 0.5rem 0;
    backdrop-filter: blur(1.5px);
  }

  .lame-beauty-love__brand-image {
    display: block;
    width: auto;
    max-width: 5.5rem;
    max-height: 1.5rem;
    height: auto;
    object-fit: contain;
  }

  .lame-beauty-love__brand-text {
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.7rem, 1.15vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.1;
    text-transform: uppercase;
    color: #1a2a4a;
    white-space: nowrap;
  }

  .lame-beauty-love__badge {
    position: absolute;
    left: 50%;
    bottom: 0.55rem;
    z-index: 1;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: calc(100% - 0.9rem);
    padding: 0.28rem 0.65rem;
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--lame-bl-badge, #8b6b5a) 88%, transparent);
    color: #fff;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.56rem, 1vw, 0.68rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(2px);
  }

  @supports not (background: color-mix(in srgb, red 50%, transparent)) {
    .lame-beauty-love__badge {
      background: var(--lame-bl-badge, #8b6b5a);
    }
  }

  .lame-beauty-love__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    min-width: 0;
    text-align: center;
    padding-inline: 0.15rem;
  }

  .lame-beauty-love__title {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.82rem, 1.35vw, 0.95rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--lame-bl-ink);
  }

  .lame-beauty-love__subtitle {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(0.7rem, 1.1vw, 0.8rem);
    font-weight: 400;
    line-height: 1.35;
    color: var(--lame-bl-muted);
  }

  .lame-beauty-love__empty {
    margin: 0;
    padding: 1.5rem;
    text-align: center;
    color: var(--lame-bl-muted);
    border: 1px dashed rgb(26 22 20 / 0.18);
    border-radius: var(--lame-bl-radius);
  }

  @media screen and (min-width: 750px) {
    .lame-beauty-love {
      --lame-bl-gap: 0.9rem;
      --lame-bl-radius: 10px;
    }

    /* Tablet / medium (e.g. Realme Pad 2) — 4 across */
    .lame-beauty-love__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-beauty-love__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1100px) {
    .lame-beauty-love {
      --lame-bl-gap: 1rem;
    }

    .lame-beauty-love__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .lame-beauty-love__brand {
      min-height: 2.05rem;
      padding: 0.48rem 0.8rem 0.52rem;
    }

    .lame-beauty-love__brand-image {
      max-width: 6rem;
      max-height: 1.6rem;
    }

    .lame-beauty-love__brand-text {
      font-size: clamp(0.76rem, 1.05vw, 0.88rem);
    }
  }

  @media screen and (max-width: 749px) {
    .lame-beauty-love {
      --lame-bl-radius: 8px;
      --lame-bl-gap: 0.55rem;
    }

    .lame-beauty-love__wrap {
      padding-inline: 0.75rem;
    }

    .lame-beauty-love__brand {
      max-width: 70%;
      min-height: 1.45rem;
      padding: 0.28rem 0.45rem 0.32rem;
    }

    .lame-beauty-love__brand-image {
      max-width: 3.75rem;
      max-height: 1.1rem;
    }

    .lame-beauty-love__brand-text {
      font-size: 0.58rem;
    }

    .lame-beauty-love__badge {
      bottom: 0.35rem;
      padding: 0.2rem 0.4rem;
      font-size: 0.5rem;
    }

    .lame-beauty-love__title {
      font-size: 0.72rem;
    }

    .lame-beauty-love__subtitle {
      font-size: 0.62rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .lame-beauty-love__card:hover .lame-beauty-love__image {
      transform: scale(1.03);
    }

    .lame-beauty-love__image {
      transition: transform 0.35s ease;
    }

    .lame-beauty-love__media {
      overflow: hidden;
    }
  }
{% endstylesheet %}

{% schema %}
