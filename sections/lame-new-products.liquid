{% liquid
  assign new_collection = collections[section.settings.collection]
  if new_collection == blank
    assign new_collection = collections.all
  endif

  assign view_all_url = new_collection.url
  if new_collection == blank
    assign view_all_url = routes.all_products_collection_url
  endif
  if view_all_url contains '?'
    assign view_all_url = view_all_url | append: '&sort_by=created-descending'
  else
    assign view_all_url = view_all_url | append: '?sort_by=created-descending'
  endif

  assign products_to_show = section.settings.products_to_show
  assign per_brand_limit = section.settings.per_brand_limit | default: 1
  assign products_shown = 0
  assign seen_ids = '||'
  assign seen_brands = '||'
  assign skip_ids = '||'

  comment
    Avoid repeating products already shown in Best Selling (first items of All / selected skip collection).
  endcomment
  assign skip_collection = collections[section.settings.skip_collection]
  if skip_collection == blank
    assign skip_collection = collections.all
  endif
  if skip_collection != blank
    for skip_product in skip_collection.products limit: section.settings.skip_bestseller_count
      assign skip_ids = skip_ids | append: skip_product.id | append: '||'
    endfor
  endif
%}

{% capture arrival_products_markup %}
  {% paginate new_collection.products by 250 %}
    {% assign newest_products = new_collection.products | sort: 'created_at' | reverse %}

    {% comment %}
      Pass 1: newest product(s) per brand so the row mixes brands
      instead of many items from one vendor that were added together.
    {% endcomment %}
    {% for product in newest_products %}
      {% if products_shown >= products_to_show %}
        {% break %}
      {% endif %}

      {% assign id_token = '||' | append: product.id | append: '||' %}
      {% if seen_ids contains id_token %}
        {% continue %}
      {% endif %}
      {% if skip_ids contains id_token %}
        {% continue %}
      {% endif %}

      {% capture brand_raw %}
        {% render 'lame-product-brand-name', product: product %}
      {% endcapture %}
      {% assign brand_key = brand_raw | strip | downcase | handleize %}
      {% if brand_key == blank %}
        {% assign brand_key = 'unknown' %}
      {% endif %}

      {% assign brand_token = '||' | append: brand_key | append: '||' %}
      {% assign brand_parts = seen_brands | split: brand_token %}
      {% assign brand_count = brand_parts.size | minus: 1 %}
      {% if brand_count >= per_brand_limit %}
        {% continue %}
      {% endif %}

      {% assign seen_brands = seen_brands | append: brand_key | append: '||' %}
      {% assign seen_ids = seen_ids | append: product.id | append: '||' %}

      {% render 'lame-flash-deal-product',
        product: product,
        product_index: products_shown,
        products_limit: products_to_show,
        badge_label: section.settings.badge_label,
        add_to_cart_label: section.settings.add_to_cart_label,
        sold_out_label: section.settings.sold_out_label,
        review_count_fallback: section.settings.review_count_fallback,
        save_label_prefix: section.settings.save_label_prefix,
        reveal_delay: products_shown,
        modulo: 2
      %}
      {% assign products_shown = products_shown | plus: 1 %}
    {% endfor %}

    {% comment %}
      Pass 2: if fewer brands than slots, fill with next unique newest products
      (still no duplicate product ids, and still skip Best Selling items).
    {% endcomment %}
    {% if products_shown < products_to_show %}
      {% for product in newest_products %}
        {% if products_shown >= products_to_show %}
          {% break %}
        {% endif %}

        {% assign id_token = '||' | append: product.id | append: '||' %}
        {% if seen_ids contains id_token %}
          {% continue %}
        {% endif %}
        {% if skip_ids contains id_token %}
          {% continue %}
        {% endif %}
        {% assign seen_ids = seen_ids | append: product.id | append: '||' %}

        {% render 'lame-flash-deal-product',
          product: product,
          product_index: products_shown,
          products_limit: products_to_show,
          badge_label: section.settings.badge_label,
          add_to_cart_label: section.settings.add_to_cart_label,
          sold_out_label: section.settings.sold_out_label,
          review_count_fallback: section.settings.review_count_fallback,
          save_label_prefix: section.settings.save_label_prefix,
          reveal_delay: products_shown,
          modulo: 2
        %}
        {% assign products_shown = products_shown | plus: 1 %}
      {% endfor %}
    {% endif %}
  {% endpaginate %}
{% endcapture %}

{{ 'lame-flash-deal.css' | asset_url | stylesheet_tag }}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal lame-new-products"
  data-flash-deal-carousel
  style="--lame-flash-visible-count: {{ products_shown | at_least: 1 | at_most: products_to_show }};"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-flash-deal__header lame-new-products__header" data-lame-reveal>
      <div class="lame-new-products__header-row">
        {% render 'lame-section-heading',
          title: section.settings.heading,
          alignment: 'left',
          size: 'large'
        %}
        {% if section.settings.view_all_label != blank %}
          <a class="lame-new-products__view-all" href="{{ view_all_url }}">{{ section.settings.view_all_label }}</a>
        {% endif %}
      </div>
    </header>

    <div class="lame-flash-deal__carousel">
      <button
        type="button"
        class="lame-flash-deal__nav lame-flash-deal__nav--prev"
        data-flash-prev
        aria-label="{{ section.settings.prev_label }}"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>

      <div class="lame-flash-deal__viewport" data-flash-viewport>
        <ul class="lame-flash-deal__track" role="list" data-flash-track>
          {% if products_shown > 0 %}
            {{ arrival_products_markup }}
          {% else %}
            {% for i in (1..products_to_show) %}
              <li class="lame-flash-deal__item" data-lame-reveal>
                <article class="lame-flash-card">
                  <div class="lame-flash-card__media">
                    <span class="lame-flash-card__badge">{{ section.settings.badge_label | default: 'NEW' }}</span>
                    <a href="#" class="lame-flash-card__media-link" tabindex="-1" aria-hidden="true">
                      {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-flash-card__image placeholder-svg' }}
                    </a>
                  </div>
                  <div class="lame-flash-card__body">
                    <h3 class="lame-flash-card__title">
                      <a href="#">{{ section.settings.placeholder_title }}</a>
                    </h3>
                    <div class="lame-flash-card__price-row">
                      <span class="lame-flash-card__price">{{ section.settings.placeholder_price | default: '₹899' }}</span>
                    </div>
                    <div class="lame-flash-card__actions">
                      <form class="lame-flash-card__form">
                        <button type="button" class="lame-flash-card__atc" disabled>
                          {{ section.settings.add_to_cart_label }}
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <button
        type="button"
        class="lame-flash-deal__nav lame-flash-deal__nav--next"
        data-flash-next
        aria-label="{{ section.settings.next_label }}"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-new-products .lame-new-products__header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }

  .lame-new-products .lame-new-products__header-row .lame-section-heading {
    margin: 0;
    min-width: 0;
  }

  .lame-new-products .lame-new-products__view-all {
    flex-shrink: 0;
    margin-bottom: 0.55rem;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--lame-cos-forest, 45 74 34));
    text-decoration: none;
    white-space: nowrap;
  }

  .lame-new-products .lame-new-products__view-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    const viewport = section.querySelector('[data-flash-viewport]');
    const track = section.querySelector('[data-flash-track]');
    const prev = section.querySelector('[data-flash-prev]');
    const next = section.querySelector('[data-flash-next]');
    const scrollEl = viewport || track;

    if (scrollEl && track) {
      const updateCarouselLayout = () => {
        const overflows = track.scrollWidth > scrollEl.clientWidth + 4;
        scrollEl.classList.toggle('is-scrollable', overflows);
        scrollEl.classList.toggle('is-centered', !overflows);
        prev?.toggleAttribute('hidden', !overflows);
        next?.toggleAttribute('hidden', !overflows);
        if (!overflows) {
          scrollEl.scrollLeft = 0;
        }
      };

      const scrollBySlide = (dir) => {
        const slide = track.querySelector('.lame-flash-deal__item');
        if (!slide) return;
        const gap = parseFloat(getComputedStyle(track).gap) || 16;
        scrollEl.scrollBy({ left: dir * (slide.offsetWidth + gap), behavior: 'smooth' });
      };

      updateCarouselLayout();
      window.addEventListener('resize', () => {
        updateCarouselLayout();
        if (!scrollEl.classList.contains('is-scrollable')) {
          scrollEl.scrollLeft = 0;
        }
      });

      prev?.addEventListener('click', () => scrollBySlide(-1));
      next?.addEventListener('click', () => scrollBySlide(1));
    }

    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        const formData = new FormData(form);
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { resource: cartData, sourceId: '{{ section.id }}', data: { source: 'new-products-atc' } },
            })
          );
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "New arrivals grid",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "save_label_prefix", "label": "Savings label", "default": "You Save" },
    { "type": "text", "id": "badge_label", "label": "New badge", "default": "NEW" },
    { "type": "text", "id": "review_count_fallback", "label": "Review count fallback", "default": "120" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Newest products are picked first, limited per brand so the same vendor does not fill the row."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "per_brand_limit",
      "label": "Max products per brand",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Keeps New Arrivals mixed across brands. Extra slots fill with other newest products if needed."
    },
    {
      "type": "collection",
      "id": "skip_collection",
      "label": "Skip products from (Best Selling)",
      "info": "Products already shown in this collection (usually All / Best Selling) are not repeated here."
    },
    {
      "type": "range",
      "id": "skip_bestseller_count",
      "label": "Skip first N from that collection",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 8,
      "info": "Match Best Selling “products to show” so those cards do not repeat below."
    },
    { "type": "text", "id": "prev_label", "label": "Previous label", "default": "Previous products" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Next products" },
    { "type": "text", "id": "placeholder_title", "label": "Placeholder title", "default": "Product title" },
    { "type": "text", "id": "placeholder_price", "label": "Placeholder price", "default": "₹899" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [{ "name": "New arrivals grid", "category": "Products" }]
}
{% endschema %}
