{% liquid
  assign new_collection = collections[section.settings.collection]
  if new_collection == blank
    assign new_collection = collections.all
  endif

  assign view_all_url = new_collection.url
  if new_collection == blank
    assign view_all_url = routes.all_products_collection_url
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-new-products"
  {{ section.shopify_attributes }}
>
  <div class="lame-new-products__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-new-products__header" data-lame-reveal>
      {% if section.settings.heading != blank %}
        <h2 class="lame-new-products__title">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.view_all_label != blank %}
        <a class="lame-new-products__view-all" href="{{ view_all_url }}">{{ section.settings.view_all_label }}</a>
      {% endif %}
    </header>

    <ul class="lame-new-products__grid" role="list">
      {% for product in new_collection.products limit: section.settings.products_to_show %}
        <li class="lame-new-products__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 5 }}">
          {% render 'lame-home-product-card',
            product: product,
            card_style: 'grid',
            show_sale_badge: section.settings.show_sale_badge,
            show_type: section.settings.show_vendor,
            show_rating: section.settings.show_rating
          %}
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-new-products__item" data-lame-reveal>
            <article class="lame-home-product-card lame-home-product-card--grid">
              <div class="lame-home-product-card__media">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-home-product-card__image placeholder-svg' }}
              </div>
              <div class="lame-home-product-card__body">
                <h3 class="lame-home-product-card__title">{{ section.settings.placeholder_title }}</h3>
                <p class="lame-home-product-card__price">{{ section.settings.placeholder_price }}</p>
              </div>
            </article>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-new-products__wrap {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .lame-new-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .lame-new-products__title {
    margin: 0;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 700;
    color: #111;
    text-transform: capitalize;
  }

  .lame-new-products__view-all {
    font-size: 0.78rem;
    color: rgb(0 0 0 / 0.65);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .lame-new-products__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .lame-new-products__item {
    min-width: 0;
  }

  .lame-new-products .lame-home-product-card--grid {
    border: 1px solid rgb(0 0 0 / 0.1);
    background: #fff;
    height: 100%;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__media {
    aspect-ratio: 1 / 1;
    background: #f7f7f7;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__body {
    padding: 0.65rem 0.55rem 0.75rem;
    text-align: center;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__type {
    font-size: 0.62rem;
    color: rgb(0 0 0 / 0.5);
    margin: 0 0 0.2rem;
    text-transform: capitalize;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__title {
    font-size: 0.78rem;
    margin: 0 0 0.25rem;
    line-height: 1.25;
    font-weight: 600;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__rating {
    justify-content: center;
    margin-bottom: 0.2rem;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__star {
    color: #f5b301;
    font-size: 0.62rem;
  }

  .lame-new-products .lame-home-product-card--grid .lame-home-product-card__price {
    font-size: 0.78rem;
    font-weight: 700;
  }

  @media screen and (min-width: 750px) {
    .lame-new-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-new-products__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.1 }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% schema %}
{
  "name": "New products grid",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Products" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5
    },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show sale badge", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show product type", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "placeholder_title", "label": "Placeholder title", "default": "Product title" },
    { "type": "text", "id": "placeholder_price", "label": "Placeholder price", "default": "$0.00" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [{ "name": "New products grid", "category": "Products" }]
}
{% endschema %}

