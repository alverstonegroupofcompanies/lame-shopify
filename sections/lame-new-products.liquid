{{ 'lame-product-card.css' | asset_url | stylesheet_tag }}

{% liquid
  assign new_collection = collections[section.settings.collection]
  if new_collection == blank
    assign new_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-new-products">
  <div class="lame-new-products__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <header class="lame-new-products__header">
        <h2 class="lame-new-products__title">{{ section.settings.heading }}</h2>
        {% if section.settings.view_all_label != blank and new_collection != blank %}
          <a class="lame-new-products__view-all" href="{{ new_collection.url }}">
            {{ section.settings.view_all_label }}
          </a>
        {% endif %}
      </header>
    {% endif %}

    <ul class="lame-new-products__grid" role="list">
      {% for product in new_collection.products limit: section.settings.products_to_show %}
        <li class="lame-new-products__item">
          {% render 'lame-product-card',
            product: product,
            show_badge: section.settings.show_sale_badge,
            show_vendor: section.settings.show_vendor,
            show_rating: section.settings.show_rating,
            image_sizes: '(min-width: 1200px) 18vw, (min-width: 750px) 28vw, 44vw'
          %}
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-new-products__item">
            <article class="lame-product-card">
              <div class="lame-product-card__media">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-product-card__image placeholder-svg' }}
              </div>
              <div class="lame-product-card__body">
                <h3 class="lame-product-card__title">{{ section.settings.placeholder_title }}</h3>
                <p class="lame-product-card__price">{{ section.settings.placeholder_price }}</p>
              </div>
            </article>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-new-products__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .lame-new-products__title {
    margin: 0;
    flex: 1;
    text-align: center;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #111;
  }

  .lame-new-products__view-all {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #111;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .lame-new-products__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .lame-new-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-new-products__grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "New products grid",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Products"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale discount badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor as category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating row",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Placeholder title",
      "default": "Product title"
    },
    {
      "type": "text",
      "id": "placeholder_price",
      "label": "Placeholder price",
      "default": "$0.00"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "New products grid",
      "category": "Products"
    }
  ]
}
{% endschema %}
