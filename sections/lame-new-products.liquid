{% liquid
  assign brand_filter = section.settings.brand_filter | default: 'lame_only'
  assign target_vendor = section.settings.vendor_filter | default: 'lame' | downcase | strip
  assign products_to_show = section.settings.products_to_show | default: 8
  assign per_brand_limit = section.settings.per_brand_limit | default: 1
  assign products_shown = 0
  assign seen_ids = '||'
  assign seen_brands = '||'
  assign skip_ids = '||'

  comment
    Populate skip ids (Best Selling) — but never skip Lamé products!
  endcomment
  assign skip_collection = collections[section.settings.skip_collection]
  if skip_collection != blank and section.settings.skip_bestseller_count > 0
    for skip_product in skip_collection.products limit: section.settings.skip_bestseller_count
      assign skip_vendor_down = skip_product.vendor | downcase | strip
      unless skip_vendor_down == 'lame' or skip_vendor_down contains 'lamé' or skip_vendor_down contains 'lamstone'
        assign skip_ids = skip_ids | append: skip_product.id | append: '||'
      endunless
    endfor
  endif

  assign new_collection = collections[section.settings.collection]
  if new_collection == blank
    assign new_collection = collections.all
  endif

  assign sc_prod_1 = nil
  assign sc_prod_2 = nil
  assign sc_prod_3 = nil

  assign frag_col = collections.fragrance
  if frag_col == blank or frag_col.products.size == 0
    assign frag_col = collections['our-products']
  endif
  if frag_col == blank or frag_col.products.size == 0
    assign frag_col = collections['all']
  endif

  if section.settings.featured_products.count >= 3
    assign sc_prod_1 = section.settings.featured_products[0]
    assign sc_prod_2 = section.settings.featured_products[1]
    assign sc_prod_3 = section.settings.featured_products[2]
  elsif frag_col != blank and frag_col.products.size > 0
    for p in frag_col.products
      assign v_down = p.vendor | downcase | strip
      assign t_down = p.title | downcase
      assign is_target = false
      if v_down contains 'lame' or v_down contains 'lamé' or v_down contains 'lamstone'
        assign is_target = true
      elsif t_down contains 'lamé' or t_down contains 'lame ' or t_down contains 'mayscent' or t_down contains 'mirage' or t_down contains 'barqat'
        assign is_target = true
      endif

      if is_target
        if sc_prod_1 == nil
          assign sc_prod_1 = p
        elsif sc_prod_2 == nil and p.id != sc_prod_1.id
          assign sc_prod_2 = p
        elsif sc_prod_3 == nil and p.id != sc_prod_1.id and p.id != sc_prod_2.id
          assign sc_prod_3 = p
          break
        endif
      endif
    endfor

    if sc_prod_1 == nil and frag_col.products.size > 0
      assign sc_prod_1 = frag_col.products[0]
    endif
    if sc_prod_2 == nil and frag_col.products.size > 1
      assign sc_prod_2 = frag_col.products[1]
    endif
    if sc_prod_3 == nil and frag_col.products.size > 2
      assign sc_prod_3 = frag_col.products[2]
    endif
  endif

  assign slide_1_product = nil
  assign slide_2_product = nil
  assign slide_3_product = nil

  assign p_mayscent = all_products['lame-mayscent-eau-de-parfum-100ml']
  assign p_blue = all_products['lame-blue-mirage-eau-de-parfum-100ml']
  assign p_barqat = all_products['lame-barqat-eau-de-parfum-100ml']

  if section.settings.featured_products.count >= 3
    assign slide_1_product = section.settings.featured_products[0]
    assign slide_2_product = section.settings.featured_products[1]
    assign slide_3_product = section.settings.featured_products[2]
  else
    if p_mayscent != empty and p_mayscent != blank
      assign slide_1_product = p_mayscent
    elsif sc_prod_1 != nil
      assign slide_1_product = sc_prod_1
    endif

    if p_blue != empty and p_blue != blank
      assign slide_2_product = p_blue
    elsif sc_prod_2 != nil
      assign slide_2_product = sc_prod_2
    endif

    if p_barqat != empty and p_barqat != blank
      assign slide_3_product = p_barqat
    elsif sc_prod_3 != nil
      assign slide_3_product = sc_prod_3
    endif
  endif

  comment
    Slide 1: Mayscent
  endcomment
  assign s1_title = 'Mayscent'
  assign s1_eyebrow = 'LAMÉ HAUTE PARFUMERIE • NO. 01'
  assign s1_subtitle = 'EAU DE PARFUM 100ML'
  assign s1_desc = 'A luminous golden symphony. Fresh citrus brightness unfolding into sparkling bergamot and radiant warmth, anchored by sensual golden amber.'
  assign s1_notes = 'CITRUS, BERGAMOT, GOLDEN AMBER'
  assign s1_price = '₹899'
  assign s1_link = '/products/lame-mayscent-eau-de-parfum-100ml'
  assign s1_img = 'WhatsApp_Image_2026-04-20_at_5.02.57_PM.jpg' | file_url
  assign s1_var_id = ''
  assign s1_avail = true

  if slide_1_product != nil
    assign s1_title = slide_1_product.title
    assign s1_price = slide_1_product.price | money
    assign s1_link = slide_1_product.url
    assign s1_avail = slide_1_product.available
    if slide_1_product.first_available_variant != blank
      assign s1_var_id = slide_1_product.first_available_variant.id
    endif
    if slide_1_product.featured_image != blank
      assign s1_img = slide_1_product.featured_image | image_url: width: 900
    endif
    if slide_1_product.description != blank
      assign s1_desc = slide_1_product.description | strip_html | truncatewords: 24
    endif
  endif

  comment
    Slide 2: Blue Mirage
  endcomment
  assign s2_title = 'Blue Mirage'
  assign s2_eyebrow = 'LAMÉ HAUTE PARFUMERIE • NO. 02'
  assign s2_subtitle = 'EAU DE PARFUM 100ML'
  assign s2_desc = 'Deep oceanic intensity intertwined with crisp aquatic notes, aromatic cedarwood, and an enigmatic veil of smoky sophistication.'
  assign s2_notes = 'AQUATIC, CEDARWOOD, SMOKY MUSK'
  assign s2_price = '₹899'
  assign s2_link = '/products/lame-blue-mirage-eau-de-parfum-100ml'
  assign s2_img = 'lame-blue-mirage-hero.jpg' | asset_url
  assign s2_var_id = ''
  assign s2_avail = true

  if slide_2_product != nil
    assign s2_title = slide_2_product.title
    assign s2_price = slide_2_product.price | money
    assign s2_link = slide_2_product.url
    assign s2_avail = slide_2_product.available
    if slide_2_product.first_available_variant != blank
      assign s2_var_id = slide_2_product.first_available_variant.id
    endif
    if slide_2_product.featured_image != blank
      assign s2_img = slide_2_product.featured_image | image_url: width: 900
    endif
    if slide_2_product.description != blank
      assign s2_desc = slide_2_product.description | strip_html | truncatewords: 24
    endif
  endif

  comment
    Slide 3: Barqat
  endcomment
  assign s3_title = 'Barqat'
  assign s3_eyebrow = 'LAMÉ ROYAL RESERVE • NO. 03'
  assign s3_subtitle = 'EAU DE PARFUM 100ML'
  assign s3_desc = 'A regal oriental blend wrapped in golden warmth. Rare Cambodian oud accented with spiced velvety damask rose and royal amber.'
  assign s3_notes = 'ROYAL OUD, SPICED ROSE, AMBER'
  assign s3_price = '₹999'
  assign s3_link = '/products/lame-barqat-eau-de-parfum-100ml'
  assign s3_img = 'lame-coming-soon-barqat.png' | asset_url
  assign s3_var_id = ''
  assign s3_avail = true

  if slide_3_product != nil
    assign s3_title = slide_3_product.title
    assign s3_price = slide_3_product.price | money
    assign s3_link = slide_3_product.url
    assign s3_avail = slide_3_product.available
    if slide_3_product.first_available_variant != blank
      assign s3_var_id = slide_3_product.first_available_variant.id
    endif
    if slide_3_product.featured_image != blank
      assign s3_img = slide_3_product.featured_image | image_url: width: 900
    endif
    if slide_3_product.description != blank
      assign s3_desc = slide_3_product.description | strip_html | truncatewords: 24
    endif
  endif
-%}

{% capture arrival_products_markup %}
  {%- if section.settings.featured_products.count > 0 -%}
    {%- for product in section.settings.featured_products -%}
      {%- if products_shown >= products_to_show -%}{%- break -%}{%- endif -%}
      {%- assign id_token = '||' | append: product.id | append: '||' -%}
      {%- if seen_ids contains id_token -%}{%- continue -%}{%- endif -%}
      {%- assign seen_ids = seen_ids | append: product.id | append: '||' -%}

      {% render 'lame-flash-deal-product',
        product: product,
        product_index: products_shown,
        products_limit: products_to_show,
        badge_label: section.settings.badge_label,
        add_to_cart_label: section.settings.add_to_cart_label,
        sold_out_label: section.settings.sold_out_label,
        review_count_fallback: section.settings.review_count_fallback,
        save_label_prefix: section.settings.save_label_prefix,
        reveal_delay: products_shown,
        modulo: 2
      %}
      {%- assign products_shown = products_shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if brand_filter == 'lame_only' or brand_filter == 'lame_first' -%}
    {%- if collections.fragrance != blank and products_shown < products_to_show -%}
      {%- for product in collections.fragrance.products -%}
        {%- if products_shown >= products_to_show -%}{%- break -%}{%- endif -%}
        {%- assign id_token = '||' | append: product.id | append: '||' -%}
        {%- if seen_ids contains id_token -%}{%- continue -%}{%- endif -%}

        {%- assign v_down = product.vendor | downcase | strip -%}
        {%- assign t_down = product.title | downcase -%}
        {%- assign is_lame = false -%}
        {%- if v_down == target_vendor or v_down contains 'lame' or v_down contains 'lamé' or v_down contains 'lamstone' -%}
          {%- assign is_lame = true -%}
        {%- elsif t_down contains 'lamé' or t_down contains 'lame ' -%}
          {%- assign is_lame = true -%}
        {%- endif -%}

        {%- if is_lame -%}
          {%- assign seen_ids = seen_ids | append: product.id | append: '||' -%}
          {% render 'lame-flash-deal-product',
            product: product,
            product_index: products_shown,
            products_limit: products_to_show,
            badge_label: section.settings.badge_label,
            add_to_cart_label: section.settings.add_to_cart_label,
            sold_out_label: section.settings.sold_out_label,
            review_count_fallback: section.settings.review_count_fallback,
            save_label_prefix: section.settings.save_label_prefix,
            reveal_delay: products_shown,
            modulo: 2
          %}
          {%- assign products_shown = products_shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if collections['our-products'] != blank and products_shown < products_to_show -%}
      {%- for product in collections['our-products'].products -%}
        {%- if products_shown >= products_to_show -%}{%- break -%}{%- endif -%}
        {%- assign id_token = '||' | append: product.id | append: '||' -%}
        {%- if seen_ids contains id_token -%}{%- continue -%}{%- endif -%}

        {%- assign v_down = product.vendor | downcase | strip -%}
        {%- assign t_down = product.title | downcase -%}
        {%- assign is_lame = false -%}
        {%- if v_down == target_vendor or v_down contains 'lame' or v_down contains 'lamé' or v_down contains 'lamstone' -%}
          {%- assign is_lame = true -%}
        {%- elsif t_down contains 'lamé' or t_down contains 'lame ' -%}
          {%- assign is_lame = true -%}
        {%- endif -%}

        {%- if is_lame -%}
          {%- assign seen_ids = seen_ids | append: product.id | append: '||' -%}
          {% render 'lame-flash-deal-product',
            product: product,
            product_index: products_shown,
            products_limit: products_to_show,
            badge_label: section.settings.badge_label,
            add_to_cart_label: section.settings.add_to_cart_label,
            sold_out_label: section.settings.sold_out_label,
            review_count_fallback: section.settings.review_count_fallback,
            save_label_prefix: section.settings.save_label_prefix,
            reveal_delay: products_shown,
            modulo: 2
          %}
          {%- assign products_shown = products_shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if new_collection != blank and products_shown < products_to_show -%}
      {%- for product in new_collection.products -%}
        {%- if products_shown >= products_to_show -%}{%- break -%}{%- endif -%}
        {%- assign id_token = '||' | append: product.id | append: '||' -%}
        {%- if seen_ids contains id_token -%}{%- continue -%}{%- endif -%}

        {%- assign v_down = product.vendor | downcase | strip -%}
        {%- assign t_down = product.title | downcase -%}
        {%- assign is_lame = false -%}
        {%- if v_down == target_vendor or v_down contains 'lame' or v_down contains 'lamé' or v_down contains 'lamstone' -%}
          {%- assign is_lame = true -%}
        {%- elsif t_down contains 'lamé' or t_down contains 'lame ' -%}
          {%- assign is_lame = true -%}
        {%- endif -%}

        {%- if is_lame -%}
          {%- assign seen_ids = seen_ids | append: product.id | append: '||' -%}
          {% render 'lame-flash-deal-product',
            product: product,
            product_index: products_shown,
            products_limit: products_to_show,
            badge_label: section.settings.badge_label,
            add_to_cart_label: section.settings.add_to_cart_label,
            sold_out_label: section.settings.sold_out_label,
            review_count_fallback: section.settings.review_count_fallback,
            save_label_prefix: section.settings.save_label_prefix,
            reveal_delay: products_shown,
            modulo: 2
          %}
          {%- assign products_shown = products_shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}

  {%- if brand_filter != 'lame_only' and products_shown < products_to_show -%}
    {%- assign newest_products = new_collection.products | sort: 'created_at' | reverse -%}
    {%- for product in newest_products -%}
      {%- if products_shown >= products_to_show -%}{%- break -%}{%- endif -%}

      {%- assign id_token = '||' | append: product.id | append: '||' -%}
      {%- if seen_ids contains id_token -%}{%- continue -%}{%- endif -%}
      {%- if skip_ids contains id_token -%}{%- continue -%}{%- endif -%}

      {%- capture brand_raw -%}
        {% render 'lame-product-brand-name', product: product %}
      {%- endcapture -%}
      {%- assign brand_key = brand_raw | strip | downcase | handleize -%}
      {%- if brand_key == blank -%}
        {%- assign brand_key = 'unknown' -%}
      {%- endif -%}

      {%- assign brand_token = '||' | append: brand_key | append: '||' -%}
      {%- assign brand_parts = seen_brands | split: brand_token -%}
      {%- assign brand_count = brand_parts.size | minus: 1 -%}
      {%- if brand_count >= per_brand_limit -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign seen_brands = seen_brands | append: brand_key | append: '||' -%}
      {%- assign seen_ids = seen_ids | append: product.id | append: '||' -%}

      {% render 'lame-flash-deal-product',
        product: product,
        product_index: products_shown,
        products_limit: products_to_show,
        badge_label: section.settings.badge_label,
        add_to_cart_label: section.settings.add_to_cart_label,
        sold_out_label: section.settings.sold_out_label,
        review_count_fallback: section.settings.review_count_fallback,
        save_label_prefix: section.settings.save_label_prefix,
        reveal_delay: products_shown,
        modulo: 2
      %}
      {%- assign products_shown = products_shown | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}
{% endcapture %}

{%- liquid
  assign title_full_width = false
  if section.settings.heading_image_full_width
    assign title_full_width = true
  endif

  assign title_mobile_full_width = false
  if section.settings.heading_image_mobile_full_width
    assign title_mobile_full_width = true
  elsif section.settings.heading_image_mobile_full_width == nil and title_full_width
    assign title_mobile_full_width = true
  endif

  assign bg_color = section.settings.section_background_color_code | default: '' | strip
  if bg_color == blank
    assign bg_color = section.settings.section_background_color
  endif
  if bg_color == 'transparent' or bg_color == 'rgba(0,0,0,0)' or bg_color == blank
    assign bg_color = ''
  endif

  assign below_banner_only = section.settings.background_below_banner_only
  if below_banner_only == nil
    assign below_banner_only = false
  endif

  assign content_bg = ''
  assign whole_section_bg = ''
  if bg_color != blank
    if below_banner_only
      assign content_bg = bg_color
    else
      assign whole_section_bg = bg_color
    endif
  endif
-%}

{{ 'lame-flash-deal.css' | asset_url | stylesheet_tag }}
<style>
  #shopify-section-{{ section.id }} {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    {%- if whole_section_bg != blank -%}
      background-color: {{ whole_section_bg }} !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
      margin-block: 0 !important;
    {%- endif -%}
  }
  {%- if whole_section_bg != blank -%}
    #shopify-section-{{ section.id }} .section-background {
      background-color: {{ whole_section_bg }} !important;
    }
  {%- endif -%}

  /* Align width and layout identically with Exclusive Offers and Home Offer Banners */
  #shopify-section-{{ section.id }} .lame-new-products.section {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    display: block !important;
  }
  #shopify-section-{{ section.id }} .lame-flash-deal__wrap {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .lame-flash-deal__header {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .lame-new-products__header-row,
  #shopify-section-{{ section.id }} .lame-flash-deal__title-image {
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
  }
  #shopify-section-{{ section.id }} .lame-flash-deal__carousel {
    max-width: 100% !important;
    width: 100% !important;
    margin-inline: 0 !important;
    padding-inline: 0 !important;
    box-sizing: border-box !important;
  }

  /* Desktop height and aspect ratio: match all homepage title banners consistently */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .lame-flash-deal__title-image,
    #shopify-section-{{ section.id }} .lame-flash-deal__title-picture,
    #shopify-section-{{ section.id }} .lame-flash-deal__title-img {
      width: 100% !important;
      max-width: 100% !important;
      height: clamp(160px, 14vw, 220px) !important;
      min-height: 0 !important;
      max-height: none !important;
      object-fit: contain !important;
      object-position: center center !important;
      border-radius: clamp(10px, 1.4vw, 16px) !important;
      border: none !important;
      box-shadow: none !important;
      overflow: hidden !important;
    }
  }

  /* Mobile: full width tight gap to cards, object-fit contain */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lame-flash-deal__wrap {
      padding-block-start: 8px !important;
      padding-top: 8px !important;
    }
    #shopify-section-{{ section.id }} .lame-flash-deal__header {
      width: 100% !important;
      max-width: 100% !important;
      margin-inline: 0 !important;
      margin-bottom: 0.65rem !important;
      padding: 0 !important;
    }
    #shopify-section-{{ section.id }} .lame-flash-deal__title-image,
    #shopify-section-{{ section.id }} .lame-flash-deal__title-picture,
    #shopify-section-{{ section.id }} .lame-flash-deal__title-img {
      width: 100% !important;
      max-width: 100% !important;
      height: clamp(90px, 22vw, 140px) !important;
      min-height: 0 !important;
      max-height: none !important;
      object-fit: contain !important;
      object-position: center center !important;
      border-radius: 8px !important;
      border: none !important;
      box-shadow: none !important;
    }
    #shopify-section-{{ section.id }} .lame-flash-deal__track {
      padding-top: 0 !important;
    }
    #shopify-section-{{ section.id }} .lame-flash-deal__carousel {
      margin-top: 0 !important;
      padding-top: 0 !important;
      padding-inline: var(--lame-flash-mobile-gutter, 0.55rem) !important;
    }
  }

  /* =========================================================
     LUXURY SPLIT SHOWCASE BANNER (Image one side + Animated text)
     ========================================================= */
  #shopify-section-{{ section.id }} .lame-new-showcase {
    position: relative;
    width: 100%;
    margin-top: clamp(0.75rem, 1.8vw, 1.4rem);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(254, 246, 236, 0.75) 100%);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(220, 185, 140, 0.35);
    border-radius: clamp(14px, 1.8vw, 24px);
    box-shadow: 0 14px 38px -10px rgba(110, 65, 20, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    box-sizing: border-box;
    padding: clamp(1rem, 2.8vw, 2.2rem);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .lame-new-showcase__stage {
    position: relative;
    width: 100%;
    min-height: 440px;
  }

  #shopify-section-{{ section.id }} .lame-new-showcase__slide {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s ease;
  }

  #shopify-section-{{ section.id }} .lame-new-showcase__slide.is-active {
    position: relative;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Media Side alignment support */
  #shopify-section-{{ section.id }} .lame-new-showcase--media-right .lame-new-showcase__slide-media {
    order: 2;
  }
  #shopify-section-{{ section.id }} .lame-new-showcase--media-right .lame-new-showcase__slide-text {
    order: 1;
  }

  /* MEDIA SIDE STYLING */
  #shopify-section-{{ section.id }} .lame-new-showcase__slide-media {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 400px;
    padding: 1rem;
  }

  #shopify-section-{{ section.id }} .lame-new-showcase__media-frame {
    position: relative;
    width: 100%;
    max-width: 420px;
    display: flex;
    flex-direction: column;
    align-items: center;
