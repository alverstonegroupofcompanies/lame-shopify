<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        const formData = new FormData(form);
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { resource: cartData, sourceId: '{{ section.id }}', data: { source: 'new-products-atc' } },
            })
          );
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  
    // Luxury Split Showcase Controller
    function initShowcaseBanner() {
      const showcase = section.querySelector('[data-lame-showcase]');
      if (!showcase) return;

      const slides = showcase.querySelectorAll('[data-showcase-slide]');
      const tabs = showcase.querySelectorAll('[data-showcase-tab]');
      const prevBtn = showcase.querySelector('[data-showcase-prev]');
      const nextBtn = showcase.querySelector('[data-showcase-next]');
      const durationSec = parseFloat(showcase.dataset.autoplay) || 6;
      const durationMs = durationSec * 1000;

      let currentIndex = 0;
      let startTime = performance.now();
      let rafId = null;
      let isPaused = false;
      let lastTimestamp = performance.now();

      function updateSlide(index) {
        if (index < 0) index = slides.length - 1;
        if (index >= slides.length) index = 0;
        currentIndex = index;

        slides.forEach((s, idx) => {
          const active = idx === currentIndex;
          s.classList.remove('is-active');
          if (active) {
            void s.offsetWidth; // trigger reflow to cleanly restart animations
            s.classList.add('is-active');
            s.setAttribute('aria-hidden', 'false');
          } else {
            s.setAttribute('aria-hidden', 'true');
          }
        });

        tabs.forEach((t, idx) => {
          const active = idx === currentIndex;
          t.classList.toggle('is-active', active);
          t.setAttribute('aria-selected', active ? 'true' : 'false');
          const bar = t.querySelector('.lame-new-showcase__tab-progress');
          if (bar) bar.style.width = '0%';
        });

        startProgress();
      }

      function startProgress() {
        if (rafId) cancelAnimationFrame(rafId);
        startTime = performance.now();
        lastTimestamp = performance.now();

        function step(timestamp) {
          if (isPaused) {
            startTime += (timestamp - lastTimestamp);
          }
          lastTimestamp = timestamp;

          const elapsed = timestamp - startTime;
          const progress = Math.min(100, (elapsed / durationMs) * 100);

          const activeBar = showcase.querySelector('.lame-new-showcase__tab.is-active .lame-new-showcase__tab-progress');
          if (activeBar) {
            activeBar.style.width = progress + '%';
          }

          if (progress < 100) {
            rafId = requestAnimationFrame(step);
          } else {
            updateSlide(currentIndex + 1);
          }
        }

        rafId = requestAnimationFrame(step);
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => {
          updateSlide(idx);
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          updateSlide(currentIndex - 1);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          updateSlide(currentIndex + 1);
        });
      }

      showcase.addEventListener('mouseenter', () => {
        isPaused = true;
      });
      showcase.addEventListener('mouseleave', () => {
        isPaused = false;
      });

      // Touch swipe gestures on mobile
      let touchStartX = 0;
      let touchEndX = 0;
      showcase.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        isPaused = true;
      }, { passive: true });
      showcase.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        isPaused = false;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) updateSlide(currentIndex + 1);
          else updateSlide(currentIndex - 1);
        }
      }, { passive: true });

      startProgress();
    }

    initShowcaseBanner();

  })();
</script>

