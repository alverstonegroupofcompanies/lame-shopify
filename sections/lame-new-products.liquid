</style>
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal lame-new-products lame-category--new-arrivals{% if title_full_width %} lame-flash-deal--title-full-width{% endif %}{% if title_mobile_full_width %} lame-flash-deal--title-mobile-full-width{% endif %}{% if content_bg != blank %} lame-flash-deal--has-content-bg{% endif %}{% if whole_section_bg != blank %} lame-flash-deal--has-section-bg{% endif %}"
  data-flash-deal-carousel
  style="--lame-flash-visible-count: 6;{% if whole_section_bg != blank %} background-color: {{ whole_section_bg }} !important; --lame-flash-bg: {{ whole_section_bg }};{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-flash-deal__header lame-new-products__header{% if title_full_width %} lame-flash-deal__header--full-width{% endif %}{% if title_mobile_full_width %} lame-flash-deal__header--mobile-full-width{% endif %}" data-lame-reveal>
      <div class="lame-new-products__header-row">
        {%- liquid
          assign heading_image = section.settings.heading_image
          assign heading_image_mobile = section.settings.heading_image_mobile
          assign heading_image_asset = section.settings.heading_image_asset | strip
          assign heading_alt = section.settings.heading | default: 'New Arrivals'
          assign show_heading_mobile = true
          if section.settings.show_heading_image_mobile == false
            assign show_heading_mobile = false
          endif
          assign use_heading_image = false
          if heading_image != blank or heading_image_asset != blank or heading_image_mobile != blank
            assign use_heading_image = true
          endif
        -%}

        {%- if use_heading_image -%}
          <h2 class="lame-flash-deal__title-image{% unless show_heading_mobile %} lame-title-image--hide-mobile{% endunless %}{% if title_full_width %} lame-title-image--full-width{% endif %}{% if title_mobile_full_width %} lame-title-image--mobile-full-width{% endif %}">
            <picture class="lame-flash-deal__title-picture">
              {%- if heading_image_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ heading_image_mobile | image_url: width: 900 }}">
              {%- endif -%}
              {%- if heading_image != blank -%}
                {{
                  heading_image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'lame-flash-deal__title-img',
                    loading: 'lazy',
                    widths: '600,900,1200,1600',
                    sizes: '(min-width: 1200px) 1200px, 100vw',
                    alt: heading_alt
                }}
              {%- elsif heading_image_mobile != blank -%}
                {{
                  heading_image_mobile
                  | image_url: width: 900
                  | image_tag:
                    class: 'lame-flash-deal__title-img',
                    loading: 'lazy',
                    widths: '600,900',
                    sizes: '100vw',
                    alt: heading_alt
                }}
              {%- else -%}
                <img
                  class="lame-flash-deal__title-img"
                  src="{{ heading_image_asset | asset_url }}"
                  alt="{{ heading_alt | escape }}"
                  width="1024"
                  height="216"
                  loading="lazy"
                >
              {%- endif -%}
            </picture>
          </h2>
          {%- if section.settings.subtitle != blank -%}
            <p class="lame-flash-deal__title-subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        {%- else -%}
          {% render 'lame-section-heading',
            title: section.settings.heading,
            alignment: 'center',
            size: 'large'
          %}
        {%- endif -%}
      </div>
    </header>

        <div class="lame-flash-deal__body"{% if content_bg != blank %} style="background-color: {{ content_bg }};"{% endif %}>
      {% if section.settings.presentation_style == 'cards_carousel' %}
        <div class="lame-flash-deal__carousel">
          <button
            type="button"
            class="lame-flash-deal__nav lame-flash-deal__nav--prev"
            data-flash-prev
            aria-label="{{ section.settings.prev_label }}"
          >
            <span aria-hidden="true">&#8249;</span>
          </button>

          <div class="lame-flash-deal__viewport" data-flash-viewport>
            <ul class="lame-flash-deal__track" role="list" data-flash-track>
              {% if products_shown > 0 %}
                {{ arrival_products_markup }}
              {% else %}
                {% for i in (1..products_to_show) %}
                  <li class="lame-flash-deal__item" data-lame-reveal>
                    <article class="lame-flash-card">
                      <div class="lame-flash-card__media">
                        <span class="lame-flash-card__badge">{{ section.settings.badge_label | default: 'NEW' }}</span>
                        <a href="#" class="lame-flash-card__media-link" tabindex="-1" aria-hidden="true">
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-flash-card__image placeholder-svg' }}
                        </a>
                      </div>
                      <div class="lame-flash-card__body">
                        <h3 class="lame-flash-card__title">
                          <a href="#">{{ section.settings.placeholder_title }}</a>
                        </h3>
                        <div class="lame-flash-card__price-row">
                          <span class="lame-flash-card__price">{{ section.settings.placeholder_price | default: '₹899' }}</span>
                        </div>
                        <div class="lame-flash-card__actions">
                          <form class="lame-flash-card__form">
                            <button type="button" class="lame-flash-card__atc" disabled>
                              {{ section.settings.add_to_cart_label }}
                            </button>
                          </form>
                        </div>
                      </div>
                    </article>
                  </li>
                {% endfor %}
              {% endif %}
            </ul>
          </div>

          <button
            type="button"
            class="lame-flash-deal__nav lame-flash-deal__nav--next"
            data-flash-next
            aria-label="{{ section.settings.next_label }}"
          >
            <span aria-hidden="true">&#8250;</span>
          </button>
        </div>
      {% else %}
        {%- comment -%} LUXURY SPLIT SHOWCASE BANNER (Image one side + Animated Text other end) {%- endcomment -%}
        <div
          class="lame-new-showcase lame-new-showcase--media-{{ section.settings.banner_media_side | default: 'left' }}"
          data-lame-showcase
          data-autoplay="{{ section.settings.showcase_autoplay_interval | default: 6 }}"
        >
          <div class="lame-new-showcase__stage">
            {%- for i in (0..2) -%}
              {%- liquid
                assign s_active = false
                if i == 0
                  assign s_active = true
                endif

                if i == 0
                  assign cur_title = s1_title
