          "options": [
            { "value": "all-products", "label": "All Products (Leaf)" },
            { "value": "skincare", "label": "Skincare (Cream Jar)" },
            { "value": "makeup", "label": "Makeup (Lipstick)" },
            { "value": "haircare", "label": "Haircare (Silhouette)" },
            { "value": "bath-body", "label": "Bath & Body (Lotion Pump)" },
            { "value": "fragrance", "label": "Fragrance (Perfume Bottle)" },
            { "value": "baby-care", "label": "Baby Care (Baby Face)" },
            { "value": "wellness", "label": "Wellness (Heart Pulse)" }
          ],
          "default": "all-products"
        },
        {
          "type": "image_picker",
          "id": "custom_icon_image",
          "label": "Custom icon image (optional)"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Circle background color (optional override)"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon color (optional override)"
        },
        {
          "type": "checkbox",
          "id": "is_active_default",
          "label": "Set as active / highlighted by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Radiant Category Pills",
      "category": "Navigation",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "All Products",
            "icon": "all-products",
            "is_active_default": true
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Skincare",
            "icon": "skincare"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Makeup",
            "icon": "makeup"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Haircare",
            "icon": "haircare"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bath & Body",
            "icon": "bath-body"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fragrance",
            "icon": "fragrance"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Baby Care",
            "icon": "baby-care"
          }
        },
        {
          "type": "category",
          "settings": {
