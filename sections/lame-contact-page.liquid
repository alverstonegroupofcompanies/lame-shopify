{{ 'lame-contact-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_prefix = section.settings.heading_prefix | default: "We'd love to"
  assign heading_accent = section.settings.heading_accent | default: 'hear'
  assign heading_suffix = section.settings.heading_suffix | default: 'from you'

  assign form_id = 'LameContactForm-' | append: section.id
  assign contact_success = false
-%}

<div
  class="lame-contact-page section spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="lame-contact-page__shell page-width">
    <header class="lame-contact-page__head">
      <h1 class="lame-contact-page__title">
        {%- if heading_prefix != blank -%}
          <span class="lame-contact-page__title-text">{{ heading_prefix | escape }}</span>
        {%- endif -%}
        {%- if heading_accent != blank -%}
          <em class="lame-contact-page__title-accent">{{ heading_accent | escape }}</em>
        {%- endif -%}
        {%- if heading_suffix != blank -%}
          <span class="lame-contact-page__title-text">{{ heading_suffix | escape }}</span>
        {%- endif -%}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="lame-contact-page__subtitle">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="lame-contact-page__layout">
      <aside class="lame-contact-page__info" aria-label="{{ 'lame_contact.get_in_touch' | t }}">
        <div class="lame-contact-page__details">
          {% if section.settings.phone != blank %}
            <div class="lame-contact-page__info-detail">
              <span class="lame-contact-page__info-label">{{ 'lame_contact.phone' | t }}</span>
              <a
                class="lame-contact-page__info-value lame-contact-page__info-value--link"
                href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}"
              >
                {{ section.settings.phone | escape }}
              </a>
            </div>
          {% endif %}

          {% if section.settings.head_office_email != blank %}
            <div class="lame-contact-page__info-detail">
              <span class="lame-contact-page__info-label">{{ 'lame_contact.email' | t }}</span>
              <a
                class="lame-contact-page__info-value lame-contact-page__info-value--link"
                href="mailto:{{ section.settings.head_office_email | strip }}"
              >
                {{ section.settings.head_office_email | escape }}
              </a>
            </div>
          {% endif %}

          {% if section.settings.hours != blank %}
            <div class="lame-contact-page__info-detail">
              <span class="lame-contact-page__info-label">{{ section.settings.hours_label | default: 'Hours' | escape }}</span>
              <p class="lame-contact-page__info-value">
                {{ section.settings.hours | escape | newline_to_br }}
              </p>
            </div>
          {% endif %}

          {% if section.settings.show_head_office and section.settings.head_office_address != blank %}
            <div class="lame-contact-page__info-detail">
              <span class="lame-contact-page__info-label">{{ section.settings.studio_label | default: 'Studio' | escape }}</span>
              <p class="lame-contact-page__info-value">
                {{ section.settings.head_office_address | escape | newline_to_br }}
              </p>
            </div>
          {% endif %}
        </div>
      </aside>

      <div class="lame-contact-page__form-panel">
        {%- form 'contact', id: form_id, class: 'lame-contact-page__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">
          <input type="hidden" name="contact[tags]" value="contact-page">

          {%- if form.posted_successfully? and form.id == form_id -%}
            {%- assign contact_success = true -%}
          {%- endif -%}

          {%- if form.errors and form.id == form_id -%}
            <div class="lame-contact-page__message lame-contact-page__message--error" tabindex="-1" autofocus role="alert">
              {{- 'icon-error.svg' | inline_asset_content -}}
              <div>
                <p class="lame-contact-page__message-title">{{ 'blocks.contact_form.error_heading' | t }}</p>
                <ul class="lame-contact-page__error-list">
                  {% for field in form.errors %}
                    <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {%- endif -%}

          <div class="lame-contact-page__field-row">
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
              <input
                type="text"
                id="{{ form_id }}-name"
                class="lame-contact-page__input"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'lame_contact.name_placeholder' | t }}"
                required
              >
            </div>
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="{{ form_id }}-email"
                class="lame-contact-page__input"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ 'lame_contact.email_placeholder' | t }}"
                aria-required="true"
                required
                {% if form.errors contains 'email' and form.id == form_id %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-phone">{{ 'lame_contact.phone_optional' | t }}</label>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              class="lame-contact-page__input"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ 'lame_contact.phone_placeholder' | t }}"
            >
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-body">{{ 'blocks.contact_form.comment' | t }} <span aria-hidden="true">*</span></label>
            <textarea
              id="{{ form_id }}-body"
              class="lame-contact-page__input lame-contact-page__textarea"
              name="contact[body]"
              rows="6"
              placeholder="{{ 'lame_contact.message_placeholder' | t }}"
              required
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="lame-contact-page__submit">
            {%- if section.settings.submit_label != blank -%}
              {{ section.settings.submit_label }}
            {%- else -%}
              {{ 'lame_contact.submit' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>

  {%- if contact_success -%}
    <div
      class="lame-contact-alert"
      data-lame-contact-alert
      role="alertdialog"
      aria-modal="true"
      aria-labelledby="LameContactAlertTitle-{{ section.id }}"
      aria-describedby="LameContactAlertText-{{ section.id }}"
    >
      <div class="lame-contact-alert__backdrop" data-lame-contact-alert-close></div>
      <div class="lame-contact-alert__card">
        <div class="lame-contact-alert__icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
            <path d="M7.5 12.5l3 3 6-6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="lame-contact-alert__title" id="LameContactAlertTitle-{{ section.id }}">Message sent</h2>
        <p class="lame-contact-alert__text" id="LameContactAlertText-{{ section.id }}">
          {{ 'lame_contact.success' | t }}
        </p>
        <button type="button" class="lame-contact-alert__btn" data-lame-contact-alert-close>
          Close
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    const COPY_TO = {{ section.settings.copy_email | default: 'creative@alverstones.com' | json }};
    const form = document.getElementById({{ form_id | json }});
    const alertEl = document.querySelector('[data-lame-contact-alert]');

    if (alertEl) {
      const close = () => {
        alertEl.classList.add('is-closing');
        window.setTimeout(() => alertEl.remove(), 280);
      };
      alertEl.querySelectorAll('[data-lame-contact-alert-close]').forEach((el) => {
        el.addEventListener('click', close);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') close();
      });
      window.requestAnimationFrame(() => alertEl.classList.add('is-open'));
    }

    if (!form || !COPY_TO) return;

    let copySent = false;
    form.addEventListener('submit', () => {
      if (copySent) return;
      copySent = true;

      const data = new FormData(form);
      const payload = {
        name: data.get('contact[name]') || '',
        email: data.get('contact[email]') || '',
        phone: data.get('contact[phone]') || '',
        message: data.get('contact[body]') || '',
        _replyto: data.get('contact[email]') || '',
        _subject: 'Lamstone Healthcare — Contact form copy',
        _template: 'table',
      };

      fetch('https://formsubmit.co/ajax/' + encodeURIComponent(COPY_TO), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json',
        },
        body: JSON.stringify(payload),
        keepalive: true,
      }).catch(() => {});
    });
  })();
</script>

{% schema %}
{
  "name": "Contact page (premium)",
  "tag": "section",
  "class": "lame-contact-page-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submissions go to the store contact email (Shopify Admin → Settings → Store details). A copy is also sent to the address below. On first use, FormSubmit may email that inbox once for activation."
    },
    {
      "type": "text",
      "id": "copy_email",
      "label": "Also send a copy to",
      "default": "creative@alverstones.com"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading (before accent)",
      "default": "We'd love to"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word",
      "default": "hear",
      "info": "Shown in italic terracotta."
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading (after accent)",
      "default": "from you"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions about an order, a product, or a partnership — send us a note and someone from our team will reply within one business day."
    },
    {
      "type": "header",
      "content": "Get in touch card"
    },
    {
      "type": "textarea",
      "id": "info_intro",
      "label": "Intro text",
      "default": "Reach us directly, or use the form and we'll follow up by email."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 974 639 7686"
    },
    {
      "type": "text",
      "id": "head_office_email",
      "label": "Email",
      "default": "mail@lamstonehealthcare.com"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Hours",
      "default": "Monday – Saturday\n10am – 6pm IST"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours label",
      "default": "Hours"
    },
    {
      "type": "checkbox",
      "id": "show_head_office",
      "label": "Show studio / address block",
      "default": true
    },
    {
      "type": "text",
      "id": "studio_label",
      "label": "Address label",
      "default": "Studio"
    },
    {
      "type": "textarea",
      "id": "head_office_address",
      "label": "Address",
      "default": "Z Avenue, 10/20/E-10/20/G, NH 66,\nMangalapuram, Kerala 695317"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send message"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
