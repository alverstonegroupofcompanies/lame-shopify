{{ 'lame-contact-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_heading = section.settings.heading
  if page_heading == blank and page != blank
    assign page_heading = page.title
  endif
  if page_heading == blank
    assign page_heading = 'lame_contact.heading' | t
  endif

  assign form_id = 'LameContactForm-' | append: section.id
-%}

<div class="lame-contact-page section spacing-style color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="lame-contact-page__shell page-width">
    <header class="lame-contact-page__head">
      <nav class="lame-contact-page__breadcrumbs" aria-label="Breadcrumb">
        <ol class="lame-contact-page__breadcrumbs-list">
          <li><a href="{{ routes.root_url }}">{{ 'lame_product.breadcrumb_home' | t }}</a></li>
          <li class="lame-contact-page__breadcrumbs-sep" aria-hidden="true">&bull;</li>
          <li aria-current="page"><span>{{ page_heading | escape }}</span></li>
        </ol>
      </nav>
      <h1 class="lame-contact-page__title">{{ page_heading | escape }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="lame-contact-page__subtitle">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="lame-contact-page__layout">
      <aside class="lame-contact-page__info">
        <div class="lame-contact-page__info-card">
          <h2 class="lame-contact-page__info-title">{{ 'lame_contact.get_in_touch' | t }}</h2>
          <p class="lame-contact-page__info-text">{{ 'lame_contact.get_in_touch_intro' | t }}</p>
        </div>

        {% if section.settings.response_note != blank %}
          <div class="lame-contact-page__info-card lame-contact-page__info-card--muted">
            <h2 class="lame-contact-page__info-title">{{ 'lame_contact.response_time' | t }}</h2>
            <p class="lame-contact-page__info-text">{{ section.settings.response_note | escape }}</p>
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="lame-contact-page__info-card lame-contact-page__info-card--muted">
            <h2 class="lame-contact-page__info-title">{{ 'lame_contact.phone' | t }}</h2>
            <a class="lame-contact-page__phone-link" href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">
              {{ section.settings.phone | escape }}
            </a>
          </div>
        {% endif %}

        {% if page.content != blank %}
          <div class="lame-contact-page__page-content rte">{{ page.content }}</div>
        {% endif %}
      </aside>

      <div class="lame-contact-page__form-panel">
        {%- form 'contact', id: form_id, class: 'lame-contact-page__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">
          <input type="hidden" name="contact[tags]" value="contact-page">

          {%- if form.errors and form.id == form_id -%}
            <div class="lame-contact-page__message lame-contact-page__message--error" tabindex="-1" autofocus role="alert">
              {{- 'icon-error.svg' | inline_asset_content -}}
              <div>
                <p class="lame-contact-page__message-title">{{ 'blocks.contact_form.error_heading' | t }}</p>
                <ul class="lame-contact-page__error-list">
                  {% for field in form.errors %}
                    <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == form_id -%}
            <div class="lame-contact-page__message lame-contact-page__message--success" tabindex="-1" autofocus role="status">
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
              <p>{{ 'lame_contact.success' | t }}</p>
            </div>
          {%- endif -%}

          <div class="lame-contact-page__field-row">
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
              <input
                type="text"
                id="{{ form_id }}-name"
                class="lame-contact-page__input"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'lame_contact.name_placeholder' | t }}"
                required
              >
            </div>
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="{{ form_id }}-email"
                class="lame-contact-page__input"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ 'lame_contact.email_placeholder' | t }}"
                aria-required="true"
                required
                {% if form.errors contains 'email' and form.id == form_id %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-phone">{{ 'blocks.contact_form.phone' | t }}</label>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              class="lame-contact-page__input"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ 'lame_contact.phone_placeholder' | t }}"
            >
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-body">{{ 'blocks.contact_form.comment' | t }} <span aria-hidden="true">*</span></label>
            <textarea
              id="{{ form_id }}-body"
              class="lame-contact-page__input lame-contact-page__textarea"
              name="contact[body]"
              rows="6"
              placeholder="{{ 'lame_contact.message_placeholder' | t }}"
              required
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="lame-contact-page__submit button">
            {%- if section.settings.submit_label != blank -%}
              {{ section.settings.submit_label }}
            {%- else -%}
              {{ 'lame_contact.submit' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}
      </div>
    </div>

    {% if section.settings.show_head_office %}
      <section class="lame-contact-page__head-office" aria-labelledby="HeadOfficeHeading-{{ section.id }}">
        <div class="lame-contact-page__head-office-card">
          <header class="lame-contact-page__head-office-header">
            <h2 id="HeadOfficeHeading-{{ section.id }}" class="lame-contact-page__head-office-title">
              {{ 'lame_contact.head_office' | t }}
            </h2>
          </header>

          <div class="lame-contact-page__head-office-layout">
            <div class="lame-contact-page__head-office-brand">
              {% if section.settings.head_office_logo != blank %}
                {{
                  section.settings.head_office_logo
                  | image_url: width: 480
                  | image_tag:
                    class: 'lame-contact-page__head-office-logo',
                    loading: 'lazy',
                    widths: '200,280,360,480',
                    sizes: '(max-width: 749px) 200px, 240px',
                    alt: section.settings.head_office_logo_alt | default: 'Alverstone Healthcare Pvt Ltd'
                }}
              {% else %}
                <img
                  class="lame-contact-page__head-office-logo"
                  src="{{ 'alverstone-healthcare-logo.png' | asset_url }}"
                  alt="{{ section.settings.head_office_logo_alt | default: 'Alverstone Healthcare Pvt Ltd' | escape }}"
                  width="240"
                  height="80"
                  loading="lazy"
                >
              {% endif %}
            </div>

            <div class="lame-contact-page__head-office-details">
              {% if section.settings.head_office_address != blank %}
                <div class="lame-contact-page__head-office-detail">
                  <span class="lame-contact-page__head-office-label">{{ 'lame_contact.address' | t }}</span>
                  <p class="lame-contact-page__head-office-value">
                    {{ section.settings.head_office_address | escape | newline_to_br }}
                  </p>
                </div>
              {% endif %}

              {% if section.settings.head_office_email != blank %}
                <div class="lame-contact-page__head-office-detail">
                  <span class="lame-contact-page__head-office-label">{{ 'lame_contact.email' | t }}</span>
                  <a class="lame-contact-page__head-office-value lame-contact-page__head-office-link" href="mailto:{{ section.settings.head_office_email | strip }}">
                    {{ section.settings.head_office_email | escape }}
                  </a>
                </div>
              {% endif %}

              {% if section.settings.head_office_website != blank %}
                {% liquid
                  assign head_office_site = section.settings.head_office_website | strip
                  assign head_office_site_href = head_office_site
                  unless head_office_site_href contains '://'
                    assign head_office_site_href = 'https://' | append: head_office_site_href
                  endunless
                %}
                <div class="lame-contact-page__head-office-detail">
                  <span class="lame-contact-page__head-office-label">{{ 'lame_contact.website' | t }}</span>
                  <a class="lame-contact-page__head-office-value lame-contact-page__head-office-link" href="{{ head_office_site_href }}" target="_blank" rel="noopener noreferrer">
                    {{ section.settings.head_office_website | escape }}
                  </a>
                </div>
              {% endif %}

              {% if section.settings.head_office_phones != blank %}
                <div class="lame-contact-page__head-office-detail lame-contact-page__head-office-detail--phones">
                  <span class="lame-contact-page__head-office-label">{{ 'lame_contact.contact_numbers' | t }}</span>
                  <ul class="lame-contact-page__head-office-phone-grid" role="list">
                    {% liquid
                      assign head_office_phone_blob = section.settings.head_office_phones | replace: ',', '
' | replace: '|', '
'
                      assign head_office_phone_lines = head_office_phone_blob | split: '
'
                    %}
                    {% for phone_line in head_office_phone_lines %}
                      {% assign phone_stripped = phone_line | strip %}
                      {% if phone_stripped != blank %}
                        {% assign phone_href = phone_stripped | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}
                        <li>
                          <a class="lame-contact-page__head-office-link" href="tel:{{ phone_href }}">
                            {{ phone_stripped | escape }}
                          </a>
                        </li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </section>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Contact page (premium)",
  "tag": "section",
  "class": "lame-contact-page-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submissions use Shopify’s contact form. Set the store contact email in Shopify Admin → Settings → Store details (not shown on this page)."
    },
    {
      "type": "header",
      "content": "Head office"
    },
    {
      "type": "checkbox",
      "id": "show_head_office",
      "label": "Show head office block",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "head_office_logo",
      "label": "Head office logo",
      "info": "Leave empty to use the default Alverstone Healthcare logo."
    },
    {
      "type": "text",
      "id": "head_office_logo_alt",
      "label": "Logo alt text",
      "default": "Alverstone Healthcare Pvt Ltd"
    },
    {
      "type": "textarea",
      "id": "head_office_address",
      "label": "Head office address",
      "default": "Bio 360, Kerala Life Sciences Industries Park, Thiruvananthapuram-695317"
    },
    {
      "type": "text",
      "id": "head_office_email",
      "label": "Head office email",
      "default": "mail@lamstonehealthcare.com"
    },
    {
      "type": "text",
      "id": "head_office_website",
      "label": "Head office website",
      "default": "www.lamstonehealthcare.com"
    },
    {
      "type": "textarea",
      "id": "head_office_phones",
      "label": "Head office phone numbers",
      "info": "One number per line.",
      "default": "+91 974 639 7686\n+91 813 980 7686\n+9181291 42686\n+97154 740 1777"
    },
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "We’d love to hear from you. Send us a message and our team will respond as soon as possible."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone (optional)"
    },
    {
      "type": "text",
      "id": "response_note",
      "label": "Response time note",
      "default": "We typically reply within 1–2 business days."
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send message"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
