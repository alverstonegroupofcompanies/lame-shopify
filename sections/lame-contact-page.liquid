{{ 'lame-contact-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading_prefix = section.settings.heading_prefix | default: "We'd love to"
  assign heading_accent = section.settings.heading_accent | default: 'hear'
  assign heading_suffix = section.settings.heading_suffix | default: 'from you'

  assign form_id = 'LameContactForm-' | append: section.id
  assign info_intro = section.settings.info_intro
  if info_intro == blank
    assign info_intro = 'lame_contact.get_in_touch_intro' | t
  endif
-%}

<div
  class="lame-contact-page section spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="lame-contact-page__shell page-width">
    <header class="lame-contact-page__head">
      <h1 class="lame-contact-page__title">
        {%- if heading_prefix != blank -%}
          <span class="lame-contact-page__title-text">{{ heading_prefix | escape }}</span>
        {%- endif -%}
        {%- if heading_accent != blank -%}
          <em class="lame-contact-page__title-accent">{{ heading_accent | escape }}</em>
        {%- endif -%}
        {%- if heading_suffix != blank -%}
          <span class="lame-contact-page__title-text">{{ heading_suffix | escape }}</span>
        {%- endif -%}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="lame-contact-page__subtitle">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="lame-contact-page__layout">
      <aside class="lame-contact-page__info" aria-label="{{ 'lame_contact.get_in_touch' | t }}">
        <div class="lame-contact-page__info-card">
          <div class="lame-contact-page__info-glow" aria-hidden="true"></div>

          <div class="lame-contact-page__info-top">
            <h2 class="lame-contact-page__info-title">{{ 'lame_contact.get_in_touch' | t }}</h2>
            {% if info_intro != blank %}
              <p class="lame-contact-page__info-text">{{ info_intro | escape }}</p>
            {% endif %}

            {% if section.settings.phone != blank %}
              <div class="lame-contact-page__info-detail">
                <span class="lame-contact-page__info-label">{{ 'lame_contact.phone' | t }}</span>
                <a
                  class="lame-contact-page__info-value"
                  href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}"
                >
                  {{ section.settings.phone | escape }}
                </a>
              </div>
            {% endif %}

            {% if section.settings.head_office_email != blank %}
              <div class="lame-contact-page__info-detail">
                <span class="lame-contact-page__info-label">{{ 'lame_contact.email' | t }}</span>
                <a
                  class="lame-contact-page__info-value"
                  href="mailto:{{ section.settings.head_office_email | strip }}"
                >
                  {{ section.settings.head_office_email | escape }}
                </a>
              </div>
            {% endif %}
          </div>

          {% if section.settings.show_head_office and section.settings.head_office_address != blank %}
            <div class="lame-contact-page__studio">
              <span class="lame-contact-page__info-label">{{ section.settings.studio_label | default: 'Studio' | escape }}</span>
              <div class="lame-contact-page__studio-box">
                <p class="lame-contact-page__studio-address">
                  {{ section.settings.head_office_address | escape | newline_to_br }}
                </p>
              </div>
            </div>
          {% endif %}
        </div>
      </aside>

      <div class="lame-contact-page__form-panel">
        {%- form 'contact', id: form_id, class: 'lame-contact-page__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">
          <input type="hidden" name="contact[tags]" value="contact-page">

          {%- if form.errors and form.id == form_id -%}
            <div class="lame-contact-page__message lame-contact-page__message--error" tabindex="-1" autofocus role="alert">
              {{- 'icon-error.svg' | inline_asset_content -}}
              <div>
                <p class="lame-contact-page__message-title">{{ 'blocks.contact_form.error_heading' | t }}</p>
                <ul class="lame-contact-page__error-list">
                  {% for field in form.errors %}
                    <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          {%- endif -%}

          {%- if form.posted_successfully? and form.id == form_id -%}
            <div class="lame-contact-page__message lame-contact-page__message--success" tabindex="-1" autofocus role="status">
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
              <p>{{ 'lame_contact.success' | t }}</p>
            </div>
          {%- endif -%}

          <div class="lame-contact-page__field-row">
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-name">{{ 'blocks.contact_form.name' | t }}</label>
              <input
                type="text"
                id="{{ form_id }}-name"
                class="lame-contact-page__input"
                name="contact[name]"
                autocomplete="name"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ 'lame_contact.name_placeholder' | t }}"
                required
              >
            </div>
            <div class="lame-contact-page__field">
              <label for="{{ form_id }}-email">{{ 'blocks.contact_form.email' | t }} <span aria-hidden="true">*</span></label>
              <input
                type="email"
                id="{{ form_id }}-email"
                class="lame-contact-page__input"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ 'lame_contact.email_placeholder' | t }}"
                aria-required="true"
                required
                {% if form.errors contains 'email' and form.id == form_id %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-phone">{{ 'lame_contact.phone_optional' | t }}</label>
            <input
              type="tel"
              id="{{ form_id }}-phone"
              class="lame-contact-page__input"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="{{ 'lame_contact.phone_placeholder' | t }}"
            >
          </div>

          <div class="lame-contact-page__field">
            <label for="{{ form_id }}-body">{{ 'blocks.contact_form.comment' | t }} <span aria-hidden="true">*</span></label>
            <textarea
              id="{{ form_id }}-body"
              class="lame-contact-page__input lame-contact-page__textarea"
              name="contact[body]"
              rows="6"
              placeholder="{{ 'lame_contact.message_placeholder' | t }}"
              required
            >{{- form.body -}}</textarea>
          </div>

          <button type="submit" class="lame-contact-page__submit">
            {%- if section.settings.submit_label != blank -%}
              {{ section.settings.submit_label }}
            {%- else -%}
              {{ 'lame_contact.submit' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact page (premium)",
  "tag": "section",
  "class": "lame-contact-page-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Submissions use Shopify’s contact form. Set the store contact email in Shopify Admin → Settings → Store details."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading (before accent)",
      "default": "We'd love to"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word",
      "default": "hear",
      "info": "Shown in italic terracotta."
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading (after accent)",
      "default": "from you"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions about an order, a product, or a partnership — send us a note and someone from our team will reply within one business day."
    },
    {
      "type": "header",
      "content": "Get in touch card"
    },
    {
      "type": "textarea",
      "id": "info_intro",
      "label": "Intro text",
      "default": "Reach us directly, or use the form and we'll follow up by email."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91 974 639 7686"
    },
    {
      "type": "text",
      "id": "head_office_email",
      "label": "Email",
      "default": "mail@lamstonehealthcare.com"
    },
    {
      "type": "checkbox",
      "id": "show_head_office",
      "label": "Show studio / address block",
      "default": true
    },
    {
      "type": "text",
      "id": "studio_label",
      "label": "Address label",
      "default": "Studio"
    },
    {
      "type": "textarea",
      "id": "head_office_address",
      "label": "Address",
      "default": "Z Avenue, 10/20/E-10/20/G, NH 66,\nMangalapuram, Kerala 695317"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send message"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
