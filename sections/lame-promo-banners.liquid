<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-promo-banners">
  <div class="lame-promo-banners__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <ul class="lame-promo-banners__grid" role="list">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <a
            class="lame-promo-banners__tile"
            href="{{ block.settings.link | default: routes.collections_url }}"
          >
            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  class: 'lame-promo-banners__image',
                  loading: 'lazy',
                  widths: '400,600,900',
                  sizes: '(min-width: 990px) 32vw, (min-width: 750px) 48vw, 94vw'
              }}
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'lame-promo-banners__image placeholder-svg' }}
            {% endif %}

            <span class="lame-promo-banners__overlay"></span>

            <span class="lame-promo-banners__content">
              {% if block.settings.heading != blank %}
                <span class="lame-promo-banners__heading">{{ block.settings.heading }}</span>
              {% endif %}
              {% if block.settings.subtext != blank %}
                <span class="lame-promo-banners__subtext">{{ block.settings.subtext }}</span>
              {% endif %}
              {% if block.settings.button_label != blank %}
                <span class="lame-promo-banners__cta">{{ block.settings.button_label }}</span>
              {% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-promo-banners__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .lame-promo-banners__tile {
    position: relative;
    display: block;
    min-height: 200px;
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-promo-banners__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .lame-promo-banners__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(0 0 0 / 0.15), rgb(0 0 0 / 0.45));
    pointer-events: none;
  }

  .lame-promo-banners__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 200px;
    padding: 20px;
    gap: 6px;
  }

  .lame-promo-banners__heading {
    font-size: clamp(0.875rem, 2vw, 1.125rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
    max-width: 18ch;
  }

  .lame-promo-banners__subtext {
    font-size: 0.8125rem;
    opacity: 0.92;
  }

  .lame-promo-banners__cta {
    margin-top: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .lame-promo-banners__tile:hover .lame-promo-banners__image {
    transform: scale(1.04);
  }

  @media screen and (min-width: 750px) {
    .lame-promo-banners__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .lame-promo-banners__tile,
    .lame-promo-banners__content {
      min-height: 240px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banners (3-up)",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collection" },
        { "type": "text", "id": "subtext", "label": "Subtext", "default": "From only $29.00" },
        { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners (3-up)",
      "blocks": [
        {
          "type": "banner",
          "settings": {
            "heading": "Apply your makeup like a pro",
            "subtext": "Professional tools",
            "button_label": "Shop now"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "From only $29.00",
            "subtext": "Limited time",
            "button_label": "Shop now"
          }
        },
        {
          "type": "banner",
          "settings": {
            "heading": "30% off facewash & lotion",
            "subtext": "Skincare essentials",
            "button_label": "Shop now"
          }
        }
      ]
    }
  ]
}
{% endschema %}
