{%- liquid
  assign banner_image = nil
  assign ns = section.settings.metafield_namespace | default: 'custom' | strip
  assign ky = section.settings.metafield_key | default: 'top_banner' | strip

  if collection != blank and ns != blank and ky != blank
    assign mf = collection.metafields[ns][ky]
    if mf != blank and mf.value != blank
      assign banner_image = mf.value
    endif
  endif

  if banner_image == blank and section.settings.use_collection_image_fallback and collection != blank and collection.image != blank
    assign banner_image = collection.image
  endif
-%}

{%- if banner_image != blank -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="lame-collection-top-banner spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
    style="
      --lctb-min-height: {{ section.settings.min_height }}px;
      --lctb-object-fit: {{ section.settings.object_fit }};
      {% render 'spacing-padding', settings: section.settings %}
    "
  >
    <div class="lame-collection-top-banner__frame">
      {{
        banner_image
        | image_url: width: 3840
        | image_tag:
          class: 'lame-collection-top-banner__img',
          widths: '832, 1200, 1600, 1920, 2560, 3840',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: collection.title | default: shop.name | escape,
          decoding: 'async'
      }}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div
    class="lame-collection-top-banner lame-collection-top-banner--placeholder spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    <p class="lame-collection-top-banner__hint">
      Add a collection <strong>File</strong> metafield ({{ ns }}.{{ ky }}) or enable “Collection featured image” and set each collection’s image in Admin.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .lame-collection-top-banner {
    padding: 0;
    margin: 0;
  }

  .lame-collection-top-banner__frame {
    width: 100%;
    min-height: var(--lctb-min-height, 220px);
    max-height: min(55svh, 520px);
    overflow: hidden;
    display: block;
    line-height: 0;
  }

  .lame-collection-top-banner__img {
    width: 100%;
    height: 100%;
    min-height: var(--lctb-min-height, 220px);
    max-height: min(55svh, 520px);
    object-fit: var(--lctb-object-fit, cover);
    object-position: center center;
    display: block;
  }

  .lame-collection-top-banner--placeholder {
    padding: 1rem 1.25rem;
    border: 1px dashed rgb(var(--color-foreground-rgb) / 0.25);
    background: rgb(var(--color-background-rgb) / 0.5);
  }

  .lame-collection-top-banner__hint {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    text-align: center;
    max-width: 42rem;
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection top banner",
  "tag": "section",
  "class": "lame-collection-top-banner-section section-wrapper",
  "blocks": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Image is per collection: metafield (below) takes priority, then optional Collection featured image. Template settings here are shared; they only control layout and which sources to use."
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "default": "custom",
      "info": "e.g. custom — must match Collection metafield definition in Admin → Settings → Custom data."
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "default": "top_banner",
      "info": "File (image) metafield key, e.g. top_banner"
    },
    {
      "type": "checkbox",
      "id": "use_collection_image_fallback",
      "label": "Use collection featured image when metafield is empty",
      "default": true
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum banner height",
      "min": 120,
      "max": 480,
      "step": 4,
      "unit": "px",
      "default": 220
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection top banner"
    }
  ]
}
{% endschema %}
