<script>
  (() => {
    const section = document.getElementById('LameRadiantBeautyPage-{{ section.id }}');
    if (!section) return;

    // Categories scrolling
    const catViewport = section.querySelector('[data-master-cat-viewport]');
    const catPrev = section.querySelector('[data-master-cat-prev]');
    const catNext = section.querySelector('[data-master-cat-next]');
    if (catViewport) {
      const step = () => catViewport.clientWidth * 0.65 || 240;
      catPrev?.addEventListener('click', () => catViewport.scrollBy({ left: -step(), behavior: 'smooth' }));
      catNext?.addEventListener('click', () => catViewport.scrollBy({ left: step(), behavior: 'smooth' }));
    }

    // Brands scrolling
    const brandViewport = section.querySelector('[data-master-brand-viewport]');
    const brandPrev = section.querySelector('[data-master-brand-prev]');
    const brandNext = section.querySelector('[data-master-brand-next]');
    if (brandViewport) {
      const step = () => brandViewport.clientWidth * 0.65 || 260;
      brandPrev?.addEventListener('click', () => brandViewport.scrollBy({ left: -step(), behavior: 'smooth' }));
      brandNext?.addEventListener('click', () => brandViewport.scrollBy({ left: step(), behavior: 'smooth' }));
    }
  })();
</script>

