        },
        {
          "type": "select",
          "id": "brand",
          "label": "Brand / Vendor",
          "options": [
            { "value": "custom", "label": "Custom (Use Link URL below)" },
            { "value": "Plum", "label": "Plum" },
            { "value": "Himalaya", "label": "Himalaya" },
            { "value": "Bombay Shaving Company", "label": "Bombay Shaving Company" },
            { "value": "DR.RASHEL", "label": "DR.RASHEL" },
            { "value": "Vaseline", "label": "Vaseline" },
            { "value": "Sirona", "label": "Sirona" },
            { "value": "NIVEA", "label": "NIVEA" },
            { "value": "SebaMed", "label": "SebaMed" },
            { "value": "Cetaphil", "label": "Cetaphil" },
            { "value": "Jovees Herbal", "label": "Jovees Herbal" },
