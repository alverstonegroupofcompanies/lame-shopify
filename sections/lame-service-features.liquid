<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-service-features"
  style="--lame-service-bar-bg: {{ section.settings.bar_background }};"
  {{ section.shopify_attributes }}
>
  <div class="lame-service-features__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <ul class="lame-service-features__list" role="list">
      {% for block in section.blocks %}
        <li class="lame-service-features__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="lame-service-features__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'guarantee' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.4"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              {% when 'support' %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M4 14a8 8 0 1 1 16 0v2a2 2 0 0 1-2 2h-1.2a1.8 1.8 0 0 0-1.8 1.8V22H9.2v-2.2A1.8 1.8 0 0 0 7.4 18H6a2 2 0 0 1-2-2v-2Z" stroke="currentColor" stroke-width="1.4"/></svg>
              {% when 'payment' %}
                <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M3 10h18" stroke="currentColor" stroke-width="1.4"/></svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none"><path d="M3 8.5 12 3l9 5.5V18a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8.5Z" stroke="currentColor" stroke-width="1.4"/><path d="M9 14h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            {% endcase %}
          </span>
          <div class="lame-service-features__text">
            {% if block.settings.title != blank %}
              <p class="lame-service-features__title">{{ block.settings.title }}</p>
            {% endif %}
            {% if block.settings.text != blank %}
              <p class="lame-service-features__sub">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-service-features__wrap {
    background: var(--lame-service-bar-bg, #f0f0f0);
    border-block: 1px solid rgb(0 0 0 / 0.06);
  }

  .lame-service-features__list {
    list-style: none;
    margin: 0;
    padding: 1rem 0.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .lame-service-features__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .lame-service-features__icon {
    flex: 0 0 2rem;
    width: 2rem;
    height: 2rem;
    color: #111;
    display: inline-flex;
  }

  .lame-service-features__icon svg {
    width: 100%;
    height: 100%;
  }

  .lame-service-features__title {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 700;
    color: #111;
    line-height: 1.25;
  }

  .lame-service-features__sub {
    margin: 0.15rem 0 0;
    font-size: 0.72rem;
    color: rgb(0 0 0 / 0.58);
    line-height: 1.3;
  }

  @media screen and (min-width: 750px) {
    .lame-service-features__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 2rem;
      padding: 1.1rem 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-service-features__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% schema %}
{
  "name": "Service features bar",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar background",
      "default": "#f0f0f0"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "guarantee", "label": "Guarantee" },
            { "value": "support", "label": "Support" },
            { "value": "payment", "label": "Payment" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature title" },
        { "type": "text", "id": "text", "label": "Text", "default": "Short description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service features bar",
      "blocks": [
        { "type": "feature", "settings": { "icon": "shipping", "title": "Free Worldwide Shipping", "text": "On qualifying orders" } },
        { "type": "feature", "settings": { "icon": "guarantee", "title": "Money Back Guarantee", "text": "30-day returns" } },
        { "type": "feature", "settings": { "icon": "support", "title": "24/7 Customer Support", "text": "We are here to help" } },
        { "type": "feature", "settings": { "icon": "payment", "title": "Secure Online Payment", "text": "Protected checkout" } }
      ]
    }
  ]
}
{% endschema %}
