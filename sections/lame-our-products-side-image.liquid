{%- liquid
  assign lame_category_shop_page = false
  assign lame_cosmetic_collection = false
  assign lame_category_hero_handles = 'bath-body,fragrance,make-up,skin-care,baby-mom,wellness,hair-care' | split: ','

  if template.name == 'collection' and collection != blank
    if lame_category_hero_handles contains collection.handle
      assign lame_category_shop_page = true
    endif

    unless lame_category_shop_page
      if template.suffix == 'our-products' or collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
        assign lame_cosmetic_collection = true
      endif
    endunless
  endif

  assign show_side_images = false
  if lame_cosmetic_collection and lame_category_shop_page == false
    if template.suffix == 'our-products' or collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
      assign show_side_images = true
    endif
  endif
-%}

{%- if show_side_images -%}
<div
  class="lame-op-side-images section section--full-width"
  style="--lame-op-side-width: {{ section.settings.column_width }}px; --lame-op-side-top: {{ section.settings.offset_top }}px; --lame-op-side-gap: {{ section.settings.image_gap }}px;"
  {{ section.shopify_attributes }}
>
  <aside class="lame-op-side-images__aside" aria-label="{{ section.settings.aria_label | default: 'Promotional images' | escape }}">
    <div class="lame-op-side-images__column">
      {%- for block in section.blocks -%}
        <div class="lame-op-side-images__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="lame-op-side-images__link">
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag:
                class: 'lame-op-side-images__img',
                loading: 'lazy',
                widths: '180, 240, 300, 360, 480, 600',
                sizes: '(min-width: 1200px) var(--lame-op-side-width, 180px), 0px',
                alt: block.settings.image_alt | escape
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'lame-op-side-images__placeholder' }}
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </aside>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Our Products side images",
  "tag": "section",
  "class": "section-wrapper lame-our-products-side-image-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Deprecated — use Promo image blocks on the Collection section instead. This section is kept for older templates only."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Promotional images"
    },
    {
      "type": "range",
      "id": "column_width",
      "label": "Column width (desktop)",
      "min": 120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "offset_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Products side images",
      "category": "Collection",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
