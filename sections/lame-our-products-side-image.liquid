{%- liquid
  assign lame_category_shop_page = false
  assign lame_cosmetic_collection = false
  assign lame_category_hero_handles = 'bath-body,fragrance,make-up,skin-care,baby-mom,wellness,hair-care' | split: ','

  if template.name == 'collection' and collection != blank
    if lame_category_hero_handles contains collection.handle
      assign lame_category_shop_page = true
    endif

    unless lame_category_shop_page
      if template.suffix == 'our-products' or collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
        assign lame_cosmetic_collection = true
      endif
    endunless
  endif

  assign show_side_images = false
  if lame_cosmetic_collection and lame_category_shop_page == false
    if template.suffix == 'our-products' or collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
      assign show_side_images = true
    endif
  endif
-%}

{%- if show_side_images -%}
  {%- render 'lame-our-products-side-images',
    blocks: section.blocks,
    column_width: section.settings.column_width,
    image_gap: section.settings.image_gap,
    top_spacing: section.settings.offset_top,
    aria_label: section.settings.aria_label
  -%}
  <script>
    (() => {
      const relocate = () => {
        const slot = document.querySelector('[data-lame-op-side-slot]');
        const root = document.querySelector('.lame-our-products-side-image-section .lame-op-side-images');
        if (!slot || !root || slot.contains(root)) return;

        slot.appendChild(root);

        const wrapper = slot.closest('.collection-wrapper');
        for (const name of ['--lame-op-side-width', '--lame-op-side-top', '--lame-op-side-gap']) {
          const value = root.style.getPropertyValue(name);
          if (!value) continue;
          slot.style.setProperty(name, value);
          wrapper?.style.setProperty(name, value);
        }
      };

      relocate();
      document.addEventListener('shopify:section:load', relocate);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Our Products side images",
  "tag": "section",
  "class": "section-wrapper lame-our-products-side-image-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Three promotional images in a vertical column beside the product grid. Scrolls with the page. Hidden on mobile and tablet."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessibility label",
      "default": "Promotional images"
    },
    {
      "type": "range",
      "id": "column_width",
      "label": "Column width (desktop)",
      "min": 120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 180
    },
    {
      "type": "range",
      "id": "offset_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap between images",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Products side images",
      "category": "Collection",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}