<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-skincare-routine"
  {{ section.shopify_attributes }}
>
  <div class="lame-skincare-routine__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="lame-skincare-routine__heading" data-lame-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="lame-skincare-routine__grid">
      <div class="lame-skincare-routine__steps" data-lame-reveal>
        <ol class="lame-skincare-routine__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li class="lame-skincare-routine__step" {{ block.shopify_attributes }}>
                <span class="lame-skincare-routine__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'tone' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v18M8 7h8M7 12h10M8 17h8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    {%- when 'treat' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M8 6h8v12H8z" stroke="currentColor" stroke-width="1.3"/><path d="M10 10h4M10 14h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    {%- when 'moisturize' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 21c4-5 6-9 6-13a6 6 0 1 0-12 0c0 4 2 8 6 13Z" stroke="currentColor" stroke-width="1.3"/></svg>
                    {%- when 'protect' -%}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M8 8h8l-1 12H9L8 8Z" stroke="currentColor" stroke-width="1.3"/><path d="M10 8V6.5A2 2 0 0 1 14 6.5V8" stroke="currentColor" stroke-width="1.3"/></svg>
                  {%- endcase -%}
                </span>
                <div class="lame-skincare-routine__copy">
                  {%- if block.settings.title != blank -%}
                    <h3 class="lame-skincare-routine__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="lame-skincare-routine__text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
                {%- unless forloop.last -%}
                  <span class="lame-skincare-routine__arrow" aria-hidden="true">→</span>
                {%- endunless -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="lame-skincare-routine__media" data-lame-reveal data-lame-delay="1">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'lame-skincare-routine__photo',
              loading: 'lazy',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 990px) 38vw, 92vw',
              alt: section.settings.image.alt | default: section.settings.heading | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-skincare-routine__wrap {
    padding-inline: max(1rem, var(--page-margin));
  }

  .lame-skincare-routine__heading {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
    font-family: var(--lame-font-display);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-align: center;
    color: rgb(var(--lame-cos-forest, var(--brand-forest)));
  }

  .lame-skincare-routine__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: center;
  }

  .lame-skincare-routine__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lame-skincare-routine__step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem;
    background: var(--lame-premium-white);
    border: 1px solid rgb(var(--brand-forest) / 0.08);
    border-radius: var(--lame-premium-radius);
    box-shadow: var(--lame-premium-shadow);
  }

  .lame-skincare-routine__arrow {
    display: none;
  }

  .lame-skincare-routine__icon {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgb(var(--brand-forest) / 0.08);
    color: var(--lame-premium-forest);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lame-skincare-routine__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .lame-skincare-routine__title {
    margin: 0 0 0.25rem;
    font-family: var(--lame-font-display);
    font-size: 1.05rem;
    font-weight: 500;
    color: rgb(var(--brand-forest));
  }

  .lame-skincare-routine__text {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--lame-premium-muted);
  }

  .lame-skincare-routine__media {
    border-radius: var(--lame-premium-radius-lg);
    overflow: hidden;
    box-shadow: var(--lame-premium-shadow-lg);
  }

  .lame-skincare-routine__photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 4 / 5;
  }

  [data-lame-reveal] {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  [data-lame-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (min-width: 990px) {
    .lame-skincare-routine__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }

    .lame-skincare-routine__list {
      flex-direction: row;
      flex-wrap: nowrap;
      gap: 0;
      align-items: stretch;
    }

    .lame-skincare-routine__step {
      flex: 1 1 0;
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      border-radius: 0;
      box-shadow: none;
      border: none;
      border-inline-end: 1px solid rgb(var(--brand-forest) / 0.1);
      background: transparent;
      padding: 0.5rem 0.75rem;
      position: relative;
    }

    .lame-skincare-routine__step:last-child {
      border-inline-end: none;
    }

    .lame-skincare-routine__arrow {
      display: block;
      position: absolute;
      right: -0.35rem;
      top: 1.35rem;
      font-size: 0.85rem;
      color: rgb(var(--brand-forest) / 0.45);
      z-index: 1;
    }

    .lame-skincare-routine__copy {
      max-width: 11rem;
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Skincare routine",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple Steps, Beautiful Skin." },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cleanse", "label": "Cleanse" },
            { "value": "tone", "label": "Tone" },
            { "value": "treat", "label": "Treat" },
            { "value": "moisturize", "label": "Moisturize" },
            { "value": "protect", "label": "Protect" }
          ],
          "default": "cleanse"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
        { "type": "text", "id": "text", "label": "Description", "default": "Gently remove impurities without stripping." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skincare routine",
      "blocks": [
        { "type": "step", "settings": { "icon": "cleanse", "title": "Cleanse", "text": "Gently remove impurities without stripping." } },
        { "type": "step", "settings": { "icon": "tone", "title": "Tone", "text": "Balance and prep skin for treatment." } },
        { "type": "step", "settings": { "icon": "treat", "title": "Treat", "text": "Target concerns with active serums." } },
        { "type": "step", "settings": { "icon": "moisturize", "title": "Moisturize", "text": "Lock in hydration for a soft glow." } },
        { "type": "step", "settings": { "icon": "protect", "title": "Protect", "text": "Shield with SPF every morning." } }
      ]
    }
  ]
}
{% endschema %}
