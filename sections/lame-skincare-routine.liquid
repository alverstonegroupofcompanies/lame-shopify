{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign text_mod = section.settings.text_color | default: 'light'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-skincare-routine lame-skincare-routine--text-{{ text_mod }}"
  style="
    --lame-routine-overlay-width: {{ section.settings.overlay_width }}%;
    {% if section.settings.overlay_scrim %}--lame-routine-scrim: {{ section.settings.overlay_scrim_opacity | divided_by: 100.0 }};{% endif %}
  "
  {{ section.shopify_attributes }}
>
  <div class="lame-skincare-routine__stage spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.image != blank -%}
      <div class="lame-skincare-routine__media" aria-hidden="true">
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'lame-skincare-routine__image',
            loading: 'lazy',
            widths: '750, 990, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {%- else -%}
      <div class="lame-skincare-routine__media lame-skincare-routine__media--placeholder" aria-hidden="true">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'lame-skincare-routine__image placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="lame-skincare-routine__overlay">
      <div class="lame-skincare-routine__overlay-inner" data-lame-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lame-skincare-routine__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="lame-skincare-routine__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if step_blocks.size > 0 -%}
          <ol class="lame-skincare-routine__steps" role="list">
            {%- for block in step_blocks -%}
              <li class="lame-skincare-routine__step" {{ block.shopify_attributes }}>
                <span class="lame-skincare-routine__step-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'tone' -%}
                      <svg viewBox="0 0 24 24" fill="none"><rect x="8" y="4" width="8" height="16" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M10 8h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    {%- when 'treat' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3M9 6h6l-1 14H10L9 6Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="12" cy="3" r="1.2" fill="currentColor"/></svg>
                    {%- when 'moisturize' -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M6 10h12v10a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V10Z" stroke="currentColor" stroke-width="1.3"/><path d="M9 10V8a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.3"/></svg>
                    {%- when 'protect' -%}
                      <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none"><path d="M9 4h6v3a3 3 0 0 1-6 0V4Z" stroke="currentColor" stroke-width="1.3"/><path d="M7 7h10l-1 13H8L7 7Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M9 11h1M14 11h1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                  {%- endcase -%}
                </span>
                {%- if block.settings.title != blank -%}
                  <p class="lame-skincare-routine__step-title">{{ block.settings.title | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="lame-skincare-routine__step-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </li>
              {%- unless forloop.last -%}
                <li class="lame-skincare-routine__arrow" aria-hidden="true">&#8250;</li>
              {%- endunless -%}
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="lame-skincare-routine__cta lame-btn--forest"
            href="{{ section.settings.button_link | default: routes.collections_url }}"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="lame-skincare-routine__mobile-content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lame-skincare-routine__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="lame-skincare-routine__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if step_blocks.size > 0 -%}
        <ol class="lame-skincare-routine__steps lame-skincare-routine__steps--mobile" role="list">
          {%- for block in step_blocks -%}
            <li class="lame-skincare-routine__step" {{ block.shopify_attributes }}>
              <span class="lame-skincare-routine__step-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'tone' -%}
                    <svg viewBox="0 0 24 24" fill="none"><rect x="8" y="4" width="8" height="16" rx="2" stroke="currentColor" stroke-width="1.3"/></svg>
                  {%- when 'treat' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3v3M9 6h6l-1 14H10L9 6Z" stroke="currentColor" stroke-width="1.3"/></svg>
                  {%- when 'moisturize' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M6 10h12v10H6V10Z" stroke="currentColor" stroke-width="1.3"/></svg>
                  {%- when 'protect' -%}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.3"/><path d="M12 2v2M12 20v2" stroke="currentColor" stroke-width="1.3"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M9 4h6v3H9V4Z" stroke="currentColor" stroke-width="1.3"/><path d="M7 7h10l-1 13H8L7 7Z" stroke="currentColor" stroke-width="1.3"/></svg>
                {%- endcase -%}
              </span>
              {%- if block.settings.title != blank -%}
                <p class="lame-skincare-routine__step-title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="lame-skincare-routine__step-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          class="lame-skincare-routine__cta lame-btn--forest lame-skincare-routine__cta--mobile"
          href="{{ section.settings.button_link | default: routes.collections_url }}"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const node = section.querySelector('[data-lame-reveal]');
    if (!node) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      observer.observe(node);
    } else {
      node.classList.add('is-visible');
    }
  })();
</script>

{% stylesheet %}
  .lame-skincare-routine {
    --lame-routine-scrim: 0;
    padding: 0 !important;
  }

  .lame-skincare-routine > .section-background {
    display: none;
  }

  .lame-skincare-routine__stage {
    position: relative;
    width: 100%;
    min-height: clamp(380px, 42vw, 520px);
    overflow: hidden;
    padding: 0 !important;
  }

  .lame-skincare-routine__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .lame-skincare-routine__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    display: block;
  }

  .lame-skincare-routine__overlay {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: var(--lame-routine-overlay-width, 50%);
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: rgb(0 0 0 / var(--lame-routine-scrim, 0));
  }

  .lame-skincare-routine__overlay-inner {
    width: 100%;
    max-width: 34rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .lame-skincare-routine__overlay-inner.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lame-skincare-routine--text-light .lame-skincare-routine__eyebrow,
  .lame-skincare-routine--text-light .lame-skincare-routine__heading,
  .lame-skincare-routine--text-light .lame-skincare-routine__step-title,
  .lame-skincare-routine--text-light .lame-skincare-routine__step-text,
  .lame-skincare-routine--text-light .lame-skincare-routine__arrow {
    color: #fff;
  }

  .lame-skincare-routine--text-dark .lame-skincare-routine__eyebrow,
  .lame-skincare-routine--text-dark .lame-skincare-routine__heading,
  .lame-skincare-routine--text-dark .lame-skincare-routine__step-title {
    color: rgb(var(--lame-premium-forest, 45 74 34));
  }

  .lame-skincare-routine--text-dark .lame-skincare-routine__step-text,
  .lame-skincare-routine--text-dark .lame-skincare-routine__arrow {
    color: rgb(var(--lame-premium-muted, 90 96 86));
  }

  .lame-skincare-routine__eyebrow {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', sans-serif);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .lame-skincare-routine__heading {
    margin: 0;
    font-family: var(--lame-font-display, 'Cormorant Garamond', serif);
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.01em;
  }

  .lame-skincare-routine__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: center;
    gap: 0.35rem 0.15rem;
    width: 100%;
  }

  .lame-skincare-routine__step {
    flex: 0 1 4.5rem;
    min-width: 3.75rem;
    max-width: 5.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .lame-skincare-routine__step-icon {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: rgb(var(--lame-premium-sage, 141 160 137) / 0.85);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lame-skincare-routine__step-icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .lame-skincare-routine__step-title {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', sans-serif);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .lame-skincare-routine__step-text {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', sans-serif);
    font-size: 0.52rem;
    line-height: 1.35;
    opacity: 0.88;
  }

  .lame-skincare-routine__arrow {
    list-style: none;
    align-self: center;
    font-size: 0.85rem;
    opacity: 0.6;
    padding-top: 0.5rem;
    flex: 0 0 auto;
  }

  .lame-skincare-routine__cta {
    margin-top: 0.35rem;
  }

  .lame-skincare-routine__mobile-content {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .lame-skincare-routine__stage {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .lame-skincare-routine__media {
      position: relative;
      aspect-ratio: 16 / 10;
      flex-shrink: 0;
    }

    .lame-skincare-routine__overlay {
      display: none;
    }

    .lame-skincare-routine__mobile-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1rem;
      padding: clamp(1.25rem, 4vw, 2rem) max(1rem, var(--page-margin));
      background: var(--lame-premium-cream, #f9f9f7);
    }

    .lame-skincare-routine--text-light .lame-skincare-routine__mobile-content .lame-skincare-routine__eyebrow,
    .lame-skincare-routine--text-light .lame-skincare-routine__mobile-content .lame-skincare-routine__heading,
    .lame-skincare-routine--text-light .lame-skincare-routine__mobile-content .lame-skincare-routine__step-title {
      color: rgb(var(--lame-premium-forest, 45 74 34));
    }

    .lame-skincare-routine--text-light .lame-skincare-routine__mobile-content .lame-skincare-routine__step-text {
      color: rgb(var(--lame-premium-muted, 90 96 86));
    }

    .lame-skincare-routine__steps--mobile {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 0.75rem;
      width: 100%;
      max-width: 28rem;
    }

    .lame-skincare-routine__steps--mobile .lame-skincare-routine__step {
      flex: none;
      max-width: none;
      min-width: 0;
    }

    .lame-skincare-routine__cta--mobile {
      width: 100%;
      max-width: 20rem;
    }
  }

  @media screen and (max-width: 479px) {
    .lame-skincare-routine__steps--mobile {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Skincare routine",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Skin Care Routine" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Simple Steps, Beautiful Skin" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Routine Guide" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "range",
      "id": "overlay_width",
      "label": "Left overlay width",
      "min": 35,
      "max": 65,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color on overlay",
      "options": [
        { "value": "light", "label": "Light (for dark banner left)" },
        { "value": "dark", "label": "Dark (for cream banner left)" }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "overlay_scrim",
      "label": "Add dark scrim on overlay zone",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_scrim_opacity",
      "label": "Scrim opacity",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "cleanse", "label": "Cleanse" },
            { "value": "tone", "label": "Tone" },
            { "value": "treat", "label": "Treat" },
            { "value": "moisturize", "label": "Moisturize" },
            { "value": "protect", "label": "Protect" }
          ],
          "default": "cleanse"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse" },
        { "type": "text", "id": "text", "label": "Description", "default": "Remove dirt & refresh your skin" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Skincare routine",
      "blocks": [
        { "type": "step", "settings": { "icon": "cleanse", "title": "Cleanse", "text": "Remove dirt & refresh your skin" } },
        { "type": "step", "settings": { "icon": "tone", "title": "Tone", "text": "Balance & hydrate skin" } },
        { "type": "step", "settings": { "icon": "treat", "title": "Treat", "text": "Target concerns with care" } },
        { "type": "step", "settings": { "icon": "moisturize", "title": "Moisturize", "text": "Nourish & protect your skin" } },
        { "type": "step", "settings": { "icon": "protect", "title": "Protect", "text": "Shield with SPF every day" } }
      ]
    }
  ]
}
{% endschema %}
