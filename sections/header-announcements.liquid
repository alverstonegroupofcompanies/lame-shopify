
{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{%- liquid
  assign phone = section.settings.phone | default: shop.phone
  if phone == blank and section.settings.phone_fallback != blank
    assign phone = section.settings.phone_fallback
  endif
  assign show_contact = section.settings.show_contact and phone != blank

  assign social_keys = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,pinterest_url' | split: ','
  assign show_social = false
  if section.settings.show_social
    for link_key in social_keys
      if section.settings[link_key] != blank
        assign show_social = true
        break
      endif
    endfor
  endif

  assign autoplay = false
  assign show_arrows = false
  if section.blocks.size > 1
    assign autoplay = true
    assign show_arrows = true
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar announcement-bar--cosmetic spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
  aria-label="{{ section.settings.accessibility_label | escape }}"
>
  <div class="announcement-bar__grid page-width">
    <div class="announcement-bar__column announcement-bar__column--start">
      {%- if show_contact -%}
        <a
          class="announcement-bar__contact"
          href="tel:{{ phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' }}"
        >
          <span class="announcement-bar__contact-label">{{ section.settings.contact_label }}</span>
          <span class="announcement-bar__contact-value">{{ phone }}</span>
        </a>
      {%- elsif request.design_mode and section.settings.show_contact -%}
        <span class="announcement-bar__hint">{{ section.settings.contact_label }} — add phone in bar settings</span>
      {%- endif -%}
    </div>

    <div class="announcement-bar__column announcement-bar__column--center">
      {%- if section.blocks.size > 0 -%}
        <announcement-bar-component
          class="announcement-bar__slider"
          {% if autoplay %}
            autoplay="{{ section.settings.speed }}" aria-live="polite"
          {% endif %}
        >
          {% if show_arrows %}
            {% render 'slideshow-arrows', icon_style: 'chevron' %}
          {% endif %}

          <div class="announcement-bar__slides">
            {% content_for 'blocks' %}
          </div>
        </announcement-bar-component>
      {%- elsif request.design_mode -%}
        <p class="announcement-bar__hint">Add an announcement block for the center message</p>
      {%- endif -%}
    </div>

    <div class="announcement-bar__column announcement-bar__column--end">
      {%- if show_social -%}
        <ul class="announcement-bar__social" role="list">
          {%- for link_key in social_keys -%}
            {%- assign link_url = section.settings[link_key] -%}
            {%- if link_url == blank -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              case link_key
                when 'facebook_url'
                  assign platform = 'facebook'
                when 'instagram_url'
                  assign platform = 'instagram'
                when 'youtube_url'
                  assign platform = 'youtube'
                when 'tiktok_url'
                  assign platform = 'tiktok'
                when 'twitter_url'
                  assign platform = 'twitter'
                when 'pinterest_url'
                  assign platform = 'pinterest'
              endcase
            -%}
            <li>
              <a
                class="announcement-bar__social-link"
                href="{{ link_url }}"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="{{ platform | capitalize }}"
              >
                <svg class="announcement-bar__social-icon" aria-hidden="true" focusable="false" viewBox="0 0 20 20">
                  {%- render 'icon', icon: platform -%}
                </svg>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</aside>

{% stylesheet %}
  .announcement-bar--cosmetic {
    border-block-end: var(--border-bottom-width) solid rgb(var(--color-border-rgb) / 0.3);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  .announcement-bar__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--gap-md);
    min-height: 2.25rem;
  }

  .announcement-bar__column {
    min-width: 0;
  }

  .announcement-bar__column--start {
    justify-self: start;
  }

  .announcement-bar__column--center {
    justify-self: center;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
  }

  .announcement-bar__column--end {
    justify-self: end;
  }

  .announcement-bar__contact {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.3;
  }

  .announcement-bar__contact:hover,
  .announcement-bar__contact:focus-visible {
    opacity: 0.88;
    text-decoration: underline;
    text-underline-offset: 0.12em;
  }

  .announcement-bar__contact-label {
    font-weight: 600;
  }

  .announcement-bar__hint {
    margin: 0;
    opacity: 0.55;
    font-size: 0.6875rem;
    line-height: 1.3;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    min-height: 1.35rem;
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] minmax(0, 1fr);
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    place-items: center;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.45s ease-in-out, visibility 0.45s ease-in-out;
    place-content: center;
    width: 100%;
    text-align: center;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__text {
    margin: 0;
    font-size: inherit;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: 0.03em;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__text p {
    margin: 0;
    display: inline;
  }

  .announcement-bar__text a {
    color: inherit;
    font-weight: 700;
    text-underline-offset: 0.12em;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    animation: none;
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: 0.65rem;
    height: 0.65rem;
  }

  .announcement-bar__social {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .announcement-bar__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .announcement-bar__social-link:hover,
  .announcement-bar__social-link:focus-visible {
    background: rgb(var(--color-foreground-rgb) / 0.12);
    border-color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .announcement-bar__social-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0;
      min-height: auto;
    }

    .announcement-bar__column--start,
    .announcement-bar__column--end {
      display: none;
    }

    .announcement-bar__column--center {
      max-width: 100%;
    }

    .announcement-bar__text {
      font-size: 0.6875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contact (left)"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Phone label",
      "default": "Call us:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "Leave blank to use the store phone from Shopify admin."
    },
    {
      "type": "text",
      "id": "phone_fallback",
      "label": "Fallback phone",
      "default": "+1 (234) 567-8900"
    },
    {
      "type": "header",
      "content": "Social (right)"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest"
    },
    {
      "type": "header",
      "content": "Announcements (center)"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Region label (screen readers)",
      "default": "Store announcements"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-cosmetic-bar",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "<p>Sign up and GET 25% OFF your first order. <a href=\"/account/register\">Sign up now</a></p>"
          }
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
