{%- liquid
  assign max_products = section.settings.max_products | default: 8
  assign found = 0
  assign exclude_ids = product.id | append: '|'
  assign similar_handles = ''

  assign source_collection = collection
  if source_collection == blank
    assign source_collection = product.collections.first
  endif
  if source_collection == blank
    assign source_collection = collections.all
  endif

  assign title_lc = product.title | downcase | replace: '-', ' ' | replace: '|', ' '
  assign keywords = title_lc | split: ' '

  comment
    Pass 1: same vendor
  endcomment
  for item in source_collection.products limit: 200
    if found >= max_products
      break
    endif
    if item.id == product.id
      continue
    endif
    assign id_token = item.id | append: '|'
    if exclude_ids contains id_token
      continue
    endif
    if product.vendor != blank and item.vendor == product.vendor
      assign similar_handles = similar_handles | append: item.handle | append: '|'
      assign exclude_ids = exclude_ids | append: id_token
      assign found = found | plus: 1
    endif
  endfor

  comment
    Pass 2: title keyword overlap (3+ character words)
  endcomment
  for item in source_collection.products limit: 200
    if found >= max_products
      break
    endif
    if item.id == product.id
      continue
    endif
    assign id_token = item.id | append: '|'
    if exclude_ids contains id_token
      continue
    endif

    assign item_title_lc = item.title | downcase
    assign keyword_hit = false

    for kw in keywords
      assign word = kw | strip
      if word.size < 3
        continue
      endif
      if item_title_lc contains word
        assign keyword_hit = true
        break
      endif
    endfor

    if keyword_hit
      assign similar_handles = similar_handles | append: item.handle | append: '|'
      assign exclude_ids = exclude_ids | append: id_token
      assign found = found | plus: 1
    endif
  endfor

  comment
    Pass 3: same product type
  endcomment
  if product.type != blank
    for item in source_collection.products limit: 200
      if found >= max_products
        break
      endif
      if item.id == product.id
        continue
      endif
      assign id_token = item.id | append: '|'
      if exclude_ids contains id_token
        continue
      endif
      if item.type == product.type
        assign similar_handles = similar_handles | append: item.handle | append: '|'
        assign exclude_ids = exclude_ids | append: id_token
        assign found = found | plus: 1
      endif
    endfor
  endif

  assign similar_handle_list = similar_handles | split: '|'
-%}

{% if found > 0 %}
  {{ 'lame-shop-product-card.css' | asset_url | stylesheet_tag }}

  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-pdp-similar lame-our-products-card-scope"
    data-pdp-similar-carousel
    {{ section.shopify_attributes }}
  >
    <div class="lame-pdp-similar__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
      <header class="lame-pdp-similar__header">
        <h2 class="lame-pdp-similar__heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="lame-pdp-similar__subheading">{{ section.settings.subheading | escape }}</p>
        {% endif %}
      </header>

      <div class="lame-pdp-similar__carousel">
        <button
          type="button"
          class="lame-pdp-similar__nav lame-pdp-similar__nav--prev"
          data-pdp-similar-prev
          aria-label="{{ 'lame_cart.carousel_prev' | t | default: 'Previous' }}"
        >
          <span aria-hidden="true">&#8249;</span>
        </button>

        <div class="lame-pdp-similar__viewport" data-pdp-similar-viewport>
          <ul class="lame-pdp-similar__track" role="list" data-pdp-similar-track>
            {% for handle in similar_handle_list %}
              {% if handle == blank %}
                {% continue %}
              {% endif %}
              {% assign similar_product = all_products[handle] %}
              {% if similar_product == blank %}
                {% continue %}
              {% endif %}
              <li class="lame-pdp-similar__slide">
                {% render 'lame-shop-product-card', product: similar_product, section: section %}
              </li>
            {% endfor %}
          </ul>
        </div>

        <button
          type="button"
          class="lame-pdp-similar__nav lame-pdp-similar__nav--next"
          data-pdp-similar-next
          aria-label="{{ 'lame_cart.carousel_next' | t | default: 'Next' }}"
        >
          <span aria-hidden="true">&#8250;</span>
        </button>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;

      const viewport = section.querySelector('[data-pdp-similar-viewport]');
      const track = section.querySelector('[data-pdp-similar-track]');
      const prev = section.querySelector('[data-pdp-similar-prev]');
      const next = section.querySelector('[data-pdp-similar-next]');
      if (!viewport || !track) return;

      const scrollBySlide = (dir) => {
        const slide = track.querySelector('.lame-pdp-similar__slide');
        if (!slide) return;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '16') || 16;
        viewport.scrollBy({ left: dir * (slide.getBoundingClientRect().width + gap), behavior: 'smooth' });
      };

      prev?.addEventListener('click', () => scrollBySlide(-1));
      next?.addEventListener('click', () => scrollBySlide(1));
    })();
  </script>
{% endif %}

{% stylesheet %}
  .lame-pdp-similar {
    --lame-pdp-similar-gap: 1rem;
    --lame-pdp-similar-card: 220px;
    background: #f7f7f5;
  }

  .lame-pdp-similar__wrap {
    width: 100%;
    max-width: min(1120px, 100%);
    margin-inline: auto;
    padding-inline: clamp(1rem, 3vw, 1.5rem);
    box-sizing: border-box;
  }

  .lame-pdp-similar__header {
    margin-bottom: 1.15rem;
  }

  .lame-pdp-similar__heading {
    margin: 0;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.25rem, 2.2vw, 1.6rem);
    font-weight: 600;
    color: #121212;
  }

  .lame-pdp-similar__subheading {
    margin: 0.35rem 0 0;
    font-size: 0.95rem;
    color: #6b7280;
  }

  .lame-pdp-similar__carousel {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: stretch;
    gap: 0.5rem;
  }

  .lame-pdp-similar__nav {
    align-self: center;
    flex-shrink: 0;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgb(0 0 0 / 0.12);
    border-radius: 50%;
    background: #fff;
    color: #6b7280;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .lame-pdp-similar__nav:hover {
    border-color: rgb(26 77 46 / 0.35);
    color: #1a4d2e;
  }

  .lame-pdp-similar__viewport {
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .lame-pdp-similar__viewport::-webkit-scrollbar {
    display: none;
  }

  .lame-pdp-similar__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--lame-pdp-similar-gap);
    margin: 0;
    padding: 0.25rem 0.15rem 0.5rem;
    list-style: none;
    width: max-content;
  }

  .lame-pdp-similar__slide {
    flex: 0 0 var(--lame-pdp-similar-card);
    width: var(--lame-pdp-similar-card);
    min-width: var(--lame-pdp-similar-card);
    max-width: var(--lame-pdp-similar-card);
    scroll-snap-align: start;
    box-sizing: border-box;
  }

  .lame-pdp-similar__slide .lame-catlog-card {
    height: 100%;
    background: #fff;
    border: 1px solid #e8ebe9;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgb(18 18 18 / 0.04);
  }

  .lame-pdp-similar__slide .lame-catlog-card:hover {
    transform: translateY(-2px);
    border-color: rgb(26 77 46 / 0.22);
    box-shadow: 0 12px 28px rgb(18 18 18 / 0.08);
  }

  @media screen and (min-width: 750px) {
    .lame-pdp-similar {
      --lame-pdp-similar-card: 240px;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-pdp-similar {
      --lame-pdp-similar-card: min(200px, 68vw);
    }

    .lame-pdp-similar__nav {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Similar products",
  "tag": "section",
  "class": "lame-product-similar-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Handpicked picks with a similar look and feel"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart button label",
      "default": "Add to cart",
      "info": "Unused with catalog cards (card has its own Add to cart)"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Similar products"
    }
  ]
}
{% endschema %}
