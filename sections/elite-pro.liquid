    height: 32px;
    border-radius: 50%;
    background: var(--elite-pink-medium);
    color: var(--elite-maroon);
    font-weight: 900;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border: 1px solid var(--elite-gold);
  }

  .elite-pro-perk-item__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--elite-maroon);
    margin: 0 0 0.25rem;
  }

  .elite-pro-perk-item__desc {
    font-size: 0.88rem;
    color: var(--elite-text-muted);
    margin: 0;
    line-height: 1.45;
  }

  /* Final Box */
  .elite-pro-final-box {
    background: linear-gradient(135deg, var(--elite-maroon-dark) 0%, var(--elite-maroon) 50%, var(--elite-maroon-dark) 100%);
    color: var(--elite-white);
    border-radius: var(--elite-radius-lg);
    padding: 3.5rem 2rem;
    text-align: center;
    box-shadow: var(--elite-shadow-lg);
    border: 2px solid var(--elite-gold);
    position: relative;
    overflow: hidden;
  }

  .elite-pro-final-box__badge {
    display: inline-block;
    background: var(--elite-gold);
    color: var(--elite-maroon-dark);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.35rem 1rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .elite-pro-final-box__title {
    font-family: var(--font-heading-family, inherit);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    color: var(--elite-white);
    font-weight: 800;
    margin: 0 0 1rem;
    letter-spacing: -0.01em;
  }

  .elite-pro-final-box__desc {
    font-size: 1.1rem;
    color: var(--elite-pink-soft);
    max-width: 620px;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  .elite-pro-final-box__action {
    margin-bottom: 1.25rem;
  }

  .elite-pro-final-box__guarantee {
    font-size: 0.82rem;
    color: var(--elite-gold-light);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
    font-weight: 600;
  }

  /* Responsive Adjustments */
  @media screen and (max-width: 768px) {
    .elite-pro-section {
      padding: 2rem 1rem 3.5rem;
    }
    .elite-pro-container {
      gap: 2.5rem;
    }
    .elite-pro-hero__price-bar {
      border-radius: var(--elite-radius-md);
      flex-direction: column;
      align-items: stretch;
      padding: 1.25rem;
      gap: 1rem;
    }
    .elite-pro-hero__price-info {
      text-align: center;
    }
    .elite-pro-refer-box {
      padding: 2rem 1.5rem;
    }
    .elite-pro-refer-box__inner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
    }
    .elite-pro-refer-box__action {
      width: 100%;
    }
    .elite-pro-btn--refer {
      width: 100%;
    }
    .elite-pro-final-box {
      padding: 2.5rem 1.5rem;
    }
    .elite-pro-perks-list {
      grid-template-columns: 1fr;
    }
  }
</style>

