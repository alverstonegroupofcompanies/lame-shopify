{% liquid
  assign featured_collection = collections[section.settings.collection]
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="lame-featured-products spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-featured-products__header" data-lame-reveal>
      <h2 class="lame-featured-products__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="lame-featured-products__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    <div class="lame-featured-products__carousel-wrap">
      <button class="lame-featured-products__arrow lame-featured-products__arrow--prev" type="button" aria-label="{{ section.settings.prev_products_label }}" data-arrow="prev">
        <span aria-hidden="true">&#8249;</span>
      </button>
      <button class="lame-featured-products__arrow lame-featured-products__arrow--next" type="button" aria-label="{{ section.settings.next_products_label }}" data-arrow="next">
        <span aria-hidden="true">&#8250;</span>
      </button>
      <ul class="lame-featured-products__grid" role="list" data-featured-track>
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        <li class="lame-featured-products__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 3 }}">
          {% liquid
            assign selected_variant = product.selected_or_first_available_variant
          %}
          <div class="lame-featured-products__card">
            <a href="{{ product.url }}" class="lame-featured-products__media-link" aria-label="{{ product.title | escape }}">
              <div class="lame-featured-products__image-wrap">
                {% if product.featured_media %}
                  {{
                    product.featured_media
                    | image_url: width: 900
                    | image_tag:
                      class: 'lame-featured-products__image',
                      loading: 'lazy',
                      widths: '240,360,480,720,900',
                      sizes: '(min-width: 1200px) 14vw, (min-width: 990px) 17vw, (min-width: 750px) 23vw, 36vw'
                  }}
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-featured-products__image placeholder-svg' }}
                {% endif %}
              </div>
            </a>
            {% if selected_variant %}
              <form method="post" action="{{ routes.cart_add_url }}" class="lame-featured-products__quick-add-form">
                <input type="hidden" name="id" value="{{ selected_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  class="lame-featured-products__quick-add"
                  aria-label="{{ section.settings.add_to_cart_label }} {{ product.title | escape }}"
                  {% unless product.available %}
                    disabled
                  {% endunless %}
                >
                  <span class="visually-hidden">{{ section.settings.add_to_cart_label }}</span>
                  <svg aria-hidden="true" viewBox="0 0 20 20" focusable="false">
                    <path d="M3.5 6.8h13l-1.2 8.1a1.4 1.4 0 0 1-1.38 1.19H6.1a1.4 1.4 0 0 1-1.38-1.19L3.5 6.8Z"></path>
                    <path d="M7.2 6.7V5.4a2.8 2.8 0 0 1 5.6 0v1.3"></path>
                  </svg>
                </button>
              </form>
            {% endif %}

            <div class="lame-featured-products__content">
              <h3 class="lame-featured-products__product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <p class="lame-featured-products__price">
                {% render 'price', product_resource: product, show_sale_price_first: true %}
              </p>
            </div>
          </div>
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-featured-products__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 3 }}">
            <div class="lame-featured-products__card">
              <div class="lame-featured-products__image-wrap">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-featured-products__image placeholder-svg' }}
              </div>
              <div class="lame-featured-products__content">
                <h3 class="lame-featured-products__product-title">{{ section.settings.placeholder_product_title }}</h3>
                <p class="lame-featured-products__price">{{ section.settings.placeholder_product_price }}</p>
              </div>
            </div>
          </li>
        {% endfor %}
      {% endfor %}
      </ul>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const track = section.querySelector('[data-featured-track]');
    if (!track) return;
    const prev = section.querySelector('[data-arrow=\"prev\"]');
    const next = section.querySelector('[data-arrow=\"next\"]');
    if (!prev || !next) return;

    const updateArrows = () => {
      const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
      const hasOverflow = maxScrollLeft > 1;
      prev.hidden = !hasOverflow;
      next.hidden = !hasOverflow;
      if (!hasOverflow) {
        prev.disabled = true;
        next.disabled = true;
        return;
      }

      const current = track.scrollLeft;
      prev.disabled = current <= 1;
      next.disabled = current >= maxScrollLeft - 1;
    };

    const scrollByCard = (direction) => {
      const card = track.querySelector('.lame-featured-products__item');
      if (!card) return;
      const styles = getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0');
      const amount = card.clientWidth + gap;
      track.scrollBy({ left: direction * amount, behavior: 'smooth' });
    };

    prev.addEventListener('click', () => scrollByCard(-1));
    next.addEventListener('click', () => scrollByCard(1));
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    setTimeout(updateArrows, 0);

    if ('IntersectionObserver' in window) {
      const revealNodes = section.querySelectorAll('[data-lame-reveal]');
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      section.querySelectorAll('[data-lame-reveal]').forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-featured-products__header {
    text-align: center;
    margin-bottom: var(--padding-md);
  }

  .lame-featured-products__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-featured-products__subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 42ch;
    margin-inline: auto;
  }

  .lame-featured-products__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .lame-featured-products__grid::-webkit-scrollbar {
    display: none;
  }

  .lame-featured-products__carousel-wrap {
    position: relative;
    padding-inline: 2rem;
  }

  .lame-featured-products__item {
    min-width: calc((100% - 24px) / 2.3);
    scroll-snap-align: start;
    display: flex;
  }

  .lame-featured-products__card {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    border: 1px solid rgb(var(--color-border-rgb) / 0.16);
    background: transparent;
    padding: 0.45rem;
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
    position: relative;
  }

  .lame-featured-products__card:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.28);
    transform: translateY(-3px);
    box-shadow: 0 12px 24px rgb(16 16 16 / 0.08);
  }

  .lame-featured-products__image-wrap {
    aspect-ratio: 1 / 1.02;
    background: transparent;
    display: grid;
    place-items: center;
    position: relative;
  }

  .lame-featured-products__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 280ms ease;
  }

  .lame-featured-products__item:is(:hover, :focus-within) .lame-featured-products__image {
    transform: scale(1.025);
  }

  .lame-featured-products__content {
    padding-top: 0.42rem;
    text-align: center;
    min-height: 58px;
  }

  .lame-featured-products__product-title {
    margin: 0 0 0.2rem;
    font-size: 0.72rem;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb));
  }

  .lame-featured-products__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .lame-featured-products__media-link {
    display: block;
  }

  .lame-featured-products__quick-add-form {
    position: absolute;
    right: 0.78rem;
    top: 0.78rem;
    z-index: 3;
  }

  .lame-featured-products__quick-add {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--brand-gold) / 0.45);
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--brand-ink));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
    transform: translateY(3px);
  }

  .lame-featured-products__quick-add svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lame-featured-products__quick-add:disabled {
    opacity: 0.45 !important;
    cursor: not-allowed;
    pointer-events: none;
  }

  .lame-featured-products__item:is(:hover, :focus-within) .lame-featured-products__quick-add {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .lame-featured-products__price {
    margin: 0;
    font-size: 0.68rem;
    font-family: var(--price-font-family);
    font-variant-numeric: tabular-nums;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .lame-featured-products__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid rgb(var(--color-border-rgb) / 0.3);
    background: rgb(var(--color-background-rgb));
    color: rgb(var(--color-foreground-rgb) / 0.8);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
  }

  .lame-featured-products__arrow:disabled {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }

  .lame-featured-products__arrow--prev {
    left: 0;
  }

  .lame-featured-products__arrow--next {
    right: 0;
  }

  @media screen and (min-width: 750px) {
    .lame-featured-products__grid {
      gap: 14px;
    }

    .lame-featured-products__item {
      min-width: calc((100% - 42px) / 3.6);
    }
  }

  @media screen and (min-width: 990px) {
    .lame-featured-products__item {
      min-width: calc((100% - 56px) / 4.3);
    }
  }

  @media screen and (max-width: 749px) {
    .lame-featured-products__quick-add {
      opacity: 1;
      pointer-events: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Featured Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get the skin you want now."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "prev_products_label",
      "label": "Previous button label",
      "default": "Previous products"
    },
    {
      "type": "text",
      "id": "next_products_label",
      "label": "Next button label",
      "default": "Next products"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "placeholder_product_title",
      "label": "Placeholder product title",
      "default": "Product title"
    },
    {
      "type": "text",
      "id": "placeholder_product_price",
      "label": "Placeholder product price",
      "default": "$0.00"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 9,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "presets": [
    {
      "name": "Lame Featured Products"
    }
  ]
}
{% endschema %}
