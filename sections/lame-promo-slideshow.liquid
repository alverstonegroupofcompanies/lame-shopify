{%- liquid
  assign slide_count = section.blocks.size
  assign has_heading = false
  if section.settings.heading != blank
    assign has_heading = true
  endif

  assign banner_ratio_class = 'lame-promo-slideshow--ratio-3-1'
  case section.settings.banner_ratio
    when 'adapt'
      assign banner_ratio_class = 'lame-promo-slideshow--ratio-adapt'
    when '2.4-1'
      assign banner_ratio_class = 'lame-promo-slideshow--ratio-2-4'
    when '16-9'
      assign banner_ratio_class = 'lame-promo-slideshow--ratio-16-9'
    else
      assign banner_ratio_class = 'lame-promo-slideshow--ratio-3-1'
  endcase

  assign peek_mode_class = 'lame-promo-slideshow--peek-medium'
  case section.settings.peek_mode
    when 'small'
      assign peek_mode_class = 'lame-promo-slideshow--peek-small'
    when 'large'
      assign peek_mode_class = 'lame-promo-slideshow--peek-large'
    when 'none'
      assign peek_mode_class = 'lame-promo-slideshow--peek-none'
    else
      assign peek_mode_class = 'lame-promo-slideshow--peek-medium'
  endcase
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-promo-slideshow-section"
  id="LamePromoSlideshow-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="lame-promo-slideshow__wrapper spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
  >
    {%- if has_heading -%}
      <div class="lame-promo-slideshow__header">
        {% render 'lame-section-heading',
          title: section.settings.heading,
          subtitle: section.settings.subtitle,
          alignment: 'center',
          size: 'large'
        %}
      </div>
    {%- endif -%}

    {%- if slide_count > 0 -%}
      <div
        class="lame-promo-slideshow {{ banner_ratio_class }} {{ peek_mode_class }}{% if section.settings.enable_shadow %} lame-promo-slideshow--shadow{% endif %}"
        data-promo-slideshow
        data-autoplay="{{ section.settings.autoplay }}"
        data-interval="{{ section.settings.autoplay_interval | default: 4 | times: 1000 }}"
        data-pause-on-hover="{{ section.settings.pause_on_hover }}"
        style="--promo-slide-radius: {{ section.settings.corner_radius }}px;"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | default: 'Promotional Offers' | escape }}"
      >
        <div class="lame-promo-slideshow__viewport" data-promo-viewport>
          <ul class="lame-promo-slideshow__track" role="list" data-promo-track>
            {%- for block in section.blocks -%}
              {%- liquid
                assign slide_image = block.settings.image
                assign slide_mobile_image = block.settings.mobile_image
                assign fallback_asset = block.settings.fallback_asset | strip
                assign slide_title = block.settings.title | default: 'Promotional offer'
                assign slide_alt = slide_title | escape
                assign slide_link = block.settings.link
                assign open_new_tab = block.settings.open_in_new_tab
                assign is_first = forloop.first
                assign slide_loading = 'lazy'
                assign slide_fetchpriority = 'auto'
                if is_first
                  assign slide_loading = 'eager'
                  assign slide_fetchpriority = 'high'
                endif
              -%}

              <li
                class="lame-promo-slideshow__slide"
                data-promo-slide
                data-slide-index="{{ forloop.index0 }}"
                data-block-id="{{ block.id }}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} of {{ slide_count }}"
                {% unless is_first %}aria-hidden="true"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if slide_link != blank -%}
                  <a
                    href="{{ slide_link }}"
                    class="lame-promo-slideshow__link"
                    aria-label="{{ slide_title | escape }}"
                    {% if open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  >
                {%- else -%}
                  <div class="lame-promo-slideshow__link">
                {%- endif -%}

                  <div class="lame-promo-slideshow__media">
                    {%- if slide_image != blank -%}
                      {%- if slide_mobile_image != blank -%}
                        <picture class="lame-promo-slideshow__picture">
                          <source
                            media="(max-width: 749px)"
                            srcset="{{ slide_mobile_image | image_url: width: 750 }} 750w, {{ slide_mobile_image | image_url: width: 900 }} 900w"
                          >
                          {{
                            slide_image
                            | image_url: width: 1800
                            | image_tag:
                              class: 'lame-promo-slideshow__image',
                              loading: slide_loading,
                              fetchpriority: slide_fetchpriority,
                              widths: '600, 800, 1024, 1200, 1400, 1800',
                              sizes: '(min-width: 1200px) 1200px, 100vw',
                              alt: slide_alt
                          }}
                        </picture>
                      {%- else -%}
                        {{
                          slide_image
                          | image_url: width: 1800
                          | image_tag:
                            class: 'lame-promo-slideshow__image',
                            loading: slide_loading,
                            fetchpriority: slide_fetchpriority,
                            widths: '600, 800, 1024, 1200, 1400, 1800',
                            sizes: '(min-width: 1200px) 1200px, 100vw',
                            alt: slide_alt
                        }}
                      {%- endif -%}
                    {%- elsif fallback_asset != blank -%}
                      {%- if slide_mobile_image != blank -%}
                        <picture class="lame-promo-slideshow__picture">
                          <source
                            media="(max-width: 749px)"
                            srcset="{{ slide_mobile_image | image_url: width: 750 }} 750w, {{ slide_mobile_image | image_url: width: 900 }} 900w"
                          >
                          <img
                            class="lame-promo-slideshow__image"
                            src="{{ fallback_asset | asset_url }}"
                            alt="{{ slide_alt }}"
                            width="1024"
                            height="341"
                            loading="{{ slide_loading }}"
                            decoding="async"
                          >
                        </picture>
                      {%- else -%}
                        <img
                          class="lame-promo-slideshow__image"
                          src="{{ fallback_asset | asset_url }}"
                          alt="{{ slide_alt }}"
                          width="1024"
                          height="341"
                          loading="{{ slide_loading }}"
                          decoding="async"
                        >
                      {%- endif -%}
                    {%- else -%}
                      <div class="lame-promo-slideshow__placeholder-wrap">
                        {{ 'lifestyle-1' | placeholder_svg_tag: 'lame-promo-slideshow__placeholder' }}
                      </div>
                    {%- endif -%}
                  </div>

                {%- if slide_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if slide_count > 1 and section.settings.show_arrows -%}
          <div class="lame-promo-slideshow__arrows" aria-label="Slideshow navigation">
            <button
              type="button"
              class="lame-promo-slideshow__arrow lame-promo-slideshow__arrow--prev"
              data-promo-arrow="prev"
              aria-label="Previous slide"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              type="button"
              class="lame-promo-slideshow__arrow lame-promo-slideshow__arrow--next"
              data-promo-arrow="next"
              aria-label="Next slide"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {%- endif -%}

        {%- if slide_count > 1 and section.settings.show_dots -%}
          <div class="lame-promo-slideshow__dots-wrap">
            <div class="lame-promo-slideshow__dots" role="tablist" aria-label="Slideshow pagination">
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="lame-promo-slideshow__dot{% if forloop.first %} is-active{% endif %}"
                  data-promo-dot="{{ forloop.index0 }}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Go to slide {{ forloop.index }}"
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #LamePromoSlideshow-{{ section.id }} {
    --promo-slide-radius: {{ section.settings.corner_radius }}px;
  }

  .lame-promo-slideshow__wrapper {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
    padding-inline: clamp(0.75rem, 2.5vw, 1.25rem);
  }

  .section--full-width .lame-promo-slideshow__wrapper {
    max-width: 100%;
    padding-inline: 0;
  }

  .lame-promo-slideshow__header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    text-align: center;
  }

  /* Peek widths & gaps */
  .lame-promo-slideshow--peek-medium {
    --promo-slide-width: 86%;
    --promo-slide-gap: clamp(10px, 1.6vw, 18px);
  }

  .lame-promo-slideshow--peek-small {
    --promo-slide-width: 91%;
    --promo-slide-gap: clamp(10px, 1.4vw, 16px);
  }

  .lame-promo-slideshow--peek-large {
    --promo-slide-width: 80%;
    --promo-slide-gap: clamp(12px, 2vw, 22px);
  }

  .lame-promo-slideshow--peek-none {
    --promo-slide-width: 100%;
    --promo-slide-gap: 0px;
  }

  @media (max-width: 749px) {
    .lame-promo-slideshow--peek-medium {
      --promo-slide-width: 85%;
      --promo-slide-gap: 10px;
    }
    .lame-promo-slideshow--peek-small {
      --promo-slide-width: 90%;
      --promo-slide-gap: 8px;
    }
    .lame-promo-slideshow--peek-large {
      --promo-slide-width: 78%;
      --promo-slide-gap: 12px;
    }
  }

  .lame-promo-slideshow {
    position: relative;
    width: 100%;
    user-select: none;
    touch-action: pan-y pinch-zoom;
  }

  .lame-promo-slideshow__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .lame-promo-slideshow__track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    gap: var(--promo-slide-gap, 16px);
    width: 100%;
    will-change: transform;
  }

  .lame-promo-slideshow__slide {
    flex: 0 0 var(--promo-slide-width, 86%);
    width: var(--promo-slide-width, 86%);
    min-width: var(--promo-slide-width, 86%);
    position: relative;
    box-sizing: border-box;
    border-radius: var(--promo-slide-radius, 16px);
    overflow: hidden;
    background: #00000008;
    transition: transform 300ms cubic-bezier(0.2, 0.9, 0.3, 1), box-shadow 300ms ease;
  }

  .lame-promo-slideshow--shadow .lame-promo-slideshow__slide {
    box-shadow: 0 8px 24px -6px rgba(0, 0, 0, 0.12), 0 2px 6px -2px rgba(0, 0, 0, 0.05);
  }

  .section--full-width .lame-promo-slideshow__slide {
    border-radius: 0;
  }

  .lame-promo-slideshow__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    position: relative;
    outline-offset: -3px;
  }

  .lame-promo-slideshow__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    border-radius: inherit;
  }

  /* Aspect ratio variants */
  .lame-promo-slideshow--ratio-3-1 .lame-promo-slideshow__media {
    aspect-ratio: 1024 / 341;
  }

  .lame-promo-slideshow--ratio-2-4 .lame-promo-slideshow__media {
    aspect-ratio: 2.4 / 1;
  }

  .lame-promo-slideshow--ratio-16-9 .lame-promo-slideshow__media {
    aspect-ratio: 16 / 9;
  }

  .lame-promo-slideshow--ratio-adapt .lame-promo-slideshow__media {
    aspect-ratio: auto;
  }

  .lame-promo-slideshow__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .lame-promo-slideshow__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 600ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .lame-promo-slideshow__link:hover .lame-promo-slideshow__image {
    transform: scale(1.02);
  }

  .lame-promo-slideshow__placeholder-wrap {
    width: 100%;
    aspect-ratio: 3 / 1;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lame-promo-slideshow__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.6;
  }

  /* Arrows (if enabled) */
  .lame-promo-slideshow__arrows {
    pointer-events: none;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: clamp(10px, 2vw, 20px);
    z-index: 2;
  }

  .lame-promo-slideshow__arrow {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: clamp(36px, 4.5vw, 44px);
    height: clamp(36px, 4.5vw, 44px);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.16);
    color: #1a1a1a;
    cursor: pointer;
    padding: 0;
    transition: all 240ms cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .lame-promo-slideshow__arrow:hover {
    background: #ffffff;
    transform: scale(1.1);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24);
    color: #000000;
  }

  /* Pagination Dots */
  .lame-promo-slideshow__dots-wrap {
    margin-top: clamp(10px, 1.8vw, 16px);
    display: flex;
    justify-content: center;
    z-index: 2;
  }

  .lame-promo-slideshow__dots {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 5px 10px;
    border-radius: 20px;
  }

  .lame-promo-slideshow__dot {
    width: 8px;
    height: 8px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.25);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .lame-promo-slideshow__dot:hover {
    background: rgba(0, 0, 0, 0.5);
  }

  .lame-promo-slideshow__dot.is-active {
    width: 24px;
    background: var(--color-foreground, #111111);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 749px) {
    .lame-promo-slideshow__arrows {
      display: none;
    }

    .lame-promo-slideshow__dots-wrap {
      margin-top: 10px;
    }

    .lame-promo-slideshow__dots {
      padding: 4px 8px;
      gap: 5px;
    }

    .lame-promo-slideshow__dot {
      width: 6px;
      height: 6px;
    }

    .lame-promo-slideshow__dot.is-active {
      width: 18px;
    }
  }
</style>

<script>
  (function () {
    function initSlideshow(container) {
      if (!container || container.__promoSlideshowInitialized) return;
      container.__promoSlideshowInitialized = true;

      var track = container.querySelector('[data-promo-track]');
      if (!track) return;

      var originalSlides = Array.prototype.slice.call(container.querySelectorAll('[data-promo-slide]:not([data-clone="true"])'));
      var dots = Array.prototype.slice.call(container.querySelectorAll('[data-promo-dot]'));
      var prevBtn = container.querySelector('[data-promo-arrow="prev"]');
      var nextBtn = container.querySelector('[data-promo-arrow="next"]');

      var total = originalSlides.length;
      if (total <= 1) return;

      // Remove any previously cloned nodes before setting up
      var oldClones = track.querySelectorAll('[data-clone="true"]');
      for (var c = 0; c < oldClones.length; c++) {
        oldClones[c].remove();
      }

      // Clone first 2 slides to end of track for seamless infinite loop with peek
      for (var i = 0; i < Math.min(2, total); i++) {
        var clone = originalSlides[i].cloneNode(true);
        clone.setAttribute('data-clone', 'true');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      }

      var allSlides = Array.prototype.slice.call(track.querySelectorAll('[data-promo-slide]'));

      var currentIndex = 0;
      var autoplayEnabled = container.getAttribute('data-autoplay') === 'true';
      var intervalMs = parseInt(container.getAttribute('data-interval'), 10) || 4000;
      var pauseOnHover = container.getAttribute('data-pause-on-hover') === 'true';
      var autoplayTimer = null;
      var isPaused = false;
      var isAnimating = false;

      function getOffset(idx) {
        if (!allSlides[idx]) return 0;
        return allSlides[idx].offsetLeft - allSlides[0].offsetLeft;
      }

      function updateActiveState(animate) {
        if (animate === false) {
          track.style.transition = 'none';
        } else {
          track.style.transition = 'transform 480ms cubic-bezier(0.25, 1, 0.5, 1)';
        }

        var offset = getOffset(currentIndex);
        track.style.transform = 'translate3d(-' + offset + 'px, 0, 0)';

        var realIndex = currentIndex % total;

        dots.forEach(function (dot, idx) {
          if (idx === realIndex) {
            dot.classList.add('is-active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('is-active');
            dot.setAttribute('aria-selected', 'false');
          }
        });

        originalSlides.forEach(function (slide, idx) {
          if (idx === realIndex) {
            slide.removeAttribute('aria-hidden');
          } else {
            slide.setAttribute('aria-hidden', 'true');
          }
        });
      }

      function goToSlide(index, animate) {
        currentIndex = index;
        updateActiveState(animate !== false);
      }

      function nextSlide() {
        if (isAnimating) return;
        currentIndex++;
        isAnimating = true;
        updateActiveState(true);

        if (currentIndex >= total) {
          // Wrapped to cloned first slide; snap back after animation ends
          window.setTimeout(function () {
            currentIndex = 0;
            updateActiveState(false);
            void track.offsetHeight; // force layout
            isAnimating = false;
          }, 490);
        } else {
          window.setTimeout(function () {
            isAnimating = false;
          }, 490);
        }
      }

      function prevSlide() {
        if (isAnimating) return;
        if (currentIndex === 0) {
          currentIndex = total;
          updateActiveState(false);
          void track.offsetHeight;
          currentIndex = total - 1;
          isAnimating = true;
          updateActiveState(true);
          window.setTimeout(function () {
            isAnimating = false;
          }, 490);
        } else {
          currentIndex--;
          isAnimating = true;
          updateActiveState(true);
          window.setTimeout(function () {
            isAnimating = false;
          }, 490);
        }
      }

      function startAutoplay() {
        if (!autoplayEnabled || autoplayTimer || isPaused) return;
        autoplayTimer = window.setInterval(function () {
          if (!document.hidden && !isPaused) {
            nextSlide();
          }
        }, intervalMs);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          window.clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      // Arrows if rendered
      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.preventDefault();
          prevSlide();
          stopAutoplay();
          startAutoplay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.preventDefault();
          nextSlide();
          stopAutoplay();
          startAutoplay();
        });
      }

      // Dots click
      dots.forEach(function (dot, idx) {
        dot.addEventListener('click', function (e) {
          e.preventDefault();
          goToSlide(idx, true);
          stopAutoplay();
          startAutoplay();
        });
      });

      // Hover pause
      if (pauseOnHover) {
        container.addEventListener('mouseenter', function () {
          isPaused = true;
          stopAutoplay();
        });
        container.addEventListener('mouseleave', function () {
          isPaused = false;
          startAutoplay();
        });
      }

      // Touch & Swipe gestures with threshold
      var startX = 0;
      var startY = 0;
      var diffX = 0;
      var isSwiping = false;
      var hasDeterminedGesture = false;

      container.addEventListener('touchstart', function (e) {
        if (!e.touches || e.touches.length === 0 || isAnimating) return;
        var touch = e.touches[0];
        startX = touch.clientX;
        startY = touch.clientY;
        diffX = 0;
        isSwiping = true;
        hasDeterminedGesture = false;
        stopAutoplay();
      }, { passive: true });

      container.addEventListener('touchmove', function (e) {
        if (!isSwiping || !e.touches || e.touches.length === 0) return;
        var touch = e.touches[0];
        var curX = touch.clientX - startX;
        var curY = touch.clientY - startY;

        if (!hasDeterminedGesture) {
          if (Math.abs(curX) > Math.abs(curY) && Math.abs(curX) > 8) {
            hasDeterminedGesture = true;
          } else if (Math.abs(curY) > 8) {
            isSwiping = false;
            return;
          }
        }

        if (hasDeterminedGesture) {
          diffX = curX;
          track.style.transition = 'none';
          var baseOffset = getOffset(currentIndex);
          track.style.transform = 'translate3d(-' + (baseOffset - diffX) + 'px, 0, 0)';
        }
      }, { passive: true });

      container.addEventListener('touchend', function () {
        if (!isSwiping) return;
        isSwiping = false;
        if (hasDeterminedGesture) {
          if (diffX < -40) {
            nextSlide();
          } else if (diffX > 40) {
            prevSlide();
          } else {
            updateActiveState(true);
          }
        }
        startAutoplay();
      }, { passive: true });

      // Prevent accidental link navigation on horizontal swipe
      track.addEventListener('click', function (e) {
        if (Math.abs(diffX) > 15) {
          e.preventDefault();
        }
      }, true);

      // Recalculate on window resize
      window.addEventListener('resize', function () {
        updateActiveState(false);
      });

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
          stopAutoplay();
        } else {
          startAutoplay();
        }
      });

      // Initialize initial state & start autoplay
      updateActiveState(false);
      startAutoplay();

      // Shopify Admin Theme Editor events
      document.addEventListener('shopify:block:select', function (e) {
        if (!e.target || !container.contains(e.target)) return;
        var blockId = e.detail && e.detail.blockId;
        if (!blockId) return;
        var matchIdx = originalSlides.findIndex(function (s) {
          return s.getAttribute('data-block-id') === blockId;
        });
        if (matchIdx !== -1) {
          stopAutoplay();
          goToSlide(matchIdx, true);
        }
      });

      document.addEventListener('shopify:block:deselect', function (e) {
        if (!e.target || !container.contains(e.target)) return;
        startAutoplay();
      });
    }

    function initAll() {
      var containers = document.querySelectorAll('[data-promo-slideshow]');
      for (var i = 0; i < containers.length; i++) {
        initSlideshow(containers[i]);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target) {
        var el = e.target.querySelector('[data-promo-slideshow]');
        if (el) initSlideshow(el);
      }
    });
  })();
</script>

