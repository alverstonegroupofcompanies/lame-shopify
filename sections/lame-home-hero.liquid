{%- liquid
  assign desktop_slide_count = 0
  assign mobile_slide_count = 0
  assign desktop_banner_ratio = 2.4
  assign mobile_banner_ratio = 0.5625
  assign desktop_ratio_set = false
  assign mobile_ratio_set = false

  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign desktop_slide_count = desktop_slide_count | plus: 1
      unless desktop_ratio_set
        assign desktop_banner_ratio = block.settings.image.aspect_ratio | default: 2.4
        assign desktop_ratio_set = true
      endunless
    endif
    if block.type == 'mobile_slide' and block.settings.image != blank
      assign mobile_slide_count = mobile_slide_count | plus: 1
      unless mobile_ratio_set
        assign mobile_banner_ratio = block.settings.image.aspect_ratio | default: 0.5625
        assign mobile_ratio_set = true
      endunless
    endif
  endfor

  assign mobile_fallback = section.settings.mobile_fallback_desktop
  assign show_mobile_desktop_fallback = false
  if mobile_slide_count == 0 and mobile_fallback and desktop_slide_count > 0
    assign show_mobile_desktop_fallback = true
    assign mobile_banner_ratio = desktop_banner_ratio
  endif

  assign has_mobile_carousel = false
  if mobile_slide_count > 0 or show_mobile_desktop_fallback
    assign has_mobile_carousel = true
  endif

  assign hero_height = section.settings.banner_height
  assign hero_height_mobile = section.settings.banner_height_mobile | default: 'medium'
  assign slideshow_slide_size = hero_height
  assign image_fit = section.settings.image_fit | default: 'cover'

  case hero_height
    when 'full_screen'
      # svh stays fixed when mobile browser chrome shows/hides on scroll
      assign lame_hero_h = '100svh'
      assign lame_hero_h_desktop = '100svh'
      assign slideshow_slide_size = 'large'
    when 'half'
      # Nykaa-style: ~45–50% of viewport, one full banner at a time
      assign lame_hero_h = '48svh'
      assign lame_hero_h_desktop = '48svh'
      assign slideshow_slide_size = 'large'
    when 'small'
      assign lame_hero_h = '200px'
      assign lame_hero_h_desktop = '300px'
    when 'medium'
      assign lame_hero_h = '240px'
      assign lame_hero_h_desktop = '380px'
    else
      assign lame_hero_h = '280px'
      assign lame_hero_h_desktop = '440px'
  endcase

  case hero_height_mobile
    when 'full_screen'
      assign lame_hero_h_mobile = '100svh'
    when 'half'
      assign lame_hero_h_mobile = '45svh'
    when 'small'
      assign lame_hero_h_mobile = '180px'
    when 'medium'
      assign lame_hero_h_mobile = '220px'
    when 'large'
      assign lame_hero_h_mobile = '280px'
    else
      assign lame_hero_h_mobile = '220px'
  endcase

  assign show_section = false
  if desktop_slide_count > 0 or has_mobile_carousel or request.design_mode
    assign show_section = true
  endif

  assign mobile_block_type = 'mobile_slide'
  if show_mobile_desktop_fallback
    assign mobile_block_type = 'slide'
  endif
-%}

{%- if show_section -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero lame-home-hero--{{ hero_height }} lame-home-hero--mobile-{{ hero_height_mobile }} lame-home-hero--fit-{{ image_fit }}{% if has_mobile_carousel %} lame-home-hero--has-mobile-banners{% endif %}"
    data-testid="hero-slideshow"
    style="--lame-hero-height: {{ lame_hero_h }}; --lame-hero-height-desktop: {{ lame_hero_h_desktop }}; --lame-hero-height-mobile: {{ lame_hero_h_mobile }}; --lame-hero-desktop-ratio: {{ desktop_banner_ratio }}; --lame-hero-mobile-ratio: {{ mobile_banner_ratio }};"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow spacing-style disable-section-top-offset"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if desktop_slide_count == 0 and mobile_slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>
            Add <strong>Desktop slide</strong> blocks for large screens and <strong>Mobile slide</strong> blocks for
            phones. Desktop banners are hidden on mobile when mobile slides exist.
          </p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>

        {%- if desktop_slide_count > 0 -%}
          {%- liquid
            assign desktop_prioritize_loading = true
            if has_mobile_carousel
              assign desktop_prioritize_loading = false
            endif
          -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: 'slide',
            carousel_modifier: 'desktop',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: desktop_prioritize_loading,
            media_fit: image_fit
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--desktop">
            <p>Add desktop slides with images for tablets and desktop (600px and wider).</p>
          </div>
        {%- endif -%}

        {%- if has_mobile_carousel -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: mobile_block_type,
            carousel_modifier: 'mobile',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: true,
            media_fit: image_fit
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--mobile">
            <p>Add mobile slides for phones only (under 600px), or enable “Use desktop slides on mobile”.</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
  <script src="{{ 'lame-home-hero-mobile.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% stylesheet %}
  .lame-home-hero {
    --lame-hero-height: 48svh;
    --lame-hero-height-desktop: 48svh;
    --lame-hero-height-mobile: 220px;
    /* Header + announcement take space above; banner fills configured height */
    --lame-hero-height-offset: var(--header-group-height, 0px);
    --lame-hero-display-height: auto;
    --lame-hero-desktop-min: 600px;
    --lame-hero-desktop-ratio: 2.4;
    --lame-hero-mobile-ratio: 0.5625;
    --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
    /* Default to half-screen; full_screen / size modifiers override */
    --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
    --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    width: 100%;
    max-width: none;
    overflow-x: hidden;
    background: #fff;
  }

  .lame-home-hero.section.section--full-width {
    display: block;
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .lame-home-hero.section.section--full-width > * {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  .shopify-section.hero-wrapper:has(.lame-home-hero) {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
    padding-inline: 0;
  }

  /* Transparent header overlays the banner — use full viewport for the frame */
  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child {
    margin-top: 0;
    width: 100%;
    max-width: none;
  }

  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen,
  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--mobile-full_screen,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--mobile-full_screen {
    --lame-hero-height-offset: 0px;
  }

  .lame-home-hero__slideshow {
    width: 100%;
    max-width: none;
    padding-inline: 0;
    position: relative;
  }

  /* Default / tablet+desktop: horizontal desktop banners */
  .lame-home-hero__frame--desktop {
    display: block;
  }

  .lame-home-hero__frame--mobile {
    display: none;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
    display: block;
    --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--mobile {
    display: none;
  }

  /* Full-width frame — viewport fill + cover (extend image to fill) */
  .lame-home-hero__frame,
  .lame-home-hero__carousel slideshow-component,
  .lame-home-hero__carousel slideshow-container,
  .lame-home-hero__carousel slideshow-slides {
    width: 100%;
    min-width: 100%;
    max-width: none;
    height: var(--lame-hero-frame-max-height) !important;
    min-height: var(--lame-hero-frame-min-height, var(--lame-hero-frame-max-height)) !important;
    max-height: var(--lame-hero-frame-max-height) !important;
    aspect-ratio: unset;
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    min-width: 100%;
    height: 100% !important;
    min-height: 100% !important;
    max-height: none !important;
  }

  .lame-home-hero__carousel slideshow-component {
    --slide-min-height: 0 !important;
    --slide-min-height-desktop: 0 !important;
    --product-media-fit: cover;
  }

  .lame-home-hero__frame {
    overflow: hidden;
    line-height: 0;
    background: #1a1a1a;
  }

  /* Full screen: remaining viewport under the header (fixed; does not grow on scroll) */
  .lame-home-hero--full_screen,
  .lame-home-hero--mobile-full_screen {
    --lame-hero-frame-max-height: calc(100svh - var(--lame-hero-height-offset, 0px));
    --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
  }

  @supports not (height: 100svh) {
    .lame-home-hero--full_screen,
    .lame-home-hero--mobile-full_screen {
      --lame-hero-frame-max-height: calc(100vh - var(--lame-hero-height-offset, 0px));
    }
  }

  .lame-home-hero--small,
  .lame-home-hero--medium,
  .lame-home-hero--large,
  .lame-home-hero--half {
    --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
    --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
  }

  .lame-home-hero--full_screen .lame-home-hero__frame,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-slides,
  .lame-home-hero--half .lame-home-hero__frame,
  .lame-home-hero--half .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--half .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--half .lame-home-hero__carousel slideshow-slides,
  .lame-home-hero--small .lame-home-hero__frame,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-slides,
  .lame-home-hero--medium .lame-home-hero__frame,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-slides,
  .lame-home-hero--large .lame-home-hero__frame,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-frame-max-height) !important;
    min-height: var(--lame-hero-frame-max-height) !important;
    max-height: var(--lame-hero-frame-max-height) !important;
  }

  /* Phones only (under 600px): vertical mobile banners */
  @media screen and (max-width: 599px) {
    .lame-home-hero {
      --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
      --lame-hero-height-offset: max(var(--header-group-height, 0px), var(--header-height, 60px));
    }

    .shopify-section.hero-wrapper:has(.lame-home-hero) {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
      /* Solid header is in document flow — no offset padding (avoids white gap) */
      padding-top: 0;
      box-sizing: border-box;
    }

    body:has(.header[transparent])
      .content-for-layout
      > .shopify-section.hero-wrapper:has(.lame-home-hero):first-child,
    body:has(header-component[transparent])
      .content-for-layout
      > .shopify-section.hero-wrapper:has(.lame-home-hero):first-child {
      margin-top: 0;
      padding-top: var(--lame-hero-height-offset);
    }

    body:has(.header[transparent])
      .content-for-layout
      > .shopify-section:has(.lame-home-hero):first-child
      .lame-home-hero--full_screen,
    body:has(.header[transparent])
      .content-for-layout
      > .shopify-section:has(.lame-home-hero):first-child
      .lame-home-hero--mobile-full_screen,
    body:has(header-component[transparent])
      .content-for-layout
      > .shopify-section:has(.lame-home-hero):first-child
      .lame-home-hero--full_screen,
    body:has(header-component[transparent])
      .content-for-layout
      > .shopify-section:has(.lame-home-hero):first-child
      .lame-home-hero--mobile-full_screen {
      --lame-hero-height-offset: max(var(--header-group-height, 0px), var(--header-height, 60px));
    }

    /* Non-transparent: banner starts immediately under navbar */
    body:not(:has(.header[transparent])):not(:has(header-component[transparent]))
      .content-for-layout
      > .shopify-section.hero-wrapper:has(.lame-home-hero):first-child {
      padding-top: 0 !important;
      margin-top: 0 !important;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop {
      display: none !important;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
      display: block !important;
      --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
    }

    .lame-home-hero--mobile-small,
    .lame-home-hero--mobile-medium,
    .lame-home-hero--mobile-large,
    .lame-home-hero--mobile-half {
      --lame-hero-frame-max-height: var(--lame-hero-height-mobile);
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    .lame-home-hero--mobile-full_screen {
      --lame-hero-frame-max-height: calc(100svh - var(--lame-hero-height-offset, 0px));
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    @supports not (height: 100svh) {
      .lame-home-hero--mobile-full_screen {
        --lame-hero-frame-max-height: calc(100vh - var(--lame-hero-height-offset, 0px));
      }
    }

    /* Fixed remaining-viewport height — banner always fits first screen */
    .lame-home-hero__frame--mobile,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop,
    .lame-home-hero__carousel--mobile slideshow-component,
    .lame-home-hero__carousel--mobile slideshow-container,
    .lame-home-hero__carousel--mobile slideshow-slides,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-component,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-container,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-slides {
      width: 100% !important;
      max-width: 100% !important;
      height: var(--lame-hero-frame-max-height) !important;
      min-height: var(--lame-hero-frame-max-height) !important;
      max-height: var(--lame-hero-frame-max-height) !important;
      aspect-ratio: unset !important;
      overflow: hidden;
    }

    .lame-home-hero__carousel--mobile slideshow-slide,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-slide {
      width: 100%;
      max-width: 100%;
      height: 100% !important;
      min-height: 100% !important;
      max-height: 100% !important;
    }

    .lame-home-hero__carousel--mobile slideshow-slide > .slide__image-container,
    .lame-home-hero__carousel--mobile .lame-home-hero__slide-link {
      width: 100%;
      height: 100%;
    }

    /* Swipe: plain horizontal slide only — no smooth scroll, pop-in, or partial slides */
    .lame-home-hero__carousel--mobile slideshow-slides,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-slides {
      scroll-behavior: auto !important;
      scroll-snap-type: x mandatory;
      scroll-snap-stop: always;
      overscroll-behavior-x: contain;
      -webkit-overflow-scrolling: touch;
    }

    .lame-home-hero__carousel--mobile slideshow-component:not([in-viewport]) slideshow-slides,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners)
      .lame-home-hero__carousel--desktop
      slideshow-component:not([in-viewport])
      slideshow-slides {
      overflow-x: scroll;
    }

    .lame-home-hero__carousel--mobile slideshow-slide,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-slide {
      scroll-snap-align: start;
      content-visibility: visible !important;
      contain-intrinsic-size: unset !important;
      view-timeline-name: none !important;
    }

    .lame-home-hero__carousel--mobile slideshow-component,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-component {
      timeline-scope: none;
    }

    .lame-home-hero__carousel--mobile slideshow-component[transitioning],
    .lame-home-hero__carousel--mobile slideshow-component[dragging],
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners)
      .lame-home-hero__carousel--desktop
      slideshow-component:is([transitioning], [dragging]) {
      transition: none !important;
      animation: none !important;
    }

    /* Fill edge-to-edge — vertical banners always span full viewport width */
    .lame-home-hero__frame {
      background: #1a1a1a;
    }

    .lame-home-hero,
    .lame-home-hero__slideshow,
    .lame-home-hero__frame--mobile,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
      width: 100% !important;
      max-width: none !important;
      margin-inline: 0 !important;
      padding-inline: 0 !important;
    }

    /* Always cover on mobile (ignore Image fit = contain) so sides never letterbox;
       pin to top so only the bottom can crop */
    .lame-home-hero__carousel .slide__image,
    .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero__slide-link .slide__image,
    .lame-home-hero__slide-link img,
    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link img,
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link img {
      object-fit: cover !important;
      object-position: center top !important;
      min-width: 100% !important;
      min-height: 100% !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
    }

    .lame-home-hero--mobile-full_screen,
    .lame-home-hero--full_screen {
      /* Width-locked height = full-bleed banner with almost no side crop */
      --lame-hero-natural-height: calc(100vw / max(var(--lame-hero-banner-ratio), 0.75));
      --lame-hero-frame-max-height: min(
        calc(100svh - var(--lame-hero-height-offset, 0px)),
        var(--lame-hero-natural-height)
      );
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    @supports not (height: 100svh) {
      .lame-home-hero--mobile-full_screen,
      .lame-home-hero--full_screen {
        --lame-hero-frame-max-height: min(
          calc(100vh - var(--lame-hero-height-offset, 0px)),
          var(--lame-hero-natural-height)
        );
      }
    }
  }

  /* Tablets + desktop (600px+): horizontal banners; height follows setting (half by default) */
  @media screen and (min-width: 600px) {
    .lame-home-hero {
      --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
      --lame-hero-height-offset: max(var(--header-group-height, 0px), var(--header-height, 60px));
      --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    /* Full screen only when explicitly selected */
    .lame-home-hero--full_screen {
      --lame-hero-frame-max-height: calc(100svh - var(--lame-hero-height-offset, 0px));
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    @supports not (height: 100svh) {
      .lame-home-hero--full_screen {
        --lame-hero-frame-max-height: calc(100vh - var(--lame-hero-height-offset, 0px));
      }
    }

    /* Half screen: ~48% viewport, capped so header never overflows */
    .lame-home-hero--half {
      --lame-hero-frame-max-height: min(
        var(--lame-hero-height-desktop),
        calc(100svh - var(--lame-hero-height-offset, 0px))
      );
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    .lame-home-hero--small,
    .lame-home-hero--medium,
    .lame-home-hero--large {
      --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
      --lame-hero-frame-min-height: var(--lame-hero-frame-max-height);
    }

    /* Transparent header overlays the banner — use full viewport only for full_screen */
    body:has(.header[transparent]) .lame-home-hero--full_screen,
    body:has(header-component[transparent]) .lame-home-hero--full_screen {
      --lame-hero-height-offset: 0px;
    }

    .shopify-section.hero-wrapper:has(.lame-home-hero) {
      width: 100%;
      max-width: 100%;
      margin-inline: 0;
      padding-top: 0;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
    .lame-home-hero__frame--desktop {
      display: block !important;
      --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile,
    .lame-home-hero__frame--mobile {
      display: none !important;
    }

    .lame-home-hero__frame {
      background: #1a1a1a;
    }

    .lame-home-hero__frame,
    .lame-home-hero__carousel slideshow-component,
    .lame-home-hero__carousel slideshow-container,
    .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--full_screen .lame-home-hero__frame,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--half .lame-home-hero__frame,
    .lame-home-hero--half .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--half .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--half .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--small .lame-home-hero__frame,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--medium .lame-home-hero__frame,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--large .lame-home-hero__frame,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-slides {
      width: 100% !important;
      max-width: none !important;
      height: var(--lame-hero-frame-max-height) !important;
      min-height: var(--lame-hero-frame-max-height) !important;
      max-height: var(--lame-hero-frame-max-height) !important;
      aspect-ratio: unset !important;
    }

    .lame-home-hero__carousel slideshow-slide {
      width: 100% !important;
      min-width: 100% !important;
      height: 100% !important;
      min-height: 100% !important;
      max-height: none !important;
    }

    .lame-home-hero__carousel slideshow-slide > .slide__image-container,
    .lame-home-hero__carousel .lame-home-hero__slide-link {
      width: 100%;
      height: 100%;
    }

    /* Cover fills the frame; pin top so navbar never hides the banner top */
    .lame-home-hero__carousel .slide__image,
    .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero__slide-link .slide__image,
    .lame-home-hero__slide-link img,
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link img {
      object-fit: cover !important;
      object-position: center top !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100% !important;
      min-height: 100% !important;
    }

    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link img {
      object-fit: contain !important;
      object-position: center center !important;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      min-width: 0 !important;
      min-height: 0 !important;
    }
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
    height: 100% !important;
    min-height: 100% !important;
    position: relative;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* One full banner at a time — no peeking next slide */
  .lame-home-hero__carousel slideshow-slides {
    scroll-snap-type: x mandatory;
    scroll-snap-stop: always;
  }

  .lame-home-hero__carousel slideshow-slide > .slide__image-container {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    line-height: 0;
  }

  .lame-home-hero__carousel .lame-home-hero__slide-link,
  .lame-home-hero__slide-link {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  /* Default image fill — mobile portrait uses cover; desktop overrides below with contain */
  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img,
  .lame-home-hero__slide-link .slide__image,
  .lame-home-hero__slide-link img {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image,
  .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image-container img,
  .lame-home-hero--fit-contain .lame-home-hero__slide-link .slide__image,
  .lame-home-hero--fit-contain .lame-home-hero__slide-link img {
    object-fit: contain;
    object-position: center center;
    min-width: 0;
    min-height: 0;
  }

  /* Re-assert desktop/tablet image fit (respects cover/contain setting) */
  @media screen and (min-width: 600px) {
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-cover .lame-home-hero__slide-link img {
      object-fit: cover !important;
      object-position: center top !important;
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      min-width: 100% !important;
      min-height: 100% !important;
    }

    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image-container img,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link .slide__image,
    .lame-home-hero--fit-contain .lame-home-hero__slide-link img {
      object-fit: contain !important;
      object-position: center center !important;
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      min-width: 0 !important;
      min-height: 0 !important;
    }
  }

  .lame-home-hero__frame {
    background: #1a1a1a;
  }

  /* Swipe / drag to change slides — no arrow controls */
  .lame-home-hero__carousel slideshow-slides {
    cursor: grab;
  }

  .lame-home-hero__carousel slideshow-component[dragging] slideshow-slides {
    cursor: grabbing;
  }

  .lame-home-hero__carousel slideshow-arrows {
    display: none !important;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-square {
    position: absolute;
    top: auto;
    bottom: var(--lame-hero-arrow-bottom-gap);
    pointer-events: auto;
    opacity: 1;
    animation: none;
    transform: none;
    min-width: var(--lame-hero-arrow-size);
    min-height: var(--lame-hero-arrow-size);
    width: var(--lame-hero-arrow-size);
    height: var(--lame-hero-arrow-size);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    cursor: pointer;
    background-color: rgb(45 74 34) !important;
    color: #fff !important;
    border: 1px solid rgb(45 74 34 / 0.35);
    box-shadow: 0 4px 14px rgb(26 42 36 / 0.18);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--previous {
    left: var(--lame-hero-arrow-side-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--next {
    right: var(--lame-hero-arrow-side-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle:hover {
    background-color: rgb(35 58 28) !important;
    color: #fff !important;
    border-color: rgb(35 58 28);
    filter: none;
    box-shadow: 0 6px 18px rgb(26 42 36 / 0.22);
  }

  @media (hover: hover) and (pointer: fine) {
    .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover,
    .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle:hover {
      transform: scale(1.04);
    }
  }

  @media (hover: none), (pointer: coarse) {
    .lame-home-hero__carousel slideshow-arrows .slideshow-control,
    .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover,
    .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle:hover {
      transform: none !important;
      transition: none !important;
    }

    .lame-home-hero,
    .lame-home-hero__frame,
    .lame-home-hero__slideshow,
    .lame-home-hero :is(slideshow-component, slideshow-container, slideshow-slides, slideshow-slide),
    .lame-home-hero :is(.slide__image, .slide__image-container img) {
      transform: none !important;
      animation: none !important;
    }
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
    width: var(--lame-hero-arrow-icon);
    height: var(--lame-hero-arrow-icon);
    display: block;
    color: #fff;
    stroke: currentColor;
  }

  @media screen and (max-width: 599px) {
    .lame-home-hero__carousel slideshow-arrows,
    .lame-home-hero__carousel slideshow-arrows[position='center'] {
      --lame-hero-arrow-side-gap: 0.75rem;
      --lame-hero-arrow-bottom-gap: 1.75rem;
      --lame-hero-arrow-size: 2.5rem;
      --lame-hero-arrow-icon: 1rem;
    }
  }

  .lame-home-hero__placeholder {
    height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }

  @media screen and (min-width: 600px) {
    .lame-home-hero__placeholder--mobile {
      display: none;
    }
  }

  @media screen and (max-width: 599px) {
    .lame-home-hero__placeholder--desktop {
      display: none;
    }
  }

  /* Theme editor: preview both desktop and mobile carousels */
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    display: block;
  }

  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    margin-top: 0.75rem;
    outline: 1px dashed rgb(0 0 0 / 0.15);
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper hero-wrapper",
  "max_blocks": 16,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "header",
      "content": "Desktop banners"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Desktop banner height",
      "options": [
        { "value": "half", "label": "Half screen (~45–50%, Nykaa style)" },
        { "value": "full_screen", "label": "Full screen (max)" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "half",
      "info": "Half screen (~48% viewport) keeps banners compact so content below stays visible. Full screen fills the remaining viewport under the header."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show full image (no crop)" },
        { "value": "cover", "label": "Fill frame (may crop)" }
      ],
      "default": "cover",
      "info": "Cover fills the banner frame cleanly. Contain shows the whole image with possible letterboxing. On phones the image always fills the full width."
    },
    {
      "type": "header",
      "content": "Mobile banners"
    },
    {
      "type": "select",
      "id": "banner_height_mobile",
      "label": "Mobile banner height",
      "options": [
        { "value": "half", "label": "Half screen (~45%)" },
        { "value": "full_screen", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "half",
      "info": "Half screen keeps mobile banners compact like Nykaa (~45% of viewport)."
    },
    {
      "type": "checkbox",
      "id": "mobile_fallback_desktop",
      "label": "Use desktop slides on mobile if no mobile slides",
      "default": false,
      "info": "When off, mobile shows only Mobile slide blocks."
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Desktop slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Shown on tablets and desktop (600px and wider). Hidden on phones when mobile slides exist."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "mobile_slide",
      "name": "Mobile slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Mobile image",
          "info": "Shown on phones only (under 600px). Prefer portrait/tall crop so key content stays visible."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero banner",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "mobile_slide" },
        { "type": "mobile_slide" }
      ]
    }
  ]
}
{% endschema %}
