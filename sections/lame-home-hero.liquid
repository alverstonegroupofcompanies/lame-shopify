{%- liquid
  assign desktop_slide_count = 0
  assign mobile_slide_count = 0

  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign desktop_slide_count = desktop_slide_count | plus: 1
    endif
    if block.type == 'mobile_slide' and block.settings.image != blank
      assign mobile_slide_count = mobile_slide_count | plus: 1
    endif
  endfor

  assign mobile_fallback = section.settings.mobile_fallback_desktop
  assign show_mobile_desktop_fallback = false
  if mobile_slide_count == 0 and mobile_fallback and desktop_slide_count > 0
    assign show_mobile_desktop_fallback = true
  endif

  assign has_mobile_carousel = false
  if mobile_slide_count > 0 or show_mobile_desktop_fallback
    assign has_mobile_carousel = true
  endif

  assign hero_height = section.settings.banner_height
  assign hero_height_mobile = section.settings.banner_height_mobile | default: 'medium'
  assign slideshow_slide_size = hero_height

  case hero_height
    when 'full_screen'
      assign lame_hero_h = '100svh'
      assign lame_hero_h_desktop = '100svh'
      assign slideshow_slide_size = 'large'
    when 'small'
      assign lame_hero_h = '200px'
      assign lame_hero_h_desktop = '300px'
    when 'medium'
      assign lame_hero_h = '240px'
      assign lame_hero_h_desktop = '380px'
    else
      assign lame_hero_h = '280px'
      assign lame_hero_h_desktop = '440px'
  endcase

  case hero_height_mobile
    when 'full_screen'
      assign lame_hero_h_mobile = '100svh'
    when 'small'
      assign lame_hero_h_mobile = '180px'
    when 'medium'
      assign lame_hero_h_mobile = '220px'
    when 'large'
      assign lame_hero_h_mobile = '280px'
    else
      assign lame_hero_h_mobile = '220px'
  endcase

  assign show_section = false
  if desktop_slide_count > 0 or has_mobile_carousel or request.design_mode
    assign show_section = true
  endif

  assign mobile_block_type = 'mobile_slide'
  if show_mobile_desktop_fallback
    assign mobile_block_type = 'slide'
  endif
-%}

{%- if show_section -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero lame-home-hero--{{ hero_height }} lame-home-hero--mobile-{{ hero_height_mobile }}{% if has_mobile_carousel %} lame-home-hero--has-mobile-banners{% endif %}"
    data-testid="hero-slideshow"
    style="--lame-hero-height: {{ lame_hero_h }}; --lame-hero-height-desktop: {{ lame_hero_h_desktop }}; --lame-hero-height-mobile: {{ lame_hero_h_mobile }};"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow spacing-style disable-section-top-offset"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if desktop_slide_count == 0 and mobile_slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>
            Add <strong>Desktop slide</strong> blocks for large screens and <strong>Mobile slide</strong> blocks for
            phones. Desktop banners are hidden on mobile when mobile slides exist.
          </p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>

        {%- if desktop_slide_count > 0 -%}
          {%- liquid
            assign desktop_prioritize_loading = true
            if has_mobile_carousel
              assign desktop_prioritize_loading = false
            endif
          -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: 'slide',
            carousel_modifier: 'desktop',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: desktop_prioritize_loading
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--desktop">
            <p>Add desktop slides with images for screens 750px and wider.</p>
          </div>
        {%- endif -%}

        {%- if has_mobile_carousel -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: mobile_block_type,
            carousel_modifier: 'mobile',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: true
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--mobile">
            <p>Add mobile slides for screens under 750px, or enable “Use desktop slides on mobile”.</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .lame-home-hero {
    --lame-hero-height: 100svh;
    --lame-hero-height-desktop: 100svh;
    --lame-hero-height-mobile: 220px;
    --lame-hero-height-offset: 0px;
    --lame-hero-display-height: var(--lame-hero-height-mobile);
    width: 100%;
    max-width: none;
  }

  body:has(> #header-group > .header-section > #header-component)
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: var(--header-group-height, 0px);
  }

  body:has(.header[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child,
  body:has(header-component[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child {
    margin-top: calc(var(--header-group-height, 0px) * -1);
    width: 100%;
    max-width: none;
  }

  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: 0px;
  }

  .lame-home-hero--full_screen {
    --lame-hero-display-height: calc(var(--lame-hero-height-mobile) - var(--lame-hero-height-offset, 0px));
  }

  @media screen and (max-width: 749px) {
    .lame-home-hero--mobile-full_screen {
      --lame-hero-display-height: calc(var(--lame-hero-height-mobile) - var(--lame-hero-height-offset, 0px));
    }
  }

  .lame-home-hero__slideshow {
    width: 100%;
    max-width: none;
    padding-inline: 0;
    position: relative;
  }

  /* Mobile: show mobile carousel only */
  .lame-home-hero__frame--desktop {
    display: none;
  }

  .lame-home-hero__frame--mobile {
    display: block;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
    display: block;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--mobile {
    display: none;
  }

  .lame-home-hero__carousel slideshow-component {
    --slide-min-height: var(--lame-hero-display-height) !important;
    --slide-min-height-desktop: var(--lame-hero-display-height) !important;
  }

  .lame-home-hero__frame,
  .lame-home-hero__carousel slideshow-component,
  .lame-home-hero__carousel slideshow-container,
  .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-display-height);
    max-height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
  }

  .lame-home-hero__frame {
    width: 100%;
    max-width: none;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .lame-home-hero {
      --lame-hero-display-height: var(--lame-hero-height);
    }

    .lame-home-hero:not(.lame-home-hero--full_screen) {
      --lame-hero-display-height: var(--lame-hero-height-desktop);
    }

    .lame-home-hero--full_screen {
      --lame-hero-display-height: calc(var(--lame-hero-height-desktop) - var(--lame-hero-height-offset, 0px));
    }

    .lame-home-hero__frame--desktop {
      display: block;
    }

    .lame-home-hero__frame--mobile {
      display: none;
    }
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
    height: 100%;
  }

  .lame-home-hero__carousel slideshow-slide > .slide__image-container {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .lame-home-hero__slide-link {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .lame-home-hero__slide-link .slide__image,
  .lame-home-hero__slide-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .lame-home-hero__carousel slideshow-arrows,
  .lame-home-hero__carousel slideshow-arrows[position='center'] {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: normal;
    --lame-hero-arrow-gap: 0.5rem;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control {
    position: absolute;
    bottom: var(--lame-hero-arrow-gap);
    pointer-events: auto;
    opacity: 1;
    animation: none;
    transform: none;
    min-width: 0;
    min-height: 0;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--previous {
    left: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--next {
    right: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle {
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover {
    filter: brightness(0.96);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
    width: 0.5rem;
    height: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .lame-home-hero__carousel slideshow-arrows,
    .lame-home-hero__carousel slideshow-arrows[position='center'] {
      --lame-hero-arrow-gap: 0.375rem;
    }

    .lame-home-hero__carousel slideshow-arrows .slideshow-control {
      width: 1.15rem;
      height: 1.15rem;
    }

    .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
    .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
      width: 0.45rem;
      height: 0.45rem;
    }
  }

  .lame-home-hero__placeholder {
    height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }

  @media screen and (min-width: 750px) {
    .lame-home-hero__placeholder--mobile {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-home-hero__placeholder--desktop {
      display: none;
    }
  }

  /* Theme editor: preview both desktop and mobile carousels */
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    display: block;
  }

  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    margin-top: 0.75rem;
    outline: 1px dashed rgb(0 0 0 / 0.15);
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 16,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "header",
      "content": "Desktop banners"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Desktop banner height",
      "options": [
        { "value": "full_screen", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "full_screen"
    },
    {
      "type": "header",
      "content": "Mobile banners"
    },
    {
      "type": "select",
      "id": "banner_height_mobile",
      "label": "Mobile banner height",
      "options": [
        { "value": "full_screen", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "medium",
      "info": "Recommended: Medium or Large for mobile-friendly crops."
    },
    {
      "type": "checkbox",
      "id": "mobile_fallback_desktop",
      "label": "Use desktop slides on mobile if no mobile slides",
      "default": false,
      "info": "When off, mobile shows only Mobile slide blocks."
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Desktop slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Desktop image",
          "info": "Shown on screens 750px and wider. Hidden on mobile when mobile slides are added."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "mobile_slide",
      "name": "Mobile slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Mobile image",
          "info": "Shown only on screens under 750px. Use portrait or square crops (e.g. 1080×1350px)."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero banner",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "mobile_slide" },
        { "type": "mobile_slide" }
      ]
    }
  ]
}
{% endschema %}
