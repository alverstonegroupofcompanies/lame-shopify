<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-home-hero"
  style="--lame-home-hero-bg: {{ section.settings.background_color }};"
>
  <div class="lame-home-hero__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <div class="lame-home-hero__grid">
      <div class="lame-home-hero__content">
        {% if section.settings.eyebrow != blank %}
          <p class="lame-home-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h1 class="lame-home-hero__heading">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="lame-home-hero__description rte">{{ section.settings.description }}</div>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <a
            class="lame-home-hero__button button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

      <div class="lame-home-hero__media">
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'lame-home-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '600,900,1200,1600',
              sizes: '(min-width: 990px) 50vw, 94vw'
          }}
        {% else %}
          {{ 'collection-apparel-2' | placeholder_svg_tag: 'lame-home-hero__image placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-home-hero {
    background: var(--lame-home-hero-bg, #f7f7f7);
  }

  .lame-home-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    min-height: clamp(280px, 42vw, 420px);
  }

  .lame-home-hero__content {
    padding: 8px 0;
  }

  .lame-home-hero__eyebrow {
    margin: 0 0 10px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.55);
  }

  .lame-home-hero__heading {
    margin: 0 0 14px;
    font-family: var(--font-heading--family);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #111;
    max-width: 16ch;
  }

  .lame-home-hero__description {
    margin: 0 0 22px;
    max-width: 42ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(0 0 0 / 0.62);
  }

  .lame-home-hero__description p {
    margin: 0;
  }

  .lame-home-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 28px;
    background: #111 !important;
    color: #fff !important;
    border: 1px solid #111 !important;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 200ms ease, color 200ms ease;
  }

  .lame-home-hero__button:hover {
    background: #fff !important;
    color: #111 !important;
  }

  .lame-home-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 240px;
  }

  .lame-home-hero__image {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    display: block;
  }

  @media screen and (min-width: 990px) {
    .lame-home-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "View our women's hair products"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover salon-quality care and styling essentials curated for every hair type.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f5f5f5"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "category": "Banners"
    }
  ]
}
{% endschema %}
