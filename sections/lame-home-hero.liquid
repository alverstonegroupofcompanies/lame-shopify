{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign show_arrows = false
  if slide_count > 1
    assign show_arrows = true
  endif

  assign hero_height = section.settings.banner_height
  assign slideshow_class = 'lame-home-hero__carousel'
  if slide_count == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
-%}

{%- if slide_count > 0 or request.design_mode -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero"
    data-testid="hero-slideshow"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow spacing-style"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>Add at least one slide with a banner image. Add two or more slides to enable arrow navigation.</p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>
        {% capture slides %}
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.image == blank -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign slide_loading = 'lazy'
              assign slide_fetchpriority = 'auto'
              if slide_index == 0
                assign slide_loading = 'eager'
                assign slide_fetchpriority = 'high'
              endif
            -%}
            {%- capture slide_children -%}
              <div class="slide__image-container">
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="lame-home-hero__slide-link"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank" rel="noopener"
                    {% endif %}
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    class: 'slide__image',
                    loading: slide_loading,
                    fetchpriority: slide_fetchpriority,
                    widths: '832, 1200, 1600, 1920, 2560, 3840',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: section.settings.accessibility_label | escape
                }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endcapture -%}
            {% render 'slideshow-slide',
              index: slide_index,
              children: slide_children,
              attributes: block.shopify_attributes,
              slide_size: hero_height,
              navigate_to_slide: false
            %}
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endfor -%}
        {% endcapture %}

        <div class="slideshow-section lame-home-hero__frame">
          {% render 'slideshow',
            class: slideshow_class,
            slides: slides,
            slide_count: slide_count,
            slide_size: hero_height,
            show_arrows: show_arrows,
            icon_style: 'arrows_large',
            icon_shape: 'circle',
            arrows_position: 'center',
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed
          %}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .lame-home-hero {
    --lame-hero-min-height: clamp(280px, 52vh, 720px);
    width: 100%;
  }

  .lame-home-hero__slideshow {
    width: 100%;
    padding-inline: 0;
  }

  .lame-home-hero__frame {
    width: 100%;
    overflow: hidden;
  }

  .lame-home-hero__carousel slideshow-slides {
    min-height: var(--lame-hero-min-height);
  }

  @media screen and (min-width: 750px) {
    .lame-home-hero__carousel slideshow-slides {
      min-height: var(--lame-hero-min-height);
    }
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
  }

  .lame-home-hero__carousel .slide__image-container {
    display: flex;
    width: 100%;
    min-height: var(--lame-hero-min-height);
    overflow: hidden;
    position: relative;
  }

  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img {
    width: 100%;
    height: 100%;
    min-height: var(--lame-hero-min-height);
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .lame-home-hero__slide-link {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .lame-home-hero__carousel slideshow-arrows {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    z-index: 2;
    padding-inline: clamp(0.35rem, 2vw, 1rem);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control {
    pointer-events: auto;
    background: rgb(255 255 255 / 0.88);
    border: 1px solid rgb(0 0 0 / 0.08);
    color: #111;
  }

  .lame-home-hero__placeholder {
    min-height: var(--lame-hero-min-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Required. Add at least one slide image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero banner",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
