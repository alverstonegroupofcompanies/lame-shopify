{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign show_arrows = false
  if slide_count > 1
    assign show_arrows = true
  endif

  assign hero_height = section.settings.banner_height
  assign slideshow_slide_size = hero_height
  case hero_height
    when 'full_screen'
      assign lame_hero_h = '100svh'
      assign lame_hero_h_desktop = '100svh'
      assign slideshow_slide_size = 'large'
    when 'small'
      assign lame_hero_h = '200px'
      assign lame_hero_h_desktop = '300px'
    when 'medium'
      assign lame_hero_h = '240px'
      assign lame_hero_h_desktop = '380px'
    else
      assign lame_hero_h = '280px'
      assign lame_hero_h_desktop = '440px'
  endcase
  assign slideshow_class = 'lame-home-hero__carousel'
  if slide_count == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
-%}

{%- if slide_count > 0 or request.design_mode -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero lame-home-hero--{{ hero_height }}"
    data-testid="hero-slideshow"
    style="--lame-hero-height: {{ lame_hero_h }}; --lame-hero-height-desktop: {{ lame_hero_h_desktop }};"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow spacing-style disable-section-top-offset"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>Add at least one slide with a banner image. Add two or more slides to enable arrow navigation.</p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>
        {% capture slides %}
          {%- assign slide_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.image == blank -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign slide_loading = 'lazy'
              assign slide_fetchpriority = 'auto'
              if slide_index == 0
                assign slide_loading = 'eager'
                assign slide_fetchpriority = 'high'
              endif
            -%}
            {%- capture slide_children -%}
              <div class="slide__image-container">
                {%- if block.settings.link != blank -%}
                  <a
                    href="{{ block.settings.link }}"
                    class="lame-home-hero__slide-link"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank" rel="noopener"
                    {% endif %}
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    class: 'slide__image',
                    loading: slide_loading,
                    fetchpriority: slide_fetchpriority,
                    widths: '832, 1200, 1600, 1920, 2560, 3840',
                    sizes: '100vw',
                    alt: block.settings.image.alt | default: section.settings.accessibility_label | escape
                }}
                {%- if block.settings.link != blank -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endcapture -%}
            {% render 'slideshow-slide',
              index: slide_index,
              children: slide_children,
              attributes: block.shopify_attributes,
              slide_size: slideshow_slide_size,
              media_fit: 'contain',
              navigate_to_slide: false
            %}
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endfor -%}
        {% endcapture %}

        <div class="slideshow-section lame-home-hero__frame">
          {% render 'slideshow',
            class: slideshow_class,
            slides: slides,
            slide_count: slide_count,
            slide_size: slideshow_slide_size,
            show_arrows: show_arrows,
            icon_style: 'arrow',
            icon_shape: 'circle',
            arrows_position: 'center',
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed
          %}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .lame-home-hero {
    --lame-hero-height: 100svh;
    --lame-hero-height-desktop: 100svh;
    --lame-hero-height-offset: 0px;
    --lame-hero-display-height: var(--lame-hero-height);
    width: 100%;
    max-width: none;
  }

  body:has(> #header-group > .header-section > #header-component)
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: var(--header-group-height, 0px);
  }

  body:has(.header[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child,
  body:has(header-component[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child {
    margin-top: calc(var(--header-group-height, 0px) * -1);
    width: 100%;
    max-width: none;
  }

  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: 0px;
  }

  .lame-home-hero--full_screen {
    --lame-hero-display-height: calc(var(--lame-hero-height) - var(--lame-hero-height-offset, 0px));
  }

  .lame-home-hero__slideshow {
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }

  .lame-home-hero__carousel slideshow-component {
    --slide-min-height: var(--lame-hero-display-height) !important;
    --slide-min-height-desktop: var(--lame-hero-display-height) !important;
  }

  .lame-home-hero__frame,
  .lame-home-hero__carousel slideshow-component,
  .lame-home-hero__carousel slideshow-container,
  .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-display-height);
    max-height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
  }

  .lame-home-hero__frame {
    width: 100%;
    max-width: none;
    overflow: hidden;
  }

  @media screen and (min-width: 750px) {
    .lame-home-hero:not(.lame-home-hero--full_screen) {
      --lame-hero-display-height: var(--lame-hero-height-desktop);
    }

    .lame-home-hero--full_screen {
      --lame-hero-display-height: calc(var(--lame-hero-height-desktop) - var(--lame-hero-height-offset, 0px));
    }
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
    height: 100%;
  }

  .lame-home-hero__carousel slideshow-slide > .slide__image-container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center center;
    display: block;
  }

  .lame-home-hero__slide-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .lame-home-hero__carousel slideshow-arrows,
  .lame-home-hero__carousel slideshow-arrows[position='center'] {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: normal;
    --lame-hero-arrow-gap: 0.5rem;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control {
    position: absolute;
    bottom: var(--lame-hero-arrow-gap);
    pointer-events: auto;
    opacity: 1;
    animation: none;
    transform: none;
    min-width: 0;
    min-height: 0;
    width: 1.25rem;
    height: 1.25rem;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--previous {
    left: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--next {
    right: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle {
    background-color: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover {
    filter: brightness(0.96);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
    width: 0.5rem;
    height: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .lame-home-hero__carousel slideshow-arrows,
    .lame-home-hero__carousel slideshow-arrows[position='center'] {
      --lame-hero-arrow-gap: 0.375rem;
    }

    .lame-home-hero__carousel slideshow-arrows .slideshow-control {
      width: 1.15rem;
      height: 1.15rem;
    }

    .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
    .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
      width: 0.45rem;
      height: 0.45rem;
    }
  }

  .lame-home-hero__placeholder {
    height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Banner height",
      "options": [
        { "value": "full_screen", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "full_screen"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Required. Add at least one slide image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero banner",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
