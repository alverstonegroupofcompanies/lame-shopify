{%- liquid
  assign desktop_slide_count = 0
  assign mobile_slide_count = 0
  assign desktop_banner_ratio = 2.4
  assign mobile_banner_ratio = 0.5625
  assign desktop_ratio_set = false
  assign mobile_ratio_set = false

  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign desktop_slide_count = desktop_slide_count | plus: 1
      unless desktop_ratio_set
        assign desktop_banner_ratio = block.settings.image.aspect_ratio | default: 2.4
        assign desktop_ratio_set = true
      endunless
    endif
    if block.type == 'mobile_slide' and block.settings.image != blank
      assign mobile_slide_count = mobile_slide_count | plus: 1
      unless mobile_ratio_set
        assign mobile_banner_ratio = block.settings.image.aspect_ratio | default: 0.5625
        assign mobile_ratio_set = true
      endunless
    endif
  endfor

  assign mobile_fallback = section.settings.mobile_fallback_desktop
  assign show_mobile_desktop_fallback = false
  if mobile_slide_count == 0 and mobile_fallback and desktop_slide_count > 0
    assign show_mobile_desktop_fallback = true
    assign mobile_banner_ratio = desktop_banner_ratio
  endif

  assign has_mobile_carousel = false
  if mobile_slide_count > 0 or show_mobile_desktop_fallback
    assign has_mobile_carousel = true
  endif

  assign hero_height = section.settings.banner_height
  assign hero_height_mobile = section.settings.banner_height_mobile | default: 'medium'
  assign slideshow_slide_size = hero_height
  assign image_fit = section.settings.image_fit | default: 'contain'

  case hero_height
    when 'full_screen'
      assign lame_hero_h = '100svh'
      assign lame_hero_h_desktop = '100svh'
      assign slideshow_slide_size = 'large'
    when 'small'
      assign lame_hero_h = '200px'
      assign lame_hero_h_desktop = '300px'
    when 'medium'
      assign lame_hero_h = '240px'
      assign lame_hero_h_desktop = '380px'
    else
      assign lame_hero_h = '280px'
      assign lame_hero_h_desktop = '440px'
  endcase

  case hero_height_mobile
    when 'full_screen'
      assign lame_hero_h_mobile = '100svh'
    when 'small'
      assign lame_hero_h_mobile = '180px'
    when 'medium'
      assign lame_hero_h_mobile = '220px'
    when 'large'
      assign lame_hero_h_mobile = '280px'
    else
      assign lame_hero_h_mobile = '220px'
  endcase

  assign show_section = false
  if desktop_slide_count > 0 or has_mobile_carousel or request.design_mode
    assign show_section = true
  endif

  assign mobile_block_type = 'mobile_slide'
  if show_mobile_desktop_fallback
    assign mobile_block_type = 'slide'
  endif
-%}

{%- if show_section -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero lame-home-hero--{{ hero_height }} lame-home-hero--mobile-{{ hero_height_mobile }} lame-home-hero--fit-{{ image_fit }}{% if has_mobile_carousel %} lame-home-hero--has-mobile-banners{% endif %}"
    data-testid="hero-slideshow"
    style="--lame-hero-height: {{ lame_hero_h }}; --lame-hero-height-desktop: {{ lame_hero_h_desktop }}; --lame-hero-height-mobile: {{ lame_hero_h_mobile }}; --lame-hero-desktop-ratio: {{ desktop_banner_ratio }}; --lame-hero-mobile-ratio: {{ mobile_banner_ratio }};"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow spacing-style disable-section-top-offset"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if desktop_slide_count == 0 and mobile_slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>
            Add <strong>Desktop slide</strong> blocks for large screens and <strong>Mobile slide</strong> blocks for
            phones. Desktop banners are hidden on mobile when mobile slides exist.
          </p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>

        {%- if desktop_slide_count > 0 -%}
          {%- liquid
            assign desktop_prioritize_loading = true
            if has_mobile_carousel
              assign desktop_prioritize_loading = false
            endif
          -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: 'slide',
            carousel_modifier: 'desktop',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: desktop_prioritize_loading,
            media_fit: 'cover'
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--desktop">
            <p>Add desktop slides with images for screens 1200px and wider (13″+ displays).</p>
          </div>
        {%- endif -%}

        {%- if has_mobile_carousel -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: mobile_block_type,
            carousel_modifier: 'mobile',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: true,
            media_fit: 'cover'
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--mobile">
            <p>Add mobile slides for phones and tablets under 12″ (under 1200px), or enable “Use desktop slides on mobile”.</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .lame-home-hero {
    --lame-hero-height: 100svh;
    --lame-hero-height-desktop: 100svh;
    --lame-hero-height-mobile: 220px;
    --lame-hero-height-offset: 0px;
    --lame-hero-display-height: auto;
    --lame-hero-desktop-min: 1200px;
    --lame-hero-desktop-ratio: 2.4;
    --lame-hero-mobile-ratio: 0.5625;
    --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
    --lame-hero-frame-max-height: 100svh;
    width: 100%;
    max-width: none;
    overflow-x: hidden;
    background: #fff;
  }

  .lame-home-hero.section.section--full-width {
    display: block;
    width: 100%;
    max-width: none;
    padding: 0;
    margin: 0;
  }

  .lame-home-hero.section.section--full-width > * {
    width: 100%;
    max-width: none;
    margin-inline: 0;
    padding-inline: 0;
  }

  .shopify-section.hero-wrapper:has(.lame-home-hero) {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: 0;
  }

  body:has(> #header-group > .header-section > #header-component)
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: var(--header-group-height, 0px);
  }

  /* Transparent header: keep banner top visible — pad slideshow below nav instead of pulling section under header */
  body:has(.header[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child,
  body:has(header-component[transparent]) .content-for-layout > .shopify-section:has(.lame-home-hero):first-child {
    margin-top: 0;
    width: 100%;
    max-width: none;
  }

  body:has(.header[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen,
  body:has(header-component[transparent])
    .content-for-layout
    > .shopify-section:has(.lame-home-hero):first-child
    .lame-home-hero--full_screen {
    --lame-hero-height-offset: 0px;
  }

  .lame-home-hero__slideshow {
    width: 100%;
    max-width: none;
    padding-inline: 0;
    position: relative;
  }

  /* Mobile: show mobile carousel only */
  .lame-home-hero__frame--desktop {
    display: none;
  }

  .lame-home-hero__frame--mobile {
    display: block;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
    display: block;
    --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--mobile {
    display: none;
  }

  /* Full-width frame — always viewport width; fixed height + cover (no side letterboxing) */
  .lame-home-hero__frame,
  .lame-home-hero__carousel slideshow-component,
  .lame-home-hero__carousel slideshow-container,
  .lame-home-hero__carousel slideshow-slides {
    width: 100%;
    min-width: 100%;
    max-width: none;
    height: var(--lame-hero-frame-max-height);
    min-height: var(--lame-hero-frame-min-height, 0px);
    max-height: var(--lame-hero-frame-max-height);
    aspect-ratio: unset;
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    min-width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .lame-home-hero__carousel slideshow-component {
    --slide-min-height: 0 !important;
    --slide-min-height-desktop: 0 !important;
    --product-media-fit: cover;
  }

  .lame-home-hero__frame {
    overflow: hidden;
    line-height: 0;
    background: #1a1a1a;
  }

  /* Optional height caps — frame stays full width; image uses cover inside */
  .lame-home-hero--full_screen {
    --lame-hero-frame-max-height: calc(100svh - var(--lame-hero-height-offset, 0px));
  }

  .lame-home-hero--small {
    --lame-hero-frame-max-height: var(--lame-hero-height-mobile);
  }

  .lame-home-hero--medium {
    --lame-hero-frame-max-height: var(--lame-hero-height-mobile);
  }

  .lame-home-hero--large {
    --lame-hero-frame-max-height: var(--lame-hero-height-mobile);
  }

  .lame-home-hero--full_screen .lame-home-hero__frame,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-frame-max-height);
    max-height: var(--lame-hero-frame-max-height);
  }

  .lame-home-hero--small .lame-home-hero__frame,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--small .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-frame-max-height);
    max-height: var(--lame-hero-frame-max-height);
  }

  .lame-home-hero--medium .lame-home-hero__frame,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--medium .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-frame-max-height);
    max-height: var(--lame-hero-frame-max-height);
  }

  .lame-home-hero--large .lame-home-hero__frame,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-component,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-container,
  .lame-home-hero--large .lame-home-hero__carousel slideshow-slides {
    height: var(--lame-hero-frame-max-height);
    max-height: var(--lame-hero-frame-max-height);
  }

  /* Phones + tablets under ~12″: mobile banners only */
  @media screen and (max-width: 1199px) {
    .lame-home-hero {
      --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop {
      display: none !important;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
      display: block !important;
      --lame-hero-banner-ratio: var(--lame-hero-mobile-ratio);
    }

    .lame-home-hero--mobile-full_screen {
      --lame-hero-frame-max-height: calc(100svh - var(--lame-hero-height-offset, 0px));
    }

    .lame-home-hero--mobile-full_screen .lame-home-hero__frame--mobile,
    .lame-home-hero--mobile-full_screen .lame-home-hero__carousel--mobile slideshow-component,
    .lame-home-hero--mobile-full_screen .lame-home-hero__carousel--mobile slideshow-container,
    .lame-home-hero--mobile-full_screen .lame-home-hero__carousel--mobile slideshow-slides {
      height: var(--lame-hero-frame-max-height);
      max-height: var(--lame-hero-frame-max-height);
    }

    @supports (height: 100dvh) {
      .lame-home-hero--mobile-full_screen {
        --lame-hero-frame-max-height: calc(100dvh - var(--lame-hero-height-offset, 0px));
      }
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile,
    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile slideshow-component,
    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile slideshow-container,
    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile slideshow-slides,
    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile slideshow-slide {
      width: 100%;
      max-width: 100%;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile slideshow-slide > .slide__image-container,
    .lame-home-hero--has-mobile-banners .lame-home-hero__carousel--mobile .lame-home-hero__slide-link {
      width: 100%;
      height: 100%;
    }
  }

  /* Desktop / large screens (1200px+) */
  @media screen and (min-width: 1200px) {
    .lame-home-hero {
      --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
    }

    .lame-home-hero__frame--desktop {
      display: block;
      --lame-hero-banner-ratio: var(--lame-hero-desktop-ratio);
    }

    .lame-home-hero__frame--mobile {
      display: none;
    }

    .lame-home-hero--small {
      --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
    }

    .lame-home-hero--medium {
      --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
    }

    .lame-home-hero--large {
      --lame-hero-frame-max-height: var(--lame-hero-height-desktop);
    }

    .lame-home-hero--full_screen {
      --lame-hero-frame-max-height: calc(var(--lame-hero-height-desktop) - var(--lame-hero-height-offset, 0px));
    }

    .lame-home-hero--small .lame-home-hero__frame,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--small .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--medium .lame-home-hero__frame,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--medium .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--large .lame-home-hero__frame,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--large .lame-home-hero__carousel slideshow-slides,
    .lame-home-hero--full_screen .lame-home-hero__frame,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-component,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-container,
    .lame-home-hero--full_screen .lame-home-hero__carousel slideshow-slides {
      height: var(--lame-hero-frame-max-height);
      max-height: var(--lame-hero-frame-max-height);
    }
  }

  .lame-home-hero__carousel slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
    height: 100%;
    min-height: 0;
    position: relative;
  }

  .lame-home-hero__carousel slideshow-slide > .slide__image-container {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    line-height: 0;
  }

  /* Always cover — no side letterboxing */
  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img,
  .lame-home-hero__slide-link .slide__image,
  .lame-home-hero__slide-link img {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover !important;
    object-position: center top;
    display: block;
  }

  .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image,
  .lame-home-hero--fit-contain .lame-home-hero__carousel .slide__image-container img,
  .lame-home-hero--fit-contain .lame-home-hero__slide-link .slide__image,
  .lame-home-hero--fit-contain .lame-home-hero__slide-link img {
    object-fit: contain !important;
    object-position: center top;
  }

  .lame-home-hero__slide-link {
    display: block;
    width: 100%;
    height: 100%;
    line-height: 0;
  }

  .lame-home-hero__carousel slideshow-arrows,
  .lame-home-hero__carousel slideshow-arrows[position='center'] {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: normal;
    --lame-hero-arrow-gap: 1rem;
    --lame-hero-arrow-size: 2.75rem;
    --lame-hero-arrow-icon: 1.125rem;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-square {
    position: absolute;
    bottom: var(--lame-hero-arrow-gap);
    pointer-events: auto;
    opacity: 1;
    animation: none;
    transform: none;
    min-width: var(--lame-hero-arrow-size);
    min-height: var(--lame-hero-arrow-size);
    width: var(--lame-hero-arrow-size);
    height: var(--lame-hero-arrow-size);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    cursor: pointer;
    background-color: rgb(45 74 34) !important;
    color: #fff !important;
    border: 1px solid rgb(45 74 34 / 0.35);
    box-shadow: 0 4px 14px rgb(26 42 36 / 0.18);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--previous {
    left: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--next {
    right: var(--lame-hero-arrow-gap);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control:hover,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control.slideshow-control--shape-circle:hover {
    background-color: rgb(35 58 28) !important;
    color: #fff !important;
    border-color: rgb(35 58 28);
    filter: none;
    box-shadow: 0 6px 18px rgb(26 42 36 / 0.22);
    transform: scale(1.04);
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper,
  .lame-home-hero__carousel slideshow-arrows .slideshow-control .svg-wrapper svg {
    width: var(--lame-hero-arrow-icon);
    height: var(--lame-hero-arrow-icon);
    display: block;
    color: #fff;
    stroke: currentColor;
  }

  @media screen and (max-width: 1199px) {
    .lame-home-hero__carousel slideshow-arrows,
    .lame-home-hero__carousel slideshow-arrows[position='center'] {
      --lame-hero-arrow-gap: 0.75rem;
      --lame-hero-arrow-size: 2.5rem;
      --lame-hero-arrow-icon: 1rem;
    }
  }

  .lame-home-hero__placeholder {
    height: var(--lame-hero-display-height);
    min-height: var(--lame-hero-display-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }

  @media screen and (min-width: 1200px) {
    .lame-home-hero__placeholder--mobile {
      display: none;
    }
  }

  @media screen and (max-width: 1199px) {
    .lame-home-hero__placeholder--desktop {
      display: none;
    }
  }

  /* Theme editor: preview both desktop and mobile carousels */
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    display: block;
  }

  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    margin-top: 0.75rem;
    outline: 1px dashed rgb(0 0 0 / 0.15);
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper hero-wrapper",
  "max_blocks": 16,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "header",
      "content": "Desktop banners"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Desktop banner height",
      "options": [
        { "value": "full_screen", "label": "Full screen (max)" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "full_screen",
      "info": "Banners keep their natural aspect ratio so the full image stays visible. Height only sets a maximum."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show full image (no crop)" },
        { "value": "cover", "label": "Fill frame (may crop)" }
      ],
      "default": "cover",
      "info": "“Fill frame” keeps the banner edge-to-edge on every screen. Use “Show full image” only if you prefer letterboxing."
    },
    {
      "type": "header",
      "content": "Mobile banners"
    },
    {
      "type": "select",
      "id": "banner_height_mobile",
      "label": "Mobile banner height",
      "options": [
