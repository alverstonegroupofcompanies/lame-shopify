{%- liquid
  assign desktop_slide_count = 0
  assign mobile_slide_count = 0
  assign desktop_banner_ratio = 2.4
  assign mobile_banner_ratio = 0.5625
  assign desktop_ratio_set = false
  assign mobile_ratio_set = false

  for block in section.blocks
    if block.type == 'slide' and block.settings.image != blank
      assign desktop_slide_count = desktop_slide_count | plus: 1
      assign slide_ratio = block.settings.image.aspect_ratio | default: 2.4
      unless desktop_ratio_set
        assign desktop_banner_ratio = slide_ratio
        assign desktop_ratio_set = true
      else
        if slide_ratio < desktop_banner_ratio
          assign desktop_banner_ratio = slide_ratio
        endif
      endunless
    endif
    if block.type == 'mobile_slide' and block.settings.image != blank
      assign mobile_slide_count = mobile_slide_count | plus: 1
      assign slide_ratio = block.settings.image.aspect_ratio | default: 0.5625
      unless mobile_ratio_set
        assign mobile_banner_ratio = slide_ratio
        assign mobile_ratio_set = true
      else
        if slide_ratio < mobile_banner_ratio
          assign mobile_banner_ratio = slide_ratio
        endif
      endunless
    endif
  endfor

  assign mobile_fallback = section.settings.mobile_fallback_desktop
  assign show_mobile_desktop_fallback = false
  if mobile_slide_count == 0 and mobile_fallback and desktop_slide_count > 0
    assign show_mobile_desktop_fallback = true
    assign mobile_banner_ratio = desktop_banner_ratio
  endif

  assign has_mobile_carousel = false
  if mobile_slide_count > 0 or show_mobile_desktop_fallback
    assign has_mobile_carousel = true
  endif

  assign hero_height = section.settings.banner_height
  assign hero_height_mobile = section.settings.banner_height_mobile | default: 'medium'
  assign slideshow_slide_size = hero_height
  assign image_fit = section.settings.image_fit | default: 'cover'

  case hero_height
    when 'full_screen'
      # svh stays fixed when mobile browser chrome shows/hides on scroll
      assign lame_hero_h = '100svh'
      assign lame_hero_h_desktop = '100svh'
      assign slideshow_slide_size = 'large'
    when 'half'
      # Shared frame for every slide — tall enough to show the banner bottom
      assign lame_hero_h = '56svh'
      assign lame_hero_h_desktop = '56svh'
      assign slideshow_slide_size = 'large'
    when 'small'
      assign lame_hero_h = '200px'
      assign lame_hero_h_desktop = '300px'
    when 'medium'
      assign lame_hero_h = '240px'
      assign lame_hero_h_desktop = '380px'
    else
      assign lame_hero_h = '280px'
      assign lame_hero_h_desktop = '440px'
  endcase

  case hero_height_mobile
    when 'full_screen'
      assign lame_hero_h_mobile = '100svh'
    when 'half'
      assign lame_hero_h_mobile = '52svh'
    when 'small'
      assign lame_hero_h_mobile = '180px'
    when 'medium'
      assign lame_hero_h_mobile = '220px'
    when 'large'
      assign lame_hero_h_mobile = '280px'
    else
      assign lame_hero_h_mobile = '220px'
  endcase

  assign show_section = false
  if desktop_slide_count > 0 or has_mobile_carousel or request.design_mode
    assign show_section = true
  endif

  assign mobile_block_type = 'mobile_slide'
  if show_mobile_desktop_fallback
    assign mobile_block_type = 'slide'
  endif
-%}

{%- if show_section -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-home-hero lame-home-hero--{{ hero_height }} lame-home-hero--mobile-{{ hero_height_mobile }} lame-home-hero--fit-{{ image_fit }}{% if has_mobile_carousel %} lame-home-hero--has-mobile-banners{% endif %}"
    data-testid="hero-slideshow"
    style="--lame-hero-height: {{ lame_hero_h }}; --lame-hero-height-desktop: {{ lame_hero_h_desktop }}; --lame-hero-height-mobile: {{ lame_hero_h_mobile }}; --lame-hero-desktop-ratio: {{ desktop_banner_ratio }}; --lame-hero-mobile-ratio: {{ mobile_banner_ratio }};"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-home-hero__slideshow disable-section-top-offset"
    >
      {%- if desktop_slide_count == 0 and mobile_slide_count == 0 and request.design_mode -%}
        <div class="lame-home-hero__placeholder">
          <p>
            Add <strong>Desktop slide</strong> blocks for large screens and <strong>Mobile slide</strong> blocks for
            phones. Desktop banners are hidden on mobile when mobile slides exist.
          </p>
        </div>
      {%- else -%}
        <h2 class="visually-hidden">{{ section.settings.accessibility_label | escape }}</h2>

        {%- if desktop_slide_count > 0 -%}
          {%- liquid
            assign desktop_prioritize_loading = true
            if has_mobile_carousel
              assign desktop_prioritize_loading = false
            endif
          -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: 'slide',
            carousel_modifier: 'desktop',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: desktop_prioritize_loading,
            media_fit: image_fit
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--desktop">
            <p>Add desktop slides with images for tablets and desktop (600px and wider).</p>
          </div>
        {%- endif -%}

        {%- if has_mobile_carousel -%}
          {% render 'lame-home-hero-slideshow',
            section: section,
            block_type: mobile_block_type,
            carousel_modifier: 'mobile',
            accessibility_label: section.settings.accessibility_label,
            slideshow_slide_size: slideshow_slide_size,
            autoplay: section.settings.autoplay,
            autoplay_speed: section.settings.autoplay_speed,
            prioritize_first_slide: true,
            media_fit: image_fit
          %}
        {%- elsif request.design_mode -%}
          <div class="lame-home-hero__placeholder lame-home-hero__placeholder--mobile">
            <p>Add mobile slides for phones only (under 600px), or enable “Use desktop slides on mobile”.</p>
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_navaratri_ticker == true and section.settings.navaratri_ticker_text != blank -%}
      {%- assign navaratri_text = section.settings.navaratri_ticker_text -%}
      {%- assign navaratri_link = section.settings.navaratri_ticker_link | default: '/collections/all' -%}
      <div
        class="lame-navaratri-ticker"
        role="region"
        aria-label="Promotion Announcement"
        style="--lame-navaratri-bg: {{ section.settings.navaratri_ticker_bg | default: '#1a472a' }}; --lame-navaratri-color: {{ section.settings.navaratri_ticker_text_color | default: '#ffffff' }};"
      >
        <a href="{{ navaratri_link }}" class="lame-navaratri-ticker__inner" title="{{ navaratri_text | escape }}">
          <div class="lame-navaratri-ticker__track">
            <div class="lame-navaratri-ticker__group">
              {%- for i in (1..8) -%}
                <span class="lame-navaratri-ticker__item">
                  <span class="lame-navaratri-ticker__spark" aria-hidden="true">✦</span>
                  <span class="lame-navaratri-ticker__text">{{ navaratri_text | escape }}</span>
                </span>
              {%- endfor -%}
            </div>
            <div class="lame-navaratri-ticker__group" aria-hidden="true">
              {%- for i in (1..8) -%}
                <span class="lame-navaratri-ticker__item">
                  <span class="lame-navaratri-ticker__spark" aria-hidden="true">✦</span>
                  <span class="lame-navaratri-ticker__text">{{ navaratri_text | escape }}</span>
                </span>
              {%- endfor -%}
            </div>
          </div>
        </a>
      </div>
    {%- endif -%}
  </section>
  <script src="{{ 'lame-home-hero-mobile.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% stylesheet %}
  /* Navaratri Sale Live Ticker Strip (closely under banner) */
  .lame-navaratri-ticker {
    width: 100%;
    background: var(--lame-navaratri-bg, #f37021);
    background: linear-gradient(90deg, #ff6500 0%, #f37021 50%, #ff5200 100%);
    color: var(--lame-navaratri-color, #ffffff);
    overflow: hidden;
    position: relative;
    z-index: 3;
    margin: 0;
    padding: 0.52rem 0;
    line-height: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 3px 10px rgba(243, 112, 33, 0.25);
  }

  .lame-navaratri-ticker__inner {
    display: flex;
    overflow: hidden;
    width: 100%;
    text-decoration: none;
    color: inherit;
    user-select: none;
    mask-image: linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 2%, black 98%, transparent 100%);
  }

  .lame-navaratri-ticker__track {
    display: flex;
    flex-shrink: 0;
    width: max-content;
    align-items: center;
    will-change: transform;
    animation: lame-navaratri-loop 24s linear infinite;
  }

  .lame-navaratri-ticker:hover .lame-navaratri-ticker__track {
    animation-play-state: paused;
  }

  .lame-navaratri-ticker__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2.25rem;
    padding-right: 2.25rem;
  }

  .lame-navaratri-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading-family, var(--font-body--family, sans-serif));
    font-size: clamp(0.78rem, 1.15vw, 0.92rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lame-navaratri-color, #ffffff);
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  .lame-navaratri-ticker__spark {
    color: #ffe680;
    font-size: 0.72em;
    line-height: 1;
    display: inline-block;
    filter: drop-shadow(0 0 4px rgba(255, 230, 128, 0.7));
    animation: lame-spark-pulse 1.8s infinite ease-in-out alternate;
  }

  @keyframes lame-navaratri-loop {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes lame-spark-pulse {
    0% {
      transform: scale(0.85);
      opacity: 0.75;
    }
    100% {
      transform: scale(1.2);
      opacity: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-navaratri-ticker {
      padding: 0.42rem 0;
    }
    .lame-navaratri-ticker__group {
      gap: 1.5rem;
      padding-right: 1.5rem;
    }
    .lame-navaratri-ticker__item {
      font-size: 0.76rem;
      gap: 0.5rem;
      letter-spacing: 0.08em;
    }
  }

  .lame-home-hero {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden;
    background: transparent;
  }

  .lame-home-hero.section.section--full-width {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .lame-home-hero.section.section--full-width > * {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    margin-inline: 0 !important;
    padding: 0 !important;
    padding-inline: 0 !important;
  }

  .shopify-section.hero-wrapper:has(.lame-home-hero) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    margin-inline: 0 !important;
    padding: 0 !important;
    padding-inline: 0 !important;
    height: auto !important;
    min-height: 0 !important;
  }

  .lame-home-hero__slideshow {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    height: auto !important;
    min-height: 0 !important;
    position: relative !important;
  }

  /* Default / tablet+desktop: horizontal desktop banners */
  .lame-home-hero__frame--desktop {
    display: block;
  }

  .lame-home-hero__frame--mobile {
    display: none;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
    display: block;
  }

  .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--mobile {
    display: none;
  }

  /* Full-bleed edge-to-edge frame & slideshow components */
  .lame-home-hero__frame,
  .lame-home-hero__carousel slideshow-component,
  .lame-home-hero__carousel slideshow-container,
  .lame-home-hero__carousel slideshow-slides {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: auto !important;
    position: relative !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .lame-home-hero__frame {
    overflow: hidden !important;
    line-height: 0 !important;
    background: transparent !important;
  }

  .lame-home-hero__carousel slideshow-slides {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory !important;
    scroll-behavior: auto !important;
    scrollbar-width: none !important;
    -webkit-overflow-scrolling: touch;
    --slide-min-height: 0 !important;
    --slide-min-height-desktop: 0 !important;
    min-height: 0 !important;
  }

  .lame-home-hero__carousel slideshow-slides::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .lame-home-hero__carousel slideshow-slide {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    position: relative !important;
    display: block !important;
    scroll-snap-align: start !important;
    scroll-snap-stop: always !important;
    content-visibility: visible !important;
    contain-intrinsic-size: unset !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .lame-home-hero__carousel slideshow-slide > .slide__image-container,
  .lame-home-hero__carousel .lame-home-hero__slide-link {
    position: relative !important;
    inset: auto !important;
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 0 !important;
    overflow: hidden !important;
  }

  /* Edge-to-edge full-bleed image on every slide */
  .lame-home-hero__carousel .slide__image,
  .lame-home-hero__carousel .slide__image-container img,
  .lame-home-hero__slide-link .slide__image,
  .lame-home-hero__slide-link img {
    width: 100% !important;
    height: auto !important;
    min-width: 100% !important;
    max-width: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  /* Arrow controls kept inside banner */
  .lame-home-hero__carousel slideshow-arrows {
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    pointer-events: none !important;
    z-index: 5 !important;
    padding-inline: 1rem !important;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    pointer-events: auto !important;
    opacity: 1 !important;
    z-index: 6 !important;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--previous {
    left: 1rem !important;
    right: auto !important;
  }

  .lame-home-hero__carousel slideshow-arrows .slideshow-control--next {
    right: 1rem !important;
    left: auto !important;
  }

  /* Dots / controls kept inside banner */
  .lame-home-hero slideshow-controls {
    position: absolute !important;
    bottom: 1rem !important;
    left: 0 !important;
    right: 0 !important;
    margin: 0 auto !important;
    width: 100% !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    pointer-events: none !important;
    z-index: 5 !important;
  }

  .lame-home-hero slideshow-controls * {
    pointer-events: auto !important;
  }

  /* Phones (under 600px): vertical mobile banners */
  @media screen and (max-width: 599px) {
    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop {
      display: none !important;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
      display: block !important;
    }

    .lame-home-hero,
    .lame-home-hero__slideshow,
    .lame-home-hero__frame--mobile,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__frame--desktop {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      position: relative !important;
    }

    .lame-home-hero__carousel--mobile :is(slideshow-component, slideshow-container, slideshow-slides),
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop :is(slideshow-component, slideshow-container, slideshow-slides) {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
    }

    .lame-home-hero__carousel--mobile slideshow-slide,
    .lame-home-hero:not(.lame-home-hero--has-mobile-banners) .lame-home-hero__carousel--desktop slideshow-slide {
      flex: 0 0 100% !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
    }

    .lame-home-hero__carousel--mobile slideshow-slide > .slide__image-container,
    .lame-home-hero__carousel--mobile .lame-home-hero__slide-link {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
    }
  }

  /* Tablets + desktop (600px+): horizontal banners */
  @media screen and (min-width: 600px) {
    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
    .lame-home-hero__frame--desktop {
      display: block !important;
    }

    .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile,
    .lame-home-hero__frame--mobile {
      display: none !important;
    }

    .lame-home-hero__frame,
    .lame-home-hero__carousel slideshow-component,
    .lame-home-hero__carousel slideshow-container,
    .lame-home-hero__carousel slideshow-slides {
      width: 100% !important;
      min-width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      aspect-ratio: auto !important;
      position: relative !important;
    }

    .lame-home-hero__carousel slideshow-slide {
      flex: 0 0 100% !important;
      width: 100% !important;
      min-width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
    }

    .lame-home-hero__carousel slideshow-slide > .slide__image-container,
    .lame-home-hero__carousel .lame-home-hero__slide-link {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
    }
  }

  .lame-home-hero__placeholder {
    height: auto;
    min-height: 200px;
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: rgb(0 0 0 / 0.04);
    color: rgb(0 0 0 / 0.6);
    font-size: 0.9rem;
  }

  @media screen and (min-width: 600px) {
    .lame-home-hero__placeholder--mobile {
      display: none;
    }
  }

  @media screen and (max-width: 599px) {
    .lame-home-hero__placeholder--desktop {
      display: none;
    }
  }

  /* Theme editor: preview both desktop and mobile carousels */
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--desktop,
  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    display: block;
  }

  .shopify-design-mode .lame-home-hero--has-mobile-banners .lame-home-hero__frame--mobile {
    margin-top: 0.75rem;
    outline: 1px dashed rgb(0 0 0 / 0.15);
    outline-offset: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Home hero banner",
  "tag": "section",
  "class": "section-wrapper hero-wrapper",
  "max_blocks": 16,
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Homepage hero banner"
    },
    {
      "type": "header",
      "content": "Desktop banners"
    },
    {
      "type": "select",
      "id": "banner_height",
      "label": "Desktop banner height",
      "options": [
        { "value": "half", "label": "Half screen (~45–50%, Nykaa style)" },
        { "value": "full_screen", "label": "Full screen (max)" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "half",
      "info": "Half screen (~48% viewport) keeps banners compact so content below stays visible. Full screen fills the remaining viewport under the header."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Show full image (no crop)" },
        { "value": "cover", "label": "Fill frame (may crop)" }
      ],
      "default": "cover",
      "info": "Cover fills the banner frame cleanly. Contain shows the whole image with possible letterboxing. On phones the image always fills the full width."
    },
