{% liquid
  assign featured_collection = collections[section.settings.collection]
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign trust_blocks = section.blocks | where: 'type', 'trust'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cosmetic-featured"
  {{ section.shopify_attributes }}
>
  <div class="lame-cosmetic-featured__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-cosmetic-featured__header" data-lame-reveal>
      {% render 'lame-section-heading',
        title: section.settings.heading,
        subtitle: section.settings.subheading,
        alignment: 'center',
        show_divider: false
      %}
    </header>

    <ul class="lame-cosmetic-featured__grid" role="list">
      {% for product in featured_collection.products limit: section.settings.products_to_show %}
        {% liquid
          assign selected_variant = product.selected_or_first_available_variant
          assign product_description = product.description | strip_html | truncate: 90
        %}
        <li class="lame-cosmetic-featured__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 3 }}">
          <article class="lame-cosmetic-featured__card">
            <a href="{{ product.url }}" class="lame-cosmetic-featured__media-link" aria-label="{{ product.title | escape }}">
              <div class="lame-cosmetic-featured__media">
                {% if product.featured_media %}
                  {{
                    product.featured_media
                    | image_url: width: 600
                    | image_tag:
                      class: 'lame-cosmetic-featured__image',
                      loading: 'lazy',
                      widths: '240,360,480,600',
                      sizes: '(min-width: 990px) 200px, 30vw',
                      alt: product.title | escape
                  }}
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-cosmetic-featured__image placeholder-svg' }}
                {% endif %}
              </div>
            </a>
            <div class="lame-cosmetic-featured__body">
              <h3 class="lame-cosmetic-featured__title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              {% if product_description != blank %}
                <p class="lame-cosmetic-featured__desc">{{ product_description }}</p>
              {% endif %}
              <p class="lame-cosmetic-featured__price">
                {% render 'price', product_resource: product, show_sale_price_first: true %}
              </p>
              {% if selected_variant %}
                <form method="post" action="{{ routes.cart_add_url }}" class="lame-cosmetic-featured__atc-form" data-lame-home-atc>
                  <input type="hidden" name="id" value="{{ selected_variant.id }}">
                  {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
                  <input type="hidden" name="quantity" value="{{ lame_bogo_qty | strip }}">
                  <button
                    type="submit"
                    class="lame-cosmetic-featured__atc"
                    {% unless product.available %}
                      disabled
                    {% endunless %}
                  >
                    {% if product.available %}
                      {{ section.settings.add_to_cart_label }}
                    {% else %}
                      {{ section.settings.sold_out_label }}
                    {% endif %}
                  </button>
                  <span class="lame-cosmetic-featured__atc-status" aria-live="polite"></span>
                </form>
              {% endif %}
            </div>
          </article>
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-cosmetic-featured__item" data-lame-reveal>
            <article class="lame-cosmetic-featured__card">
              <div class="lame-cosmetic-featured__media">
                {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-cosmetic-featured__image placeholder-svg' }}
              </div>
              <div class="lame-cosmetic-featured__body">
                <h3 class="lame-cosmetic-featured__title">{{ section.settings.placeholder_title }}</h3>
                <p class="lame-cosmetic-featured__price">{{ section.settings.placeholder_price }}</p>
                <button type="button" class="lame-cosmetic-featured__atc" disabled>{{ section.settings.add_to_cart_label }}</button>
              </div>
            </article>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>

    {% if trust_blocks.size > 0 %}
      <ul class="lame-cosmetic-featured__trust" role="list">
        {% for block in trust_blocks %}
          <li class="lame-cosmetic-featured__trust-item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 5 }}" {{ block.shopify_attributes }}>
            <span class="lame-cosmetic-featured__trust-icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'leaf' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 21c4-5 6-9 6-13a6 6 0 1 0-12 0c0 4 2 8 6 13Z" stroke="currentColor" stroke-width="1.2"/></svg>
                {% when 'shield' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.2"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                {% when 'heart' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z" stroke="currentColor" stroke-width="1.2"/></svg>
                {% when 'flag' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M5 4v16M5 4h12l-2.5 4L17 12H5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.2"/><path d="M9 12h6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
              {% endcase %}
            </span>
            {% if block.settings.label != blank %}
              <span class="lame-cosmetic-featured__trust-label">{{ block.settings.label }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        const status = form.querySelector('.lame-cosmetic-featured__atc-status');
        if (button?.disabled) return;

        const formData = new FormData(form);
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message || 'Add failed');

          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { resource: cartData, sourceId: '{{ section.id }}', data: { source: 'cosmetic-featured-atc' } },
            })
          );
          if (status) {
            status.textContent = 'Added';
            status.classList.add('is-visible');
            window.setTimeout(() => status.classList.remove('is-visible'), 1600);
          }
        } catch (error) {
          if (status) {
            status.textContent = 'Error';
            status.classList.add('is-visible', 'is-error');
          }
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Cosmetic featured collection",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Handpicked for you." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "placeholder_title", "label": "Placeholder title", "default": "Product title" },
    { "type": "text", "id": "placeholder_price", "label": "Placeholder price", "default": "₹899" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Natural" },
            { "value": "shield", "label": "Tested" },
            { "value": "check", "label": "Free from" },
            { "value": "heart", "label": "Cruelty free" },
            { "value": "flag", "label": "Made in India" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Natural & Safe Ingredients" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cosmetic featured collection",
      "blocks": [
        { "type": "trust", "settings": { "icon": "leaf", "label": "Natural & Safe Ingredients" } },
        { "type": "trust", "settings": { "icon": "shield", "label": "Dermatologically Tested" } },
        { "type": "trust", "settings": { "icon": "check", "label": "Paraben & Sulfate Free" } },
        { "type": "trust", "settings": { "icon": "heart", "label": "Cruelty Free" } },
        { "type": "trust", "settings": { "icon": "flag", "label": "Made in India" } }
      ]
    }
  ]
}
{% endschema %}
