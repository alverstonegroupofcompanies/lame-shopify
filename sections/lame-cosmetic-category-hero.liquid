{%- liquid
  assign hero_heading = section.settings.heading
  assign hero_subtitle = section.settings.subtitle
  assign hero_eyebrow = section.settings.eyebrow
  assign hero_image = section.settings.image
  if collection != blank
    if hero_heading == blank
      assign hero_heading = collection.title
    endif

    if hero_image == blank and collection.image != blank
      assign hero_image = collection.image
    endif

    case collection.handle
      when 'bath-body'
        if hero_subtitle == blank
          assign hero_subtitle = 'Soothing body care rituals for soft, nourished skin from head to toe.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Bath & Body'
        endif
      when 'fragrance'
        if hero_subtitle == blank
          assign hero_subtitle = 'Signature scents crafted to linger beautifully throughout your day.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Fragrance'
        endif
      when 'skin-care'
        if hero_subtitle == blank
          assign hero_subtitle = 'Botanical formulas for radiant, healthy skin — gentle enough for daily use.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Skin Care'
        endif
      when 'make-up'
        if hero_subtitle == blank
          assign hero_subtitle = 'Clean beauty essentials that enhance your natural glow with confidence.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Makeup'
        endif
      when 'baby-mom'
        if hero_subtitle == blank
          assign hero_subtitle = 'Gentle, safe care for moms and little ones — pure ingredients you can trust.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Mom & Baby'
        endif
      when 'wellness'
        if hero_subtitle == blank
          assign hero_subtitle = 'Holistic wellness products to support your everyday self-care routine.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Wellness'
        endif
      when 'hair-care'
        if hero_subtitle == blank
          assign hero_subtitle = 'Plant-powered formulas to nourish, strengthen, and shine — every day, every way.'
        endif
        if hero_eyebrow == blank
          assign hero_eyebrow = 'Hair Care'
        endif
      else
        if hero_subtitle == blank
          assign hero_subtitle = section.settings.default_subtitle
        endif
    endcase
  endif
-%}

{%- liquid
  assign cosmetic_hero_handles = 'bath-body,fragrance,make-up,skin-care,baby-mom,wellness,hair-care' | split: ','
  assign show_category_hero = false
  if collection != blank and cosmetic_hero_handles contains collection.handle
    assign show_category_hero = true
  endif
  if section.settings.heading != blank or section.settings.image != blank
    assign show_category_hero = true
  endif
  if collection.handle == 'frontpage'
    assign show_category_hero = false
  endif
-%}

{%- if show_category_hero and collection != blank -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cosmetic-category-hero lame-cosmetic-category-hero--{{ collection.handle }}"
    {{ section.shopify_attributes }}
  >
    <div class="lame-cosmetic-category-hero__inner spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
      <div class="lame-cosmetic-category-hero__content">
        {%- if hero_eyebrow != blank -%}
          <p class="lame-cosmetic-category-hero__eyebrow">{{ hero_eyebrow }}</p>
        {%- endif -%}
        {%- if hero_heading != blank -%}
          <h1 class="lame-cosmetic-category-hero__heading">{{ hero_heading }}</h1>
        {%- endif -%}
        {%- if hero_subtitle != blank -%}
          <p class="lame-cosmetic-category-hero__subtitle">{{ hero_subtitle }}</p>
        {%- endif -%}
      </div>

      {%- if hero_image != blank -%}
        <div class="lame-cosmetic-category-hero__media">
          {{
            hero_image
            | image_url: width: 1200
            | image_tag:
              class: 'lame-cosmetic-category-hero__image',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '400,600,800,1000,1200',
              sizes: '(min-width: 990px) 42vw, 88vw',
              alt: hero_heading | escape
          }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Cosmetic category hero",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Heading and subtitle auto-fill from the collection. Each category handle gets a tailored subtitle."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional override)" },
    { "type": "text", "id": "heading", "label": "Heading (optional override)" },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle (optional override)"
    },
    {
      "type": "text",
      "id": "default_subtitle",
      "label": "Default subtitle",
      "default": "Explore our curated selection of premium cosmetic essentials."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (optional — uses collection image if empty)"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Cosmetic category hero"
    }
  ]
}
{% endschema %}
