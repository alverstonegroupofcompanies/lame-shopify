<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-luxury-testimonials lame-luxury-glow-root"
  {{ section.shopify_attributes }}
>
  <div class="lame-luxury-testimonials__wrap lame-luxury-glow spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.eyebrow != blank %}
      <p class="lame-luxury-testimonials__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="lame-luxury-testimonials__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="lame-luxury-testimonials__grid">
      {% for block in section.blocks %}
        <blockquote class="lame-luxury-testimonials__card" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 5 }}" {{ block.shopify_attributes }}>
          {% liquid
            assign rating = block.settings.rating | times: 1
            if rating < 1
              assign rating = 5
            endif
            if rating > 5
              assign rating = 5
            endif
          %}
          <div class="lame-luxury-testimonials__stars" aria-hidden="true">
            {% for i in (1..5) %}
              <span class="lame-luxury-testimonials__star{% if i > rating %} lame-luxury-testimonials__star--muted{% endif %}">★</span>
            {% endfor %}
          </div>

          {% if block.settings.quote != blank %}
            <p class="lame-luxury-testimonials__quote">{{ block.settings.quote }}</p>
          {% endif %}

          <footer class="lame-luxury-testimonials__footer">
            {% if block.settings.image != blank %}
              <span class="lame-luxury-testimonials__avatar">
                {{
                  block.settings.image
                  | image_url: width: 120
                  | image_tag:
                    loading: 'lazy',
                    widths: '80,120',
                    sizes: '48px',
                    alt: ''
                }}
              </span>
            {% endif %}
            <span class="lame-luxury-testimonials__byline">
              {% if block.settings.author != blank %}
                <cite class="lame-luxury-testimonials__author">{{ block.settings.author }}</cite>
              {% endif %}
              {% if block.settings.detail != blank %}
                <span class="lame-luxury-testimonials__detail">{{ block.settings.detail }}</span>
              {% endif %}
            </span>
          </footer>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-luxury-testimonials__wrap {
    position: relative;
    padding-inline: var(--page-margin);
  }

  .lame-luxury-testimonials__eyebrow {
    margin: 0 0 0.35rem;
    text-align: center;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb));
  }

  .lame-luxury-testimonials__heading {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.45rem, 3vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-luxury-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
  }

  @media screen and (min-width: 750px) {
    .lame-luxury-testimonials__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-luxury-testimonials__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lame-luxury-testimonials__card {
    margin: 0;
    padding: 1.35rem 1.25rem 1.25rem;
    border-radius: 18px;
    background: rgb(var(--color-background-rgb) / 0.72);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.06);
    box-shadow: 0 18px 42px rgb(0 0 0 / 0.07);
    backdrop-filter: blur(14px);
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lame-luxury-testimonials__card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lame-luxury-testimonials__card[data-lame-delay='1'] {
    transition-delay: 0.06s;
  }
  .lame-luxury-testimonials__card[data-lame-delay='2'] {
    transition-delay: 0.12s;
  }
  .lame-luxury-testimonials__card[data-lame-delay='3'] {
    transition-delay: 0.18s;
  }
  .lame-luxury-testimonials__card[data-lame-delay='4'] {
    transition-delay: 0.24s;
  }

  .lame-luxury-testimonials__stars {
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: rgb(var(--color-primary-rgb));
    margin-bottom: 0.65rem;
  }

  .lame-luxury-testimonials__star--muted {
    opacity: 0.28;
  }

  .lame-luxury-testimonials__quote {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgb(var(--color-foreground-rgb) / 0.88);
  }

  .lame-luxury-testimonials__footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.07);
  }

  .lame-luxury-testimonials__avatar {
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    overflow: hidden;
    background: rgb(245 240 236);
  }

  .lame-luxury-testimonials__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lame-luxury-testimonials__byline {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .lame-luxury-testimonials__author {
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-luxury-testimonials__detail {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.58);
  }
{% endstylesheet %}

