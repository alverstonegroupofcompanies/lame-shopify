              </div>
            </div>

            <div class="lame-editorial-content">
              {%- if section.settings.delivery_tag != blank -%}
                <p class="lame-editorial-eyebrow">
                  <span class="lame-editorial-eyebrow-dot" aria-hidden="true"></span>
                  <span>{{ section.settings.delivery_tag | escape }}</span>
                </p>
              {%- endif -%}

              <h3 class="lame-editorial-heading">{{ section.settings.delivery_heading | escape }}</h3>

              {%- if section.settings.delivery_description != blank -%}
                <div class="lame-editorial-desc rte">
                  {{ section.settings.delivery_description }}
                </div>
              {%- endif -%}

              <div class="lame-editorial-stats">
                <div class="lame-editorial-stat">
                  <span class="lame-editorial-stat-num">
                    <span data-lame-stat-number data-target="{{ stat_1_num }}">0</span><span class="lame-editorial-stat-suffix">{{ section.settings.delivery_stat_1_suffix | default: '+' }}</span>
                  </span>
                  <span class="lame-editorial-stat-label">{{ section.settings.delivery_stat_1_label | default: 'Orders fulfilled' }}</span>
                </div>
                <div class="lame-editorial-stat">
                  <span class="lame-editorial-stat-num">
                    <span data-lame-stat-number data-target="{{ stat_2_num }}">0</span><span class="lame-editorial-stat-suffix">{{ section.settings.delivery_stat_2_suffix | default: '+' }}</span>
                  </span>
                  <span class="lame-editorial-stat-label">{{ section.settings.delivery_stat_2_label | default: 'Products' }}</span>
                </div>
              </div>

              {%- if section.settings.delivery_button_label != blank -%}
                <div class="lame-editorial-actions">
                  <a
                    class="lame-editorial-link"
                    href="{{ section.settings.delivery_button_link | default: routes.all_products_collection_url }}"
                  >
                    <span>{{ section.settings.delivery_button_label | escape }}</span>
                    <span class="lame-editorial-link-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    const root = document.querySelector('[data-lame-delivery-pickup]');
    if (!root) return;

    const animateNumber = (el, target, duration = 1600) => {
      const start = 0;
      const startTime = performance.now();
      const step = (now) => {
        const progress = Math.min((now - startTime) / duration, 1);
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = Math.floor(start + (target - start) * easeOut);
        el.textContent = current.toLocaleString();
        if (progress < 1) {
          requestAnimationFrame(step);
        } else {
          el.textContent = target.toLocaleString();
        }
      };
      requestAnimationFrame(step);
    };

    const statElements = root.querySelectorAll('[data-lame-stat-number]');
    if (!statElements.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            statElements.forEach((el) => {
              const target = parseInt(el.getAttribute('data-target') || '0', 10);
              if (!isNaN(target) && target > 0) {
                animateNumber(el, target);
              }
            });
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    observer.observe(root);
  })();
</script>

