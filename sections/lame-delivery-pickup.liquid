              {%- endif -%}

              <div class="lame-editorial-stats">
                <div class="lame-editorial-stat">
                  <span class="lame-editorial-stat-num">
                    <span data-lame-stat-number data-target="{{ stat_1_num }}">0</span><span class="lame-editorial-stat-suffix">{{ section.settings.delivery_stat_1_suffix | default: '+' }}</span>
                  </span>
                  <span class="lame-editorial-stat-label">{{ section.settings.delivery_stat_1_label | default: 'Orders fulfilled' }}</span>
                </div>
                <div class="lame-editorial-stat">
                  <span class="lame-editorial-stat-num">
                    <span data-lame-stat-number data-target="{{ stat_2_num }}">0</span><span class="lame-editorial-stat-suffix">{{ section.settings.delivery_stat_2_suffix | default: '+' }}</span>
                  </span>
                  <span class="lame-editorial-stat-label">{{ section.settings.delivery_stat_2_label | default: 'Products' }}</span>
                </div>
              </div>

              {%- if section.settings.delivery_button_label != blank -%}
                <div class="lame-editorial-actions">
                  <a
                    class="lame-editorial-link"
                    href="{{ section.settings.delivery_button_link | default: routes.all_products_collection_url }}"
                  >
                    <span>{{ section.settings.delivery_button_label | escape }}</span>
                    <span class="lame-editorial-link-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endif -%}

      {%- if section.settings.pickup_enabled -%}
        <article class="lame-editorial-row lame-editorial-row--pickup lame-editorial-row--reverse">
          <div class="lame-editorial-row__media-col">
