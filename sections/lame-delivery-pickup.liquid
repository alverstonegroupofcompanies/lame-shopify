                <path d="M 180,-40 A 420,420 0 0,0 620,400" stroke="currentColor" stroke-width="1.0" stroke-linecap="round" opacity="0.10"/>
                <path d="M 280,-40 A 320,320 0 0,0 620,300" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" opacity="0.08"/>
              </svg>
            </div>

            <div class="lame-editorial-content">
