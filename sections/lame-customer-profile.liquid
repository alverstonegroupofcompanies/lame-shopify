<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
<script src="{{ 'lame-customer-profile.js' | asset_url }}" defer></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-customer-profile"
  data-lame-customer-profile
  {{ section.shopify_attributes }}
>
  <div class="lame-profile spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% unless customer %}
      <div class="lame-profile__guest">
        <h1 class="lame-profile__page-title">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading }}
          {% else %}
            {{ 'content.account_profile' | t }}
          {% endif %}
        </h1>
        <p>{{ 'lame_customer.login_required' | t }}</p>
        <a href="{{ routes.account_login_url }}" class="button lame-profile__btn-primary">
          {{ 'customer.log_in' | t }}
        </a>
        <p class="lame-profile__hint">
          {{ 'lame_customer.create_account_html' | t: link: routes.account_register_url }}
        </p>
      </div>
    {% else %}
      {%- liquid
        assign profile_page = pages['my-profile']
        assign profile_path = '/pages/my-profile'
        if profile_page != blank
          assign profile_path = profile_page.url
        endif
        assign on_profile_page = false
        if request.path == profile_path
          assign on_profile_page = true
        endif
        if template.name == 'page' and page.handle == 'my-profile'
          assign on_profile_page = true
        endif
        assign avatar_letter = customer.first_name | slice: 0, 1 | upcase
        if avatar_letter == blank
          assign avatar_letter = customer.email | slice: 0, 1 | upcase
        endif
      -%}

      <header class="lame-profile__hero">
        <div class="lame-profile__hero-main">
          <span class="lame-profile__avatar" aria-hidden="true">{{ avatar_letter }}</span>
          <div class="lame-profile__hero-text">
            <p class="lame-profile__eyebrow">{{ shop.name }}</p>
            <h1 class="lame-profile__page-title">
              {% if section.settings.heading != blank %}
                {{ section.settings.heading }}
              {% else %}
                {{ 'content.account_profile' | t }}
              {% endif %}
            </h1>
            <p class="lame-profile__welcome">{{ customer.name }}</p>
          </div>
        </div>
      </header>

      {% if section.settings.show_orders %}
        <nav class="lame-profile__subnav" aria-label="{{ 'lame_customer.account_nav' | t }}">
          <a
            href="{{ routes.account_url }}"
            class="lame-profile__subnav-link{% unless on_profile_page %} lame-profile__subnav-link--current{% endunless %}"
            {% unless on_profile_page %}
              aria-current="page"
            {% endunless %}
          >
            {{ 'customer.orders.title' | t }}
          </a>
          <a
            href="{{ profile_path }}"
            class="lame-profile__subnav-link{% if on_profile_page %} lame-profile__subnav-link--current{% endif %}"
            {% if on_profile_page %}
              aria-current="page"
            {% endif %}
          >
            {{ 'content.account_profile' | t }}
          </a>
        </nav>
      {% endif %}

      <div class="lame-profile__stack">
        {%- comment -%} Account card {%- endcomment -%}
        <section class="lame-profile__card" aria-labelledby="ProfileAccountHeading">
          <h2 id="ProfileAccountHeading" class="visually-hidden">{{ 'lame_customer.account_info' | t }}</h2>

          <div class="lame-profile__card-view" data-profile-view="account">
            <div class="lame-profile__info-row">
              <div class="lame-profile__info-main">
                <span class="lame-profile__info-label">{{ 'lame_customer.name' | t }}</span>
                <span class="lame-profile__info-value">{{ customer.name }}</span>
              </div>
              <button
                type="button"
                class="lame-profile__icon-btn"
                data-edit-toggle
                aria-expanded="false"
                aria-controls="AccountEditForm"
              >
                <span class="visually-hidden">{{ 'customer.addresses.edit' | t }}</span>
                {% render 'icon-edit', class: 'lame-profile__icon' %}
              </button>
            </div>
            <div class="lame-profile__info-row lame-profile__info-row--plain">
              <div class="lame-profile__info-main">
                <span class="lame-profile__info-label">{{ 'customer.login_page.email' | t }}</span>
                <span class="lame-profile__info-value">{{ customer.email }}</span>
              </div>
            </div>
            {% if customer.phone != blank %}
              <div class="lame-profile__info-row lame-profile__info-row--plain">
                <div class="lame-profile__info-main">
                  <span class="lame-profile__info-label">{{ 'customer.addresses.phone' | t }}</span>
                  <span class="lame-profile__info-value">{{ customer.phone }}</span>
                </div>
              </div>
            {% endif %}
          </div>

          <div id="AccountEditForm" class="lame-profile__card-edit" data-profile-edit="account" hidden>
            {%- form 'customer', class: 'lame-profile__form' -%}
              {%- if form.errors -%}
                <div class="lame-profile__message lame-profile__message--error" tabindex="-1" autofocus>
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <div class="lame-profile__message lame-profile__message--success" tabindex="-1" autofocus>
                  {{ 'lame_customer.profile_saved' | t }}
                </div>
              {%- endif -%}

              <div class="lame-profile__field-row">
                <div class="lame-profile__field">
                  <label for="ProfileFirstName">{{ 'customer.addresses.first_name' | t }}</label>
                  <input
                    type="text"
                    id="ProfileFirstName"
                    name="customer[first_name]"
                    value="{{ customer.first_name }}"
                    autocomplete="given-name"
                    class="lame-profile__input"
                  >
                </div>
                <div class="lame-profile__field">
                  <label for="ProfileLastName">{{ 'customer.addresses.last_name' | t }}</label>
                  <input
                    type="text"
                    id="ProfileLastName"
                    name="customer[last_name]"
                    value="{{ customer.last_name }}"
                    autocomplete="family-name"
                    class="lame-profile__input"
                  >
                </div>
              </div>

              <div class="lame-profile__field">
                <label for="ProfileEmail">{{ 'customer.login_page.email' | t }}</label>
                <input
                  type="email"
                  id="ProfileEmail"
                  name="customer[email]"
                  value="{{ customer.email }}"
                  autocomplete="email"
                  class="lame-profile__input"
                >
              </div>

              <div class="lame-profile__field">
                <label for="ProfilePhone">{{ 'customer.addresses.phone' | t }}</label>
                <input
                  type="tel"
                  id="ProfilePhone"
                  name="customer[phone]"
                  value="{{ customer.phone }}"
                  autocomplete="tel"
                  class="lame-profile__input"
                >
              </div>

              <div class="lame-profile__form-actions">
                <button type="submit" class="button lame-profile__btn-primary">
                  {{ 'lame_customer.save_profile' | t }}
                </button>
                <button type="button" class="button button-secondary" data-edit-cancel aria-controls="AccountEditForm">
                  {{ 'customer.addresses.cancel' | t }}
                </button>
              </div>
            {%- endform -%}
          </div>
        </section>

        {%- comment -%} Addresses card {%- endcomment -%}
        <section class="lame-profile__card" aria-labelledby="ProfileAddressesHeading" data-customer-addresses>
          <div class="lame-profile__card-header">
            <h2 id="ProfileAddressesHeading" class="lame-profile__card-title">{{ 'customer.addresses.title' | t }}</h2>
            <button
              type="button"
              class="lame-profile__link-btn"
              data-toggle-address
              aria-expanded="false"
              aria-controls="AddressNewForm"
            >
              {{ 'lame_customer.add' | t }}
            </button>
          </div>

          <p class="lame-profile__card-desc">{{ 'lame_customer.addresses_help' | t }}</p>

          <div id="AddressNewForm" class="lame-profile__card-edit lame-profile__card-edit--inset" hidden>
            <h3 class="lame-profile__card-subtitle">{{ 'customer.addresses.add_new' | t }}</h3>
            {%- form 'customer_address', customer.new_address, class: 'lame-profile__form' -%}
              {% render 'lame-customer-address-fields', form: form, prefix: 'New' %}
              <div class="lame-profile__form-actions">
                <button type="submit" class="button lame-profile__btn-primary">
                  {{ 'customer.addresses.add' | t }}
                </button>
                <button type="reset" class="button button-secondary" data-cancel-address>
                  {{ 'customer.addresses.cancel' | t }}
                </button>
              </div>
            {%- endform -%}
          </div>

          {% if customer.addresses.size > 0 %}
            <ul class="lame-profile__address-list" role="list">
              {%- for address in customer.addresses -%}
                <li class="lame-profile__address-block">
                  <div class="lame-profile__address-block-header">
                    <div>
                      {% if address == customer.default_address %}
                        <p class="lame-profile__address-label">{{ 'lame_customer.default_address' | t }}</p>
                      {% else %}
                        <p class="lame-profile__address-label">{{ 'lame_customer.address' | t }} {{ forloop.index }}</p>
                      {% endif %}
                      <address class="lame-profile__address-display">{{ address | format_address }}</address>
                    </div>
                    <button
                      type="button"
                      class="lame-profile__icon-btn"
                      data-toggle-address
                      aria-expanded="false"
                      aria-controls="EditAddress_{{ address.id }}"
                    >
                      <span class="visually-hidden">{{ 'customer.addresses.edit' | t }}</span>
                      {% render 'icon-edit', class: 'lame-profile__icon' %}
                    </button>
                  </div>

                  <div
                    id="EditAddress_{{ address.id }}"
                    class="lame-profile__card-edit lame-profile__card-edit--inset"
                    hidden
                  >
                    <h3 class="lame-profile__card-subtitle">{{ 'customer.addresses.edit_address' | t }}</h3>
                    {%- form 'customer_address', address, class: 'lame-profile__form' -%}
                      {% render 'lame-customer-address-fields', form: form, prefix: address.id %}
                      <div class="lame-profile__form-actions">
                        <button type="submit" class="button lame-profile__btn-primary">
                          {{ 'customer.addresses.update' | t }}
                        </button>
                        <button type="reset" class="button button-secondary" data-cancel-address>
                          {{ 'customer.addresses.cancel' | t }}
                        </button>
                        {% unless address == customer.default_address and customer.addresses_count == 1 %}
                          <button
                            type="button"
                            class="lame-profile__link-btn lame-profile__link-btn--danger"
                            data-delete-address
                            data-target="{{ address.url }}"
                            data-confirm-message="{{ 'customer.addresses.delete_confirm' | t }}"
                          >
                            {{ 'customer.addresses.delete' | t }}
                          </button>
                        {% endunless %}
                      </div>
                    {%- endform -%}
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          {% else %}
            <p class="lame-profile__empty">{{ 'lame_customer.no_addresses' | t }}</p>
          {% endif %}
        </section>

        {%- comment -%} Bank details card {%- endcomment -%}
        {% if section.settings.show_bank %}
          {% liquid
            assign bank_holder = customer.metafields.lame.account_holder.value | default: customer.metafields.lame.account_holder
            assign bank_name = customer.metafields.lame.bank_name.value | default: customer.metafields.lame.bank_name
            assign bank_account = customer.metafields.lame.account_number.value | default: customer.metafields.lame.account_number
            assign bank_routing = customer.metafields.lame.routing_number.value | default: customer.metafields.lame.routing_number
            assign bank_iban = customer.metafields.lame.iban.value | default: customer.metafields.lame.iban
            assign has_saved_bank = false
            if bank_holder != blank or bank_name != blank or bank_account != blank or bank_iban != blank
              assign has_saved_bank = true
            endif
          %}

          <section class="lame-profile__card" aria-labelledby="ProfileBankHeading">
            <div class="lame-profile__card-header">
              <h2 id="ProfileBankHeading" class="lame-profile__card-title">{{ 'lame_customer.tab_bank' | t }}</h2>
              <button
                type="button"
                class="lame-profile__link-btn"
                data-edit-toggle
                aria-expanded="false"
                aria-controls="BankEditForm"
              >
                {% if has_saved_bank %}
                  {{ 'customer.addresses.edit' | t }}
                {% else %}
                  {{ 'lame_customer.add' | t }}
                {% endif %}
              </button>
            </div>

            <div class="lame-profile__card-view" data-profile-view="bank">
              {% if has_saved_bank %}
                <dl class="lame-profile__bank-summary">
                  {% if bank_holder != blank %}
                    <div>
                      <dt>{{ 'lame_customer.bank_holder' | t }}</dt>
                      <dd>{{ bank_holder }}</dd>
                    </div>
                  {% endif %}
                  {% if bank_name != blank %}
                    <div>
                      <dt>{{ 'lame_customer.bank_name' | t }}</dt>
                      <dd>{{ bank_name }}</dd>
                    </div>
                  {% endif %}
                  {% if bank_account != blank %}
                    <div>
                      <dt>{{ 'lame_customer.bank_account' | t }}</dt>
                      <dd>
                        {%- if bank_account.size > 8 -%}
                          {{ bank_account | slice: 0, 4 }}••••{{ bank_account | slice: -4, 4 }}
                        {%- else -%}
                          ••••
                        {%- endif -%}
                      </dd>
                    </div>
                  {% endif %}
                  {% if bank_routing != blank %}
                    <div>
                      <dt>{{ 'lame_customer.bank_routing' | t }}</dt>
                      <dd>{{ bank_routing }}</dd>
                    </div>
                  {% endif %}
                  {% if bank_iban != blank %}
                    <div>
                      <dt>{{ 'lame_customer.bank_iban' | t }}</dt>
                      <dd>
                        {%- if bank_iban.size > 8 -%}
                          {{ bank_iban | slice: 0, 4 }}••••{{ bank_iban | slice: -4, 4 }}
                        {%- else -%}
                          ••••
                        {%- endif -%}
                      </dd>
                    </div>
                  {% endif %}
                </dl>
              {% else %}
                <p class="lame-profile__empty">{{ 'lame_customer.bank_empty' | t }}</p>
              {% endif %}
            </div>

            <div id="BankEditForm" class="lame-profile__card-edit" data-profile-edit="bank" hidden>
              <p class="lame-profile__card-desc">{{ 'lame_customer.bank_help' | t }}</p>

              {%- assign bank_form_id = 'BankForm-' | append: section.id -%}
              {%- form 'contact', id: bank_form_id, class: 'lame-profile__form lame-profile__form--bank' -%}
                <input type="hidden" name="contact[id]" value="{{ bank_form_id }}">
                <input type="hidden" name="contact[email]" value="{{ customer.email }}">
                <input type="hidden" name="contact[name]" value="{{ customer.name }}">
                <textarea name="contact[body]" data-bank-body hidden></textarea>

                {%- if form.posted_successfully? and form.id == bank_form_id -%}
                  <div class="lame-profile__message lame-profile__message--success" tabindex="-1" autofocus>
                    {{ 'lame_customer.bank_saved' | t }}
                  </div>
                {%- endif -%}

                {%- if form.errors and form.id == bank_form_id -%}
                  <div class="lame-profile__message lame-profile__message--error">
                    {{ form.errors | default_errors }}
                  </div>
                {%- endif -%}

                <div class="lame-profile__field">
                  <label for="BankHolder">{{ 'lame_customer.bank_holder' | t }}</label>
                  <input
                    type="text"
                    id="BankHolder"
                    class="lame-profile__input"
                    data-bank-field="Account holder"
                    value="{{ bank_holder }}"
                    autocomplete="name"
                  >
                </div>
                <div class="lame-profile__field">
                  <label for="BankName">{{ 'lame_customer.bank_name' | t }}</label>
                  <input
                    type="text"
                    id="BankName"
                    class="lame-profile__input"
                    data-bank-field="Bank name"
                    value="{{ bank_name }}"
                    autocomplete="organization"
                  >
                </div>
                <div class="lame-profile__field-row">
                  <div class="lame-profile__field">
                    <label for="BankAccount">{{ 'lame_customer.bank_account' | t }}</label>
                    <input
                      type="text"
                      id="BankAccount"
                      class="lame-profile__input"
                      data-bank-field="Account number"
                      inputmode="numeric"
                      autocomplete="off"
                    >
                  </div>
                  <div class="lame-profile__field">
                    <label for="BankRouting">{{ 'lame_customer.bank_routing' | t }}</label>
                    <input
                      type="text"
                      id="BankRouting"
                      class="lame-profile__input"
                      data-bank-field="Routing / sort code"
                      value="{{ bank_routing }}"
                      autocomplete="off"
                    >
                  </div>
                </div>
                <div class="lame-profile__field">
                  <label for="BankIban">{{ 'lame_customer.bank_iban' | t }}</label>
                  <input
                    type="text"
                    id="BankIban"
                    class="lame-profile__input"
                    data-bank-field="IBAN"
                    value="{{ bank_iban }}"
                    autocomplete="off"
                  >
                </div>

                <div class="lame-profile__form-actions">
                  <button type="submit" class="button lame-profile__btn-primary">
                    {{ 'lame_customer.save_bank' | t }}
                  </button>
                  <button type="button" class="button button-secondary" data-edit-cancel aria-controls="BankEditForm">
                    {{ 'customer.addresses.cancel' | t }}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </section>
        {% endif %}
      </div>

      <footer class="lame-profile__footer">
        <a href="{{ routes.account_logout_url }}" class="button button-secondary lame-profile__sign-out">
          {{ 'customer.log_out' | t }}
        </a>
      </footer>
    {% endunless %}
  </div>
</section>

{% stylesheet %}
  .lame-customer-profile {
    --lame-profile-max: 52rem;
    background: linear-gradient(180deg, rgb(var(--brand-cream) / 0.5) 0%, transparent 12rem);
  }

  .lame-profile {
    max-width: var(--lame-profile-max);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .lame-profile__hero {
    margin-bottom: 1.5rem;
    padding: 1.35rem 1.5rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgb(47 79 58 / 0.96), rgb(40 68 50 / 0.98));
    border: 1px solid rgb(var(--brand-gold) / 0.25);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.12);
    color: #fff;
  }

  .lame-profile__hero-main {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .lame-profile__avatar {
    flex-shrink: 0;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    background: rgb(var(--brand-gold) / 0.2);
    border: 2px solid rgb(var(--brand-gold) / 0.55);
    color: #fff;
  }

  .lame-profile__eyebrow {
    margin: 0 0 0.2rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .lame-profile__page-title {
    font-family: var(--lame-font-display, inherit);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .lame-profile__welcome {
    margin: 0.35rem 0 0;
    font-size: 0.92rem;
    opacity: 0.88;
    font-weight: 500;
  }

  .lame-profile__subnav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    margin: 0 0 1.5rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: rgb(var(--brand-gold) / 0.08);
    border: 1px solid rgb(var(--brand-gold) / 0.22);
    width: fit-content;
    max-width: 100%;
  }

  .lame-profile__subnav-link {
    font-family: var(--lame-font-menu, inherit);
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(var(--brand-gold-strong));
    opacity: 0.65;
    padding: 0.2rem 0.1rem;
    transition: opacity 0.2s ease, color 0.2s ease;
  }

  .lame-profile__subnav-link:hover {
    opacity: 1;
    color: rgb(var(--brand-ink));
  }

  .lame-profile__subnav-link--current {
    opacity: 1;
    color: rgb(var(--brand-ink));
    box-shadow: inset 0 -2px 0 rgb(var(--brand-gold-strong));
  }

  .lame-profile__stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lame-profile__card {
    background: rgb(var(--color-background-rgb, 255 255 255));
    border: 1px solid rgb(var(--brand-gold) / 0.2);
    border-radius: 14px;
    padding: 1.35rem 1.5rem;
    box-shadow: var(--lame-shadow-soft, 0 8px 24px rgb(0 0 0 / 0.06));
    border-inline-start: 3px solid rgb(var(--brand-gold-strong));
  }

  .lame-profile__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.35rem;
  }

  .lame-profile__card-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }

  .lame-profile__card-subtitle {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .lame-profile__card-desc {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    line-height: 1.45;
    opacity: 0.72;
  }

  .lame-profile__info-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-profile__info-row:first-child {
    padding-top: 0;
  }

  .lame-profile__info-row--plain {
    padding-inline-end: 2.5rem;
  }

  .lame-profile__info-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .lame-profile__info-label {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0.6;
    margin-bottom: 0.2rem;
  }

  .lame-profile__info-value {
    font-size: 0.98rem;
    font-weight: 500;
    word-break: break-word;
  }

  .lame-profile__icon-btn {
    flex-shrink: 0;
    appearance: none;
    background: rgb(var(--brand-gold) / 0.1);
    border: 1px solid rgb(var(--brand-gold) / 0.28);
    border-radius: 8px;
    padding: 0.4rem;
    cursor: pointer;
    color: rgb(var(--brand-gold-strong));
    line-height: 0;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .lame-profile__icon-btn:hover {
    background: rgb(var(--brand-gold) / 0.18);
    transform: translateY(-1px);
  }

  .lame-profile__icon {
    width: 1.1rem;
    height: 1.1rem;
  }

  .lame-profile__link-btn {
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--brand-gold-strong));
    cursor: pointer;
    text-decoration: none;
  }

  .lame-profile__link-btn:hover {
    text-decoration: underline;
  }

  .lame-profile__link-btn--danger {
    color: #a32;
    margin-inline-start: auto;
  }

  .lame-profile__card-edit {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-profile__card-edit--inset {
    margin-top: 0.75rem;
    padding: 1rem;
    background: rgb(0 0 0 / 0.02);
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 8px;
  }

  .lame-profile__card-edit[hidden],
  .lame-profile__card-edit--inset[hidden],
  [data-profile-view][hidden] {
    display: none !important;
  }

  .lame-profile__address-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .lame-profile__address-block {
    padding: 1rem 0;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-profile__address-block:first-child {
    border-top: none;
    padding-top: 0.25rem;
  }

  .lame-profile__address-block-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .lame-profile__address-label {
    margin: 0 0 0.35rem;
    font-size: 0.82rem;
    font-weight: 600;
    opacity: 0.65;
  }

  .lame-profile__address-display {
    font-style: normal;
    line-height: 1.5;
    font-size: 0.95rem;
    margin: 0;
  }

  .lame-profile__bank-summary {
    margin: 0.5rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .lame-profile__bank-summary dt {
    font-size: 0.75rem;
    font-weight: 600;
    opacity: 0.6;
    margin-bottom: 0.1rem;
  }

  .lame-profile__bank-summary dd {
    margin: 0;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .lame-profile__empty {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    opacity: 0.65;
  }

  .lame-profile__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lame-profile__field-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media screen and (min-width: 600px) {
    .lame-profile__field-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .lame-profile__field label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
  }

  .lame-profile__input,
  .lame-profile__select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border-radius: var(--style-border-radius-inputs, 6px);
    border: 1px solid var(--color-input-border, rgb(0 0 0 / 0.2));
    background: var(--color-input-background, #fff);
    color: var(--color-input-text, inherit);
    font: inherit;
    font-size: 0.95rem;
  }

  .lame-profile__checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .lame-profile__form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .lame-profile__btn-primary {
    background: linear-gradient(135deg, rgb(var(--brand-gold)), rgb(var(--brand-gold-strong)));
    border-color: rgb(var(--brand-gold));
    color: #111;
    font-weight: 600;
  }

  .lame-profile__message {
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-size: 0.88rem;
    margin-top: 0.75rem;
  }

  .lame-profile__message--success {
    background: rgb(34 120 60 / 0.1);
    border: 1px solid rgb(34 120 60 / 0.3);
  }

  .lame-profile__message--error {
    background: rgb(180 40 40 / 0.08);
    border: 1px solid rgb(180 40 40 / 0.3);
  }

  .lame-profile__footer {
    margin-top: 1.5rem;
    padding-top: 0.5rem;
  }

  .lame-profile__sign-out {
    min-width: 8rem;
  }

  .lame-profile__guest {
    text-align: center;
    padding: 3rem 1rem;
  }

  .lame-profile__hint {
    margin-top: 1rem;
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .lame-profile__hint a {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer profile",
  "tag": "section",
  "class": "lame-customer-profile-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Branded profile on your store (not Shopify’s default account screen). Create a page with the “my-profile” template, then in Header settings enable “Use custom profile page” and select that page. The built-in Shopify Profile tab cannot be themed—customers should open this page from your store menu/account icon."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "info": "Leave blank to show \"Profile\"."
    },
    {
      "type": "checkbox",
      "id": "show_orders",
      "label": "Show Orders link above profile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bank",
      "label": "Show bank details card",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Customer profile"
    }
  ]
}
{% endschema %}
