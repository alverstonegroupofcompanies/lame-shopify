{{ 'lame-customer-account.css' | asset_url | stylesheet_tag }}
{{ 'lame-customer-profile-layout.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lame-customer-order-tracking.js' | asset_url }}" defer></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-customer-tracking-page"
  data-lame-order-tracking
  {{ section.shopify_attributes }}
>
  {%- capture lame_profile_url -%}{%- render 'lame-customer-profile-url', section: section -%}{%- endcapture -%}
  {%- capture lame_orders_url -%}{%- render 'lame-customer-orders-url', section: section -%}{%- endcapture -%}
  {%- capture lame_login_url -%}{%- render 'lame-customer-auth-url', type: 'login' -%}{%- endcapture -%}
  {%- capture lame_register_url -%}{%- render 'lame-customer-auth-url', type: 'register' -%}{%- endcapture -%}
  {%- liquid
    assign back_url = lame_orders_url
    if section.settings.back_page == 'profile'
      assign back_url = lame_profile_url
    endif

    assign page_heading = section.settings.heading
    if page_heading == blank
      assign page_heading = 'lame_customer.tracking_page_title' | t
    endif
  -%}

  <div class="lame-acct-page spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% unless customer %}
      <div class="lame-profile__guest lame-acct-card lame-tracking-guest">
        <span class="lame-profile__empty-icon" aria-hidden="true">
          {% render 'lame-account-icon', size: 36, class: '' %}
        </span>
        <h1 class="lame-profile__page-title">{{ page_heading }}</h1>
        <p>{{ 'lame_customer.tracking_login_required' | t }}</p>
        <a
          href="{{ lame_login_url }}"
          class="button lame-profile__btn-primary"
          data-tracking-login
        >
          {{ 'customer.log_in' | t }}
        </a>
        <p class="lame-profile__hint">
          {{ 'lame_customer.create_account_html' | t: link: lame_register_url }}
        </p>
      </div>
    {% else %}
      <div class="lame-acct-layout lame-acct-layout--tracking">
        {% if section.settings.show_sidebar %}
          {% render 'lame-profile-sidebar',
            section: section,
            profile_url: lame_profile_url,
            orders_url: lame_orders_url,
            active_nav: 'orders',
            show_wishlist: section.settings.show_wishlist
          %}
        {% endif %}

        <div class="lame-acct-main lame-tracking-main">
          <header class="lame-acct-card lame-tracking-page-head lame-profile__panel">
            <a href="{{ back_url }}" class="lame-order-detail__back">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m15 6-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>{{ section.settings.back_label | default: 'lame_customer.back_to_orders' | t }}</span>
            </a>
            <h1 class="lame-tracking-page-head__title">{{ page_heading }}</h1>
            {% if section.settings.subheading != blank %}
              <p class="lame-tracking-page-head__desc">{{ section.settings.subheading }}</p>
            {% else %}
              <p class="lame-tracking-page-head__desc">{{ 'lame_customer.tracking_page_desc' | t }}</p>
            {% endif %}
          </header>

          <div class="lame-tracking-page__picker lame-acct-card" data-order-tracking-picker>
            <h2 class="lame-acct-card__title">{{ 'lame_customer.tracking_pick_order' | t }}</h2>
            <p class="lame-tracking-page-head__desc">{{ 'lame_customer.tracking_pick_order_desc' | t }}</p>
            {% if customer.orders.size > 0 %}
              <ul class="lame-acct-order-list lame-tracking-page__picker-list" role="list">
                {%- for order in customer.orders limit: 12 -%}
                  {%- capture order_track_url -%}
                    {%- render 'lame-customer-order-detail-url', order: order, base_url: request.path -%}
                  {%- endcapture -%}
                  <li class="lame-acct-order-row">
                    <div class="lame-acct-order-row__main">
                      <p class="lame-acct-order-row__number">{{ 'lame_customer.order_number' | t: number: order.name }}</p>
                      <time class="lame-acct-order-row__date" datetime="{{ order.created_at | date: '%Y-%m-%d' }}">
                        {{ order.created_at | time_tag: format: 'date' }}
                      </time>
                    </div>
                    <a href="{{ order_track_url }}" class="lame-acct-order-row__cta">
                      <span>{{ 'lame_customer.track_order' | t }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
              <a href="{{ lame_orders_url }}" class="lame-acct-card__action-link lame-tracking-page__picker-all">
                {{ 'lame_customer.view_all_orders' | t }}
              </a>
            {% else %}
              <div class="lame-profile__empty-state">
                <p class="lame-profile__empty-title">{{ 'lame_customer.orders_empty_title' | t }}</p>
                <p class="lame-profile__empty-desc">{{ 'lame_customer.orders_empty' | t }}</p>
                <a href="{{ routes.all_products_collection_url }}" class="button lame-profile__btn-primary">
                  {{ 'lame_customer.shop_now' | t }}
                </a>
              </div>
            {% endif %}
          </div>

          <div class="lame-tracking-page__empty lame-acct-card" data-order-tracking-empty hidden>
            <p class="lame-profile__empty-title">{{ 'lame_customer.tracking_order_not_found' | t }}</p>
            <p class="lame-profile__empty-desc">{{ 'lame_customer.tracking_order_not_found_desc' | t }}</p>
            <a href="{{ lame_orders_url }}" class="button lame-profile__btn-primary">
              {{ 'lame_customer.view_all_orders' | t }}
            </a>
          </div>

          {%- for order in customer.orders -%}
            <article
              class="lame-tracking-page__order lame-acct-card"
              data-order-tracking
              data-order-id="{{ order.id }}"
              hidden
            >
              {% render 'lame-customer-order-detail',
                order: order,
                orders_url: back_url,
                standalone: true
              %}
            </article>
          {%- endfor -%}
        </div>
      </div>

      {% if section.settings.show_trust_bar %}
        {% render 'lame-profile-trust-bar' %}
      {% endif %}
    {% endunless %}
  </div>
</section>

{% schema %}
{
  "name": "Order tracking",
  "tag": "section",
  "class": "lame-customer-order-tracking-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Dedicated order tracking page. Create a page with handle “track-order” and assign template “track-order” (not the default page template). Links use /pages/track-order?order=ORDER_ID."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Track your order"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow your shipment status and order details in one place."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back link label",
      "default": "Back to orders"
    },
    {
      "type": "select",
      "id": "back_page",
      "label": "Back link destination",
      "options": [
        { "value": "orders", "label": "Orders page (my-orders)" },
        { "value": "profile", "label": "Profile page (my-profile)" }
      ],
      "default": "orders"
    },
    {
      "type": "page",
      "id": "tracking_page",
      "label": "Tracking page override (optional)",
      "info": "Leave empty to use the page with handle “track-order”."
    },
    {
      "type": "checkbox",
      "id": "show_sidebar",
      "label": "Show account sidebar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist in sidebar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Order tracking"
    }
  ]
}
{% endschema %}
