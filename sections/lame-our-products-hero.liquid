{%- liquid
  assign badge_blocks = section.blocks | where: 'type', 'trust_badge'
  assign heading = section.settings.heading
  if heading == blank and collection != blank
    assign heading = collection.title
  endif
  if heading == blank
    assign heading = 'Our Premium Collection'
  endif

  assign decor_left = section.settings.decor_image_left
  assign decor_right = section.settings.decor_image_right
  assign hero_image = section.settings.hero_image
-%}

{{ 'lame-our-products-hero.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="lame-our-products-hero section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-our-products-hero__frame">
    {% if hero_image != blank %}
      <div class="lame-our-products-hero__banner" aria-hidden="true">
        {{
          hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'lame-our-products-hero__banner-image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 990, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: ''
        }}
        <div class="lame-our-products-hero__banner-scrim"></div>
      </div>
    {% endif %}

    {% if decor_left != blank %}
      <div class="lame-our-products-hero__decor lame-our-products-hero__decor--left" aria-hidden="true">
        {{
          decor_left
          | image_url: width: 600
          | image_tag:
            class: 'lame-our-products-hero__decor-image',
            loading: 'lazy',
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 990px) 280px, 180px',
            alt: ''
        }}
      </div>
    {% else %}
      <div class="lame-our-products-hero__decor lame-our-products-hero__decor--left" aria-hidden="true">
        <img
          class="lame-our-products-hero__decor-image"
          src="{{ 'lame-hero-leaf-left.svg' | asset_url }}"
          width="280"
          height="340"
          loading="lazy"
          alt=""
        >
      </div>
    {% endif %}

    {% if decor_right != blank %}
      <div class="lame-our-products-hero__decor lame-our-products-hero__decor--right lame-our-products-hero__decor--ring" aria-hidden="true">
        {{
          decor_right
          | image_url: width: 600
          | image_tag:
            class: 'lame-our-products-hero__decor-image',
            loading: 'lazy',
            widths: '200, 300, 400, 600',
            sizes: '(min-width: 990px) 280px, 180px',
            alt: ''
        }}
      </div>
    {% else %}
      <div class="lame-our-products-hero__decor lame-our-products-hero__decor--right lame-our-products-hero__decor--ring" aria-hidden="true">
        <img
          class="lame-our-products-hero__decor-image"
          src="{{ 'lame-hero-leaf-right.svg' | asset_url }}"
          width="280"
          height="340"
          loading="lazy"
          alt=""
        >
      </div>
    {% endif %}

    <div class="lame-our-products-hero__content lame-our-products-hero__content--{{ section.settings.content_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="lame-our-products-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h1 class="lame-our-products-hero__heading">{{ heading | escape }}</h1>

      {% if section.settings.subtitle != blank %}
        <p class="lame-our-products-hero__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>

    {% if badge_blocks.size > 0 %}
      <ul class="lame-our-products-hero__badges" role="list">
        {%- for block in badge_blocks -%}
          <li class="lame-our-products-hero__badge" {{ block.shopify_attributes }}>
            <span class="lame-our-products-hero__badge-icon" aria-hidden="true">
              {% render 'lame-our-products-hero-icon', icon: block.settings.icon %}
            </span>
            {% if block.settings.label != blank %}
              <span class="lame-our-products-hero__badge-label">{{ block.settings.label | escape }}</span>
            {% endif %}
          </li>
        {%- endfor -%}
      </ul>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Our Products hero",
  "tag": "section",
  "class": "section-wrapper lame-our-products-hero-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Hero banner for the Our Products collection template. Appears below the site header. Upload decorative leaf images and an optional full-width background image."
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Background image (optional)",
      "info": "Full-width image behind the hero content. Leave empty for cream background only."
    },
    {
      "type": "image_picker",
      "id": "decor_image_left",
      "label": "Left decorative image",
      "info": "Watercolor leaf or botanical graphic (recommended ~400 × 500 px)."
    },
    {
      "type": "image_picker",
      "id": "decor_image_right",
      "label": "Right decorative image",
      "info": "Watercolor leaf or botanical graphic (recommended ~400 × 500 px)."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "DISCOVER CARE, DELIVERING WELLNESS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Healthcare Essentials for Everyday Wellness",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted products from leading brands curated for your family."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "badge", "label": "Verified badge" },
            { "value": "leaf", "label": "Leaf / natural" },
            { "value": "shield", "label": "Shield / tested" },
            { "value": "users", "label": "People / trusted" },
            { "value": "card", "label": "Secure payment" },
            { "value": "heart", "label": "Heart" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "badge"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "100% Original Products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Products hero",
      "category": "Collection",
      "blocks": [
        { "type": "trust_badge", "settings": { "icon": "badge", "label": "100% Original Products" } },
        { "type": "trust_badge", "settings": { "icon": "leaf", "label": "Dermatologically Tested" } },
        { "type": "trust_badge", "settings": { "icon": "users", "label": "Trusted by Thousands" } },
        { "type": "trust_badge", "settings": { "icon": "card", "label": "Secure Payments" } }
      ]
    }
  ]
}
{% endschema %}
