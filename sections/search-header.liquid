{{ 'lame-search-page.css' | asset_url | stylesheet_tag }}

<style>
  .lame-search-path {
    width: 100%;
    margin-block-end: 14px;
  }
  .lame-search-path__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: #8a9390;
  }
  .lame-search-path__item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lame-search-path__item:not(:last-child)::after {
    content: "/";
    display: inline-block;
    margin-inline-start: 8px;
    color: #b0b8b4;
    font-size: 0.72rem;
    line-height: 1;
    pointer-events: none;
  }
  .lame-search-path__item a {
    color: #5c6b62;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .lame-search-path__item a:hover {
    color: #154230;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .lame-search-path__item--current,
  .lame-search-path__item--current span {
    color: #242b27;
    font-weight: 600;
  }
  .lame-search-path__term {
    display: inline-block;
    vertical-align: bottom;
    max-width: clamp(140px, 45vw, 320px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .lame-search-hero {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    padding-block: 1rem 0;
    text-align: center;
    box-sizing: border-box;
  }
  .lame-search-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    gap: 0;
  }
  .lame-search-hero .text-block,
  .lame-search-hero .text-block > *,
  .lame-search-hero h1,
  .lame-search-hero h2,
  .lame-search-hero h3 {
    margin: 0 auto 12px auto !important;
    width: 100%;
    max-width: 640px;
    text-align: center !important;
  }
  .lame-search-header__meta {
    margin: 0 auto 16px auto !important;
    width: 100%;
    max-width: 640px;
    text-align: center !important;
  }
  .lame-search-hero__bar {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    margin-block-end: 24px;
    box-sizing: border-box;
  }
  @media screen and (max-width: 749px) {
    .lame-search-hero__bar {
      margin-block-end: 16px;
    }
  }
  .lame-search-hero .search-page-input__parent,
  .search-page-input__parent {
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    box-sizing: border-box;
  }
  .lame-search-hero search-page-input-component,
  search-page-input-component {
    position: relative;
    display: flex;
    align-items: center;
    align-self: stretch;
    width: 100%;
    max-width: 640px;
    margin-inline: auto;
    margin-block: 0;
    --size-style-width: 640px;
    box-sizing: border-box;
  }
  .lame-search-hero .search-page-input,
  .search-page-input {
    flex: 1 1 100%;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }
  .lame-search-hero search-page-input-component .search__reset-button {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    right: 0.75rem !important;
    width: 32px !important;
    height: 32px !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
    border-radius: 999px !important;
    box-sizing: border-box !important;
    cursor: pointer;
    text-decoration: none;
  }
  .lame-search-hero search-page-input-component .search__reset-button:active {
    transform: translateY(-50%) scale(0.92) !important;
  }
  .lame-search-hero search-page-input-component .search__reset-button-icon {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 14px !important;
    height: 14px !important;
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1 !important;
  }
  .lame-search-hero search-page-input-component .search__reset-button-icon svg {
    display: block !important;
    width: 14px !important;
    height: 14px !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .lame-search-hero search-page-input-component .search__reset-button-text {
    display: none !important;
  }
</style>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }} lame-search-header">
  <div
    class="spacing-style search-page__header lame-search-hero"
    style="
      width: 100%;
      --horizontal-alignment: center;
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    <div class="lame-search-hero__copy">
      <nav class="lame-search-path" aria-label="Breadcrumb">
        <ol class="lame-search-path__list">
          <li class="lame-search-path__item">
            <a href="{{ routes.root_url }}">{{ 'lame_product.breadcrumb_home' | t | default: 'Home' }}</a>
          </li>
          {%- if search.performed and search.terms != blank -%}
            <li class="lame-search-path__item">
              <a href="{{ routes.search_url }}">{{ 'content.search' | t | default: 'Search' }}</a>
            </li>
            <li class="lame-search-path__item lame-search-path__item--current" aria-current="page">
              <span class="lame-search-path__term" title="{{ search.terms | escape }}">{{ search.terms | escape }}</span>
            </li>
          {%- else -%}
            <li class="lame-search-path__item lame-search-path__item--current" aria-current="page">
              <span class="lame-search-path__term">{{ 'content.search' | t | default: 'Search' }}</span>
            </li>
          {%- endif -%}
        </ol>
      </nav>

      {% assign heading_text = 'content.search' | t %}

      {% if search.performed %}
        {% assign heading_text = 'content.search_results' | t %}
      {% endif %}

      {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}

      {% if search.performed %}
        <p class="lame-search-header__meta">
          {% if search.results_count > 0 %}
            <span class="lame-search-header__count">{{ search.results_count }}</span>
            {% if search.terms != blank %}
              results for <span class="lame-search-header__term">“{{ search.terms | escape }}”</span>
            {% else %}
              results
            {% endif %}
          {% else %}
            No products found{% if search.terms != blank %} for <span class="lame-search-header__term">“{{ search.terms | escape }}”</span>{% endif %}
          {% endif %}
        </p>
      {% else %}
        <p class="lame-search-header__meta">Find products, brands, and beauty essentials</p>
      {% endif %}
    </div>

    <div class="lame-search-hero__bar">
      {% content_for 'block', id: 'search', type: '_search-input' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
