{{ 'lame-store-stats.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enabled -%}
  {%- liquid
    assign live_products = shop.products_count | default: 0
    assign live_brands = shop.vendors.size | default: 0
    assign live_orders_placed = 0
    assign live_orders_delivered = 0

    if shop.metafields.custom.orders_placed.value != blank
      assign live_orders_placed = shop.metafields.custom.orders_placed.value | times: 1
    elsif shop.metafields.custom.orders_count.value != blank
      assign live_orders_placed = shop.metafields.custom.orders_count.value | times: 1
    endif

    if shop.metafields.custom.orders_delivered.value != blank
      assign live_orders_delivered = shop.metafields.custom.orders_delivered.value | times: 1
    elsif shop.metafields.custom.orders_fulfilled.value != blank
      assign live_orders_delivered = shop.metafields.custom.orders_fulfilled.value | times: 1
    endif

    assign stat_count = 0
    for block in section.blocks
      assign stat_count = stat_count | plus: 1
    endfor
  -%}

  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-store-stats"
    style="{% render 'spacing-padding', settings: section.settings %}"
    data-lame-store-stats
    {{ section.shopify_attributes }}
  >
    <div class="lame-store-stats__wrap spacing-style">
      <div class="lame-store-stats__layout lame-store-stats__layout--{{ section.settings.image_position | default: 'image-left' }}">
        <div class="lame-store-stats__media">
          {%- liquid
            assign stats_image_alt = section.settings.image_alt | default: 'MyLamstone delivery'
          -%}
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                class: 'lame-store-stats__image',
                loading: 'lazy',
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: stats_image_alt
            }}
          {%- else -%}
            <img
              class="lame-store-stats__image"
              src="{{ 'lame-store-stats-delivery.png' | asset_url }}"
              alt="{{ stats_image_alt | escape }}"
              width="1200"
              height="900"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <div class="lame-store-stats__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="lame-store-stats__badge">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading_brand != blank or section.settings.heading_italic != blank or section.settings.heading_after != blank or section.settings.heading != blank -%}
            <h2 class="lame-store-stats__heading">
              {%- if section.settings.heading_brand != blank -%}
                <span>{{ section.settings.heading_brand | escape }}</span>{{ ' ' }}
              {%- endif -%}
              {%- if section.settings.heading_italic != blank -%}
                <em>{{ section.settings.heading_italic | escape }}</em>{{ ' ' }}
              {%- endif -%}
              {%- if section.settings.heading_after != blank -%}
                <span>{{ section.settings.heading_after | escape }}</span>
              {%- endif -%}
              {%- if section.settings.heading_brand == blank and section.settings.heading_italic == blank and section.settings.heading != blank -%}
                {{ section.settings.heading | escape }}
              {%- endif -%}
            </h2>
          {%- endif -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="lame-store-stats__grid lame-store-stats__grid--{{ stat_count }}" role="list">
              {%- for block in section.blocks -%}
                {%- liquid
                  assign stat_value = block.settings.number | strip
                  assign stat_numeric = 0

                  case block.settings.source
                    when 'products'
                      assign stat_numeric = live_products
                    when 'brands'
                      assign stat_numeric = live_brands
                    when 'orders_placed'
                      assign stat_numeric = live_orders_placed
                    when 'orders_delivered'
                      assign stat_numeric = live_orders_delivered
                    else
                      assign stat_numeric = block.settings.number | times: 1
                  endcase

                  if block.settings.use_custom_number and block.settings.number != blank
                    assign stat_numeric = block.settings.number | times: 1
                  endif

                  if stat_numeric == blank or stat_numeric == 0
                    if stat_value != blank
                      assign stat_numeric = stat_value | times: 1
                    endif
                  endif
                -%}
                <li class="lame-store-stats__item" data-lame-stat {{ block.shopify_attributes }}>
                  <p class="lame-store-stats__value">
                    <span
                      class="lame-store-stats__number"
                      data-lame-stat-number
                      data-target="{{ stat_numeric }}"
                    >{{ stat_numeric }}</span>{%- if block.settings.suffix != blank -%}<span class="lame-store-stats__suffix">{{ block.settings.suffix | escape }}</span>{%- endif -%}
                  </p>
                  {%- if block.settings.label != blank -%}
                    <p class="lame-store-stats__label">{{ block.settings.label | escape }}</p>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_order_details -%}
        {%- capture lame_orders_url -%}{%- render 'lame-customer-orders-url' -%}{%- endcapture -%}
        {%- capture lame_login_url -%}{%- render 'lame-customer-auth-url', type: 'login' -%}{%- endcapture -%}
        <div class="lame-store-stats__orders">
          <div class="lame-store-stats__orders-head">
            <h3 class="lame-store-stats__orders-title">Your placed orders</h3>
            {% if customer %}
              <a class="lame-store-stats__orders-link" href="{{ lame_orders_url }}">View all</a>
            {% endif %}
          </div>

          {% if customer %}
            {% if customer.orders.size > 0 %}
              <ul class="lame-store-stats__order-list" role="list">
                {%- for order in customer.orders limit: section.settings.order_details_limit -%}
                  {%- liquid
                    assign status_key = order.fulfillment_status | default: 'unfulfilled'
                    assign status_label = order.fulfillment_status_label | default: 'Placed'
                    if order.cancelled
                      assign status_key = 'cancelled'
                      assign status_label = 'Cancelled'
                    endif
                  -%}
                  {%- capture order_detail_url -%}
                    {%- render 'lame-customer-order-detail-url', order: order -%}
                  {%- endcapture -%}
                  <li class="lame-store-stats__order">
                    <div class="lame-store-stats__order-top">
                      <div>
                        <p class="lame-store-stats__order-id">{{ order.name }}</p>
                        <time class="lame-store-stats__order-date" datetime="{{ order.created_at | date: '%Y-%m-%d' }}">
                          {{ order.created_at | date: '%d %b %Y' }}
                        </time>
                      </div>
                      <span class="lame-store-stats__order-status lame-store-stats__order-status--{{ status_key }}">{{ status_label }}</span>
                    </div>
                    <ul class="lame-store-stats__order-items" role="list">
                      {%- for line_item in order.line_items limit: 3 -%}
                        <li class="lame-store-stats__order-item">
                          {%- if line_item.image != blank -%}
                            {{
                              line_item.image
                              | image_url: width: 96
                              | image_tag:
                                widths: '48, 72, 96',
                                sizes: '40px',
                                class: 'lame-store-stats__order-thumb',
                                loading: 'lazy',
                                alt: line_item.title
                            }}
                          {%- else -%}
                            <span class="lame-store-stats__order-thumb lame-store-stats__order-thumb--empty" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="lame-store-stats__order-item-copy">
                            <span class="lame-store-stats__order-item-title">{{ line_item.title }}</span>
                            <span class="lame-store-stats__order-item-meta">Qty {{ line_item.quantity }} · {{ line_item.final_line_price | money }}</span>
                          </span>
                        </li>
                      {%- endfor -%}
                      {%- if order.line_items.size > 3 -%}
                        <li class="lame-store-stats__order-more">+{{ order.line_items.size | minus: 3 }} more item{% if order.line_items.size > 4 %}s{% endif %}</li>
                      {%- endif -%}
                    </ul>
                    <div class="lame-store-stats__order-foot">
                      <p class="lame-store-stats__order-total">
                        {%- if order.total_net_amount != blank -%}
                          {{ order.total_net_amount | money_with_currency }}
                        {%- else -%}
                          {{ order.total_price | money_with_currency }}
                        {%- endif -%}
                      </p>
                      <a class="lame-store-stats__order-cta" href="{{ order_detail_url }}">View details</a>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {% else %}
              <p class="lame-store-stats__orders-empty">No orders on this account yet. Your placed order details will appear here after checkout.</p>
            {% endif %}
          {% else %}
            <p class="lame-store-stats__orders-empty">Sign in to see your placed order details — number, items, status, and total. We don’t show other shoppers’ orders here.</p>
            <a class="lame-store-stats__order-cta lame-store-stats__order-cta--block" href="{{ lame_login_url }}">Sign in to view orders</a>
          {% endif %}
        </div>
      {%- endif -%}
    </div>
  </section>

  <script>
    (() => {
      const root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      const numbers = root.querySelectorAll('[data-lame-stat-number]');
      if (!numbers.length) return;

      const format = (value) => {
        try {
          return new Intl.NumberFormat('en-IN').format(Math.round(value));
        } catch (_) {
          return String(Math.round(value));
        }
      };

      const animate = (el) => {
        const target = Number(el.dataset.target || 0);
        if (!Number.isFinite(target) || target <= 0) {
          el.textContent = format(target || 0);
          return;
        }
        const duration = 1100;
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = format(target * eased);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if (!('IntersectionObserver' in window)) {
        numbers.forEach(animate);
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animate(entry.target);
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.35 }
      );
      numbers.forEach((el) => observer.observe(el));
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .shopify-section:has(.lame-store-stats) {
    width: 100%;
    max-width: none;
  }

  .shopify-section:has(.lame-store-stats) > .section-background {
    background: transparent;
  }

  .lame-store-stats.section {
    --lame-stats-ink: #9a3d4a;
    --lame-stats-muted: #8a5b62;
    --lame-stats-blush: #f6ebe8;
    --lame-stats-panel: #f3e4e0;
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }

  .lame-store-stats.section > .lame-store-stats__wrap {
    grid-column: 1 / -1;
    width: min(var(--page-width, 90rem), calc(100% - 2 * var(--page-margin, 1.25rem)));
    margin-inline: auto;
    padding-inline: 0;
  }

  .lame-store-stats__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
    align-items: stretch;
  }

  @media screen and (min-width: 750px) {
    .lame-store-stats__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem;
      min-height: 28rem;
    }

    .lame-store-stats__layout--image-right .lame-store-stats__media {
      order: 2;
    }

    .lame-store-stats__layout--image-right .lame-store-stats__copy {
      order: 1;
    }
  }

  .lame-store-stats__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100%;
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
    border-radius: 28px;
    background: var(--lame-stats-panel);
  }

  .lame-store-stats__badge {
    display: inline-flex;
    align-self: flex-start;
    margin: 0 0 1.15rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--lame-stats-ink);
    border-radius: 999px;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__heading {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    max-width: 18ch;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(1.65rem, 3.4vw, 2.55rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__heading em {
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-style: italic;
    font-weight: 500;
  }

  .lame-store-stats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
  }

  .lame-store-stats__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem 1.25rem;
    align-items: center;
    text-align: left;
    background: none;
    border: 0;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
  }

  .lame-store-stats__value,
  .lame-store-stats__number {
    margin: 0;
    border: 0;
    text-decoration: none;
    box-shadow: none;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--lame-stats-ink);
    white-space: nowrap;
  }

  .lame-store-stats__value::after,
  .lame-store-stats__number::after {
    content: none;
  }

  .lame-store-stats__label {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
    text-transform: none;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__media {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
    border-radius: 28px;
    background: var(--lame-stats-blush);
  }

  .lame-store-stats__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  @media screen and (min-width: 750px) {
    .lame-store-stats__media {
      min-height: 100%;
    }

    .lame-store-stats__image,
    .lame-store-stats__image-placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      min-height: 0;
    }
  }

  .lame-store-stats__image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 22rem;
    height: 100%;
    border: 1px dashed rgb(154 61 74 / 0.35);
    color: var(--lame-stats-muted);
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.9rem;
  }

  .lame-store-stats__orders {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store statistics",
  "tag": "section",
  "class": "section-wrapper section-wrapper--full-width",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show this section",
      "default": true,
      "info": "Turn off to hide the statistics bar without deleting it. You can also use the eye icon in the theme editor."
    },
    {
      "type": "paragraph",
      "content": "Shopify themes cannot read your order history directly. Product count is live. Order counts auto-update from shop metafields that Shopify Flow keeps current."
    },
    {
      "type": "paragraph",
      "content": "Setup: Admin → Settings → Custom data → Shop → Add definition. Integer metafields named custom.orders_placed and custom.orders_delivered. Turn on Storefront access. Set the starting value to your current total in Admin → Orders."
    },
    {
      "type": "paragraph",
      "content": "Then Admin → Flow: (1) Trigger Order created → Update shop metafield custom.orders_placed to current value + 1. (2) Trigger Fulfillment created → Update shop metafield custom.orders_delivered to current value + 1."
    },
    {
      "type": "header",
      "content": "Left image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shows on the left. If empty, the MyLamstone delivery photo is used. Click Select to upload your own."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "MyLamstone delivery"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-left"
    },
    {
      "type": "header",
      "content": "Right content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Badge",
      "default": "Trusted by shoppers"
    },
    {
      "type": "text",
      "id": "heading_brand",
      "label": "Heading start",
      "default": "MyLamstone in numbers for"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic highlight",
      "default": "smoother, softer"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading end",
      "default": "everyday beauty."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "MyLamstone in numbers",
      "info": "Used only if the split heading fields are empty."
    },
    {
      "type": "header",
      "content": "Placed order details"
    },
    {
      "type": "checkbox",
      "id": "show_order_details",
      "label": "Show placed order details",
      "default": false,
      "info": "Logged-in shoppers see their own recent orders. Shopify cannot show every store order on the website."
    },
    {
      "type": "range",
      "id": "order_details_limit",
      "label": "Orders to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Number source",
          "options": [
            { "value": "orders_placed", "label": "Auto: orders placed" },
            { "value": "orders_delivered", "label": "Auto: orders delivered" },
            { "value": "products", "label": "Live product count" },
            { "value": "brands", "label": "Live brand / vendor count" },
            { "value": "custom", "label": "Entered number" }
          ],
          "default": "orders_placed",
          "info": "Auto order sources use shop metafields custom.orders_placed and custom.orders_delivered, updated by Shopify Flow."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Fallback / override number",
          "default": "0",
          "info": "Shown if the live metafield is empty, or when “Use entered number” is on."
        },
        {
          "type": "checkbox",
          "id": "use_custom_number",
          "label": "Use entered number instead of live count",
          "default": false
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+",
          "info": "Shown after the number, e.g. +"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Orders fulfilled"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": ""
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "orders", "label": "Orders" },
            { "value": "products", "label": "Products" },
            { "value": "brands", "label": "Brands" },
            { "value": "customers", "label": "Customers" },
            { "value": "shield", "label": "Trust" }
          ],
          "default": "orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store statistics",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "source": "orders_delivered",
            "number": "10000",
            "use_custom_number": false,
            "suffix": "+",
            "label": "Orders fulfilled",
            "caption": "",
            "icon": "orders"
          }
        },
        {
          "type": "stat",
          "settings": {
            "source": "products",
            "number": "",
            "use_custom_number": false,
            "suffix": "+",
            "label": "Products",
            "caption": "",
            "icon": "products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
