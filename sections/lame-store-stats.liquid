{%- if section.settings.enabled -%}
  {%- liquid
    assign live_products = shop.products_count | default: 0
    assign live_brands = shop.vendors.size | default: 0
    assign live_orders_placed = 0
    assign live_orders_delivered = 0

    if shop.metafields.custom.orders_placed.value != blank
      assign live_orders_placed = shop.metafields.custom.orders_placed.value | times: 1
    elsif shop.metafields.custom.orders_count.value != blank
      assign live_orders_placed = shop.metafields.custom.orders_count.value | times: 1
    endif

    if shop.metafields.custom.orders_delivered.value != blank
      assign live_orders_delivered = shop.metafields.custom.orders_delivered.value | times: 1
    elsif shop.metafields.custom.orders_fulfilled.value != blank
      assign live_orders_delivered = shop.metafields.custom.orders_fulfilled.value | times: 1
    endif

    assign stat_count = 0
    for block in section.blocks
      assign stat_count = stat_count | plus: 1
    endfor
  -%}

  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--full-width color-{{ section.settings.color_scheme }} lame-store-stats"
    style="{% render 'spacing-padding', settings: section.settings %}"
    data-lame-store-stats
    {{ section.shopify_attributes }}
  >
    <div class="lame-store-stats__wrap spacing-style">
      {%- if request.design_mode and live_orders_placed == 0 and live_orders_delivered == 0 -%}
        <p class="lame-store-stats__setup">
          Auto order counts need a shop metafield. Create
          <strong>custom.orders_placed</strong> and/or
          <strong>custom.orders_delivered</strong>
          (integer, storefront access on), seed with your current total from Admin → Orders, then use Shopify Flow to add 1 on each new order or fulfillment. This note is only visible in the theme editor.
        </p>
      {%- endif -%}

      <div class="lame-store-stats__banner">
        <div class="lame-store-stats__decor" aria-hidden="true">
          <svg class="lame-store-stats__leaf lame-store-stats__leaf--tl" viewBox="0 0 180 140" fill="none">
            <path d="M20 90c28-38 70-62 140-70-18 42-54 78-118 96-8-8-16-16-22-26Z" fill="#7ea889" opacity=".55"/>
            <path d="M38 78c22-28 54-46 108-52-14 32-42 60-92 74-6-6-12-14-16-22Z" fill="#2f6b4e" opacity=".5"/>
            <path d="M8 118c18-8 34-6 48 8-22 6-38 4-48-8Z" fill="#4f8a66" opacity=".45"/>
          </svg>
          <svg class="lame-store-stats__leaf lame-store-stats__leaf--tr" viewBox="0 0 180 140" fill="none">
            <path d="M160 88c-28-38-70-62-140-70 18 42 54 78 118 96 8-8 16-16 22-26Z" fill="#6f9b7c" opacity=".5"/>
            <path d="M142 74c-22-28-54-46-108-52 14 32 42 60 92 74 6-6 12-14 16-22Z" fill="#245a40" opacity=".45"/>
          </svg>
          <span class="lame-store-stats__prop lame-store-stats__prop--box"></span>
          <span class="lame-store-stats__prop lame-store-stats__prop--plate"></span>
          <span class="lame-store-stats__prop lame-store-stats__prop--silk"></span>
        </div>

        {%- if section.settings.eyebrow != blank or section.settings.heading_brand != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
          <header class="lame-store-stats__header">
            {%- if section.settings.eyebrow != blank -%}
              <p class="lame-store-stats__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.heading_brand != blank or section.settings.heading_italic != blank -%}
              <h2 class="lame-store-stats__heading">
                {%- if section.settings.heading_brand != blank -%}
                  <span class="lame-store-stats__brand">{{ section.settings.heading_brand | escape }}</span>
                {%- endif -%}
                {%- if section.settings.heading_italic != blank -%}
                  <em class="lame-store-stats__heading-em">{{ section.settings.heading_italic | escape }}</em>
                {%- endif -%}
              </h2>
            {%- elsif section.settings.heading != blank -%}
              <h2 class="lame-store-stats__heading">{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
              <p class="lame-store-stats__subheading">{{ section.settings.subheading | escape }}</p>
            {%- endif -%}
          </header>
        {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul
          class="lame-store-stats__grid lame-store-stats__grid--{{ stat_count }}"
          role="list"
        >
          {%- for block in section.blocks -%}
            {%- liquid
              assign stat_value = block.settings.number | strip
              assign stat_numeric = 0

              case block.settings.source
                when 'products'
                  assign stat_numeric = live_products
                when 'brands'
                  assign stat_numeric = live_brands
                when 'orders_placed'
                  assign stat_numeric = live_orders_placed
                when 'orders_delivered'
                  assign stat_numeric = live_orders_delivered
                else
                  assign stat_numeric = block.settings.number | times: 1
              endcase

              if block.settings.use_custom_number and block.settings.number != blank
                assign stat_numeric = block.settings.number | times: 1
              endif

              if stat_numeric == blank or stat_numeric == 0
                if stat_value != blank
                  assign stat_numeric = stat_value | times: 1
                endif
              endif
            -%}
            <li
              class="lame-store-stats__item"
              data-lame-stat
              {{ block.shopify_attributes }}
            >
              <span class="lame-store-stats__icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'orders' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="20" r="1.35"/>
                      <circle cx="18" cy="20" r="1.35"/>
                      <path d="M3 5h2.2l2.1 11h11.4l1.9-7.5H7.1"/>
                    </svg>
                  {%- when 'products' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 8.5 12 4l8 4.5V18a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V8.5Z"/>
                      <path d="M12 12v7M12 12 20 8M12 12 4 8"/>
                    </svg>
                  {%- when 'brands' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="3"/>
                      <path d="M5 19a7 7 0 0 1 14 0"/>
                    </svg>
                  {%- when 'customers' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="8" r="3"/>
                      <path d="M3 19a6 6 0 0 1 12 0"/>
                      <circle cx="17" cy="9" r="2.2"/>
                      <path d="M21 19a4.8 4.8 0 0 0-4-4.6"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z"/>
                    </svg>
                {%- endcase -%}
              </span>
              <p class="lame-store-stats__value">
                <span
                  class="lame-store-stats__number"
                  data-lame-stat-number
                  data-target="{{ stat_numeric }}"
                >{{ stat_numeric }}</span>{%- if block.settings.suffix != blank -%}<span class="lame-store-stats__suffix">{{ block.settings.suffix | escape }}</span>{%- endif -%}
              </p>
              {%- if block.settings.label != blank -%}
                <p class="lame-store-stats__label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <p class="lame-store-stats__caption">{{ block.settings.caption | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      </div>

      {%- if section.settings.show_order_details -%}
        {%- capture lame_orders_url -%}{%- render 'lame-customer-orders-url' -%}{%- endcapture -%}
        {%- capture lame_login_url -%}{%- render 'lame-customer-auth-url', type: 'login' -%}{%- endcapture -%}
        <div class="lame-store-stats__orders">
          <div class="lame-store-stats__orders-head">
            <h3 class="lame-store-stats__orders-title">Your placed orders</h3>
            {% if customer %}
              <a class="lame-store-stats__orders-link" href="{{ lame_orders_url }}">View all</a>
            {% endif %}
          </div>

          {% if customer %}
            {% if customer.orders.size > 0 %}
              <ul class="lame-store-stats__order-list" role="list">
                {%- for order in customer.orders limit: section.settings.order_details_limit -%}
                  {%- liquid
                    assign status_key = order.fulfillment_status | default: 'unfulfilled'
                    assign status_label = order.fulfillment_status_label | default: 'Placed'
                    if order.cancelled
                      assign status_key = 'cancelled'
                      assign status_label = 'Cancelled'
                    endif
                  -%}
                  {%- capture order_detail_url -%}
                    {%- render 'lame-customer-order-detail-url', order: order -%}
                  {%- endcapture -%}
                  <li class="lame-store-stats__order">
                    <div class="lame-store-stats__order-top">
                      <div>
                        <p class="lame-store-stats__order-id">{{ order.name }}</p>
                        <time class="lame-store-stats__order-date" datetime="{{ order.created_at | date: '%Y-%m-%d' }}">
                          {{ order.created_at | date: '%d %b %Y' }}
                        </time>
                      </div>
                      <span class="lame-store-stats__order-status lame-store-stats__order-status--{{ status_key }}">{{ status_label }}</span>
                    </div>
                    <ul class="lame-store-stats__order-items" role="list">
                      {%- for line_item in order.line_items limit: 3 -%}
                        <li class="lame-store-stats__order-item">
                          {%- if line_item.image != blank -%}
                            {{
                              line_item.image
                              | image_url: width: 96
                              | image_tag:
                                widths: '48, 72, 96',
                                sizes: '40px',
                                class: 'lame-store-stats__order-thumb',
                                loading: 'lazy',
                                alt: line_item.title
                            }}
                          {%- else -%}
                            <span class="lame-store-stats__order-thumb lame-store-stats__order-thumb--empty" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="lame-store-stats__order-item-copy">
                            <span class="lame-store-stats__order-item-title">{{ line_item.title }}</span>
                            <span class="lame-store-stats__order-item-meta">Qty {{ line_item.quantity }} · {{ line_item.final_line_price | money }}</span>
                          </span>
                        </li>
                      {%- endfor -%}
                      {%- if order.line_items.size > 3 -%}
                        <li class="lame-store-stats__order-more">+{{ order.line_items.size | minus: 3 }} more item{% if order.line_items.size > 4 %}s{% endif %}</li>
                      {%- endif -%}
                    </ul>
                    <div class="lame-store-stats__order-foot">
                      <p class="lame-store-stats__order-total">
                        {%- if order.total_net_amount != blank -%}
                          {{ order.total_net_amount | money_with_currency }}
                        {%- else -%}
                          {{ order.total_price | money_with_currency }}
                        {%- endif -%}
                      </p>
                      <a class="lame-store-stats__order-cta" href="{{ order_detail_url }}">View details</a>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            {% else %}
              <p class="lame-store-stats__orders-empty">No orders on this account yet. Your placed order details will appear here after checkout.</p>
            {% endif %}
          {% else %}
            <p class="lame-store-stats__orders-empty">Sign in to see your placed order details — number, items, status, and total. We don’t show other shoppers’ orders here.</p>
            <a class="lame-store-stats__order-cta lame-store-stats__order-cta--block" href="{{ lame_login_url }}">Sign in to view orders</a>
          {% endif %}
        </div>
      {%- endif -%}
    </div>
  </section>

  <script>
    (() => {
      const root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      const numbers = root.querySelectorAll('[data-lame-stat-number]');
      if (!numbers.length) return;

      const format = (value) => {
        try {
          return new Intl.NumberFormat('en-IN').format(Math.round(value));
        } catch (_) {
          return String(Math.round(value));
        }
      };

      const animate = (el) => {
        const target = Number(el.dataset.target || 0);
        if (!Number.isFinite(target) || target <= 0) {
          el.textContent = format(target || 0);
          return;
        }
        const duration = 1100;
        const start = performance.now();
        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = format(target * eased);
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      if (!('IntersectionObserver' in window)) {
        numbers.forEach(animate);
        return;
      }

      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            animate(entry.target);
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.35 }
      );
      numbers.forEach((el) => observer.observe(el));
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .shopify-section:has(.lame-store-stats) {
    width: 100%;
    max-width: none;
  }

  .lame-store-stats {
    --lame-stats-ink: #0f3d2e;
    --lame-stats-muted: #6b746f;
    --lame-stats-accent: #15553c;
    --lame-stats-cream: #f4efe6;
    --lame-stats-mint: #e7f1ea;
    --lame-stats-mint-deep: #d7e8dd;
    width: 100%;
    max-width: none;
    padding-inline: 0;
  }

  .lame-store-stats__wrap {
    width: 100%;
    max-width: none;
    margin: 0;
    padding-inline: 0;
  }

  .lame-store-stats__banner {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.75rem, 4vw, 3rem);
    border-radius: 0;
    box-shadow: none;
    background:
      radial-gradient(120% 90% at 50% 0%, #fbf8f2 0%, var(--lame-stats-cream) 55%, #efe8dc 100%);
  }

  .lame-store-stats__decor {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .lame-store-stats__leaf {
    position: absolute;
    width: min(34vw, 220px);
    height: auto;
    filter: blur(0.2px);
  }

  .lame-store-stats__leaf--tl {
    top: -18px;
    left: -12px;
  }

  .lame-store-stats__leaf--tr {
    top: -22px;
    right: -16px;
  }

  .lame-store-stats__prop {
    position: absolute;
    display: block;
  }

  .lame-store-stats__prop--box {
    left: -28px;
    bottom: 18%;
    width: 150px;
    height: 110px;
    border-radius: 8px 18px 10px 8px;
    background:
      linear-gradient(135deg, #d8c7a6 0%, #cbb48a 42%, #b89a68 100%);
    box-shadow: 0 16px 28px rgb(15 61 46 / 0.12);
    transform: rotate(-8deg);
    opacity: 0.88;
  }

  .lame-store-stats__prop--box::after {
    content: '';
    position: absolute;
    inset: 18px 22px auto 22px;
    height: 28px;
    border-radius: 4px;
    background: rgb(191 162 74 / 0.35);
  }

  .lame-store-stats__prop--plate {
    right: 18px;
    bottom: 12%;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #fff 0%, #f3eee6 55%, #e4d9c8 100%);
    box-shadow: 0 14px 26px rgb(15 61 46 / 0.1);
    opacity: 0.9;
  }

  .lame-store-stats__prop--silk {
    right: -30px;
    bottom: -20px;
    width: 220px;
    height: 120px;
    border-radius: 80% 40% 70% 50%;
    background: linear-gradient(135deg, #163f31 0%, #0f2f24 55%, #1b5a42 100%);
    transform: rotate(-18deg);
    opacity: 0.82;
  }

  @media screen and (max-width: 749px) {
    .lame-store-stats__prop--box,
    .lame-store-stats__prop--plate {
      display: none;
    }

    .lame-store-stats__prop--silk {
      width: 140px;
      height: 80px;
      opacity: 0.45;
    }
  }

  .lame-store-stats__setup {
    margin: 0 auto 1rem;
    max-width: 48rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px dashed rgb(21 85 60 / 0.35);
    background: rgb(21 85 60 / 0.06);
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb, 60 60 60));
    text-align: left;
  }

  .lame-store-stats__header,
  .lame-store-stats__grid {
    position: relative;
    z-index: 1;
  }

  .lame-store-stats__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto clamp(1.35rem, 3vw, 2rem);
    padding-inline: var(--page-margin, 1.25rem);
  }

  .lame-store-stats__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin: 0 0 0.7rem;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8a918c;
  }

  .lame-store-stats__eyebrow::before,
  .lame-store-stats__eyebrow::after {
    content: '';
    width: 2.4rem;
    height: 1px;
    background: #c5ccc7;
  }

  .lame-store-stats__heading {
    margin: 0;
    color: var(--lame-stats-ink);
    line-height: 1.05;
  }

  .lame-store-stats__brand {
    display: block;
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2.1rem, 5vw, 3.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .lame-store-stats__heading-em {
    display: block;
    margin-top: 0.05em;
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.7rem, 4.2vw, 2.7rem);
    font-style: italic;
    font-weight: 500;
  }

  .lame-store-stats__subheading {
    margin: 0.7rem 0 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--lame-stats-muted);
  }

  .lame-store-stats__grid {
    list-style: none;
    margin: 0 auto;
    padding: 0 var(--page-margin, 1.25rem);
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    max-width: 52rem;
    box-sizing: border-box;
  }

  @media screen and (min-width: 750px) {
    .lame-store-stats__grid,
    .lame-store-stats__grid--2,
    .lame-store-stats__grid--3,
    .lame-store-stats__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      border: 0;
      background: transparent;
      overflow: visible;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-store-stats__grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 64rem;
    }

    .lame-store-stats__grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: 72rem;
    }
  }

  .lame-store-stats__item {
    text-align: center;
    padding: 1.45rem 1.1rem 1.3rem;
    border-radius: 18px;
    background: var(--lame-stats-mint);
    border: 0;
    box-shadow: 0 10px 24px rgb(15 61 46 / 0.06);
  }

  @media screen and (min-width: 750px) {
    .lame-store-stats__item {
      border: 0;
      border-radius: 18px;
      background: var(--lame-stats-mint);
      padding: 1.6rem 1.2rem 1.4rem;
      box-shadow: 0 10px 24px rgb(15 61 46 / 0.06);
    }

    .lame-store-stats__item:last-child {
      box-shadow: 0 10px 24px rgb(15 61 46 / 0.06);
    }
  }

  .lame-store-stats__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.15rem;
    height: 3.15rem;
    margin-bottom: 0.85rem;
    border-radius: 50%;
    background: var(--lame-stats-mint-deep);
    color: var(--lame-stats-accent);
  }

  .lame-store-stats__icon svg {
    width: 1.45rem;
    height: 1.45rem;
  }

  .lame-store-stats__value {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__suffix {
    margin-left: 0.02em;
  }

  .lame-store-stats__label {
    margin: 0.55rem 0 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lame-stats-accent);
  }

  .lame-store-stats__caption {
    margin: 0.35rem 0 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--lame-stats-muted);
  }

  .lame-store-stats__orders {
    width: min(52rem, calc(100% - 2 * var(--page-margin, 1.25rem)));
    margin: clamp(1.25rem, 3vw, 2rem) auto 0;
    padding: 1.15rem 1.1rem 1.2rem;
    border-radius: 20px;
    border: 1px solid rgb(var(--color-foreground-rgb, 28 32 24) / 0.08);
    background: rgb(var(--color-background-rgb, 255 255 255) / 0.72);
  }

  .lame-store-stats__orders-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .lame-store-stats__orders-title {
    margin: 0;
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__orders-link,
  .lame-store-stats__order-cta {
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--lame-stats-accent);
  }

  .lame-store-stats__orders-empty {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--lame-stats-muted);
  }

  .lame-store-stats__order-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media screen and (min-width: 750px) {
    .lame-store-stats__order-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-store-stats__order-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lame-store-stats__order {
    padding: 0.95rem;
    border-radius: 14px;
    background: rgb(var(--color-background-rgb, 255 255 255));
    border: 1px solid rgb(var(--color-foreground-rgb, 28 32 24) / 0.07);
  }

  .lame-store-stats__order-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lame-store-stats__order-id {
    margin: 0;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__order-date {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.75rem;
    color: var(--lame-stats-muted);
  }

  .lame-store-stats__order-status {
    flex: 0 0 auto;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: rgb(var(--lame-premium-forest, 21 66 48) / 0.1);
    color: var(--lame-stats-accent);
  }

  .lame-store-stats__order-status--fulfilled {
    background: rgb(21 128 61 / 0.12);
    color: #157a3a;
  }

  .lame-store-stats__order-status--cancelled {
    background: rgb(180 35 24 / 0.1);
    color: #b42318;
  }

  .lame-store-stats__order-items {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .lame-store-stats__order-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
  }

  .lame-store-stats__order-thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 8px;
    background: #f3eee8;
  }

  .lame-store-stats__order-item-copy {
    min-width: 0;
    display: grid;
  }

  .lame-store-stats__order-item-title {
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--lame-stats-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lame-store-stats__order-item-meta,
  .lame-store-stats__order-more {
    font-size: 0.72rem;
    color: var(--lame-stats-muted);
  }

  .lame-store-stats__order-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgb(var(--color-foreground-rgb, 28 32 24) / 0.08);
  }

  .lame-store-stats__order-total {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--lame-stats-ink);
  }

  .lame-store-stats__order-cta--block {
    display: inline-flex;
    margin-top: 0.85rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--lame-stats-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store statistics",
  "tag": "section",
  "class": "section-wrapper section-wrapper--full-width",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show this section",
      "default": true,
      "info": "Turn off to hide the statistics bar without deleting it. You can also use the eye icon in the theme editor."
    },
    {
      "type": "paragraph",
      "content": "Shopify themes cannot read your order history directly. Product count is live. Order counts auto-update from shop metafields that Shopify Flow keeps current."
    },
    {
      "type": "paragraph",
      "content": "Setup: Admin → Settings → Custom data → Shop → Add definition. Integer metafields named custom.orders_placed and custom.orders_delivered. Turn on Storefront access. Set the starting value to your current total in Admin → Orders."
    },
    {
      "type": "paragraph",
      "content": "Then Admin → Flow: (1) Trigger Order created → Update shop metafield custom.orders_placed to current value + 1. (2) Trigger Fulfillment created → Update shop metafield custom.orders_delivered to current value + 1."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Trusted by shoppers"
    },
    {
      "type": "text",
      "id": "heading_brand",
      "label": "Heading brand",
      "default": "MyLamstone"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading italic line",
      "default": "in numbers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading fallback",
      "default": "MyLamstone in numbers",
      "info": "Used only if brand/italic fields are empty."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real catalog size, plus orders fulfilled from our store."
    },
    {
      "type": "header",
      "content": "Placed order details"
    },
    {
      "type": "checkbox",
      "id": "show_order_details",
      "label": "Show placed order details",
      "default": false,
      "info": "Logged-in shoppers see their own recent orders. Shopify cannot show every store order on the website."
    },
    {
      "type": "range",
      "id": "order_details_limit",
      "label": "Orders to show",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "select",
          "id": "source",
          "label": "Number source",
          "options": [
            { "value": "orders_placed", "label": "Auto: orders placed" },
            { "value": "orders_delivered", "label": "Auto: orders delivered" },
            { "value": "products", "label": "Live product count" },
            { "value": "brands", "label": "Live brand / vendor count" },
            { "value": "custom", "label": "Entered number" }
          ],
          "default": "orders_placed",
          "info": "Auto order sources use shop metafields custom.orders_placed and custom.orders_delivered, updated by Shopify Flow."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Fallback / override number",
          "default": "0",
          "info": "Shown if the live metafield is empty, or when “Use entered number” is on."
        },
        {
          "type": "checkbox",
          "id": "use_custom_number",
          "label": "Use entered number instead of live count",
          "default": false
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+",
          "info": "Shown after the number, e.g. +"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Orders fulfilled"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": ""
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "orders", "label": "Orders" },
            { "value": "products", "label": "Products" },
            { "value": "brands", "label": "Brands" },
            { "value": "customers", "label": "Customers" },
            { "value": "shield", "label": "Trust" }
          ],
          "default": "orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store statistics",
      "category": "Storytelling",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "source": "orders_delivered",
            "number": "10000",
            "use_custom_number": false,
            "suffix": "+",
            "label": "Orders fulfilled",
            "caption": "",
            "icon": "orders"
          }
        },
        {
          "type": "stat",
          "settings": {
            "source": "products",
            "number": "",
            "use_custom_number": false,
            "suffix": "+",
            "label": "Products",
            "caption": "",
            "icon": "products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
