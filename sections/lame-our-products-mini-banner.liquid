{%- doc -%}
  Full-width Our Products page banner — image only.
  Shown on all / our-products / products collection handles.
{%- enddoc -%}

{%- liquid
  assign show_banner = false
  if template.name == 'collection' and collection != blank
    if template.suffix == 'our-products'
      assign show_banner = true
    elsif collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products' or collection.handle == 'frontpage'
      assign show_banner = true
    endif
  endif

  assign image_alt = section.settings.image_alt | default: 'Our Products'
  assign banner_image = section.settings.image
  assign banner_ratio = 3.0029
  if banner_image != blank and banner_image.aspect_ratio != blank
    assign banner_ratio = banner_image.aspect_ratio
  endif
-%}

{%- if show_banner -%}
  {{ 'lame-op-page.css' | asset_url | stylesheet_tag }}

  <section
    class="lame-op-mini-banner lame-op-mini-banner--{{ section.settings.height }} lame-op-mini-banner--image-only"
    style="--lame-op-mini-bg-setting: {{ section.settings.bg_color }}; --lame-op-mini-ratio: {{ banner_ratio }};"
    aria-label="{{ image_alt | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="lame-op-mini-banner__surface">
      {% if banner_image != blank %}
        {{
          banner_image
          | image_url: width: 2400
          | image_tag:
            class: 'lame-op-mini-banner__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750,1100,1500,2000,2400',
            sizes: '100vw',
            alt: image_alt
        }}
      {% else %}
        <img
          class="lame-op-mini-banner__image"
          src="{{ 'lame-our-products-banner-v2.png' | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1600"
          height="520"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Our Products mini banner",
  "tag": "section",
  "class": "section-wrapper lame-op-mini-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Image-only banner for All / Our Products collection pages."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image",
      "info": "Leave empty to use the built-in banner image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Our Products"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "slim", "label": "Slim (slight crop)" },
        { "value": "regular", "label": "Fit full image" },
        { "value": "tall", "label": "Taller frame" }
      ],
      "default": "regular",
      "info": "Fit full image matches the banner proportions so the artwork fills the width with no empty gaps. Slim crops a little from the bottom; Tall shows a bit more height."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background",
      "default": "#fff0f6"
    }
  ],
  "presets": [
    {
      "name": "Our Products mini banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
