{%- doc -%}
  Full-width Our Products page banner.
  Default image: assets/lame-our-products-banner.png
  Heading + Shop CTA both link to this collection page.
{%- enddoc -%}

{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign button_label = section.settings.button_label
  assign banner_image = section.settings.image
  assign page_url = collection.url | default: routes.all_products_collection_url
  assign link_url = page_url
  if section.settings.button_link != blank
    assign link_url = section.settings.button_link
  endif
  assign has_content = true
  assign image_alt = section.settings.image_alt | default: heading | default: collection.title
-%}

<section
  class="lame-op-mini-banner lame-op-mini-banner--{{ section.settings.height }} lame-op-mini-banner--align-{{ section.settings.content_align }}"
  style="
    --lame-op-mini-bg: {{ section.settings.bg_color }};
    --lame-op-mini-fg: {{ section.settings.text_color }};
    --lame-op-mini-accent: {{ section.settings.accent_color }};
    --lame-op-mini-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
  {{ section.shopify_attributes }}
>
  <div class="lame-op-mini-banner__surface">
    {% if banner_image != blank %}
      {{
        banner_image
        | image_url: width: 2400
        | image_tag:
          class: 'lame-op-mini-banner__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750,1100,1500,2000,2400',
          sizes: '100vw',
          alt: image_alt
      }}
    {% else %}
      <img
        class="lame-op-mini-banner__image"
        src="{{ 'lame-our-products-banner.png' | asset_url }}"
        alt="{{ image_alt | escape }}"
        width="1600"
        height="400"
        loading="eager"
        fetchpriority="high"
      >
    {% endif %}

    <div class="lame-op-mini-banner__overlay" aria-hidden="true"></div>

    <div class="lame-op-mini-banner__inner lame-op-mini-banner__inner--{{ section.settings.content_align }}">
      <div class="lame-op-mini-banner__copy">
        {% if section.settings.badge != blank %}
          <span class="lame-op-mini-banner__badge">{{ section.settings.badge | escape }}</span>
        {% endif %}

        {% if heading != blank %}
          <h2 class="lame-op-mini-banner__heading">
            <a class="lame-op-mini-banner__heading-link" href="{{ link_url }}">
              {{ heading | escape }}
            </a>
          </h2>
        {% endif %}

        {% if text != blank %}
          <p class="lame-op-mini-banner__text">{{ text | escape }}</p>
        {% endif %}

        {% if button_label != blank %}
          <a class="lame-op-mini-banner__btn" href="{{ link_url }}">
            {{ button_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-op-mini-banner {
    width: 100%;
    max-width: none;
    margin: 0;
    background: var(--lame-op-mini-bg, #f4b8c8);
    color: var(--lame-op-mini-fg, #3a1f28);
  }

  .lame-op-mini-banner__surface {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: var(--lame-op-mini-h, 220px);
    overflow: hidden;
  }

  .lame-op-mini-banner--slim {
    --lame-op-mini-h: 140px;
  }

  .lame-op-mini-banner--regular {
    --lame-op-mini-h: clamp(180px, 26vw, 280px);
  }

  .lame-op-mini-banner--tall {
    --lame-op-mini-h: clamp(220px, 32vw, 360px);
  }

  .lame-op-mini-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .lame-op-mini-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 45%,
      rgba(58, 31, 40, calc(var(--lame-op-mini-overlay, 0.18) * 0.55)) 70%,
      rgba(58, 31, 40, var(--lame-op-mini-overlay, 0.18)) 100%
    );
    pointer-events: none;
  }

  .lame-op-mini-banner__inner {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    max-width: min(1280px, 100%);
    margin-inline: auto;
    padding: 1.25rem clamp(1rem, 3vw, 2rem);
    box-sizing: border-box;
  }

  .lame-op-mini-banner__inner--left {
    justify-content: flex-start;
    text-align: left;
  }

  .lame-op-mini-banner__inner--center {
    justify-content: center;
    text-align: center;
  }

  .lame-op-mini-banner__inner--right {
    justify-content: flex-end;
    text-align: left;
  }

  .lame-op-mini-banner__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
    max-width: min(22rem, 100%);
  }

  .lame-op-mini-banner__inner--center .lame-op-mini-banner__copy {
    align-items: center;
    text-align: center;
  }

  .lame-op-mini-banner__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: #c23b6a;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
  }

  .lame-op-mini-banner__heading {
    margin: 0;
    font-family: var(--font-heading--family, var(--font-body--family, system-ui, sans-serif));
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.15;
    color: inherit;
  }

  .lame-op-mini-banner__heading-link {
    color: inherit;
    text-decoration: none;
  }

  .lame-op-mini-banner__heading-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .lame-op-mini-banner__text {
    margin: 0;
    font-size: clamp(0.875rem, 1.6vw, 1rem);
    font-weight: 500;
    line-height: 1.4;
    color: inherit;
    opacity: 0.9;
  }

  .lame-op-mini-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    margin-top: 0.25rem;
    padding: 0.55rem 1.35rem;
    border-radius: 999px;
    background: var(--lame-op-mini-accent, #fc2779);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(252, 39, 121, 0.28);
    transition: opacity 0.2s ease, transform 0.15s ease;
  }

  .lame-op-mini-banner__btn:hover {
    opacity: 0.94;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 749px) {
    .lame-op-mini-banner--slim,
    .lame-op-mini-banner--regular,
    .lame-op-mini-banner--tall {
      --lame-op-mini-h: clamp(200px, 52vw, 260px);
    }

    .lame-op-mini-banner__image {
      object-position: 18% center;
    }

    .lame-op-mini-banner__overlay {
      background: linear-gradient(
        180deg,
        rgba(58, 31, 40, 0.05) 0%,
        rgba(58, 31, 40, 0.35) 55%,
        rgba(58, 31, 40, 0.55) 100%
      );
    }

    .lame-op-mini-banner__inner,
    .lame-op-mini-banner__inner--left,
    .lame-op-mini-banner__inner--center,
    .lame-op-mini-banner__inner--right {
      align-items: flex-end;
      justify-content: center;
      text-align: center;
      min-height: var(--lame-op-mini-h);
      padding-bottom: 1.35rem;
    }

    .lame-op-mini-banner__copy {
      align-items: center;
      max-width: 100%;
    }

    .lame-op-mini-banner__heading {
      font-size: clamp(1.35rem, 6vw, 1.75rem);
      color: #ffffff;
    }

    .lame-op-mini-banner__text {
      color: #ffffff;
    }

    .lame-op-mini-banner__heading-link:hover {
      text-decoration-color: #ffffff;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our Products mini banner",
  "tag": "section",
  "class": "section-wrapper lame-op-mini-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Our Products",
      "info": "Links to this collection page."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop",
      "info": "Links to this collection page by default."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom link (optional)",
      "info": "Leave blank so heading and Shop stay on this page."
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Leave empty to use the built-in Our Products banner image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "All Our Products"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Right-side overlay strength",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "slim", "label": "Slim" },
        { "value": "regular", "label": "Regular" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background",
      "default": "#f4b8c8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3a1f28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#fc2779"
    }
  ],
  "presets": [
    {
      "name": "Our Products mini banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
