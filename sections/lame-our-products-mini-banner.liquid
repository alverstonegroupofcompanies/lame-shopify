{%- doc -%}
  Optional Theme Editor section wrapper. Banner also renders automatically
  from main-collection on Our Products catalog pages.
{%- enddoc -%}

{%- liquid
  assign show_banner = false
  if template.suffix == 'our-products'
    assign show_banner = true
  elsif collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
    assign show_banner = true
  endif
-%}

{%- comment -%} Skip when main-collection already paints the banner for OP pages. {%- endcomment -%}
{%- unless show_banner -%}
  {%- liquid
    assign heading = section.settings.heading
    assign text = section.settings.text
    assign button_label = section.settings.button_label
    assign banner_image = section.settings.image
    assign page_url = collection.url | default: routes.all_products_collection_url
    assign link_url = page_url
    if section.settings.button_link != blank
      assign link_url = section.settings.button_link
    endif
    assign image_alt = section.settings.image_alt | default: heading | default: collection.title
  -%}

  <section
    class="lame-op-mini-banner lame-op-mini-banner--{{ section.settings.height }} lame-op-mini-banner--align-{{ section.settings.content_align }}"
    style="
      --lame-op-mini-bg: {{ section.settings.bg_color }};
      --lame-op-mini-fg: {{ section.settings.text_color }};
      --lame-op-mini-accent: {{ section.settings.accent_color }};
    "
    {{ section.shopify_attributes }}
  >
    <div class="lame-op-mini-banner__surface">
      {% if banner_image != blank %}
        {{
          banner_image
          | image_url: width: 2400
          | image_tag:
            class: 'lame-op-mini-banner__image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750,1100,1500,2000,2400',
            sizes: '100vw',
            alt: image_alt
        }}
      {% else %}
        <img
          class="lame-op-mini-banner__image"
          src="{{ 'lame-our-products-banner.png' | asset_url }}"
          alt="{{ image_alt | escape }}"
          width="1600"
          height="400"
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
      <div class="lame-op-mini-banner__overlay" aria-hidden="true"></div>
      <div class="lame-op-mini-banner__inner lame-op-mini-banner__inner--{{ section.settings.content_align }}">
        <div class="lame-op-mini-banner__copy">
          {% if heading != blank %}
            <h2 class="lame-op-mini-banner__heading">
              <a class="lame-op-mini-banner__heading-link" href="{{ link_url }}">{{ heading | escape }}</a>
            </h2>
          {% endif %}
          {% if text != blank %}
            <p class="lame-op-mini-banner__text">{{ text | escape }}</p>
          {% endif %}
          {% if button_label != blank %}
            <a class="lame-op-mini-banner__btn" href="{{ link_url }}">{{ button_label | escape }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Our Products mini banner",
  "tag": "section",
  "class": "section-wrapper lame-op-mini-banner-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "On Our Products / All products pages the banner is shown automatically above the product grid. Use this section only on other collection templates."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Our Products"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting text",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Custom link (optional)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "All Our Products"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "slim", "label": "Slim" },
        { "value": "regular", "label": "Regular" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fallback background",
      "default": "#f4b8c8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#3a1f28"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button color",
      "default": "#fc2779"
    }
  ],
  "presets": [
    {
      "name": "Our Products mini banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
