{%- liquid
  assign target_handle = section.settings.category_handle
  if target_handle == blank and template.suffix != blank
    assign target_handle = template.suffix
  endif

  assign banner_image = section.settings.image
  assign mobile_image = section.settings.image_mobile
  assign display_image = banner_image
  if display_image == blank
    assign display_image = mobile_image
  endif
  assign show_mobile_variant = false
  if mobile_image != blank and banner_image != blank
    assign show_mobile_variant = true
  endif
  assign banner_alt = section.settings.image_alt
  if banner_alt == blank and collection != blank
    assign banner_alt = collection.title | append: ' awareness'
  endif
  assign banner_alt = banner_alt | escape

  assign is_target_collection = false
  if collection != blank and target_handle != blank and collection.handle == target_handle
    assign is_target_collection = true
  endif

  assign show_banner = false
  if is_target_collection
    if display_image != blank or request.design_mode
      assign show_banner = true
    endif
  endif
-%}

{%- if show_banner -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <section
    class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-category-awareness lame-category-awareness--{{ collection.handle }}"
    {{ section.shopify_attributes }}
  >
    <div
      class="lame-category-awareness__wrap spacing-style"
      style="{% render 'spacing-padding', settings: section.settings %}"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="lame-category-awareness__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="lame-category-awareness__frame">
        {%- if section.settings.link != blank and display_image != blank -%}
          <a
            href="{{ section.settings.link }}"
            class="lame-category-awareness__link"
            {% if section.settings.open_in_new_tab %}
              target="_blank"
              rel="noopener"
            {% endif %}
          >
        {%- endif -%}

        {%- if display_image != blank -%}
          {%- liquid
            assign desktop_image_class = 'lame-category-awareness__image'
            if show_mobile_variant
              assign desktop_image_class = desktop_image_class | append: ' lame-category-awareness__image--desktop'
            endif
          -%}
          <picture>
            {%- if show_mobile_variant -%}
              {{
                mobile_image
                | image_url: width: 1200
                | image_tag:
                  class: 'lame-category-awareness__image lame-category-awareness__image--mobile',
                  loading: 'lazy',
                  widths: '375, 550, 750',
                  sizes: '100vw',
                  alt: banner_alt
              }}
            {%- endif -%}
            {{
              display_image
              | image_url: width: 3840
              | image_tag:
                class: desktop_image_class,
                loading: 'lazy',
                widths: '750, 990, 1200, 1600, 1920, 2560, 3840',
                sizes: '(min-width: 990px) min(100vw, var(--page-width)), 100vw',
                alt: banner_alt
            }}
          </picture>
        {%- elsif request.design_mode -%}
          <div class="lame-category-awareness__placeholder">
            <p>Upload an awareness image for this category.</p>
          </div>
        {%- endif -%}

        {%- if section.settings.link != blank and display_image != blank -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .lame-category-awareness {
    --lame-awareness-radius: 14px;
    width: 100%;
  }

  .lame-category-awareness__wrap {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
  }

  .section--full-width .lame-category-awareness__wrap {
    max-width: 100%;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
  }

  .lame-category-awareness__heading {
    margin: 0 0 1rem;
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--lame-cos-forest, 45 74 34));
    text-align: center;
  }

  .lame-category-awareness__frame {
    width: 100%;
    overflow: hidden;
    border-radius: var(--lame-awareness-radius);
    box-shadow: 0 10px 32px rgb(45 74 34 / 0.1);
    line-height: 0;
    background: #e8f0eb;
  }

  .lame-category-awareness__link {
    display: block;
    width: 100%;
    line-height: 0;
    text-decoration: none;
  }

  .lame-category-awareness__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0;
    border: none;
    object-fit: cover;
    object-position: center center;
  }

  .lame-category-awareness__image--mobile {
    display: none;
  }

  .lame-category-awareness__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 10rem;
    padding: 2rem;
    text-align: center;
    color: rgb(var(--lame-cos-forest, 45 74 34));
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .lame-category-awareness__placeholder p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .lame-category-awareness__frame {
      border-radius: 10px;
    }

    .lame-category-awareness:has(.lame-category-awareness__image--mobile) .lame-category-awareness__image--desktop {
      display: none;
    }

    .lame-category-awareness:has(.lame-category-awareness__image--mobile) .lame-category-awareness__image--mobile {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category awareness banner",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Each category has its own awareness section. This section only appears on the collection matching the category below."
    },
    {
      "type": "select",
      "id": "category_handle",
      "label": "Category",
      "options": [
        { "value": "bath-body", "label": "Bath & Body" },
        { "value": "fragrance", "label": "Fragrance" },
        { "value": "make-up", "label": "Makeup" },
        { "value": "skin-care", "label": "Skin Care" },
        { "value": "baby-mom", "label": "Mom & Baby" },
        { "value": "wellness", "label": "Wellness" },
        { "value": "hair-care", "label": "Hair Care" }
      ],
      "default": "skin-care"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Awareness image",
      "info": "Required. Recommended wide banner (~1920×640px or similar)."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Shown on phones instead of the desktop image."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading above image",
      "info": "Optional. Leave blank for image only."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Optional. Defaults to the collection name."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Banner link",
      "info": "Optional. Makes the whole banner clickable."
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Bath & Body awareness",
      "settings": {
        "category_handle": "bath-body",
        "heading": "Bath & Body awareness",
        "image_alt": "Bath & Body awareness banner"
      }
    },
    {
      "name": "Fragrance awareness",
      "settings": {
        "category_handle": "fragrance",
        "heading": "Fragrance awareness",
        "image_alt": "Fragrance awareness banner"
      }
    },
    {
      "name": "Makeup awareness",
      "settings": {
        "category_handle": "make-up",
        "heading": "Makeup awareness",
        "image_alt": "Makeup awareness banner"
      }
    },
    {
      "name": "Skin Care awareness",
      "settings": {
        "category_handle": "skin-care",
        "heading": "Skin Care awareness",
        "image_alt": "Skin Care awareness banner"
      }
    },
    {
      "name": "Mom & Baby awareness",
      "settings": {
        "category_handle": "baby-mom",
        "heading": "Mom & Baby awareness",
        "image_alt": "Mom & Baby awareness banner"
      }
    },
    {
      "name": "Wellness awareness",
      "settings": {
        "category_handle": "wellness",
        "heading": "Wellness awareness",
        "image_alt": "Wellness awareness banner"
      }
    },
    {
      "name": "Hair Care awareness",
      "settings": {
        "category_handle": "hair-care",
        "heading": "Hair Care awareness",
        "image_alt": "Hair Care awareness banner"
      }
    }
  ]
}
{% endschema %}
