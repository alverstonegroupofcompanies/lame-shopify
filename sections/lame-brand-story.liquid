<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--full-width color-{{ section.settings.color_scheme }} lame-brand-story"
  {{ section.shopify_attributes }}
>
  <div class="lame-brand-story__wrap">
    {%- if section.settings.image != blank -%}
      <div class="lame-brand-story__media" aria-hidden="true">
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            class: 'lame-brand-story__image',
            loading: 'lazy',
            widths: '750, 990, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: ''
        }}
      </div>
    {%- endif -%}
    <div class="lame-brand-story__overlay" aria-hidden="true"></div>
    <div class="lame-brand-story__content spacing-style" style="{% render 'spacing-padding', settings: section.settings %}" data-lame-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="lame-brand-story__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="lame-brand-story__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="lame-btn--outline-white lame-brand-story__cta"
          href="{{ section.settings.button_link | default: routes.root_url }}"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const node = section.querySelector('[data-lame-reveal]');
    if (!node) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(node);
    } else {
      node.classList.add('is-visible');
    }
  })();
</script>

{% stylesheet %}
  .lame-brand-story__wrap {
    position: relative;
    min-height: clamp(320px, 42vw, 480px);
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--lame-premium-forest);
  }

  .lame-brand-story__media,
  .lame-brand-story__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lame-brand-story__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(var(--brand-forest) / 0.55) 0%, rgb(var(--brand-forest-dark) / 0.88) 100%);
  }

  .lame-brand-story__content {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    margin-inline: auto;
    padding-inline: max(1rem, var(--page-margin));
    text-align: center;
    color: #fff;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  .lame-brand-story__content.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lame-brand-story__heading {
    margin: 0;
    font-family: var(--lame-font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .lame-brand-story__text {
    font-size: clamp(0.9rem, 1.2vw, 1rem);
    line-height: 1.65;
    color: rgb(255 255 255 / 0.88);
    max-width: 38ch;
  }

  .lame-brand-story__text p {
    margin: 0;
  }

  .lame-brand-story__cta {
    margin-top: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure Ingredients. Radiant You." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We believe in clean, conscious beauty — formulas rooted in nature and crafted for results you can see and feel every day.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Know More" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
