{%- comment -%}
  Homepage Best Offers — wave cards with image, badge, icon, CTA.
{%- endcomment -%}

{{ 'lame-discount-tiles.css' | asset_url | stylesheet_tag }}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-discount-tiles"
  aria-label="{{ section.settings.eyebrow | default: section.settings.heading | default: 'Best Offers' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-discount-tiles__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-discount-tiles__header" data-lame-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lame-discount-tiles__eyebrow">
          <span class="lame-discount-tiles__eyebrow-rule" aria-hidden="true"></span>
          <span class="lame-discount-tiles__eyebrow-text">{{ section.settings.eyebrow | escape }}</span>
          <span class="lame-discount-tiles__eyebrow-rule" aria-hidden="true"></span>
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="lame-discount-tiles__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="lame-discount-tiles__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <ul class="lame-discount-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_link = block.settings.link
          if block.settings.collection != blank
            assign tile_link = block.settings.collection.url
          endif

          assign percent = block.settings.percent | default: 50
          assign category = block.settings.category | default: 'Skincare'
          assign eyebrow = block.settings.eyebrow | default: 'UP TO'
          assign tile_type = block.settings.tile_type | default: 'percent'
          assign icon_name = block.settings.icon | default: 'leaf'
          assign cta_label = block.settings.cta_label | default: 'SHOP NOW'
          assign offer_line = block.settings.offer_line

          if offer_line == blank
            if tile_type == 'bogo'
              assign offer_line = 'BUY 1 GET 1 FREE'
            else
              assign offer_line = eyebrow | append: ' ' | append: percent | append: '% OFF'
            endif
          endif

          assign category_line = block.settings.category_line
          if category_line == blank
            if tile_type == 'bogo'
              assign category_line = 'on ' | append: category | append: ' Products'
            else
              assign category_line = 'on ' | append: category
            endif
          endif

          assign badge_line = block.settings.badge_text
          if badge_line == blank
            if tile_type == 'bogo'
              assign badge_line = 'BUY 1 GET 1'
            else
              assign badge_line = eyebrow | append: ' ' | append: percent | append: '% OFF'
            endif
          endif
        -%}

        <li class="lame-discount-tiles__item" {{ block.shopify_attributes }}>
          {%- if tile_link != blank -%}
            <a class="lame-discount-tile lame-discount-tile--{{ tile_type }}" href="{{ tile_link }}">
          {%- else -%}
            <div class="lame-discount-tile lame-discount-tile--{{ tile_type }}">
          {%- endif -%}

            <div class="lame-discount-tile__visual">
              <span class="lame-discount-tile__pattern" aria-hidden="true"></span>

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'lame-discount-tile__image',
                    loading: 'lazy',
                    widths: '320, 480, 640, 900',
                    sizes: '(min-width: 990px) 18vw, (min-width: 750px) 30vw, 70vw',
                    alt: category
                }}
              {%- elsif tile_type == 'bogo' -%}
                <div class="lame-discount-tile__bogo-visual" aria-hidden="true">
                  <span class="lame-discount-tile__bogo-kicker">SPECIAL OFFER</span>
                  <span class="lame-discount-tile__bogo-main">BUY 1</span>
                  <span class="lame-discount-tile__bogo-main lame-discount-tile__bogo-main--accent">GET 1 FREE</span>
                </div>
              {%- else -%}
                <div class="lame-discount-tile__placeholder" aria-hidden="true">
                  <span>{{ percent }}%</span>
                </div>
              {%- endif -%}

              <span class="lame-discount-tile__badge">
                <span class="lame-discount-tile__badge-text">{{ badge_line | escape }}</span>
              </span>

              <svg class="lame-discount-tile__wave" viewBox="0 0 400 48" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0,18 C70,48 130,0 200,22 C270,44 330,6 400,24 L400,48 L0,48 Z"></path>
              </svg>
            </div>

            <div class="lame-discount-tile__body">
              <span class="lame-discount-tile__icon" aria-hidden="true">
                {%- case icon_name -%}
                  {%- when 'mustache' -%}
                    <svg viewBox="0 0 48 24" fill="none"><path d="M4 14c4-8 10-10 14-6 2 2 3 3 6 3s4-1 6-3c4-4 10-2 14 6-5-2-8 1-12 3-3 1.5-5 1.5-8 0-4-2-7-5-12-3z" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- when 'baby' -%}
                    <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="18" r="10" stroke="currentColor" stroke-width="2.2"/><path d="M14 17.5h2M24 17.5h2M16 23c1.4 1.6 6.6 1.6 8 0" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M12 10c2-4 6-5 8-5s6 1 8 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M13 30h14" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                  {%- when 'venus' -%}
                    <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="14" r="8" stroke="currentColor" stroke-width="2.2"/><path d="M20 22v12M14 28h12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                  {%- when 'gift' -%}
                    <svg viewBox="0 0 40 40" fill="none"><rect x="8" y="16" width="24" height="16" rx="2" stroke="currentColor" stroke-width="2.2"/><path d="M8 22h24M20 16v16M20 16c-4-6-10-4-10 0 0 2.5 4 4 10 4M20 16c4-6 10-4 10 0 0 2.5-4 4-10 4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 40 40" fill="none"><path d="M20 34c8-6 12-12 12-18a8 8 0 0 0-16 0c0-6-4-8-8-8-2 8 2 16 12 26z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M14 18c2 2 4 3 6 3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
                {%- endcase -%}
              </span>

              <p class="lame-discount-tile__offer">
                <span class="lame-discount-tile__offer-strong">{{ offer_line | escape }}</span>
                <span class="lame-discount-tile__offer-cat">{{ category_line | escape }}</span>
              </p>

              <span class="lame-discount-tile__cta">
                {{ cta_label | escape }}
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>

          {%- if tile_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Discount tiles",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BEST OFFERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grab the Best Deals on Your Favorites"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Limited time offers on skincare, baby care, hygiene & more"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Discount tile",
      "settings": [
        {
          "type": "select",
          "id": "tile_type",
          "label": "Tile type",
          "options": [
            { "value": "percent", "label": "Percent off" },
            { "value": "bogo", "label": "Buy 1 Get 1 Free" }
          ],
          "default": "percent"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (skincare)" },
            { "value": "mustache", "label": "Mustache (men)" },
            { "value": "baby", "label": "Baby" },
            { "value": "venus", "label": "Venus (hygiene)" },
            { "value": "gift", "label": "Gift (special)" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "UP TO"
        },
        {
          "type": "range",
          "id": "percent",
          "label": "Percent",
          "min": 5,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text (optional)",
          "info": "Defaults from eyebrow + percent, or BOGO"
        },
        {
          "type": "text",
          "id": "offer_line",
          "label": "Offer line (optional)",
          "info": "e.g. UP TO 50% OFF"
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category label",
          "default": "Skincare"
        },
        {
          "type": "text",
          "id": "category_line",
          "label": "Category line (optional)",
          "info": "e.g. on Skincare"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)",
          "info": "Used only if no collection is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discount tiles",
      "category": "Banners",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "icon": "leaf",
            "eyebrow": "UP TO",
            "percent": 50,
            "category": "Skincare"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "icon": "mustache",
            "eyebrow": "UP TO",
            "percent": 25,
            "category": "Men's Care"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "icon": "baby",
            "eyebrow": "UP TO",
            "percent": 15,
            "category": "Baby Care"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "icon": "venus",
            "eyebrow": "UP TO",
            "percent": 20,
            "category": "Female Hygiene"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "bogo",
            "icon": "gift",
            "category": "Selected",
            "category_line": "on Selected Products"
          }
        }
      ]
    }
  ]
}
{% endschema %}
