{%- comment -%}
  Homepage Best Offers — single-image slideshow (editable slides + links).
{%- endcomment -%}

{{ 'lame-discount-tiles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign slide_count = 0
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-discount-tiles"
  aria-label="{{ section.settings.eyebrow | default: section.settings.heading | default: 'Best Offers' | escape }}"
  data-offer-slider
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | default: 5 }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-discount-tiles__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtitle != blank -%}
      <header class="lame-discount-tiles__header" data-lame-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lame-discount-tiles__eyebrow">
            <span class="lame-discount-tiles__eyebrow-rule" aria-hidden="true"></span>
            <span class="lame-discount-tiles__eyebrow-text">{{ section.settings.eyebrow | escape }}</span>
            <span class="lame-discount-tiles__eyebrow-rule" aria-hidden="true"></span>
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="lame-discount-tiles__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="lame-discount-tiles__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="lame-offer-stage">
      <div class="lame-offer-stage__side lame-offer-stage__side--left" aria-hidden="true">
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--lg" viewBox="0 0 120 120" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="60" cy="60" r="10" stroke-width="1.4" opacity="0.55"/>
            <circle cx="60" cy="60" r="22" stroke-width="1.1" opacity="0.4"/>
            <circle cx="60" cy="60" r="36" stroke-width="1" opacity="0.28"/>
            <path d="M60 18c6 10 6 20 0 30-6-10-6-20 0-30Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M60 72c6 10 6 20 0 30-6-10-6-20 0-30Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M18 60c10-6 20-6 30 0-10 6-20 6-30 0Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M72 60c10-6 20-6 30 0-10 6-20 6-30 0Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M30 30c10 4 16 10 20 20-10-4-16-10-20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M70 70c10 4 16 10 20 20-10-4-16-10-20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M90 30c-4 10-10 16-20 20 4-10 10-16 20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M50 70c-4 10-10 16-20 20 4-10 10-16 20-20Z" stroke-width="1.1" opacity="0.42"/>
            <circle cx="60" cy="60" r="3.2" fill="currentColor" stroke="none" opacity="0.45"/>
          </g>
        </svg>
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--sm" viewBox="0 0 80 80" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="40" cy="40" r="8" stroke-width="1.2" opacity="0.45"/>
            <path d="M40 12c4 7 4 14 0 21-4-7-4-14 0-21Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M40 47c4 7 4 14 0 21-4-7-4-14 0-21Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M12 40c7-4 14-4 21 0-7 4-14 4-21 0Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M47 40c7-4 14-4 21 0-7 4-14 4-21 0Z" stroke-width="1.1" opacity="0.5"/>
            <circle cx="40" cy="40" r="2.4" fill="currentColor" stroke="none" opacity="0.4"/>
          </g>
        </svg>
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--md" viewBox="0 0 100 100" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="50" cy="50" r="18" stroke-width="1" opacity="0.3"/>
            <path d="M50 16c5 8 5 16 0 24-5-8-5-16 0-24Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M50 60c5 8 5 16 0 24-5-8-5-16 0-24Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M16 50c8-5 16-5 24 0-8 5-16 5-24 0Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M60 50c8-5 16-5 24 0-8 5-16 5-24 0Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M26 26c8 3 13 8 16 16-8-3-13-8-16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M58 58c8 3 13 8 16 16-8-3-13-8-16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M74 26c-3 8-8 13-16 16 3-8 8-13 16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M42 58c-3 8-8 13-16 16 3-8 8-13 16-16Z" stroke-width="1" opacity="0.38"/>
            <circle cx="50" cy="50" r="2.8" fill="currentColor" stroke="none" opacity="0.42"/>
          </g>
        </svg>
      </div>

      <div class="lame-offer-slider">
        {%- if slide_count > 1 -%}
          <button
            type="button"
            class="lame-offer-slider__nav lame-offer-slider__nav--prev"
            data-offer-prev
            aria-label="{{ section.settings.prev_label | default: 'Previous offer' | escape }}"
          >
            <span aria-hidden="true">&#8249;</span>
          </button>
        {%- endif -%}

        <div class="lame-offer-slider__viewport" data-offer-viewport>
          <ul class="lame-offer-slider__track" role="list" data-offer-track>
            {%- assign visible_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- liquid
                assign slide_link = block.settings.link
                if block.settings.collection != blank
                  assign slide_link = block.settings.collection.url
                endif
                assign image_alt = block.settings.image_alt | default: section.settings.heading | default: 'Offer'
              -%}

              {%- if block.settings.image == blank and request.design_mode == false -%}
                {%- continue -%}
              {%- endif -%}

              <li
                class="lame-offer-slider__slide{% if visible_index == 0 %} is-active{% endif %}"
                data-offer-slide
                {{ block.shopify_attributes }}
              >
                {%- if slide_link != blank -%}
                  <a
                    class="lame-offer-slider__link"
                    href="{{ slide_link }}"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank"
                      rel="noopener"
                    {% endif %}
                  >
                {%- else -%}
                  <div class="lame-offer-slider__link">
                {%- endif -%}

                  {%- if block.settings.image != blank -%}
                    {%- liquid
                      if visible_index == 0
                        assign image_loading = 'eager'
                      else
                        assign image_loading = 'lazy'
                      endif
                    -%}
                    {{
                      block.settings.image
                      | image_url: width: 1800
                      | image_tag:
                        class: 'lame-offer-slider__image',
                        loading: image_loading,
                        widths: '640, 900, 1200, 1500, 1800',
                        sizes: '(max-width: 749px) 20.5rem, (max-width: 1199px) min(100vw - 1.5rem, 34rem), min(920px, 70vw)',
                        alt: image_alt
                    }}
                  {%- else -%}
                    <div class="lame-offer-slider__placeholder">
                      <span>Add offer image</span>
                      <small>Theme editor → Offer slide → Image</small>
                    </div>
                  {%- endif -%}

                {%- if slide_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
              {%- assign visible_index = visible_index | plus: 1 -%}
            {%- endfor -%}

            {%- if visible_index == 0 and request.design_mode -%}
              <li class="lame-offer-slider__slide is-active" data-offer-slide>
                <div class="lame-offer-slider__link">
                  <div class="lame-offer-slider__placeholder">
                    <span>Add offer slides</span>
                    <small>Add blocks with image + link</small>
                  </div>
                </div>
              </li>
            {%- endif -%}
          </ul>
        </div>

        {%- if slide_count > 1 -%}
          <button
            type="button"
            class="lame-offer-slider__nav lame-offer-slider__nav--next"
            data-offer-next
            aria-label="{{ section.settings.next_label | default: 'Next offer' | escape }}"
          >
            <span aria-hidden="true">&#8250;</span>
          </button>
        {%- endif -%}
      </div>

      <div class="lame-offer-stage__side lame-offer-stage__side--right" aria-hidden="true">
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--md" viewBox="0 0 100 100" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="50" cy="50" r="18" stroke-width="1" opacity="0.3"/>
            <path d="M50 16c5 8 5 16 0 24-5-8-5-16 0-24Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M50 60c5 8 5 16 0 24-5-8-5-16 0-24Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M16 50c8-5 16-5 24 0-8 5-16 5-24 0Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M60 50c8-5 16-5 24 0-8 5-16 5-24 0Z" stroke-width="1.15" opacity="0.48"/>
            <path d="M26 26c8 3 13 8 16 16-8-3-13-8-16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M58 58c8 3 13 8 16 16-8-3-13-8-16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M74 26c-3 8-8 13-16 16 3-8 8-13 16-16Z" stroke-width="1" opacity="0.38"/>
            <path d="M42 58c-3 8-8 13-16 16 3-8 8-13 16-16Z" stroke-width="1" opacity="0.38"/>
            <circle cx="50" cy="50" r="2.8" fill="currentColor" stroke="none" opacity="0.42"/>
          </g>
        </svg>
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--sm" viewBox="0 0 80 80" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="40" cy="40" r="8" stroke-width="1.2" opacity="0.45"/>
            <path d="M40 12c4 7 4 14 0 21-4-7-4-14 0-21Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M40 47c4 7 4 14 0 21-4-7-4-14 0-21Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M12 40c7-4 14-4 21 0-7 4-14 4-21 0Z" stroke-width="1.1" opacity="0.5"/>
            <path d="M47 40c7-4 14-4 21 0-7 4-14 4-21 0Z" stroke-width="1.1" opacity="0.5"/>
            <circle cx="40" cy="40" r="2.4" fill="currentColor" stroke="none" opacity="0.4"/>
          </g>
        </svg>
        <svg class="lame-offer-stage__ornament lame-offer-stage__ornament--lg" viewBox="0 0 120 120" focusable="false">
          <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="60" cy="60" r="10" stroke-width="1.4" opacity="0.55"/>
            <circle cx="60" cy="60" r="22" stroke-width="1.1" opacity="0.4"/>
            <circle cx="60" cy="60" r="36" stroke-width="1" opacity="0.28"/>
            <path d="M60 18c6 10 6 20 0 30-6-10-6-20 0-30Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M60 72c6 10 6 20 0 30-6-10-6-20 0-30Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M18 60c10-6 20-6 30 0-10 6-20 6-30 0Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M72 60c10-6 20-6 30 0-10 6-20 6-30 0Z" stroke-width="1.2" opacity="0.5"/>
            <path d="M30 30c10 4 16 10 20 20-10-4-16-10-20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M70 70c10 4 16 10 20 20-10-4-16-10-20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M90 30c-4 10-10 16-20 20 4-10 10-16 20-20Z" stroke-width="1.1" opacity="0.42"/>
            <path d="M50 70c-4 10-10 16-20 20 4-10 10-16 20-20Z" stroke-width="1.1" opacity="0.42"/>
            <circle cx="60" cy="60" r="3.2" fill="currentColor" stroke="none" opacity="0.45"/>
          </g>
        </svg>
      </div>
    </div>

    {%- if slide_count > 1 and section.settings.show_dots -%}
      <div class="lame-offer-slider__dots" data-offer-dots role="tablist" aria-label="Offer slides">
        {%- assign dot_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image == blank and request.design_mode == false -%}
            {%- continue -%}
          {%- endif -%}
          <button
            type="button"
            class="lame-offer-slider__dot{% if dot_index == 0 %} is-active{% endif %}"
            data-offer-dot="{{ dot_index }}"
            aria-label="Go to slide {{ dot_index | plus: 1 }}"
          ></button>
          {%- assign dot_index = dot_index | plus: 1 -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('#shopify-section-{{ section.id }} [data-offer-slider]');
    if (!root) return;

    const track = root.querySelector('[data-offer-track]');
    const slides = Array.from(root.querySelectorAll('[data-offer-slide]'));
    const prev = root.querySelector('[data-offer-prev]');
    const next = root.querySelector('[data-offer-next]');
    const dots = Array.from(root.querySelectorAll('[data-offer-dot]'));
    if (!track || slides.length === 0) return;

    let index = 0;
    let timer = null;
    const autoplay = root.dataset.autoplay === 'true' && slides.length > 1;
    const speed = Math.max(2, Number(root.dataset.autoplaySpeed) || 5) * 1000;

    const setActive = (nextIndex) => {
      index = (nextIndex + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
      });
      track.style.transform = `translateX(-${index * 100}%)`;
    };

    const stop = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const start = () => {
      if (!autoplay) return;
      stop();
      timer = window.setInterval(() => setActive(index + 1), speed);
    };

    prev?.addEventListener('click', () => {
      setActive(index - 1);
      start();
    });
    next?.addEventListener('click', () => {
      setActive(index + 1);
      start();
    });
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        setActive(Number(dot.dataset.offerDot) || 0);
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    setActive(0);
    start();
  })();
</script>

{% schema %}
{
  "name": "Best Offers slider",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "BEST OFFERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Grab the Best Deals on Your Favorites"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Limited time offers on skincare, baby care, hygiene & more"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous button label",
      "default": "Previous offer"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next offer"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "slide",
      "name": "Offer slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)",
          "info": "Used only if no collection is selected"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Offers slider",
      "category": "Banners",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
