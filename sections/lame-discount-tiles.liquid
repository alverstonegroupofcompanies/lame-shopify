{%- comment -%}
  Homepage discount tiles — CSS promo style matching sale creatives.
{%- endcomment -%}

{{ 'lame-discount-tiles.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Montserrat:wght@700;800;900&family=Pacifico&display=swap"
  rel="stylesheet"
>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-discount-tiles"
  aria-label="{{ section.settings.heading | default: 'Discount offers' | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-discount-tiles__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <header class="lame-discount-tiles__header">
        <h2 class="lame-discount-tiles__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    <ul class="lame-discount-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_link = block.settings.link
          if block.settings.collection != blank
            assign tile_link = block.settings.collection.url
          endif

          assign percent = block.settings.percent | default: 50
          assign category = block.settings.category | default: 'Skincare'
          assign eyebrow = block.settings.eyebrow | default: 'UP TO'
          assign tile_type = block.settings.tile_type | default: 'percent'
        -%}

        <li class="lame-discount-tiles__item" {{ block.shopify_attributes }}>
          {%- if tile_link != blank -%}
            <a class="lame-discount-tile lame-discount-tile--{{ tile_type }}" href="{{ tile_link }}">
          {%- else -%}
            <div class="lame-discount-tile lame-discount-tile--{{ tile_type }}">
          {%- endif -%}

            <span class="lame-discount-tile__halftone" aria-hidden="true"></span>
            <span class="lame-discount-tile__sparkles" aria-hidden="true"></span>

            {%- if tile_type == 'bogo' -%}
              <span class="lame-discount-tile__eyebrow">
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
                SPECIAL OFFER
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
              </span>
              <span class="lame-discount-tile__bogo">
                <span class="lame-discount-tile__bogo-line">BUY 1</span>
                <span class="lame-discount-tile__bogo-get">GET 1</span>
                <span class="lame-discount-tile__bogo-free">FREE</span>
              </span>
              <span class="lame-discount-tile__for">
                <span class="lame-discount-tile__rule lame-discount-tile__rule--gold" aria-hidden="true"></span>
                on
                <span class="lame-discount-tile__rule lame-discount-tile__rule--gold" aria-hidden="true"></span>
              </span>
              <span class="lame-discount-tile__category">{{ category | upcase | escape }}</span>
              <span class="lame-discount-tile__products">products</span>
            {%- else -%}
              <span class="lame-discount-tile__eyebrow">
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
                {{ eyebrow | upcase | escape }}
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
              </span>
              <span class="lame-discount-tile__offer" aria-hidden="true">
                <span class="lame-discount-tile__number">{{ percent }}</span>
                <span class="lame-discount-tile__suffix">
                  <span class="lame-discount-tile__percent">%</span>
                  <span class="lame-discount-tile__off">off</span>
                </span>
              </span>
              <span class="visually-hidden">{{ eyebrow }} {{ percent }}% off</span>
              <span class="lame-discount-tile__for">
                <span class="lame-discount-tile__rule lame-discount-tile__rule--gold" aria-hidden="true"></span>
                for
                <span class="lame-discount-tile__rule lame-discount-tile__rule--gold" aria-hidden="true"></span>
              </span>
              <span class="lame-discount-tile__category">{{ category | upcase | escape }}</span>
              <span class="lame-discount-tile__products">
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
                products
                <span class="lame-discount-tile__rule" aria-hidden="true"></span>
              </span>
            {%- endif -%}

          {%- if tile_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Discount tiles",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Category offers"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Discount tile",
      "settings": [
        {
          "type": "select",
          "id": "tile_type",
          "label": "Tile type",
          "options": [
            { "value": "percent", "label": "Percent off" },
            { "value": "bogo", "label": "Buy 1 Get 1 Free" }
          ],
          "default": "percent"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "UP TO"
        },
        {
          "type": "range",
          "id": "percent",
          "label": "Percent",
          "min": 5,
          "max": 90,
          "step": 5,
          "unit": "%",
          "default": 50
        },
        {
          "type": "text",
          "id": "category",
          "label": "Category label",
          "default": "Skincare"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link (optional)",
          "info": "Used only if no collection is selected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Discount tiles",
      "category": "Banners",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "eyebrow": "UP TO",
            "percent": 50,
            "category": "Skincare"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "eyebrow": "UP TO",
            "percent": 25,
            "category": "Men's care"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "eyebrow": "UP TO",
            "percent": 15,
            "category": "Baby care"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "percent",
            "eyebrow": "UP TO",
            "percent": 20,
            "category": "Female Hygiene"
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_type": "bogo",
            "category": "Selected"
          }
        }
      ]
    }
  ]
}
{% endschema %}
