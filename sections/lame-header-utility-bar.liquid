{%- liquid
  assign phone = section.settings.phone | default: shop.phone
  assign show_contact = false
  if section.settings.show_contact and phone != blank
    assign show_contact = true
  endif

  assign promo_text = section.settings.promo_text | strip_html | strip
  assign show_promo = false
  if promo_text != blank
    assign show_promo = true
  endif

  assign social_keys = 'facebook_url,instagram_url,youtube_url,tiktok_url,twitter_url,pinterest_url' | split: ','
  assign show_social = false
  if section.settings.show_social
    for link_key in social_keys
      if section.settings[link_key] != blank
        assign show_social = true
        break
      endif
    endfor
  endif

  assign show_bar = false
  if request.design_mode
    assign show_bar = true
  elsif show_contact or show_promo or show_social
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  <div class="lame-utility-bar-section" data-testid="lame-header-utility-bar">
    <div class="section-background color-{{ section.settings.color_scheme }}"></div>
      <aside
        class="lame-utility-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
        style="{% render 'spacing-padding', settings: section.settings %}"
        aria-label="{{ section.settings.accessibility_label | escape }}"
      >
        <div class="lame-utility-bar__grid page-width">
          <div class="lame-utility-bar__start">
            {%- if show_contact -%}
              <a class="lame-utility-bar__contact" href="tel:{{ phone | replace: ' ', '' | replace: '-', '' }}">
                <span class="lame-utility-bar__contact-label">{{ section.settings.contact_label }}</span>
                <span class="lame-utility-bar__contact-value">{{ phone }}</span>
              </a>
            {%- elsif request.design_mode and section.settings.show_contact -%}
              <span class="lame-utility-bar__placeholder">{{ section.settings.contact_label }} — add a phone number in section settings</span>
            {%- endif -%}
          </div>

          <div class="lame-utility-bar__center">
            {%- if show_promo -%}
              <div class="lame-utility-bar__promo">
                {{ section.settings.promo_text }}
                {%- if section.settings.promo_link != blank and section.settings.promo_link_label != blank -%}
                  <a class="lame-utility-bar__promo-link" href="{{ section.settings.promo_link }}">
                    {{ section.settings.promo_link_label }}
                  </a>
                {%- endif -%}
              </div>
            {%- elsif request.design_mode -%}
              <p class="lame-utility-bar__placeholder">Add promo text in section settings</p>
            {%- endif -%}
          </div>

          <div class="lame-utility-bar__end">
            {%- if show_social -%}
              {% render 'lame-utility-bar-social', settings: section.settings %}
            {%- endif -%}
          </div>
        </div>
      </aside>
  </div>
{%- endif -%}

{% stylesheet %}
  .lame-utility-bar {
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    border-block-end: 1px solid rgb(var(--color-border-rgb) / 0.25);
  }

  .lame-utility-bar__grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--gap-md);
    min-height: 2.25rem;
  }

  .lame-utility-bar__start {
    justify-self: start;
    min-width: 0;
  }

  .lame-utility-bar__center {
    justify-self: center;
    text-align: center;
    min-width: 0;
    max-width: min(42rem, 100%);
  }

  .lame-utility-bar__end {
    justify-self: end;
    display: block;
  }

  .lame-utility-bar__contact {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .lame-utility-bar__contact:hover,
  .lame-utility-bar__contact:focus-visible {
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lame-utility-bar__contact-label {
    font-weight: 600;
  }

  .lame-utility-bar__promo {
    margin: 0;
    line-height: 1.4;
    font-weight: 500;
  }

  .lame-utility-bar__promo :first-child {
    margin: 0;
    display: inline;
  }

  .lame-utility-bar__promo-link {
    margin-inline-start: 0.35rem;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    text-decoration-thickness: 1px;
  }

  .lame-utility-bar__promo-link:hover,
  .lame-utility-bar__promo-link:focus-visible {
    opacity: 0.85;
  }

  .lame-utility-bar__placeholder {
    margin: 0;
    opacity: 0.55;
    font-size: 0.6875rem;
  }

  .lame-utility-bar__social-list {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lame-utility-bar__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.35);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .lame-utility-bar__social-link:hover,
  .lame-utility-bar__social-link:focus-visible {
    background: rgb(var(--color-foreground-rgb) / 0.12);
    border-color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .lame-utility-bar__social-icon {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    .lame-utility-bar__grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.35rem;
      padding-block: 0.15rem;
    }

    .lame-utility-bar__start,
    .lame-utility-bar__end {
      display: none;
    }

    .lame-utility-bar__center {
      max-width: 100%;
    }

    .lame-utility-bar__promo {
      font-size: 0.6875rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header utility bar",
  "tag": "section",
  "class": "lame-header-utility-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contact (left)"
    },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Call us:"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "Leave blank to use the store phone from Shopify admin settings."
    },
    {
      "type": "header",
      "content": "Promotion (center)"
    },
    {
      "type": "richtext",
      "id": "promo_text",
      "label": "Promo message",
      "default": "<p>Sign up and GET 25% OFF for your first order.</p>"
    },
    {
      "type": "url",
      "id": "promo_link",
      "label": "Promo link"
    },
    {
      "type": "text",
      "id": "promo_link_label",
      "label": "Promo link text",
      "default": "Sign up now"
    },
    {
      "type": "header",
      "content": "Social (right)"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X / Twitter"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Region label (screen readers)",
      "default": "Store contact and offers"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-cosmetic-bar",
      "info": "Cosmetic Bar uses a dark green scheme; pick any dark scheme for a similar look."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Header utility bar"
    }
  ]
}
{% endschema %}
