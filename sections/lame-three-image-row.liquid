{%- liquid
  assign img_1 = section.settings.image_1
  assign img_2 = section.settings.image_2
  assign img_3 = section.settings.image_3

  assign alt_1 = section.settings.alt_1 | default: shop.name | escape
  assign alt_2 = section.settings.alt_2 | default: shop.name | escape
  assign alt_3 = section.settings.alt_3 | default: shop.name | escape
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-three-image-row"
  {{ section.shopify_attributes }}
>
  <div class="lame-three-image-row__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <header class="lame-three-image-row__header" data-lame-reveal>
        <h2 class="lame-three-image-row__heading">{{ section.settings.heading | escape }}</h2>
      </header>
    {%- endif -%}

    <div class="lame-three-image-row__grid">
      {%- for i in (1..3) -%}
        {%- liquid
          assign img = img_1
          assign alt = alt_1
          if i == 2
            assign img = img_2
            assign alt = alt_2
          elsif i == 3
            assign img = img_3
            assign alt = alt_3
          endif

          assign link_setting = section.settings.link_1
          if i == 2
            assign link_setting = section.settings.link_2
          elsif i == 3
            assign link_setting = section.settings.link_3
          endif
        -%}

        <div class="lame-three-image-row__item">
          {%- if link_setting != blank -%}
            <a
              class="lame-three-image-row__link"
              href="{{ link_setting }}"
              {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener"{% endif %}
            >
          {%- endif -%}

          {%- if img != blank -%}
            {{
              img
              | image_url: width: 2400
              | image_tag:
                class: 'lame-three-image-row__image',
                loading: 'lazy',
                widths: '550, 750, 990, 1200, 1600, 2000, 2400',
                sizes: '(min-width: 990px) calc((min(100vw, var(--page-width)) - (var(--lame-three-image-row-gap) * 2)) / 3), 100vw',
                alt: alt
            }}
          {%- else -%}
            <img
              class="lame-three-image-row__image"
              src="{{ 'lame-tips-banner-' | append: i | append: '.png' | asset_url }}"
              alt="{{ alt }}"
              width="1600"
              height="900"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}

          {%- if link_setting != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-three-image-row {
    --lame-three-image-row-gap: 16px;
    --lame-three-image-row-radius: 14px;
  }

  .lame-three-image-row__wrap {
    width: 100%;
    max-width: min(100%, var(--page-width, 1200px));
    margin-inline: auto;
    box-sizing: border-box;
  }

  .section--full-width .lame-three-image-row__wrap {
    max-width: 100%;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
  }

  .lame-three-image-row__header {
    text-align: center;
    margin-bottom: clamp(0.75rem, 2vw, 1.25rem);
  }

  .lame-three-image-row__heading {
    margin: 0;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.25rem, 2.5vw, 1.6rem);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .lame-three-image-row__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--lame-three-image-row-gap);
  }

  .lame-three-image-row__item {
    overflow: hidden;
    border-radius: var(--lame-three-image-row-radius);
    background: #e8f0eb;
    box-shadow: 0 10px 30px rgb(24 18 16 / 0.08);
  }

  .lame-three-image-row__link {
    display: block;
    width: 100%;
    text-decoration: none;
    line-height: 0;
  }

  .lame-three-image-row__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    object-position: center;
  }

  @media screen and (min-width: 750px) {
    .lame-three-image-row__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-three-image-row__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Three image row",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beauty tips"
    },
    {
      "type": "header",
      "content": "Images"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "text", "id": "alt_1", "label": "Alt text 1", "default": "Beauty tip banner 1" },
    { "type": "url", "id": "link_1", "label": "Link 1 (optional)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "alt_2", "label": "Alt text 2", "default": "Beauty tip banner 2" },
    { "type": "url", "id": "link_2", "label": "Link 2 (optional)" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "text", "id": "alt_3", "label": "Alt text 3", "default": "Beauty tip banner 3" },
    { "type": "url", "id": "link_3", "label": "Link 3 (optional)" },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open links in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    { "name": "Three image row", "category": "Banners" }
  ]
}
{% endschema %}
