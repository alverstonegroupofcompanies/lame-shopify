{% liquid
  assign title = section.settings.heading
  if title == blank and collection != blank
    assign title = collection.title
  endif
  if title == blank
    assign title = 'Healthcare Essentials for Everyday Wellness'
  endif
  assign subtitle = section.settings.subtitle
  if subtitle == blank
    assign subtitle = 'Trusted products from leading brands curated for your family.'
  endif
  assign eyebrow = section.settings.eyebrow
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lame-our-products-intro lame-op-hero lame-our-products-intro--{{ section.settings.heading_alignment | default: 'left' }} spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-op-hero__botanical" aria-hidden="true"></div>
  <div class="lame-op-hero__overlay" aria-hidden="true"></div>
  <div class="lame-op-hero__inner lame-our-products-intro__inner">
    {% if eyebrow != blank %}
      <p class="lame-our-products-intro__eyebrow lame-op-hero__eyebrow">{{ eyebrow | escape }}</p>
    {% endif %}
    <div class="lame-op-hero__content">
      <h1 class="lame-op-hero__heading">{{ title | escape }}</h1>
      {% if subtitle != blank %}
        <p class="lame-op-hero__subheading">{{ subtitle | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Our products header",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Healthcare Essentials for Everyday Wellness"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted products from leading brands curated for your family."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Gold divider under title",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Our products header",
      "category": "Collection"
    }
  ]
}
{% endschema %}
