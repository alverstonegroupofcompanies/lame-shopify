{% liquid
  assign title = section.settings.heading
  if title == blank and collection != blank
    assign title = collection.title
  endif
  if title == blank
    assign title = 'Our products'
  endif
  assign subtitle = section.settings.subtitle
  assign eyebrow = section.settings.eyebrow
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lame-our-products-intro lame-our-products-intro--{{ section.settings.heading_alignment | default: 'left' }} spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-our-products-intro__inner">
    {% if eyebrow != blank %}
      <p class="lame-our-products-intro__eyebrow">{{ eyebrow | escape }}</p>
    {% endif %}
    {% render 'lame-section-heading',
      title: title,
      subtitle: subtitle,
      alignment: section.settings.heading_alignment,
      size: section.settings.heading_size,
      show_divider: section.settings.show_divider,
      class: 'lame-our-products-intro__heading'
    %}
  </div>
</div>

{% stylesheet %}
  .lame-our-products-intro {
    --lame-section-heading-color: #2d472c;
    --lame-section-heading-accent: #2d472c;
    --lame-section-heading-ornament: rgb(45 71 44 / 0.35);
  }

  .lame-our-products-intro__inner {
    padding-inline: clamp(1rem, 3vw, 2rem);
    max-width: 1520px;
    margin-inline: auto;
  }

  .lame-our-products-intro--left .lame-our-products-intro__inner,
  .lame-our-products-intro--left .lame-section-heading {
    text-align: left;
    align-items: flex-start;
  }

  .template-collection-our-products .lame-our-products-intro {
    position: relative;
    padding-block-end: 0.35rem !important;
    overflow: hidden;
  }

  .template-collection-our-products .lame-our-products-intro::before {
    content: '';
    position: absolute;
    top: -10%;
    right: -4%;
    width: min(42vw, 420px);
    height: min(42vw, 420px);
    pointer-events: none;
    opacity: 0.22;
    background:
      radial-gradient(ellipse at 70% 30%, rgb(45 71 44 / 0.35) 0%, transparent 58%),
      radial-gradient(ellipse at 40% 60%, rgb(90 120 70 / 0.28) 0%, transparent 52%),
      radial-gradient(ellipse at 80% 75%, rgb(45 71 44 / 0.2) 0%, transparent 48%);
    filter: blur(1px);
    z-index: 0;
  }

  .template-collection-our-products .lame-our-products-intro__inner {
    position: relative;
    z-index: 1;
  }

  .template-collection-our-products .lame-our-products-intro__eyebrow {
    display: none;
  }

  .template-collection-our-products .lame-our-products-intro .lame-section-heading__divider {
    display: block;
    margin-block: 0.5rem 0.35rem;
    color: rgb(45 71 44 / 0.4);
  }

  .template-collection-our-products .lame-our-products-intro .lame-section-heading__title {
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(2rem, 3.5vw, 2.5rem);
    font-weight: 600;
    color: #2d472c;
    letter-spacing: 0.01em;
  }

  .template-collection-our-products .lame-our-products-intro .lame-section-heading__subtitle {
    margin-top: 0.35rem;
    max-width: 42rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: #6b635c;
  }

  .lame-our-products-intro__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb));
  }

  .lame-our-products-intro--center .lame-our-products-intro__eyebrow {
    text-align: center;
  }

  .lame-our-products-intro .lame-our-products-intro__heading.lame-section-heading {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our products header",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Skincare & beauty"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our products"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated rituals for radiant skin — filter, explore, and add to your routine."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Gold divider under title",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Our products header",
      "category": "Collection"
    }
  ]
}
{% endschema %}
