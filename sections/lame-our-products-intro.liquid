{% liquid
  assign title = section.settings.heading
  if title == blank and collection != blank
    assign title = collection.title
  endif
  if title == blank
    assign title = 'Our products'
  endif

  assign subtitle = section.settings.subtitle
  assign eyebrow = section.settings.eyebrow
%}

{% if title != blank or subtitle != blank or eyebrow != blank or request.design_mode %}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="lame-our-products-intro lame-our-products-intro--{{ section.settings.heading_alignment }} spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-style', settings: section.settings %}"
    {{ section.shopify_attributes }}
  >
    <div class="lame-our-products-intro__inner">
      {% if eyebrow != blank %}
        <p class="lame-our-products-intro__eyebrow">{{ eyebrow | escape }}</p>
      {% endif %}

      {% render 'lame-section-heading',
        title: title,
        subtitle: subtitle,
        alignment: section.settings.heading_alignment,
        size: section.settings.heading_size,
        show_divider: section.settings.show_divider,
        class: 'lame-our-products-intro__heading'
      %}

      {% if request.design_mode and section.settings.heading == blank %}
        <p class="lame-our-products-intro__placeholder-hint">
          Optional: set a custom heading, or leave blank to use the collection title.
        </p>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .lame-our-products-intro {
    --lame-section-heading-color: rgb(var(--color-foreground-heading-rgb));
    --lame-section-heading-ornament: rgb(var(--brand-gold-strong));
    width: 100%;
  }

  .lame-our-products-intro__inner {
    padding-inline: var(--page-margin);
    max-width: 100%;
  }

  .lame-our-products-intro__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb));
    text-align: inherit;
  }

  .lame-our-products-intro--center .lame-our-products-intro__eyebrow {
    text-align: center;
  }

  .lame-our-products-intro--left .lame-our-products-intro__eyebrow {
    text-align: left;
  }

  .lame-our-products-intro--right .lame-our-products-intro__eyebrow {
    text-align: right;
  }

  .lame-our-products-intro .lame-our-products-intro__heading.lame-section-heading {
    margin-bottom: 0;
  }

  .lame-our-products-intro__placeholder-hint {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    opacity: 0.65;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our products intro",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection.our-products"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown on the Our products collection template. Heading defaults to the collection title when empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Shop",
      "info": "Small line above the title (e.g. category label)."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our products",
      "info": "Leave blank to use the current collection name."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated essentials with the finish and care you expect from LAMÉ."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show gold divider under title",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Our products intro",
      "category": "Banners"
    }
  ]
}
{% endschema %}
