{% liquid
  assign title = section.settings.heading
  if title == blank and collection != blank
    assign title = collection.title
  endif
  if title == blank
    assign title = 'Our products'
  endif
  assign subtitle = section.settings.subtitle
  assign eyebrow = section.settings.eyebrow
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lame-our-products-intro lame-our-products-intro--{{ section.settings.heading_alignment }} spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-our-products-intro__inner">
    {% if eyebrow != blank %}
      <p class="lame-our-products-intro__eyebrow">{{ eyebrow | escape }}</p>
    {% endif %}
    {% render 'lame-section-heading',
      title: title,
      subtitle: subtitle,
      alignment: section.settings.heading_alignment,
      size: section.settings.heading_size,
      show_divider: section.settings.show_divider,
      class: 'lame-our-products-intro__heading'
    %}
  </div>
</div>

{% stylesheet %}
  .lame-our-products-intro {
    --lame-section-heading-color: rgb(var(--color-foreground-heading-rgb));
    --lame-section-heading-ornament: rgb(var(--brand-gold-strong));
  }

  .lame-our-products-intro__inner {
    padding-inline: var(--page-margin);
    max-width: 1480px;
    margin-inline: auto;
  }

  .lame-our-products-intro__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(var(--color-primary-rgb));
  }

  .lame-our-products-intro--center .lame-our-products-intro__eyebrow {
    text-align: center;
  }

  .lame-our-products-intro .lame-our-products-intro__heading.lame-section-heading {
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our products header",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Skincare & beauty"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our products"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Curated rituals for radiant skin — filter, explore, and add to your routine."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Gold divider under title",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Our products header",
      "category": "Collection"
    }
  ]
}
{% endschema %}
