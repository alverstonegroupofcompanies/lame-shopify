{% liquid
  assign title = section.settings.heading
  if title == blank and collection != blank
    assign title = collection.title
  endif
  if title == blank
    assign title = 'Healthcare Essentials for Everyday Wellness'
  endif
  assign subtitle = section.settings.subtitle
  if subtitle == blank
    assign subtitle = 'Trusted products from leading brands curated for your family.'
  endif
  assign eyebrow = section.settings.eyebrow
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="lame-our-products-intro lame-op-hero lame-our-products-intro--{{ section.settings.heading_alignment | default: 'left' }} spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-op-hero__botanical" aria-hidden="true"></div>
  <div class="lame-op-hero__overlay" aria-hidden="true"></div>
  <div class="lame-op-hero__inner lame-our-products-intro__inner">
    {% if eyebrow != blank %}
      <p class="lame-our-products-intro__eyebrow lame-op-hero__eyebrow">{{ eyebrow | escape }}</p>
    {% endif %}
    <div class="lame-op-hero__content">
      <h1 class="lame-op-hero__heading">{{ title | escape }}</h1>
      {% if subtitle != blank %}
        <p class="lame-op-hero__subheading">{{ subtitle | escape }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .lame-op-hero {
    position: relative;
    overflow: hidden;
    background: var(--lame-lux-bg, #f7faf8);
    min-height: clamp(200px, 28vw, 280px);
  }

  .lame-op-hero__botanical {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 80% 60% at 85% 20%, rgb(63 107 82 / 0.16) 0%, transparent 55%),
      radial-gradient(ellipse 60% 50% at 10% 80%, rgb(38 71 52 / 0.12) 0%, transparent 50%),
      radial-gradient(ellipse 40% 35% at 70% 75%, rgb(77 122 99 / 0.1) 0%, transparent 45%);
    z-index: 0;
  }

  .lame-op-hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      rgb(38 71 52 / 0.06) 0%,
      transparent 45%,
      rgb(38 71 52 / 0.03) 100%
    );
    z-index: 1;
  }

  .lame-op-hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: var(--lame-lux-layout-max, 1600px);
    margin-inline: auto;
    padding-inline: clamp(16px, 2vw, 32px);
    padding-block: clamp(2rem, 4vw, 3rem);
    min-height: inherit;
    box-sizing: border-box;
  }

  .lame-op-hero__content {
    max-width: 42rem;
  }

  .lame-op-hero__heading {
    margin: 0;
    font-family: var(--lame-lux-font-display, 'Playfair Display', Georgia, serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: 0.01em;
    color: var(--lame-lux-primary, #264734);
  }

  .lame-op-hero__heading::after {
    content: '';
    display: block;
    width: 3.5rem;
    height: 2px;
    margin-top: 0.85rem;
    background: linear-gradient(90deg, var(--lame-lux-secondary, #3f6b52), transparent);
    border-radius: 2px;
  }

  .lame-op-hero__subheading {
    margin: 1rem 0 0;
    max-width: 36rem;
    font-family: var(--lame-lux-font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(0.9375rem, 1.5vw, 1.125rem);
    line-height: 1.6;
    color: var(--lame-lux-secondary, #3f6b52);
  }

  .lame-op-hero__eyebrow {
    margin: 0 0 0.65rem;
    font-family: var(--lame-lux-font-body, 'Inter', system-ui, sans-serif);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lame-lux-secondary, #3f6b52);
  }

  .lame-our-products-intro--center .lame-op-hero__inner {
    align-items: center;
    text-align: center;
  }

  .lame-our-products-intro--center .lame-op-hero__content {
    max-width: 48rem;
  }

  .lame-our-products-intro--center .lame-op-hero__heading::after {
    margin-inline: auto;
  }

  .template-collection-our-products .lame-our-products-intro {
    padding-block-end: 0 !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our products header",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Healthcare Essentials for Everyday Wellness"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Trusted products from leading brands curated for your family."
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Gold divider under title",
      "default": false
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Our products header",
      "category": "Collection"
    }
  ]
}
{% endschema %}
