{%- liquid
  assign slide_interval = section.settings.slide_seconds | default: 5
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#000000'
  assign has_custom_blocks = false
  if section.blocks.size > 0
    assign has_custom_blocks = true
  endif
-%}

<aside
  class="lame-promo-top-bar"
  id="LamePromoTopBar-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Offers and Elite Pro announcements' | escape }}"
  style="--topbar-bg: {{ bg_color }}; --topbar-text: {{ text_color }};"
>
  {%- if section.settings.enable_holiday_flight != false -%}
    <!-- Festive Snowfall Stage (Behind Text - Gentle continuous snowfall) -->
    <div class="lame-santa-stage" id="LameSantaStage-{{ section.id }}" aria-hidden="true">
      <div class="lame-santa-snow-wrap">
        <span class="lame-snowflake" style="--left: 2%; --delay: 0s; --size: 4px; --dur: 2.2s;"></span>
        <span class="lame-snowflake" style="--left: 8%; --delay: 0.7s; --size: 5px; --dur: 1.8s;"></span>
        <span class="lame-snowflake" style="--left: 15%; --delay: 0.2s; --size: 3px; --dur: 2.4s;"></span>
        <span class="lame-snowflake" style="--left: 22%; --delay: 1.1s; --size: 6px; --dur: 2.1s;"></span>
        <span class="lame-snowflake" style="--left: 30%; --delay: 0.4s; --size: 4px; --dur: 1.9s;"></span>
        <span class="lame-snowflake" style="--left: 38%; --delay: 1.4s; --size: 5px; --dur: 2.3s;"></span>
        <span class="lame-snowflake" style="--left: 45%; --delay: 0.1s; --size: 3px; --dur: 2.6s;"></span>
        <span class="lame-snowflake" style="--left: 53%; --delay: 0.8s; --size: 5px; --dur: 2s;"></span>
        <span class="lame-snowflake" style="--left: 61%; --delay: 1.3s; --size: 4px; --dur: 1.9s;"></span>
        <span class="lame-snowflake" style="--left: 70%; --delay: 0.3s; --size: 6px; --dur: 2.5s;"></span>
        <span class="lame-snowflake" style="--left: 78%; --delay: 0.9s; --size: 4px; --dur: 2.1s;"></span>
        <span class="lame-snowflake" style="--left: 86%; --delay: 0.5s; --size: 5px; --dur: 2.0s;"></span>
        <span class="lame-snowflake" style="--left: 93%; --delay: 1.2s; --size: 3px; --dur: 2.3s;"></span>
        <span class="lame-snowflake" style="--left: 98%; --delay: 0.6s; --size: 4px; --dur: 1.9s;"></span>
      </div>
    </div>
  {%- endif -%}

  <div class="lame-promo-top-bar__inner">
    <div
      class="lame-promo-top-bar__track"
      data-topbar-track
      data-interval="{{ slide_interval }}"
    >
      {%- capture promo_content -%}
        {% content_for 'blocks' %}
      {%- endcapture -%}
      {%- if promo_content != blank and promo_content contains 'lame-promo-top-bar__slide' -%}
        {{ promo_content }}
      {%- else -%}
        <div class="lame-promo-top-bar__slide is-active" data-slide-index="0">
          <a class="lame-promo-top-bar__link" href="/products/elite-pro-6-months">
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Free gifts on orders above ₹899 &amp; Welcome Gift <strong class="lame-promo-top-bar__cta-highlight">(Join for ₹199 / 6 mos)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Free gifts above ₹899 &amp; welcome gift <strong class="lame-promo-top-bar__cta-highlight">(₹199 / 6 mos)</strong>
            </span>
          </a>
        </div>
        <div class="lame-promo-top-bar__slide" data-slide-index="1">
          <a class="lame-promo-top-bar__link" href="/products/elite-pro-6-months">
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Member-Only Offers: Hidden price drops &amp; extra combo savings <strong class="lame-promo-top-bar__cta-highlight">(Shop VIP Deals)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Member-only offers &amp; hidden price drops <strong class="lame-promo-top-bar__cta-highlight">(VIP Deals)</strong>
            </span>
          </a>
        </div>
        <div class="lame-promo-top-bar__slide" data-slide-index="2">
          <a class="lame-promo-top-bar__link" href="/products/elite-pro-6-months">
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Early Access to Sales: 24-hr advance access to mega sales &amp; restocks <strong class="lame-promo-top-bar__cta-highlight">(Learn More)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              24-hr early access to mega sales &amp; restocks <strong class="lame-promo-top-bar__cta-highlight">(Join Now)</strong>
            </span>
          </a>
        </div>
        <div class="lame-promo-top-bar__slide" data-slide-index="3">
          <a class="lame-promo-top-bar__link" href="/products/elite-pro-6-months">
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Shop, Earn &amp; Redeem: Earn reward points on orders &amp; birthday treats <strong class="lame-promo-top-bar__cta-highlight">(Explore Perks)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Reward points on orders &amp; birthday treats <strong class="lame-promo-top-bar__cta-highlight">(Perks)</strong>
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</aside>

{% stylesheet %}
  .lame-promo-top-bar {
    background-color: #ffffff !important;
    background: #ffffff !important;
    border: none !important;
    border-bottom: 1px solid #e5e7eb !important;
    border-block-end: 1px solid #e5e7eb !important;
    color: #111827 !important;
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    width: 100%;
    position: relative;
    z-index: 5;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    overflow: hidden;
    box-sizing: border-box;
    display: block;
    user-select: none;
    box-shadow: none !important;
  }

  .lame-promo-top-bar__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    gap: 16px;
    box-sizing: border-box;
    z-index: 3;
  }

  /* Festive Snowfall Animation (Behind Text - Gentle continuous snowfall) */
  .lame-santa-stage {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .lame-santa-snow-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .lame-snowflake {
    position: absolute;
    top: -10px;
    left: var(--left, 50%);
    width: var(--size, 4px);
    height: var(--size, 4px);
    background: radial-gradient(circle, #ffffff 30%, #7dd3fc 70%, #0284c7 100%);
    border-radius: 50%;
    opacity: 0.85;
    box-shadow: 0 0 4px rgba(56, 189, 248, 0.6), 0 0 1px rgba(2, 132, 199, 0.8);
    pointer-events: none;
    animation: lameSnowFall var(--dur, 2.2s) linear infinite;
    animation-delay: var(--delay, 0s);
  }

  @keyframes lameSnowFall {
    0% {
      transform: translate3d(0, 0, 0) scale(0.8);
      opacity: 0;
    }
    15% {
      opacity: 0.95;
    }
    85% {
      opacity: 0.85;
    }
    100% {
      transform: translate3d(-18px, 48px, 0) scale(1.15);
      opacity: 0;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-snowflake {
      box-shadow: 0 0 2px rgba(56, 189, 248, 0.5);
    }
  }

  /* Pill removed per request */
  .lame-topbar-pill {
    display: none !important;
  }

  /* Arrow navigation removed per request */
  .lame-topbar-arrow {
    display: none !important;
  }

  /* Carousel Track and Slides */
  .lame-promo-top-bar__track {
    flex: 1 1 auto;
    height: 100%;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    z-index: 3;
  }

  .lame-promo-top-bar__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s ease;
    z-index: 3;
  }

  .lame-promo-top-bar__slide.is-active,
  .lame-promo-top-bar__track:not([data-initialized='true']) > .lame-promo-top-bar__slide:first-child {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    position: relative;
  }

  .lame-promo-top-bar__slide.is-prev {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
  }

  .lame-promo-top-bar__link {
    color: inherit !important;
    text-decoration: none !important;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.25;
    transition: opacity 0.2s ease;
    position: relative;
    z-index: 4;
  }

  .lame-promo-top-bar__link:hover {
    opacity: 0.92;
    text-decoration: none !important;
  }

  .lame-promo-top-bar__text {
    color: #111827 !important;
    font-size: inherit;
    font-weight: 600;
    line-height: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-shadow: none !important;
    letter-spacing: 0.015em;
    position: relative;
    z-index: 4;
  }

  .lame-promo-top-bar strong,
  .lame-promo-top-bar b {
    font-weight: 700;
    color: #000000 !important;
  }

  .lame-promo-top-bar__cta-highlight {
    font-weight: 700;
    color: #000000 !important;
    text-decoration: underline;
    text-underline-offset: 2.5px;
    opacity: 0.95;
  }

  .lame-topbar-pill__desktop,
  .lame-promo-top-bar__text--desktop {
    display: inline !important;
  }

  .lame-topbar-pill__mobile,
  .lame-promo-top-bar__text--mobile {
    display: none !important;
  }

  /* Responsive styling for Tablet & Mobile */
  @media screen and (max-width: 749px) {
    .lame-topbar-pill__desktop,
    .lame-promo-top-bar__text--desktop {
      display: none !important;
    }

    .lame-topbar-pill__mobile,
    .lame-promo-top-bar__text--mobile {
      display: inline !important;
    }

    .lame-promo-top-bar {
      height: 35px;
      min-height: 35px;
      max-height: 35px;
    }

    .lame-promo-top-bar__inner {
      padding: 0 10px;
      gap: 6px;
    }

    .lame-promo-top-bar__link {
      font-size: 11px;
      gap: 6px;
      letter-spacing: 0;
    }

    .lame-topbar-pill {
      font-size: 9px;
      padding: 1px 6px;
      line-height: 1.25;
    }
  }

  @media screen and (max-width: 380px) {
    .lame-promo-top-bar__inner {
      padding: 0 6px;
      gap: 4px;
    }

    .lame-promo-top-bar__link {
      font-size: 9.5px;
      gap: 4px;
    }

    .lame-topbar-pill {
      font-size: 8.5px;
      padding: 1px 5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lame-promo-top-bar__slide {
      transition: opacity 0.2s ease, visibility 0.2s ease !important;
      transform: none !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const initTopBar = () => {
      const topBar = document.getElementById('LamePromoTopBar-{{ section.id }}');
      if (!topBar || topBar.dataset.initialized) return;
      topBar.dataset.initialized = 'true';

      const track = topBar.querySelector('[data-topbar-track]');
      const prevBtn = topBar.querySelector('[data-topbar-prev]');
      const nextBtn = topBar.querySelector('[data-topbar-next]');
      if (!track) return;

      const slides = Array.from(track.querySelectorAll('.lame-promo-top-bar__slide'));
      if (slides.length === 0) return;

      slides.forEach((slide, idx) => {
        slide.dataset.slideIndex = idx;
        if (idx === 0) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active', 'is-prev');
        }
      });

      if (slides.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        return;
      }

      let currentIndex = 0;
      let timer = null;
      const intervalSec = parseFloat(track.dataset.interval) || 5;

      const showSlide = (nextIndex, direction = 1) => {
        const total = slides.length;
        const normalizedIndex = (nextIndex + total) % total;
        if (normalizedIndex === currentIndex) return;

        slides.forEach((slide, idx) => {
          slide.classList.remove('is-active', 'is-prev');
          if (idx === normalizedIndex) {
            slide.classList.add('is-active');
          } else if (idx === currentIndex) {
            if (direction > 0) {
              slide.classList.add('is-prev');
            }
          }
        });

        currentIndex = normalizedIndex;
      };

      const nextSlide = () => showSlide(currentIndex + 1, 1);
      const prevSlide = () => showSlide(currentIndex - 1, -1);

      const startAutoPlay = () => {
        stopAutoPlay();
        timer = setInterval(nextSlide, intervalSec * 1000);
      };

      const stopAutoPlay = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          prevSlide();
          startAutoPlay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          nextSlide();
          startAutoPlay();
        });
      }

      topBar.addEventListener('mouseenter', stopAutoPlay);
      topBar.addEventListener('mouseleave', startAutoPlay);

      // Keyboard navigation
      topBar.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          prevSlide();
          startAutoPlay();
        } else if (e.key === 'ArrowRight') {
          nextSlide();
          startAutoPlay();
        }
      });

      // Touch swipe support for mobile
      let touchStartX = 0;
      let touchEndX = 0;
      track.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 35) {
          if (diff > 0) {
            prevSlide();
          } else {
            nextSlide();
          }
          startAutoPlay();
        }
      }, { passive: true });

      startAutoPlay();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopBar);
    } else {
      initTopBar();
    }
  })();
</script>

{% schema %}
{
  "name": "Elite Pro Top Bar",
  "tag": "section",
  "class": "lame-promo-top-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "_lame-promo-caption"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_holiday_flight",
      "label": "Enable Festive Snowfall",
      "default": true,
      "info": "Displays gentle falling snowflakes across the top announcement bar"
    },
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Slide interval (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Bar label (screen readers)",
      "default": "Offers and Elite Pro announcements"
    }
  ],
  "presets": [
    {
      "name": "Elite Pro Top Bar",
      "blocks": {
        "slide_1": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "✨ Join Elite Pro — Flat 10% Extra Cashback + Free Shipping on All Orders! (Join Now)",
            "link": "/pages/elite-pro"
          }
        },
        "slide_2": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "👑 Exclusive Weekend Offer — Flat 15% off on All Products for Elite Pro Members (Till 15th Nov.)",
            "link": "/pages/elite-pro"
          }
        },
        "slide_3": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "🎁 Elite Pro Membership for ₹199 — Get Free Luxury Beauty Kit + VIP Early Access!",
            "link": "/pages/elite-pro"
          }
        }
      },
      "block_order": [
        "slide_1",
        "slide_2",
        "slide_3"
      ]
    }
  ]
}
{% endschema %}
