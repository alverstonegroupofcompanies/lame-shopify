{%- capture promo_content -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

{%- liquid
  assign promo_blocks_html = promo_content | strip
  assign rendered_caption_count = promo_content | split: 'lame-promo-top-bar__caption"' | size | minus: 1
  if rendered_caption_count < 1
    assign rendered_caption_count = promo_content | split: 'class="lame-promo-top-bar__caption' | size | minus: 1
  endif

  if rendered_caption_count > 0
    assign promo_count = rendered_caption_count
  elsif section.blocks.size > 0
    assign promo_count = section.blocks.size
  elsif promo_blocks_html != blank
    assign promo_count = 1
  else
    assign promo_count = 0
  endif
-%}

{%- if promo_count > 0 or request.design_mode -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <aside
    class="lame-promo-top-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
    style="{% render 'spacing-padding', settings: section.settings %}"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <div class="lame-promo-top-bar__inner">
      {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
        <div class="lame-promo-top-bar__badge-wrap">
          <span class="lame-promo-top-bar__badge" aria-hidden="true">{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      <div
        class="lame-promo-top-bar__ticker"
        id="LamePromoTicker-{{ section.id }}"
        role="region"
        aria-label="{{ section.settings.accessibility_label | escape }}"
      >
        {%- if promo_count == 0 and request.design_mode -%}
          <p class="lame-promo-top-bar__placeholder">Add one or more promo lines in the sidebar to scroll continuously.</p>
        {%- else -%}
          <div class="lame-promo-top-bar__ticker-track">
            <div class="lame-promo-top-bar__ticker-group">
              <div class="lame-promo-top-bar__ticker-items">
                {{ promo_content }}
              </div>
              {%- for i in (1..5) -%}
                <div class="lame-promo-top-bar__ticker-items lame-promo-top-bar__ticker-items--dup" aria-hidden="true">
                  {{ promo_content | replace: 'id="', 'data-dup-id="' }}
                </div>
              {%- endfor -%}
            </div>
            <div class="lame-promo-top-bar__ticker-group lame-promo-top-bar__ticker-group--clone" aria-hidden="true">
              {%- for i in (1..6) -%}
                <div class="lame-promo-top-bar__ticker-items lame-promo-top-bar__ticker-items--dup">
                  {{ promo_content | replace: 'id="', 'data-dup-id="' }}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  .lame-promo-top-bar {
    --lame-promo-badge-bg: rgb(var(--brand-gold));
    --lame-promo-badge-fg: #0a0a0c;
    border-block-end: 1px solid rgb(var(--color-border-rgb) / 0.35);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    position: relative;
    color: #ffffff !important;
    overflow: hidden;
    width: 100%;
    background: var(--lame-purple-gradient, linear-gradient(90deg, #6b0f46 0%, #4a0730 100%)) !important;
  }

  .lame-promo-top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: nowrap;
    width: 100%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
  }

  .lame-promo-top-bar__badge-wrap {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    z-index: 2;
    padding-inline-end: clamp(0.6rem, 1.5vw, 1rem);
  }

  .lame-promo-top-bar__badge {
    flex-shrink: 0;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.28rem 0.55rem;
    border-radius: 3px;
    background: var(--lame-promo-badge-bg);
    color: var(--lame-promo-badge-fg);
    line-height: 1;
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.12);
    animation: lame-promo-badge-pop 2.8s ease-in-out infinite;
    white-space: nowrap;
  }

  @keyframes lame-promo-badge-pop {
    0%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.06);
    }
    24% {
      transform: scale(1);
    }
  }

  .lame-promo-top-bar__ticker {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
  }

  .lame-promo-top-bar__ticker-track {
    display: flex;
    align-items: center;
    width: max-content;
    white-space: nowrap;
    will-change: transform;
    animation: lame-promo-ticker 20s linear infinite;
  }

  /* Pause scrolling on hover or focus */
  .lame-promo-top-bar:hover .lame-promo-top-bar__ticker-track,
  .lame-promo-top-bar:focus-within .lame-promo-top-bar__ticker-track {
    animation-play-state: paused;
  }

  @keyframes lame-promo-ticker {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .lame-promo-top-bar__ticker-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .lame-promo-top-bar__ticker-items {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .lame-promo-top-bar__ticker-items > * {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .lame-promo-top-bar__placeholder {
    margin: 0;
    font-size: 0.8125rem;
    color: #ffffff;
    opacity: 0.85;
    white-space: nowrap;
  }

  .lame-promo-top-bar__caption {
    margin: 0;
    width: auto;
    display: inline-flex;
    align-items: center;
    color: #ffffff !important;
    white-space: nowrap;
  }

  .lame-promo-top-bar__caption::after {
    content: "•";
    margin-inline: clamp(0.75rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85em;
    display: inline-block;
  }

  .lame-promo-top-bar__caption-link {
    color: #ffffff !important;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .lame-promo-top-bar__caption-link:hover,
  .lame-promo-top-bar__caption-link:focus-visible {
    color: #ffffff !important;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .lame-promo-top-bar__caption-text {
    font-size: clamp(0.75rem, 1.35vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: #ffffff !important;
    white-space: nowrap;
  }

  .lame-promo-top-bar__caption-text :first-child {
    margin: 0;
    color: #ffffff !important;
  }

  .lame-promo-top-bar__caption-text strong,
  .lame-promo-top-bar__caption-text b {
    color: #ffffff !important;
    font-weight: 700;
  }

  /* Reduced motion: show text without scrolling */
  @media (prefers-reduced-motion: reduce) {
    .lame-promo-top-bar__badge {
      animation: none !important;
    }

    .lame-promo-top-bar__ticker {
      mask-image: none !important;
      -webkit-mask-image: none !important;
    }

    .lame-promo-top-bar__ticker-track {
      animation: none !important;
      transform: none !important;
      width: 100%;
      overflow-x: auto;
    }

    .lame-promo-top-bar__ticker-group--clone,
    .lame-promo-top-bar__ticker-items--dup {
      display: none !important;
    }

    .lame-promo-top-bar__ticker-items:only-child .lame-promo-top-bar__caption:only-child::after {
      display: none;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Super deal top bar",
  "tag": "section",
  "class": "lame-promo-top-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "_lame-promo-caption"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Seconds per caption",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show deal badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Super deal"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Region label (screen readers)",
      "default": "Promotions and offers"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Super deal top bar",
      "blocks": {
        "deal_1": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "<strong>20% off</strong> your first order — use code <strong>WELCOME20</strong>"
          }
        },
        "deal_2": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "Free shipping on orders over <strong>$75</strong>"
          }
        },
        "deal_3": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "New arrivals weekly — <strong>shop the drop</strong>"
          }
        }
      },
      "block_order": ["deal_1", "deal_2", "deal_3"]
    }
  ]
}
{% endschema %}
