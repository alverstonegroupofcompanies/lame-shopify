{%- liquid
  assign slide_interval = section.settings.slide_seconds | default: 5
  assign bg_color = section.settings.bg_color | default: 'rgba(255, 107, 44, 0.08)'
  assign text_color = section.settings.text_color | default: '#8A2E00'
  assign has_custom_blocks = false
  if section.blocks.size > 0
    assign has_custom_blocks = true
  endif
-%}

<aside
  class="lame-promo-top-bar"
  id="LamePromoTopBar-{{ section.id }}"
  role="region"
  aria-label="{{ section.settings.accessibility_label | default: 'Offers and Elite Pro announcements' | escape }}"
  style="--topbar-bg: {{ bg_color }}; --topbar-text: {{ text_color }};"
>
  <div class="lame-promo-top-bar__inner">
    <button
      type="button"
      class="lame-topbar-arrow lame-topbar-arrow--prev"
      data-topbar-prev
      aria-label="Previous announcement"
    >
      <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="10 3 5 8 10 13"></polyline>
      </svg>
    </button>

    <div
      class="lame-promo-top-bar__track"
      data-topbar-track
      data-interval="{{ slide_interval }}"
    >
      {%- capture promo_content -%}
        {% content_for 'blocks' %}
      {%- endcapture -%}
      {%- if promo_content != blank and promo_content contains 'lame-promo-top-bar__slide' -%}
        {{ promo_content }}
      {%- else -%}
        <div class="lame-promo-top-bar__slide is-active" data-slide-index="0">
          <a class="lame-promo-top-bar__link" href="/pages/elite-pro">
            <span class="lame-topbar-pill">
              <span class="lame-topbar-pill__desktop">Why Join Elite?</span>
              <span class="lame-topbar-pill__mobile">Elite</span>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Free shipping, 10% extra cashback & VIP beauty perks <strong class="lame-promo-top-bar__cta-highlight">(Join for ₹199)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Free shipping, 10% cashback & VIP perks <strong class="lame-promo-top-bar__cta-highlight">(₹199)</strong>
            </span>
          </a>
        </div>
        <div class="lame-promo-top-bar__slide" data-slide-index="1">
          <a class="lame-promo-top-bar__link" href="/pages/elite-pro">
            <span class="lame-topbar-pill">
              <span class="lame-topbar-pill__desktop">Why Join Elite?</span>
              <span class="lame-topbar-pill__mobile">Elite</span>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Flat 15% off weekend deals & exclusive member-only savings <strong class="lame-promo-top-bar__cta-highlight">(Join Now)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Flat 15% off weekend deals & member perks <strong class="lame-promo-top-bar__cta-highlight">(Join)</strong>
            </span>
          </a>
        </div>
        <div class="lame-promo-top-bar__slide" data-slide-index="2">
          <a class="lame-promo-top-bar__link" href="/pages/elite-pro">
            <span class="lame-topbar-pill">
              <span class="lame-topbar-pill__desktop">Why Join Elite?</span>
              <span class="lame-topbar-pill__mobile">Elite</span>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--desktop">
              Free luxury beauty kit, surprise gifts & VIP early access <strong class="lame-promo-top-bar__cta-highlight">(Learn More)</strong>
            </span>
            <span class="lame-promo-top-bar__text lame-promo-top-bar__text--mobile">
              Free luxury beauty kit & early access <strong class="lame-promo-top-bar__cta-highlight">(More)</strong>
            </span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <button
      type="button"
      class="lame-topbar-arrow lame-topbar-arrow--next"
      data-topbar-next
      aria-label="Next announcement"
    >
      <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 3 11 8 6 13"></polyline>
      </svg>
    </button>
  </div>
</aside>

{% stylesheet %}
  .lame-promo-top-bar {
    background-color: var(--topbar-bg, #FFF6F0) !important;
    background: linear-gradient(90deg, #FFF9F5 0%, #FFF0E6 50%, #FFF9F5 100%) !important;
    border-bottom: 1px solid rgba(255, 107, 44, 0.16) !important;
    color: var(--topbar-text, #8A2E00) !important;
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    width: 100%;
    position: relative;
    z-index: 25;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    overflow: hidden;
    box-sizing: border-box;
    display: block;
    user-select: none;
  }

  .lame-promo-top-bar__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    gap: 16px;
    box-sizing: border-box;
  }

  /* Compact 'Why Join Elite?' highlighted pill */
  .lame-topbar-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 107, 44, 0.12);
    color: #9A380B;
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.02em;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 107, 44, 0.25);
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.3;
    box-shadow: 0 1px 2px rgba(255, 107, 44, 0.05);
  }

  /* Round subtle navigation buttons '<' and '>' */
  .lame-topbar-arrow {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    border-radius: 50%;
    background: #ffffff !important;
    color: #8A2E00 !important;
    border: 1px solid rgba(255, 107, 44, 0.22) !important;
    box-shadow: 0 1px 3px rgba(138, 46, 0, 0.08), 0 0.5px 1px rgba(0, 0, 0, 0.04);
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
    padding: 0 !important;
    margin: 0 !important;
    flex-shrink: 0;
    transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    outline: none;
    z-index: 3;
    line-height: 0;
  }

  .lame-topbar-arrow svg {
    display: block;
    width: 10px;
    height: 10px;
    stroke: currentColor;
    fill: none;
  }

  .lame-topbar-arrow:hover {
    transform: scale(1.08);
    box-shadow: 0 2px 6px rgba(138, 46, 0, 0.18);
    background: #FFF2EB !important;
    border-color: rgba(255, 107, 44, 0.42) !important;
    color: #642000 !important;
  }

  .lame-topbar-arrow:active {
    transform: scale(0.95);
  }

  .lame-topbar-arrow:focus-visible {
    outline: 2px solid #D9531E;
    outline-offset: 2px;
  }

  /* Carousel Track and Slides */
  .lame-promo-top-bar__track {
    flex: 1 1 auto;
    height: 100%;
    min-width: 0;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lame-promo-top-bar__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                visibility 0.35s ease;
  }

  .lame-promo-top-bar__slide.is-active,
  .lame-promo-top-bar__track:not([data-initialized='true']) > .lame-promo-top-bar__slide:first-child {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    position: relative;
  }

  .lame-promo-top-bar__slide.is-prev {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-8px);
  }

  .lame-promo-top-bar__link {
    color: inherit !important;
    text-decoration: none !important;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 1.25;
    transition: opacity 0.2s ease;
  }

  .lame-promo-top-bar__link:hover {
    opacity: 0.92;
    text-decoration: none !important;
  }

  .lame-promo-top-bar__text {
    color: var(--topbar-text, #8A2E00) !important;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lame-promo-top-bar strong,
  .lame-promo-top-bar b {
    font-weight: 700;
    color: #732400 !important;
  }

  .lame-promo-top-bar__cta-highlight {
    font-weight: 700;
    color: #D9531E !important;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lame-topbar-pill__desktop,
  .lame-promo-top-bar__text--desktop {
    display: inline !important;
  }

  .lame-topbar-pill__mobile,
  .lame-promo-top-bar__text--mobile {
    display: none !important;
  }

  /* Responsive styling for Tablet & Mobile */
  @media screen and (max-width: 749px) {
    .lame-topbar-pill__desktop,
    .lame-promo-top-bar__text--desktop {
      display: none !important;
    }

    .lame-topbar-pill__mobile,
    .lame-promo-top-bar__text--mobile {
      display: inline !important;
    }

    .lame-promo-top-bar {
      height: 33px;
      min-height: 33px;
      max-height: 33px;
    }

    .lame-promo-top-bar__inner {
      padding: 0 6px;
      gap: 4px;
    }

    .lame-topbar-arrow {
      width: 18px;
      height: 18px;
      min-width: 18px;
      min-height: 18px;
    }

    .lame-topbar-arrow svg {
      width: 8px;
      height: 8px;
      stroke-width: 2.4;
    }

    .lame-promo-top-bar__link {
      font-size: 10px;
      gap: 4px;
      letter-spacing: 0;
    }

    .lame-topbar-pill {
      font-size: 8.5px;
      padding: 1px 5px;
      line-height: 1.2;
    }
  }

  @media screen and (max-width: 380px) {
    .lame-promo-top-bar__inner {
      padding: 0 4px;
      gap: 3px;
    }

    .lame-promo-top-bar__link {
      font-size: 9px;
      gap: 3px;
    }

    .lame-topbar-pill {
      font-size: 8px;
      padding: 1px 4px;
    }

    .lame-topbar-arrow {
      width: 16px;
      height: 16px;
      min-width: 16px;
      min-height: 16px;
    }

    .lame-topbar-arrow svg {
      width: 7px;
      height: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lame-promo-top-bar__slide {
      transition: opacity 0.2s ease, visibility 0.2s ease !important;
      transform: none !important;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const initTopBar = () => {
      const topBar = document.getElementById('LamePromoTopBar-{{ section.id }}');
      if (!topBar || topBar.dataset.initialized) return;
      topBar.dataset.initialized = 'true';

      const track = topBar.querySelector('[data-topbar-track]');
      const prevBtn = topBar.querySelector('[data-topbar-prev]');
      const nextBtn = topBar.querySelector('[data-topbar-next]');
      if (!track) return;

      const slides = Array.from(track.querySelectorAll('.lame-promo-top-bar__slide'));
      if (slides.length === 0) return;

      slides.forEach((slide, idx) => {
        slide.dataset.slideIndex = idx;
        if (idx === 0) {
          slide.classList.add('is-active');
        } else {
          slide.classList.remove('is-active', 'is-prev');
        }
      });

      if (slides.length <= 1) {
        if (prevBtn) prevBtn.style.display = 'none';
        if (nextBtn) nextBtn.style.display = 'none';
        return;
      }

      let currentIndex = 0;
      let timer = null;
      const intervalSec = parseFloat(track.dataset.interval) || 5;

      const showSlide = (nextIndex, direction = 1) => {
        const total = slides.length;
        const normalizedIndex = (nextIndex + total) % total;
        if (normalizedIndex === currentIndex) return;

        slides.forEach((slide, idx) => {
          slide.classList.remove('is-active', 'is-prev');
          if (idx === normalizedIndex) {
            slide.classList.add('is-active');
          } else if (idx === currentIndex) {
            if (direction > 0) {
              slide.classList.add('is-prev');
            }
          }
        });

        currentIndex = normalizedIndex;
      };

      const nextSlide = () => showSlide(currentIndex + 1, 1);
      const prevSlide = () => showSlide(currentIndex - 1, -1);

      const startAutoPlay = () => {
        stopAutoPlay();
        timer = setInterval(nextSlide, intervalSec * 1000);
      };

      const stopAutoPlay = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          prevSlide();
          startAutoPlay();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          nextSlide();
          startAutoPlay();
        });
      }

      topBar.addEventListener('mouseenter', stopAutoPlay);
      topBar.addEventListener('mouseleave', startAutoPlay);

      // Keyboard navigation
      topBar.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          prevSlide();
          startAutoPlay();
        } else if (e.key === 'ArrowRight') {
          nextSlide();
          startAutoPlay();
        }
      });

      // Touch swipe support for mobile
      let touchStartX = 0;
      let touchEndX = 0;
      track.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      track.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 35) {
          if (diff > 0) {
            prevSlide();
          } else {
            nextSlide();
          }
          startAutoPlay();
        }
      }, { passive: true });

      startAutoPlay();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTopBar);
    } else {
      initTopBar();
    }
  })();
</script>

{% schema %}
{
  "name": "Elite Pro Top Bar",
  "tag": "section",
  "class": "lame-promo-top-bar-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "_lame-promo-caption"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Slide interval (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "rgba(255, 107, 44, 0.08)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#8A2E00"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Bar label (screen readers)",
      "default": "Offers and Elite Pro announcements"
    }
  ],
  "presets": [
    {
      "name": "Elite Pro Top Bar",
      "blocks": {
        "slide_1": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "✨ Join Elite Pro — Flat 10% Extra Cashback + Free Shipping on All Orders! (Join Now)",
            "link": "/pages/elite-pro"
          }
        },
        "slide_2": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "👑 Exclusive Weekend Offer — Flat 15% off on All Products for Elite Pro Members (Till 15th Nov.)",
            "link": "/pages/elite-pro"
          }
        },
        "slide_3": {
          "type": "_lame-promo-caption",
          "settings": {
            "text": "🎁 Elite Pro Membership for ₹199 — Get Free Luxury Beauty Kit + VIP Early Access!",
            "link": "/pages/elite-pro"
          }
        }
      },
      "block_order": [
        "slide_1",
        "slide_2",
        "slide_3"
      ]
    }
  ]
}
{% endschema %}
