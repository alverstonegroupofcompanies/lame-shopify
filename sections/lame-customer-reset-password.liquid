{%- liquid
  capture login_url
    render 'lame-customer-auth-url', type: 'login'
  endcapture

  assign page_title = section.settings.heading
  if page_title == blank
    assign page_title = 'lame_customer.auth_reset_title' | t
  endif

  assign page_subtitle = section.settings.subheading
-%}

{%- capture auth_body -%}
  {%- form 'reset_customer_password', class: 'lame-profile__form lame-auth__form', id: 'LameResetPasswordForm' -%}
    {%- if form.errors -%}
      <div class="lame-profile__message lame-profile__message--error" tabindex="-1" autofocus role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="lame-profile__message lame-profile__message--error" data-lame-reset-errors hidden role="alert"></div>

    <div class="lame-profile__field">
      <label for="ResetPassword">{{ 'lame_customer.auth_new_password' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
      <input
        type="password"
        id="ResetPassword"
        name="customer[password]"
        autocomplete="new-password"
        class="lame-profile__input"
        minlength="5"
        required
        aria-required="true"
        aria-describedby="ResetPasswordHint"
      >
      <p id="ResetPasswordHint" class="lame-auth__hint">{{ 'lame_customer.auth_password_hint' | t }}</p>
    </div>

    <div class="lame-profile__field">
      <label for="ResetPasswordConfirm">{{ 'lame_customer.auth_confirm_password' | t }} <span class="lame-auth__required" aria-hidden="true">*</span></label>
      <input
        type="password"
        id="ResetPasswordConfirm"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        class="lame-profile__input"
        minlength="5"
        required
        aria-required="true"
      >
    </div>

    <div class="lame-profile__form-actions lame-auth__actions">
      <button type="submit" class="button lame-profile__btn-primary lame-auth__submit">
        {{ 'lame_customer.auth_reset_submit' | t }}
      </button>
    </div>
  {%- endform -%}

  <p class="lame-auth__footer">
    <a href="{{ login_url }}">{{ 'lame_customer.auth_back_to_login' | t }}</a>
  </p>
{%- endcapture -%}

{% render 'lame-customer-auth-shell',
  page_title: page_title,
  page_subtitle: page_subtitle,
  body: auth_body,
  section: section
%}

{% schema %}
{
  "name": "Customer reset password",
  "tag": "section",
  "class": "lame-customer-reset-password-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reset your password"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a new password for your account."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-golden"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Customer reset password"
    }
  ]
}
{% endschema %}
