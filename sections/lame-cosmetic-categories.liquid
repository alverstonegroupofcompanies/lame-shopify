{%- liquid
  assign category_count = section.blocks.size
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cosmetic-categories"
  data-category-carousel
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  {{ section.shopify_attributes }}
>
  <div class="lame-cosmetic-categories__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-cosmetic-categories__header" data-lame-reveal>
      {% render 'lame-section-heading',
        title: section.settings.heading,
        subtitle: section.settings.subheading,
        alignment: 'center',
        show_divider: false
      %}
    </header>

    <div class="lame-cosmetic-categories__carousel">
      <button
        type="button"
        class="lame-cosmetic-categories__nav lame-cosmetic-categories__nav--prev"
        data-category-prev
        aria-label="{{ section.settings.prev_label }}"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>

      <div class="lame-cosmetic-categories__viewport" data-category-viewport>
        <ul class="lame-cosmetic-categories__track" role="list" data-category-track>
          {%- for block in section.blocks -%}
            {%- liquid
              assign cat_collection = collections[block.settings.collection]
              assign card_title = block.settings.title
              if card_title == blank and cat_collection != blank
                assign card_title = cat_collection.title
              endif

              assign card_link = block.settings.link
              if card_link == blank and cat_collection != blank
                assign card_link = cat_collection.url
              endif

              assign card_image = block.settings.image
              if card_image == blank and cat_collection != blank and cat_collection.image
                assign card_image = cat_collection.image
              elsif card_image == blank and cat_collection != blank and cat_collection.featured_image
                assign card_image = cat_collection.featured_image
              endif
            -%}
            <li
              class="lame-cosmetic-categories__slide"
              data-category-slide
              data-lame-reveal
              {{ block.shopify_attributes }}
            >
              <a href="{{ card_link | default: '#' }}" class="lame-cosmetic-categories__card">
                <div class="lame-cosmetic-categories__media">
                  {%- if card_image != blank -%}
                    {{
                      card_image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'lame-cosmetic-categories__image',
                        loading: 'lazy',
                        widths: '400,600,800,1000,1200',
                        sizes: '(min-width: 990px) 28vw, (min-width: 750px) 46vw, 92vw',
                        alt: card_title | escape
                    }}
                  {%- else -%}
                    {{ 'collection-apparel-1' | placeholder_svg_tag: 'lame-cosmetic-categories__image placeholder-svg' }}
                  {%- endif -%}
                  <div class="lame-cosmetic-categories__overlay">
                    {%- if card_title != blank -%}
                      <h3 class="lame-cosmetic-categories__title">{{ card_title }}</h3>
                    {%- endif -%}
                    {%- if section.settings.link_label != blank -%}
                      <span class="lame-cosmetic-categories__link">
                        {{ section.settings.link_label }}
                        <span aria-hidden="true">→</span>
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <button
        type="button"
        class="lame-cosmetic-categories__nav lame-cosmetic-categories__nav--next"
        data-category-next
        aria-label="{{ section.settings.next_label }}"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>

    {%- if category_count > 1 and section.settings.show_dots -%}
      <div class="lame-cosmetic-categories__dots" data-category-dots role="tablist" aria-label="{{ section.settings.dots_label }}"></div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]:not([data-category-clone])').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    const track = section.querySelector('[data-category-track]');
    const viewport = section.querySelector('[data-category-viewport]');
    const scrollEl = viewport || track;
    const prev = section.querySelector('[data-category-prev]');
    const next = section.querySelector('[data-category-next]');
    const dotsWrap = section.querySelector('[data-category-dots]');

    if (!track || !scrollEl) return;

    const originals = [...track.querySelectorAll('[data-category-slide]:not([data-category-clone])')];
    const count = originals.length;
    if (count === 0) return;

    const markClone = (slide) => {
      slide.dataset.categoryClone = 'true';
      slide.setAttribute('aria-hidden', 'true');
      slide.querySelectorAll('a').forEach((link) => link.setAttribute('tabindex', '-1'));
    };

    const appendCloneSet = (target) => {
      originals.forEach((slide) => {
        const clone = slide.cloneNode(true);
        markClone(clone);
        target.appendChild(clone);
      });
    };

    if (!track.dataset.categoryLoopReady && count > 1) {
      const beforeFrag = document.createDocumentFragment();
      const afterFrag = document.createDocumentFragment();
      appendCloneSet(beforeFrag);
      appendCloneSet(afterFrag);
      track.insertBefore(beforeFrag, track.firstChild);
      track.appendChild(afterFrag);
      track.dataset.categoryLoopReady = 'true';
    }

    const offsetStart = count;
    const offsetEnd = count * 2 - 1;

    const autoplayEnabled = section.dataset.autoplay === 'true';
    const autoplaySpeed = Number(section.dataset.autoplaySpeed) || 4000;
    let logicalIndex = 0;
    let autoplayTimer = null;
    let isResetting = false;
    let dots = [];
    let loopStart = 0;
    let loopEnd = 0;

    const getSlideSpan = () => {
      const slide = track.children[offsetStart];
      if (!slide) return 280;
      const gap = parseFloat(getComputedStyle(track).gap) || 16;
      return slide.offsetWidth + gap;
    };

    const getSlideScrollLeft = (child) => {
      if (!child) return 0;
      return Math.max(0, child.offsetLeft - track.offsetLeft);
    };

    const canScrollLoop = () => track.scrollWidth > scrollEl.clientWidth + 4;

    const ensureExtraClones = () => {
      if (count <= 1) return;
      let guard = 0;
      while (!canScrollLoop() && guard < 12) {
        appendCloneSet(track);
        guard += 1;
      }
    };

    const measureLoopBounds = () => {
      loopStart = getSlideScrollLeft(track.children[offsetStart]);
      loopEnd = getSlideScrollLeft(track.children[offsetEnd]) + track.children[offsetEnd].offsetWidth;
    };

    const scrollToPhysical = (physicalIndex, smooth = true) => {
      const child = track.children[physicalIndex];
      if (!child) return;
      scrollEl.scrollTo({
        left: getSlideScrollLeft(child),
        behavior: smooth && !isResetting ? 'smooth' : 'auto',
      });
    };

    const afterScroll = (callback) => {
      if ('onscrollend' in scrollEl) {
        scrollEl.addEventListener('scrollend', callback, { once: true });
      } else {
        window.setTimeout(callback, 480);
      }
    };

    const scrollToLogical = (index, smooth = true) => {
      logicalIndex = ((index % count) + count) % count;
      scrollToPhysical(offsetStart + logicalIndex, smooth);
      updateUI();
    };

    const loopForward = () => {
      measureLoopBounds();
      scrollEl.scrollBy({ left: getSlideSpan(), behavior: 'smooth' });
      afterScroll(() => {
        normalizeLoopPosition();
        syncFromScroll();
        if (logicalIndex === count - 1) {
          isResetting = true;
          scrollToPhysical(offsetStart, false);
          logicalIndex = 0;
          isResetting = false;
          updateUI();
        }
      });
    };

    const loopBackward = () => {
      measureLoopBounds();
      scrollEl.scrollBy({ left: -getSlideSpan(), behavior: 'smooth' });
      afterScroll(() => {
        normalizeLoopPosition();
        syncFromScroll();
        if (logicalIndex === 0) {
          isResetting = true;
          scrollToPhysical(offsetEnd, false);
          logicalIndex = count - 1;
          isResetting = false;
          updateUI();
        }
      });
    };

    const normalizeLoopPosition = () => {
      if (isResetting || count <= 1 || !canScrollLoop()) return;
      measureLoopBounds();
      const x = scrollEl.scrollLeft;
      const span = loopEnd - loopStart;
      const threshold = getSlideSpan() * 0.4;
      const firstAfterClone = track.children[count * 2];
      const lastBeforeClone = track.children[count - 1];

      if (firstAfterClone && x >= getSlideScrollLeft(firstAfterClone) - threshold) {
        isResetting = true;
        scrollEl.scrollLeft = x - span;
        isResetting = false;
        syncFromScroll();
        return;
      }

      if (lastBeforeClone && x <= getSlideScrollLeft(lastBeforeClone) + threshold) {
        isResetting = true;
        scrollEl.scrollLeft = x + span;
        isResetting = false;
        syncFromScroll();
      }
    };

    const goNext = () => {
      if (isResetting || count <= 1) return;
      if (logicalIndex < count - 1) {
        scrollToLogical(logicalIndex + 1);
      } else {
        loopForward();
      }
    };

    const goPrev = () => {
      if (isResetting || count <= 1) return;
      if (logicalIndex > 0) {
        scrollToLogical(logicalIndex - 1);
      } else {
        loopBackward();
      }
    };

    const updateViewportMode = () => {
      scrollEl.classList.toggle('is-centered', count <= 1 && !canScrollLoop());
    };

    const buildDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = '';
      dots = [];
      for (let i = 0; i < count; i += 1) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'lame-cosmetic-categories__dot';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Category ${i + 1}`);
        dot.addEventListener('click', () => {
          scrollToLogical(i);
          restartAutoplay();
        });
        dotsWrap.appendChild(dot);
        dots.push(dot);
      }
    };

    const updateUI = () => {
      const showControls = count > 1;
      if (prev) {
        prev.hidden = !showControls;
        prev.disabled = false;
      }
      if (next) {
        next.hidden = !showControls;
        next.disabled = false;
      }
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === logicalIndex);
        dot.setAttribute('aria-selected', i === logicalIndex ? 'true' : 'false');
      });
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (!autoplayEnabled || count <= 1) return;
      autoplayTimer = window.setInterval(goNext, autoplaySpeed);
    };

    const restartAutoplay = () => {
      stopAutoplay();
      startAutoplay();
    };

    const syncFromScroll = () => {
      if (isResetting) return;
      normalizeLoopPosition();
      if (isResetting) return;

      const scrollLeft = scrollEl.scrollLeft;
      let nearest = logicalIndex;
      let nearestDist = Infinity;
      for (let i = 0; i < count; i += 1) {
        const child = track.children[offsetStart + i];
        if (!child) continue;
        const dist = Math.abs(getSlideScrollLeft(child) - scrollLeft);
        if (dist < nearestDist) {
          nearestDist = dist;
          nearest = i;
        }
      }
      logicalIndex = nearest;
      updateUI();
    };

    prev?.addEventListener('click', () => {
      goPrev();
      restartAutoplay();
    });

    next?.addEventListener('click', () => {
      goNext();
      restartAutoplay();
    });

    scrollEl.addEventListener('scroll', syncFromScroll, { passive: true });

    section.addEventListener('mouseenter', stopAutoplay);
    section.addEventListener('mouseleave', startAutoplay);

    const init = () => {
      ensureExtraClones();
      measureLoopBounds();
      updateViewportMode();
      isResetting = true;
      logicalIndex = 0;
      scrollToPhysical(offsetStart, false);
      isResetting = false;
      buildDots();
      updateUI();
      startAutoplay();
    };

    init();
    window.addEventListener('resize', () => {
      ensureExtraClones();
      measureLoopBounds();
      updateViewportMode();
      isResetting = true;
      scrollToPhysical(offsetStart + logicalIndex, false);
      isResetting = false;
      updateUI();
    });
  })();
</script>

{% schema %}
{
  "name": "Cosmetic categories",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 8,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Natural care for every you." },
    { "type": "text", "id": "link_label", "label": "Card link label", "default": "Shop now" },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto-rotate speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous button label",
      "default": "Previous categories"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "default": "Next categories"
    },
    {
      "type": "text",
      "id": "dots_label",
      "label": "Pagination label",
      "default": "Category pages"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Skin Care" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cosmetic categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Bath & Body", "collection": "bath-body" } },
        { "type": "category", "settings": { "title": "Fragrance", "collection": "fragrance" } },
        { "type": "category", "settings": { "title": "Hair Care", "collection": "hair-care" } },
        { "type": "category", "settings": { "title": "Makeup", "collection": "make-up" } }
      ]
    }
  ]
}
{% endschema %}
