<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-cosmetic-categories"
  {{ section.shopify_attributes }}
>
  <div class="lame-cosmetic-categories__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-cosmetic-categories__header" data-lame-reveal>
      {% render 'lame-section-heading',
        title: section.settings.heading,
        subtitle: section.settings.subheading,
        alignment: 'center',
        show_divider: false
      %}
    </header>

    <ul class="lame-cosmetic-categories__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = collections[block.settings.collection]
          assign card_title = block.settings.title
          if card_title == blank and collection != blank
            assign card_title = collection.title
          endif
          assign card_link = block.settings.link
          if card_link == blank and collection != blank
            assign card_link = collection.url
          endif
          assign card_image = block.settings.image
          if card_image == blank and collection != blank and collection.featured_image
            assign card_image = collection.featured_image
          endif
        -%}
        <li class="lame-cosmetic-categories__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <a href="{{ card_link | default: '#' }}" class="lame-cosmetic-categories__card">
            <div class="lame-cosmetic-categories__media">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'lame-cosmetic-categories__image',
                    loading: 'lazy',
                    widths: '300,400,500,600,800',
                    sizes: '(min-width: 990px) 22vw, (min-width: 750px) 44vw, 88vw',
                    alt: card_title | escape
                }}
              {%- else -%}
                {{ 'collection-apparel-1' | placeholder_svg_tag: 'lame-cosmetic-categories__image placeholder-svg' }}
              {%- endif -%}
              <div class="lame-cosmetic-categories__overlay">
                {%- if card_title != blank -%}
                  <h3 class="lame-cosmetic-categories__title">{{ card_title }}</h3>
                {%- endif -%}
                {%- if section.settings.link_label != blank -%}
                  <span class="lame-cosmetic-categories__link">{{ section.settings.link_label }} <span aria-hidden="true">→</span></span>
                {%- endif -%}
              </div>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% schema %}
{
  "name": "Cosmetic categories",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 6,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Natural care for every you." },
    { "type": "text", "id": "link_label", "label": "Card link label", "default": "Shop now" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Skin Care" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cosmetic categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Makeup" } },
        { "type": "category", "settings": { "title": "Mom & Baby" } },
        { "type": "category", "settings": { "title": "Skin Care" } },
        { "type": "category", "settings": { "title": "Hair Care" } }
      ]
    }
  ]
}
{% endschema %}
