
<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% liquid
  assign lame_cosmetic_collection = false
  if template.suffix == 'our-products'
    assign lame_cosmetic_collection = true
  endif

  if lame_cosmetic_collection
    assign lame_product_grid_item_class = 'product-grid__item lame-op-card__item'
  else
    assign lame_product_grid_item_class = 'product-grid__item product-grid__item--premium'
  endif
%}

{% if template.name == 'collection' %}
  {% render 'lame-collection-premium' %}
{% endif %}

{% comment %}
  Our Products cards: isolated layout in assets/lame-our-products-cards.css
  Edit --lame-op-columns-desktop, --lame-op-image-height there.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section section--full-width product-grid-container premium-products-shell color-{{ section.settings.color_scheme }} uniform-products-page lame-collection-premium-active{% if collection.handle == 'all' %} all-products-page{% endif %}{% if lame_cosmetic_collection %} collection-template-our-products lame-our-products-grid lame-our-products-card-scope{% endif %}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{% if lame_cosmetic_collection %}false{% else %}{{ section.settings.enable_infinite_scroll }}{% endif %}"
  {% if lame_cosmetic_collection %}data-lame-our-products="true"{% endif %}
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div class="lame-collection-shell">
    <div
      class="collection-wrapper grid gap-style lame-collection-layout lame-collection-layout--sidebar-left{% if section.settings.product_grid_width == 'full-width' or lame_cosmetic_collection %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% liquid
        if lame_cosmetic_collection
          assign products_per_page = 12
          assign use_infinite_scroll = false
        else
          assign products_per_page = 24
          assign use_infinite_scroll = section.settings.enable_infinite_scroll
          if use_infinite_scroll == false
            assign products_per_page = section.settings.products_per_page
          endif
        endif
      %}

      {% paginate collection.products by products_per_page %}
        <div class="lame-collection-products-column" data-lame-products-scroll>
          <div class="lame-collection-brand-nav-wrap">
            {% render 'lame-collection-brand-filter', collection: collection, products: collection.products %}
          </div>
        {% liquid
          assign group_by_brand = section.settings.group_products_by_brand
          if lame_cosmetic_collection and section.settings.group_products_by_brand_our_products == false
            assign group_by_brand = false
          endif
        %}

        {% if group_by_brand %}
          {% liquid
            assign brand_slugs_pipe = '|'
            assign brand_labels_json = ''
            for product in collection.products
              assign raw_vendor = product.vendor | strip
              assign raw_down = raw_vendor | downcase
              if raw_vendor == blank
                assign brand_slug = 'other'
                assign brand_label = 'Other'
              elsif raw_down contains 'lamstone'
                assign brand_slug = 'lamstone-healthcare'
                assign brand_label = 'Lamstone Healthcare'
              else
                assign brand_slug = raw_vendor | handleize
                assign brand_label = raw_vendor
              endif
              assign slug_token = '|' | append: brand_slug | append: '|'
              unless brand_slugs_pipe contains slug_token
                assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|'
                assign brand_labels_json = brand_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
              endunless
            endfor
            assign brand_slugs = brand_slugs_pipe | split: '|'
          %}
          {% capture children %}
            {% for brand_slug in brand_slugs %}
              {% if brand_slug == blank %}
                {% continue %}
              {% endif %}
              {% liquid
                assign brand_label = brand_slug
                assign label_chunks = brand_labels_json | split: '||'
                for chunk in label_chunks
                  if chunk contains brand_slug
                    assign brand_label = chunk | split: '::' | last
                    break
                  endif
                endfor
                assign brand_product_count = 0
                for product in collection.products
                  assign raw_vendor = product.vendor | strip
                  assign raw_down = raw_vendor | downcase
                  if raw_vendor == blank
                    assign product_slug = 'other'
                  elsif raw_down contains 'lamstone'
                    assign product_slug = 'lamstone-healthcare'
                  else
                    assign product_slug = raw_vendor | handleize
                  endif
                  if product_slug == brand_slug
                    assign brand_product_count = brand_product_count | plus: 1
                  endif
                endfor
              %}
              {% if brand_product_count > 0 %}
                <section
                  class="lame-collection-brand-section"
                  id="brand-{{ brand_slug }}"
                  aria-labelledby="brand-heading-{{ section.id }}-{{ brand_slug }}"
                >
                  <header class="lame-collection-brand-section__header">
                    <div class="lame-collection-brand-section__heading">
                      <h2
                        class="lame-collection-brand-section__title"
                        id="brand-heading-{{ section.id }}-{{ brand_slug }}"
                      >
                        {{ brand_label }}
                      </h2>
                      <p class="lame-collection-brand-section__count">
                        {{ 'lame_collection.brand_product_count' | t: count: brand_product_count }}
                      </p>
                    </div>
                  </header>
                  <ul
                    class="product-grid product-grid--{{ section.id }} product-grid--{{ section.settings.layout_type }} lame-collection-brand-section__grid{% if section.settings.mobile_product_card_size == 'large' %} product-grid-mobile--large{% endif %}"
                    data-testid="product-grid-brand-{{ brand_slug }}"
                    role="list"
                  >
                    {% assign item_index = 0 %}
                    {% for product in collection.products %}
                      {% liquid
                        assign raw_vendor = product.vendor | strip
                        assign raw_down = raw_vendor | downcase
                        if raw_vendor == blank
                          assign product_slug = 'other'
                        elsif raw_down contains 'lamstone'
                          assign product_slug = 'lamstone-healthcare'
                        else
                          assign product_slug = raw_vendor | handleize
                        endif
                      %}
                      {% if product_slug == brand_slug %}
                        <li
                          id="{{ section.id }}-{{ product.id }}"
                          class="{{ lame_product_grid_item_class }} product-grid__item--{{ item_index }}"
                          data-page="{{ paginate.current_page }}"
                          data-product-id="{{ product.id }}"
                          data-brand="{{ brand_label | escape }}"
                          ref="cards[]"
                        >
                          {% # theme-check-disable %}
                          {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                          {% # theme-check-enable %}
                        </li>
                        {% assign item_index = item_index | plus: 1 %}
                      {% endif %}
                    {% endfor %}
                  </ul>
                </section>
              {% endif %}
            {% endfor %}
          {% endcapture %}
        {% else %}
          {% capture children %}
            {% for product in collection.products %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="{{ lame_product_grid_item_class }} product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                data-brand="{{ product.vendor | escape }}"
                ref="cards[]"
              >
                {% # theme-check-disable %}
                {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                {% # theme-check-enable %}
              </li>
            {% endfor %}
          {% endcapture %}
        {% endif %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate,
            enable_infinite_scroll: use_infinite_scroll,
            grouped_by_brand: group_by_brand,
            lame_paginated_collection: lame_cosmetic_collection
          %}
        </div>
      {% endpaginate %}
    </div>
  </div>
</results-list>

{% stylesheet %}
  /* Hide default Shopify toolbar (item count, sort, grid density) — filters stay in sidebar / drawer */
  .lame-collection-premium-active .collection-wrapper > .facets.facets-controls-wrapper.facets--horizontal {
    display: none !important;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Brands"
    },
    {
      "type": "checkbox",
      "id": "group_products_by_brand",
      "label": "Group products by brand on the page",
      "default": true,
      "info": "Uses each product’s Vendor field as the brand name. Sections appear per brand on this page."
    },
    {
      "type": "checkbox",
      "id": "group_products_by_brand_our_products",
      "label": "Also group by brand on Our products template",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist on product images",
      "default": true,
      "info": "Only applies to the Our products collection template. Requires LAMÉ wishlist in theme settings."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": []
}
{% endschema %}
