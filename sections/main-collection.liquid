

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% if template.name == 'collection' %}
  {% render 'lame-collection-premium' %}
{% endif %}
{% if template.suffix == 'our-products' %}
<style>
  .collection-template-our-products {
    background:
      radial-gradient(circle at 15% 10%, rgba(221, 181, 109, 0.16), transparent 28%),
      radial-gradient(circle at 85% 20%, rgba(245, 210, 220, 0.22), transparent 30%),
      #fbf6eb !important;
    padding: 24px 18px 60px !important;
  }

  .collection-template-our-products .collection-wrapper {
    max-width: 1500px !important;
    margin: 0 auto !important;
    gap: 28px !important;
    align-items: flex-start !important;
  }

  .collection-template-our-products .facets,
  .collection-template-our-products facet-filters-form,
  .collection-template-our-products .facets-wrapper {
    background: rgba(255,255,255,0.52) !important;
    border: 1px solid rgba(190,150,80,0.25) !important;
    border-radius: 22px !important;
    padding: 18px !important;
    box-shadow: 0 18px 45px rgba(80,60,30,0.08) !important;
    position: sticky !important;
    top: 20px !important;
  }

  .collection-template-our-products .product-grid {
    gap: 28px !important;
  }

  .collection-template-our-products .product-grid__item {
    list-style: none !important;
  }

  .collection-template-our-products .card,
  .collection-template-our-products .product-card,
  .collection-template-our-products .card-wrapper,
  .collection-template-our-products product-card {
    background: rgba(255,255,255,0.62) !important;
    border: 1px solid rgba(185,145,75,0.22) !important;
    border-radius: 26px !important;
    overflow: hidden !important;
    box-shadow: 0 14px 38px rgba(64,48,24,0.09) !important;
    transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease !important;
  }

  .collection-template-our-products .card:hover,
  .collection-template-our-products .product-card:hover,
  .collection-template-our-products .card-wrapper:hover,
  .collection-template-our-products product-card:hover {
    transform: translateY(-6px) !important;
    box-shadow: 0 24px 55px rgba(64,48,24,0.14) !important;
    border-color: rgba(185,145,75,0.45) !important;
  }

  .collection-template-our-products img {
    object-fit: contain !important;
  }

  .collection-template-our-products .card__media,
  .collection-template-our-products .product-card__image,
  .collection-template-our-products .card-media,
  .collection-template-our-products .media {
    background: #fffaf0 !important;
    border-radius: 22px !important;
    overflow: hidden !important;
  }

  .collection-template-our-products .card__heading,
  .collection-template-our-products .product-card__title,
  .collection-template-our-products .card__information a {
    font-size: 15px !important;
    line-height: 1.35 !important;
    font-weight: 600 !important;
    color: #1f1b16 !important;
    display: -webkit-box !important;
    -webkit-line-clamp: 2 !important;
    -webkit-box-orient: vertical !important;
    overflow: hidden !important;
  }

  .collection-template-our-products .price,
  .collection-template-our-products .price-item {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #4a3420 !important;
  }

  .collection-template-our-products .badge,
  .collection-template-our-products .price__badge-sale {
    background: #fff !important;
    color: #6f4c1f !important;
    border: 1px solid rgba(185,145,75,0.35) !important;
    border-radius: 999px !important;
    padding: 7px 12px !important;
    font-size: 12px !important;
    font-weight: 600 !important;
  }

  .collection-template-our-products button,
  .collection-template-our-products .button,
  .collection-template-our-products .quick-add__submit {
    border-radius: 999px !important;
  }

  @media screen and (min-width: 990px) {
    .collection-template-our-products .collection-wrapper {
      display: grid !important;
      grid-template-columns: 260px 1fr !important;
    }

    .collection-template-our-products .product-grid {
      display: grid !important;
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .collection-template-our-products {
      padding: 20px 16px 50px !important;
    }

    .collection-template-our-products .product-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 20px !important;
    }

    .collection-template-our-products .facets,
    .collection-template-our-products facet-filters-form,
    .collection-template-our-products .facets-wrapper {
      position: relative !important;
      top: auto !important;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-template-our-products {
      padding: 14px 10px 44px !important;
    }

    .collection-template-our-products .collection-wrapper {
      display: block !important;
    }

    .collection-template-our-products .product-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 14px !important;
    }

    .collection-template-our-products .card,
    .collection-template-our-products .product-card,
    .collection-template-our-products .card-wrapper,
    .collection-template-our-products product-card {
      border-radius: 18px !important;
    }

    .collection-template-our-products .card__heading,
    .collection-template-our-products .product-card__title,
    .collection-template-our-products .card__information a {
      font-size: 12px !important;
      line-height: 1.3 !important;
    }

    .collection-template-our-products .price,
    .collection-template-our-products .price-item {
      font-size: 13px !important;
    }

    .collection-template-our-products .facets,
    .collection-template-our-products facet-filters-form,
    .collection-template-our-products .facets-wrapper {
      position: relative !important;
      top: auto !important;
      margin-bottom: 16px !important;
      padding: 14px !important;
      border-radius: 18px !important;
    }
  }
</style>
{% endif %}
{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section product-grid-container premium-products-shell color-{{ section.settings.color_scheme }} uniform-products-page lame-collection-premium-active{% if collection.handle == 'all' %} all-products-page{% endif %}{% if template.suffix == 'our-products' %} collection-template-our-products lame-luxury-glow-root lame-luxury-glow{% endif %}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{{ section.settings.enable_infinite_scroll }}"
>
  {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

  <div
    class="collection-wrapper grid gap-style{% if section.settings.product_grid_width == 'full-width' %} collection-wrapper--grid-full-width{% endif %}"
  >
    {% content_for 'block',
      type: 'filters',
      id: 'filters',
      results: collection,
      results_size: collection.products_count
    %}

    {% assign products_per_page = 24 %}

    {% if section.settings.enable_infinite_scroll == false %}
      {% assign products_per_page = section.settings.products_per_page %}
    {% endif %}

    {% paginate collection.products by products_per_page %}
      {% capture children %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
            {% # theme-check-enable %}
          </li>
        {% endfor %}
      {% endcapture %}

      {% render 'product-grid',
        section: section,
        children: children,
        products: collection.products,
        paginate: paginate,
        enable_infinite_scroll: section.settings.enable_infinite_scroll
      %}
    {% endpaginate %}
  </div>
</results-list>

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist hearts",
      "default": false,
      "info": "When the theme wishlist is enabled, shows a heart on product images for the Our Products collection template."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": []
}
{% endschema %}
