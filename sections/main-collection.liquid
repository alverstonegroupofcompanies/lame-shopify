<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% javascript %}
  const url = new URL(window.location.href);
  if (url.hash) {
    document.addEventListener(
      'DOMContentLoaded',
      () => {
        const card = document.getElementById(url.hash.slice(1));
        if (card) {
          card.scrollIntoView({ behavior: 'instant' });
        }
      },
      { once: true }
    );
  }
{% endjavascript %}

{% liquid
  assign lame_cosmetic_collection = false
  assign lame_category_shop_page = false
  assign lame_category_handle = collection.handle
  assign lame_category_hero_handles = 'bath-body,fragrance,make-up,skin-care,baby-mom,wellness,hair-care' | split: ','

  if template.name == 'collection' and collection != blank
    if lame_category_hero_handles contains collection.handle
      assign lame_category_shop_page = true
      assign lame_category_handle = collection.handle
    endif

    unless lame_category_shop_page
      assign lame_cosmetic_handles = 'bath-body,fragrance,make-up,skin-care,baby-mom,wellness,hair-care,frontpage' | split: ','
      if template.suffix == 'our-products' or collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
        assign lame_cosmetic_collection = true
      elsif lame_cosmetic_handles contains collection.handle
        assign lame_cosmetic_collection = true
      elsif section.settings.use_our_products_layout
        assign lame_cosmetic_collection = true
      endif
    endunless
  endif

  if lame_cosmetic_collection
    assign lame_product_grid_item_class = 'lame-category-shop__item'
  else
    assign lame_product_grid_item_class = 'product-grid__item product-grid__item--premium'
  endif
%}

{% if template.name == 'collection' and lame_category_shop_page == false %}
  {% render 'lame-collection-premium' %}
{% endif %}

{% comment %}
  Our Products cards: isolated layout in assets/lame-our-products-cards.css
  Edit --lame-op-columns-desktop, --lame-op-image-height there.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<results-list
  class="section section--full-width product-grid-container color-{{ section.settings.color_scheme }}{% if lame_category_shop_page %} lame-category-shop-page lame-category-shop-page--{{ lame_category_handle }}{% else %} premium-products-shell uniform-products-page lame-collection-premium-active{% if lame_cosmetic_collection %} all-products-page collection-template-our-products lame-our-products-grid lame-our-products--category-cards{% endif %}{% endif %}"
  style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  section-id="{{ section.id }}"
  infinite-scroll="{% if lame_cosmetic_collection or lame_category_shop_page %}false{% else %}{{ section.settings.enable_infinite_scroll }}{% endif %}"
  {% if lame_cosmetic_collection %}data-lame-our-products="true" data-lame-collection-layout="our-products"{% endif %}
  {% if lame_category_shop_page %}data-lame-category-shop="true"{% endif %}
>
  <div class="lame-collection-shell">
    <div
      class="collection-wrapper grid gap-style lame-collection-layout{% unless lame_category_shop_page %} lame-collection-layout--sidebar-left{% endunless %}{% if section.settings.product_grid_width == 'full-width' or lame_cosmetic_collection or lame_category_shop_page %} collection-wrapper--grid-full-width{% endif %}"
    >
      {% unless lame_category_shop_page %}
        {% content_for 'block',
          type: 'filters',
          id: 'filters',
          results: collection,
          results_size: collection.products_count
        %}
      {% endunless %}

      {% liquid
        if lame_category_shop_page or lame_cosmetic_collection
          assign products_per_page = 12
          assign use_infinite_scroll = false
        else
          assign products_per_page = 24
          assign use_infinite_scroll = section.settings.enable_infinite_scroll
          if use_infinite_scroll == false
            assign products_per_page = section.settings.products_per_page
          endif
        endif
      %}

      {% paginate collection.products by products_per_page %}
        {% liquid
          assign group_by_brand = section.settings.group_products_by_brand
          if lame_category_shop_page
            assign group_by_brand = false
          elsif lame_cosmetic_collection
            if section.settings.group_products_by_brand_our_products
              assign group_by_brand = true
            else
              assign group_by_brand = false
            endif
          endif

          assign lame_active_brand_slugs_pipe = '|'
          assign lame_active_brand_count = 0
          for filter in collection.filters
            if filter.param_name == 'filter.p.vendor'
              for value in filter.active_values
                assign raw_vendor = value.value | strip
                if raw_vendor == blank
                  assign raw_vendor = value.label | strip
                endif
                capture active_slug_capture
                  render 'lame-vendor-slug', vendor: raw_vendor
                endcapture
                assign active_slug = active_slug_capture | strip
                if active_slug == blank or active_slug == 'other'
                  capture active_slug_capture
                    render 'lame-vendor-slug', vendor: value.label
                  endcapture
                  assign active_slug = active_slug_capture | strip
                endif
                assign active_slug_token = '|' | append: active_slug | append: '|'
                unless lame_active_brand_slugs_pipe contains active_slug_token
                  assign lame_active_brand_slugs_pipe = lame_active_brand_slugs_pipe | append: active_slug | append: '|'
                  assign lame_active_brand_count = lame_active_brand_count | plus: 1
                endunless
              endfor
              break
            endif
          endfor

          assign has_active_brand_filter = false
          if lame_active_brand_count > 0
            assign has_active_brand_filter = true
          endif

          assign lame_active_brand_slug = blank
          if lame_active_brand_count == 1
            assign slug_parts = lame_active_brand_slugs_pipe | split: '|'
            for slug_part in slug_parts
              if slug_part != blank
                assign lame_active_brand_slug = slug_part
                break
              endif
            endfor
          endif
        %}
        <div
          class="lame-collection-products-column{% if has_active_brand_filter %} lame-collection-products-column--brand-selected{% endif %}"
          data-lame-products-scroll
          {% if has_active_brand_filter %}data-server-vendor-filter="true"{% endif %}
          {% if lame_active_brand_slug != blank %}data-active-brand="{{ lame_active_brand_slug }}"{% endif %}
        >
          <p class="lame-brand-filter-empty" data-lame-brand-filter-empty hidden>
            {{ 'lame_collection.brand_filter_no_results' | t | default: 'No products match the selected brands.' }}
          </p>
          {% liquid
            assign show_inline_header = false
            if lame_cosmetic_collection and section.settings.our_products_heading != blank
              assign show_inline_header = true
              if collection != blank and lame_category_hero_handles contains lame_category_handle
                assign show_inline_header = false
              endif
            endif
          %}
          {% if show_inline_header %}
            {% liquid
              assign inline_heading = section.settings.our_products_heading
              assign inline_subtitle = section.settings.our_products_subtitle
              if collection != blank
                case lame_category_handle
                  when 'bath-body'
                    assign inline_heading = 'Bath & Body'
                    assign inline_subtitle = 'Soothing body care rituals for soft, nourished skin.'
                  when 'fragrance'
                    assign inline_heading = 'Fragrance'
                    assign inline_subtitle = 'Signature scents crafted to leave a lasting impression.'
                  when 'skin-care'
                    assign inline_heading = 'Skin Care'
                    assign inline_subtitle = 'Botanical formulas for radiant, healthy skin every day.'
                  when 'make-up'
                    assign inline_heading = 'Makeup'
                    assign inline_subtitle = 'Clean beauty essentials for your natural glow.'
                  when 'baby-mom'
                    assign inline_heading = 'Mom & Baby'
                    assign inline_subtitle = 'Gentle, safe care for moms and little ones.'
                  when 'wellness'
                    assign inline_heading = 'Wellness'
                    assign inline_subtitle = 'Holistic wellness for your everyday self-care routine.'
                  when 'hair-care'
                    assign inline_heading = 'Hair Care'
                    assign inline_subtitle = 'Plant-powered care for healthy hair that shines naturally.'
                  when 'frontpage'
                    assign inline_heading = 'Hair Care'
                    assign inline_subtitle = 'Plant-powered care for healthy hair that shines naturally.'
                endcase
              endif
            %}
            <div class="lame-our-products-inline-header">
              <h1 class="lame-our-products-inline-header__title">{{ inline_heading | escape }}</h1>
              {% if inline_subtitle != blank %}
                <p class="lame-our-products-inline-header__subtitle">{{ inline_subtitle | escape }}</p>
              {% endif %}
            </div>
          {% endif %}

          {% if lame_category_shop_page %}
            {% render 'lame-category-price-sort', collection: collection, paginate: paginate %}
          {% elsif lame_cosmetic_collection %}
            {% liquid
              assign lame_filters_block = section.blocks['filters']
              assign lame_enable_sorting = false
              assign lame_enable_grid_density = false
              if lame_filters_block != blank
                assign lame_enable_sorting = lame_filters_block.settings.enable_sorting
                assign lame_enable_grid_density = lame_filters_block.settings.enable_grid_density
              endif
            %}
            {% render 'lame-our-products-toolbar',
              collection: collection,
              paginate: paginate,
              section: section,
              enable_sorting: lame_enable_sorting,
              enable_grid_density: lame_enable_grid_density
            %}
          {% endif %}

        {% if lame_category_shop_page %}
          {% capture children %}
            {% for product in collection.products %}
              <li class="lame-category-shop__item" data-product-id="{{ product.id }}">
                {% render 'lame-category-product-card',
                  product: product,
                  section: section,
                  collection_handle: lame_category_handle,
                  show_wishlist: section.settings.show_wishlist
                %}
              </li>
            {% endfor %}
          {% endcapture %}
        {% elsif group_by_brand %}
          {% liquid
            assign brand_slugs_pipe = '|'
            assign brand_labels_json = ''
            for product in collection.products
              assign raw_vendor = product.vendor | strip
              capture product_slug_capture
                render 'lame-vendor-slug', vendor: raw_vendor
              endcapture
              assign brand_slug = product_slug_capture | strip
              if raw_vendor == blank
                assign brand_label = 'Other'
              else
                assign brand_label = raw_vendor
              endif
              assign slug_token = '|' | append: brand_slug | append: '|'
              unless brand_slugs_pipe contains slug_token
                assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|'
                assign brand_labels_json = brand_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
              endunless
            endfor
            assign brand_slugs = brand_slugs_pipe | split: '|'
          %}
          {% capture children %}
            {% for brand_slug in brand_slugs %}
              {% if brand_slug == blank %}
                {% continue %}
              {% endif %}
              {% liquid
                assign brand_label = brand_slug
                assign label_chunks = brand_labels_json | split: '||'
                for chunk in label_chunks
                  assign chunk_slug = chunk | split: '::' | first
                  if chunk_slug == brand_slug
                    assign brand_label = chunk | split: '::' | last
                    break
                  endif
                endfor
                assign brand_product_count = 0
                for product in collection.products
                  assign raw_vendor = product.vendor | strip
                  capture product_slug_capture
                    render 'lame-vendor-slug', vendor: raw_vendor
                  endcapture
                  assign product_slug = product_slug_capture | strip
                  if product_slug == brand_slug
                    assign brand_product_count = brand_product_count | plus: 1
                  endif
                endfor
              %}
              {% if brand_product_count > 0 %}
                {% liquid
                  assign show_brand_section_header = false
                  if lame_active_brand_slug != blank and brand_slug == lame_active_brand_slug
                    assign show_brand_section_header = true
                  endif
                %}
                <section
                  class="lame-collection-brand-section{% if show_brand_section_header %} lame-collection-brand-section--show-header{% endif %}"
                  id="brand-{{ brand_slug }}"
                  data-brand-slug="{{ brand_slug }}"
                  data-brand="{{ brand_label | escape }}"
                  {% if show_brand_section_header %}aria-labelledby="brand-heading-{{ section.id }}-{{ brand_slug }}"{% else %}aria-label="{{ brand_label }}"{% endif %}
                >
                  {% if show_brand_section_header %}
                    <header class="lame-collection-brand-section__header">
                      <div class="lame-collection-brand-section__heading">
                        <h2
                          class="lame-collection-brand-section__title"
                          id="brand-heading-{{ section.id }}-{{ brand_slug }}"
                        >
                          {{ brand_label }}
                        </h2>
                        <p class="lame-collection-brand-section__count">
                          {{ 'lame_collection.brand_product_count' | t: count: brand_product_count }}
                        </p>
                      </div>
                    </header>
                  {% endif %}
                  <ul
                    class="product-grid product-grid--{{ section.id }} product-grid--{{ section.settings.layout_type }}{% if lame_cosmetic_collection %} lame-category-shop__grid{% endif %} lame-collection-brand-section__grid{% if section.settings.mobile_product_card_size == 'large' %} product-grid-mobile--large{% endif %}"
                    data-testid="product-grid-brand-{{ brand_slug }}"
                    role="list"
                  >
                    {% assign item_index = 0 %}
                    {% for product in collection.products %}
                      {% liquid
                        assign raw_vendor = product.vendor | strip
                        capture product_slug_capture
                          render 'lame-vendor-slug', vendor: raw_vendor
                        endcapture
                        assign product_slug = product_slug_capture | strip
                      %}
                      {% if product_slug == brand_slug %}
                        <li
                          id="{{ section.id }}-{{ product.id }}"
                          class="{{ lame_product_grid_item_class }} product-grid__item--{{ item_index }}"
                          data-page="{{ paginate.current_page }}"
                          data-product-id="{{ product.id }}"
                          data-brand="{{ raw_vendor | escape }}"
                          data-brand-slug="{{ brand_slug }}"
                          ref="cards[]"
                        >
                          {% if lame_cosmetic_collection %}
                            {% render 'lame-category-product-card',
                              product: product,
                              section: section,
                              collection_handle: 'our-products',
                              show_wishlist: section.settings.show_wishlist
                            %}
                          {% else %}
                            {% # theme-check-disable %}
                            {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                            {% # theme-check-enable %}
                          {% endif %}
                        </li>
                        {% assign item_index = item_index | plus: 1 %}
                      {% endif %}
                    {% endfor %}
                  </ul>
                </section>
              {% endif %}
            {% endfor %}
          {% endcapture %}
        {% else %}
          {% capture children %}
            {% assign flat_grid_index = 0 %}
            {% for product in collection.products %}
              {% liquid
                assign raw_vendor = product.vendor | strip
                capture product_slug_capture
                  render 'lame-vendor-slug', vendor: raw_vendor
                endcapture
                assign product_brand_slug = product_slug_capture | strip
              %}
                <li
                  id="{{ section.id }}-{{ product.id }}"
                  class="{{ lame_product_grid_item_class }} product-grid__item--{{ flat_grid_index }}"
                  data-page="{{ paginate.current_page }}"
                  data-product-id="{{ product.id }}"
                  data-brand="{{ raw_vendor | escape }}"
                  data-brand-slug="{{ product_brand_slug }}"
                  ref="cards[]"
                >
                  {% if lame_cosmetic_collection %}
                    {% render 'lame-category-product-card',
                      product: product,
                      section: section,
                      collection_handle: 'our-products',
                      show_wishlist: section.settings.show_wishlist
                    %}
                  {% else %}
                    {% # theme-check-disable %}
                    {% content_for 'block', type: '_product-card', id: 'product-card', closest.product: product %}
                    {% # theme-check-enable %}
                  {% endif %}
                </li>
                {% assign flat_grid_index = flat_grid_index | plus: 1 %}
            {% endfor %}
          {% endcapture %}
        {% endif %}

          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate,
            enable_infinite_scroll: use_infinite_scroll,
            grouped_by_brand: group_by_brand,
            lame_paginated_collection: lame_cosmetic_collection,
            category_shop_grid: lame_category_shop_page or lame_cosmetic_collection
          %}
        </div>
      {% endpaginate %}
    </div>
  </div>
</results-list>

{% stylesheet %}
  /* Hide default Shopify toolbar (item count, sort, grid density) — filters stay in sidebar / drawer */
  .lame-collection-premium-active .collection-wrapper > .facets.facets-controls-wrapper.facets--horizontal {
    display: none !important;
  }

  .lame-category-shop-page .product-grid.lame-category-shop__grid {
    display: grid !important;
    --product-grid-columns-desktop: unset;
    --product-grid-gap-mobile: unset;
    --product-grid-gap-desktop: unset;
  }

  .lame-category-shop-page .lame-category-shop__item {
    display: block;
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.collection_container",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "organic",
          "label": "t:options.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "t:settings.card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "extra-large",
          "label": "t:options.extra_large"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "t:settings.mobile_card_size",
      "options": [
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "large",
          "label": "t:options.large"
        }
      ],
      "default": "small"
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "t:settings.auto_load_products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24,
      "visible_if": "{{ section.settings.enable_infinite_scroll == false }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "centered",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "centered"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "t:settings.full_width_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.product_grid_width != 'full-width' }}"
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Our Products layout"
    },
    {
      "type": "checkbox",
      "id": "use_our_products_layout",
      "label": "Use Our Products healthcare layout on this collection",
      "default": false,
      "info": "Also turns on automatically for the our-products theme template or handles listed in Theme settings → LAMÉ wishlist."
    },
    {
      "type": "text",
      "id": "our_products_heading",
      "label": "Page heading (when not using Our products header section)",
      "default": "Our Products"
    },
    {
      "type": "textarea",
      "id": "our_products_subtitle",
      "label": "Page subtitle",
      "default": "Trusted healthcare essentials for your everyday wellness."
    },
    {
      "type": "header",
      "content": "Brands"
    },
    {
      "type": "checkbox",
      "id": "group_products_by_brand",
      "label": "Group products by brand on the page",
      "default": true,
      "info": "Uses each product’s Vendor field as the brand name. Sections appear per brand on this page."
    },
    {
      "type": "checkbox",
      "id": "group_products_by_brand_our_products",
      "label": "Also group by brand on Our products template",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist on product images",
      "default": true,
      "info": "Only applies to the Our products collection template. Requires LAMÉ wishlist in theme settings."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": []
}
{% endschema %}
