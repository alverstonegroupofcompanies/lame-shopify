{{ 'lame-product-card.css' | asset_url | stylesheet_tag }}

{% liquid
  assign deal_collection = collections[section.settings.collection]
  if deal_collection == blank
    assign deal_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal"
  data-countdown-end="{{ section.settings.countdown_end | escape }}"
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <header class="lame-flash-deal__header">
        <h2 class="lame-flash-deal__title">{{ section.settings.heading }}</h2>
      </header>
    {% endif %}

    <ul class="lame-flash-deal__grid" role="list">
      {% for product in deal_collection.products limit: section.settings.products_to_show %}
        <li class="lame-flash-deal__item">
          <div class="lame-flash-deal__card">
            {% render 'lame-product-card',
              product: product,
              card_class: 'lame-product-card--horizontal',
              image_sizes: '(min-width: 750px) 220px, 42vw'
            %}

            {% if section.settings.show_countdown %}
              <div class="lame-flash-deal__countdown" data-flash-countdown hidden>
                <p class="lame-flash-deal__countdown-label">{{ section.settings.countdown_label }}</p>
                <div class="lame-flash-deal__timer" aria-live="polite">
                  <div class="lame-flash-deal__unit">
                    <span data-unit="days">00</span>
                    <small>{{ section.settings.label_days }}</small>
                  </div>
                  <div class="lame-flash-deal__unit">
                    <span data-unit="hours">00</span>
                    <small>{{ section.settings.label_hours }}</small>
                  </div>
                  <div class="lame-flash-deal__unit">
                    <span data-unit="minutes">00</span>
                    <small>{{ section.settings.label_minutes }}</small>
                  </div>
                  <div class="lame-flash-deal__unit">
                    <span data-unit="seconds">00</span>
                    <small>{{ section.settings.label_seconds }}</small>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-flash-deal__item">
            <div class="lame-flash-deal__card lame-flash-deal__card--placeholder">
              <p>Add products to the selected collection.</p>
            </div>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    const endRaw = section.dataset.countdownEnd;
    if (!endRaw) return;

    const endDate = new Date(endRaw);
    if (Number.isNaN(endDate.getTime())) return;

    const countdownBlocks = section.querySelectorAll('[data-flash-countdown]');
    if (!countdownBlocks.length) return;

    const pad = (n) => String(n).padStart(2, '0');

    const tick = () => {
      const now = Date.now();
      const diff = Math.max(0, endDate.getTime() - now);

      const days = Math.floor(diff / 86400000);
      const hours = Math.floor((diff % 86400000) / 3600000);
      const minutes = Math.floor((diff % 3600000) / 60000);
      const seconds = Math.floor((diff % 60000) / 1000);

      countdownBlocks.forEach((block) => {
        block.hidden = false;
        const daysEl = block.querySelector('[data-unit="days"]');
        const hoursEl = block.querySelector('[data-unit="hours"]');
        const minutesEl = block.querySelector('[data-unit="minutes"]');
        const secondsEl = block.querySelector('[data-unit="seconds"]');
        if (daysEl) daysEl.textContent = pad(days);
        if (hoursEl) hoursEl.textContent = pad(hours);
        if (minutesEl) minutesEl.textContent = pad(minutes);
        if (secondsEl) secondsEl.textContent = pad(seconds);
      });
    };

    tick();
    window.setInterval(tick, 1000);
  })();
</script>

{% stylesheet %}
  .lame-flash-deal__header {
    text-align: center;
    margin-bottom: 24px;
  }

  .lame-flash-deal__title {
    margin: 0;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #111;
  }

  .lame-flash-deal__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  .lame-flash-deal__card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: #fff;
    border: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-flash-deal__card--placeholder {
    padding: 32px;
    text-align: center;
    color: rgb(0 0 0 / 0.55);
  }

  .lame-flash-deal__countdown {
    padding: 16px 20px 20px;
    border-top: 1px solid rgb(0 0 0 / 0.06);
    background: #fafafa;
  }

  .lame-flash-deal__countdown-label {
    margin: 0 0 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.55);
  }

  .lame-flash-deal__timer {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .lame-flash-deal__unit {
    text-align: center;
    background: #111;
    color: #fff;
    padding: 10px 6px;
    border-radius: 4px;
  }

  .lame-flash-deal__unit span {
    display: block;
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }

  .lame-flash-deal__unit small {
    display: block;
    margin-top: 4px;
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  @media screen and (min-width: 990px) {
    .lame-flash-deal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lame-flash-deal__card {
      grid-template-columns: 1fr auto;
      align-items: stretch;
    }

    .lame-flash-deal__countdown {
      border-top: 0;
      border-left: 1px solid rgb(0 0 0 / 0.06);
      min-width: 200px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Flash deal",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flash Deal"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "End date & time",
      "info": "Format: YYYY-MM-DD HH:MM (store timezone). Example: 2026-12-31 23:59",
      "default": "2026-12-31 23:59"
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Offer ends in"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours label",
      "default": "Hrs"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes label",
      "default": "Min"
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "Seconds label",
      "default": "Sec"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Flash deal",
      "category": "Products"
    }
  ]
}
{% endschema %}
