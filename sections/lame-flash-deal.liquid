{% liquid
  assign deal_collection = collections[section.settings.collection]
  assign discount_target = section.settings.discount_percent
  assign discount_tolerance = section.settings.discount_tolerance
  assign min_discount = discount_target | minus: discount_tolerance
  assign max_discount = discount_target | plus: discount_tolerance
  assign products_limit = section.settings.products_to_show
  assign products_shown = 0
  assign filter_mode = section.settings.filter_mode | default: 'all'
  assign product_source = section.settings.product_source | default: 'collection'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    <header class="lame-flash-deal__header" data-lame-reveal>
      {% if section.settings.heading != blank %}
        <h2 class="lame-flash-deal__title">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.show_countdown %}
        <div
          class="lame-flash-deal__countdown"
          data-countdown
          data-countdown-start="{{ section.settings.countdown_start | escape }}"
          data-countdown-duration="{{ section.settings.countdown_duration_hours | times: 3600 }}"
          aria-label="{{ section.settings.countdown_label | escape }}"
        >
          {% if section.settings.countdown_label != blank %}
            <p class="lame-flash-deal__countdown-label">{{ section.settings.countdown_label }}</p>
          {% endif %}
          <div class="lame-flash-deal__countdown-units" role="timer">
            <div class="lame-flash-deal__unit">
              <span data-hours>00</span>
              <small>{{ section.settings.label_hours }}</small>
            </div>
            <span class="lame-flash-deal__sep" aria-hidden="true">:</span>
            <div class="lame-flash-deal__unit">
              <span data-minutes>00</span>
              <small>{{ section.settings.label_minutes }}</small>
            </div>
            <span class="lame-flash-deal__sep" aria-hidden="true">:</span>
            <div class="lame-flash-deal__unit">
              <span data-seconds>00</span>
              <small>{{ section.settings.label_seconds }}</small>
            </div>
          </div>
        </div>
      {% endif %}
    </header>

    <ul class="lame-flash-deal__grid" role="list">
      {% if product_source == 'manual' %}
        {% for block in section.blocks %}
          {% if products_shown >= products_limit %}
            {% break %}
          {% endif %}
          {% if block.type != 'product' or block.settings.product == blank %}
            {% continue %}
          {% endif %}

          {% assign product = block.settings.product %}
          {% render 'lame-flash-deal-product',
            product: product,
            badge_label: section.settings.badge_label,
            reveal_delay: products_shown | modulo: 2,
            block_attributes: block.shopify_attributes
          %}
          {% assign products_shown = products_shown | plus: 1 %}
        {% endfor %}
      {% elsif deal_collection != blank %}
        {% for product in deal_collection.products %}
          {% if products_shown >= products_limit %}
            {% break %}
          {% endif %}

          {% liquid
            assign selected_variant = product.selected_or_first_available_variant
            assign compare_at = selected_variant.compare_at_price
            assign price = selected_variant.price
            assign qualifies = true

            if filter_mode == 'on_sale' or filter_mode == 'compare_at_range'
              assign qualifies = false
              if compare_at > price
                if filter_mode == 'on_sale'
                  assign qualifies = true
                else
                  assign discount_percent = compare_at | minus: price | times: 100 | divided_by: compare_at
                  if discount_percent >= min_discount and discount_percent <= max_discount
                    assign qualifies = true
                  endif
                endif
              endif
            endif
          %}

          {% unless qualifies %}
            {% continue %}
          {% endunless %}

          {% render 'lame-flash-deal-product',
            product: product,
            badge_label: section.settings.badge_label,
            reveal_delay: products_shown | modulo: 2
          %}
          {% assign products_shown = products_shown | plus: 1 %}
        {% endfor %}
      {% endif %}

      {% if products_shown == 0 %}
        {% for i in (1..products_limit) %}
          <li class="lame-flash-deal__item" data-lame-reveal>
            <article class="lame-flash-deal__empty">
              <p>{{ section.settings.empty_text }}</p>
            </article>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-flash-deal__wrap {
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .lame-flash-deal__header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .lame-flash-deal__title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: rgb(var(--brand-ink));
    text-transform: capitalize;
  }

  .lame-flash-deal__countdown {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .lame-flash-deal__countdown-label {
    margin: 0;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.78);
  }

  .lame-flash-deal__countdown-units {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
  }

  .lame-flash-deal__unit {
    min-width: 3.25rem;
    text-align: center;
  }

  .lame-flash-deal__unit span {
    display: block;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: #111;
  }

  .lame-flash-deal__unit small {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.72);
  }

  .lame-flash-deal__sep {
    font-size: 1.2rem;
    font-weight: 700;
    color: rgb(0 0 0 / 0.55);
    line-height: 1;
    padding-bottom: 0.85rem;
  }

  .lame-flash-deal__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
  }

  .lame-flash-deal__item {
    min-width: 0;
  }

  .lame-flash-deal__empty {
    margin: 0;
    min-height: 200px;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 1rem;
    border: 1px dashed rgb(0 0 0 / 0.12);
    background: rgb(0 0 0 / 0.02);
  }

  .lame-flash-deal__empty p {
    margin: 0;
    font-size: 0.875rem;
    color: rgb(0 0 0 / 0.78);
    line-height: 1.45;
  }

  .lame-flash-deal .lame-home-product-card--flash .lame-home-product-card__media {
    aspect-ratio: 1;
    background: #fafafa;
    border-radius: 2px;
  }

  .lame-flash-deal .lame-home-product-card__badge {
    top: 0.4rem;
    left: 0.4rem;
    right: auto;
    background: #c41e3a;
    font-size: 0.75rem;
    padding: 0.28rem 0.45rem;
    border-radius: 2px;
    text-transform: uppercase;
  }

  @media screen and (max-width: 549px) {
    .lame-flash-deal__grid {
      gap: 0.75rem;
    }

    .lame-flash-deal__unit span {
      font-size: 1.15rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    const pad = (n) => String(n).padStart(2, '0');
    section.querySelectorAll('[data-countdown]').forEach((root) => {
      const startRaw = root.dataset.countdownStart;
      const durationSeconds = Number(root.dataset.countdownDuration) || 86400;
      if (!startRaw) return;

      const start = new Date(startRaw.replace(' ', 'T'));
      if (Number.isNaN(start.getTime())) return;

      const end = new Date(start.getTime() + durationSeconds * 1000);
      const hoursNode = root.querySelector('[data-hours]');
      const minutesNode = root.querySelector('[data-minutes]');
      const secondsNode = root.querySelector('[data-seconds]');

      const tick = () => {
        const diff = end.getTime() - Date.now();
        if (diff <= 0) {
          if (hoursNode) hoursNode.textContent = '00';
          if (minutesNode) minutesNode.textContent = '00';
          if (secondsNode) secondsNode.textContent = '00';
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        const hours = Math.floor(totalSeconds / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        if (hoursNode) hoursNode.textContent = pad(hours);
        if (minutesNode) minutesNode.textContent = pad(minutes);
        if (secondsNode) secondsNode.textContent = pad(seconds);
      };

      tick();
      window.setInterval(tick, 1000);
    });
  })();
</script>

{% schema %}
{
  "name": "Flash deal",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flash Deal" },
    {
      "type": "select",
      "id": "product_source",
      "label": "Products to show",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "manual", "label": "Hand-picked products (blocks below)" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Create a collection (e.g. “Sale” or “Discount”) and add your deal products. Shopify Admin → Discounts does not feed this section automatically."
    },
    {
      "type": "select",
      "id": "filter_mode",
      "label": "Collection filter",
      "options": [
        { "value": "all", "label": "All products in collection" },
        { "value": "on_sale", "label": "Only products with compare-at price (any % off)" },
        { "value": "compare_at_range", "label": "Only products near target discount %" }
      ],
      "default": "all",
      "info": "Use “All products” when products use Shopify automatic discounts (no compare-at price)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Discount badge",
      "default": "10% OFF"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Target discount (%)",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "info": "Used only when collection filter is “near target discount %”."
    },
    {
      "type": "range",
      "id": "discount_tolerance",
      "label": "Discount tolerance (±%)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2,
      "info": "Used only when collection filter is “near target discount %”."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Select a collection with products, or add product blocks. Theme editor → Flash deal → Collection."
    },
    { "type": "header", "content": "24-hour countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    {
      "type": "text",
      "id": "countdown_start",
      "label": "Deal start (YYYY-MM-DD HH:MM)",
      "default": "2026-05-17 00:00",
      "info": "Timer counts down for 24 hours from this date and time (store timezone)."
    },
    {
      "type": "range",
      "id": "countdown_duration_hours",
      "label": "Countdown duration (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "Ends in"
    },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_minutes", "label": "Minutes label", "default": "Min" },
    { "type": "text", "id": "label_seconds", "label": "Seconds label", "default": "Sec" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flash deal",
      "category": "Products",
      "settings": {
        "product_source": "collection",
        "filter_mode": "all"
      }
    }
  ]
}
{% endschema %}
