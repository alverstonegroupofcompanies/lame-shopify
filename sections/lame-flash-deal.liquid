{% liquid
  assign deal_collection = collections[section.settings.collection]
  if deal_collection == blank
    assign deal_collection = collections.all
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <header class="lame-flash-deal__header" data-lame-reveal>
        <h2 class="lame-flash-deal__title">{{ section.settings.heading }}</h2>
      </header>
    {% endif %}

    <ul class="lame-flash-deal__grid" role="list">
      {% for product in deal_collection.products limit: section.settings.products_to_show %}
        <li class="lame-flash-deal__item" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 2 }}">
          <div class="lame-flash-deal__card">
            {% render 'lame-home-product-card',
              product: product,
              card_style: 'flash',
              show_sale_badge: true,
              show_type: true,
              show_rating: true
            %}
            {% if section.settings.show_countdown %}
              <div
                class="lame-flash-deal__countdown"
                data-countdown
                data-countdown-end="{{ section.settings.countdown_end | escape }}"
                aria-label="{{ section.settings.countdown_label | escape }}"
              >
                <p class="lame-flash-deal__countdown-label">{{ section.settings.countdown_label }}</p>
                <div class="lame-flash-deal__countdown-units">
                  <div class="lame-flash-deal__unit"><span data-days>00</span><small>{{ section.settings.label_days }}</small></div>
                  <div class="lame-flash-deal__unit"><span data-hours>00</span><small>{{ section.settings.label_hours }}</small></div>
                  <div class="lame-flash-deal__unit"><span data-minutes>00</span><small>{{ section.settings.label_minutes }}</small></div>
                  <div class="lame-flash-deal__unit"><span data-seconds>00</span><small>{{ section.settings.label_seconds }}</small></div>
                </div>
              </div>
            {% endif %}
          </div>
        </li>
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li class="lame-flash-deal__item" data-lame-reveal>
            <div class="lame-flash-deal__card lame-flash-deal__card--placeholder">
              <p>{{ section.settings.empty_text }}</p>
            </div>
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-flash-deal__header {
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .lame-flash-deal__title {
    margin: 0;
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    font-weight: 700;
    color: #111;
    text-transform: capitalize;
  }

  .lame-flash-deal__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .lame-flash-deal__card {
    border: 1px solid rgb(0 0 0 / 0.1);
    background: #fff;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .lame-flash-deal__card--placeholder {
    min-height: 220px;
    place-content: center;
    text-align: center;
    color: rgb(0 0 0 / 0.55);
    font-size: 0.85rem;
  }

  .lame-flash-deal__countdown {
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid rgb(0 0 0 / 0.08);
  }

  .lame-flash-deal__countdown-label {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(0 0 0 / 0.55);
    text-align: center;
  }

  .lame-flash-deal__countdown-units {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .lame-flash-deal__unit {
    background: #111;
    color: #fff;
    text-align: center;
    padding: 0.45rem 0.25rem;
    border-radius: 2px;
  }

  .lame-flash-deal__unit span {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .lame-flash-deal__unit small {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .lame-flash-deal .lame-home-product-card--flash .lame-home-product-card__media {
    aspect-ratio: 1 / 0.95;
    background: #f7f7f7;
  }

  @media screen and (min-width: 750px) {
    .lame-flash-deal__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    const pad = (n) => String(n).padStart(2, '0');
    section.querySelectorAll('[data-countdown]').forEach((root) => {
      const endRaw = root.dataset.countdownEnd;
      if (!endRaw) return;
      const end = new Date(endRaw.replace(' ', 'T'));
      if (Number.isNaN(end.getTime())) return;

      const daysNode = root.querySelector('[data-days]');
      const hoursNode = root.querySelector('[data-hours]');
      const minutesNode = root.querySelector('[data-minutes]');
      const secondsNode = root.querySelector('[data-seconds]');

      const tick = () => {
        const diff = end.getTime() - Date.now();
        if (diff <= 0) {
          if (daysNode) daysNode.textContent = '00';
          if (hoursNode) hoursNode.textContent = '00';
          if (minutesNode) minutesNode.textContent = '00';
          if (secondsNode) secondsNode.textContent = '00';
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        if (daysNode) daysNode.textContent = pad(days);
        if (hoursNode) hoursNode.textContent = pad(hours);
        if (minutesNode) minutesNode.textContent = pad(minutes);
        if (secondsNode) secondsNode.textContent = pad(seconds);
      };

      tick();
      window.setInterval(tick, 1000);
    });
  })();
</script>

{% schema %}
{
  "name": "Flash deal products",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flash Deal" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Add products to this collection to show flash deals."
    },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown end (YYYY-MM-DD HH:MM)",
      "default": "2026-12-31 23:59"
    },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "Offer ends in" },
    { "type": "text", "id": "label_days", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_minutes", "label": "Minutes label", "default": "Min" },
    { "type": "text", "id": "label_seconds", "label": "Seconds label", "default": "Sec" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [{ "name": "Flash deal products", "category": "Products" }]
}
{% endschema %}

