{% liquid
  assign deal_collection = collections[section.settings.collection]
  assign discount_target = section.settings.discount_percent
  assign discount_tolerance = section.settings.discount_tolerance
  assign min_discount = discount_target | minus: discount_tolerance
  assign max_discount = discount_target | plus: discount_tolerance
  assign products_limit = section.settings.products_to_show
  assign products_shown = 0
  assign filter_mode = section.settings.filter_mode | default: 'all'
  assign product_source = section.settings.product_source | default: 'collection'
%}

{% capture deal_products_markup %}
  {% if product_source == 'manual' %}
    {% for block in section.blocks %}
      {% if products_shown >= products_limit %}
        {% break %}
      {% endif %}
      {% if block.type != 'product' or block.settings.product == blank %}
        {% continue %}
      {% endif %}

      {% assign product = block.settings.product %}
      {% render 'lame-flash-deal-product', product: product, product_index: products_shown, products_limit: products_limit, badge_label: section.settings.badge_label, add_to_cart_label: section.settings.add_to_cart_label, sold_out_label: section.settings.sold_out_label, review_count_fallback: section.settings.review_count_fallback, save_label_prefix: section.settings.save_label_prefix, reveal_delay: products_shown, modulo: 2, block_attributes: block.shopify_attributes %}
      {% assign products_shown = products_shown | plus: 1 %}
    {% endfor %}
  {% elsif deal_collection != blank %}
    {% for product in deal_collection.products %}
      {% if products_shown >= products_limit %}
        {% break %}
      {% endif %}

      {% liquid
        assign selected_variant = product.selected_or_first_available_variant
        assign compare_at = selected_variant.compare_at_price
        assign price = selected_variant.price
        assign qualifies = true

        if filter_mode == 'on_sale' or filter_mode == 'compare_at_range'
          assign qualifies = false
          if compare_at > price
            if filter_mode == 'on_sale'
              assign qualifies = true
            else
              assign discount_percent = compare_at | minus: price | times: 100 | divided_by: compare_at
              if discount_percent >= min_discount and discount_percent <= max_discount
                assign qualifies = true
              endif
            endif
          endif
        endif
      %}

      {% unless qualifies %}
        {% continue %}
      {% endunless %}

      {% render 'lame-flash-deal-product', product: product, product_index: products_shown, products_limit: products_limit, badge_label: section.settings.badge_label, add_to_cart_label: section.settings.add_to_cart_label, sold_out_label: section.settings.sold_out_label, review_count_fallback: section.settings.review_count_fallback, save_label_prefix: section.settings.save_label_prefix, reveal_delay: products_shown, modulo: 2 %}
      {% assign products_shown = products_shown | plus: 1 %}
    {% endfor %}
  {% endif %}
{% endcapture %}

{% liquid
  assign show_deal_section = false
  assign deal_section_paused = false

  if section.settings.offer_active
    if products_shown > 0
      assign show_deal_section = true
    elsif request.design_mode
      assign show_deal_section = true
    elsif section.settings.hide_when_empty == false
      assign show_deal_section = true
    endif
  elsif request.design_mode
    assign show_deal_section = true
    assign deal_section_paused = true
  endif

  assign countdown_active = false
  if section.settings.show_countdown and section.settings.countdown_start != blank
    assign countdown_start_iso = section.settings.countdown_start | strip | replace: ' ', 'T'
    assign countdown_start_ts = countdown_start_iso | date: '%s' | plus: 0
    assign countdown_duration_seconds = section.settings.countdown_duration_hours | times: 3600
    assign countdown_end_ts = countdown_start_ts | plus: countdown_duration_seconds
    assign now_ts = 'now' | date: '%s' | plus: 0
    if countdown_start_ts > 0 and now_ts >= countdown_start_ts and now_ts < countdown_end_ts
      assign countdown_active = true
    endif
  endif
%}

{% if show_deal_section %}
{%- liquid
  assign title_full_width = false
  if section.settings.heading_image_full_width
    assign title_full_width = true
  endif

  assign title_mobile_full_width = false
  if section.settings.heading_image_mobile_full_width
    assign title_mobile_full_width = true
  elsif section.settings.heading_image_mobile_full_width == nil and title_full_width
    assign title_mobile_full_width = true
  endif

  assign is_glow_up_daily = false
  assign heading_lower = section.settings.heading | default: '' | downcase
  if heading_lower contains 'glow up' or section.id contains 'row_skin_care'
    assign is_glow_up_daily = true
  endif

  if is_glow_up_daily
    assign title_mobile_full_width = true
  endif

  assign bg_color = section.settings.section_background_color_code | default: '' | strip
  if bg_color == blank
    assign bg_color = section.settings.section_background_color
  endif
  if bg_color == 'transparent' or bg_color == 'rgba(0,0,0,0)' or bg_color == blank
    assign bg_color = ''
  endif

  assign below_banner_only = section.settings.background_below_banner_only
  if below_banner_only == nil
    assign below_banner_only = true
  endif

  assign content_bg = ''
  assign whole_section_bg = ''
  if bg_color != blank
    if below_banner_only
      assign content_bg = bg_color
    else
      assign whole_section_bg = bg_color
    endif
  endif
-%}

{{ 'lame-flash-deal.css' | asset_url | stylesheet_tag }}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-flash-deal{% if is_glow_up_daily %} lame-flash-deal--glow-up-daily{% endif %}{% if title_full_width %} lame-flash-deal--title-full-width{% endif %}{% if title_mobile_full_width %} lame-flash-deal--title-mobile-full-width{% endif %}{% if content_bg != blank %} lame-flash-deal--has-content-bg{% endif %}"
  data-flash-deal-carousel
  style="--lame-flash-visible-count: {{ products_shown | at_least: 1 | at_most: products_limit }};{% if is_glow_up_daily %} --lame-flash-banner-ratio: 1920 / 237;{% endif %}{% if whole_section_bg != blank %} background-color: {{ whole_section_bg }};{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-flash-deal__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if deal_section_paused %}
      <p class="lame-flash-deal__paused-notice" role="status">
        Offer is paused — enable <strong>Offer active</strong> in section settings to show this on the live storefront.
      </p>
    {% endif %}

    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtitle != blank or section.settings.heading_image != blank or section.settings.heading_image_asset != blank or countdown_active %}
    <header class="lame-flash-deal__header{% if title_full_width %} lame-flash-deal__header--full-width{% endif %}{% if title_mobile_full_width %} lame-flash-deal__header--mobile-full-width{% endif %}" data-lame-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lame-flash-deal__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- liquid
        assign heading_image = section.settings.heading_image
        assign heading_image_mobile = section.settings.heading_image_mobile
        assign heading_image_asset = section.settings.heading_image_asset | strip
        assign heading_alt = section.settings.heading | default: 'Best Selling'
        assign show_heading_mobile = true
        if section.settings.show_heading_image_mobile == false
          assign show_heading_mobile = false
        endif
        assign use_heading_image = false
        if heading_image != blank or heading_image_asset != blank or heading_image_mobile != blank
          assign use_heading_image = true
        endif
      -%}

      {%- if use_heading_image -%}
        <h2 class="lame-flash-deal__title-image{% unless show_heading_mobile %} lame-title-image--hide-mobile{% endunless %}{% if title_full_width %} lame-title-image--full-width{% endif %}{% if title_mobile_full_width %} lame-title-image--mobile-full-width{% endif %}">
          <picture class="lame-flash-deal__title-picture">
            {%- if heading_image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ heading_image_mobile | image_url: width: 600 }} 600w, {{ heading_image_mobile | image_url: width: 900 }} 900w, {{ heading_image_mobile | image_url: width: 1200 }} 1200w, {{ heading_image_mobile | image_url: width: 1600 }} 1600w"
                sizes="100vw"
                width="{{ heading_image_mobile.width }}"
                height="{{ heading_image_mobile.height }}"
              >
            {%- endif -%}
            {%- if heading_image != blank -%}
              {{
                heading_image
                | image_url: width: 1920
                | image_tag:
                  class: 'lame-flash-deal__title-img',
                  loading: 'lazy',
                  widths: '600,900,1200,1600,1920,2400',
                  sizes: '(min-width: 1200px) 1920px, 100vw',
                  alt: heading_alt
              }}
            {%- elsif heading_image_mobile != blank -%}
              {{
                heading_image_mobile
                | image_url: width: 1200
                | image_tag:
                  class: 'lame-flash-deal__title-img',
                  loading: 'lazy',
                  widths: '600,900,1200,1600',
                  sizes: '100vw',
                  alt: heading_alt
              }}
            {%- else -%}
              <img
                class="lame-flash-deal__title-img"
                src="{{ heading_image_asset | asset_url }}"
                alt="{{ heading_alt | escape }}"
                width="1024"
                height="192"
                loading="lazy"
              >
            {%- endif -%}
          </picture>
        </h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="lame-flash-deal__title-subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      {%- else -%}
        {% render 'lame-section-heading',
          title: section.settings.heading,
          subtitle: section.settings.subtitle,
          alignment: 'center',
          size: 'large'
        %}
      {%- endif -%}

      {% if countdown_active %}
        <div
          class="lame-flash-deal__countdown"
          data-countdown
          data-countdown-start="{{ section.settings.countdown_start | escape }}"
          data-countdown-duration="{{ section.settings.countdown_duration_hours | times: 3600 }}"
          aria-label="{{ section.settings.countdown_label | escape }}"
        >
          <div class="lame-flash-deal__countdown-box">
            {% if section.settings.countdown_label != blank %}
              <p class="lame-flash-deal__countdown-label">{{ section.settings.countdown_label }}</p>
            {% endif %}
            <div class="lame-flash-deal__countdown-units" role="timer">
              <div class="lame-flash-deal__unit">
                <span class="lame-flash-deal__unit-value" data-days>00</span>
                <small>{{ section.settings.label_days }}</small>
              </div>
              <span class="lame-flash-deal__unit-divider" aria-hidden="true"></span>
              <div class="lame-flash-deal__unit">
                <span class="lame-flash-deal__unit-value" data-hours>00</span>
                <small>{{ section.settings.label_hours }}</small>
              </div>
              <span class="lame-flash-deal__unit-divider" aria-hidden="true"></span>
              <div class="lame-flash-deal__unit">
                <span class="lame-flash-deal__unit-value" data-minutes>00</span>
                <small>{{ section.settings.label_minutes }}</small>
              </div>
              <span class="lame-flash-deal__unit-divider" aria-hidden="true"></span>
              <div class="lame-flash-deal__unit">
                <span class="lame-flash-deal__unit-value" data-seconds>00</span>
                <small>{{ section.settings.label_seconds }}</small>
              </div>
            </div>
          </div>
        </div>
      {% endif %}
    </header>
    {% endif %}

    <div class="lame-flash-deal__body"{% if content_bg != blank %} style="background-color: {{ content_bg }};"{% endif %}>
      {%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
      {%- if card_blocks.size > 0 -%}
        {{ 'lame-beauty-love.css' | asset_url | stylesheet_tag }}
        <div
          class="lame-flash-deal__spotlight lame-beauty-love lame-beauty-love--category"
          data-beauty-sync
          data-autoplay="5000"
          data-fade="900"
          style="--lame-bl-fade: 900ms;"
        >
          <div class="lame-beauty-love__wrap">
            {% render 'lame-beauty-love-grid',
              blocks: card_blocks,
              open_new_tab: false,
              products_url: routes.all_products_collection_url
            %}
          </div>
        </div>
        <script src="{{ 'lame-beauty-love.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      <div class="lame-flash-deal__carousel">
        <button
          type="button"
          class="lame-flash-deal__nav lame-flash-deal__nav--prev"
          data-flash-prev
          aria-label="{{ section.settings.prev_label }}"
        >
          <span aria-hidden="true">&#8249;</span>
        </button>

        <div class="lame-flash-deal__viewport" data-flash-viewport>
          <ul class="lame-flash-deal__track" role="list" data-flash-track>
            {% if products_shown > 0 %}
              {{ deal_products_markup }}
            {% elsif request.design_mode %}
              <li class="lame-flash-deal__item" data-lame-reveal>
                <article class="lame-flash-deal__empty lame-flash-deal__empty--editor">
                  <p>{{ section.settings.empty_text }}</p>
                </article>
              </li>
            {% endif %}
          </ul>
        </div>

        <button
          type="button"
          class="lame-flash-deal__nav lame-flash-deal__nav--next"
          data-flash-next
          aria-label="{{ section.settings.next_label }}"
        >
          <span aria-hidden="true">&#8250;</span>
        </button>
      </div>

      {%- if section.settings.show_trust_bar -%}
        {% render 'lame-flash-deal-trust-bar' %}
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    section.querySelectorAll('[data-lame-reveal]').forEach((node) => {
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12 }
        );
        observer.observe(node);
      } else {
        node.classList.add('is-visible');
      }
    });

    const pad = (n) => String(n).padStart(2, '0');
    section.querySelectorAll('[data-countdown]').forEach((root) => {
      const startRaw = root.dataset.countdownStart;
      const durationSeconds = Number(root.dataset.countdownDuration) || 86400;
      if (!startRaw) return;

      const start = new Date(startRaw.replace(' ', 'T'));
      if (Number.isNaN(start.getTime())) return;

      const end = new Date(start.getTime() + durationSeconds * 1000);
      const daysNode = root.querySelector('[data-days]');
      const hoursNode = root.querySelector('[data-hours]');
      const minutesNode = root.querySelector('[data-minutes]');
      const secondsNode = root.querySelector('[data-seconds]');

      const hideCountdown = () => {
        root.hidden = true;
        root.setAttribute('aria-hidden', 'true');
      };

      const tick = () => {
        const now = Date.now();
        const diff = end.getTime() - now;
        if (now < start.getTime() || diff <= 0) {
          hideCountdown();
          return;
        }
        const totalSeconds = Math.floor(diff / 1000);
        const days = Math.floor(totalSeconds / 86400);
        const hours = Math.floor((totalSeconds % 86400) / 3600);
        const minutes = Math.floor((totalSeconds % 3600) / 60);
        const seconds = totalSeconds % 60;
        if (daysNode) daysNode.textContent = pad(days);
        if (hoursNode) hoursNode.textContent = pad(hours);
        if (minutesNode) minutesNode.textContent = pad(minutes);
        if (secondsNode) secondsNode.textContent = pad(seconds);
      };

      tick();
      window.setInterval(tick, 1000);
    });

    section.querySelectorAll('[data-lame-home-atc]').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const button = form.querySelector('button[type="submit"]');
        if (button?.disabled) return;
        const formData = new FormData(form);
        try {
          if (button) button.disabled = true;
          const response = await fetch('{{ routes.cart_add_url }}.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: formData,
          });
          const data = await response.json();
          if (!response.ok || data?.status) throw new Error(data?.message);
          const cartResponse = await fetch('{{ routes.cart_url }}.js', { headers: { Accept: 'application/json' } });
          const cartData = await cartResponse.json();
          document.dispatchEvent(
            new CustomEvent('cart:update', {
              bubbles: true,
              detail: { resource: cartData, sourceId: '{{ section.id }}', data: { source: 'flash-deal-atc' } },
            })
          );
        } catch (error) {
          console.error('Add to cart failed', error);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });
  })();
</script>
{% endif %}

{% schema %}
{
  "name": "Best Selling",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "header", "content": "Visibility" },
    {
      "type": "checkbox",
      "id": "offer_active",
      "label": "Section active",
      "default": true,
      "info": "When off, this section is hidden on the live storefront."
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Hide when no products",
      "default": true,
      "info": "Hide the entire section if no products are found."
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Selling", "info": "Used as image alt text when a title image is set." },
    {
      "type": "image_picker",
      "id": "heading_image",
      "label": "Title image (Desktop)",
      "info": "Replaces the text heading with an image banner. Leave empty to use text or asset filename."
    },
    {
      "type": "image_picker",
      "id": "heading_image_mobile",
      "label": "Title image (Mobile)",
      "info": "Optional. Dedicated title banner for mobile screens (up to 749px)."
    },
    {
      "type": "checkbox",
      "id": "show_heading_image_mobile",
      "label": "Show title banner on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "heading_image_full_width",
      "label": "Full width title banner (edge-to-edge)",
      "info": "Stretch title banner edge-to-edge with 0 padding and 0 margins.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "heading_image_mobile_full_width",
      "label": "Full width title banner on mobile",
      "info": "When enabled, mobile title banner stretches edge-to-edge (0 margin/padding). When unchecked, keeps standard side gap and rounded corners.",
      "default": false
    },
    {
      "type": "text",
      "id": "heading_image_asset",
      "label": "Title image asset filename",
      "info": "Optional theme asset file name (e.g. lame-best-selling-title.png). Leave empty if you want a normal text title."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "save_label_prefix", "label": "Savings label", "default": "You Save" },
    {
      "type": "select",
      "id": "product_source",
      "label": "Products to show",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "manual", "label": "Hand-picked products (blocks below)" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Create a collection (e.g. “Sale” or “Discount”) and add your deal products. Shopify Admin → Discounts does not feed this section automatically."
    },
    {
      "type": "select",
      "id": "filter_mode",
      "label": "Collection filter",
      "options": [
        { "value": "all", "label": "All products in collection" },
        { "value": "on_sale", "label": "Only products with compare-at price (any % off)" },
        { "value": "compare_at_range", "label": "Only products near target discount %" }
      ],
      "default": "all",
      "info": "Use “All products” when products use Shopify automatic discounts (no compare-at price)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Discount badge fallback",
      "default": "10% OFF",
      "info": "Shown when product has no compare-at price."
    },
    {
      "type": "text",
      "id": "review_count_fallback",
      "label": "Review count fallback",
      "default": "120",
      "info": "Used when product has no review metafield."
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Target discount (%)",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 10,
      "info": "Used only when collection filter is “near target discount %”."
    },
    {
      "type": "range",
      "id": "discount_tolerance",
      "label": "Discount tolerance (±%)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 2,
      "info": "Used only when collection filter is “near target discount %”."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Select a collection with products, or add product blocks. Theme editor → Flash deal → Collection."
    },
    { "type": "header", "content": "Carousel" },
    { "type": "text", "id": "prev_label", "label": "Previous label", "default": "Previous products" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Next products" },
    { "type": "checkbox", "id": "show_trust_bar", "label": "Show trust bar", "default": true },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": true },
    {
      "type": "text",
      "id": "countdown_start",
      "label": "Deal start (YYYY-MM-DD HH:MM)",
      "default": "2026-05-17 00:00",
      "info": "Timer counts down from this date and time (store timezone)."
    },
    {
      "type": "range",
      "id": "countdown_duration_hours",
      "label": "Countdown duration (hours)",
      "min": 1,
      "max": 72,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "default": "ENDS IN"
    },
    { "type": "text", "id": "label_days", "label": "Days label", "default": "Days" },
    { "type": "text", "id": "label_hours", "label": "Hours label", "default": "Hrs" },
    { "type": "text", "id": "label_minutes", "label": "Minutes label", "default": "Min" },
    { "type": "text", "id": "label_seconds", "label": "Seconds label", "default": "Sec" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Background color",
      "info": "Optional. Pick a color or enter a custom code below. Clear it for no background."
    },
    {
      "type": "text",
