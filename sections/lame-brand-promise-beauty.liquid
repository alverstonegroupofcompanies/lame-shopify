            "text": "Thoughtfully sourced botanicals and essentials."
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon": "cruelty",
            "title": "Cruelty free",
            "text": "Never tested on animals—always ethically crafted."
          }
        },
        {
          "type": "promise",
          "settings": {
            "icon": "premium",
            "title": "Premium quality",
            "text": "Small-batch finishes with spa-grade texture."
          }
        }
      ]
    }
  ]
}
