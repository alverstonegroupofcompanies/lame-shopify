<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-brand-promise-beauty lame-luxury-glow-root"
  {{ section.shopify_attributes }}
>
  <div class="lame-brand-promise-beauty__wrap lame-luxury-glow spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <h2 class="lame-brand-promise-beauty__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <ul class="lame-brand-promise-beauty__grid" role="list">
      {% for block in section.blocks %}
        <li class="lame-brand-promise-beauty__card" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <span class="lame-brand-promise-beauty__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'derm' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.35"/>
                  <path d="M9 12.5 11 15l5-5.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {% when 'natural' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 21c4-5 6-9 6-13a6 6 0 1 0-12 0c0 4 2 8 6 13Z" stroke="currentColor" stroke-width="1.35"/>
                  <path d="M12 11v10" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {% when 'cruelty' %}
                <svg viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.35"/>
                  <path d="M9 14h6M12 15v3M10 10h.01M14 10h.01" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                  <path d="m8 8 10 10" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
              {% else %}
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M12 3 6 8v9l6 4 6-4V8l-6-5Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
                  <path d="M12 22V11.5M12 11.5 16 8M12 11.5 8 8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
                </svg>
            {% endcase %}
          </span>
          {% if block.settings.title != blank %}
            <p class="lame-brand-promise-beauty__title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="lame-brand-promise-beauty__text">{{ block.settings.text }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const nodes = section.querySelectorAll('[data-lame-reveal]');
    if (!nodes.length) return;
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      nodes.forEach((node) => observer.observe(node));
    } else {
      nodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

{% stylesheet %}
  .lame-brand-promise-beauty__wrap {
    position: relative;
    padding-inline: var(--page-margin);
  }

  .lame-brand-promise-beauty__heading {
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
    text-align: center;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-brand-promise-beauty__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media screen and (min-width: 750px) {
    .lame-brand-promise-beauty__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .lame-brand-promise-beauty__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .lame-brand-promise-beauty__card {
    padding: 1.25rem 1.1rem;
    border-radius: 16px;
    background: rgb(var(--color-background-rgb) / 0.62);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.07);
    box-shadow: 0 14px 36px rgb(0 0 0 / 0.06);
    backdrop-filter: blur(12px);
    text-align: center;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lame-brand-promise-beauty__card.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .lame-brand-promise-beauty__card[data-lame-delay='1'] {
    transition-delay: 0.06s;
  }
  .lame-brand-promise-beauty__card[data-lame-delay='2'] {
    transition-delay: 0.12s;
  }
  .lame-brand-promise-beauty__card[data-lame-delay='3'] {
    transition-delay: 0.18s;
  }

  .lame-brand-promise-beauty__icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    color: rgb(var(--color-primary-rgb));
    align-items: center;
    justify-content: center;
  }

  .lame-brand-promise-beauty__icon svg {
    width: 100%;
    height: 100%;
  }

  .lame-brand-promise-beauty__title {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-brand-promise-beauty__text {
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }
{% endstylesheet %}

