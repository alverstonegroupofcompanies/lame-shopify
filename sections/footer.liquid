{%- liquid
  assign categories_menu = linklists[section.settings.categories_menu]
  assign quick_links_menu = linklists[section.settings.quick_links_menu]
  assign use_collection_links = false
  if categories_menu == blank or categories_menu.links.size == 0
    assign use_collection_links = true
  endif
  assign show_categories = section.settings.show_categories

  assign phone_href = section.settings.phone | strip
  if phone_href != blank
    assign phone_href = phone_href | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  endif

  assign map_query = section.settings.map_query | default: 'Lamstone Healthcare Mangalapuram Kerala' | url_encode
  assign directions_url = section.settings.map_directions_url
  if directions_url == blank
    assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
  endif

  assign social_instagram = section.settings.social_instagram_url | strip
  assign social_facebook = section.settings.social_facebook_url | strip
  assign social_youtube = section.settings.social_youtube_url | strip
  assign social_whatsapp = section.settings.social_whatsapp_url | strip

  if social_instagram == blank
    assign social_instagram = 'https://www.instagram.com/mylamstone/'
  endif
  if social_facebook == blank
    assign social_facebook = 'https://www.facebook.com/mylamstone/'
  endif
  if social_youtube == blank
    assign social_youtube = 'https://www.youtube.com/@MyLamstone-ecom'
  endif
  if social_whatsapp == blank
    assign social_whatsapp = 'https://whatsapp.com/channel/0029VbE3V0kD38CUs4ivfl1A'
  endif

  assign show_social = section.settings.show_social
  assign venture_blocks = section.blocks | where: 'type', 'venture'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<footer
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-premium"
  id="footer-{{ section.id }}"
>
  <div
    class="footer-premium__shell spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- comment -%} Newsletter + social {%- endcomment -%}
    {% if section.settings.show_newsletter or show_social %}
      <div class="footer-premium__top">
        {% if section.settings.show_newsletter %}
          <div class="footer-premium__newsletter">
            {% if section.settings.newsletter_heading != blank %}
              <h2 class="footer-premium__title">{{ section.settings.newsletter_heading | escape }}</h2>
            {% endif %}
            {% if section.settings.newsletter_text != blank %}
              <p class="footer-premium__lede">{{ section.settings.newsletter_text | escape }}</p>
            {% endif %}
            {%- form 'customer', class: 'footer-premium__form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
                {{ 'blocks.email_signup.label' | t }}
              </label>
              <div class="footer-premium__form-row">
                <input
                  id="FooterNewsletterEmail-{{ section.id }}"
                  class="footer-premium__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                  {% endif %}
                >
                <button type="submit" class="footer-premium__submit">
                  {{ section.settings.newsletter_button | escape }}
                </button>
              </div>
              {%- if form.errors -%}
                <p class="footer-premium__form-msg footer-premium__form-msg--error">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <p class="footer-premium__form-msg footer-premium__form-msg--success">
                  {% if section.settings.newsletter_success != blank %}
                    {{ section.settings.newsletter_success | escape }}
                  {% else %}
                    {{ 'blocks.email_signup.success' | t }}
                  {% endif %}
                </p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {% endif %}

        {% if show_social %}
          <div class="footer-premium__social-block">
            {% if section.settings.social_heading != blank %}
              <h2 class="footer-premium__title">{{ section.settings.social_heading | escape }}</h2>
            {% endif %}
            {% if section.settings.social_text != blank %}
              <p class="footer-premium__lede">{{ section.settings.social_text | escape }}</p>
            {% endif %}
            <ul class="footer-premium__socials" role="list">
              {% if social_instagram != blank %}
                <li>
                  <a class="footer-premium__social" href="{{ social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <span aria-hidden="true">{% render 'footer-icon', name: 'instagram' %}</span>
                  </a>
                </li>
              {% endif %}
              {% if social_facebook != blank %}
                <li>
                  <a class="footer-premium__social" href="{{ social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <span aria-hidden="true">{% render 'footer-icon', name: 'facebook' %}</span>
                  </a>
                </li>
              {% endif %}
              {% if social_youtube != blank %}
                <li>
                  <a class="footer-premium__social" href="{{ social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                    <span aria-hidden="true">{% render 'footer-icon', name: 'youtube' %}</span>
                  </a>
                </li>
              {% endif %}
              {% if social_whatsapp != blank %}
                <li>
                  <a class="footer-premium__social" href="{{ social_whatsapp }}" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Channel">
                    <span aria-hidden="true">{% render 'footer-icon', name: 'whatsapp' %}</span>
                  </a>
                </li>
              {% endif %}
            </ul>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Main columns {%- endcomment -%}
    <div class="footer-premium__grid">
      {% if show_categories %}
        <div class="footer-premium__col">
          <h3 class="footer-premium__heading">{{ section.settings.categories_heading | escape }}</h3>
          <ul class="footer-premium__links" role="list">
            {% if use_collection_links %}
              {% for collection in collections limit: 12 %}
                {% unless collection.handle == 'frontpage' %}
                  <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
                {% endunless %}
              {% endfor %}
              {% if collections.size == 0 %}
                <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
              {% endif %}
            {% else %}
              {% for link in categories_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      {% endif %}

      <div class="footer-premium__col">
        <h3 class="footer-premium__heading">{{ section.settings.quick_links_heading | escape }}</h3>
        <ul class="footer-premium__links" role="list">
          {% if quick_links_menu != blank and quick_links_menu.links.size > 0 %}
            {% for link in quick_links_menu.links %}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.root_url }}">Home</a></li>
            <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
            {% if pages.contact %}
              <li><a href="{{ pages.contact.url }}">Contact</a></li>
            {% endif %}
            <li><a href="{{ routes.search_url }}">Search</a></li>
            <li><a href="{{ routes.account_url }}">My account</a></li>
          {% endif %}
        </ul>
      </div>

      {% if section.settings.show_map %}
        <div class="footer-premium__col">
          <h3 class="footer-premium__heading">{{ section.settings.map_heading | escape }}</h3>
          <a class="footer-premium__action" href="{{ directions_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.map_directions_label | escape }}
            <span aria-hidden="true">{% render 'footer-icon', name: 'external' %}</span>
          </a>
        </div>
      {% endif %}

      <div class="footer-premium__col">
        <h3 class="footer-premium__heading">{{ section.settings.hours_heading | escape }}</h3>
        <div class="footer-premium__copy rte">{{ section.settings.working_hours }}</div>
      </div>

      <div class="footer-premium__col">
        <h3 class="footer-premium__heading">{{ section.settings.address_heading | escape }}</h3>
        <div class="footer-premium__copy rte">{{ section.settings.shop_address }}</div>
      </div>

      <div class="footer-premium__col">
        <h3 class="footer-premium__heading">{{ section.settings.contact_heading | escape }}</h3>
        <ul class="footer-premium__contact" role="list">
          {% if section.settings.phone != blank %}
            <li>
              <span class="footer-premium__label">Phone</span>
              <a href="tel:{{ phone_href }}">{{ section.settings.phone | escape }}</a>
            </li>
          {% endif %}
          {% if section.settings.email != blank %}
            <li>
              <span class="footer-premium__label">Email</span>
              <a href="mailto:{{ section.settings.email | strip }}">{{ section.settings.email | escape }}</a>
            </li>
          {% endif %}
          {% if section.settings.contact_details != blank %}
            <li class="footer-premium__copy rte">{{ section.settings.contact_details }}</li>
          {% endif %}
        </ul>
      </div>
    </div>

    {%- comment -%} Ventures {%- endcomment -%}
    {% if section.settings.show_ventures %}
      {% if venture_blocks.size > 0 or request.design_mode %}
        <div class="footer-premium__ventures-bar" aria-label="{{ section.settings.ventures_heading | default: 'Our Ventures' | escape }}">
          <div class="footer-premium__ventures-bar-inner">
            {% if section.settings.ventures_heading != blank %}
              <p class="footer-premium__ventures-bar-label">{{ section.settings.ventures_heading | escape }}</p>
              <div class="footer-premium__ventures-ornament" aria-hidden="true">
                <span class="footer-premium__ventures-ornament-line"></span>
                <span class="footer-premium__ventures-ornament-mark"></span>
                <span class="footer-premium__ventures-ornament-line"></span>
              </div>
            {% endif %}
            <ul class="footer-premium__ventures-row" role="list">
              {% for block in venture_blocks %}
                {% liquid
                  assign venture_image = block.settings.image
                  assign venture_alt = block.settings.alt | default: block.settings.title
                  assign venture_asset = block.settings.asset | strip
                  assign has_venture_logo = false
                  if venture_image != blank or venture_asset != blank
                    assign has_venture_logo = true
                  endif
                %}
                {% if has_venture_logo == false and request.design_mode == false %}
                  {% continue %}
                {% endif %}
                <li class="footer-premium__venture-item" {{ block.shopify_attributes }}>
                  {% if block.settings.link != blank %}
                    <a
                      href="{{ block.settings.link }}"
                      class="footer-premium__venture-link"
                      aria-label="{{ venture_alt | escape }}"
                      {% if block.settings.open_in_new_tab %}
                        target="_blank" rel="noopener noreferrer"
                      {% endif %}
                    >
                  {% else %}
                    <span class="footer-premium__venture-link">
                  {% endif %}
                  {% if venture_image != blank %}
                    {{
                      venture_image
                      | image_url: width: 1920
                      | image_tag:
                        class: 'footer-premium__venture-logo',
                        loading: 'lazy',
                        widths: '320,480,640,800,960,1200,1440,1920',
                        sizes: '(max-width: 749px) 44vw, 320px',
                        alt: venture_alt
                    }}
                  {% elsif venture_asset != blank %}
                    <img
                      class="footer-premium__venture-logo"
                      src="{{ venture_asset | asset_url }}"
                      alt="{{ venture_alt | escape }}"
                      width="560"
                      height="180"
                      loading="lazy"
                    >
                  {% elsif request.design_mode %}
                    <span class="footer-premium__venture-placeholder">Add venture logo</span>
                  {% endif %}
                  {% if block.settings.link != blank %}
                    </a>
                  {% else %}
                    </span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}
    {% endif %}

    {%- comment -%} Legal {%- endcomment -%}
    <div class="footer-premium__legal">
      {% if section.settings.trust_badges != blank %}
        <p class="footer-premium__trust">{{ section.settings.trust_badges | escape }}</p>
      {% endif %}

      <div class="footer-premium__legal-row">
        {% if section.settings.show_policy_links %}
          <ul class="footer-premium__policies" role="list">
            {% for policy in shop.policies %}
              {% if policy != blank %}
                <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}

        <div class="footer-premium__credits">
          {% if section.settings.copyright_text != blank %}
            <p class="footer-premium__copyright">{{ section.settings.copyright_text | newline_to_br }}</p>
          {% endif %}
          <p class="footer-premium__rights">
            {{ section.settings.rights_text | default: 'All rights reserved. Lamstone Healthcare (P) Ltd since 2026.' | escape }}
          </p>
        </div>
      </div>
    </div>
  </div>
</footer>

{% style %}
  #footer-{{ section.id }} {
    --footer-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    --footer-body: 'Jost', var(--font-body--family), system-ui, sans-serif;
    --footer-bg: #143f2e;
    --footer-bg-soft: #1a4d39;
    --footer-line: rgb(255 255 255 / 0.12);
    --footer-gold: #ddc482;
    --footer-text: #ffffff;
    --footer-muted: rgb(255 255 255 / 0.78);
    --footer-subtle: rgb(255 255 255 / 0.58);
    --footer-pad: clamp(1.25rem, 4vw, 3rem);
    font-family: var(--footer-body);
    color: var(--footer-text);
    background:
      radial-gradient(ellipse 80% 50% at 50% 0%, rgb(255 255 255 / 0.04), transparent 55%),
      var(--footer-bg);
    border-top: 1px solid var(--footer-line);
  }

  #footer-{{ section.id }} .section-background {
    display: none;
  }

  #footer-{{ section.id }} .footer-premium__shell {
    width: min(1120px, calc(100% - (var(--footer-pad) * 2)));
    margin-inline: auto;
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    overflow: visible;
  }

  #footer-{{ section.id }} .footer-premium__top {
    display: grid;
    gap: 1.75rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--footer-line);
  }

  #footer-{{ section.id }} .footer-premium__title {
    margin: 0 0 0.45rem;
    font-family: var(--footer-display);
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.2;
    color: var(--footer-gold);
  }

  #footer-{{ section.id }} .footer-premium__lede {
    margin: 0 0 1rem;
    max-width: 38ch;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--footer-muted);
  }

  #footer-{{ section.id }} .footer-premium__form-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    max-width: 28rem;
  }

  #footer-{{ section.id }} .footer-premium__input {
    flex: 1 1 12rem;
    min-height: 2.75rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.18);
    color: var(--footer-text);
    font: inherit;
    font-size: 0.9rem;
  }

  #footer-{{ section.id }} .footer-premium__input::placeholder {
    color: var(--footer-subtle);
  }

  #footer-{{ section.id }} .footer-premium__input:focus {
    outline: 2px solid rgb(221 196 130 / 0.55);
    outline-offset: 1px;
  }

  #footer-{{ section.id }} .footer-premium__submit {
    min-height: 2.75rem;
    padding: 0.7rem 1.35rem;
    border: 0;
    border-radius: 999px;
    background: var(--footer-gold);
    color: #143f2e;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #footer-{{ section.id }} .footer-premium__submit:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  #footer-{{ section.id }} .footer-premium__form-msg {
    margin: 0.65rem 0 0;
    font-size: 0.82rem;
  }

  #footer-{{ section.id }} .footer-premium__form-msg--error {
    color: #ffb4a8;
  }

  #footer-{{ section.id }} .footer-premium__form-msg--success {
    color: #b8e0c4;
  }

  #footer-{{ section.id }} .footer-premium__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #footer-{{ section.id }} .footer-premium__social {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    color: var(--footer-text);
    background: rgb(255 255 255 / 0.04);
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  #footer-{{ section.id }} .footer-premium__social:hover {
    border-color: var(--footer-gold);
    color: var(--footer-gold);
    background: rgb(221 196 130 / 0.08);
  }

  #footer-{{ section.id }} .footer-premium__social .footer-premium__icon-svg {
    width: 1rem;
    height: 1rem;
  }

  #footer-{{ section.id }} .footer-premium__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 1.25rem;
  }

  #footer-{{ section.id }} .footer-premium__col {
    min-width: 0;
  }

  #footer-{{ section.id }} .footer-premium__heading {
    margin: 0 0 0.85rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid rgb(221 196 130 / 0.28);
    font-family: var(--footer-display);
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--footer-gold);
  }

  #footer-{{ section.id }} .footer-premium__links,
  #footer-{{ section.id }} .footer-premium__contact {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }

  #footer-{{ section.id }} .footer-premium__links a,
  #footer-{{ section.id }} .footer-premium__contact a,
  #footer-{{ section.id }} .footer-premium__copy,
  #footer-{{ section.id }} .footer-premium__copy :is(p, a) {
    margin: 0;
    color: var(--footer-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    text-decoration: none;
  }

  #footer-{{ section.id }} .footer-premium__links a:hover,
  #footer-{{ section.id }} .footer-premium__contact a:hover {
    color: var(--footer-text);
  }

  #footer-{{ section.id }} .footer-premium__action {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.15rem;
    color: var(--footer-gold);
    font-size: 0.84rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  #footer-{{ section.id }} .footer-premium__action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #footer-{{ section.id }} .footer-premium__action .footer-premium__icon-svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  #footer-{{ section.id }} .footer-premium__label {
    display: block;
    margin-bottom: 0.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--footer-subtle);
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    border-top: 1px solid #c5a059;
    border-bottom: 1px solid #c5a059;
    background-color: #f9f8f3;
    color: rgb(24 24 24);
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar-inner {
    width: 100%;
    max-width: min(1280px, 100%);
    margin-inline: auto;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1rem, 3vw, 2.5rem) clamp(1.85rem, 3.8vw, 2.85rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar-label {
    margin: 0;
    text-align: center;
    font-family: var(--footer-display);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #012a1c;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    max-width: 11rem;
    margin: 0.7rem auto 1.35rem;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-line {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c5a059 30%, #c5a059);
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-line:last-child {
    background: linear-gradient(90deg, #c5a059, #c5a059 70%, transparent);
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-mark {
    position: relative;
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid #c5a059;
    transform: rotate(45deg);
    background: #f9f8f3;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-mark::before {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px solid rgb(197 160 89 / 0.55);
  }

  #footer-{{ section.id }} .footer-premium__ventures-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
  }

  #footer-{{ section.id }} .footer-premium__venture-item {
    flex: 0 1 auto;
    min-width: 0;
  }

  #footer-{{ section.id }} .footer-premium__venture-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  #footer-{{ section.id }} .footer-premium__venture-link:is(:hover, :focus-visible) {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  #footer-{{ section.id }} .footer-premium__venture-logo {
    display: block;
    width: auto;
    max-width: min(10rem, 38vw);
    height: auto;
    max-height: 3.75rem;
    object-fit: contain;
    object-position: center;
    background: transparent;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  #footer-{{ section.id }} .footer-premium__venture-placeholder {
    min-width: 5.5rem;
    padding: 0.5rem 0.65rem;
    border: 1px dashed rgb(0 0 0 / 0.18);
    font-size: 0.75rem;
    color: rgb(0 0 0 / 0.45);
  }

  @media screen and (min-width: 990px) {
    #footer-{{ section.id }} .footer-premium__ventures-bar-inner {
      padding: clamp(2rem, 3.5vw, 3rem) clamp(1.5rem, 3vw, 2.75rem) clamp(2.15rem, 3.8vw, 3.15rem);
    }

    #footer-{{ section.id }} .footer-premium__ventures-bar-label {
      font-size: clamp(1.15rem, 1.5vw, 1.4rem);
      letter-spacing: 0.26em;
    }

    #footer-{{ section.id }} .footer-premium__ventures-ornament {
      max-width: 12.5rem;
      margin-bottom: 1.65rem;
    }

    #footer-{{ section.id }} .footer-premium__ventures-row {
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    #footer-{{ section.id }} .footer-premium__venture-link {
      min-height: 5.5rem;
      padding: 0.55rem 0.75rem;
    }

    #footer-{{ section.id }} .footer-premium__venture-logo {
      max-width: 15rem;
      max-height: 6rem;
    }
  }

  @media screen and (max-width: 989px) {
    #footer-{{ section.id }} .footer-premium__ventures-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      gap: 0.85rem 1rem;
    }

    #footer-{{ section.id }} .footer-premium__venture-item {
      width: 100%;
    }

    #footer-{{ section.id }} .footer-premium__venture-link {
      min-height: 4.75rem;
      width: 100%;
      padding: 0.5rem 0.55rem;
    }

    #footer-{{ section.id }} .footer-premium__venture-logo {
      width: 100%;
      max-width: 100%;
      max-height: clamp(4rem, 18vw, 5.5rem);
    }
  }

  #footer-{{ section.id }} .footer-premium__legal {
    padding-top: 0.25rem;
    border-top: 1px solid var(--footer-line);
    display: grid;
    gap: 0.85rem;
  }

  #footer-{{ section.id }} .footer-premium__trust {
    margin: 0;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--footer-subtle);
  }

  #footer-{{ section.id }} .footer-premium__legal-row {
    display: grid;
    gap: 0.85rem;
    align-items: start;
  }

  #footer-{{ section.id }} .footer-premium__policies {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }

  #footer-{{ section.id }} .footer-premium__policies a {
    color: var(--footer-muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  #footer-{{ section.id }} .footer-premium__policies a:hover {
    color: var(--footer-text);
  }

  #footer-{{ section.id }} .footer-premium__credits {
    display: grid;
    gap: 0.2rem;
  }

  #footer-{{ section.id }} .footer-premium__copyright,
  #footer-{{ section.id }} .footer-premium__rights {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--footer-subtle);
  }

  @media screen and (min-width: 750px) {
    #footer-{{ section.id }} .footer-premium__top {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
      align-items: end;
      gap: 2.5rem;
    }

    #footer-{{ section.id }} .footer-premium__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.75rem 1.5rem;
    }

    #footer-{{ section.id }} .footer-premium__legal-row {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 1.5rem;
    }

    #footer-{{ section.id }} .footer-premium__credits {
      text-align: end;
    }
  }

  @media screen and (min-width: 990px) {
    #footer-{{ section.id }} .footer-premium__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1.5rem 1.25rem;
    }

    #footer-{{ section.id }} .footer-premium__grid:has(.footer-premium__col:nth-child(5):last-child) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    #footer-{{ section.id }} .footer-premium__grid:has(.footer-premium__col:nth-child(4):last-child) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstyle %}

