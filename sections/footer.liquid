{%- liquid
  assign categories_menu = linklists[section.settings.categories_menu]
  assign quick_links_menu = linklists[section.settings.quick_links_menu]
  assign use_collection_links = false
  if categories_menu == blank or categories_menu.links.size == 0
    assign use_collection_links = true
  endif

  assign phone_href = section.settings.phone | strip
  if phone_href != blank
    assign phone_href = phone_href | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  endif

  assign map_query = section.settings.map_query | default: 'Lamstone Healthcare Mangalapuram Kerala' | url_encode
  assign directions_url = section.settings.map_directions_url
  if directions_url == blank
    assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<footer
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-premium"
  id="footer-{{ section.id }}"
>
  {% if section.settings.show_footer_image %}
    <div class="footer-premium__visual" aria-hidden="true">
      {% if section.settings.footer_image != blank %}
        {{
          section.settings.footer_image
          | image_url: width: 2400
          | image_tag:
            class: 'footer-premium__visual-img',
            loading: 'lazy',
            widths: '600,900,1200,1600,2000,2400',
            sizes: '100vw',
            alt: ''
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'footer-premium__visual-placeholder' }}
      {% endif %}
      <span
        class="footer-premium__visual-overlay"
        style="--footer-visual-overlay: {{ section.settings.footer_image_overlay | divided_by: 100.0 }};"
      ></span>
    </div>
  {% endif %}

  <div class="footer-premium__inner spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="footer-premium__main">
      <div class="footer-premium__brand">
        {% if section.settings.logo != blank %}
          <a href="{{ routes.root_url }}" class="footer-premium__logo-link">
            {{
              section.settings.logo
              | image_url: width: 360
              | image_tag:
                class: 'footer-premium__logo',
                loading: 'lazy',
                widths: '120,180,240,360',
                sizes: '200px',
                alt: section.settings.brand_name | default: shop.name
            }}
          </a>
        {% elsif section.settings.brand_name != blank %}
          <a href="{{ routes.root_url }}" class="footer-premium__brand-name">{{ section.settings.brand_name }}</a>
        {% endif %}

        {% if section.settings.about_text != blank %}
          <div class="footer-premium__about rte">{{ section.settings.about_text }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <ul class="footer-premium__social" role="list">
            {% for block in section.blocks %}
              {% if block.type == 'social_link' and block.settings.url != blank %}
                <li {{ block.shopify_attributes }}>
                  <a
                    href="{{ block.settings.url }}"
                    class="footer-premium__social-link"
                    aria-label="{{ block.settings.label | escape }}"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    {% render 'footer-social-icon', platform: block.settings.platform %}
                    <span class="visually-hidden">{{ block.settings.label }}</span>
                  </a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        {% endif %}
      </div>

      <div class="footer-premium__column">
        <h3 class="footer-premium__heading footer-premium__heading--icon">
          <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
          {{ section.settings.categories_heading }}
        </h3>
        <ul class="footer-premium__links" role="list">
          {% if use_collection_links %}
            {% for collection in collections limit: 12 %}
              {% unless collection.handle == 'frontpage' %}
                <li>
                  <a href="{{ collection.url }}" class="footer-premium__link-row">
                    <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                    <span>{{ collection.title }}</span>
                  </a>
                </li>
              {% endunless %}
            {% endfor %}
            {% if collections.size == 0 %}
              <li>
                <a href="{{ routes.all_products_collection_url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                  <span>Shop all</span>
                </a>
              </li>
            {% endif %}
          {% else %}
            {% for link in categories_menu.links %}
              <li>
                <a href="{{ link.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-link-icon', link: link %}</span>
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="footer-premium__column">
        <h3 class="footer-premium__heading footer-premium__heading--icon">
          <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'arrow' %}</span>
          {{ section.settings.quick_links_heading }}
        </h3>
        <ul class="footer-premium__links" role="list">
          {% if quick_links_menu != blank and quick_links_menu.links.size > 0 %}
            {% for link in quick_links_menu.links %}
              <li>
                <a href="{{ link.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-link-icon', link: link %}</span>
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          {% else %}
            <li>
              <a href="{{ routes.root_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'home' %}</span>
                <span>Home</span>
              </a>
            </li>
            <li>
              <a href="{{ routes.all_products_collection_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                <span>All products</span>
              </a>
            </li>
            {% if pages.contact %}
              <li>
                <a href="{{ pages.contact.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'email' %}</span>
                  <span>Contact</span>
                </a>
              </li>
            {% endif %}
            <li>
              <a href="{{ routes.search_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'search' %}</span>
                <span>Search</span>
              </a>
            </li>
            <li>
              <a href="{{ routes.account_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'account' %}</span>
                <span>My account</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </div>

      {% if section.settings.show_newsletter %}
        <div class="footer-premium__newsletter">
          <h3 class="footer-premium__heading footer-premium__heading--icon">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'mail' %}</span>
            {{ section.settings.newsletter_heading }}
          </h3>
          {% if section.settings.newsletter_text != blank %}
            <p class="footer-premium__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {% endif %}
          {%- form 'customer', class: 'footer-premium__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
              {{ 'blocks.email_signup.label' | t }}
            </label>
            <div class="footer-premium__newsletter-row">
              <span class="footer-premium__icon footer-premium__icon--input" aria-hidden="true">
                {% render 'footer-icon', name: 'email' %}
              </span>
              <input
                id="FooterNewsletterEmail-{{ section.id }}"
                class="footer-premium__newsletter-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button type="submit" class="footer-premium__newsletter-btn">
                <span>{{ section.settings.newsletter_button }}</span>
                <span class="footer-premium__icon footer-premium__icon--btn" aria-hidden="true">
                  {% render 'footer-icon', name: 'send' %}
                </span>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="footer-premium__newsletter-message footer-premium__newsletter-message--error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer-premium__newsletter-message footer-premium__newsletter-message--success">
                {% if section.settings.newsletter_success != blank %}
                  {{ section.settings.newsletter_success }}
                {% else %}
                  {{ 'blocks.email_signup.success' | t }}
                {% endif %}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {% endif %}
    </div>

    <div class="footer-premium__mid">
      {% if section.settings.show_map %}
        <div class="footer-premium__map-wrap">
          <h3 class="footer-premium__heading footer-premium__heading--icon">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'map-pin' %}</span>
            {{ section.settings.map_heading }}
          </h3>
          <div class="footer-premium__map">
            {% if section.settings.map_embed_url != blank %}
              <iframe
                title="{{ section.settings.map_heading | escape }}"
                src="{{ section.settings.map_embed_url }}"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            {% else %}
              <a
                class="footer-premium__map-fallback"
                href="{{ directions_url }}"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="footer-premium__icon footer-premium__icon--map" aria-hidden="true">
                  {% render 'footer-icon', name: 'map-pin' %}
                </span>
                <span>{{ section.settings.map_fallback_text }}</span>
              </a>
            {% endif %}
          </div>
          <a class="footer-premium__directions" href="{{ directions_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.map_directions_label }}
            <span class="footer-premium__icon footer-premium__icon--inline" aria-hidden="true">
              {% render 'footer-icon', name: 'external' %}
            </span>
          </a>
        </div>
      {% endif %}

      <div class="footer-premium__contact-grid">
        <div class="footer-premium__contact-card">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'clock' %}</span>
            {{ section.settings.hours_heading }}
          </h4>
          <div class="rte">{{ section.settings.working_hours }}</div>
        </div>
        <div class="footer-premium__contact-card">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'location' %}</span>
            {{ section.settings.address_heading }}
          </h4>
          <div class="rte">{{ section.settings.shop_address }}</div>
        </div>
        <div class="footer-premium__contact-card">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'phone' %}</span>
            {{ section.settings.contact_heading }}
          </h4>
          <ul class="footer-premium__contact-list" role="list">
            {% if section.settings.phone != blank %}
              <li>
                <span class="footer-premium__contact-label">Phone</span>
                <a href="tel:{{ phone_href }}">{{ section.settings.phone }}</a>
              </li>
            {% endif %}
            {% if section.settings.email != blank %}
              <li>
                <span class="footer-premium__contact-label">Email</span>
                <a href="mailto:{{ section.settings.email | strip }}">{{ section.settings.email }}</a>
              </li>
            {% endif %}
            {% if section.settings.contact_details != blank %}
              <li class="footer-premium__contact-extra rte">{{ section.settings.contact_details }}</li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>

    {% if section.settings.trust_badges != blank %}
      <p class="footer-premium__trust">
        <span class="footer-premium__icon footer-premium__icon--trust" aria-hidden="true">
          {% render 'footer-icon', name: 'sparkle' %}
        </span>
        {{ section.settings.trust_badges }}
      </p>
    {% endif %}

    <div class="footer-premium__bottom">
      <p class="footer-premium__copyright">{{ section.settings.copyright_text }}</p>
      {% if section.settings.show_policy_links %}
        <ul class="footer-premium__policies" role="list">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li>
                <a href="{{ policy.url }}" class="footer-premium__link-row footer-premium__link-row--policy">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'arrow' %}</span>
                  <span>{{ policy.title }}</span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer-premium {
    --footer-font-display: 'Cormorant Garamond', Georgia, serif;
    --footer-font-body: 'Jost', var(--font-body--family), sans-serif;
    --footer-gold: rgb(var(--brand-gold, 212 175 55));
    --footer-gold-soft: rgb(var(--brand-gold, 212 175 55) / 0.22);
    font-family: var(--footer-font-body);
    border-top: 1px solid var(--footer-gold-soft);
    background: linear-gradient(180deg, rgb(var(--color-background-rgb)) 0%, rgb(var(--color-background-rgb) / 0.97) 100%);
  }

  .footer-premium__inner {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .footer-premium__main {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .footer-premium__brand {
    display: grid;
    gap: 0.85rem;
    align-content: start;
  }

  .footer-premium__logo-link {
    display: inline-block;
    line-height: 0;
  }

  .footer-premium__logo {
    width: 100%;
    max-width: 200px;
    height: auto;
    display: block;
  }

  .footer-premium__brand-name {
    font-family: var(--footer-font-display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: inherit;
  }

  .footer-premium__about {
    margin: 0;
    max-width: 36ch;
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgb(var(--color-foreground-rgb) / 0.78);
  }

  .footer-premium__about p {
    margin: 0;
  }

  .footer-premium__social {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-premium__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 999px;
    border: 1px solid var(--footer-gold-soft);
    background: rgb(var(--color-background-rgb) / 0.6);
    color: var(--footer-gold);
    transition: background 200ms ease, border-color 200ms ease, transform 200ms ease;
  }

  .footer-premium__social-link:hover {
    background: var(--footer-gold);
    border-color: var(--footer-gold);
    color: #111;
    transform: translateY(-2px);
  }

  .footer-premium__social-link svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
  }

  .footer-premium__heading {
    margin: 0 0 0.85rem;
    font-family: var(--footer-font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
    color: inherit;
    position: relative;
    padding-bottom: 0.45rem;
  }

  .footer-premium__heading::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 2rem;
    height: 1px;
    background: var(--footer-gold);
  }

  .footer-premium__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer-premium__links a {
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    color: rgb(var(--color-foreground-rgb) / 0.82);
    transition: color 180ms ease;
  }

  .footer-premium__links a:is(:hover, :focus-visible) {
    color: var(--footer-gold);
  }

  .footer-premium__newsletter-text {
    margin: 0 0 0.85rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    max-width: 32ch;
  }

  .footer-premium__newsletter-form {
    display: grid;
    gap: 0.5rem;
  }

  .footer-premium__newsletter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    border: 1px solid var(--footer-gold-soft);
    border-radius: 999px;
    padding: 0.28rem;
    background: rgb(var(--color-background-rgb) / 0.55);
  }

  .footer-premium__newsletter-input {
    flex: 1 1 10rem;
    min-width: 0;
    border: none;
    background: transparent;
    padding: 0.55rem 0.85rem;
    font-family: var(--footer-font-body);
    font-size: 0.86rem;
    color: inherit;
  }

  .footer-premium__newsletter-input:focus-visible {
    outline: 2px solid var(--footer-gold);
    outline-offset: 2px;
    border-radius: 999px;
  }

  .footer-premium__newsletter-btn {
    flex-shrink: 0;
    border: none;
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font-family: var(--footer-font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    background: linear-gradient(135deg, var(--footer-gold), rgb(var(--brand-gold-strong, 193 151 31)));
    color: #111;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .footer-premium__newsletter-btn:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .footer-premium__newsletter-message {
    margin: 0;
    font-size: 0.82rem;
  }

  .footer-premium__newsletter-message--error {
    color: #b42318;
  }

  .footer-premium__newsletter-message--success {
    color: rgb(var(--color-foreground-rgb) / 0.85);
  }

  .footer-premium__mid {
    display: grid;
    gap: 1.25rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--footer-gold-soft);
  }

  .footer-premium__map-wrap {
    display: grid;
    gap: 0.65rem;
  }

  .footer-premium__map {
    position: relative;
    width: 100%;
    min-height: 220px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--footer-gold-soft);
    background: rgb(var(--color-foreground-rgb) / 0.04);
  }

  .footer-premium__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .footer-premium__map-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 220px;
    padding: 1.5rem;
    text-align: center;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.75);
    font-size: 0.9rem;
  }

  .footer-premium__map-pin {
    font-size: 1.75rem;
  }

  .footer-premium__directions {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--footer-gold);
    font-weight: 600;
  }

  .footer-premium__directions:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-premium__contact-grid {
    display: grid;
    gap: 1rem;
  }

  .footer-premium__contact-card h4 {
    margin: 0 0 0.45rem;
    font-family: var(--footer-font-display);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .footer-premium__contact-card :is(p, a) {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .footer-premium__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-premium__contact-label {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    margin-bottom: 0.15rem;
  }

  .footer-premium__contact-list a {
    text-decoration: none;
    color: inherit;
  }

  .footer-premium__contact-list a:hover {
    color: var(--footer-gold);
  }

  .footer-premium__trust {
    margin: 0;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    padding: 0.5rem 0;
    border-top: 1px solid var(--footer-gold-soft);
    border-bottom: 1px solid var(--footer-gold-soft);
  }

  .footer-premium__bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    text-align: center;
  }

  .footer-premium__copyright {
    margin: 0;
    font-size: 0.8rem;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .footer-premium__policies {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1rem;
  }

  .footer-premium__policies a {
    font-size: 0.78rem;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  .footer-premium__policies a:hover {
    color: var(--footer-gold);
  }

  @media screen and (min-width: 750px) {
    .footer-premium__main {
      grid-template-columns: 1.15fr repeat(3, minmax(0, 1fr));
      align-items: start;
    }

    .footer-premium__mid {
      grid-template-columns: 1.1fr 1fr;
      gap: 1.75rem;
      align-items: start;
    }

    .footer-premium__map {
      min-height: 260px;
    }

    .footer-premium__contact-grid {
      grid-template-columns: 1fr;
    }

    .footer-premium__bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: start;
    }

    .footer-premium__policies {
      justify-content: flex-end;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Editable Footer",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
