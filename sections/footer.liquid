

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
>
  {% liquid
    assign total_blocks = section.blocks.size

    # Grid layout calculations
    assign grid_columns = total_blocks | at_most: 4

    # Calculate last row counts using modulo arithmetic
    # last_row_count = (total_blocks - 1) % N + 1
    assign last_row_count = total_blocks | minus: 1 | modulo: 4 | plus: 1
    assign tablet_last_row_count = total_blocks | minus: 1 | modulo: 2 | plus: 1

    # Check if there are orphaned elements (single item in last row)
    assign has_isolated_grid_item_desktop = false
    assign has_isolated_grid_item_tablet = false

    if total_blocks > 4 and last_row_count == 1
      assign has_isolated_grid_item_desktop = true
    endif

    if total_blocks == 5
      assign has_isolated_grid_item_tablet = true
    endif
  %}
  <div
    class="
      footer-content
      spacing-style
      {% if has_isolated_grid_item_desktop %}footer-content--isolated-grid-item-desktop{% endif %}
      {% if has_isolated_grid_item_tablet %}footer-content--isolated-grid-item-tablet{% endif %}
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      --footer-gap: {{ section.settings.gap }}px;
      --grid-columns: {{ grid_columns }};
      --last-row-count: {{ last_row_count }};
      --tablet-last-row-count: {{ tablet_last_row_count }};
    "
  >
    {% content_for 'blocks' %}
  </div>

  {% liquid
    assign category_menu = linklists[section.settings.category_menu]
    assign quick_links_menu = linklists[section.settings.quick_links_menu]
    assign support_menu = linklists[section.settings.support_menu]
  %}

  {% if section.settings.show_detailed_footer %}
    <div class="footer-detailed">
      {% if section.settings.detailed_footer_heading != blank %}
        <div class="footer-detailed__intro">
          <h3 class="footer-detailed__title">{{ section.settings.detailed_footer_heading }}</h3>
          {% if section.settings.detailed_footer_text != blank %}
            <p class="footer-detailed__text">{{ section.settings.detailed_footer_text }}</p>
          {% endif %}
        </div>
      {% endif %}

      <div class="footer-detailed__grid">
        <div class="footer-detailed__column">
          <h4 class="footer-detailed__heading">{{ section.settings.categories_heading | default: 'Categories' }}</h4>
          {% if category_menu != blank and category_menu.links.size > 0 %}
            <ul class="footer-detailed__list" role="list">
              {% for link in category_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-detailed__placeholder">{{ section.settings.categories_empty_text }}</p>
          {% endif %}
        </div>

        <div class="footer-detailed__column">
          <h4 class="footer-detailed__heading">{{ section.settings.quick_links_heading | default: 'Quick links' }}</h4>
          {% if quick_links_menu != blank and quick_links_menu.links.size > 0 %}
            <ul class="footer-detailed__list" role="list">
              {% for link in quick_links_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-detailed__placeholder">{{ section.settings.quick_links_empty_text }}</p>
          {% endif %}
        </div>

        <div class="footer-detailed__column">
          <h4 class="footer-detailed__heading">{{ section.settings.support_heading | default: 'Support' }}</h4>
          {% if support_menu != blank and support_menu.links.size > 0 %}
            <ul class="footer-detailed__list" role="list">
              {% for link in support_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-detailed__placeholder">{{ section.settings.support_empty_text }}</p>
          {% endif %}
        </div>

        <div class="footer-detailed__column">
          <h4 class="footer-detailed__heading">{{ section.settings.contact_heading | default: 'Contact' }}</h4>
          {% if section.settings.contact_text != blank %}
            <div class="footer-detailed__contact rte">{{ section.settings.contact_text }}</div>
          {% else %}
            <p class="footer-detailed__placeholder">{{ section.settings.contact_empty_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .footer-content {
    contain: content;
    content-visibility: auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--footer-gap);
    align-items: start;
  }

  .footer-content .menu__heading__default {
    font-weight: var(--font-heading--weight);
  }

  .footer-detailed {
    margin-top: clamp(1.2rem, 3vw, 2rem);
    padding-top: clamp(1rem, 2.2vw, 1.4rem);
    border-top: 1px solid rgb(var(--color-border-rgb) / 0.22);
  }

  .footer-detailed__intro {
    margin-bottom: 1rem;
  }

  .footer-detailed__title {
    margin: 0;
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    letter-spacing: 0.02em;
  }

  .footer-detailed__text {
    margin: 0.35rem 0 0;
    color: rgb(var(--color-foreground-rgb) / 0.72);
    max-width: 72ch;
  }

  .footer-detailed__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  .footer-detailed__heading {
    margin: 0 0 0.5rem;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .footer-detailed__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }

  .footer-detailed__list a {
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.86);
    transition: color 160ms ease;
  }

  .footer-detailed__list a:is(:hover, :focus-visible) {
    color: rgb(var(--color-foreground-rgb));
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-detailed__contact {
    color: rgb(var(--color-foreground-rgb) / 0.84);
  }

  .footer-detailed__contact p {
    margin: 0 0 0.45rem;
  }

  .footer-detailed__placeholder {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.58);
    font-size: 0.9rem;
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .footer-content {
      grid-template-columns: repeat(min(var(--grid-columns), 3), 1fr);
      grid-auto-flow: row;
    }

    .footer-content[style*='--grid-columns: 4'] {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-content--isolated-grid-item-tablet > :last-child {
      grid-column: 1 / -1;
    }

    .footer-detailed__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .footer-content {
      grid-template-columns: repeat(var(--grid-columns), 1fr);
    }

    /* Single item centered */
    .footer-content[style*='--grid-columns: 1'] {
      justify-items: center;
    }

    .footer-content--isolated-grid-item-desktop > :last-child {
      grid-column: 1 / -1;
    }

    .footer-detailed__grid {
      grid-template-columns: 1.15fr 1fr 1fr 1.2fr;
      gap: 1.8rem;
    }
  }
{% endstylesheet %}

