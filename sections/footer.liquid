<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<footer class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  {% liquid
    assign categories_menu = linklists[section.settings.categories_menu]
    assign quick_links_menu = linklists[section.settings.quick_links_menu]
  %}

  <div class="footer-rich spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="footer-rich__top">
      <div class="footer-rich__brand">
        {% if section.settings.logo != blank %}
          {{
            section.settings.logo
            | image_url: width: 320
            | image_tag:
              class: 'footer-rich__logo',
              loading: 'lazy',
              widths: '120,180,240,320',
              sizes: '180px'
          }}
        {% else %}
          <h2 class="footer-rich__brand-name">{{ section.settings.brand_name }}</h2>
        {% endif %}

        {% if section.settings.about_text != blank %}
          <div class="footer-rich__about rte">{{ section.settings.about_text }}</div>
        {% endif %}
      </div>

      <div class="footer-rich__nav-columns">
        <div class="footer-rich__column">
          <h3 class="footer-rich__heading">{{ section.settings.categories_heading }}</h3>
          {% if categories_menu != blank and categories_menu.links.size > 0 %}
            <ul class="footer-rich__links" role="list">
              {% for link in categories_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-rich__placeholder">{{ section.settings.categories_empty_text }}</p>
          {% endif %}
        </div>

        <div class="footer-rich__column">
          <h3 class="footer-rich__heading">{{ section.settings.quick_links_heading }}</h3>
          {% if quick_links_menu != blank and quick_links_menu.links.size > 0 %}
            <ul class="footer-rich__links" role="list">
              {% for link in quick_links_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-rich__placeholder">{{ section.settings.quick_links_empty_text }}</p>
          {% endif %}
        </div>

        <div class="footer-rich__column">
          <h3 class="footer-rich__heading">{{ section.settings.social_heading }}</h3>
          {% if section.blocks.size > 0 %}
            <ul class="footer-rich__links footer-rich__links--social" role="list">
              {% for block in section.blocks %}
                {% if block.type == 'social_link' and block.settings.url != blank %}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.url }}" {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
                      {{ block.settings.label }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          {% else %}
            <p class="footer-rich__placeholder">{{ section.settings.social_empty_text }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="footer-rich__info">
      <div class="footer-rich__info-item">
        <h4>{{ section.settings.hours_heading }}</h4>
        <div class="rte">{{ section.settings.working_hours }}</div>
      </div>
      <div class="footer-rich__info-item">
        <h4>{{ section.settings.address_heading }}</h4>
        <div class="rte">{{ section.settings.shop_address }}</div>
      </div>
      <div class="footer-rich__info-item">
        <h4>{{ section.settings.contact_heading }}</h4>
        <div class="rte">{{ section.settings.contact_details }}</div>
      </div>
    </div>

    <div class="footer-rich__bottom">
      <p>{{ section.settings.copyright_text }}</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .footer-rich {
    display: grid;
    gap: 1.25rem;
  }

  .footer-rich__top {
    display: grid;
    gap: 1.2rem;
  }

  .footer-rich__brand {
    display: grid;
    gap: 0.7rem;
  }

  .footer-rich__logo {
    width: 100%;
    max-width: 180px;
    height: auto;
    display: block;
  }

  .footer-rich__brand-name {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .footer-rich__about {
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .footer-rich__about p {
    margin: 0;
  }

  .footer-rich__nav-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .footer-rich__heading {
    margin: 0 0 0.55rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-rich__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.42rem;
  }

  .footer-rich__links a {
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.86);
  }

  .footer-rich__links a:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-rich__placeholder {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.58);
    font-size: 0.9rem;
  }

  .footer-rich__info {
    border-top: 1px solid rgb(var(--color-border-rgb) / 0.22);
    border-bottom: 1px solid rgb(var(--color-border-rgb) / 0.22);
    padding: 0.95rem 0;
    display: grid;
    gap: 0.85rem;
  }

  .footer-rich__info-item h4 {
    margin: 0 0 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .footer-rich__info-item :is(p, a) {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.86);
  }

  .footer-rich__bottom p {
    margin: 0;
    text-align: center;
    font-size: 0.82rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  @media screen and (min-width: 750px) {
    .footer-rich__top {
      grid-template-columns: 1.1fr 2fr;
      gap: 1.6rem;
    }

    .footer-rich__nav-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.4rem;
    }

    .footer-rich__info {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Editable Footer",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (fallback)",
      "default": "Lame Beauty Care"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Company logo"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "About text",
      "default": "<p>Premium cosmetic essentials designed for healthy skin and everyday confidence.</p>"
    },
    {
      "type": "text",
      "id": "categories_heading",
      "label": "Categories heading",
      "default": "Categories"
    },
    {
      "type": "link_list",
      "id": "categories_menu",
      "label": "Categories menu"
    },
    {
      "type": "text",
      "id": "categories_empty_text",
      "label": "Categories empty text",
      "default": "Assign a categories menu."
    },
    {
      "type": "text",
      "id": "quick_links_heading",
      "label": "Quick links heading",
      "default": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "quick_links_menu",
      "label": "Quick links menu"
    },
    {
      "type": "text",
      "id": "quick_links_empty_text",
      "label": "Quick links empty text",
      "default": "Assign a quick links menu."
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Social Sites"
    },
    {
      "type": "text",
      "id": "social_empty_text",
      "label": "Social empty text",
      "default": "Add social links blocks."
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Working hours heading",
      "default": "Working Hours"
    },
    {
      "type": "richtext",
      "id": "working_hours",
      "label": "Working hours",
      "default": "<p>Mon - Sat: 10:00 AM - 7:00 PM</p><p>Sunday: Closed</p>"
    },
    {
      "type": "text",
      "id": "address_heading",
      "label": "Address heading",
      "default": "Shop Address"
    },
    {
      "type": "richtext",
      "id": "shop_address",
      "label": "Shop address",
      "default": "<p>123 Beauty Street, City Name, State 000000</p>"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact Us"
    },
    {
      "type": "richtext",
      "id": "contact_details",
      "label": "Contact details",
      "default": "<p>Phone: +91 90000 00000</p><p>Email: support@example.com</p>"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "© 2026 Lame Beauty Care. All rights reserved."
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "social_link",
      "name": "Social link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Platform name",
          "default": "Instagram"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Editable Footer",
      "settings": {
        "brand_name": "Lame Beauty Care",
        "categories_heading": "Categories",
        "quick_links_heading": "Quick Links",
        "social_heading": "Social Sites",
        "hours_heading": "Working Hours",
        "address_heading": "Shop Address",
        "contact_heading": "Contact Us",
        "copyright_text": "© 2026 Lame Beauty Care. All rights reserved."
      },
      "blocks": {
        "social_instagram": {
          "type": "social_link",
          "settings": {
            "label": "Instagram",
            "url": "https://instagram.com"
          }
        },
        "social_facebook": {
          "type": "social_link",
          "settings": {
            "label": "Facebook",
            "url": "https://facebook.com"
          }
        },
        "social_youtube": {
          "type": "social_link",
          "settings": {
            "label": "YouTube",
            "url": "https://youtube.com"
          }
        }
      },
      "block_order": ["social_instagram", "social_facebook", "social_youtube"]
    }
  ]
}
{% endschema %}
