{%- liquid
  assign categories_menu = linklists[section.settings.categories_menu]
  assign quick_links_menu = linklists[section.settings.quick_links_menu]
  assign use_collection_links = false
  if categories_menu == blank or categories_menu.links.size == 0
    assign use_collection_links = true
  endif

  assign phone_href = section.settings.phone | strip
  if phone_href != blank
    assign phone_href = phone_href | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  endif

  assign map_query = section.settings.map_query | default: 'Lamstone Healthcare Mangalapuram Kerala' | url_encode
  assign directions_url = section.settings.map_directions_url
  if directions_url == blank
    assign directions_url = 'https://www.google.com/maps/search/?api=1&query=' | append: map_query
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<footer
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} footer-premium footer-premium--forest"
  id="footer-{{ section.id }}"
>
  {% if section.settings.show_footer_image %}
    <div class="footer-premium__visual" aria-hidden="true">
      {% if section.settings.footer_image != blank %}
        {{
          section.settings.footer_image
          | image_url: width: 2400
          | image_tag:
            class: 'footer-premium__visual-img',
            loading: 'lazy',
            widths: '600,900,1200,1600,2000,2400',
            sizes: '100vw',
            alt: ''
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'footer-premium__visual-placeholder' }}
      {% endif %}
      <span
        class="footer-premium__visual-overlay"
        style="--footer-visual-overlay: {{ section.settings.footer_image_overlay | divided_by: 100.0 }};"
      ></span>
    </div>
  {% endif %}

  <div class="footer-premium__inner spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="footer-premium__nav-panel">
      <div class="footer-premium__main">
      <div class="footer-premium__column">
        <h3 class="footer-premium__heading footer-premium__heading--icon">
          <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
          {{ section.settings.categories_heading }}
        </h3>
        <ul class="footer-premium__links" role="list">
          {% if use_collection_links %}
            {% for collection in collections limit: 12 %}
              {% unless collection.handle == 'frontpage' %}
                <li>
                  <a href="{{ collection.url }}" class="footer-premium__link-row">
                    <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                    <span>{{ collection.title }}</span>
                  </a>
                </li>
              {% endunless %}
            {% endfor %}
            {% if collections.size == 0 %}
              <li>
                <a href="{{ routes.all_products_collection_url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                  <span>Shop all</span>
                </a>
              </li>
            {% endif %}
          {% else %}
            {% for link in categories_menu.links %}
              <li>
                <a href="{{ link.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-link-icon', link: link %}</span>
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div class="footer-premium__column">
        <h3 class="footer-premium__heading footer-premium__heading--icon">
          <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'arrow' %}</span>
          {{ section.settings.quick_links_heading }}
        </h3>
        <ul class="footer-premium__links" role="list">
          {% if quick_links_menu != blank and quick_links_menu.links.size > 0 %}
            {% for link in quick_links_menu.links %}
              <li>
                <a href="{{ link.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-link-icon', link: link %}</span>
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {% endfor %}
          {% else %}
            <li>
              <a href="{{ routes.root_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'home' %}</span>
                <span>Home</span>
              </a>
            </li>
            <li>
              <a href="{{ routes.all_products_collection_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'grid' %}</span>
                <span>All products</span>
              </a>
            </li>
            {% if pages.contact %}
              <li>
                <a href="{{ pages.contact.url }}" class="footer-premium__link-row">
                  <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'email' %}</span>
                  <span>Contact</span>
                </a>
              </li>
            {% endif %}
            <li>
              <a href="{{ routes.search_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'search' %}</span>
                <span>Search</span>
              </a>
            </li>
            <li>
              <a href="{{ routes.account_url }}" class="footer-premium__link-row">
                <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'account' %}</span>
                <span>My account</span>
              </a>
            </li>
          {% endif %}
        </ul>
      </div>

      {% if section.settings.show_newsletter %}
        <div class="footer-premium__newsletter">
          <h3 class="footer-premium__heading footer-premium__heading--icon">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'mail' %}</span>
            {{ section.settings.newsletter_heading }}
          </h3>
          {% if section.settings.newsletter_text != blank %}
            <p class="footer-premium__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {% endif %}
          {%- form 'customer', class: 'footer-premium__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">
              {{ 'blocks.email_signup.label' | t }}
            </label>
            <div class="footer-premium__newsletter-row">
              <span class="footer-premium__icon footer-premium__icon--input" aria-hidden="true">
                {% render 'footer-icon', name: 'email' %}
              </span>
              <input
                id="FooterNewsletterEmail-{{ section.id }}"
                class="footer-premium__newsletter-input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
              >
              <button type="submit" class="footer-premium__newsletter-btn">
                <span>{{ section.settings.newsletter_button }}</span>
                <span class="footer-premium__icon footer-premium__icon--btn" aria-hidden="true">
                  {% render 'footer-icon', name: 'send' %}
                </span>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="footer-premium__newsletter-message footer-premium__newsletter-message--error">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="footer-premium__newsletter-message footer-premium__newsletter-message--success">
                {% if section.settings.newsletter_success != blank %}
                  {{ section.settings.newsletter_success }}
                {% else %}
                  {{ 'blocks.email_signup.success' | t }}
                {% endif %}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {% endif %}
      </div>
    </div>

    <div class="footer-premium__info-panel">
      <div class="footer-premium__mid">
      {% if section.settings.show_map %}
        <div class="footer-premium__map-wrap">
          <h3 class="footer-premium__heading footer-premium__heading--icon">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'map-pin' %}</span>
            {{ section.settings.map_heading }}
          </h3>
          <a class="footer-premium__directions" href="{{ directions_url }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.map_directions_label }}
            <span class="footer-premium__icon footer-premium__icon--inline" aria-hidden="true">
              {% render 'footer-icon', name: 'external' %}
            </span>
          </a>
        </div>
      {% endif %}

      <div class="footer-premium__contact-grid" aria-label="Store information">
        <div class="footer-premium__contact-block">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'clock' %}</span>
            {{ section.settings.hours_heading }}
          </h4>
          <div class="rte">{{ section.settings.working_hours }}</div>
        </div>
        <div class="footer-premium__contact-block">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'location' %}</span>
            {{ section.settings.address_heading }}
          </h4>
          <div class="rte">{{ section.settings.shop_address }}</div>
        </div>
        <div class="footer-premium__contact-block">
          <h4 class="footer-premium__contact-title">
            <span class="footer-premium__icon" aria-hidden="true">{% render 'footer-icon', name: 'phone' %}</span>
            {{ section.settings.contact_heading }}
          </h4>
          <ul class="footer-premium__contact-list" role="list">
            {% if section.settings.phone != blank %}
              <li>
                <span class="footer-premium__contact-label">Phone</span>
                <a href="tel:{{ phone_href }}">{{ section.settings.phone }}</a>
              </li>
            {% endif %}
            {% if section.settings.email != blank %}
              <li>
                <span class="footer-premium__contact-label">Email</span>
                <a href="mailto:{{ section.settings.email | strip }}">{{ section.settings.email }}</a>
              </li>
            {% endif %}
            {% if section.settings.contact_details != blank %}
              <li class="footer-premium__contact-extra rte">{{ section.settings.contact_details }}</li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>
    </div>
  </div>

  {% if section.settings.show_ventures %}
    {% liquid
      assign venture_blocks = section.blocks | where: 'type', 'venture'
    %}
    {% if venture_blocks.size > 0 or request.design_mode %}
      <div class="footer-premium__ventures-bar" aria-label="{{ section.settings.ventures_heading | default: 'Our Ventures' | escape }}">
        <div class="footer-premium__ventures-bar-inner">
          {% if section.settings.ventures_heading != blank %}
            <p class="footer-premium__ventures-bar-label">{{ section.settings.ventures_heading }}</p>
            <div class="footer-premium__ventures-ornament" aria-hidden="true">
              <span class="footer-premium__ventures-ornament-line"></span>
              <span class="footer-premium__ventures-ornament-mark"></span>
              <span class="footer-premium__ventures-ornament-line"></span>
            </div>
          {% endif %}
          <ul class="footer-premium__ventures-row" role="list">
            {% for block in venture_blocks %}
              {% liquid
                assign venture_image = block.settings.image
                assign venture_alt = block.settings.alt | default: block.settings.title
                assign venture_asset = block.settings.asset | strip
                assign has_venture_logo = false
                if venture_image != blank or venture_asset != blank
                  assign has_venture_logo = true
                endif
              %}
              {% if has_venture_logo == false and request.design_mode == false %}
                {% continue %}
              {% endif %}
              <li class="footer-premium__venture-item" {{ block.shopify_attributes }}>
                {% if block.settings.link != blank %}
                  <a
                    href="{{ block.settings.link }}"
                    class="footer-premium__venture-link"
                    aria-label="{{ venture_alt | escape }}"
                    {% if block.settings.open_in_new_tab %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                {% else %}
                  <span class="footer-premium__venture-link">
                {% endif %}
                {% if venture_image != blank %}
                  {{
                    venture_image
                    | image_url: width: 1920
                    | image_tag:
                      class: 'footer-premium__venture-logo',
                      loading: 'lazy',
                      widths: '320,480,640,800,960,1200,1440,1920',
                      sizes: '(max-width: 749px) 44vw, 320px',
                      alt: venture_alt
                  }}
                {% elsif venture_asset != blank %}
                  <img
                    class="footer-premium__venture-logo"
                    src="{{ venture_asset | asset_url }}"
                    alt="{{ venture_alt | escape }}"
                    width="560"
                    height="180"
                    loading="lazy"
                  >
                {% elsif request.design_mode %}
                  <span class="footer-premium__venture-placeholder">Add venture logo</span>
                {% endif %}
                {% if block.settings.link != blank %}
                  </a>
                {% else %}
                  </span>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% endif %}

  <div class="footer-premium__legal">
    {% if section.settings.trust_badges != blank %}
      <p class="footer-premium__trust">
        <span class="footer-premium__icon footer-premium__icon--trust" aria-hidden="true">
          {% render 'footer-icon', name: 'sparkle' %}
        </span>
        {{ section.settings.trust_badges }}
      </p>
    {% endif %}

    <div class="footer-premium__bottom">
      {% if section.settings.show_policy_links %}
        <ul class="footer-premium__policies" role="list">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li>
                <a href="{{ policy.url }}" class="footer-premium__link-row footer-premium__link-row--policy">
                  <span>{{ policy.title }}</span>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
      {% if section.settings.copyright_text != blank %}
        <p class="footer-premium__copyright">{{ section.settings.copyright_text | newline_to_br }}</p>
      {% endif %}
    </div>

    <p class="footer-premium__rights">
      {{ section.settings.rights_text | default: 'All rights reserved. Lamstone Healthcare (P) Ltd since 2026.' }}
    </p>
  </div>
</footer>

{% style %}
  #footer-{{ section.id }} {
    --footer-font-display: 'Cormorant Garamond', Georgia, serif;
    --footer-font-body: 'Jost', var(--font-body--family), sans-serif;
    --footer-forest: 21 66 48;
    --footer-forest-dark: 21 66 48;
    --footer-gold: rgb(221 196 130);
    --footer-gold-bright: rgb(212 175 55);
    --footer-gold-soft: rgb(255 255 255 / 0.16);
    --footer-icon-bg: rgb(255 255 255 / 0.08);
    --footer-text: rgb(255 255 255);
    --footer-text-muted: rgb(255 255 255 / 0.88);
    --footer-text-subtle: rgb(255 255 255 / 0.68);
    --footer-icon-size: 0.875rem;
    --footer-icon-box: 1.375rem;
    --footer-edge: clamp(0.65rem, 2.5vw, 0.85rem);
    --footer-edge-desktop: clamp(1.25rem, 3vw, 2.5rem);
    --footer-luxury-radius: 14px;
    font-family: var(--footer-font-body);
    color: var(--footer-text);
    border-top: 1px solid rgb(255 255 255 / 0.1);
    background: #154230;
  }

  #footer-{{ section.id }} .footer-premium__icon-svg,
  #footer-{{ section.id }} svg.footer-premium__icon-svg {
    width: var(--footer-icon-size);
    height: var(--footer-icon-size);
    display: block;
    flex-shrink: 0;
  }

  #footer-{{ section.id }} .footer-premium__inner {
    display: grid;
    gap: 0;
    width: 100%;
    max-width: min(1200px, 100%);
    margin-inline: auto;
    padding-inline: var(--footer-edge-desktop);
    box-sizing: border-box;
  }

  #footer-{{ section.id }} .footer-premium__nav-panel {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  #footer-{{ section.id }} .footer-premium__info-panel {
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  #footer-{{ section.id }} .footer-premium__main {
    display: grid;
    gap: clamp(1.35rem, 2.5vw, 2rem);
  }

  #footer-{{ section.id }} .footer-premium__column,
  #footer-{{ section.id }} .footer-premium__newsletter {
    min-width: 0;
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar {
    margin-top: 0;
    border-top: 1px solid #c5a059;
    border-bottom: 1px solid #c5a059;
    background-color: #f9f8f3;
    background-image: none;
    color: rgb(24 24 24);
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar-inner {
    width: 100%;
    max-width: min(1280px, 100%);
    margin-inline: auto;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1rem, 3vw, 2.5rem) clamp(1.85rem, 3.8vw, 2.85rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #footer-{{ section.id }} .footer-premium__ventures-bar-label {
    margin: 0;
    text-align: center;
    font-family: var(--footer-font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #012a1c;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    max-width: 11rem;
    margin: 0.7rem auto 1.35rem;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-line {
    flex: 1 1 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, #c5a059 30%, #c5a059);
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-line:last-child {
    background: linear-gradient(90deg, #c5a059, #c5a059 70%, transparent);
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-mark {
    position: relative;
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid #c5a059;
    transform: rotate(45deg);
    background: #f9f8f3;
  }

  #footer-{{ section.id }} .footer-premium__ventures-ornament-mark::before {
    content: '';
    position: absolute;
    inset: 2px;
    border: 1px solid rgb(197 160 89 / 0.55);
  }

  #footer-{{ section.id }} .footer-premium__ventures-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
  }

  #footer-{{ section.id }} .footer-premium__venture-item {
    flex: 0 1 auto;
    min-width: 0;
  }

  #footer-{{ section.id }} .footer-premium__venture-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.25rem 0.4rem;
    text-decoration: none;
    background: transparent;
    border: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  #footer-{{ section.id }} .footer-premium__venture-link:is(:hover, :focus-visible) {
    opacity: 0.82;
    transform: translateY(-1px);
  }

  #footer-{{ section.id }} .footer-premium__venture-logo {
    display: block;
    width: auto;
    max-width: min(7.5rem, 22vw);
    height: auto;
    max-height: 2.5rem;
    object-fit: contain;
    object-position: center;
    background: transparent;
    filter: invert(1);
    mix-blend-mode: multiply;
  }

  #footer-{{ section.id }} .footer-premium__venture-placeholder {
    min-width: 5.5rem;
    padding: 0.5rem 0.65rem;
    border: 1px dashed rgb(0 0 0 / 0.18);
    border-radius: 6px;
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(0 0 0 / 0.45);
    text-align: center;
    background: rgb(255 255 255 / 0.65);
  }

  @media screen and (min-width: 750px) {
    #footer-{{ section.id }} .footer-premium__ventures-bar-inner {
      padding: clamp(2rem, 3.5vw, 3rem) clamp(1.5rem, 3vw, 2.75rem) clamp(2.15rem, 3.8vw, 3.15rem);
    }

    #footer-{{ section.id }} .footer-premium__ventures-bar-label {
      font-size: clamp(1.15rem, 1.5vw, 1.4rem);
      letter-spacing: 0.26em;
    }

    #footer-{{ section.id }} .footer-premium__ventures-ornament {
      max-width: 12.5rem;
      margin-bottom: 1.65rem;
    }
  }

  /* Desktop: larger logos in a single centered row */
  @media screen and (min-width: 990px) {
    #footer-{{ section.id }} .footer-premium__ventures-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: clamp(1.5rem, 3vw, 2.75rem);
    }

    #footer-{{ section.id }} .footer-premium__venture-item {
      flex: 0 1 auto;
      width: auto;
      max-width: none;
    }

    #footer-{{ section.id }} .footer-premium__venture-link {
      min-height: 4.5rem;
      padding: 0.5rem 0.65rem;
      width: auto;
    }

    #footer-{{ section.id }} .footer-premium__venture-logo {
      width: auto;
      max-width: 12.5rem;
      max-height: 4.75rem;
    }
  }

  /* Mobile + tablet: 2 logos per row */
  @media screen and (max-width: 989px) {
    #footer-{{ section.id }} .footer-premium__ventures-bar-inner {
      padding-inline: clamp(0.85rem, 4vw, 1.5rem);
    }

    #footer-{{ section.id }} .footer-premium__ventures-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: center;
      align-items: center;
      gap: 0.85rem 1rem;
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }

    #footer-{{ section.id }} .footer-premium__ventures-row::-webkit-scrollbar {
      display: none;
    }

    #footer-{{ section.id }} .footer-premium__venture-item {
      width: 100%;
      max-width: none;
      scroll-snap-align: unset;
    }

    #footer-{{ section.id }} .footer-premium__venture-link {
      min-height: 3.25rem;
      padding: 0.4rem 0.5rem;
      width: 100%;
    }

    #footer-{{ section.id }} .footer-premium__venture-logo {
      width: 100%;
      max-width: 100%;
      max-height: clamp(2.5rem, 10vw, 3.5rem);
    }
  }

  #footer-{{ section.id }} .footer-premium__heading {
    margin: 0 0 1rem;
    font-family: var(--footer-font-display);
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--footer-text);
    position: relative;
    padding-bottom: 0.65rem;
  }

  #footer-{{ section.id }} .footer-premium__heading--icon {
    display: flex;
    align-items: center;
    gap: 0;
