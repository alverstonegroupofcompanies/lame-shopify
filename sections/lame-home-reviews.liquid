{%- liquid
  assign review_sum = 0
  assign review_count = 0

  for block in section.blocks
    if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank
      assign review_sum = review_sum | plus: block.settings.rating
      assign review_count = review_count | plus: 1
    endif
  endfor

  assign review_average = 0
  if review_count > 0
    assign review_average = review_sum | times: 1.0 | divided_by: review_count | round: 1
  endif

  assign store_name = shop.name | default: 'My Lamstone'
  assign store_url = request.origin
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-home-reviews"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-home-reviews__wrap" data-lame-reviews data-shop-domain="{{ shop.permanent_domain | escape }}">
    <header class="lame-home-reviews__head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="lame-home-reviews__badge-wrap">
          <span class="lame-home-reviews__badge">
            <span class="lame-home-reviews__badge-sparkle" aria-hidden="true">✦</span>
            {{ section.settings.eyebrow | escape }}
            <span class="lame-home-reviews__badge-sparkle" aria-hidden="true">✦</span>
          </span>
        </div>
      {%- endif -%}

      {%- assign heading_text = section.settings.heading | default: 'Loved by Our Customers' -%}
      {%- if heading_text != blank -%}
        <h2 class="lame-home-reviews__heading">{{ heading_text | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="lame-home-reviews__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if review_count > 0 and section.settings.show_summary -%}
        <div class="lame-home-reviews__summary">
          <div class="lame-home-reviews__summary-card">
            <span class="lame-home-reviews__score" data-lame-review-score>{{ review_average }}</span>
            <div class="lame-home-reviews__summary-copy">
              <span class="lame-home-reviews__stars" style="--lame-rating: {{ review_average }};" data-lame-summary-stars aria-hidden="true">
                {%- for star_index in (0..4) -%}
                  <span class="lame-home-reviews__star" style="--i: {{ star_index }}">★</span>
                {%- endfor -%}
              </span>
              <p class="lame-home-reviews__count">
                Overall rating for {{ store_name | escape }}
                ·
                <span data-lame-review-count>
                  {% if review_count == 1 %}
                    1 verified review
                  {% else %}
                    {{ review_count }} verified reviews
                  {% endif %}
                </span>
              </p>
            </div>
          </div>
        </div>
      {%- endif -%}
    </header>

    {%- liquid
      assign reviewer_name = ''
      if customer
        assign reviewer_name = customer.first_name | append: ' ' | append: customer.last_name | strip
        if reviewer_name == blank
          assign reviewer_name = customer.email | split: '@' | first
        endif
      endif
      capture review_login_url
        render 'lame-customer-auth-url', type: 'login', return_url: request.path
      endcapture
      assign review_login_url = review_login_url | strip
    -%}

    <div class="lame-home-reviews__content-row">
      {%- comment -%} LEFT COLUMN: WRITE A REVIEW {%- endcomment -%}
      <aside class="lame-home-reviews__side-col">
        <div class="lame-home-reviews__compose" id="lame-write-review">
          {%- if customer -%}
            <form
              class="lame-home-reviews__form"
              data-lame-review-form
              data-customer-id="{{ customer.id }}"
              data-customer-name="{{ reviewer_name | escape }}"
              data-customer-email="{{ customer.email | escape }}"
              novalidate
            >
              <div class="lame-home-reviews__form-head">
                <p class="lame-home-reviews__form-title">Write a review</p>
                <p class="lame-home-reviews__form-as">Posting as {{ reviewer_name | escape }}</p>
              </div>
              <fieldset class="lame-home-reviews__stars-input">
                <legend>Your rating</legend>
                <div class="lame-home-reviews__stars-row">
                  {%- for star in (1..5) reversed -%}
                    <input
                      type="radio"
                      id="LameReviewStar-{{ section.id }}-{{ star }}"
                      name="rating"
                      value="{{ star }}"
                      {% if star == 5 %}checked{% endif %}
                    >
                    <label for="LameReviewStar-{{ section.id }}-{{ star }}">
                      <span aria-hidden="true">★</span>
                      <span class="lame-home-reviews__sr">{{ star }} star{% if star > 1 %}s{% endif %}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
              <label class="lame-home-reviews__field">
                <span>Title</span>
                <input type="text" name="title" maxlength="120" autocomplete="off" placeholder="Summarize your review">
              </label>
              <label class="lame-home-reviews__field">
                <span>Review</span>
                <textarea name="body" rows="3" maxlength="1500" required placeholder="How was your experience?"></textarea>
              </label>
              <div class="lame-home-reviews__form-actions">
                <button type="submit" class="lame-home-reviews__submit">Post review</button>
                <button type="button" class="lame-home-reviews__cancel" data-lame-review-cancel hidden>Cancel</button>
              </div>
              <p class="lame-home-reviews__form-status" data-lame-review-status role="status"></p>
            </form>
          {%- else -%}
            <div class="lame-home-reviews__login-card">
              <div class="lame-home-reviews__form-head">
                <p class="lame-home-reviews__form-title">Write a review</p>
                <p class="lame-home-reviews__form-as">Share your experience with our products</p>
              </div>
              <a class="lame-home-reviews__login" href="{{ review_login_url }}">Log in to write a review</a>
            </div>
          {%- endif -%}
        </div>
      </aside>

      {%- comment -%} RIGHT COLUMN: REVIEWS CAROUSEL {%- endcomment -%}
      <div class="lame-home-reviews__carousel-col">
        <div class="lame-home-reviews__carousel" data-lame-review-carousel>
          <button type="button" class="lame-home-reviews__nav lame-home-reviews__nav--prev" data-lame-review-prev aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>

          <div class="lame-home-reviews__grid" data-lame-review-grid>
          {%- if review_count > 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
                {%- liquid
                  assign card_rating = block.settings.rating | times: 1
                  if card_rating < 1
                    assign card_rating = 1
                  endif
                  if card_rating > 5
                    assign card_rating = 5
                  endif

                  assign author_name = block.settings.author | strip
                  assign author_initials = author_name | slice: 0, 1 | upcase
                  assign author_parts = author_name | split: ' '
                  if author_parts.size > 1
                    assign last_initial = author_parts.last | slice: 0, 1 | upcase
                    assign author_initials = author_initials | append: last_initial
                  endif

                  assign formatted_date = block.settings.date
                  if block.settings.date != blank and block.settings.date contains '-'
                    assign date_parts = block.settings.date | split: '-'
                    if date_parts.size == 3
                      assign y = date_parts[0]
                      assign m = date_parts[1]
                      assign d = date_parts[2]
                      case m
                        when '01'
                          assign month_name = 'Jan'
                        when '02'
                          assign month_name = 'Feb'
                        when '03'
                          assign month_name = 'Mar'
                        when '04'
                          assign month_name = 'Apr'
                        when '05'
                          assign month_name = 'May'
                        when '06'
                          assign month_name = 'Jun'
                        when '07'
                          assign month_name = 'Jul'
                        when '08'
                          assign month_name = 'Aug'
                        when '09'
                          assign month_name = 'Sep'
                        when '10'
                          assign month_name = 'Oct'
                        when '11'
                          assign month_name = 'Nov'
                        when '12'
                          assign month_name = 'Dec'
                        else
                          assign month_name = m
                      endcase
                      assign formatted_date = d | append: ' ' | append: month_name | append: ' ' | append: y
                    endif
                  endif
                -%}
                <article class="lame-home-reviews__card" data-review-rating="{{ card_rating }}" {{ block.shopify_attributes }}>
                  <span class="lame-home-reviews__card-quote-mark" aria-hidden="true">“</span>

                  <div class="lame-home-reviews__card-body">
                    <div class="lame-home-reviews__card-top">
                      <span class="lame-home-reviews__stars lame-home-reviews__stars--card" style="--lame-rating: {{ card_rating }};" aria-label="{{ card_rating }} out of 5 stars">
                        {%- for star_index in (0..4) -%}
                          <span class="lame-home-reviews__star" style="--i: {{ star_index }}" aria-hidden="true">★</span>
                        {%- endfor -%}
                      </span>
                      {%- if block.settings.date != blank -%}
                        <time class="lame-home-reviews__date" datetime="{{ block.settings.date | escape }}">{{ formatted_date | escape }}</time>
                      {%- endif -%}
                    </div>

                    {%- if block.settings.title != blank -%}
                      <h3 class="lame-home-reviews__title">{{ block.settings.title | escape }}</h3>
                    {%- endif -%}

                    <blockquote class="lame-home-reviews__quote">
                      <p>{{ block.settings.quote | escape }}</p>
                    </blockquote>
                    <button type="button" class="lame-home-reviews__read-more" aria-expanded="false" style="display: none;">Read more</button>
                  </div>

                  <footer class="lame-home-reviews__byline">
                    <div class="lame-home-reviews__author-wrap">
                      <span class="lame-home-reviews__avatar" aria-hidden="true">{{ author_initials }}</span>
                      <div class="lame-home-reviews__author-meta">
                        <cite>{{ author_name | escape }}</cite>
                        {%- if block.settings.product != blank -%}
                          <a class="lame-home-reviews__product-link" href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
                        {%- elsif block.settings.detail != blank -%}
                          <span class="lame-home-reviews__detail">{{ block.settings.detail | escape }}</span>
                        {%- endif -%}
                      </div>
                    </div>

                    <span class="lame-home-reviews__verified-tag" title="Verified Customer">
                      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg>
                      <span>Verified Buyer</span>
                    </span>
                  </footer>
                </article>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          </div>

          <button type="button" class="lame-home-reviews__nav lame-home-reviews__nav--next" data-lame-review-next aria-label="Next reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{%- if review_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "OnlineStore",
          "@id": {{ store_url | append: '/#store' | json }},
          "name": {{ store_name | json }},
          "url": {{ store_url | json }},
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ review_average | json }},
            "reviewCount": {{ review_count | json }},
            "bestRating": 5,
            "worstRating": 1
          },
          "review": [
            {%- assign emitted = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
                {%- if emitted > 0 -%},{%- endif -%}
                { "@id": {{ store_url | append: '/#review-' | append: block.id | json }} }
                {%- assign emitted = emitted | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
            {%- liquid
              assign card_rating = block.settings.rating | times: 1
              if card_rating < 1
                assign card_rating = 1
              endif
              if card_rating > 5
                assign card_rating = 5
              endif
            -%}
            ,{
              "@type": "Review",
              "@id": {{ store_url | append: '/#review-' | append: block.id | json }},
              "author": {
                "@type": "Person",
                "name": {{ block.settings.author | json }}
              },
              {%- if block.settings.date != blank -%}
              "datePublished": {{ block.settings.date | json }},
              {%- endif -%}
              {%- if block.settings.title != blank -%}
              "name": {{ block.settings.title | json }},
              {%- endif -%}
              "reviewBody": {{ block.settings.quote | json }},
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": {{ card_rating | json }},
                "bestRating": 5,
                "worstRating": 1
              },
              "itemReviewed": {
                "@id": {{ store_url | append: '/#store' | json }}
              }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script>
  (() => {
    const root = document.querySelector('[data-lame-reviews]');
    const grid = document.querySelector('[data-lame-review-grid]');
    const form = document.querySelector('[data-lame-review-form]');
    if (!root || !grid) return;

    const shopDomain = root.dataset.shopDomain || '';
    const ownerName = (form?.dataset.customerName || '').trim().toLowerCase().replace(/\s+/g, ' ');
    const ownerId = form?.dataset.customerId || 'guest';
    const hideKey = 'lame-hidden-reviews:' + ownerId;
    const editStoreKey = 'lame-edited-reviews:' + ownerId;
    let editingKey = '';

    const hiddenReviews = () => {
      try {
        return new Set(JSON.parse(localStorage.getItem(hideKey) || '[]'));
      } catch (error) {
        return new Set();
      }
    };

    const rememberHidden = (key) => {
      const hidden = hiddenReviews();
      hidden.add(key);
      localStorage.setItem(hideKey, JSON.stringify([...hidden]));
    };

    const reviewKey = (review) => review.id || 'body:' + (review.body || '').trim().toLowerCase();

    const editedReviews = () => {
      try {
        const data = JSON.parse(localStorage.getItem(editStoreKey) || '{}');
        return data && typeof data === 'object' ? data : {};
      } catch (error) {
        return {};
      }
    };

    const rememberEdit = (key, review) => {
      const edits = editedReviews();
      edits[key] = {
        rating: String(review.rating),
        title: review.title || '',
        body: review.body || '',
      };
      localStorage.setItem(editStoreKey, JSON.stringify(edits));
    };

    const savedReview = (review, key) => {
      const edits = editedReviews();
      return edits[key] || edits['body:' + (review.body || '').trim().toLowerCase()] || null;
    };

    const isOwner = (author) => {
      const name = (author || '').trim().toLowerCase().replace(/\s+/g, ' ');
      return Boolean(ownerName) && name === ownerName;
    };

    const existingBodies = () =>
      [...grid.querySelectorAll('.lame-home-reviews__quote p')].map((node) => node.textContent.trim().toLowerCase());

    const formatReviewDate = (raw) => {
      if (!raw || typeof raw !== 'string') return '';
      const parts = raw.split('-');
      if (parts.length === 3) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const m = parseInt(parts[1], 10) - 1;
        if (m >= 0 && m < 12) {
          return `${parts[2]} ${months[m]} ${parts[0]}`;
        }
      }
      return raw;
    };

    const getAuthorInitials = (author) => {
      const name = (author || 'Customer').trim();
      const parts = name.split(/\s+/).filter(Boolean);
      if (parts.length >= 2) {
        return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
      }
      return name.slice(0, 2).toUpperCase();
    };

    const setupCardReadMore = (card) => {
      if (!card) return;
      const quote = card.querySelector('.lame-home-reviews__quote p');
      if (!quote) return;

      let btn = card.querySelector('.lame-home-reviews__read-more');
      if (!btn) {
        btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'lame-home-reviews__read-more';
        btn.setAttribute('aria-expanded', 'false');
        btn.textContent = 'Read more';
        const bodyWrap = card.querySelector('.lame-home-reviews__card-body') || card;
        bodyWrap.append(btn);
      }

      const textLen = (quote.textContent || '').trim().length;
      const isOverflowing = quote.scrollHeight > quote.clientHeight + 4 || textLen > 115;

      if (isOverflowing || card.classList.contains('is-expanded')) {
        btn.style.display = 'inline-flex';
      } else {
        btn.style.display = 'none';
      }

      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const expanded = card.classList.toggle('is-expanded');
        btn.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        btn.textContent = expanded ? 'Read less' : 'Read more';
      };
    };

    const setupAllCardsReadMore = () => {
      grid.querySelectorAll('.lame-home-reviews__card').forEach(setupCardReadMore);
    };

    const paintCard = (article, { rating, title, body }) => {
      const score = Math.min(5, Math.max(1, Number(rating) || 5));
      const text = (body || '').trim();
      article.dataset.reviewRating = String(score);
      article.dataset.reviewTitle = title || '';
      article.dataset.reviewBody = text;

      const stars = article.querySelector('.lame-home-reviews__stars--card');
      if (stars) {
        stars.style.setProperty('--lame-rating', String(score));
        stars.setAttribute('aria-label', score + ' out of 5 stars');
      }

      const bodyWrap = article.querySelector('.lame-home-reviews__card-body') || article;
      let heading = article.querySelector('.lame-home-reviews__title');
      if (title) {
        if (!heading) {
          heading = document.createElement('h3');
          heading.className = 'lame-home-reviews__title';
          const quote = article.querySelector('.lame-home-reviews__quote');
          bodyWrap.insertBefore(heading, quote);
        }
        heading.textContent = title;
      } else if (heading) {
        heading.remove();
      }

      const paragraph = article.querySelector('.lame-home-reviews__quote p');
      if (paragraph) paragraph.textContent = text;
      setupCardReadMore(article);
      refreshSummary();
    };

    const addCard = ({ id, rating, title, body, author, date, detail, href }, place) => {
      const original = (body || title || '').trim();
      if (!original) return;
      const key = reviewKey({ id, body: original });
      if (hiddenReviews().has(key) || hiddenReviews().has('body:' + original.toLowerCase())) return;
      const saved = savedReview({ body: original }, key);
      const nextTitle = saved ? saved.title || '' : title || '';
      const text = (saved && saved.body ? saved.body : (body || '')).trim();
      const nextRating = saved && saved.rating ? saved.rating : rating;
      if (!text && !nextTitle) return;
      if (text && existingBodies().includes(text.toLowerCase())) return;

      const score = Math.min(5, Math.max(1, Number(nextRating) || 5));
      const article = document.createElement('article');
      article.className = 'lame-home-reviews__card';
      article.dataset.reviewKey = key;
      article.dataset.reviewRating = String(score);
      article.dataset.reviewTitle = nextTitle;
      article.dataset.reviewBody = text;

      const quoteMark = document.createElement('span');
      quoteMark.className = 'lame-home-reviews__card-quote-mark';
      quoteMark.setAttribute('aria-hidden', 'true');
      quoteMark.textContent = '“';
      article.append(quoteMark);

      const bodyWrap = document.createElement('div');
      bodyWrap.className = 'lame-home-reviews__card-body';

      const top = document.createElement('div');
      top.className = 'lame-home-reviews__card-top';
      const stars = document.createElement('span');
      stars.className = 'lame-home-reviews__stars lame-home-reviews__stars--card';
      stars.style.setProperty('--lame-rating', String(score));
      stars.setAttribute('aria-label', score + ' out of 5 stars');
      for (let index = 0; index < 5; index += 1) {
        const star = document.createElement('span');
        star.className = 'lame-home-reviews__star';
        star.style.setProperty('--i', String(index));
        star.setAttribute('aria-hidden', 'true');
        star.textContent = '★';
        stars.append(star);
      }
      top.append(stars);

      const meta = document.createElement('div');
      meta.className = 'lame-home-reviews__meta';
      if (date) {
        const time = document.createElement('time');
        time.className = 'lame-home-reviews__date';
        time.dateTime = date;
        time.textContent = formatReviewDate(date);
        meta.append(time);
      }
      top.append(meta);
      bodyWrap.append(top);

      if (nextTitle) {
        const heading = document.createElement('h3');
        heading.className = 'lame-home-reviews__title';
        heading.textContent = nextTitle;
        bodyWrap.append(heading);
      }

      if (text) {
        const quote = document.createElement('blockquote');
        quote.className = 'lame-home-reviews__quote';
        const paragraph = document.createElement('p');
        paragraph.textContent = text;
        quote.append(paragraph);
        bodyWrap.append(quote);
      }
      article.append(bodyWrap);

      const footer = document.createElement('footer');
      footer.className = 'lame-home-reviews__byline';

      const authorWrap = document.createElement('div');
      authorWrap.className = 'lame-home-reviews__author-wrap';

      const avatar = document.createElement('span');
      avatar.className = 'lame-home-reviews__avatar';
      avatar.setAttribute('aria-hidden', 'true');
      avatar.textContent = getAuthorInitials(author);
      authorWrap.append(avatar);

      const authorMeta = document.createElement('div');
      authorMeta.className = 'lame-home-reviews__author-meta';

      const cite = document.createElement('cite');
      cite.textContent = author || 'Verified Customer';
      authorMeta.append(cite);

      if (detail) {
        if (href && href.indexOf('/products/') === 0) {
          const link = document.createElement('a');
          link.className = 'lame-home-reviews__product-link';
          link.href = href;
          link.textContent = detail;
          authorMeta.append(link);
        } else {
          const span = document.createElement('span');
          span.className = 'lame-home-reviews__detail';
          span.textContent = detail;
          authorMeta.append(span);
        }
      }
      authorWrap.append(authorMeta);
      footer.append(authorWrap);

      const verified = document.createElement('span');
      verified.className = 'lame-home-reviews__verified-tag';
      verified.title = 'Verified Customer';
      verified.innerHTML =
        '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.75.75 0 0 1 1.06-1.06L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0z"/></svg><span>Verified Buyer</span>';
      footer.append(verified);

      if (isOwner(author)) {
        const edit = document.createElement('button');
        edit.type = 'button';
        edit.className = 'lame-home-reviews__edit';
        edit.setAttribute('aria-label', 'Edit your review');
        edit.innerHTML =
          '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.6 6.4 17.6 10.4"/><path d="M5.2 18.8 4.6 15.6 15.2 5a1.6 1.6 0 0 1 2.3 0l1.5 1.5a1.6 1.6 0 0 1 0 2.3L8.4 19.4 5.2 18.8z"/></svg>';
        edit.addEventListener('click', () => beginEdit(article));

        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'lame-home-reviews__remove';
        remove.setAttribute('aria-label', 'Remove your review');
        remove.innerHTML =
          '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9.2 4.8h5.6M5.4 7.2h13.2"/><path d="M8.1 7.2l.55 11.1a1.3 1.3 0 0 0 1.3 1.25h4.1a1.3 1.3 0 0 0 1.3-1.25L15.9 7.2"/><path d="M10.3 10.4v5.1M13.7 10.4v5.1"/></svg>';
        remove.addEventListener('click', () => {
          if (!window.confirm('Remove your review? Only you can remove a review you posted.')) return;
          rememberHidden(key);
          if (editingKey === key) resetComposer();
          article.remove();
          refreshCount();
        });
        meta.append(edit, remove);
      }
      article.append(footer);

      if (place === 'start') grid.prepend(article);
      else grid.append(article);
      setupCardReadMore(article);
      refreshCount();
    };

    const readReviews = (html) => {
      const doc = new DOMParser().parseFromString(html || '', 'text/html');
      return [...doc.querySelectorAll('.jdgm-rev')].map((node) => {
        const product = node.querySelector('.jdgm-rev__prod-link');
        const href = product ? product.getAttribute('href') || '' : '';
        return {
          id: node.getAttribute('data-review-id') || '',
          rating: node.querySelector('.jdgm-rev__rating')?.dataset.score || '5',
          title: node.querySelector('.jdgm-rev__title')?.textContent.trim() || '',
          body: node.querySelector('.jdgm-rev__body')?.textContent.trim() || '',
          author: node.querySelector('.jdgm-rev__author')?.textContent.trim() || '',
          date: (node.querySelector('.jdgm-rev__timestamp')?.dataset.content || '').slice(0, 10),
          detail: href.indexOf('/products/') === 0 ? product.textContent.trim() : '',
          href,
        };
      });
    };

    const countNode = root.querySelector('[data-lame-review-count]');
    const scoreNode = root.querySelector('[data-lame-review-score]');
    const summaryStars = root.querySelector('[data-lame-summary-stars]');

    const cardRating = (card) => {
      const fromData = Number(card.dataset.reviewRating);
      if (fromData >= 1) return Math.min(5, fromData);
      const stars = card.querySelector('.lame-home-reviews__stars');
      const fromStyle = Number(stars?.style.getPropertyValue('--lame-rating'));
      if (fromStyle >= 1) return Math.min(5, fromStyle);
      return 0;
    };

    const refreshSummary = () => {
      const ratings = [...grid.querySelectorAll('.lame-home-reviews__card')].map(cardRating).filter((rating) => rating > 0);
      const count = ratings.length;
      const average = count ? ratings.reduce((sum, rating) => sum + rating, 0) / count : 0;
      const rounded = Math.round(average * 10) / 10;

      if (scoreNode) scoreNode.textContent = count ? rounded.toFixed(1) : '0.0';
      if (summaryStars) summaryStars.style.setProperty('--lame-rating', String(rounded));
      if (countNode) countNode.textContent = count === 1 ? '1 review' : count + ' reviews';
    };

    const refreshCount = () => {
      refreshSummary();
      paintArrows();
    };

    const prevBtn = root.querySelector('[data-lame-review-prev]');
    const nextBtn = root.querySelector('[data-lame-review-next]');
    const carousel = root.querySelector('[data-lame-review-carousel]');
    let autoTimer = 0;
    let resumeTimer = 0;

    const stepSize = () => {
      const card = grid.querySelector('.lame-home-reviews__card');
      const styles = getComputedStyle(grid);
      const gap = parseFloat(styles.columnGap || styles.gap) || 14;
      return card ? card.getBoundingClientRect().width + gap : grid.clientWidth;
    };

    const maxScroll = () => Math.max(0, grid.scrollWidth - grid.clientWidth);
    const atStart = () => grid.scrollLeft <= 8;
    const atEnd = () => grid.scrollLeft >= maxScroll() - 8;

    const paintArrows = () => {
      const canMove = maxScroll() > 8;
      const start = atStart();
      const end = atEnd();
      prevBtn?.classList.toggle('is-ended', canMove && start);
      nextBtn?.classList.toggle('is-ended', canMove && end);
      if (prevBtn) {
        prevBtn.setAttribute('aria-disabled', canMove && start ? 'true' : 'false');
        prevBtn.style.display = canMove ? '' : 'none';
      }
      if (nextBtn) {
        nextBtn.setAttribute('aria-disabled', canMove && end ? 'true' : 'false');
        nextBtn.style.display = canMove ? '' : 'none';
      }
    };

    const scrollReviews = (direction) => {
      const max = maxScroll();
      if (max <= 8) return;
      if (direction > 0 && atEnd()) grid.scrollTo({ left: 0, behavior: 'smooth' });
      else if (direction < 0 && atStart()) grid.scrollTo({ left: max, behavior: 'smooth' });
      else grid.scrollBy({ left: direction * stepSize(), behavior: 'smooth' });
    };

    const stopAuto = () => {
      window.clearInterval(autoTimer);
      autoTimer = 0;
    };

    const startAuto = () => {
      stopAuto();
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (maxScroll() <= 8) return;
      autoTimer = window.setInterval(() => scrollReviews(1), 4200);
    };

    const pauseAuto = () => {
      stopAuto();
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(startAuto, 7000);
    };

    const resetToStart = () => {
      grid.scrollLeft = 0;
      paintArrows();
      startAuto();
    };

    prevBtn?.addEventListener('click', () => {
      scrollReviews(-1);
      pauseAuto();
    });
    nextBtn?.addEventListener('click', () => {
      scrollReviews(1);
      pauseAuto();
    });
    grid.addEventListener('scroll', () => paintArrows(), { passive: true });
    grid.addEventListener('pointerdown', pauseAuto);
    window.addEventListener('resize', () => {
      paintArrows();
      startAuto();
      setupAllCardsReadMore();
    });
    carousel?.addEventListener('mouseenter', stopAuto);
    carousel?.addEventListener('mouseleave', startAuto);
    carousel?.addEventListener('focusin', stopAuto);
    carousel?.addEventListener('focusout', startAuto);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAuto();
      else startAuto();
    });
    paintArrows();

    const loadStoredReviews = async () => {
      try {
        if (!shopDomain) return;
        const types = ['product-reviews', 'shop-reviews'];
        const found = [];
        await Promise.all(
          types.map(async (type) => {
            const url = new URL('https://cdn.judge.me/reviews/all_reviews_js_based');
            url.searchParams.set('url', shopDomain);
            url.searchParams.set('shop_domain', shopDomain);
            url.searchParams.set('platform', 'shopify');
            url.searchParams.set('page', '1');
            url.searchParams.set('per_page', '24');
            url.searchParams.set('review_type', type);
            const response = await fetch(url);
            if (!response.ok) return;
            const data = await response.json();
            found.push(...readReviews(data.html));
          })
        );
        found
          .sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0))
          .forEach((review) => addCard(review, 'start'));
      } catch (error) {
        /* Keep the reviews already on the page if Judge.me is unavailable. */
      } finally {
        refreshCount();
        resetToStart();
        setupAllCardsReadMore();
      }
    };

    setupAllCardsReadMore();
    loadStoredReviews();

    if (!form) return;
    const status = form.querySelector('[data-lame-review-status]');
    const button = form.querySelector('.lame-home-reviews__submit');
    const cancel = form.querySelector('[data-lame-review-cancel]');
    const formTitle = form.querySelector('.lame-home-reviews__form-title');

    const markEditing = (article) => {
      grid.querySelectorAll('.lame-home-reviews__card.is-editing').forEach((node) => {
        node.classList.remove('is-editing');
      });
      if (article) article.classList.add('is-editing');
    };

    const resetComposer = () => {
      editingKey = '';
      delete form.dataset.mode;
      markEditing(null);
      if (formTitle) formTitle.textContent = 'Write a review';
      if (button) button.textContent = 'Post review';
      if (cancel) cancel.hidden = true;
    };

    const beginEdit = (article) => {
      editingKey = article.dataset.reviewKey || '';
      form.dataset.mode = 'edit';
      markEditing(article);
      form.querySelector('[name="title"]').value = article.dataset.reviewTitle || '';
      form.querySelector('[name="body"]').value = article.dataset.reviewBody || '';
      const ratingInput = form.querySelector(
        'input[name="rating"][value="' + (article.dataset.reviewRating || '5') + '"]'
      );
      if (ratingInput) ratingInput.checked = true;
      if (formTitle) formTitle.textContent = 'Edit your review';
      button.textContent = 'Update review';
      if (cancel) cancel.hidden = false;
      status.textContent = '';
      status.dataset.state = '';
      form.scrollIntoView({ behavior: 'smooth', block: 'center' });
      form.querySelector('[name="body"]').focus();
    };

    cancel?.addEventListener('click', () => {
      form.reset();
      const five = form.querySelector('input[name="rating"][value="5"]');
      if (five) five.checked = true;
      resetComposer();
      status.textContent = '';
      status.dataset.state = '';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = form.querySelector('[name="body"]').value.trim();
      const title = form.querySelector('[name="title"]').value.trim();
      const rating = form.querySelector('input[name="rating"]:checked');
      if (!rating || body.length < 4) {
        status.textContent = 'Add a star rating and a short review.';
        status.dataset.state = 'error';
        return;
      }

      if (editingKey) {
        const article = [...grid.querySelectorAll('.lame-home-reviews__card')].find(
          (node) => node.dataset.reviewKey === editingKey
        );
        if (article) {
          rememberEdit(editingKey, { rating: rating.value, title, body });
          paintCard(article, { rating: rating.value, title, body });
          form.reset();
          const five = form.querySelector('input[name="rating"][value="5"]');
          if (five) five.checked = true;
          resetComposer();
          article.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          status.textContent = 'Updated. Your review is shown above.';
          status.dataset.state = 'success';
          return;
        }
        resetComposer();
      }

      const payload = new FormData();
      payload.append('shop_domain', shopDomain);
      payload.append('url', shopDomain);
      payload.append('platform', 'shopify');
      payload.append('name', form.dataset.customerName || '');
      payload.append('email', form.dataset.customerEmail || '');
      payload.append('shopify_customer_id', form.dataset.customerId || '');
      payload.append('rating', rating.value);
      payload.append('title', title);
      payload.append('body', body);
      payload.append('source', 'all-reviews-page');

      button.disabled = true;
      status.textContent = 'Posting your review…';
      status.dataset.state = '';

      try {
        const response = await fetch('https://api.judge.me/api/v1/reviews', {
          method: 'POST',
          body: payload,
        });
        if (!response.ok) {
          let message = 'Your review could not be posted. Please try again.';
          try {
            const data = await response.json();
            if (typeof data.error === 'string' && data.error) message = data.error;
            else if (Array.isArray(data.errors) && data.errors[0]) message = data.errors.join(', ');
          } catch (error) {
            message = 'Your review could not be posted. Please try again.';
          }
          throw new Error(message);
        }

        addCard(
          {
            rating: rating.value,
            title,
            body,
            author: form.dataset.customerName || 'You',
            date: new Date().toISOString().slice(0, 10),
            detail: '',
            href: '',
          },
          'start'
        );
        grid.scrollLeft = 0;
        paintArrows();
        grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        form.reset();
        const five = form.querySelector('input[name="rating"][value="5"]');
        if (five) five.checked = true;
        status.textContent = 'Posted. Your review is saved and shown above.';
        status.dataset.state = 'success';
      } catch (error) {
        status.textContent = error.message || 'Your review could not be posted. Please try again.';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>

