{%- liquid
  assign review_sum = 0
  assign review_count = 0

  for block in section.blocks
    if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank
      assign review_sum = review_sum | plus: block.settings.rating
      assign review_count = review_count | plus: 1
    endif
  endfor

  assign review_average = 0
  if review_count > 0
    assign review_average = review_sum | times: 1.0 | divided_by: review_count | round: 1
  endif

  assign store_name = shop.name | default: 'My Lamstone'
  assign store_url = request.origin
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-home-reviews"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-home-reviews__wrap" data-lame-reviews data-shop-domain="{{ shop.permanent_domain | escape }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="lame-home-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="lame-home-reviews__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if review_count > 0 and section.settings.show_summary -%}
      <div class="lame-home-reviews__summary">
        <p class="lame-home-reviews__score">{{ review_average }}</p>
        <div class="lame-home-reviews__summary-copy">
          <span class="lame-home-reviews__stars" style="--lame-rating: {{ review_average }};" aria-hidden="true">
            <span class="lame-home-reviews__stars-base">★★★★★</span>
            <span class="lame-home-reviews__stars-fill">★★★★★</span>
          </span>
          <p class="lame-home-reviews__count">
            Rating for {{ store_name | escape }}
            ·
            {% if review_count == 1 %}
              1 review
            {% else %}
              {{ review_count }} reviews
            {% endif %}
          </p>
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      assign reviewer_name = ''
      if customer
        assign reviewer_name = customer.first_name | append: ' ' | append: customer.last_name | strip
        if reviewer_name == blank
          assign reviewer_name = customer.email | split: '@' | first
        endif
      endif
      capture review_login_url
        render 'lame-customer-auth-url', type: 'login', return_url: request.path
      endcapture
      assign review_login_url = review_login_url | strip
    -%}

    <div class="lame-home-reviews__grid" data-lame-review-grid>
      {%- if review_count > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
            {%- liquid
              assign card_rating = block.settings.rating | times: 1
              if card_rating < 1
                assign card_rating = 1
              endif
              if card_rating > 5
                assign card_rating = 5
              endif
            -%}
            <article class="lame-home-reviews__card" {{ block.shopify_attributes }}>
              <div class="lame-home-reviews__card-top">
                <span class="lame-home-reviews__stars lame-home-reviews__stars--card" style="--lame-rating: {{ card_rating }};" aria-label="{{ card_rating }} out of 5 stars">
                  <span class="lame-home-reviews__stars-base" aria-hidden="true">★★★★★</span>
                  <span class="lame-home-reviews__stars-fill" aria-hidden="true">★★★★★</span>
                </span>
                {%- if block.settings.date != blank -%}
                  <time class="lame-home-reviews__date" datetime="{{ block.settings.date | escape }}">{{ block.settings.date | escape }}</time>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="lame-home-reviews__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              <blockquote class="lame-home-reviews__quote">
                <p>{{ block.settings.quote | escape }}</p>
              </blockquote>
              <footer class="lame-home-reviews__byline">
                <cite>{{ block.settings.author | escape }}</cite>
                {%- if block.settings.product != blank -%}
                  <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>
                {%- elsif block.settings.detail != blank -%}
                  <span>{{ block.settings.detail | escape }}</span>
                {%- endif -%}
              </footer>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="lame-home-reviews__compose" id="lame-write-review">
      {%- if customer -%}
        <form
          class="lame-home-reviews__form"
          data-lame-review-form
          data-customer-id="{{ customer.id }}"
          data-customer-name="{{ reviewer_name | escape }}"
          data-customer-email="{{ customer.email | escape }}"
          novalidate
        >
          <p class="lame-home-reviews__form-title">Write a review</p>
          <p class="lame-home-reviews__form-as">Posting as {{ reviewer_name | escape }}</p>
          <fieldset class="lame-home-reviews__stars-input">
            <legend>Your rating</legend>
            <div class="lame-home-reviews__stars-row">
              {%- for star in (1..5) reversed -%}
                <input
                  type="radio"
                  id="LameReviewStar-{{ section.id }}-{{ star }}"
                  name="rating"
                  value="{{ star }}"
                  {% if star == 5 %}checked{% endif %}
                >
                <label for="LameReviewStar-{{ section.id }}-{{ star }}">
                  <span aria-hidden="true">★</span>
                  <span class="lame-home-reviews__sr">{{ star }} star{% if star > 1 %}s{% endif %}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
          <label class="lame-home-reviews__field">
            <span>Title</span>
            <input type="text" name="title" maxlength="120" autocomplete="off" placeholder="Sum it up">
          </label>
          <label class="lame-home-reviews__field">
            <span>Review</span>
            <textarea name="body" rows="4" maxlength="1500" required placeholder="How was your experience?"></textarea>
          </label>
          <button type="submit" class="lame-home-reviews__submit">Post review</button>
          <p class="lame-home-reviews__form-status" data-lame-review-status role="status"></p>
        </form>
      {%- else -%}
        <a class="lame-home-reviews__login" href="{{ review_login_url }}">Log in to write a review</a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if review_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "OnlineStore",
          "@id": {{ store_url | append: '/#store' | json }},
          "name": {{ store_name | json }},
          "url": {{ store_url | json }},
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": {{ review_average | json }},
            "reviewCount": {{ review_count | json }},
            "bestRating": 5,
            "worstRating": 1
          },
          "review": [
            {%- assign emitted = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
                {%- if emitted > 0 -%},{%- endif -%}
                { "@id": {{ store_url | append: '/#review-' | append: block.id | json }} }
                {%- assign emitted = emitted | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          ]
        }
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' and block.settings.quote != blank and block.settings.author != blank -%}
            {%- liquid
              assign card_rating = block.settings.rating | times: 1
              if card_rating < 1
                assign card_rating = 1
              endif
              if card_rating > 5
                assign card_rating = 5
              endif
            -%}
            ,{
              "@type": "Review",
              "@id": {{ store_url | append: '/#review-' | append: block.id | json }},
              "author": {
                "@type": "Person",
                "name": {{ block.settings.author | json }}
              },
              {%- if block.settings.date != blank -%}
              "datePublished": {{ block.settings.date | json }},
              {%- endif -%}
              {%- if block.settings.title != blank -%}
              "name": {{ block.settings.title | json }},
              {%- endif -%}
              "reviewBody": {{ block.settings.quote | json }},
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": {{ card_rating | json }},
                "bestRating": 5,
                "worstRating": 1
              },
              "itemReviewed": {
                "@id": {{ store_url | append: '/#store' | json }}
              }
            }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script>
  (() => {
    const root = document.querySelector('[data-lame-reviews]');
    const grid = document.querySelector('[data-lame-review-grid]');
    const form = document.querySelector('[data-lame-review-form]');
    if (!root || !grid) return;

    const shopDomain = root.dataset.shopDomain || '';

    const existingBodies = () =>
      [...grid.querySelectorAll('.lame-home-reviews__quote p')].map((node) => node.textContent.trim().toLowerCase());

    const addCard = ({ rating, title, body, author, date, detail, href }, place) => {
      const text = (body || '').trim();
      if (!text) return;
      if (existingBodies().includes(text.toLowerCase())) return;

      const score = Math.min(5, Math.max(1, Number(rating) || 5));
      const article = document.createElement('article');
      article.className = 'lame-home-reviews__card';

      const top = document.createElement('div');
      top.className = 'lame-home-reviews__card-top';
      const stars = document.createElement('span');
      stars.className = 'lame-home-reviews__stars lame-home-reviews__stars--card';
      stars.style.setProperty('--lame-rating', String(score));
      stars.setAttribute('aria-label', score + ' out of 5 stars');
      const base = document.createElement('span');
      base.className = 'lame-home-reviews__stars-base';
      base.setAttribute('aria-hidden', 'true');
      base.textContent = '★★★★★';
      const fill = document.createElement('span');
      fill.className = 'lame-home-reviews__stars-fill';
      fill.setAttribute('aria-hidden', 'true');
      fill.textContent = '★★★★★';
      stars.append(base, fill);
      top.append(stars);
      if (date) {
        const time = document.createElement('time');
        time.className = 'lame-home-reviews__date';
        time.dateTime = date;
        time.textContent = date;
        top.append(time);
      }

      article.append(top);
      if (title) {
        const heading = document.createElement('h3');
        heading.className = 'lame-home-reviews__title';
        heading.textContent = title;
        article.append(heading);
      }

      const quote = document.createElement('blockquote');
      quote.className = 'lame-home-reviews__quote';
      const paragraph = document.createElement('p');
      paragraph.textContent = text;
      quote.append(paragraph);
      article.append(quote);

      const footer = document.createElement('footer');
      footer.className = 'lame-home-reviews__byline';
      const cite = document.createElement('cite');
      cite.textContent = author || 'Customer';
      footer.append(cite);
      if (detail) {
        if (href && href.indexOf('/products/') === 0) {
          const link = document.createElement('a');
          link.href = href;
          link.textContent = detail;
          footer.append(link);
        } else {
          const span = document.createElement('span');
          span.textContent = detail;
          footer.append(span);
        }
      }
      article.append(footer);

      if (place === 'start') grid.prepend(article);
      else grid.append(article);
    };

    const readReviews = (html) => {
      const doc = new DOMParser().parseFromString(html || '', 'text/html');
      return [...doc.querySelectorAll('.jdgm-rev')].map((node) => {
        const product = node.querySelector('.jdgm-rev__prod-link');
        const href = product ? product.getAttribute('href') || '' : '';
        return {
          rating: node.querySelector('.jdgm-rev__rating')?.dataset.score || '5',
          title: node.querySelector('.jdgm-rev__title')?.textContent.trim() || '',
          body: node.querySelector('.jdgm-rev__body')?.textContent.trim() || '',
          author: node.querySelector('.jdgm-rev__author')?.textContent.trim() || '',
          date: (node.querySelector('.jdgm-rev__timestamp')?.dataset.content || '').slice(0, 10),
          detail: href.indexOf('/products/') === 0 ? product.textContent.trim() : '',
          href,
        };
      });
    };

    const loadStoredReviews = async () => {
      if (!shopDomain) return;
      const types = ['product-reviews', 'shop-reviews'];
      const found = [];
      await Promise.all(
        types.map(async (type) => {
          const url = new URL('https://cdn.judge.me/reviews/all_reviews_js_based');
          url.searchParams.set('url', shopDomain);
          url.searchParams.set('shop_domain', shopDomain);
          url.searchParams.set('platform', 'shopify');
          url.searchParams.set('page', '1');
          url.searchParams.set('per_page', '6');
          url.searchParams.set('review_type', type);
          const response = await fetch(url);
          if (!response.ok) return;
          const data = await response.json();
          found.push(...readReviews(data.html));
        })
      );
      found
        .sort((a, b) => (a.date < b.date ? -1 : 1))
        .forEach((review) => addCard(review, 'start'));
    };

    loadStoredReviews();

    if (!form) return;
    const status = form.querySelector('[data-lame-review-status]');
    const button = form.querySelector('.lame-home-reviews__submit');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const body = form.querySelector('[name="body"]').value.trim();
      const title = form.querySelector('[name="title"]').value.trim();
      const rating = form.querySelector('input[name="rating"]:checked');
      if (!rating || body.length < 4) {
        status.textContent = 'Add a star rating and a short review.';
        status.dataset.state = 'error';
        return;
      }

      const payload = new FormData();
      payload.append('shop_domain', shopDomain);
      payload.append('url', shopDomain);
      payload.append('platform', 'shopify');
      payload.append('name', form.dataset.customerName || '');
      payload.append('email', form.dataset.customerEmail || '');
      payload.append('shopify_customer_id', form.dataset.customerId || '');
      payload.append('rating', rating.value);
      payload.append('title', title);
      payload.append('body', body);
      payload.append('source', 'all-reviews-page');

      button.disabled = true;
      status.textContent = 'Posting your review…';
      status.dataset.state = '';

      try {
        const response = await fetch('https://api.judge.me/api/v1/reviews', {
          method: 'POST',
          body: payload,
        });
        if (!response.ok) {
          let message = 'Your review could not be posted. Please try again.';
          try {
            const data = await response.json();
            if (typeof data.error === 'string' && data.error) message = data.error;
            else if (Array.isArray(data.errors) && data.errors[0]) message = data.errors.join(', ');
          } catch (error) {
            message = 'Your review could not be posted. Please try again.';
          }
          throw new Error(message);
        }

        addCard(
          {
            rating: rating.value,
            title,
            body,
            author: form.dataset.customerName || 'You',
            date: new Date().toISOString().slice(0, 10),
            detail: '',
            href: '',
          },
          'start'
        );
        grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        form.reset();
        const five = form.querySelector('input[name="rating"][value="5"]');
        if (five) five.checked = true;
        status.textContent = 'Posted. Your review is saved and shown above.';
        status.dataset.state = 'success';
      } catch (error) {
        status.textContent = error.message || 'Your review could not be posted. Please try again.';
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>

{% stylesheet %}
  .lame-home-reviews__wrap {
    width: min(1120px, 100%);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .lame-home-reviews__eyebrow {
    margin: 0 0 0.4rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .lame-home-reviews__heading {
    margin: 0;
    text-align: center;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-home-reviews__subheading {
    max-width: 38rem;
    margin: 0.55rem auto 0;
    text-align: center;
    font-size: 0.98rem;
    line-height: 1.5;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }

  .lame-home-reviews__summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin: 1.35rem auto 0;
  }

  .lame-home-reviews__score {
    margin: 0;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: 2.6rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-home-reviews__summary-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .lame-home-reviews__count {
    margin: 0;
    font-size: 0.86rem;
    color: rgb(var(--color-foreground-rgb) / 0.7);
  }

  .lame-home-reviews__stars {
    position: relative;
    display: inline-block;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;
  }

  .lame-home-reviews__stars--card {
    font-size: 0.95rem;
  }

  .lame-home-reviews__stars-base {
    color: #e4e4e4;
  }

  .lame-home-reviews__stars-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc((var(--lame-rating) / 5) * 100%);
    overflow: hidden;
    color: #f5a623;
    white-space: nowrap;
  }

  .lame-home-reviews__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
    margin-top: 1.5rem;
  }

  @media screen and (min-width: 750px) {
    .lame-home-reviews__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lame-home-reviews__card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin: 0;
    padding: 1.1rem 1.05rem 1rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: 16px;
    background: rgb(var(--color-background-rgb));
  }

  .lame-home-reviews__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .lame-home-reviews__date {
    font-size: 0.75rem;
    color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .lame-home-reviews__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-home-reviews__quote {
    margin: 0;
  }

  .lame-home-reviews__quote p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: rgb(var(--color-foreground-rgb) / 0.84);
  }

  .lame-home-reviews__byline {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: auto;
    padding-top: 0.35rem;
  }

  .lame-home-reviews__byline cite {
    font-style: normal;
    font-weight: 600;
    font-size: 0.9rem;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-home-reviews__byline span,
  .lame-home-reviews__byline a {
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.58);
    text-decoration: none;
  }

  .lame-home-reviews__compose {
    max-width: 34rem;
    margin: 1.75rem auto 0;
  }

  .lame-home-reviews__form {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.35rem 1.25rem 1.2rem;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 8px 28px rgb(28 32 24 / 0.05);
  }

  .lame-home-reviews__form-title {
    margin: 0;
    text-align: center;
    font-family: var(--lame-font-body, 'Jost', system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1c1c1c;
  }

  .lame-home-reviews__form-as {
    margin: -0.35rem 0 0;
    text-align: center;
    font-size: 0.86rem;
    color: #6b6460;
  }

  .lame-home-reviews__stars-input {
    margin: 0;
    padding: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .lame-home-reviews__stars-input legend {
    padding: 0;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #1c1c1c;
  }

  .lame-home-reviews__stars-row {
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    gap: 0.2rem;
  }

  .lame-home-reviews__stars-row input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .lame-home-reviews__stars-row label {
    cursor: pointer;
    font-size: 1.85rem;
    line-height: 1;
    color: #e4e4e4;
  }

  .lame-home-reviews__stars-row input:checked ~ label,
  .lame-home-reviews__stars-row label:hover,
  .lame-home-reviews__stars-row label:hover ~ label {
    color: #f5a623;
  }

  .lame-home-reviews__stars-row input:focus-visible + label {
    outline: 2px solid #2d4a22;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .lame-home-reviews__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lame-home-reviews__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .lame-home-reviews__field span {
    font-size: 0.78rem;
    font-weight: 600;
    color: #1c1c1c;
  }

  .lame-home-reviews__field input,
  .lame-home-reviews__field textarea {
    width: 100%;
    margin: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid #e6e6e6;
    border-radius: 10px;
    background: #fff;
    color: #1c1c1c;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.45;
    box-shadow: none;
  }

  .lame-home-reviews__field textarea {
    min-height: 7rem;
    resize: vertical;
  }

  .lame-home-reviews__field input:focus,
  .lame-home-reviews__field textarea:focus {
    outline: 2px solid rgb(45 74 34 / 0.35);
    border-color: #2d4a22;
  }

  .lame-home-reviews__submit,
  .lame-home-reviews__login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 999px;
    background: #2d4a22;
    color: #fff;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .lame-home-reviews__login {
    width: 100%;
    max-width: 18rem;
    margin-inline: auto;
  }

  .lame-home-reviews__submit:hover,
  .lame-home-reviews__login:hover {
    background: #243c1b;
  }

  .lame-home-reviews__submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .lame-home-reviews__form-status {
    min-height: 1.2em;
    margin: 0;
    text-align: center;
    font-size: 0.86rem;
    color: #6b6460;
  }

  .lame-home-reviews__form-status[data-state='success'] {
    color: #2d4a22;
  }

  .lame-home-reviews__form-status[data-state='error'] {
    color: #9b2c2c;
  }

  .lame-product-rating-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
    margin: 0 0 0.75rem;
  }

  .lame-product-rating-line__stars {
    position: relative;
    display: inline-block;
    font-size: 1rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .lame-product-rating-line__base {
    color: #e4e4e4;
  }

  .lame-product-rating-line__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc((var(--lame-rating) / 5) * 100%);
    overflow: hidden;
    color: #f5a623;
    white-space: nowrap;
  }

  .lame-product-rating-line__text {
    font-size: 0.86rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }
{% endstylesheet %}

