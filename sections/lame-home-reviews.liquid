    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    align-self: flex-start;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .lame-home-reviews__read-more:hover {
    color: #1a2c16;
    opacity: 0.85;
  }

  .lame-home-reviews__byline {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(45, 74, 34, 0.08);
    flex: 0 0 auto;
    height: 46px;
    min-height: 46px;
    box-sizing: border-box;
  }

  .lame-home-reviews__author-wrap {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .lame-home-reviews__avatar {
    width: 34px;
    height: 34px;
    min-width: 34px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2d4a22 0%, #3e682e 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    flex-shrink: 0;
    box-shadow: 0 3px 8px rgba(45, 74, 34, 0.18);
    border: 1.5px solid #ffffff;
  }

  .lame-home-reviews__author-meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    height: 34px;
    line-height: 1.25;
  }

  .lame-home-reviews__author-meta cite {
    font-style: normal;
    font-weight: 600;
    font-size: 0.88rem;
    line-height: 1.25;
    color: #1a2c16;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
  }

  .lame-home-reviews__detail,
  .lame-home-reviews__product-link {
    font-size: 0.72rem;
    color: #72826e;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    line-height: 1.2;
    margin-top: 2px;
  }

  .lame-home-reviews__product-link:hover {
    color: #2d4a22;
    text-decoration: underline;
  }

  .lame-home-reviews__verified-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(45, 74, 34, 0.06);
    color: #2d4a22;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    border: 1px solid rgba(45, 74, 34, 0.12);
    white-space: nowrap;
    flex-shrink: 0;
    height: 22px;
    box-sizing: border-box;
  }

  .lame-home-reviews__verified-tag svg {
    width: 11px;
    height: 11px;
  }

  @media screen and (min-width: 750px) {
    .lame-home-reviews__card {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }

  @media screen and (min-width: 990px) {
    .lame-home-reviews__card {
      flex: 0 0 calc((100% - 2 * 1.15rem) / 3);
      min-width: 0;
    }

    .lame-home-reviews__nav--prev {
      left: -0.75rem;
    }

    .lame-home-reviews__nav--next {
      right: -0.75rem;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-home-reviews {
      padding-block-start: max(var(--padding-block-start, 36px), 2.25rem);
      padding-block-end: max(var(--padding-block-end, 36px), 2.5rem);
    }

    .lame-home-reviews__carousel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "cards cards"
        "prev next";
      row-gap: 1rem;
      margin-top: 1.25rem;
    }

    .lame-home-reviews__grid {
      grid-area: cards;
      gap: 0.85rem;
      padding-bottom: 0.5rem;
    }

    .lame-home-reviews__card {
      flex-basis: calc(85% - 0.5rem);
      height: 240px;
      min-height: 240px;
      max-height: 240px;
      padding: 1.25rem 1.15rem 1rem;
    }

    .lame-home-reviews__card.is-expanded {
      height: auto;
      max-height: 900px;
    }

    .lame-home-reviews__nav {
      position: static;
      transform: none;
      width: 2.5rem;
      height: 2.5rem;
    }

    .lame-home-reviews__nav:hover:not(.is-ended):not([aria-disabled="true"]) {
      transform: scale(1.05);
    }

    .lame-home-reviews__nav:active:not(.is-ended):not([aria-disabled="true"]) {
      transform: scale(0.95);
    }

    .lame-home-reviews__nav--prev {
      grid-area: prev;
      justify-self: start;
      margin-inline-start: 0.25rem;
    }

    .lame-home-reviews__nav--next {
      grid-area: next;
      justify-self: end;
      margin-inline-end: 0.25rem;
    }
  }

  .lame-home-reviews__card.is-editing {
    border-color: rgb(45 74 34 / 0.45);
    box-shadow: 0 0 0 2px rgba(45, 74, 34, 0.2);
  }

  .lame-home-reviews__edit,
  .lame-home-reviews__remove {
    all: unset;
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 999px;
    color: rgb(var(--color-foreground-rgb) / 0.38);
    cursor: pointer;
    box-sizing: border-box;
  }

  .lame-home-reviews__edit svg,
  .lame-home-reviews__remove svg {
    width: 15px;
    height: 15px;
    overflow: visible;
  }

  .lame-home-reviews__edit svg path,
  .lame-home-reviews__remove svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.35;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lame-home-reviews__edit:hover,
  .lame-home-reviews__remove:hover {
    color: rgb(var(--color-foreground-rgb) / 0.72);
    background: rgb(var(--color-foreground-rgb) / 0.05);
  }

  .lame-home-reviews__edit:focus-visible,
  .lame-home-reviews__remove:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb) / 0.28);
    outline-offset: 1px;
  }

  .lame-home-reviews__byline span,
  .lame-home-reviews__byline a {
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.58);
    text-decoration: none;
  }

  .lame-home-reviews__compose {
    width: 100%;
    max-width: 100%;
    margin: 0;
  }

  .lame-home-reviews__form,
  .lame-home-reviews__login-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem 1.35rem 1.35rem;
    border: 1px solid rgba(45, 74, 34, 0.12);
    border-radius: 20px;
    background: #ffffff;
    box-shadow: 0 8px 24px -6px rgba(28, 48, 20, 0.06);
    box-sizing: border-box;
    width: 100%;
  }

  .lame-home-reviews__form-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 0.2rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(45, 74, 34, 0.08);
  }

  .lame-home-reviews__form-title {
    margin: 0;
    text-align: left;
    font-family: var(--lame-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #1a2c16;
    text-transform: none;
  }

  .lame-home-reviews__form-as {
    margin: 0;
    text-align: left;
    font-size: 0.8rem;
    color: #556250;
  }

  .lame-home-reviews__stars-input {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-inline-size: 0;
    margin: 0;
    padding: 0.15rem 0;
    border: 0;
  }

  .lame-home-reviews__stars-input legend {
    float: none;
    width: auto;
    margin: 0;
    padding: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    color: #1c1c1c;
  }

  .lame-home-reviews__stars-row {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
  }

  .lame-home-reviews__stars-row input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .lame-home-reviews__stars-row label {
    cursor: pointer;
    font-size: 1.45rem;
    line-height: 1;
    color: #e4e4e4;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .lame-home-reviews__stars-row label:hover {
    transform: scale(1.15);
  }

  .lame-home-reviews__stars-row input:checked ~ label,
  .lame-home-reviews__stars-row label:hover,
  .lame-home-reviews__stars-row label:hover ~ label {
    color: #f5a623;
  }

  .lame-home-reviews__stars-row input:focus-visible + label {
    outline: 2px solid #2d4a22;
    outline-offset: 3px;
    border-radius: 4px;
  }

  .lame-home-reviews__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lame-home-reviews__field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .lame-home-reviews__field span {
    font-size: 0.76rem;
    font-weight: 600;
    color: #2d4a22;
    letter-spacing: 0.02em;
  }

  .lame-home-reviews__field input {
    width: 100%;
    margin: 0;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(45, 74, 34, 0.14);
    border-radius: 10px;
    background: #fafcf9;
    color: #1c1c1c;
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.4;
    box-shadow: none;
    appearance: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .lame-home-reviews__field textarea {
    width: 100%;
    margin: 0;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(45, 74, 34, 0.14);
    border-radius: 10px;
    background: #fafcf9;
    color: #1c1c1c;
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.4;
    box-shadow: none;
    appearance: none;
    min-height: 4.85rem;
    resize: vertical;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .lame-home-reviews__field input:focus,
  .lame-home-reviews__field textarea:focus {
    outline: none;
    border-color: #2d4a22;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(45, 74, 34, 0.1);
  }

  .lame-home-reviews__submit,
  .lame-home-reviews__login {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.65rem;
    padding: 0.65rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: #2d4a22;
    color: #ffffff;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(45, 74, 34, 0.22);
    transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .lame-home-reviews__submit:hover,
  .lame-home-reviews__login:hover {
    background: #1e3317;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(45, 74, 34, 0.32);
  }

  .lame-home-reviews__submit:active,
  .lame-home-reviews__login:active {
    transform: translateY(0);
  }

  .lame-home-reviews__form-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.55rem;
    margin-top: 0.15rem;
  }

  .lame-home-reviews__cancel {
    align-self: center;
    padding: 0.15rem 0.4rem;
    border: 0;
    background: transparent;
    color: rgb(var(--color-foreground-rgb) / 0.5);
    font: inherit;
    font-size: 0.84rem;
    cursor: pointer;
  }

  .lame-home-reviews__cancel:hover {
    color: rgb(var(--color-foreground-rgb) / 0.82);
  }

  .lame-home-reviews__cancel[hidden] {
    display: none;
  }

  .lame-home-reviews__login {
    width: 100%;
    max-width: 18rem;
    margin-inline: auto;
  }

  .lame-home-reviews__submit:hover,
  .lame-home-reviews__login:hover {
    background: #243c1b;
  }

  .lame-home-reviews__submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .lame-home-reviews__form-status {
    min-height: 1.2em;
    margin: 0;
    text-align: center;
    font-size: 0.86rem;
    color: #6b6460;
  }

  .lame-home-reviews__form-status[data-state='success'] {
    color: #2d4a22;
  }

  .lame-home-reviews__form-status[data-state='error'] {
    color: #9b2c2c;
  }

  .lame-product-rating-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.6rem;
    margin: 0 0 0.75rem;
  }

  .lame-product-rating-line__stars {
    position: relative;
    display: inline-block;
    font-size: 1rem;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .lame-product-rating-line__base {
    color: #e4e4e4;
  }

  .lame-product-rating-line__fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc((var(--lame-rating) / 5) * 100%);
    overflow: hidden;
    color: #f5a623;
    white-space: nowrap;
  }

  .lame-product-rating-line__text {
    font-size: 0.86rem;
    color: rgb(var(--color-foreground-rgb) / 0.72);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer reviews",
  "tag": "section",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shoppers rate My Lamstone"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show star summary",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Use real customer reviews only. Google shows stars on product results when a product has genuine reviews. It does not show stars for a store rating written about itself."
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Review title"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Reviewer name"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date (YYYY-MM-DD)",
          "info": "Google uses this date. Example: 2026-08-21"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "Shown under the name, such as a city."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Related product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
