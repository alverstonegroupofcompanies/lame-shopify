<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-category-pills lame-luxury-glow-root"
  {{ section.shopify_attributes }}
>
  <div class="lame-category-pills__wrap lame-luxury-glow spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank %}
      <h2 class="lame-category-pills__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="lame-category-pills__scroll" role="navigation" aria-label="{{ section.settings.nav_label | escape }}">
      <ul class="lame-category-pills__list" role="list">
        {% for block in section.blocks %}
          {% liquid
            assign cat = block.settings.collection
            assign label = block.settings.label
            if label == blank and cat != blank
              assign label = cat.title
            endif
            if label == blank
              assign label = 'Category'
            endif

            assign href = block.settings.link
            if href == blank and cat != blank
              assign href = cat.url
            endif
            if href == blank
              assign href = routes.collections_url
            endif

            assign is_active = false
            if cat != blank and collection.handle == cat.handle
              assign is_active = true
            endif
          %}
          <li class="lame-category-pills__item" {{ block.shopify_attributes }}>
            <a
              href="{{ href }}"
              class="lame-category-pills__pill{% if is_active %} is-active{% endif %}"
              {% if is_active %}
                aria-current="page"
              {% endif %}
            >
              {{ label | escape }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-category-pills__wrap {
    position: relative;
    padding-inline: var(--page-margin);
  }

  .lame-category-pills__heading {
    margin: 0 0 1rem;
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-category-pills__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
    padding-bottom: 4px;
    margin-inline: calc(var(--page-margin) * -1);
    padding-inline: var(--page-margin);
  }

  .lame-category-pills__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.65rem;
    width: max-content;
    min-width: 100%;
    justify-content: safe center;
  }

  .lame-category-pills__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .lame-category-pills__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.65rem;
    padding: 0.45rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(var(--color-foreground-rgb) / 0.82);
    background: rgb(var(--color-background-rgb) / 0.72);
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.08);
    border-radius: 999px;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.05);
    backdrop-filter: blur(12px);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease,
      border-color 0.25s ease,
      color 0.25s ease,
      background 0.25s ease;
  }

  .lame-category-pills__pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.09);
    border-color: rgb(var(--color-primary-rgb) / 0.28);
    color: rgb(var(--color-foreground-heading-rgb));
  }

  .lame-category-pills__pill.is-active {
    color: rgb(var(--color-background-rgb));
    background: rgb(var(--color-foreground-rgb));
    border-color: rgb(var(--color-foreground-rgb));
    box-shadow: 0 10px 26px rgb(0 0 0 / 0.12);
  }

  .lame-category-pills__pill.is-active:hover {
    transform: translateY(-2px);
  }

  @media screen and (min-width: 990px) {
    .lame-category-pills__list {
      justify-content: center;
      flex-wrap: wrap;
      width: auto;
      min-width: 0;
      gap: 0.85rem;
    }

    .lame-category-pills__scroll {
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      scroll-snap-type: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Horizontal category navigation. Link each pill to a collection (or a manual URL). The pill highlights when its collection matches the current page."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "nav_label",
      "label": "Accessibility label",
      "default": "Product categories"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-golden"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override",
          "info": "Leave blank to use the collection title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link",
          "info": "Overrides collection URL when set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category pills",
      "category": "Navigation",
      "blocks": [
        { "type": "category", "settings": { "label": "Skincare" } },
        { "type": "category", "settings": { "label": "Haircare" } },
        { "type": "category", "settings": { "label": "Body care" } },
        { "type": "category", "settings": { "label": "Serums" } },
        { "type": "category", "settings": { "label": "Face wash" } },
        { "type": "category", "settings": { "label": "Lip care" } }
      ]
    }
  ]
}
{% endschema %}
