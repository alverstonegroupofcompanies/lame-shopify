    background: 
      linear-gradient(to right, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.65) 42%, rgba(0, 0, 0, 0.25) 75%, rgba(0, 0, 0, 0.6) 100%),
      linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.2) 35%, transparent 60%),
