                  <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="8" width="16" height="11" rx="1" stroke="currentColor" stroke-width="1.2"/><path d="M8 8V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.2"/></svg>
                {% when 'crafted' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 4 5 8v5c0 4.2 3 7.8 7 8.5 4-.7 7-4.3 7-8.5V8l-7-4Z" stroke="currentColor" stroke-width="1.2"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M8 6h8l1 12H7L8 6Z" stroke="currentColor" stroke-width="1.2"/><path d="M10 6V4.5A2 2 0 0 1 14 4.5V6" stroke="currentColor" stroke-width="1.2"/></svg>
