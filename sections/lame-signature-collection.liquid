      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Product name",
          "default": "Product name",
          "info": "Shown on the card overlay. Each block is listed by this name in the sidebar."
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Theme asset image",
          "info": "Optional. Filename in theme assets/ (e.g. lame-coming-soon-derma-polish.png). Used when no image is picked above."
        },
        { "type": "text", "id": "brand", "label": "Brand", "default": "LAMÉ" },
        {
          "type": "text",
          "id": "category",
          "label": "Category tag",
          "default": "Fragrance",
          "info": "Shown on coming soon cards (e.g. Fragrance, Skincare)."
        },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "text", "id": "scent_notes", "label": "Scent notes", "default": "FLORAL • FRUITY • MUSK" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Luxury Perfumes" },
        { "type": "text", "id": "explore_label", "label": "Explore label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "value",
      "name": "Brand value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ingredients", "label": "Ingredients" },
            { "value": "lasting", "label": "Long lasting" },
            { "value": "packaging", "label": "Packaging" },
            { "value": "crafted", "label": "Crafted" }
          ],
          "default": "ingredients"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Premium ingredients" },
        { "type": "text", "id": "text", "label": "Text", "default": "Finest oils from around the world" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Signature collection",
      "blocks": [
        {
          "type": "product",
