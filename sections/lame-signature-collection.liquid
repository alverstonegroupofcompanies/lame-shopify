    gap: 0.35rem;
    padding: 0.38rem 0.75rem;
    border-radius: 999px;
    background: rgba(13, 22, 15, 0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #fff;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }

  .lame-signature__reel-sound-btn:hover {
    background: rgba(45, 74, 34, 0.9);
    border-color: rgba(212, 175, 55, 0.6);
  }

  .lame-signature__reel-sound-btn.is-unmuted {
    border-color: rgba(212, 175, 55, 0.75);
    background: rgba(45, 74, 34, 0.92);
    color: #f3e5ab;
  }

  .lame-signature__reel-sound-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .lame-signature__reel-sound-icon svg {
    width: 100%;
    height: 100%;
  }

  .lame-signature__reel-sound-icon--unmuted {
    display: none;
  }

  .lame-signature__reel-sound-btn.is-unmuted .lame-signature__reel-sound-icon--muted {
    display: none;
  }

  .lame-signature__reel-sound-btn.is-unmuted .lame-signature__reel-sound-icon--unmuted {
    display: inline-flex;
  }

  .lame-signature__reel-footer-caption {
    position: absolute;
    inset-block-end: 1.25rem;
    inset-inline-start: 1.25rem;
    inset-inline-end: 1.25rem;
    z-index: 3;
    pointer-events: none;
  }

  .lame-signature__reel-caption-brand {
    margin: 0 0 0.2rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #d4af37;
  }

  .lame-signature__reel-caption-title {
    margin: 0;
    font-family: var(--lame-font-display, 'Cormorant Garamond', serif);
    font-size: 1.35rem;
    font-weight: 500;
    color: #ffffff;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  /* =========================================================================
     BARQAT PRODUCT SPOTLIGHT CARD (RIGHT COLUMN)
     ========================================================================= */
  .lame-signature__barqat-col {
    display: flex;
    width: 100%;
    height: 100%;
  }

  .lame-signature__barqat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(145deg, #fbfcf9 0%, #edf3ec 60%, #e3ece1 100%);
    border: 1.5px solid rgba(45, 74, 34, 0.16);
    box-shadow:
      0 18px 45px -12px rgba(45, 74, 34, 0.14),
      0 0 30px rgba(212, 175, 55, 0.08);
    box-sizing: border-box;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    cursor: pointer;
  }

  .lame-signature__barqat-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 55, 0.65);
    box-shadow:
      0 26px 60px -14px rgba(45, 74, 34, 0.24),
      0 0 45px rgba(212, 175, 55, 0.22);
  }

  @media (max-width: 989px) {
    .lame-signature__barqat-col {
      height: auto;
    }

    .lame-signature__barqat-card {
      height: auto;
      min-height: 0;
    }
  }

  .lame-signature__barqat-glow {
    position: absolute;
    inset-block-start: -20%;
    inset-inline-end: -20%;
    width: 60%;
    height: 60%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.18) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .lame-signature__barqat-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    gap: 2.25rem;
    align-items: center;
    padding: 2.5rem;
    height: 100%;
    box-sizing: border-box;
  }

  @media (max-width: 1199px) and (min-width: 990px) {
    .lame-signature__barqat-inner {
      grid-template-columns: 240px 1fr;
      gap: 1.75rem;
      padding: 2rem;
    }
  }

  @media (max-width: 989px) {
    .lame-signature__barqat-inner {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 1.75rem;
    }
  }

  /* Product Media Frame with Zoom effect */
  .lame-signature__barqat-media {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .lame-signature__barqat-badge-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-block-end: 0.85rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .lame-signature__barqat-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.32rem 0.75rem;
    border-radius: 999px;
    background: rgba(45, 74, 34, 0.12);
    color: #2d4a22;
    border: 1px solid rgba(45, 74, 34, 0.2);
  }

  .lame-signature__barqat-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
  }

  .lame-signature__barqat-stars {
    color: #d4af37;
    letter-spacing: 0.1em;
  }

  .lame-signature__barqat-score {
    font-weight: 600;
    color: #4a6341;
  }

  .lame-signature__barqat-img-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 420px;
    border-radius: 22px;
    background: radial-gradient(circle at 50% 50%, rgba(212, 175, 55, 0.22) 0%, rgba(45, 74, 34, 0.06) 65%, transparent 85%);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1rem;
    box-sizing: border-box;
  }

  .lame-signature__barqat-image {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    filter: drop-shadow(0 16px 26px rgba(25, 45, 20, 0.24));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    animation: lameBarqatFloat 6s ease-in-out infinite;
  }

  .lame-signature__barqat-card:hover .lame-signature__barqat-image {
    transform: scale(1.08) rotate(-1.5deg);
  }

  @keyframes lameBarqatFloat {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-6px) scale(1.02); }
  }

  /* Product Information & Details */
  .lame-signature__barqat-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .lame-signature__barqat-brand {
    margin: 0 0 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #2d4a22;
  }

  .lame-signature__barqat-title {
    margin: 0 0 0.25rem;
    font-family: var(--lame-font-display, 'Cormorant Garamond', serif);
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    font-weight: 600;
    color: #1a3014;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .lame-signature__barqat-subtitle {
    margin: 0 0 1rem;
    font-size: 0.88rem;
    font-weight: 500;
    color: #55704a;
    letter-spacing: 0.06em;
  }

  .lame-signature__barqat-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-block-end: 1.25rem;
  }

  .lame-signature__barqat-price {
    font-family: var(--lame-font-display, 'Cormorant Garamond', serif);
    font-size: 1.85rem;
    font-weight: 700;
    color: #1a3014;
  }

  .lame-signature__barqat-compare {
    font-size: 1.1rem;
    text-decoration: line-through;
    color: #889980;
  }

  .lame-signature__barqat-tax-pill {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(45, 74, 34, 0.08);
    color: #2d4a22;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .lame-signature__barqat-notes-wrap {
    margin-block-end: 1.25rem;
  }

  .lame-signature__barqat-note-label {
    display: block;
    margin-block-end: 0.45rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7b9470;
  }

  .lame-signature__barqat-note-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .lame-signature__barqat-note-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(212, 175, 55, 0.38);
    font-size: 0.75rem;
    font-weight: 500;
    color: #2d4a22;
    box-shadow: 0 2px 6px rgba(45, 74, 34, 0.04);
  }

  .lame-signature__note-icon {
    font-size: 0.85rem;
  }

  .lame-signature__barqat-desc {
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: #3b5233;
  }

  .lame-signature__barqat-cta-row {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-wrap: wrap;
    margin-block-end: 1.5rem;
  }

  .lame-signature__barqat-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.88rem 1.95rem;
    border-radius: 999px;
    background: #2d4a22;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    box-shadow: 0 6px 20px rgba(45, 74, 34, 0.28);
    transition: all 0.3s ease;
  }

  .lame-signature__barqat-card:hover .lame-signature__barqat-btn {
    background: #233b1a;
    box-shadow: 0 8px 24px rgba(45, 74, 34, 0.38);
  }

  .lame-signature__barqat-btn-arrow {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .lame-signature__barqat-card:hover .lame-signature__barqat-btn-arrow {
    transform: translateX(4px);
  }

  .lame-signature__barqat-click-hint {
    font-size: 0.75rem;
    color: #5d7753;
    font-style: italic;
  }

  .lame-signature__barqat-trust {
    display: flex;
    gap: 1.35rem;
    flex-wrap: wrap;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgba(45, 74, 34, 0.12);
  }

  .lame-signature__trust-item {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    color: #456139;
    font-weight: 500;
  }

  .lame-signature__trust-item svg {
    width: 15px;
    height: 15px;
    stroke: #2d4a22;
    flex-shrink: 0;
  }
{% endstylesheet %}

