<script>
  (() => {
    function initCinematicSlider(slider) {
      if (!slider) return;

      const video = slider.querySelector('[data-cinematic-bg-video]');
      const soundToggleBtn = slider.querySelector('[data-cinematic-sound-toggle]');
      const fullscreenBtn = slider.querySelector('[data-cinematic-fullscreen-toggle]');

      const heroEyebrow = slider.querySelector('[data-hero-eyebrow]');
      const heroTitle = slider.querySelector('[data-hero-title]');
      const heroDesc = slider.querySelector('[data-hero-desc]');
      const heroLink = slider.querySelector('[data-hero-link]');
      const heroBtnText = slider.querySelector('[data-hero-btn-text]');

      const viewport = slider.querySelector('[data-cinematic-viewport]');
      const track = slider.querySelector('[data-cinematic-track]');
      const cards = slider.querySelectorAll('[data-cinematic-card]');
      const prevBtn = slider.querySelector('[data-cinematic-prev]');
      const nextBtn = slider.querySelector('[data-cinematic-next]');
      const progressBar = slider.querySelector('[data-cinematic-progress-bar]');
      const counter = slider.querySelector('[data-cinematic-counter]');

      let currentIndex = 0;

      // Video Controls & Autoplay Guarantee (Strictly Muted by Default)
      if (video) {
        video.muted = true;
        video.defaultMuted = true;
        video.setAttribute('muted', '');

        const playVideo = () => {
          if (video.paused) {
            const p = video.play();
            if (p && typeof p.catch === 'function') p.catch(() => {});
          }
        };
        playVideo();
        video.addEventListener('loadeddata', playVideo, { once: true });
        video.addEventListener('canplay', playVideo, { once: true });

        ['touchstart', 'click', 'keydown', 'scroll'].forEach((evt) => {
          window.addEventListener(evt, playVideo, { once: true, passive: true });
        });

        // Sound Toggle Controller
        if (soundToggleBtn) {
          const soundOnIcon = soundToggleBtn.querySelector('.icon-sound-on');
          const soundOffIcon = soundToggleBtn.querySelector('.icon-sound-off');

          const updateSoundState = () => {
            const isMuted = video.muted;
            if (soundOnIcon) soundOnIcon.style.display = isMuted ? 'none' : '';
            if (soundOffIcon) soundOffIcon.style.display = isMuted ? '' : 'none';
          };

          soundToggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (video.muted) {
              video.muted = false;
              video.defaultMuted = false;
              video.removeAttribute('muted');
              video.volume = 1.0;
              const p = video.play();
              if (p && typeof p.catch === 'function') p.catch(() => {});
            } else {
              video.muted = true;
              video.defaultMuted = true;
              video.setAttribute('muted', '');
            }
            updateSoundState();
          });

          updateSoundState();
        }

        // Fullscreen Toggle Controller
        if (fullscreenBtn) {
          const enterIcon = fullscreenBtn.querySelector('.icon-fullscreen-enter');
          const exitIcon = fullscreenBtn.querySelector('.icon-fullscreen-exit');

          const updateFullscreenIcon = () => {
            const isFull = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);
            if (enterIcon) enterIcon.style.display = isFull ? 'none' : '';
            if (exitIcon) exitIcon.style.display = isFull ? '' : 'none';
          };

          fullscreenBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            // iOS Safari Native Fullscreen
            if (typeof video.webkitEnterFullscreen === 'function' && !document.fullscreenEnabled) {
              video.muted = false;
              video.defaultMuted = false;
              video.removeAttribute('muted');
              video.volume = 1.0;
              video.webkitEnterFullscreen();
              return;
            }

            const isFull = !!(document.fullscreenElement || document.webkitFullscreenElement || document.mozFullScreenElement || document.msFullscreenElement);

            if (!isFull) {
              // Unmute when playing fullscreen for rich immersion
              if (video.muted) {
                video.muted = false;
                video.defaultMuted = false;
                video.removeAttribute('muted');
                video.volume = 1.0;
                if (soundToggleBtn) {
                  const soundOnIcon = soundToggleBtn.querySelector('.icon-sound-on');
                  const soundOffIcon = soundToggleBtn.querySelector('.icon-sound-off');
                  if (soundOnIcon) soundOnIcon.style.display = '';
                  if (soundOffIcon) soundOffIcon.style.display = 'none';
                }
              }

              const target = video || slider;
              if (target.requestFullscreen) {
                target.requestFullscreen().catch(() => slider.requestFullscreen().catch(() => {}));
              } else if (target.webkitRequestFullscreen) {
                target.webkitRequestFullscreen();
              } else if (target.msRequestFullscreen) {
                target.msRequestFullscreen();
              }
            } else {
              if (document.exitFullscreen) {
                document.exitFullscreen().catch(() => {});
              } else if (document.webkitExitFullscreen) {
                document.webkitExitFullscreen();
              } else if (document.msExitFullscreen) {
                document.msExitFullscreen();
              }
            }
          });

          document.addEventListener('fullscreenchange', updateFullscreenIcon);
          document.addEventListener('webkitfullscreenchange', updateFullscreenIcon);
          document.addEventListener('mozfullscreenchange', updateFullscreenIcon);
          document.addEventListener('MSFullscreenChange', updateFullscreenIcon);
        }
      }

      // Card Slider & Hero update
      const activateCard = (idx, shouldScroll = true) => {
        if (!cards.length) return;
        currentIndex = (idx + cards.length) % cards.length;
        const activeCard = cards[currentIndex];
        if (!activeCard) return;

        cards.forEach((card, i) => {
          card.classList.toggle('is-active', i === currentIndex);
          card.setAttribute('aria-selected', i === currentIndex ? 'true' : 'false');
        });

        // Update Hero Details with subtle transition
        if (heroEyebrow && activeCard.dataset.eyebrow) {
          heroEyebrow.textContent = activeCard.dataset.eyebrow.replace(/^—\s*/, '');
        }
        if (heroTitle && activeCard.dataset.title) {
          heroTitle.style.opacity = '0';
          heroTitle.style.transform = 'translateY(6px)';
          setTimeout(() => {
            heroTitle.textContent = activeCard.dataset.title;
            heroTitle.style.opacity = '1';
            heroTitle.style.transform = 'translateY(0)';
          }, 140);
        }
        if (heroDesc && activeCard.dataset.desc) {
          heroDesc.style.opacity = '0';
          setTimeout(() => {
            heroDesc.textContent = activeCard.dataset.desc;
            heroDesc.style.opacity = '1';
          }, 140);
        }
        if (heroLink && activeCard.dataset.link) {
          heroLink.href = activeCard.dataset.link;
        }
        if (heroBtnText && activeCard.dataset.btn) {
          heroBtnText.textContent = activeCard.dataset.btn;
        }

        // Switch custom video if specified for this card
        if (video && activeCard.dataset.video) {
          const newSrc = activeCard.dataset.video;
          if (video.currentSrc !== newSrc) {
            video.src = newSrc;
            video.load();
            video.play().catch(() => {});
          }
        }

        // Update Counter (2 digits: 01, 02, etc.)
        if (counter) {
          counter.textContent = String(currentIndex + 1).padStart(2, '0');
        }

        // Update Progress Bar
        if (progressBar) {
          const percent = ((currentIndex + 1) / cards.length) * 100;
          progressBar.style.width = `${percent}%`;
        }

        // Scroll track to active card
        if (shouldScroll && viewport && activeCard) {
          const offset = activeCard.offsetLeft - viewport.offsetLeft - 16;
          viewport.scrollTo({ left: Math.max(0, offset), behavior: 'smooth' });
        }
      };

      cards.forEach((card, idx) => {
        card.addEventListener('click', () => activateCard(idx, true));
        card.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateCard(idx, true);
          }
        });
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          activateCard(currentIndex - 1, true);
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          activateCard(currentIndex + 1, true);
        });
      }

      const bookmarkBtn = slider.querySelector('[data-cinematic-bookmark]');
      if (bookmarkBtn) {
        bookmarkBtn.addEventListener('click', (e) => {
          e.preventDefault();
          bookmarkBtn.classList.toggle('is-saved');
        });
      }

      // Sync active card on manual touch/wheel scroll
      let scrollTimeout;
      if (viewport) {
        viewport.addEventListener('scroll', () => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            const scrollPos = viewport.scrollLeft;
            let closestIdx = 0;
            let minDiff = Infinity;
            cards.forEach((c, i) => {
              const diff = Math.abs((c.offsetLeft - viewport.offsetLeft) - scrollPos);
              if (diff < minDiff) {
                minDiff = diff;
                closestIdx = i;
              }
            });
            if (closestIdx !== currentIndex) {
              activateCard(closestIdx, false);
            }
          }, 120);
        }, { passive: true });
      }

      // Initialize initial state
      activateCard(0, false);

      // Listen for Shopify Block selection
      document.addEventListener('shopify:block:select', (e) => {
        if (!slider.contains(e.target)) return;
        const targetCard = e.target.closest('[data-cinematic-card]');
        if (targetCard) {
          const idx = parseInt(targetCard.dataset.index, 10);
          if (!isNaN(idx)) activateCard(idx, true);
        }
      });
    }

    function initSignature(section) {
      if (!section) return;

      // Initialize Cinematic Slider if present
      const cinematicSlider = section.querySelector('[data-cinematic-slider]');
      if (cinematicSlider) {
        initCinematicSlider(cinematicSlider);
      }

      // IntersectionObserver for reveal elements
      const revealNodes = section.querySelectorAll('[data-lame-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        revealNodes.forEach((node) => observer.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add('is-visible'));
      }

      // Background Video Autoplay Guarantee
      const bgVideo = section.querySelector('[data-lame-bg-video], .lame-signature__bg-video');
      if (bgVideo && bgVideo.tagName === 'VIDEO') {
        bgVideo.muted = true;
        bgVideo.defaultMuted = true;
        bgVideo.setAttribute('muted', '');
        bgVideo.setAttribute('playsinline', '');
        bgVideo.setAttribute('webkit-playsinline', '');
        const playBg = () => {
          if (bgVideo.paused) {
            const p = bgVideo.play();
            if (p && typeof p.catch === 'function') p.catch(() => {});
          }
        };
        playBg();
        bgVideo.addEventListener('loadeddata', playBg, { once: true });
        bgVideo.addEventListener('canplay', playBg, { once: true });
        ['scroll', 'touchstart', 'click', 'keydown', 'mousemove'].forEach((evt) => {
          window.addEventListener(evt, playBg, { once: true, passive: true });
        });
        document.addEventListener('visibilitychange', () => {
          if (!document.hidden) playBg();
        });
      }

      // Video Reel Modal & Play Trigger
      const modal = section.querySelector('[data-lame-video-modal]');
      const openTriggers = section.querySelectorAll('[data-lame-video-modal-open]');
      const closeTriggers = section.querySelectorAll('[data-lame-video-modal-close]');

      if (modal) {
        const modalVideo = modal.querySelector('video');
        const modalIframe = modal.querySelector('iframe');

        const openModal = () => {
          modal.classList.add('is-open');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';

          if (modalVideo) {
            modalVideo.currentTime = 0;
            modalVideo.play().catch(() => {});
          } else if (modalIframe && modalIframe.dataset.src && !modalIframe.src) {
            modalIframe.src = modalIframe.dataset.src;
          }
        };

        const closeModal = () => {
          modal.classList.remove('is-open');
          modal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';

          if (modalVideo) {
            modalVideo.pause();
          } else if (modalIframe && modalIframe.src) {
            const src = modalIframe.src;
            modalIframe.src = '';
            modalIframe.dataset.src = src;
          }
        };

        openTriggers.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openModal();
          });
        });

        closeTriggers.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            closeModal();
          });
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && modal.classList.contains('is-open')) {
            closeModal();
          }
        });
      }

      const track = section.querySelector('[data-signature-track]');
      const slides = section.querySelectorAll('[data-signature-slide]');
      const dotsWrap = section.querySelector('[data-signature-dots]');
      const prev = section.querySelector('[data-signature-prev]');
      const next = section.querySelector('[data-signature-next]');
      if (!track || !slides.length) return;

      let activeIndex = 0;
      let dots = [];

      const getSlidesPerView = () => {
        const isShowcase = section.querySelector('.lame-signature__card--showcase');
        if (isShowcase) {
          if (window.matchMedia('(min-width: 1100px)').matches) return 3;
          if (window.matchMedia('(min-width: 750px)').matches) return 2;
          return 1;
        }
        if (window.matchMedia('(min-width: 990px)').matches) return 3;
        if (window.matchMedia('(min-width: 750px)').matches) return 2;
        return 1;
      };

      const getPageCount = () => {
        const perView = getSlidesPerView();
        return Math.max(1, Math.ceil(slides.length / perView));
      };

      const buildDots = () => {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        dots = [];
        const count = getPageCount();
        for (let i = 0; i < count; i += 1) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'lame-signature__dot';
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', `Slide ${i + 1}`);
          dot.onclick = () => goToPage(i);
          dotsWrap.appendChild(dot);
          dots.push(dot);
        }
      };

      const updateDots = () => {
        dots.forEach((dot, i) => {
          const isActive = i === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      };

      const goToPage = (pageIndex) => {
        const perView = getSlidesPerView();
        const maxPage = getPageCount() - 1;
        activeIndex = Math.min(Math.max(pageIndex, 0), maxPage);
        const targetSlide = slides[activeIndex * perView];
        if (!targetSlide) return;
        const offset = targetSlide.offsetLeft - track.offsetLeft;
        track.scrollTo({ left: offset, behavior: 'smooth' });
        updateDots();
        updateArrows();
      };

      const updateArrows = () => {
        const maxPage = getPageCount() - 1;
        if (prev) prev.disabled = activeIndex <= 0;
        if (next) next.disabled = activeIndex >= maxPage;
      };

      const syncFromScroll = () => {
        const perView = getSlidesPerView();
        const slideWidth = slides[0]?.offsetWidth || 1;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0');
        const approx = Math.round(track.scrollLeft / (slideWidth + gap));
        activeIndex = Math.min(Math.max(Math.floor(approx / perView), 0), getPageCount() - 1);
        updateDots();
        updateArrows();
      };

      buildDots();
      updateDots();
      updateArrows();

      if (prev) prev.onclick = () => goToPage(activeIndex - 1);
      if (next) next.onclick = () => goToPage(activeIndex + 1);
      track.onscroll = syncFromScroll;
    }

    const currentSection = document.getElementById('shopify-section-{{ section.id }}');
    if (currentSection) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initSignature(currentSection));
      } else {
        initSignature(currentSection);
      }
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target && e.target.id === 'shopify-section-{{ section.id }}') {
        initSignature(e.target);
      }
    });
  })();
</script>

