    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 9999px;
    padding: 0.4rem 1.15rem;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
  }

  .lame-signature__cinematic-badge-icon {
    display: inline-flex;
    align-items: center;
    color: #f37021;
    margin-right: 0.15rem;
    flex-shrink: 0;
  }

  .lame-signature__cinematic-badge-icon svg {
    width: 13px;
    height: 13px;
    display: block;
  }

  .lame-signature__cinematic-badge-kicker {
    color: #f37021;
  }

  .lame-signature__cinematic-badge-sep {
    opacity: 0.4;
    font-size: 0.65rem;
  }

  .lame-signature__cinematic-badge-title {
    color: #ffffff;
  }

  .lame-signature__cinematic-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .lame-signature__cinematic-view-all:hover {
    color: #f37021;
    transform: translateX(3px);
  }

  .lame-signature__cinematic-view-all-text--mobile {
    display: none;
  }

  /* Interactive Stage (Hero on left, Cards slider on right) */
  .lame-signature__cinematic-stage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(320px, 1.05fr) minmax(340px, 1.45fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4.5vw, 4rem);
  }

  /* LEFT HERO STORY */
  .lame-signature__cinematic-hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 580px;
    min-width: 0;
  }

  .lame-signature__cinematic-eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
    font-size: clamp(0.78rem, 1.1vw, 0.95rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .lame-signature__cinematic-dash {
    color: #f37021;
    font-weight: 700;
  }

  .lame-signature__cinematic-title {
    margin: 0 0 1.15rem;
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: clamp(3.2rem, 6.8vw, 6.2rem);
    line-height: 0.94;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.7);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .lame-signature__cinematic-desc {
    margin: 0 0 1.85rem;
    font-size: clamp(0.9rem, 1.1vw, 1.02rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    max-width: 480px;
    font-weight: 400;
    transition: opacity 0.25s ease;
  }

  .lame-signature__cinematic-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .lame-signature__cinematic-btn-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #f37021;
    border: none;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(243, 112, 33, 0.45);
    transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    flex-shrink: 0;
  }

  .lame-signature__cinematic-btn-icon:hover {
    transform: scale(1.08);
    box-shadow: 0 10px 28px rgba(243, 112, 33, 0.65);
    background: #ff7d33;
  }

  .lame-signature__cinematic-btn-icon.is-saved {
    background: #ffffff;
    color: #f37021;
    box-shadow: 0 10px 28px rgba(255, 255, 255, 0.45);
  }

  .lame-signature__cinematic-btn-icon svg {
    width: 22px;
    height: 22px;
  }

  .lame-signature__cinematic-btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 2rem;
    height: 52px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease, color 0.25s ease;
  }

  .lame-signature__cinematic-btn-cta:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #121212;
    transform: translateY(-2px);
  }

  /* RIGHT CARDS SLIDER */
  .lame-signature__cinematic-cards-wrapper {
    position: relative;
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .lame-signature__cinematic-cards-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
    padding: 0.75rem 0.25rem;
  }

  .lame-signature__cinematic-cards-viewport::-webkit-scrollbar {
    display: none;
  }

  .lame-signature__cinematic-cards-track {
    display: flex;
    gap: clamp(1rem, 1.8vw, 1.5rem);
    width: max-content;
    align-items: stretch;
  }

  /* PREVIEW CARD */
  .lame-signature__cinematic-card {
    position: relative;
    width: clamp(180px, 16vw, 240px);
    aspect-ratio: 1 / 1.44;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    background: #181c19;
    border: 1.5px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease, box-shadow 0.35s ease;
    user-select: none;
    flex-shrink: 0;
  }

  .lame-signature__cinematic-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 255, 255, 0.45);
    box-shadow: 0 22px 45px rgba(0, 0, 0, 0.6);
  }

  .lame-signature__cinematic-card.is-active {
    border-color: #f37021;
    box-shadow: 0 20px 48px rgba(243, 112, 33, 0.35), 0 0 0 2px rgba(243, 112, 33, 0.5);
    transform: translateY(-4px);
  }

  .lame-signature__cinematic-card-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lame-signature__cinematic-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lame-signature__cinematic-card:hover .lame-signature__cinematic-card-img,
  .lame-signature__cinematic-card.is-active .lame-signature__cinematic-card-img {
    transform: scale(1.05);
  }

  .lame-signature__cinematic-card-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.92) 0%, rgba(0, 0, 0, 0.45) 45%, transparent 70%);
  }

  .lame-signature__cinematic-card-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.25rem 1.15rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lame-signature__cinematic-card-cat {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    font-weight: 500;
  }

  .lame-signature__cinematic-card-title {
    margin: 0;
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: clamp(1.2rem, 1.8vw, 1.55rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #ffffff;
  }

  /* NAVIGATION ROW (ARROWS + SCRUBBER + COUNTER) */
  .lame-signature__cinematic-nav-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-inline: 0.5rem;
  }

  .lame-signature__cinematic-nav-arrows {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .lame-signature__cinematic-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .lame-signature__cinematic-nav-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.6);
    transform: scale(1.06);
  }

  .lame-signature__cinematic-nav-btn svg {
    width: 18px;
    height: 18px;
  }

  .lame-signature__cinematic-progress {
    flex: 1;
    height: 2px;
    background: rgba(255, 255, 255, 0.22);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .lame-signature__cinematic-progress-bar {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 16.6%;
    background: #f37021;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(243, 112, 33, 0.6);
    transition: width 0.35s ease;
  }

  .lame-signature__cinematic-counter {
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: 2.1rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 0.05em;
    min-width: 44px;
    text-align: right;
  }

  /* BOTTOM PLAYBACK BAR (SOUND & FULLSCREEN CONTROLS) */
  .lame-signature__cinematic-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 clamp(1.5rem, 4.5vw, 4rem) clamp(1.5rem, 3.2vw, 2.25rem);
    pointer-events: auto;
  }

  .lame-signature__cinematic-playback-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 9999px;
    padding: 0.3rem 0.55rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .lame-signature__cinematic-sound-toggle-btn,
  .lame-signature__cinematic-fullscreen-btn {
    background: none;
    border: none;
    outline: none !important;
    color: #ffffff;
    cursor: pointer;
    padding: 0.45rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: transform 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .lame-signature__cinematic-sound-toggle-btn:focus,
  .lame-signature__cinematic-sound-toggle-btn:focus-visible,
  .lame-signature__cinematic-fullscreen-btn:focus,
  .lame-signature__cinematic-fullscreen-btn:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }

  .lame-signature__cinematic-sound-toggle-btn:hover,
  .lame-signature__cinematic-fullscreen-btn:hover {
    transform: scale(1.12);
    color: #f37021;
    background: rgba(255, 255, 255, 0.12);
  }

  .lame-signature__cinematic-sound-toggle-btn svg,
  .lame-signature__cinematic-fullscreen-btn svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  /* RESPONSIVE DESIGN */
  @media (max-width: 990px) {
    .lame-signature__cinematic {
      min-height: clamp(680px, 88vh, 920px);
    }

    .lame-signature__cinematic-stage {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1 1 auto;
      gap: 2rem;
      padding-block: 1.5rem 1rem;
    }

    .lame-signature__cinematic-hero {
      max-width: 100%;
      flex-shrink: 0;
    }

    .lame-signature__cinematic-cards-wrapper {
      margin-top: auto;
      width: 100%;
    }

    .lame-signature__cinematic-card {
      width: 175px;
    }
  }

  @media (max-width: 749px) {
    .lame-signature__cinematic {
      min-height: 100svh;
      min-height: -webkit-fill-available;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .lame-signature__cinematic-topbar {
      padding-inline: 0.85rem;
      padding-top: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem;
      flex-shrink: 0;
    }

    .lame-signature__cinematic-badge {
      padding: 0.22rem 0.55rem;
      font-size: 0.56rem;
      gap: 0.3rem;
      letter-spacing: 0.05em;
      white-space: nowrap;
      flex-shrink: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.2;
    }

    .lame-signature__cinematic-badge-icon {
      margin-right: 0;
    }

    .lame-signature__cinematic-badge-icon svg {
      width: 9px;
      height: 9px;
    }

    .lame-signature__cinematic-badge-kicker {
      font-weight: 700;
    }

    .lame-signature__cinematic-badge-sep {
      font-size: 0.5rem;
      opacity: 0.5;
    }

    .lame-signature__cinematic-badge-title {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .lame-signature__cinematic-view-all {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.56rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
      flex-shrink: 0;
      padding: 0.22rem 0.55rem;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 9999px;
      line-height: 1.2;
    }

    .lame-signature__cinematic-view-all-text--desktop {
      display: none !important;
    }

    .lame-signature__cinematic-view-all-text--mobile {
      display: inline !important;
    }

    .lame-signature__cinematic-view-all-arrow {
      font-size: 0.62rem;
    }

    .lame-signature__cinematic-stage {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1 1 auto;
      width: 100%;
      box-sizing: border-box;
      padding-inline: 0.85rem;
      padding-top: 0.75rem;
      padding-bottom: 0.25rem;
      gap: 1.25rem;
    }

    .lame-signature__cinematic-hero {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-start;
      width: 100%;
      max-width: 100%;
      flex-shrink: 0;
    }

    .lame-signature__cinematic-eyebrow-wrap {
      font-size: 0.65rem;
      gap: 0.4rem;
      margin-bottom: 0.3rem;
      letter-spacing: 0.12em;
    }

    .lame-signature__cinematic-title {
      font-size: clamp(1.75rem, 7.5vw, 2.2rem);
      line-height: 1;
      margin: 0 0 0.45rem;
      letter-spacing: 0.02em;
    }

    .lame-signature__cinematic-desc {
      font-size: 0.78rem;
      line-height: 1.42;
      margin: 0 0 0.95rem;
      max-width: 95%;
      color: rgba(255, 255, 255, 0.85);
    }

    .lame-signature__cinematic-actions {
      gap: 0;
    }

    .lame-signature__cinematic-btn-icon {
      display: none !important;
    }

    .lame-signature__cinematic-btn-cta {
      height: 38px;
      padding: 0 1.4rem;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
    }

    .lame-signature__cinematic-cards-wrapper {
      margin-top: auto;
      width: 100%;
      gap: 0.65rem;
      flex-shrink: 0;
    }

    .lame-signature__cinematic-cards-viewport {
      padding: 0.25rem 0.15rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .lame-signature__cinematic-cards-track {
      gap: 0.65rem;
    }

    .lame-signature__cinematic-card {
      width: 108px;
      aspect-ratio: 1 / 1.38;
      border-radius: 12px;
    }

    .lame-signature__cinematic-card-body {
      padding: 0.5rem 0.45rem;
      gap: 0.12rem;
    }

    .lame-signature__cinematic-card-cat {
      font-size: 0.52rem;
      letter-spacing: 0.08em;
    }

    .lame-signature__cinematic-card-title {
      font-size: 0.85rem;
      line-height: 1.05;
      letter-spacing: 0.02em;
    }

    .lame-signature__cinematic-nav-row {
      gap: 0.85rem;
      padding-inline: 0.25rem;
      align-items: center;
    }

    .lame-signature__cinematic-nav-arrows {
      gap: 0.45rem;
    }

    .lame-signature__cinematic-nav-btn {
      width: 36px;
      height: 36px;
    }

    .lame-signature__cinematic-nav-btn svg {
      width: 14px;
      height: 14px;
    }

    .lame-signature__cinematic-counter {
      font-size: 1.55rem;
      min-width: 30px;
    }

    .lame-signature__cinematic-footer {
      padding-inline: 0.85rem;
      padding-top: 0.2rem;
      padding-bottom: 0.85rem;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-shrink: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Signature collection",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "reel_split", "label": "Vertical Reel & Barqat spotlight" },
        { "value": "reel_and_carousel", "label": "Vertical Reel & Barqat + Carousel" },
        { "value": "carousel", "label": "Product carousel" },
        { "value": "editorial_grid", "label": "Editorial grid (explore cards)" }
      ],
      "default": "reel_split"
    },
    {
      "type": "header",
      "content": "Vertical Reel Video (Left Column)"
    },
    {
      "type": "video",
      "id": "reel_video",
      "label": "Vertical reel video (Upload / Select from Shopify)",
      "info": "Upload an MP4/MOV or choose a video from your Shopify admin files."
    },
    {
      "type": "video_url",
      "id": "reel_video_url_external",
      "label": "Or external video link (YouTube / Vimeo)",
      "accept": ["youtube", "vimeo"],
      "info": "Paste a YouTube or Vimeo link if hosting externally."
    },
    {
      "type": "text",
      "id": "reel_video_url",
      "label": "Or direct video URL (MP4 / WebM)",
      "info": "Paste direct .mp4 URL from Shopify Files or external CDN."
    },
    {
      "type": "text",
      "id": "reel_video_asset",
      "label": "Or theme asset video filename (fallback)",
      "default": "lame-home-spotlight.mp4",
      "info": "Filename in theme assets/ (e.g. lame-home-spotlight.mp4)"
    },
    {
      "type": "image_picker",
      "id": "reel_poster",
      "label": "Reel cover / poster image",
      "info": "Thumbnail poster image, or fallback image if video is not available."
    },
    {
      "type": "header",
      "content": "Cinematic Story & Display (Reel Layout)"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Hero story eyebrow / subtitle",
      "default": "LAMÉ Haute Parfumerie · 100ml",
      "info": "Appears with the dash above the large title, e.g. '— Sierra Nevada - United States' or '— LAMÉ Haute Parfumerie · 100ml'"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero story large title",
      "default": "Barqat",
      "info": "Massive bold headline in the reference style (e.g. 'YOSEMITE NATIONAL PARK' / 'BARQAT')"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero story description",
      "default": "A regal oriental blend wrapped in golden warmth and smoky elegance. Handcrafted by LAMÉ for unforgettable distinction."
    },
    {
      "type": "text",
      "id": "hero_button_label",
      "label": "Hero CTA button label",
      "default": "Discover Barqat"
    },
    {
      "type": "url",
      "id": "hero_button_link",
      "label": "Hero CTA button link"
    },
    {
      "type": "checkbox",
      "id": "show_bookmark_button",
      "label": "Show bookmark button in video hero",
      "default": false
    },
    {
      "type": "range",
      "id": "video_overlay_opacity",
      "label": "Cinematic video dark overlay opacity",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 65
    },
    {
      "type": "checkbox",
      "id": "show_playback_controls",
      "label": "Show bottom controls (Sound toggle & Fullscreen option)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sound_btn",
      "label": "Show audio sound toggle button",
      "default": true
    },
    {
      "type": "text",
      "id": "reel_sound_label",
      "label": "Audio button text",
      "default": "Audio"
    },
    {
      "type": "text",
      "id": "reel_caption_brand",
      "label": "Reel bottom brand label",
      "default": "LAMÉ PARFUMS"
    },
