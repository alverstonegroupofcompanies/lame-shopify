{%- assign has_reel_video = false -%}
{%- if section.settings.reel_video != blank or section.settings.reel_video_url_external != blank or section.settings.reel_video_url != blank or section.settings.reel_video_asset != blank -%}
  {%- assign has_reel_video = true -%}
{%- endif -%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-signature{% if section.settings.layout == 'reel_split' %} lame-signature--cinematic{% endif %}{% if section.settings.layout == 'editorial_grid' %} lame-signature--editorial{% endif %}{% if section.settings.coming_soon and section.settings.layout != 'reel_split' %} lame-signature--showcase{% endif %}{% if has_reel_video %} lame-signature--has-bg-video{% endif %}"
  {{ section.shopify_attributes }}
>
  {%- comment -%} FULL BACKGROUND CINEMATIC VIDEO IN BLACK & WHITE (for legacy layouts) {%- endcomment -%}
  {% if has_reel_video and section.settings.layout != 'reel_split' %}
    <div class="lame-signature__bg-video-wrap" aria-hidden="true">
      {% if section.settings.reel_video_url_external != blank %}
        {% if section.settings.reel_video_url_external.type == 'youtube' %}
          <iframe
            class="lame-signature__bg-video lame-signature__bg-video--iframe"
            src="https://www.youtube.com/embed/{{ section.settings.reel_video_url_external.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.reel_video_url_external.id }}&controls=0&playsinline=1"
            frameborder="0"
            allow="autoplay; encrypted-media"
            title="Background video"
          ></iframe>
        {% elsif section.settings.reel_video_url_external.type == 'vimeo' %}
          <iframe
            class="lame-signature__bg-video lame-signature__bg-video--iframe"
            src="https://player.vimeo.com/video/{{ section.settings.reel_video_url_external.id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1"
            frameborder="0"
            allow="autoplay; encrypted-media"
            title="Background video"
          ></iframe>
        {% endif %}
      {% else %}
        <video
          class="lame-signature__bg-video"
          data-lame-bg-video
          autoplay
          loop
          muted
          playsinline
          webkit-playsinline
          preload="auto"
        >
          {%- if section.settings.reel_video != blank and section.settings.reel_video.sources.size > 0 -%}
            {%- for source in section.settings.reel_video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          {%- endif -%}
          {%- if section.settings.reel_video_url != blank -%}
            <source src="{{ section.settings.reel_video_url }}" type="video/mp4">
          {%- endif -%}
          {%- if section.settings.reel_video_asset != blank -%}
            <source src="{{ section.settings.reel_video_asset | asset_url }}" type="video/mp4">
          {%- endif -%}
          <source src="{{ 'lame-home-spotlight.mp4' | asset_url }}" type="video/mp4">
        </video>
      {% endif %}
      <div class="lame-signature__bg-video-veil"></div>
    </div>
  {% endif %}
  {% if section.settings.layout != 'reel_split' %}
    <div class="lame-signature__vector-art" aria-hidden="true">
      <span class="lame-signature__vector lame-signature__vector--tl"></span>
      <span class="lame-signature__vector lame-signature__vector--br"></span>
      <span class="lame-signature__vector lame-signature__vector--pattern"></span>
    </div>
    <div class="lame-signature__decor lame-signature__decor--left" aria-hidden="true"></div>
    <div class="lame-signature__decor lame-signature__decor--right" aria-hidden="true"></div>
  {% endif %}

  <div class="lame-signature__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.layout == 'editorial_grid' %}
      <div class="lame-signature__editorial" data-lame-reveal>
        <div class="lame-signature__editorial-intro">
          {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
            <h2 class="lame-signature__title lame-signature__title--editorial">
              {% if section.settings.heading_line_1 != blank %}
                <span class="lame-signature__title-line">{{ section.settings.heading_line_1 }}</span>
              {% endif %}
              {% if section.settings.heading_line_2 != blank %}
                <span class="lame-signature__title-main">{{ section.settings.heading_line_2 }}</span>
              {% endif %}
            </h2>
          {% endif %}
          {% if section.settings.view_all_label != blank %}
            <a class="lame-signature__view-all lame-btn--forest-outline" href="{{ section.settings.view_all_link | default: routes.collections_url }}">
              {{ section.settings.view_all_label }}
            </a>
          {% endif %}
        </div>
        <ul class="lame-signature__grid" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'collection_card' %}
              <li class="lame-signature__grid-item" {{ block.shopify_attributes }}>
                <a class="lame-signature__explore-card" href="{{ block.settings.link | default: '#' }}">
                  <div class="lame-signature__explore-media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          class: 'lame-signature__explore-image',
                          loading: 'lazy',
                          widths: '360,480,600,800',
                          sizes: '(min-width: 990px) 16vw, 42vw',
                          alt: block.settings.title | escape
                      }}
                    {% else %}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'lame-signature__explore-image placeholder-svg' }}
                    {% endif %}
                    <div class="lame-signature__explore-overlay">
                      {% if block.settings.title != blank %}
                        <h3 class="lame-signature__explore-title">{{ block.settings.title }}</h3>
                      {% endif %}
                      {% if block.settings.explore_label != blank %}
                        <span class="lame-signature__explore-link">{{ block.settings.explore_label }} →</span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% else %}
    {% if section.settings.layout != 'reel_split' %}
    <header class="lame-signature__header" data-lame-reveal>
      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h2 class="lame-signature__title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="lame-signature__title-line">{{ section.settings.heading_line_1 }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="lame-signature__title-main">{{ section.settings.heading_line_2 }}</span>
          {% endif %}
        </h2>
      {% endif %}
      <span class="lame-signature__divider" aria-hidden="true">
        <svg viewBox="0 0 120 12" fill="none" focusable="false">
          <path d="M0 6h44" stroke="currentColor" stroke-width="0.6"/>
          <path d="M76 6h44" stroke="currentColor" stroke-width="0.6"/>
          <path d="M60 2c-2.2 2.8-4.8 4-8 4 3.2 0 5.8 1.2 8 4 2.2-2.8 4.8-4 8-4-3.2 0-5.8-1.2-8-4Z" fill="currentColor"/>
        </svg>
      </span>
      {% if section.settings.subheading != blank %}
        <p class="lame-signature__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    {% endif %}

    {% if section.settings.layout == 'reel_split' %}
      {%- liquid
        assign initial_hero_title = section.settings.hero_title
        if initial_hero_title == blank
          assign initial_hero_title = section.settings.reel_product_title | default: 'Barqat'
        endif

        assign initial_hero_eyebrow = section.settings.hero_eyebrow
        if initial_hero_eyebrow == blank
          assign initial_hero_eyebrow = section.settings.reel_product_subtitle | default: 'LAMÉ Haute Parfumerie · 100ml'
        endif

        assign initial_hero_desc = section.settings.hero_description
        if initial_hero_desc == blank
          assign initial_hero_desc = section.settings.reel_product_description | default: 'A regal oriental blend wrapped in golden warmth and smoky elegance. Handcrafted by LAMÉ for unforgettable distinction.'
        endif

        assign initial_hero_btn_label = section.settings.hero_button_label
        if initial_hero_btn_label == blank
          assign initial_hero_btn_label = section.settings.reel_button_label | default: 'Discover Barqat'
        endif

        assign initial_hero_link = section.settings.hero_button_link
        if initial_hero_link == blank
          assign initial_hero_link = section.settings.reel_product_link
          if initial_hero_link == blank and all_products['lame-barqat-eau-de-parfum-100ml'] != blank
            assign initial_hero_link = all_products['lame-barqat-eau-de-parfum-100ml'].url
          endif
          if initial_hero_link == blank
            assign initial_hero_link = '/collections/fragrance'
          endif
        endif

        assign overlay_opacity = section.settings.video_overlay_opacity | default: 65 | divided_by: 100.0
      -%}

      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

      <div class="lame-signature__cinematic" data-cinematic-slider>
        {%- comment -%} Background Cinematic Video {%- endcomment -%}
        <div class="lame-signature__cinematic-bg" aria-hidden="true">
          {% if section.settings.reel_video_url_external != blank %}
            {% if section.settings.reel_video_url_external.type == 'youtube' %}
              <iframe
                class="lame-signature__cinematic-video lame-signature__cinematic-video--iframe"
                data-cinematic-bg-iframe
                src="https://www.youtube.com/embed/{{ section.settings.reel_video_url_external.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.reel_video_url_external.id }}&controls=0&playsinline=1"
                frameborder="0"
                allow="autoplay; encrypted-media"
                title="Background video"
              ></iframe>
            {% elsif section.settings.reel_video_url_external.type == 'vimeo' %}
              <iframe
                class="lame-signature__cinematic-video lame-signature__cinematic-video--iframe"
                data-cinematic-bg-iframe
                src="https://player.vimeo.com/video/{{ section.settings.reel_video_url_external.id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1"
                frameborder="0"
                allow="autoplay; encrypted-media"
                title="Background video"
              ></iframe>
            {% endif %}
          {% else %}
            <video
              class="lame-signature__cinematic-video"
              data-cinematic-bg-video
              autoplay
              loop
              muted
              playsinline
              webkit-playsinline
              preload="auto"
              {% if section.settings.reel_poster != blank %}poster="{{ section.settings.reel_poster | image_url: width: 1920 }}"{% endif %}
            >
              {%- if section.settings.reel_video != blank and section.settings.reel_video.sources.size > 0 -%}
                {%- for source in section.settings.reel_video.sources -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              {%- endif -%}
              {%- if section.settings.reel_video_url != blank -%}
                <source src="{{ section.settings.reel_video_url }}" type="video/mp4">
              {%- endif -%}
              {%- if section.settings.reel_video_asset != blank -%}
                <source src="{{ section.settings.reel_video_asset | asset_url }}" type="video/mp4">
              {%- endif -%}
              <source src="{{ 'lame-home-spotlight.mp4' | asset_url }}" type="video/mp4">
            </video>
          {% endif %}
          <div class="lame-signature__cinematic-overlay" style="--lame-cinematic-overlay-opacity: {{ overlay_opacity }};"></div>
        </div>

        {%- comment -%} Top Bar: Section Title & Navigation link {%- endcomment -%}
        {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
          <header class="lame-signature__cinematic-topbar">
            <div class="lame-signature__cinematic-badge">
              <span class="lame-signature__cinematic-badge-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L14.2 8.8L21 11L14.2 13.2L12 20L9.8 13.2L3 11L9.8 8.8L12 2Z"/></svg>
              </span>
              {% if section.settings.heading_line_1 != blank %}
                <span class="lame-signature__cinematic-badge-kicker">{{ section.settings.heading_line_1 }}</span>
              {% endif %}
              {% if section.settings.heading_line_2 != blank %}
                <span class="lame-signature__cinematic-badge-sep" aria-hidden="true">•</span>
                <span class="lame-signature__cinematic-badge-title">{{ section.settings.heading_line_2 }}</span>
              {% endif %}
            </div>

            {% if section.settings.view_all_label != blank %}
              <a href="{{ section.settings.view_all_link | default: routes.collections_url }}" class="lame-signature__cinematic-view-all">
                <span class="lame-signature__cinematic-view-all-text lame-signature__cinematic-view-all-text--desktop">{{ section.settings.view_all_label }}</span>
                <span class="lame-signature__cinematic-view-all-text lame-signature__cinematic-view-all-text--mobile">View All</span>
                <span class="lame-signature__cinematic-view-all-arrow" aria-hidden="true">→</span>
              </a>
            {% endif %}
          </header>
        {% endif %}

        {%- comment -%} Interactive Stage: Left Hero Story + Right Cards Slider {%- endcomment -%}
        <div class="lame-signature__cinematic-stage">
          {%- comment -%} LEFT HERO STORY {%- endcomment -%}
          <div class="lame-signature__cinematic-hero">
            <div class="lame-signature__cinematic-eyebrow-wrap">
              <span class="lame-signature__cinematic-dash" aria-hidden="true">—</span>
              <span class="lame-signature__cinematic-eyebrow" data-hero-eyebrow>{{ initial_hero_eyebrow }}</span>
            </div>

            <h2 class="lame-signature__cinematic-title" data-hero-title>{{ initial_hero_title }}</h2>

            <p class="lame-signature__cinematic-desc" data-hero-desc>{{ initial_hero_desc }}</p>

            <div class="lame-signature__cinematic-actions">
              {% if section.settings.show_bookmark_button %}
                <button
                  type="button"
                  class="lame-signature__cinematic-btn-icon"
                  data-cinematic-bookmark
                  aria-label="Save or explore {{ initial_hero_title }}"
                  title="Save / Explore"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
                  </svg>
                </button>
              {% endif %}

              <a
                href="{{ initial_hero_link }}"
                class="lame-signature__cinematic-btn-cta"
                data-hero-link
              >
                <span data-hero-btn-text>{{ initial_hero_btn_label }}</span>
              </a>
            </div>
          </div>

          {%- comment -%} RIGHT FLOATING CARDS SLIDER {%- endcomment -%}
          <div class="lame-signature__cinematic-cards-wrapper">
            <div class="lame-signature__cinematic-cards-viewport" data-cinematic-viewport>
              <div class="lame-signature__cinematic-cards-track" data-cinematic-track role="list">
                {% for block in section.blocks %}
                  {% if block.type == 'product' %}
                    {%- liquid
                      assign card_title = block.settings.heading | default: 'Barqat'
                      assign card_cat = block.settings.category | default: block.settings.brand | default: 'Fragrance'
                      assign card_desc = block.settings.description
                      if card_desc == blank
                        assign card_desc = initial_hero_desc
                      endif
                      assign card_link = block.settings.link
                      if card_link == blank and block.settings.product != blank
                        assign card_link = block.settings.product.url
                      endif
                      if card_link == blank
                        assign card_link = initial_hero_link
                      endif
                      assign card_btn = block.settings.button_label | default: initial_hero_btn_label
                      assign card_video = block.settings.slide_video
                    -%}
                    <div
                      class="lame-signature__cinematic-card{% if forloop.first %} is-active{% endif %}"
                      data-cinematic-card
                      data-index="{{ forloop.index0 }}"
                      data-title="{{ card_title | escape }}"
                      data-eyebrow="— {{ card_cat | escape }}"
                      data-desc="{{ card_desc | escape }}"
                      data-link="{{ card_link }}"
                      data-btn="{{ card_btn | escape }}"
                      {% if card_video != blank %}data-video="{{ card_video }}"{% endif %}
                      role="listitem"
                      tabindex="0"
                      {{ block.shopify_attributes }}
                    >
                      <div class="lame-signature__cinematic-card-media">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 600
                            | image_tag:
                              class: 'lame-signature__cinematic-card-img',
                              loading: 'lazy',
                              widths: '300,450,600',
                              sizes: '(min-width: 990px) 200px, 160px',
                              alt: card_title | escape
                          }}
                        {% elsif block.settings.image_asset != blank %}
                          <img
                            class="lame-signature__cinematic-card-img"
                            src="{{ block.settings.image_asset | asset_url }}"
                            alt="{{ card_title | escape }}"
                            loading="lazy"
                            width="600"
                            height="850"
                          >
                        {% else %}
                          {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-signature__cinematic-card-img placeholder-svg' }}
                        {% endif %}
                        <div class="lame-signature__cinematic-card-gradient"></div>
                      </div>

                      <div class="lame-signature__cinematic-card-body">
                        <span class="lame-signature__cinematic-card-cat">— {{ card_cat }}</span>
                        <h3 class="lame-signature__cinematic-card-title">{{ card_title }}</h3>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            {%- comment -%} Navigation Controls (Arrows + Progress Scrubber + Counter) {%- endcomment -%}
            <div class="lame-signature__cinematic-nav-row">
              <div class="lame-signature__cinematic-nav-arrows">
                <button
                  type="button"
                  class="lame-signature__cinematic-nav-btn lame-signature__cinematic-nav-btn--prev"
                  data-cinematic-prev
                  aria-label="Previous slide"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button
                  type="button"
                  class="lame-signature__cinematic-nav-btn lame-signature__cinematic-nav-btn--next"
                  data-cinematic-next
                  aria-label="Next slide"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
              </div>

              <div class="lame-signature__cinematic-progress" aria-hidden="true">
                <div class="lame-signature__cinematic-progress-bar" data-cinematic-progress-bar></div>
              </div>

              <div class="lame-signature__cinematic-counter" data-cinematic-counter>
                01
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Bottom Playback Bar (Sound Toggle & Fullscreen Option) {%- endcomment -%}
        {% if section.settings.show_playback_controls or section.settings.show_playback_controls == nil %}
          <div class="lame-signature__cinematic-footer">
            <div class="lame-signature__cinematic-playback-right">
              <button
                type="button"
                class="lame-signature__cinematic-sound-toggle-btn"
                data-cinematic-sound-toggle
                aria-label="Mute or unmute video sound"
                title="Mute / Unmute Sound"
              >
                <svg class="icon-sound-on" viewBox="0 0 24 24" fill="currentColor" style="display:none;" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                <svg class="icon-sound-off" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
              </button>

              <button
                type="button"
                class="lame-signature__cinematic-fullscreen-btn"
                data-cinematic-fullscreen-toggle
                aria-label="Play full screen"
                title="Play Full Screen"
              >
                <svg class="icon-fullscreen-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>
                </svg>
                <svg class="icon-fullscreen-exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;" aria-hidden="true">
                  <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>
                </svg>
              </button>
            </div>
          </div>
        {% endif %}
      </div>

    {% elsif section.settings.layout == 'reel_split_legacy' or section.settings.layout == 'reel_and_carousel' %}
      {%- assign barqat_product = section.settings.reel_product -%}
      {%- if barqat_product == blank and all_products['lame-barqat-eau-de-parfum-100ml'] != blank -%}
        {%- assign barqat_product = all_products['lame-barqat-eau-de-parfum-100ml'] -%}
      {%- endif -%}
      {%- assign barqat_url = section.settings.reel_product_link -%}
      {%- if barqat_product != blank and barqat_product.url != blank -%}
        {%- assign barqat_url = barqat_product.url -%}
      {%- elsif barqat_url == blank -%}
        {%- assign barqat_url = '/products/lame-barqat-eau-de-parfum-100ml' -%}
      {%- endif -%}

      {%- assign barqat_title = section.settings.reel_product_title | default: 'Barqat' -%}
      {%- if barqat_product != blank and section.settings.reel_product_title == blank -%}
        {%- assign barqat_title = barqat_product.title -%}
      {%- endif -%}

      {%- assign barqat_price = section.settings.reel_product_price | default: '₹3,999' -%}
      {%- if barqat_product != blank and barqat_product.price > 0 -%}
        {%- assign barqat_price = barqat_product.price | money -%}
      {%- endif -%}      {%- assign barqat_compare_price = blank -%}
      {%- if section.settings.reel_product_price_compare != blank -%}
        {%- assign barqat_compare_price = section.settings.reel_product_price_compare -%}
      {%- elsif barqat_product != blank and barqat_product.compare_at_price > barqat_product.price -%}
        {%- assign barqat_compare_price = barqat_product.compare_at_price | money -%}
      {%- endif -%}

      <div class="lame-signature__reel-showcase" data-lame-reveal>
        <div class="lame-signature__barqat-col">
          <a href="{{ barqat_url }}" class="lame-signature__barqat-card" aria-label="View {{ barqat_title }} product page">
            <div class="lame-signature__barqat-glow" aria-hidden="true"></div>

