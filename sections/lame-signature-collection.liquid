<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} lame-signature{% if section.settings.layout == 'editorial_grid' %} lame-signature--editorial{% endif %}{% if section.settings.coming_soon %} lame-signature--showcase{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="lame-signature__vector-art" aria-hidden="true">
    <span class="lame-signature__vector lame-signature__vector--tl"></span>
    <span class="lame-signature__vector lame-signature__vector--br"></span>
    <span class="lame-signature__vector lame-signature__vector--pattern"></span>
  </div>
  <div class="lame-signature__decor lame-signature__decor--left" aria-hidden="true"></div>
  <div class="lame-signature__decor lame-signature__decor--right" aria-hidden="true"></div>

  <div class="lame-signature__wrap spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.layout == 'editorial_grid' %}
      <div class="lame-signature__editorial" data-lame-reveal>
        <div class="lame-signature__editorial-intro">
          {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
            <h2 class="lame-signature__title lame-signature__title--editorial">
              {% if section.settings.heading_line_1 != blank %}
                <span class="lame-signature__title-line">{{ section.settings.heading_line_1 }}</span>
              {% endif %}
              {% if section.settings.heading_line_2 != blank %}
                <span class="lame-signature__title-main">{{ section.settings.heading_line_2 }}</span>
              {% endif %}
            </h2>
          {% endif %}
          {% if section.settings.view_all_label != blank %}
            <a class="lame-signature__view-all lame-btn--forest-outline" href="{{ section.settings.view_all_link | default: routes.collections_url }}">
              {{ section.settings.view_all_label }}
            </a>
          {% endif %}
        </div>
        <ul class="lame-signature__grid" role="list">
          {% for block in section.blocks %}
            {% if block.type == 'collection_card' %}
              <li class="lame-signature__grid-item" {{ block.shopify_attributes }}>
                <a class="lame-signature__explore-card" href="{{ block.settings.link | default: '#' }}">
                  <div class="lame-signature__explore-media">
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          class: 'lame-signature__explore-image',
                          loading: 'lazy',
                          widths: '360,480,600,800',
                          sizes: '(min-width: 990px) 16vw, 42vw',
                          alt: block.settings.title | escape
                      }}
                    {% else %}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'lame-signature__explore-image placeholder-svg' }}
                    {% endif %}
                    <div class="lame-signature__explore-overlay">
                      {% if block.settings.title != blank %}
                        <h3 class="lame-signature__explore-title">{{ block.settings.title }}</h3>
                      {% endif %}
                      {% if block.settings.explore_label != blank %}
                        <span class="lame-signature__explore-link">{{ block.settings.explore_label }} →</span>
                      {% endif %}
                    </div>
                  </div>
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    {% else %}
    <header class="lame-signature__header" data-lame-reveal>
      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h2 class="lame-signature__title">
          {% if section.settings.heading_line_1 != blank %}
            <span class="lame-signature__title-line">{{ section.settings.heading_line_1 }}</span>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="lame-signature__title-main">{{ section.settings.heading_line_2 }}</span>
          {% endif %}
        </h2>
      {% endif %}
      <span class="lame-signature__divider" aria-hidden="true">
        <svg viewBox="0 0 120 12" fill="none" focusable="false">
          <path d="M0 6h44" stroke="currentColor" stroke-width="0.6"/>
          <path d="M76 6h44" stroke="currentColor" stroke-width="0.6"/>
          <path d="M60 2c-2.2 2.8-4.8 4-8 4 3.2 0 5.8 1.2 8 4 2.2-2.8 4.8-4 8-4-3.2 0-5.8-1.2-8-4Z" fill="currentColor"/>
        </svg>
      </span>
      {% if section.settings.subheading != blank %}
        <p class="lame-signature__subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {% if section.settings.layout == 'reel_split' or section.settings.layout == 'reel_and_carousel' %}
      {%- assign barqat_product = section.settings.reel_product -%}
      {%- assign barqat_url = section.settings.reel_product_link -%}
      {%- if barqat_product != blank -%}
        {%- assign barqat_url = barqat_product.url -%}
      {%- elsif barqat_url == blank -%}
        {%- assign barqat_url = 'shopify://collections/fragrance' -%}
      {%- endif -%}

      {%- assign barqat_title = section.settings.reel_product_title | default: 'Barqat' -%}
      {%- if barqat_product != blank and section.settings.reel_product_title == blank -%}
        {%- assign barqat_title = barqat_product.title -%}
      {%- endif -%}

      {%- assign barqat_price = section.settings.reel_product_price | default: '₹1,499' -%}
      {%- if barqat_product != blank and barqat_product.price > 0 -%}
        {%- assign barqat_price = barqat_product.price | money -%}
      {%- endif -%}

      {%- assign barqat_compare_price = section.settings.reel_product_price_compare | default: '₹1,999' -%}
      {%- if barqat_product != blank and barqat_product.compare_at_price > barqat_product.price -%}
        {%- assign barqat_compare_price = barqat_product.compare_at_price | money -%}
      {%- endif -%}

      <div class="lame-signature__reel-showcase" data-lame-reveal>
        <div class="lame-signature__reel-grid">

          {%- comment -%} LEFT COLUMN: VERTICAL REEL VIDEO {%- endcomment -%}
          <div class="lame-signature__reel-col">
            <div class="lame-signature__reel-frame" data-reel-container>
              {% if section.settings.reel_video != blank %}
                {{
                  section.settings.reel_video
                  | video_tag:
                    autoplay: true,
                    loop: true,
                    muted: true,
                    playsinline: true,
                    class: 'lame-signature__reel-media',
                    controls: false,
                    image_size: '900x'
                }}
              {% elsif section.settings.reel_video_url_external != blank %}
                {% if section.settings.reel_video_url_external.type == 'youtube' %}
                  <iframe
                    class="lame-signature__reel-media lame-signature__reel-media--iframe"
                    src="https://www.youtube.com/embed/{{ section.settings.reel_video_url_external.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.reel_video_url_external.id }}&controls=0&playsinline=1"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.reel_caption_title | default: 'Vertical video' | escape }}"
                  ></iframe>
                {% elsif section.settings.reel_video_url_external.type == 'vimeo' %}
                  <iframe
                    class="lame-signature__reel-media lame-signature__reel-media--iframe"
                    src="https://player.vimeo.com/video/{{ section.settings.reel_video_url_external.id }}?autoplay=1&muted=1&loop=1&autopause=0&background=1"
                    frameborder="0"
                    allow="autoplay; encrypted-media"
                    allowfullscreen
                    title="{{ section.settings.reel_caption_title | default: 'Vertical video' | escape }}"
                  ></iframe>
                {% endif %}
              {% elsif section.settings.reel_video_url != blank %}
                <video
                  class="lame-signature__reel-media"
                  autoplay
                  loop
                  muted
                  playsinline
                  src="{{ section.settings.reel_video_url }}"
                  {% if section.settings.reel_poster != blank %}poster="{{ section.settings.reel_poster | image_url: width: 900 }}"{% endif %}
                ></video>
              {% elsif section.settings.reel_video_asset != blank %}
                <video
                  class="lame-signature__reel-media"
                  autoplay
                  loop
                  muted
                  playsinline
                  src="{{ section.settings.reel_video_asset | asset_url }}"
                  {% if section.settings.reel_poster != blank %}poster="{{ section.settings.reel_poster | image_url: width: 900 }}"{% endif %}
                ></video>
              {% elsif section.settings.reel_poster != blank %}
                {{
                  section.settings.reel_poster
                  | image_url: width: 900
                  | image_tag:
                    class: 'lame-signature__reel-media',
                    loading: 'lazy',
                    widths: '360,540,720,900',
                    sizes: '(min-width: 990px) 360px, 85vw',
                    alt: section.settings.reel_caption_title | default: 'LAMÉ Reel' | escape
                }}
              {% else %}
                <div class="lame-signature__reel-placeholder">
                  <span>Vertical Video Reel</span>
                </div>
              {% endif %}

              <div class="lame-signature__reel-overlay" aria-hidden="true"></div>

              {% if section.settings.show_sound_btn != false %}
                <button
                  type="button"
                  class="lame-signature__reel-sound-btn"
                  data-reel-sound-toggle
                  aria-label="Toggle reel sound"
                  title="Toggle sound"
                >
                  <span class="lame-signature__reel-sound-icon lame-signature__reel-sound-icon--muted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M11 5 6 9H2v6h4l5 4V5Z"/>
                      <line x1="23" y1="9" x2="17" y2="15"/>
                      <line x1="17" y1="9" x2="23" y2="15"/>
                    </svg>
                  </span>
                  <span class="lame-signature__reel-sound-icon lame-signature__reel-sound-icon--unmuted" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M11 5 6 9H2v6h4l5 4V5Z"/>
                      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
                      <path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>
                    </svg>
                  </span>
                  <span class="lame-signature__reel-sound-label">{{ section.settings.reel_sound_label | default: 'Audio' }}</span>
                </button>
              {% endif %}

              <div class="lame-signature__reel-footer-caption">
                {% if section.settings.reel_caption_brand != blank %}
                  <p class="lame-signature__reel-caption-brand">{{ section.settings.reel_caption_brand }}</p>
                {% endif %}
                <p class="lame-signature__reel-caption-title">
                  {% if section.settings.reel_caption_title != blank %}
                    {{ section.settings.reel_caption_title }}
                  {% else %}
                    {{ barqat_title }} in Motion
                  {% endif %}
                </p>
              </div>
            </div>
          </div>

          {%- comment -%} RIGHT COLUMN: BARQAT PRODUCT CARD (ENTIRE CARD CLICKABLE) {%- endcomment -%}
          <div class="lame-signature__barqat-col">
            <a href="{{ barqat_url }}" class="lame-signature__barqat-card" aria-label="View {{ barqat_title }} product page">
              <div class="lame-signature__barqat-glow" aria-hidden="true"></div>

              <div class="lame-signature__barqat-inner">
                <div class="lame-signature__barqat-media">
                  <div class="lame-signature__barqat-badge-wrap">
                    {% if section.settings.reel_product_tag != blank %}
                      <span class="lame-signature__barqat-tag">{{ section.settings.reel_product_tag }}</span>
                    {% endif %}
                    {% if section.settings.reel_product_rating != blank or section.settings.reel_product_rating_stars != blank %}
                      <span class="lame-signature__barqat-rating">
                        {% if section.settings.reel_product_rating_stars != blank %}
                          <span class="lame-signature__barqat-stars">{{ section.settings.reel_product_rating_stars }}</span>
                        {% endif %}
                        {% if section.settings.reel_product_rating != blank %}
                          <span class="lame-signature__barqat-score">{{ section.settings.reel_product_rating }}</span>
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>

                  <div class="lame-signature__barqat-img-wrap">
                    {% if section.settings.reel_product_image != blank %}
                      {{
                        section.settings.reel_product_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'lame-signature__barqat-image',
                          loading: 'lazy',
                          widths: '360,540,720,900',
                          sizes: '(min-width: 990px) 380px, 85vw',
                          alt: barqat_title | escape
                      }}
                    {% elsif barqat_product != blank and barqat_product.featured_image != blank %}
                      {{
                        barqat_product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          class: 'lame-signature__barqat-image',
                          loading: 'lazy',
                          widths: '360,540,720,900',
                          sizes: '(min-width: 990px) 380px, 85vw',
                          alt: barqat_title | escape
                      }}
                    {% elsif section.settings.reel_product_image_asset != blank %}
                      <img
                        class="lame-signature__barqat-image"
                        src="{{ section.settings.reel_product_image_asset | asset_url }}"
                        alt="{{ barqat_title | escape }}"
                        loading="lazy"
                        width="900"
                        height="1125"
                      >
                    {% else %}
                      <img
                        class="lame-signature__barqat-image"
                        src="{{ 'lame-coming-soon-barqat.png' | asset_url }}"
                        alt="{{ barqat_title | escape }}"
                        loading="lazy"
                        width="900"
                        height="1125"
                      >
                    {% endif %}
                  </div>
                </div>

                <div class="lame-signature__barqat-info">
                  {% if section.settings.reel_product_brand != blank %}
                    <p class="lame-signature__barqat-brand">{{ section.settings.reel_product_brand }}</p>
                  {% endif %}
                  <h3 class="lame-signature__barqat-title">{{ barqat_title }}</h3>

                  {% if section.settings.reel_product_subtitle != blank %}
                    <p class="lame-signature__barqat-subtitle">{{ section.settings.reel_product_subtitle }}</p>
                  {% endif %}

                  <div class="lame-signature__barqat-price-row">
                    <span class="lame-signature__barqat-price">{{ barqat_price }}</span>
                    {% if barqat_compare_price != blank %}
                      <span class="lame-signature__barqat-compare">{{ barqat_compare_price }}</span>
                    {% endif %}
                    {% if section.settings.reel_product_tax_badge != blank %}
                      <span class="lame-signature__barqat-tax-pill">{{ section.settings.reel_product_tax_badge }}</span>
                    {% endif %}
                  </div>

                  {%- assign notes_label = section.settings.reel_product_notes_label | default: 'SCENT PROFILE' -%}
                  <div class="lame-signature__barqat-notes-wrap">
                    {% if notes_label != blank %}
                      <span class="lame-signature__barqat-note-label">{{ notes_label }}</span>
                    {% endif %}
                    <div class="lame-signature__barqat-note-pills">
                      {% if section.settings.reel_scent_note_1 != blank or section.settings.reel_scent_note_2 != blank or section.settings.reel_scent_note_3 != blank %}
                        {% if section.settings.reel_scent_note_1 != blank %}
                          <span class="lame-signature__barqat-note-pill">{{ section.settings.reel_scent_note_1 }}</span>
                        {% endif %}
                        {% if section.settings.reel_scent_note_2 != blank %}
                          <span class="lame-signature__barqat-note-pill">{{ section.settings.reel_scent_note_2 }}</span>
                        {% endif %}
                        {% if section.settings.reel_scent_note_3 != blank %}
                          <span class="lame-signature__barqat-note-pill">{{ section.settings.reel_scent_note_3 }}</span>
                        {% endif %}
                      {% else %}
                        {%- assign notes_string = section.settings.reel_product_scent_notes | default: 'ORIENTAL • WOODY • AMBER' -%}
                        {%- assign notes_array = notes_string | split: '•' -%}
                        {% for note in notes_array %}
                          {% assign trimmed_note = note | strip %}
                          {% if trimmed_note != blank %}
                            <span class="lame-signature__barqat-note-pill">
                              <span class="lame-signature__note-icon">
                                {% case forloop.index %}
                                  {% when 1 %}🌿
                                  {% when 2 %}🪵
                                  {% when 3 %}✨
                                  {% else %}⚜️
                                {% endcase %}
                              </span>
                              {{ trimmed_note }}
                            </span>
                          {% endif %}
                        {% endfor %}
                      {% endif %}
                    </div>
                  </div>

                  {% if section.settings.reel_product_description != blank %}
                    <p class="lame-signature__barqat-desc">{{ section.settings.reel_product_description }}</p>
                  {% endif %}

                  <div class="lame-signature__barqat-cta-row">
                    <span class="lame-signature__barqat-btn">
                      <span>{{ section.settings.reel_button_label | default: 'Explore Barqat' }}</span>
                      <svg class="lame-signature__barqat-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7"/>
                      </svg>
                    </span>
                    {% if section.settings.reel_click_hint != blank %}
                      <span class="lame-signature__barqat-click-hint">{{ section.settings.reel_click_hint }}</span>
                    {% endif %}
                  </div>

                  {% if section.settings.reel_trust_1 != blank or section.settings.reel_trust_2 != blank or section.settings.reel_trust_3 != blank %}
                    <div class="lame-signature__barqat-trust">
                      {% if section.settings.reel_trust_1 != blank %}
                        <div class="lame-signature__trust-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                          <span>{{ section.settings.reel_trust_1 }}</span>
                        </div>
                      {% endif %}
                      {% if section.settings.reel_trust_2 != blank %}
                        <div class="lame-signature__trust-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                          <span>{{ section.settings.reel_trust_2 }}</span>
                        </div>
                      {% endif %}
                      {% if section.settings.reel_trust_3 != blank %}
                        <div class="lame-signature__trust-item">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                          <span>{{ section.settings.reel_trust_3 }}</span>
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            </a>
          </div>

        </div>
      </div>
    {% endif %}

    {% if section.settings.layout == 'carousel' or section.settings.layout == 'reel_and_carousel' %}
    <div class="lame-signature__carousel{% if section.settings.layout == 'reel_and_carousel' %} lame-signature__carousel--below-reel{% endif %}" data-signature-carousel>
      <ul class="lame-signature__track" role="list" data-signature-track>
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            <li
              class="lame-signature__slide"
              data-signature-slide
              data-lame-reveal
              data-lame-delay="{{ forloop.index0 | modulo: 3 }}"
              {{ block.shopify_attributes }}
            >
              <article class="lame-signature__card{% if section.settings.coming_soon %} lame-signature__card--showcase{% endif %}">
                {% if section.settings.coming_soon %}
                <div class="lame-signature__showcase-media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        class: 'lame-signature__showcase-image',
                        loading: 'lazy',
                        widths: '360,480,600,720,900',
                        sizes: '(min-width: 1200px) 340px, (min-width: 750px) 40vw, 82vw',
                        alt: block.settings.image.alt | default: block.settings.heading | escape
                    }}
                  {% elsif block.settings.image_asset != blank %}
                    <img
                      class="lame-signature__showcase-image"
                      src="{{ block.settings.image_asset | asset_url }}"
                      alt="{{ block.settings.heading | default: block.settings.brand | escape }}"
                      loading="lazy"
                      width="900"
                      height="1125"
                    >
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-signature__showcase-image placeholder-svg' }}
                  {% endif %}
                  <div class="lame-signature__showcase-veil" aria-hidden="true"></div>
                </div>
                <div class="lame-signature__showcase-content">
                  <div class="lame-signature__showcase-meta">
                    {% if block.settings.brand != blank %}
                      <p class="lame-signature__showcase-brand">{{ block.settings.brand }}</p>
                    {% endif %}
                    {% if block.settings.category != blank %}
                      <span class="lame-signature__showcase-tag">{{ block.settings.category }}</span>
                    {% endif %}
                  </div>
                  {% if block.settings.heading != blank %}
                    <h3 class="lame-signature__showcase-name">{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.scent_notes != blank %}
                    <p class="lame-signature__showcase-notes">{{ block.settings.scent_notes }}</p>
                  {% endif %}
                  {% assign card_btn_text = block.settings.button_label | default: section.settings.coming_soon_label %}
                  {% if block.settings.link != blank %}
                    <a class="lame-signature__showcase-coming-soon" href="{{ block.settings.link }}">
                      {{ card_btn_text }}
                    </a>
                  {% else %}
                    <span class="lame-signature__showcase-coming-soon">{{ card_btn_text }}</span>
                  {% endif %}
                </div>
                {% else %}
                <div class="lame-signature__media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag:
                        class: 'lame-signature__image',
                        loading: 'lazy',
                        widths: '360,480,600,720,900',
                        sizes: '(min-width: 990px) 18vw, (min-width: 750px) 42vw, 88vw',
                        alt: block.settings.image.alt | default: block.settings.heading | escape
                    }}
                  {% elsif block.settings.image_asset != blank %}
                    <img
                      class="lame-signature__image"
                      src="{{ block.settings.image_asset | asset_url }}"
                      alt="{{ block.settings.heading | default: block.settings.brand | escape }}"
                      loading="lazy"
                      width="900"
                      height="900"
                    >
                  {% else %}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-signature__image placeholder-svg' }}
                  {% endif %}
                </div>
                {% endif %}

                {% unless section.settings.coming_soon %}
                <div class="lame-signature__content">
                  {% if block.settings.brand != blank %}
                    <p class="lame-signature__brand">{{ block.settings.brand }}</p>
                  {% endif %}
                  {% if block.settings.heading != blank %}
                    <h3 class="lame-signature__product-name">{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="lame-signature__description">{{ block.settings.description }}</p>
                  {% endif %}
                  <span class="lame-signature__crest" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" focusable="false">
                      <path d="M12 3 8 9h8L12 3Z" stroke="currentColor" stroke-width="0.8"/>
                      <path d="M6 11h12v2a6 6 0 0 1-12 0v-2Z" stroke="currentColor" stroke-width="0.8"/>
                    </svg>
                  </span>
                  {% if block.settings.scent_notes != blank %}
                    <p class="lame-signature__notes">{{ block.settings.scent_notes }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank and block.settings.link != blank %}
                    <a class="lame-signature__cta" href="{{ block.settings.link }}">
                      {{ block.settings.button_label }}
                      <span aria-hidden="true">→</span>
                    </a>
                  {% endif %}
                </div>
                {% endunless %}
              </article>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="lame-signature__controls">
        <button type="button" class="lame-signature__arrow lame-signature__arrow--prev" data-signature-prev aria-label="{{ section.settings.prev_label }}">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="lame-signature__dots" data-signature-dots role="tablist" aria-label="{{ section.settings.carousel_label }}"></div>
        <button type="button" class="lame-signature__arrow lame-signature__arrow--next" data-signature-next aria-label="{{ section.settings.next_label }}">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
    {% endif %}

    {% endif %}

    {% assign value_blocks = section.blocks | where: 'type', 'value' %}
    {% if value_blocks.size > 0 %}
      <ul class="lame-signature__values" role="list">
        {% for block in value_blocks %}
          <li class="lame-signature__value" data-lame-reveal data-lame-delay="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
            <span class="lame-signature__value-icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'lasting' %}
                  <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.2"/><path d="M12 8v4l2.5 2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                {% when 'packaging' %}
                  <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="8" width="16" height="11" rx="1" stroke="currentColor" stroke-width="1.2"/><path d="M8 8V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.2"/></svg>
                {% when 'crafted' %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M12 4 5 8v5c0 4.2 3 7.8 7 8.5 4-.7 7-4.3 7-8.5V8l-7-4Z" stroke="currentColor" stroke-width="1.2"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none"><path d="M8 6h8l1 12H7L8 6Z" stroke="currentColor" stroke-width="1.2"/><path d="M10 6V4.5A2 2 0 0 1 14 4.5V6" stroke="currentColor" stroke-width="1.2"/></svg>
              {% endcase %}
            </span>
            <div class="lame-signature__value-text">
              {% if block.settings.title != blank %}
                <p class="lame-signature__value-title">{{ block.settings.title }}</p>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="lame-signature__value-sub">{{ block.settings.text }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    function initSignature(section) {
      if (!section) return;

      // IntersectionObserver for reveal elements
      const revealNodes = section.querySelectorAll('[data-lame-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              obs.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        revealNodes.forEach((node) => observer.observe(node));
      } else {
        revealNodes.forEach((node) => node.classList.add('is-visible'));
      }

      // Reel Sound & Video toggle
      const soundBtn = section.querySelector('[data-reel-sound-toggle]');
      const reelContainer = section.querySelector('[data-reel-container]');
      if (soundBtn && reelContainer) {
        const video = reelContainer.querySelector('video');
        if (video) {
          soundBtn.style.display = '';
          soundBtn.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            video.muted = !video.muted;
            soundBtn.classList.toggle('is-unmuted', !video.muted);
            if (!video.muted && video.paused) {
              video.play().catch(() => {});
            }
          };

          video.onclick = () => {
            if (video.paused) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          };

          // Try play if autoplay was prevented
          if (video.paused) {
            video.play().catch(() => {});
          }
        } else {
          soundBtn.style.display = 'none';
        }
      }

      const track = section.querySelector('[data-signature-track]');
      const slides = section.querySelectorAll('[data-signature-slide]');
      const dotsWrap = section.querySelector('[data-signature-dots]');
      const prev = section.querySelector('[data-signature-prev]');
      const next = section.querySelector('[data-signature-next]');
      if (!track || !slides.length) return;

      let activeIndex = 0;
      let dots = [];

      const getSlidesPerView = () => {
        const isShowcase = section.querySelector('.lame-signature__card--showcase');
        if (isShowcase) {
          if (window.matchMedia('(min-width: 1100px)').matches) return 3;
          if (window.matchMedia('(min-width: 750px)').matches) return 2;
          return 1;
        }
        if (window.matchMedia('(min-width: 990px)').matches) return 3;
        if (window.matchMedia('(min-width: 750px)').matches) return 2;
        return 1;
      };

      const getPageCount = () => {
        const perView = getSlidesPerView();
        return Math.max(1, Math.ceil(slides.length / perView));
      };

      const buildDots = () => {
        if (!dotsWrap) return;
        dotsWrap.innerHTML = '';
        dots = [];
        const count = getPageCount();
        for (let i = 0; i < count; i += 1) {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'lame-signature__dot';
          dot.setAttribute('role', 'tab');
          dot.setAttribute('aria-label', `Slide ${i + 1}`);
          dot.onclick = () => goToPage(i);
          dotsWrap.appendChild(dot);
          dots.push(dot);
        }
      };

      const updateDots = () => {
        dots.forEach((dot, i) => {
          const isActive = i === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      };

      const goToPage = (pageIndex) => {
        const perView = getSlidesPerView();
        const maxPage = getPageCount() - 1;
        activeIndex = Math.min(Math.max(pageIndex, 0), maxPage);
        const targetSlide = slides[activeIndex * perView];
        if (!targetSlide) return;
        const offset = targetSlide.offsetLeft - track.offsetLeft;
        track.scrollTo({ left: offset, behavior: 'smooth' });
        updateDots();
        updateArrows();
      };

      const updateArrows = () => {
        const maxPage = getPageCount() - 1;
        if (prev) prev.disabled = activeIndex <= 0;
        if (next) next.disabled = activeIndex >= maxPage;
      };

      const syncFromScroll = () => {
        const perView = getSlidesPerView();
        const slideWidth = slides[0]?.offsetWidth || 1;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0');
        const approx = Math.round(track.scrollLeft / (slideWidth + gap));
        activeIndex = Math.min(Math.max(Math.floor(approx / perView), 0), getPageCount() - 1);
        updateDots();
        updateArrows();
      };

      buildDots();
      updateDots();
      updateArrows();

      if (prev) prev.onclick = () => goToPage(activeIndex - 1);
      if (next) next.onclick = () => goToPage(activeIndex + 1);
      track.onscroll = syncFromScroll;
    }

    const currentSection = document.getElementById('shopify-section-{{ section.id }}');
    if (currentSection) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => initSignature(currentSection));
      } else {
        initSignature(currentSection);
      }
    }

    document.addEventListener('shopify:section:load', (e) => {
      if (e.target && e.target.id === 'shopify-section-{{ section.id }}') {
        initSignature(e.target);
      }
    });
  })();
</script>

