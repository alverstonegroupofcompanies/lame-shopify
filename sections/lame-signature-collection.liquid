    --lame-sig-panel-bg: rgb(236 242 232);
    --lame-sig-panel-bg-soft: rgb(228 238 222);
    --lame-sig-panel-text: rgb(var(--lame-sig-forest));
    --lame-sig-panel-muted: rgb(var(--lame-sig-forest) / 0.72);
    --lame-sig-vector-green: rgb(var(--lame-sig-forest) / 0.22);
