{% liquid
  assign pickup_heading = section.settings.heading
  if pickup_heading == blank
    assign pickup_heading = 'Pick up at our shop within 1 hr after placing order'
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div
    class="lame-pickup-banner lame-pickup-banner--{{ section.settings.image_position }}"
    style="
      --lame-pickup-panel-bg: {{ section.settings.panel_background }};
      --lame-pickup-panel-border: {{ section.settings.panel_border }};
      --lame-pickup-chip-bg: {{ section.settings.chip_background }};
      --lame-pickup-chip-color: {{ section.settings.chip_text }};
      --lame-pickup-accent: {{ section.settings.accent_color }};
    "
  >
    <div class="lame-pickup-banner__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'lame-pickup-banner__image',
            loading: 'lazy',
            widths: '480,720,960,1280,1600,1800',
            sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'lame-pickup-banner__image placeholder-svg' }}
      {% endif %}
    </div>

    <div class="lame-pickup-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="lame-pickup-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h2 class="lame-pickup-banner__heading">{{ pickup_heading | escape }}</h2>

      {% if section.settings.description != blank %}
        <div class="lame-pickup-banner__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <ul class="lame-pickup-banner__meta list-unstyled" role="list">
        {% if section.settings.meta_one != blank %}
          <li class="lame-pickup-banner__chip">{{ section.settings.meta_one | escape }}</li>
        {% endif %}
        {% if section.settings.meta_two != blank %}
          <li class="lame-pickup-banner__chip">{{ section.settings.meta_two | escape }}</li>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <li>
            <a class="lame-pickup-banner__chip lame-pickup-banner__chip--action" href="{{ section.settings.button_link | default: routes.root_url }}">
              <svg class="lame-pickup-banner__chip-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/>
              </svg>
              <span>{{ section.settings.button_label | escape }}</span>
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-pickup-banner {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--lame-pickup-panel-bg, #f8fcf8);
    border: 1px solid var(--lame-pickup-panel-border, rgb(30 40 35 / 0.14));
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 28px rgb(18 22 20 / 0.08);
  }

  .lame-pickup-banner__media {
    min-height: clamp(220px, 42vw, 420px);
  }

  .lame-pickup-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lame-pickup-banner__content {
    display: grid;
    align-content: center;
    gap: 1rem;
    padding: clamp(1.2rem, 3.8vw, 2.35rem);
    background:
      radial-gradient(circle at 0% 0%, rgb(var(--brand-gold, 201 169 98) / 0.12), transparent 45%),
      linear-gradient(145deg, var(--lame-pickup-panel-bg, #f8fcf8) 0%, color-mix(in srgb, var(--lame-pickup-panel-bg, #f8fcf8) 82%, #dcecdf 18%) 100%);
  }

  .lame-pickup-banner__eyebrow {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--lame-pickup-accent, #24543f);
  }

  .lame-pickup-banner__heading {
    margin: 0;
    font-size: clamp(1.45rem, 3.2vw, 2.4rem);
    line-height: 1.06;
    letter-spacing: -0.015em;
    font-weight: 700;
    color: rgb(var(--color-foreground-rgb));
    max-width: 19ch;
  }

  .lame-pickup-banner__description {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / 0.82);
    font-size: 1rem;
    line-height: 1.55;
    max-width: 43ch;
  }

  .lame-pickup-banner__description p {
    margin: 0;
  }

  .lame-pickup-banner__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .lame-pickup-banner__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.38rem 0.7rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1;
    background: var(--lame-pickup-chip-bg, rgb(36 84 63 / 0.12));
    color: var(--lame-pickup-chip-color, #24543f);
  }

  .lame-pickup-banner__chip--action {
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--lame-pickup-chip-color, #6e3b12) 22%, transparent);
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .lame-pickup-banner__chip--action:hover {
    transform: translateY(-1px);
    filter: brightness(0.97);
  }

  .lame-pickup-banner__chip-icon {
    flex-shrink: 0;
    display: block;
  }

  @media screen and (min-width: 990px) {
    .lame-pickup-banner {
      grid-template-columns: 1fr 1fr;
    }

    /* Desktop only: keep left alignment, but move content inward */
    .lame-pickup-banner--image-right .lame-pickup-banner__content {
      padding-inline-start: clamp(1.8rem, 6vw, 5rem);
      padding-inline-end: clamp(1.1rem, 2.8vw, 2.4rem);
    }

    .lame-pickup-banner--image-right .lame-pickup-banner__media {
      order: 2;
    }

    .lame-pickup-banner--image-right .lame-pickup-banner__content {
      order: 1;
    }
  }

  @media screen and (max-width: 749px) {
    .lame-pickup-banner {
      border-radius: 14px;
    }

    .lame-pickup-banner__media {
      min-height: 210px;
    }

    .lame-pickup-banner__content {
      gap: 0.7rem;
      padding: 0.95rem;
    }

    .lame-pickup-banner__heading {
      font-size: clamp(1.05rem, 5.2vw, 1.35rem);
    }

    .lame-pickup-banner__description {
      font-size: 0.86rem;
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame pickup banner",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection", "index"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fast pickup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick up at our shop within 1 hr after placing order"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Order online and collect from our shop counter quickly. We'll notify you when your order is packed and ready.</p>"
    },
    {
      "type": "text",
      "id": "meta_one",
      "label": "Meta chip 1",
      "default": "Ready in 1 hour"
    },
    {
      "type": "text",
      "id": "meta_two",
      "label": "Meta chip 2",
      "default": "In-store pickup"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#f4faf4"
    },
    {
      "type": "color",
      "id": "panel_border",
      "label": "Panel border",
      "default": "#d5e6d9"
    },
    {
      "type": "color",
      "id": "chip_background",
      "label": "Chip background",
      "default": "#e5f3e8"
    },
    {
      "type": "color",
      "id": "chip_text",
      "label": "Chip text",
      "default": "#24543f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#24543f"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Lame pickup banner",
      "category": "Collection"
    }
  ]
}
{% endschema %}
