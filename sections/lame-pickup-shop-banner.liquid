{% liquid
  assign pickup_heading = section.settings.heading
  if pickup_heading == blank
    assign pickup_heading = 'Pick up at our shop within 1 hr after placing order'
  endif

  assign pickup_heading_html = pickup_heading | escape
  assign pickup_heading_html = pickup_heading_html | replace: '1 hr', '<span class="lame-pickup-banner__highlight">1 hr</span>'
  assign pickup_heading_html = pickup_heading_html | replace: '1 hour', '<span class="lame-pickup-banner__highlight">1 hour</span>'
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  <div
    class="lame-pickup-banner lame-pickup-banner--{{ section.settings.image_position }}"
    style="
      --lame-pickup-panel-bg: {{ section.settings.panel_background }};
      --lame-pickup-panel-border: {{ section.settings.panel_border }};
      --lame-pickup-chip-bg: {{ section.settings.chip_background }};
      --lame-pickup-chip-color: {{ section.settings.chip_text }};
      --lame-pickup-accent: {{ section.settings.accent_color }};
    "
  >
    <div class="lame-pickup-banner__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1800
          | image_tag:
            class: 'lame-pickup-banner__image',
            loading: 'lazy',
            widths: '480,720,960,1280,1600,1800',
            sizes: '(min-width: 990px) 50vw, 100vw'
        }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'lame-pickup-banner__image placeholder-svg' }}
      {% endif %}
    </div>

    <div class="lame-pickup-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="lame-pickup-banner__eyebrow">
          <span class="lame-pickup-banner__eyebrow-mark" aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      <h2 class="lame-pickup-banner__heading">{{ pickup_heading_html }}</h2>

      {% if section.settings.description != blank %}
        <div class="lame-pickup-banner__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <ul class="lame-pickup-banner__meta list-unstyled" role="list">
        {% if section.settings.meta_one != blank %}
          <li class="lame-pickup-banner__chip">{{ section.settings.meta_one | escape }}</li>
        {% endif %}
        {% if section.settings.meta_two != blank %}
          <li class="lame-pickup-banner__chip">{{ section.settings.meta_two | escape }}</li>
        {% endif %}
        {% if section.settings.button_label != blank %}
          <li>
            <a class="lame-pickup-banner__chip lame-pickup-banner__chip--action" href="{{ section.settings.button_link | default: routes.root_url }}">
              <svg class="lame-pickup-banner__chip-icon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/>
              </svg>
              <span>{{ section.settings.button_label | escape }}</span>
            </a>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .lame-pickup-banner {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--lame-pickup-panel-bg, #f8fcf8);
    border: 1px solid var(--lame-pickup-panel-border, rgb(30 40 35 / 0.14));
    border-radius: 22px;
    overflow: hidden;
    box-shadow:
      0 18px 48px rgb(18 22 20 / 0.1),
      0 2px 0 color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 35%, transparent);
  }

  .lame-pickup-banner__media {
    min-height: clamp(240px, 44vw, 460px);
    position: relative;
  }

  .lame-pickup-banner__media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--lame-pickup-panel-bg, #fff1cc) 55%, transparent) 0%,
      transparent 42%
    );
  }

  .lame-pickup-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lame-pickup-banner__content {
    position: relative;
    display: grid;
    align-content: center;
    gap: 1.15rem;
    padding: clamp(1.5rem, 4.2vw, 3rem);
    background:
      radial-gradient(ellipse 80% 70% at 0% 0%, color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 18%, transparent), transparent 55%),
      radial-gradient(circle at 100% 100%, rgb(var(--brand-gold, 201 169 98) / 0.16), transparent 48%),
      linear-gradient(
        155deg,
        var(--lame-pickup-panel-bg, #fff1cc) 0%,
        color-mix(in srgb, var(--lame-pickup-panel-bg, #fff1cc) 88%, #fff 12%) 55%,
        color-mix(in srgb, var(--lame-pickup-panel-bg, #fff1cc) 78%, #f0d9a0 22%) 100%
      );
  }

  .lame-pickup-banner__content::before {
    content: '';
    position: absolute;
    top: 1.25rem;
    bottom: 1.25rem;
    left: 0;
    width: 4px;
    border-radius: 0 4px 4px 0;
    background: linear-gradient(
      180deg,
      var(--lame-pickup-accent, #d07a22),
      color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 40%, #24543f)
    );
  }

  .lame-pickup-banner__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    margin: 0;
    padding: 0.42rem 0.85rem 0.42rem 0.65rem;
    border-radius: 999px;
    font-family: 'Jost', var(--lame-font-body, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lame-pickup-accent, #d07a22);
    background: color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 12%, #fff);
    border: 1px solid color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 28%, transparent);
  }

  .lame-pickup-banner__eyebrow-mark {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--lame-pickup-accent, #d07a22);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 22%, transparent);
    flex-shrink: 0;
  }

  .lame-pickup-banner__heading {
    margin: 0;
    font-family: 'Belleza', var(--font-heading--family), sans-serif;
    font-size: clamp(1.85rem, 4.2vw, 3.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    font-weight: 400;
    color: rgb(var(--color-foreground-heading-rgb, var(--color-foreground-rgb, 30 40 35)));
    max-width: 14ch;
    text-wrap: balance;
  }

  .lame-pickup-banner__highlight {
    color: var(--lame-pickup-accent, #d07a22);
    font-style: italic;
    white-space: nowrap;
  }

  .lame-pickup-banner__description {
    margin: 0;
    font-family: 'Jost', var(--lame-font-body, system-ui, sans-serif);
    color: rgb(var(--color-foreground-rgb) / 0.78);
    font-size: clamp(0.95rem, 1.4vw, 1.08rem);
    line-height: 1.6;
    max-width: 40ch;
    font-weight: 400;
  }

  .lame-pickup-banner__description p {
    margin: 0;
  }

  .lame-pickup-banner__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0.25rem 0 0;
    padding: 0;
  }

  .lame-pickup-banner__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    font-family: 'Jost', var(--lame-font-body, system-ui, sans-serif);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    background: var(--lame-pickup-chip-bg, rgb(36 84 63 / 0.12));
    color: var(--lame-pickup-chip-color, #24543f);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.45) inset;
  }

  .lame-pickup-banner__chip--action {
    text-decoration: none;
    color: #fff;
    background: linear-gradient(
      135deg,
      var(--lame-pickup-accent, #d07a22),
      color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 70%, #6e3b12)
    );
    border: none;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 35%, transparent);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, filter 0.2s ease;
  }

  .lame-pickup-banner__chip--action:hover {
    transform: translateY(-2px);
    filter: brightness(1.04);
    box-shadow: 0 12px 26px color-mix(in srgb, var(--lame-pickup-accent, #d07a22) 42%, transparent);
  }

  .lame-pickup-banner__chip-icon {
    flex-shrink: 0;
    display: block;
  }

  @media screen and (min-width: 990px) {
    .lame-pickup-banner {
      grid-template-columns: 1fr 1fr;
      min-height: 420px;
    }

    .lame-pickup-banner__media::after {
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--lame-pickup-panel-bg, #fff1cc) 40%, transparent) 0%,
        transparent 28%
      );
    }

    .lame-pickup-banner--image-right .lame-pickup-banner__content {
      padding-inline-start: clamp(2.25rem, 6.5vw, 5.5rem);
      padding-inline-end: clamp(1.4rem, 3vw, 2.8rem);
    }

    .lame-pickup-banner--image-right .lame-pickup-banner__media {
      order: 2;
    }

    .lame-pickup-banner--image-right .lame-pickup-banner__content {
      order: 1;
    }

    .lame-pickup-banner--image-left .lame-pickup-banner__media::after {
      background: linear-gradient(
        to left,
        color-mix(in srgb, var(--lame-pickup-panel-bg, #fff1cc) 40%, transparent) 0%,
        transparent 28%
      );
    }
  }

  @media screen and (max-width: 749px) {
    .lame-pickup-banner {
      border-radius: 16px;
    }

    .lame-pickup-banner__media {
      min-height: 220px;
    }

    .lame-pickup-banner__content {
      gap: 0.9rem;
      padding: 1.25rem 1.15rem 1.35rem 1.35rem;
    }

    .lame-pickup-banner__content::before {
      top: 1rem;
      bottom: 1rem;
      width: 3px;
    }

    .lame-pickup-banner__heading {
      font-size: clamp(1.55rem, 7.2vw, 1.95rem);
      max-width: 16ch;
    }

    .lame-pickup-banner__description {
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .lame-pickup-banner__chip {
      padding: 0.48rem 0.8rem;
      font-size: 0.72rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame pickup banner",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["collection", "index"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position (desktop)",
      "options": [
        { "value": "image-left", "label": "Left" },
        { "value": "image-right", "label": "Right" }
      ],
      "default": "image-right"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fast pickup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick up at our shop within 1 hr after placing order"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Order online and collect from our shop counter quickly. We'll notify you when your order is packed and ready.</p>"
    },
    {
      "type": "text",
      "id": "meta_one",
      "label": "Meta chip 1",
      "default": "Ready in 1 hour"
    },
    {
      "type": "text",
      "id": "meta_two",
      "label": "Meta chip 2",
      "default": "In-store pickup"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get directions"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "panel_background",
      "label": "Panel background",
      "default": "#f4faf4"
    },
    {
      "type": "color",
      "id": "panel_border",
      "label": "Panel border",
      "default": "#d5e6d9"
    },
    {
      "type": "color",
      "id": "chip_background",
      "label": "Chip background",
      "default": "#e5f3e8"
    },
    {
      "type": "color",
      "id": "chip_text",
      "label": "Chip text",
      "default": "#24543f"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#24543f"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Lame pickup banner",
      "category": "Collection"
    }
  ]
}
{% endschema %}
