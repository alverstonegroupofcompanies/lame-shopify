            { "value": "Himalaya", "label": "Himalaya" },
            { "value": "Indulekha", "label": "Indulekha" },
            { "value": "Jovees Herbal", "label": "Jovees Herbal" },
            { "value": "Korean", "label": "Korean" },
            { "value": "Lakme", "label": "Lakme" },
            { "value": "Lifebuoy", "label": "Lifebuoy" },
            { "value": "Lotus", "label": "Lotus" },
            { "value": "Lux", "label": "Lux" },
            { "value": "Mamaearth", "label": "Mamaearth" },
            { "value": "Pears", "label": "Pears" },
