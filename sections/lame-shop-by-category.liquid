<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div class="lame-shop-cat spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-shop-cat__header">
        {% if section.settings.heading != blank %}
          <h2 class="lame-shop-cat__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lame-shop-cat__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <ul class="lame-shop-cat__grid" role="list">
      {% for block in section.blocks %}
        {% liquid
          assign coll = block.settings.collection
          assign has_manual_title = block.settings.title != blank
          assign has_manual_image = block.settings.image != blank
          assign has_manual_link = block.settings.link != blank
          assign has_manual_content = has_manual_title or has_manual_image or has_manual_link
          assign tile_title = block.settings.title | default: coll.title
          assign tile_url = block.settings.link | default: coll.url
          assign tile_image = block.settings.image | default: coll.featured_image
        %}
        {% if coll == blank and has_manual_content == false %}
          {% if request.design_mode %}
            <li class="lame-shop-cat__item" {{ block.shopify_attributes }}>
              <div class="lame-shop-cat__tile lame-shop-cat__tile--placeholder">
                <span class="lame-shop-cat__placeholder-label">Select a collection</span>
              </div>
            </li>
          {% endif %}
          {% continue %}
        {% endif %}

        <li class="lame-shop-cat__item" {{ block.shopify_attributes }}>
          {% if tile_url != blank %}
            <a class="lame-shop-cat__tile" href="{{ tile_url }}">
          {% else %}
            <div class="lame-shop-cat__tile">
          {% endif %}
              <div class="lame-shop-cat__media">
                {% if tile_image %}
                  {{
                    tile_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'lame-shop-cat__image',
                      loading: 'lazy',
                      widths: '200,360,480,640,800',
                      sizes: '(min-width: 990px) 18vw, (min-width: 750px) 28vw, 44vw'
                  }}
                {% else %}
                  {{ 'detailed-apparel-1' | placeholder_svg_tag: 'lame-shop-cat__image placeholder-svg' }}
                {% endif %}
              </div>
              <span class="lame-shop-cat__label">{{ tile_title | default: 'Category' }}</span>
          {% if tile_url != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lame-shop-cat__header {
    text-align: left;
    margin-bottom: 0.9rem;
  }

  .lame-shop-cat__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-shop-cat__subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 52ch;
  }

  .lame-shop-cat__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 1080px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .lame-shop-cat__tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 0;
    overflow: hidden;
    background: rgb(var(--color-background-rgb));
    transition: transform 180ms ease, border-color 180ms ease;
  }

  .lame-shop-cat__tile:is(:hover, :focus-visible) {
    transform: translateY(-2px);
    border-color: rgb(var(--color-foreground-rgb) / 0.3);
  }

  .lame-shop-cat__media {
    aspect-ratio: 4 / 3;
    background: rgb(var(--color-foreground-rgb) / 0.03);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .lame-shop-cat__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lame-shop-cat__label {
    display: block;
    padding: 0.72rem 0.6rem;
    background: rgb(var(--color-background-rgb));
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    text-align: center;
    font-size: 0.82rem;
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / 0.92);
    font-weight: 700;
  }

  .lame-shop-cat__tile--placeholder {
    min-height: 140px;
    align-items: center;
    justify-content: center;
    border-style: dashed;
    color: rgb(var(--color-foreground-rgb) / 0.45);
    font-size: 0.75rem;
    padding: 1rem;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .lame-shop-cat__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.85rem;
    }
  }

  @media screen and (min-width: 990px) {
    .lame-shop-cat__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lame Shop by category",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a collection to browse products."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 7,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "Skin Care" } },
        { "type": "category", "settings": { "title": "Hair Care" } },
        { "type": "category", "settings": { "title": "Make Up" } },
        { "type": "category", "settings": { "title": "Bath & Body" } },
        { "type": "category", "settings": { "title": "Fragrance" } },
        { "type": "category", "settings": { "title": "Wellness" } },
        { "type": "category", "settings": { "title": "Mom & Baby" } }
      ]
    }
  ]
}
{% endschema %}
