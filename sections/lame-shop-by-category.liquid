{% liquid
  assign cat_tile_width = section.settings.category_tile_width | default: 170
  assign cat_gap = 10
  assign heading_align = section.settings.heading_alignment | default: 'left'
  if section.settings.auto_slide == true
    assign shop_cat_auto_slide = true
  elsif section.settings.auto_slide == false
    assign shop_cat_auto_slide = false
  else
    assign shop_cat_auto_slide = true
  endif
  if section.settings.pause_auto_slide_on_hover == false
    assign shop_cat_pause_hover = false
  else
    assign shop_cat_pause_hover = true
  endif
%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}">
  <div
    class="lame-shop-cat spacing-style"
    style="{% render 'spacing-padding', settings: section.settings %}"
    data-auto-slide="{% if shop_cat_auto_slide %}true{% else %}false{% endif %}"
    data-auto-slide-interval="{{ section.settings.auto_slide_interval | default: 5 }}"
    data-pause-auto-slide-on-hover="{% if shop_cat_pause_hover %}true{% else %}false{% endif %}"
  >
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="lame-shop-cat__header lame-shop-cat__header--align-{{ heading_align }}" data-lame-reveal>
        {% if section.settings.heading != blank %}
          <h2 class="lame-shop-cat__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="lame-shop-cat__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </header>
    {% endif %}

    <div class="lame-shop-cat__carousel-wrap">
    <div
      class="lame-shop-cat__viewport"
      style="--lame-cat-tile-width: {{ cat_tile_width }}px; --lame-cat-gap: {{ cat_gap }}px;"
    >
    <ul class="lame-shop-cat__track" role="list" data-lame-shop-cat-track>
      {% for block in section.blocks %}
        {% liquid
          assign coll = block.settings.collection
          assign tile_caption = block.settings.caption
          if block.settings.title != blank
            assign tile_title = block.settings.title
          else
            assign tile_title = coll.title
          endif
          if block.settings.link != blank
            assign tile_url = block.settings.link
          else
            assign tile_url = coll.url
          endif
          if block.settings.image != blank
            assign tile_image = block.settings.image
          else
            assign tile_image = coll.featured_image
          endif
        %}
        {% if coll == blank %}
          {% if request.design_mode %}
            <li class="lame-shop-cat__item" {{ block.shopify_attributes }}>
              <div class="lame-shop-cat__tile lame-shop-cat__tile--placeholder">
                <div class="lame-shop-cat__media lame-shop-cat__media--placeholder">
                  <span class="lame-shop-cat__media-shade" aria-hidden="true"></span>
                  <span class="lame-shop-cat__title-on-image">{{ section.settings.placeholder_collection_text }}</span>
                </div>
              </div>
            </li>
          {% endif %}
          {% continue %}
        {% endif %}

        <li
          class="lame-shop-cat__item"
          data-lame-reveal
          data-lame-delay="{{ forloop.index0 | modulo: 4 }}"
          {{ block.shopify_attributes }}
        >
          <a class="lame-shop-cat__tile" href="{{ tile_url }}">
            <div class="lame-shop-cat__media">
              {% if tile_image %}
                {{
                  tile_image
                  | image_url: width: 800
                  | image_tag:
                    class: 'lame-shop-cat__image',
                    loading: 'lazy',
                    widths: '120,200,360,480,640,800',
                    sizes: '(max-width: 749px) min(42vw, {{ cat_tile_width | times: 2 }}px), {{ cat_tile_width }}px'
                }}
              {% else %}
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'lame-shop-cat__image lame-shop-cat__placeholder-svg placeholder-svg' }}
              {% endif %}
              <span class="lame-shop-cat__media-shade" aria-hidden="true"></span>
              <span class="lame-shop-cat__title-on-image">{{ tile_title }}</span>
            </div>
          </a>
          {% if tile_caption != blank %}
            <p class="lame-shop-cat__caption">{{ tile_caption }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    </div>
      <div class="lame-shop-cat__controls" data-shop-cat-controls hidden>
        <button
          class="lame-shop-cat__ctrl-arrow lame-shop-cat__ctrl-arrow--prev"
          type="button"
          aria-label="{{ section.settings.prev_category_label }}"
          data-arrow="prev"
        >
          <span aria-hidden="true">&#8249;</span>
        </button>
        <div class="lame-shop-cat__progress-track" aria-hidden="true">
          <div class="lame-shop-cat__progress-fill" data-shop-cat-progress-fill></div>
        </div>
        <button
          class="lame-shop-cat__ctrl-arrow lame-shop-cat__ctrl-arrow--next"
          type="button"
          aria-label="{{ section.settings.next_category_label }}"
          data-arrow="next"
        >
          <span aria-hidden="true">&#8250;</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    const revealNodes = section.querySelectorAll('[data-lame-reveal]');
    if (!revealNodes.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
      );
      revealNodes.forEach((node) => observer.observe(node));
    } else {
      revealNodes.forEach((node) => node.classList.add('is-visible'));
    }
  })();
</script>

<script>
  (() => {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const root = sectionEl.querySelector('.lame-shop-cat');
    const track = sectionEl.querySelector('[data-lame-shop-cat-track]');
    if (!root || !track) return;

    const autoSlide = root.dataset.autoSlide === 'true';
    const intervalSec = Math.max(3, parseInt(root.dataset.autoSlideInterval || '5', 10));
    const pauseOnHover = root.dataset.pauseAutoSlideOnHover !== 'false';

    if (!autoSlide) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let timerId = null;
    let isPaused = false;
    let isInView = false;

    const getStepPx = () => {
      const first = track.querySelector('.lame-shop-cat__item');
      if (!first) return 0;
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return first.offsetWidth + gap;
    };

    const step = () => {
      if (isPaused || !isInView) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 4) return;

      const amount = getStepPx();
      if (amount <= 0) return;

      if (track.scrollLeft + track.clientWidth >= maxScroll - 3) {
        track.scrollTo({ left: 0, behavior: 'auto' });
      } else {
        track.scrollBy({ left: amount, behavior: 'smooth' });
      }
    };

    const start = () => {
      stop();
      timerId = window.setInterval(step, intervalSec * 1000);
    };

    const stop = () => {
      if (timerId != null) {
        window.clearInterval(timerId);
        timerId = null;
      }
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isInView = entry.isIntersecting;
            if (!isInView) {
              stop();
            } else if (!timerId) {
              start();
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px' }
      );
      io.observe(sectionEl);
    }

    if (pauseOnHover) {
      track.addEventListener('mouseenter', () => {
        isPaused = true;
      });
      track.addEventListener('mouseleave', () => {
        isPaused = false;
      });
      track.addEventListener('focusin', () => {
        isPaused = true;
      });
      track.addEventListener('focusout', () => {
        isPaused = false;
      });
    }

    if (!('IntersectionObserver' in window)) {
      isInView = true;
      start();
    }

    window.addEventListener('resize', () => {
      if (track.scrollWidth - track.clientWidth <= 4) {
        stop();
      } else if (!timerId && isInView) {
        start();
      }
    });
  })();
</script>

{% stylesheet %}
  .lame-shop-cat__header {
    text-align: center;
    margin-bottom: var(--padding-md);
  }

  .lame-shop-cat__title {
    margin: 0;
    color: rgb(var(--brand-gold));
    font-family: var(--lame-font-display, var(--font-heading--family));
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.15;
  }

  .lame-shop-cat__subtitle {
    margin: 0.35rem 0 0;
    font-size: 0.78rem;
    color: rgb(var(--color-foreground-rgb) / 0.65);
    max-width: 42ch;
    margin-inline: auto;
  }

  .lame-shop-cat__viewport {
    max-width: 1080px;
    margin-inline: auto;
  }

  .lame-shop-cat__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--lame-cat-gap, 10px);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .lame-shop-cat__track::-webkit-scrollbar {
    display: none;
  }

  .lame-shop-cat__item {
    flex: 0 0 var(--lame-cat-tile-width, 120px);
    width: var(--lame-cat-tile-width, 120px);
    max-width: min(var(--lame-cat-tile-width, 120px), calc(100vw - 2.5rem));
    min-width: 0;
    scroll-snap-align: start;
  }

  .lame-shop-cat__tile {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgb(var(--brand-gold) / 0.32);
    border-radius: var(--lame-radius-card, 10px);
    overflow: hidden;
    background: rgb(var(--color-background-rgb));
    box-shadow: var(--lame-shadow-soft);
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .lame-shop-cat__tile:is(:hover, :focus-visible) {
    transform: translateY(-2px);
    border-color: rgb(var(--brand-gold) / 0.55);
    box-shadow: 0 10px 22px rgb(18 18 18 / 0.08);
  }

  .lame-shop-cat__media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: rgb(var(--brand-gold) / 0.06);
    overflow: hidden;
  }

  .lame-shop-cat__media--placeholder {
    background: rgb(var(--brand-gold) / 0.08);
  }

  .lame-shop-cat__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lame-shop-cat__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
  }

  .lame-shop-cat__label-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    z-index: 1;
    padding: 0.5rem 0.45rem 0.55rem;
    box-sizing: border-box;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.78) 0%,
      rgb(0 0 0 / 0.45) 55%,
      transparent 100%
    );
  }

  .lame-shop-cat__label {
    display: block;
    width: 100%;
    text-align: center;
    font-size: 0.64rem;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    font-weight: 600;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
  }

  .lame-shop-cat__tile--placeholder {
    border-style: dashed;
  }

{% endstylesheet %}

{% schema %}
{
  "name": "Lame Shop by category",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a collection to browse products."
    },
    {
      "type": "text",
      "id": "placeholder_collection_text",
      "label": "Placeholder text when no collection selected",
      "default": "Select a collection"
    },
    {
      "type": "header",
      "content": "Category carousel"
    },
    {
      "type": "range",
      "id": "category_tile_width",
      "label": "Category tile width",
      "min": 110,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 120
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Auto-advance carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "auto_slide_interval",
      "label": "Auto-advance interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "pause_auto_slide_on_hover",
      "label": "Pause auto-advance on hover or keyboard focus",
      "default": true
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 96,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Leave empty to use the selected collection page (recommended). Only set this if you need a custom destination URL."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lame Shop by category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
