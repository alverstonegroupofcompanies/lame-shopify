{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [id_prefix] - Unique prefix to avoid duplicate IDs when rendered multiple times.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical', id_prefix: 'dialog' %}
{%- enddoc -%}

{%- liquid
  assign is_horizontal = false
  assign is_vertical = false
  if filter_style == 'horizontal'
    assign is_horizontal = true
  elsif filter_style == 'vertical'
    assign is_vertical = true
  endif
-%}
{% capture accordion_children %}
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span class="facets__label">{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        data-range-max="{{ filter.range_max }}"
        on:change="/updatePriceFilterAndResults"
      >
        {% liquid
          assign slider_max_raw = filter.range_max | money_without_currency
          assign slider_max = slider_max_raw | plus: 99 | divided_by: 100 | times: 100
          assign slider_min_value = 0
          if filter.min_value.value != null
            assign slider_min_raw = filter.min_value.value | money_without_currency
            assign slider_min_value = slider_min_raw | plus: 50 | divided_by: 100 | times: 100
          endif
          assign slider_max_value = slider_max
          if filter.max_value.value != null
            assign slider_max_raw_selected = filter.max_value.value | money_without_currency
            assign slider_max_value = slider_max_raw_selected | plus: 50 | divided_by: 100 | times: 100
          endif
        %}
        <div class="price-facet__range" ref="rangeSlider">
          <div class="price-facet__range-track-wrap">
            <div class="price-facet__range-thumb-labels" aria-hidden="true">
              <span class="price-facet__range-thumb-label price-facet__range-thumb-label--min" ref="minRangeLabel"></span>
              <span class="price-facet__range-thumb-label price-facet__range-thumb-label--max" ref="maxRangeLabel"></span>
            </div>
            <div class="price-facet__range-track" aria-hidden="true">
              <div class="price-facet__range-fill" ref="rangeFill"></div>
            </div>
            <input
              type="range"
              class="price-facet__range-input price-facet__range-input--min"
              ref="minRange"
              min="0"
              max="{{ slider_max }}"
              step="100"
              value="{{ slider_min_value }}"
              aria-label="{{ 'accessibility.price_filter_low' | t }}"
            >
            <input
              type="range"
              class="price-facet__range-input price-facet__range-input--max"
              ref="maxRange"
              min="0"
              max="{{ slider_max }}"
              step="100"
              value="{{ slider_max_value }}"
              aria-label="{{ 'accessibility.price_filter_high' | t }}"
            >
          </div>
          <div class="price-facet__range-bounds" aria-hidden="true">
            <span class="price-facet__range-bound price-facet__range-bound--min" ref="rangeMinBound">
              {{- 0 | money | strip_html -}}
            </span>
            <span class="price-facet__range-bound price-facet__range-bound--max" ref="rangeMaxBound">
              {{- filter.range_max | money | strip_html -}}
            </span>
          </div>
        </div>

        <div class="facets__inputs-wrapper facets__inputs-wrapper--row visually-hidden">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_low' | t }}"
                on:input="/handlePriceInput"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
                aria-label="{{ 'accessibility.price_filter_high' | t }}"
                on:input="/handlePriceInput"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE-{{ id_prefix }}"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = filter.range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_children,
  class: 'facets__item',
  open: is_vertical,
  open_by_default_on_desktop: is_vertical,
  open_by_default_on_mobile: is_vertical,
  disable_animation_on_desktop: is_horizontal,
  close_with_escape: is_horizontal
%}

{% stylesheet %}
  /* Price filter */
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }

  .price-facet__range {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.35rem var(--padding-xs) 0.85rem;
  }

  .price-facet__range-track-wrap {
    position: relative;
    height: 1.5rem;
    margin-top: 1.65rem;
  }

  .price-facet__range-thumb-labels {
    position: absolute;
    inset: 0;
    top: -1.65rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .price-facet__range-thumb-label {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--color-foreground);
    white-space: nowrap;
  }

  .price-facet__range-bounds {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.2;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .price-facet__range-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 0.35rem;
    border-radius: 999px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .price-facet__range-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    border-radius: inherit;
    background: rgb(var(--color-foreground-rgb) / 0.42);
  }

  .price-facet__range-input {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5rem;
    margin: 0;
    padding: 0;
    background: none;
    pointer-events: none;
    appearance: none;
    transform: translateY(-50%);
  }

  .price-facet__range-input::-webkit-slider-thumb {
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 2px solid #fff;
    background: rgb(var(--color-foreground-rgb) / 0.88);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
    cursor: grab;
    pointer-events: auto;
  }

  .price-facet__range-input::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 2px solid #fff;
    background: rgb(var(--color-foreground-rgb) / 0.88);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
    cursor: grab;
    pointer-events: auto;
  }

  .price-facet__range-input::-webkit-slider-runnable-track,
  .price-facet__range-input::-moz-range-track {
    height: 0.35rem;
    background: transparent;
    border: 0;
  }

  .price-facet__range-input--min {
    z-index: 3;
  }

  .price-facet__range-input--max {
    z-index: 4;
  }

  .price-facet__inputs-wrapper {
    padding-top: 0;
  }
{% endstylesheet %}
