{%- doc -%}
  Brand / vendor sidebar facet for Our Products collection pages.
  Vendors are deduplicated by slug so Femisafe / FEMISAFE appear once.

  @param {object} collection
  @param {string} section_id
  @param {string} [filter_style] - vertical | horizontal
  @param {string} [id_prefix] - unique id segment (e.g. desktop, dialog)
{%- enddoc -%}

{% liquid
  assign filter_style = filter_style | default: 'vertical'
  assign id_prefix = id_prefix | default: filter_style
  assign vendor_filter = blank

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      break
    endif
  endfor

  assign vendor_entries = ''
  assign vendor_slugs_seen = '|'

  for vendor_name in collection.all_vendors
    assign raw_vendor = vendor_name | strip
    if raw_vendor == blank
      continue
    endif

    capture vendor_slug_capture
      render 'lame-vendor-slug', vendor: raw_vendor
    endcapture
    assign vendor_slug = vendor_slug_capture | strip
    assign slug_token = '|' | append: vendor_slug | append: '|'

    unless vendor_slugs_seen contains slug_token
      assign vendor_slugs_seen = vendor_slugs_seen | append: vendor_slug | append: '|'

      assign display_label = raw_vendor
      assign filter_value = raw_vendor
      assign facet_count = blank
      assign is_checked = false
      assign raw_down = raw_vendor | downcase

      if raw_down contains 'lamstone'
        assign display_label = 'Lamstone Healthcare'
      endif

      if vendor_filter != blank
        for value in vendor_filter.values
          capture value_slug_capture
            render 'lame-vendor-slug', vendor: value.label
          endcapture
          assign value_slug = value_slug_capture | strip
          assign value_label_down = value.label | downcase
          assign value_value_down = value.value | downcase

          if value_slug == vendor_slug or value_label_down == raw_down or value_value_down == raw_down
            assign display_label = value.label
            assign filter_value = value.value
            assign facet_count = value.count
            break
          endif
        endfor

        for value in vendor_filter.active_values
          capture active_slug_capture
            render 'lame-vendor-slug', vendor: value.label
          endcapture
          assign active_slug = active_slug_capture | strip
          if active_slug == vendor_slug or value.label == raw_vendor or value.value == raw_vendor
            assign is_checked = true
            break
          endif
        endfor
      endif

      if facet_count != blank and facet_count > 0
        assign display_label = display_label | append: ' (' | append: facet_count | append: ')'
      endif

      if is_checked
        assign checked_token = 'true'
      else
        assign checked_token = 'false'
      endif

      assign vendor_entries = vendor_entries | append: vendor_slug | append: '~~' | append: display_label | append: '~~' | append: filter_value | append: '~~' | append: checked_token | append: '||'
    endunless
  endfor

  assign vendor_entry_list = vendor_entries | split: '||'
  assign active_vendor_count = 0
  if vendor_filter != blank
    assign active_vendor_count = vendor_filter.active_values.size
  endif
%}

{% if vendor_entries != blank %}
  <details
    id="Facet-Details-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
    class="facets__panel"
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ 'lame_collection.filter_brand' | t }}</span>
      <div class="facets__status-wrapper">
        <facet-status-component class="facets__status" facet-type="list" data-filter-style="{{ filter_style }}">
          <span
            class="{% if active_vendor_count > 0 %}bubble facets__bubble{% endif %} hide-when-empty"
            ref="facetStatus"
          >
            {%- if active_vendor_count > 0 -%}
              {{- active_vendor_count -}}
            {%- endif -%}
          </span>
        </facet-status-component>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </summary>

    <floating-panel-component
      data-disable-float-position="true"
      class="facets__inputs facets__panel-content details-content"
      id="facet-inputs-filter-p-vendor-{{ id_prefix }}"
    >
      <facet-inputs-component
        data-lame-vendor-filter
        id="facet-inputs-component-filter-p-vendor-{{ id_prefix }}"
      >
        <div class="facets__inputs-wrapper">
          <ul
            id="filters-list-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
            class="facets__inputs-list list-unstyled"
            name="{{ 'lame_collection.filter_brand' | t }}"
          >
            {% for entry in vendor_entry_list %}
              {% if entry == blank %}
                {% continue %}
              {% endif %}

              {% liquid
                assign entry_parts = entry | split: '~~'
                assign brand_slug = entry_parts[0]
                assign display_label = entry_parts[1]
                assign filter_value = entry_parts[2]
                assign is_checked = false
                if entry_parts[3] == 'true'
                  assign is_checked = true
                endif

                assign input_id = 'Filter-filter-p-vendor-' | append: forloop.index | append: '-' | append: id_prefix
                assign vendor_form_id = 'FacetFiltersForm--' | append: section_id | append: '-desktop'
                if id_prefix == 'dialog'
                  assign vendor_form_id = 'FacetFiltersForm--' | append: section_id | append: '-overflow'
                endif
              %}

              <li class="facets__inputs-list-item">
                <div class="checkbox">
                  <input
                    type="checkbox"
                    name="filter.p.vendor"
                    value="{{ filter_value | escape }}"
                    id="{{ input_id }}"
                    class="checkbox__input"
                    form="{{ vendor_form_id }}"
                    data-label="{{ display_label | escape }}"
                    data-brand="{{ filter_value | escape }}"
                    data-brand-slug="{{ brand_slug }}"
                    {% if is_checked %}
                      checked
                    {% endif %}
                    ref="facetInputs[]"
                  >
                  <label class="checkbox__label" for="{{ input_id }}">
                    {{ 'icon-checkmark.svg' | inline_asset_content }}
                    <span class="checkbox__label-text">{{ display_label }}</span>
                  </label>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </facet-inputs-component>
    </floating-panel-component>
  </details>
{% endif %}
