{%- doc -%}
  Brand filter for Our Products — server-side filtering via filter.p.vendor only.
  Lists every vendor in the collection; uses Search & Discovery facet values for counts and exact filter strings.

  @param {object} collection
  @param {string} section_id
  @param {string} [filter_style] - vertical | horizontal
  @param {string} [id_prefix] - unique id segment (e.g. desktop, dialog)
{%- enddoc -%}

{% liquid
  assign filter_style = filter_style | default: 'vertical'
  assign id_prefix = id_prefix | default: filter_style
  assign vendor_filter = blank
  assign brand_keys_seen = '|'
  assign brand_entries = ''

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      break
    endif
  endfor
%}

{% comment %} Primary source: every vendor in this collection {% endcomment %}
{% for vendor_name in collection.all_vendors %}
  {% liquid
    assign vendor_name_stripped = vendor_name | strip
    if vendor_name_stripped == blank
      continue
    endif

    assign vendor_key = vendor_name_stripped | downcase
    assign key_token = '|' | append: vendor_key | append: '|'
    if brand_keys_seen contains key_token
      continue
    endif
    assign brand_keys_seen = brand_keys_seen | append: vendor_key | append: '|'

    assign display_label = vendor_name_stripped
    assign filter_value = vendor_name_stripped
    assign product_count = ''
    assign is_checked = false
    assign vendor_down = vendor_name_stripped | downcase

    if vendor_down contains 'lamstone'
      assign display_label = 'Lamstone Healthcare'
    endif

    if vendor_filter != blank
      for value in vendor_filter.values
        assign facet_label = value.label | strip
        assign facet_value = value.value | strip
        assign facet_label_down = facet_label | downcase
        assign facet_value_down = facet_value | downcase

        if facet_label_down == vendor_down or facet_value_down == vendor_down
          assign display_label = facet_label
          if vendor_down contains 'lamstone'
            assign display_label = 'Lamstone Healthcare'
          endif
          assign filter_value = facet_value
          assign product_count = value.count
          if value.active
            assign is_checked = true
          endif
          break
        endif
      endfor

      unless is_checked
        for value in vendor_filter.active_values
          assign facet_label_down = value.label | strip | downcase
          assign facet_value_down = value.value | strip | downcase
          if facet_label_down == vendor_down or facet_value_down == vendor_down
            assign is_checked = true
            assign filter_value = value.value
            break
          endif
        endfor
      endunless
    endif

    assign checked_token = 'false'
    if is_checked
      assign checked_token = 'true'
    endif

    assign brand_entries = brand_entries | append: vendor_key | append: '~~' | append: display_label | append: '~~' | append: filter_value | append: '~~' | append: checked_token | append: '~~' | append: product_count | append: '||'
  %}
{% endfor %}

{% comment %} Include any facet brands missing from all_vendors {% endcomment %}
{% if vendor_filter != blank %}
  {% for value in vendor_filter.values %}
    {% liquid
      assign facet_label = value.label | strip
      if facet_label == blank
        continue
      endif

      assign facet_value = value.value | strip
      assign vendor_key = facet_label | downcase
      assign key_token = '|' | append: vendor_key | append: '|'

      unless brand_keys_seen contains key_token
        assign brand_keys_seen = brand_keys_seen | append: vendor_key | append: '|'

        assign display_label = facet_label
        assign filter_value = facet_value
        assign product_count = value.count
        assign checked_token = 'false'
        if value.active
          assign checked_token = 'true'
        endif

        assign facet_label_down = facet_label | downcase
        if facet_label_down contains 'lamstone'
          assign display_label = 'Lamstone Healthcare'
        endif

        assign brand_entries = brand_entries | append: vendor_key | append: '~~' | append: display_label | append: '~~' | append: filter_value | append: '~~' | append: checked_token | append: '~~' | append: product_count | append: '||'
      endunless
    %}
  {% endfor %}
{% endif %}

{% liquid
  assign brand_entry_list = brand_entries | split: '||'
  assign active_vendor_count = 0
  if vendor_filter != blank
    assign active_vendor_count = vendor_filter.active_values.size
  endif
%}

{% if brand_entries != blank %}
  <details
    id="Facet-Details-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
    class="facets__panel"
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ 'lame_collection.filter_brand' | t }}</span>
      <div class="facets__status-wrapper">
        <facet-status-component class="facets__status" facet-type="list" data-filter-style="{{ filter_style }}">
          <span
            class="{% if active_vendor_count > 0 %}bubble facets__bubble{% endif %} hide-when-empty"
            ref="facetStatus"
          >
            {%- if active_vendor_count > 0 -%}
              {{- active_vendor_count -}}
            {%- endif -%}
          </span>
        </facet-status-component>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </summary>

    <floating-panel-component
      data-disable-float-position="true"
      class="facets__inputs facets__panel-content details-content"
      id="facet-inputs-filter-p-vendor-{{ id_prefix }}"
    >
      <facet-inputs-component
        data-lame-vendor-filter
        id="facet-inputs-component-filter-p-vendor-{{ id_prefix }}"
      >
        <div class="facets__inputs-wrapper">
          <ul
            id="filters-list-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
            class="facets__inputs-list list-unstyled"
            name="{{ 'lame_collection.filter_brand' | t }}"
          >
            {% for entry in brand_entry_list %}
              {% if entry == blank %}
                {% continue %}
              {% endif %}

              {% liquid
                assign entry_parts = entry | split: '~~'
                assign brand_key = entry_parts[0]
                assign display_label = entry_parts[1]
                assign filter_value = entry_parts[2]
                assign is_checked = false
                if entry_parts[3] == 'true'
                  assign is_checked = true
                endif
                assign product_count = entry_parts[4]

                assign input_id = 'Filter-filter-p-vendor-' | append: forloop.index | append: '-' | append: id_prefix
                assign vendor_form_id = 'FacetFiltersForm--' | append: section_id | append: '-desktop'
                if id_prefix == 'dialog'
                  assign vendor_form_id = 'FacetFiltersForm--' | append: section_id | append: '-overflow'
                endif

                if product_count != blank and product_count != '' and product_count > 0
                  assign label_with_count = display_label | append: ' (' | append: product_count | append: ')'
                else
                  assign label_with_count = display_label
                endif
              %}

              <li class="facets__inputs-list-item">
                <div class="checkbox">
                  <input
                    type="checkbox"
                    name="filter.p.vendor"
                    value="{{ filter_value | escape }}"
                    id="{{ input_id }}"
                    class="checkbox__input"
                    form="{{ vendor_form_id }}"
                    data-label="{{ label_with_count | escape }}"
                    data-brand-key="{{ brand_key }}"
                    {% if is_checked %}
                      checked
                    {% endif %}
                    ref="facetInputs[]"
                  >
                  <label class="checkbox__label" for="{{ input_id }}">
                    {{ 'icon-checkmark.svg' | inline_asset_content }}
                    <span class="checkbox__label-text">{{ label_with_count }}</span>
                  </label>
                </div>
              </li>
            {% endfor %}
          </ul>
        </div>
      </facet-inputs-component>
    </floating-panel-component>
  </details>
{% endif %}
