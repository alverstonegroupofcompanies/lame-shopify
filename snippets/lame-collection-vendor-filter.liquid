{%- doc -%}
  Brand / vendor sidebar facet for Our Products collection pages.
  Lists all vendors in the collection (collection.all_vendors) plus shop vendors,
  merged with Shopify facet data when available.

  @param {object} collection
  @param {string} section_id
  @param {string} [filter_style] - vertical | horizontal
{%- enddoc -%}

{% liquid
  assign filter_style = filter_style | default: 'vertical'
  assign vendor_filter = blank

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      break
    endif
  endfor

  assign vendor_labels_pipe = '||'

  for vendor_name in collection.all_vendors
    assign raw_vendor = vendor_name | strip
    if raw_vendor != blank
      assign label_token = '||' | append: raw_vendor | append: '||'
      unless vendor_labels_pipe contains label_token
        assign vendor_labels_pipe = vendor_labels_pipe | append: raw_vendor | append: '||'
      endunless
    endif
  endfor

  for vendor_name in shop.vendors
    assign raw_vendor = vendor_name | strip
    if raw_vendor != blank
      assign label_token = '||' | append: raw_vendor | append: '||'
      unless vendor_labels_pipe contains label_token
        assign vendor_labels_pipe = vendor_labels_pipe | append: raw_vendor | append: '||'
      endunless
    endif
  endfor

  if vendor_filter != blank
    for value in vendor_filter.values
      assign raw_vendor = value.label | strip
      if raw_vendor != blank
        assign label_token = '||' | append: raw_vendor | append: '||'
        unless vendor_labels_pipe contains label_token
          assign vendor_labels_pipe = vendor_labels_pipe | append: raw_vendor | append: '||'
        endunless
      endif
    endfor
  endif

  if vendor_labels_pipe == '||'
    for product in collection.products
      assign raw_vendor = product.vendor | strip
      if raw_vendor != blank
        assign label_token = '||' | append: raw_vendor | append: '||'
        unless vendor_labels_pipe contains label_token
          assign vendor_labels_pipe = vendor_labels_pipe | append: raw_vendor | append: '||'
        endunless
      endif
    endfor
  endif

  assign vendor_labels = vendor_labels_pipe | split: '||' | sort_natural

  assign active_vendor_count = 0
  if vendor_filter != blank
    assign active_vendor_count = vendor_filter.active_values.size
  endif
%}

{% if vendor_labels.size > 0 %}
  <details
    id="Facet-Details-{{ section_id }}-filter-p-vendor"
    class="facets__panel"
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ 'lame_collection.filter_brand' | t }}</span>
      <div class="facets__status-wrapper">
        <facet-status-component class="facets__status" facet-type="list" data-filter-style="{{ filter_style }}">
          <span
            class="{% if active_vendor_count > 0 %}bubble facets__bubble{% endif %} hide-when-empty"
            ref="facetStatus"
          >
            {%- if active_vendor_count > 0 -%}
              {{- active_vendor_count -}}
            {%- endif -%}
          </span>
        </facet-status-component>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </summary>

    <floating-panel-component class="facets__inputs facets__panel-content details-content" id="facet-inputs-filter-p-vendor">
      <facet-inputs-component
        on:change="/updateFilters"
        id="facet-inputs-component-filter-p-vendor"
      >
        <div class="facets__inputs-wrapper">
          <ul
            id="filters-list-{{ section_id }}-filter-p-vendor"
            class="facets__inputs-list list-unstyled"
            name="{{ 'lame_collection.filter_brand' | t }}"
          >
            {% for brand_label in vendor_labels %}
              {% if brand_label == blank %}
                {% continue %}
              {% endif %}

              {% liquid
                assign is_checked = false
                assign facet_count = blank
                assign raw_down = brand_label | downcase

                if raw_down contains 'lamstone'
                  assign display_label = 'Lamstone Healthcare'
                else
                  assign display_label = brand_label
                endif

                if vendor_filter != blank
                  for value in vendor_filter.active_values
                    if value.label == brand_label
                      assign is_checked = true
                      break
                    endif
                  endfor

                  for value in vendor_filter.values
                    if value.label == brand_label
                      assign facet_count = value.count
                      break
                    endif
                  endfor
                endif

                if facet_count != blank and facet_count > 0
                  assign display_label = display_label | append: ' (' | append: facet_count | append: ')'
                endif

                assign input_id = 'Filter-filter-p-vendor-' | append: forloop.index | append: '-' | append: filter_style
              %}

              <li data-skip-node-update="true" class="facets__inputs-list-item">
                {% render 'checkbox',
                  name: 'filter.p.vendor',
                  value: brand_label,
                  label: display_label,
                  checked: is_checked,
                  id: input_id,
                  disabled: false,
                  inputRef: 'facetInputs[]',
                  events: 'on:pointerenter="/prefetchPage" on:pointerleave="/cancelPrefetchPage"'
                %}
              </li>
            {% endfor %}
          </ul>
        </div>
      </facet-inputs-component>
    </floating-panel-component>
  </details>
{% endif %}
