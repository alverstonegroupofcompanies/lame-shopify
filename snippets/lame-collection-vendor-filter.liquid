{%- doc -%}
  Brand filter — merges vendors from all_vendors, collection products, and facet values.
  Uses standard Liquid tags (no capture inside liquid blocks).

  @param {object} collection
  @param {string} section_id
  @param {string} [filter_style] - vertical | horizontal
  @param {string} [id_prefix] - unique id segment (e.g. desktop, dialog)
{%- enddoc -%}

{% liquid
  assign filter_style = filter_style | default: 'vertical'
  assign id_prefix = id_prefix | default: filter_style
  assign vendor_filter = blank

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      break
    endif
  endfor

  assign vendor_slugs_pipe = '|'
  assign vendor_labels_json = ''
%}

{% for vendor_name in collection.all_vendors %}
  {% assign vendor_name_stripped = vendor_name | strip %}
  {% if vendor_name_stripped != blank %}
    {% capture vendor_slug_capture %}
      {% render 'lame-vendor-slug', vendor: vendor_name_stripped %}
    {% endcapture %}
    {% assign vendor_slug = vendor_slug_capture | strip %}
    {% assign slug_token = '|' | append: vendor_slug | append: '|' %}
    {% unless vendor_slugs_pipe contains slug_token %}
      {% assign vendor_slugs_pipe = vendor_slugs_pipe | append: vendor_slug | append: '|' %}
      {% assign vendor_labels_json = vendor_labels_json | append: vendor_slug | append: '::' | append: vendor_name_stripped | append: '||' %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% for product in collection.products %}
  {% capture product_brand_capture %}
    {% render 'lame-product-brand-name', product: product %}
  {% endcapture %}
  {% assign vendor_name_stripped = product_brand_capture | strip %}
  {% if vendor_name_stripped != blank %}
    {% capture vendor_slug_capture %}
      {% render 'lame-vendor-slug', vendor: vendor_name_stripped %}
    {% endcapture %}
    {% assign vendor_slug = vendor_slug_capture | strip %}
    {% assign slug_token = '|' | append: vendor_slug | append: '|' %}
    {% unless vendor_slugs_pipe contains slug_token %}
      {% assign vendor_slugs_pipe = vendor_slugs_pipe | append: vendor_slug | append: '|' %}
      {% assign vendor_labels_json = vendor_labels_json | append: vendor_slug | append: '::' | append: vendor_name_stripped | append: '||' %}
    {% endunless %}
  {% endif %}
{% endfor %}

{% if vendor_filter != blank %}
  {% for value in vendor_filter.values %}
    {% assign facet_label = value.label | strip %}
    {% if facet_label != blank %}
      {% capture vendor_slug_capture %}
        {% render 'lame-vendor-slug', vendor: facet_label %}
      {% endcapture %}
      {% assign vendor_slug = vendor_slug_capture | strip %}
      {% assign slug_token = '|' | append: vendor_slug | append: '|' %}
      {% unless vendor_slugs_pipe contains slug_token %}
        {% assign facet_value = value.value | strip %}
        {% if facet_value == blank %}
          {% assign facet_value = facet_label %}
        {% endif %}
        {% assign vendor_slugs_pipe = vendor_slugs_pipe | append: vendor_slug | append: '|' %}
        {% assign vendor_labels_json = vendor_labels_json | append: vendor_slug | append: '::' | append: facet_value | append: '||' %}
      {% endunless %}
    {% endif %}
  {% endfor %}
{% endif %}

{% liquid
  assign vendor_slugs = vendor_slugs_pipe | split: '|'
  assign brand_count = 0
  for vendor_slug in vendor_slugs
    if vendor_slug != blank
      assign brand_count = brand_count | plus: 1
    endif
  endfor
%}

{% capture brand_filter_markup %}
  {% assign input_index = 0 %}
  {% for vendor_slug in vendor_slugs %}
    {% if vendor_slug == blank %}
      {% continue %}
    {% endif %}

    {% liquid
      assign vendor_label = vendor_slug
      assign label_chunks = vendor_labels_json | split: '||'
      for chunk in label_chunks
        assign chunk_slug = chunk | split: '::' | first
        if chunk_slug == vendor_slug
          assign vendor_label = chunk | split: '::' | last
          break
        endif
      endfor

      assign display_label = vendor_label
      assign label_down = vendor_label | downcase
      if label_down contains 'lamstone'
        assign display_label = 'Lamstone Healthcare'
      endif

      assign filter_value = vendor_label
      assign facet_count = 0
      assign is_checked = false
      assign is_disabled = false
    %}

    {% if vendor_filter != blank %}
      {% for value in vendor_filter.values %}
        {% assign facet_label = value.label | strip %}
        {% if facet_label != blank %}
          {% capture facet_slug_capture %}
            {% render 'lame-vendor-slug', vendor: facet_label %}
          {% endcapture %}
          {% assign facet_slug = facet_slug_capture | strip %}
          {% if facet_slug == vendor_slug %}
            {% assign facet_count = value.count %}
            {% assign filter_value = value.value | strip %}
            {% if filter_value == blank %}
              {% assign filter_value = facet_label %}
            {% endif %}
            {% if value.active %}
              {% assign is_checked = true %}
            {% endif %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% unless is_checked %}
        {% for value in vendor_filter.active_values %}
          {% assign facet_label = value.label | strip %}
          {% if facet_label != blank %}
            {% capture facet_slug_capture %}
              {% render 'lame-vendor-slug', vendor: facet_label %}
            {% endcapture %}
            {% assign facet_slug = facet_slug_capture | strip %}
            {% if facet_slug == vendor_slug %}
              {% assign is_checked = true %}
              {% assign filter_value = value.value | strip %}
              {% if filter_value == blank %}
                {% assign filter_value = facet_label %}
              {% endif %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endunless %}
    {% endif %}

    {% if facet_count > 0 %}
      {% assign display_label = display_label | append: ' (' | append: facet_count | append: ')' %}
    {% endif %}

    {% assign input_index = input_index | plus: 1 %}
    {% assign input_id = 'Filter-filter-p-vendor-' | append: input_index | append: '-' | append: id_prefix %}

    <li class="facets__inputs-list-item" data-skip-node-update="true">
      {% render 'checkbox',
        name: 'filter.p.vendor',
        value: filter_value,
        label: display_label,
        checked: is_checked,
        id: input_id,
        disabled: is_disabled,
        inputRef: 'facetInputs[]',
        events: 'on:pointerenter="/prefetchPage" on:pointerleave="/cancelPrefetchPage"'
      %}
    </li>
  {% endfor %}
{% endcapture %}

{% liquid
  assign active_vendor_count = 0
  if vendor_filter != blank
    assign active_vendor_count = vendor_filter.active_values.size
  endif
%}

{% if brand_count > 0 %}
  <details
    id="Facet-Details-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
    class="facets__panel"
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary class="facets__summary">
      <span class="facets__label">{{ 'lame_collection.filter_brand' | t }}</span>
      <div class="facets__status-wrapper">
        <facet-status-component class="facets__status" facet-type="list" data-filter-style="{{ filter_style }}">
          <span
            class="{% if active_vendor_count > 0 %}bubble facets__bubble{% endif %} hide-when-empty"
            ref="facetStatus"
          >
            {%- if active_vendor_count > 0 -%}
              {{- active_vendor_count -}}
            {%- endif -%}
          </span>
        </facet-status-component>
        <span class="svg-wrapper icon-caret icon-animated">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </summary>

    <floating-panel-component
      data-disable-float-position="true"
      class="facets__inputs facets__panel-content details-content"
      id="facet-inputs-filter-p-vendor-{{ id_prefix }}"
    >
      <facet-inputs-component
        on:change="/updateFilters"
        data-lame-vendor-filter
        id="facet-inputs-component-filter-p-vendor-{{ id_prefix }}"
      >
        <div class="facets__inputs-wrapper">
          <ul
            id="filters-list-{{ section_id }}-filter-p-vendor-{{ id_prefix }}"
            class="facets__inputs-list list-unstyled"
            name="{{ 'lame_collection.filter_brand' | t }}"
          >
            {{ brand_filter_markup }}
          </ul>
        </div>
      </facet-inputs-component>
    </floating-panel-component>
  </details>
{% endif %}
