{%- doc -%}
  Inline SVG icon for Our Products hero trust badges.

  @param {string} icon - badge | leaf | shield | users | card | heart | check
{%- enddoc -%}
{%- case icon -%}
  {%- when 'badge' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2 4 5v6c0 4.6 3.2 8.9 8 10 4.8-1.1 8-5.4 8-10V5l-8-3Z" stroke="currentColor" stroke-width="1.3"/>
      <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21c4-5 6-9 6-13a6 6 0 1 0-12 0c0 4 2 8 6 13Z" stroke="currentColor" stroke-width="1.3"/>
      <path d="M12 11v10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.3"/>
      <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'users' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.3"/>
      <path d="M3.5 19c.6-3 2.8-5 5.5-5s4.9 2 5.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
      <circle cx="17" cy="9" r="2.25" stroke="currentColor" stroke-width="1.3"/>
      <path d="M14.5 19c.4-2 1.8-3.5 3.5-3.5s3.1 1.5 3.5 3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="1.3"/>
      <path d="M3 10h18" stroke="currentColor" stroke-width="1.3"/>
      <path d="M7 15h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 20s-7-4.35-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.65-7 10-7 10Z" stroke="currentColor" stroke-width="1.3"/>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.3"/>
      <path d="M9 12h6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
