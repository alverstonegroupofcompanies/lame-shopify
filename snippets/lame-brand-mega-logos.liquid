{%- comment -%}
  Renders authentic high-definition vector logos or image assets for the Brands Mega Menu.
  @param {string} brand - Brand key or slug (e.g., 'dove', 'maybelline', 'fenty-beauty')
  @param {string} [brand_title] - Display title for accessibility
  @param {image} [image] - Optional custom merchant image override
{%- endcomment -%}
{%- liquid
  assign brand_key = brand | default: '' | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '’', '' | replace: '.', '' | replace: '·', ''
  assign brand_label = brand_title | default: brand | escape
-%}

{%- if image != blank -%}
  {{
    image
    | image_url: width: 360
    | image_tag:
      class: 'lame-brands-mega__logo-img',
      loading: 'lazy',
      widths: '120, 180, 240, 360',
      sizes: '160px',
      alt: brand_label
  }}
{%- else -%}
  {%- case brand_key -%}
    {%- when 'dove' -%}
      <img
        src="{{ 'brand-logo-dove.png' | asset_url }}"
        alt="Dove"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="110"
        height="46"
      >

    {%- when 'ponds', 'pond-s', 'ponds-skin-institute' -%}
      <img
        src="{{ 'brand-logo-ponds.png' | asset_url }}"
        alt="POND'S Skin Institute"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="120"
        height="46"
      >

    {%- when 'pears' -%}
      <img
        src="{{ 'brand-logo-pears.png' | asset_url }}"
        alt="Pears"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="105"
        height="46"
      >

    {%- when 'femisafe', 'femi-safe' -%}
      <img
        src="{{ 'brand-logo-femisafe.png' | asset_url }}"
        alt="FemiSafe"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="115"
        height="46"
