{%- comment -%}
  Renders authentic original logos for the Brands Mega Menu.
  Prioritizes merchant uploaded image from Shopify Files / Theme Editor blocks (e.g. from Beauty page).
  Falls back to authentic brand assets only for the store's verified beauty brands.
  Never renders fake or placeholder SVG mockups for non-existent brands.

  @param {string} brand - Brand key or slug (e.g., 'dove', 'ponds', 'nykaa')
  @param {string} [brand_title] - Display title for accessibility
  @param {image} [image] - Custom merchant image (e.g., shopify://shop_images/...)
{%- endcomment -%}
{%- liquid
  assign brand_key = brand | default: '' | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '’', '' | replace: '.', '' | replace: '·', ''
  assign brand_label = brand_title | default: brand | escape
-%}

{%- if image != blank -%}
  {{
    image
    | image_url: width: 360
    | image_tag:
      class: 'lame-brands-mega__logo-img',
      loading: 'lazy',
      widths: '120, 180, 240, 360',
      sizes: '160px',
      alt: brand_label
  }}
{%- else -%}
  {%- case brand_key -%}
    {%- when 'dove' -%}
      <img
        src="{{ 'brand-logo-dove.png' | asset_url }}"
        alt="Dove"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="110"
        height="46"
      >

    {%- when 'ponds', 'pond-s', 'ponds-skin-institute' -%}
      <img
        src="{{ 'brand-logo-ponds.png' | asset_url }}"
        alt="Ponds"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="120"
        height="46"
      >

    {%- when 'pears' -%}
      <img
        src="{{ 'brand-logo-pears.png' | asset_url }}"
        alt="Pears"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="105"
        height="46"
      >

    {%- when 'femisafe', 'femi-safe' -%}
      <img
        src="{{ 'brand-logo-femisafe.png' | asset_url }}"
        alt="Femisafe"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="115"
        height="46"
      >

    {%- when 'jovees', 'jovees-herbal' -%}
      <img
        src="{{ 'brand-logo-jovees.png' | asset_url }}"
        alt="Jovees Herbal"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="110"
        height="46"
      >

    {%- when 'sebamed' -%}
      <img
        src="{{ 'brand-logo-sebamed.png' | asset_url }}"
        alt="SebaMed"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="120"
        height="46"
      >

    {%- when 'nykaa', 'nykaa-cosmetics' -%}
      <img
        src="{{ 'images_1.png' | file_img_url: '300x' }}"
        alt="Nykaa"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="120"
        height="46"
      >

    {%- else -%}
      <div class="lame-brands-mega__logo-fallback">
        <span class="lame-brands-mega__logo-fallback-text">{{ brand_label }}</span>
      </div>
  {%- endcase -%}
{%- endif -%}
