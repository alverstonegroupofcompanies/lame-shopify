      </svg>

    {%- when 'kerastase-paris', 'kerastase' -%}
      <svg class="lame-brands-mega__logo-svg" viewBox="0 0 160 52" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Kérastase Paris">
        <text x="80" y="29" text-anchor="middle" font-family="'Times New Roman', serif" font-weight="800" font-size="17" letter-spacing="2" fill="#111">KÉRASTASE</text>
        <text x="80" y="42" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-weight="600" font-size="7" letter-spacing="3.5" fill="#444">PARIS</text>
      </svg>

    {%- when 'love-beauty-planet', 'love-beauty-and-planet' -%}
