        loading="lazy"
        width="110"
        height="46"
      >

    {%- when 'sebamed' -%}
      <img
        src="{{ 'brand-logo-sebamed.png' | asset_url }}"
        alt="sebamed"
        class="lame-brands-mega__logo-img"
        loading="lazy"
        width="120"
        height="46"
      >

    {%- when 'fenty-beauty', 'fenty' -%}
