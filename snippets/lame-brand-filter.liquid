{%- doc -%}
  Brand filter for Our Products collections.
  Primary source: Search & Discovery vendor facet (filter.p.vendor).
  Fallback: collection.all_vendors + product.vendor.

  @param {object} collection
  @param {string} section_id
  @param {object} [filters] - collection.filters / results.filters from facets block
  @param {string} [filter_style] - vertical | horizontal
  @param {string} [id_prefix] - unique id segment (e.g. desktop, dialog)
{%- enddoc -%}

{% liquid
  assign filter_style = filter_style | default: 'vertical'
  assign id_prefix = id_prefix | default: filter_style
  assign brand_slugs_pipe = '|'
  assign brand_count = 0
  assign filters_list = filters | default: collection.filters
  assign vendor_facet_present = false

  for filter in filters_list
    if filter.param_name == 'filter.p.vendor'
      assign vendor_facet_present = true
      break
    endif
  endfor
%}

{% capture brand_filter_markup %}
  {% assign input_index = 0 %}

  {% for filter in filters_list %}
    {% if filter.param_name == 'filter.p.vendor' %}
      {% for value in filter.values %}
        {% assign vendor_value = value.value | strip %}
        {% if vendor_value == blank %}
          {% continue %}
        {% endif %}

        {% capture vendor_slug_capture %}
          {% render 'lame-vendor-slug', vendor: vendor_value %}
        {% endcapture %}
        {% assign brand_slug = vendor_slug_capture | strip %}
        {% assign slug_token = '|' | append: brand_slug | append: '|' %}
        {% unless brand_slugs_pipe contains slug_token %}
          {% assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|' %}
          {% assign brand_count = brand_count | plus: 1 %}

          {% liquid
            assign display_label = value.label | default: vendor_value
            assign label_down = vendor_value | downcase
            if label_down contains 'lamstone'
              assign display_label = 'Lamstone Healthcare'
            endif
          %}

          {% assign input_index = input_index | plus: 1 %}
          {% assign input_id = 'Filter-brand-' | append: input_index | append: '-' | append: id_prefix %}

          <li class="facets__inputs-list-item" data-skip-node-update="true">
            <div class="checkbox">
              <input
                type="checkbox"
                id="{{ input_id }}"
                class="checkbox__input"
                data-brand-slug="{{ brand_slug | escape }}"
                data-brand-label="{{ vendor_value | escape }}"
                data-label="{{ display_label | escape }}"
              >
              <label class="checkbox__label" for="{{ input_id }}">
                {{ 'icon-checkmark.svg' | inline_asset_content }}
                <span class="checkbox__label-text">{{ display_label }}</span>
              </label>
            </div>
          </li>
        {% endunless %}
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% assign vendors_sorted = collection.all_vendors | sort %}
  {% for vendor_name in vendors_sorted %}
    {% assign vendor_name_stripped = vendor_name | strip %}
    {% if vendor_name_stripped == blank %}
      {% continue %}
    {% endif %}

    {% capture vendor_slug_capture %}
      {% render 'lame-vendor-slug', vendor: vendor_name_stripped %}
    {% endcapture %}
    {% assign brand_slug = vendor_slug_capture | strip %}
    {% assign slug_token = '|' | append: brand_slug | append: '|' %}
    {% unless brand_slugs_pipe contains slug_token %}
      {% assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|' %}
      {% assign brand_count = brand_count | plus: 1 %}

      {% liquid
        assign display_label = vendor_name_stripped
        assign label_down = vendor_name_stripped | downcase
        if label_down contains 'lamstone'
          assign display_label = 'Lamstone Healthcare'
        endif
      %}

      {% assign input_index = input_index | plus: 1 %}
      {% assign input_id = 'Filter-brand-' | append: input_index | append: '-' | append: id_prefix %}

      <li class="facets__inputs-list-item" data-skip-node-update="true">
        <div class="checkbox">
          <input
            type="checkbox"
            id="{{ input_id }}"
            class="checkbox__input"
            data-brand-slug="{{ brand_slug | escape }}"
            data-brand-label="{{ vendor_name_stripped | escape }}"
            data-label="{{ display_label | escape }}"
          >
          <label class="checkbox__label" for="{{ input_id }}">
            {{ 'icon-checkmark.svg' | inline_asset_content }}
            <span class="checkbox__label-text">{{ display_label }}</span>
          </label>
        </div>
      </li>
    {% endunless %}
  {% endfor %}

  {% for product in collection.products %}
    {% assign vendor_name = product.vendor | strip %}
    {% if vendor_name == blank %}
      {% continue %}
    {% endif %}

    {% capture brand_slug_capture %}
      {% render 'lame-vendor-slug', vendor: vendor_name %}
    {% endcapture %}
    {% assign brand_slug = brand_slug_capture | strip %}
    {% assign slug_token = '|' | append: brand_slug | append: '|' %}
    {% unless brand_slugs_pipe contains slug_token %}
      {% assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|' %}
      {% assign brand_count = brand_count | plus: 1 %}

      {% liquid
        assign display_label = vendor_name
        assign label_down = vendor_name | downcase
        if label_down contains 'lamstone'
          assign display_label = 'Lamstone Healthcare'
        endif
      %}

      {% assign input_index = input_index | plus: 1 %}
      {% assign input_id = 'Filter-brand-' | append: input_index | append: '-' | append: id_prefix %}

      <li class="facets__inputs-list-item" data-skip-node-update="true">
        <div class="checkbox">
          <input
            type="checkbox"
            id="{{ input_id }}"
            class="checkbox__input"
            data-brand-slug="{{ brand_slug | escape }}"
            data-brand-label="{{ vendor_name | escape }}"
            data-label="{{ display_label | escape }}"
          >
          <label class="checkbox__label" for="{{ input_id }}">
            {{ 'icon-checkmark.svg' | inline_asset_content }}
            <span class="checkbox__label-text">{{ display_label }}</span>
          </label>
        </div>
      </li>
    {% endunless %}
  {% endfor %}
{% endcapture %}

{% if brand_count > 0 or vendor_facet_present == false %}
  <lame-brand-filter
    data-section-id="{{ section_id }}"
    data-id-prefix="{{ id_prefix }}"
    data-vendor-filter-enabled="{% if vendor_facet_present %}true{% else %}false{% endif %}"
    data-msg-no-results="{{ 'lame_collection.brand_filter_no_results' | t | escape }}"
    data-msg-loading="{{ 'lame_collection.brand_filter_error_loading' | t | escape }}"
    data-msg-mismatch="{{ 'lame_collection.brand_filter_error_mismatch' | t | escape }}"
    data-msg-no-root="{{ 'lame_collection.brand_filter_error_no_root' | t | escape }}"
    data-msg-vendor-disabled="{{ 'lame_collection.brand_filter_error_vendor_disabled' | t | escape }}"
  >
    <details
      id="Facet-Details-{{ section_id }}-brand-{{ id_prefix }}"
      class="facets__panel"
      {% if filter_style == 'vertical' %}
        open
      {% endif %}
    >
      <summary class="facets__summary">
        <span class="facets__label">{{ 'lame_collection.filter_brand' | t }}</span>
        <div class="facets__status-wrapper">
          <span
            class="facets__status facets__bubble hide-when-empty"
            data-brand-filter-status
          ></span>
          <span class="svg-wrapper icon-caret icon-animated">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </div>
      </summary>

      <floating-panel-component
        data-disable-float-position="true"
        class="facets__inputs facets__panel-content details-content"
        id="facet-inputs-brand-{{ id_prefix }}"
      >
        <div class="facets__inputs-wrapper">
          {% unless vendor_facet_present %}
            <p class="lame-brand-filter-admin-hint" role="note">
              {{ 'lame_collection.brand_nav_hint' | t }}
            </p>
          {% endunless %}
          {% if brand_count > 0 %}
            <ul
              id="filters-list-{{ section_id }}-brand-{{ id_prefix }}"
              class="facets__inputs-list list-unstyled"
              name="{{ 'lame_collection.filter_brand' | t }}"
            >
              {{ brand_filter_markup }}
            </ul>
          {% endif %}
        </div>
      </floating-panel-component>
    </details>
  </lame-brand-filter>

  {% if id_prefix == 'desktop' %}
    <script
      src="{{ 'lame-brand-filter.js' | asset_url }}"
      type="module"
      fetchpriority="low"
    ></script>
  {% endif %}
{% endif %}
