{%- liquid
  assign lcc_dir = direction | default: 'next'
-%}
{%- if lcc_dir == 'prev' -%}
  <svg
    class="lcc__icon"
    aria-hidden="true"
    viewBox="0 0 20 20"
    focusable="false"
  >
    <path fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" d="M12.5 5 7.5 10l5 5"/>
  </svg>
{%- else -%}
  <svg
    class="lcc__icon"
    aria-hidden="true"
    viewBox="0 0 20 20"
    focusable="false"
  >
    <path fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" d="M7.5 5l5 5-5 5"/>
  </svg>
{%- endif -%}
