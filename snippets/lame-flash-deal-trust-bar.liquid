{%- doc -%}
  Trust strip below flash deal product carousel.
{%- enddoc -%}

<div class="lame-flash-trust" aria-label="{{ 'lame_flash_deal.trust_aria' | t }}">
  <ul class="lame-flash-trust__list" role="list">
    <li class="lame-flash-trust__item">
      <span class="lame-flash-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M4 7h16v3H4V7Z" stroke="currentColor" stroke-width="1.35"/><path d="M6 10v8h12v-8" stroke="currentColor" stroke-width="1.35"/><path d="M9 14h6" stroke="currentColor" stroke-width="1.35"/></svg>
      </span>
      <span class="lame-flash-trust__text">
        <span class="lame-flash-trust__title">{{ 'lame_flash_deal.trust_prices_title' | t }}</span>
        <span class="lame-flash-trust__desc">{{ 'lame_flash_deal.trust_prices_desc' | t }}</span>
      </span>
    </li>
    <li class="lame-flash-trust__item">
      <span class="lame-flash-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.35"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
      </span>
      <span class="lame-flash-trust__text">
        <span class="lame-flash-trust__title">{{ 'lame_flash_deal.trust_authentic_title' | t }}</span>
        <span class="lame-flash-trust__desc">{{ 'lame_flash_deal.trust_authentic_desc' | t }}</span>
      </span>
    </li>
    <li class="lame-flash-trust__item">
      <span class="lame-flash-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M3 7h11v8H3V7Z" stroke="currentColor" stroke-width="1.35"/><path d="M14 10h4l3 3v2h-7v-5Z" stroke="currentColor" stroke-width="1.35"/></svg>
      </span>
      <span class="lame-flash-trust__text">
        <span class="lame-flash-trust__title">{{ 'lame_flash_deal.trust_delivery_title' | t }}</span>
        <span class="lame-flash-trust__desc">{{ 'lame_flash_deal.trust_delivery_desc' | t }}</span>
      </span>
    </li>
    <li class="lame-flash-trust__item">
      <span class="lame-flash-trust__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M4 12h16M4 12l4-4M4 12l4 4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
      </span>
      <span class="lame-flash-trust__text">
        <span class="lame-flash-trust__title">{{ 'lame_flash_deal.trust_returns_title' | t }}</span>
        <span class="lame-flash-trust__desc">{{ 'lame_flash_deal.trust_returns_desc' | t }}</span>
      </span>
    </li>
  </ul>
</div>
