{%- if has_membership_product -%}
  <style>
    .cart-drawer .lame-cart-summary-line:has(span:contains("Shipping")),
    .cart-drawer .cart-totals__tax-note,
    .cart-drawer .lame-cart-shipping-note,
    .cart-drawer [data-lame-delivery-eta],
    .cart-drawer tr[data-elite-pro-item] [data-lame-delivery-eta] {
      display: none !important;
    }
  </style>
{%- endif -%}
{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{%- liquid
  assign is_elite_pro = false
  if customer and customer.tags contains 'elite-pro'
    assign is_elite_pro = true
  endif

  assign total_mrp = 0
  assign has_membership_product = false
  assign has_free_gift = false

  for item in cart.items
    assign item_h = item.product.handle | downcase
    assign item_t = item.product.title | downcase
    if item_h == 'elite-pro-6-months' or item_t contains 'elite pro'
      assign has_membership_product = true
    endif

    assign item_title_downcase = item.product.title | downcase
    assign item_handle_downcase = item.product.handle | downcase
    assign item_tags_downcase = item.product.tags | join: ',' | downcase
    if item.final_price == 0 or item.original_price == 0
      assign has_free_gift = true
    elsif item_title_downcase contains 'free gift' or item_handle_downcase contains 'free-gift'
      assign has_free_gift = true
    elsif item_tags_downcase contains 'free gift' or item_tags_downcase contains 'free-gift' or item_tags_downcase contains 'gift'
      assign has_free_gift = true
    else
      for property in item.properties
        assign prop_key = property.first | downcase
        assign prop_val = property.last | downcase
        if prop_key contains 'gift' or prop_val contains 'gift'
          assign has_free_gift = true
          break
        endif
      endfor
    endif

    assign item_unit_mrp = item.original_price
    if item.variant.compare_at_price and item.variant.compare_at_price > item.original_price
      assign item_unit_mrp = item.variant.compare_at_price
    endif
    assign item_line_mrp = item_unit_mrp | times: item.quantity
    assign total_mrp = total_mrp | plus: item_line_mrp
  endfor

  assign saving_on_mrp = total_mrp | minus: cart.items_subtotal_price
  if saving_on_mrp < 0
    assign saving_on_mrp = 0
  endif

  assign total_order_saving = total_mrp | minus: cart.total_price
  if total_order_saving < 0
    assign total_order_saving = 0
  endif

  assign final_order_total = cart.total_price

  if settings.currency_code_enabled_cart_total
    assign total_price = final_order_total | money_with_currency
  else
    assign total_price = final_order_total | money
  endif
-%}

<div class="lame-price-summary">
  {%- if is_elite_pro -%}
    <div class="elite-pro-benefits-box">
      <div class="elite-pro-benefits-box__header">
        <svg class="elite-pro-benefits-box__icon" width="18" height="18" viewBox="0 0 24 24" fill="#c9a24b" stroke="#c9a24b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
        </svg>
        <span class="elite-pro-benefits-box__title">Elite Pro Benefits Received</span>
      </div>
      <ul class="elite-pro-benefits-box__list">
        <li class="elite-pro-benefits-box__item">
          <svg class="elite-pro-benefits-box__check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>You're saving {{ total_order_saving | money }} on this order</span>
        </li>
        {%- if has_free_gift -%}
          <li class="elite-pro-benefits-box__item">
            <svg class="elite-pro-benefits-box__check" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>You've got a free gift added to your cart</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if has_membership_product -%}
    <div class="cart-membership-notice">
      <svg class="cart-membership-notice__icon" width="16" height="16" viewBox="0 0 24 24" fill="#c9a24b" stroke="#c9a24b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
      <span>Membership added. You become an Elite Pro member after payment.</span>
    </div>
  {%- endif -%}

  <div class="lame-price-summary__card">
    <h2 class="lame-price-summary__title lame-cart-summary-heading">Order Summary</h2>
    <div class="lame-price-summary__lines lame-cart-summary-lines">
      <div class="lame-price-summary__line lame-cart-summary-line">
        <span class="lame-price-summary__line-label">Total MRP</span>
        <span class="lame-price-summary__line-value lame-cart-summary-line__value">{{ total_mrp | money }}</span>
      </div>

      <div class="lame-price-summary__line lame-cart-summary-line lame-price-summary__line--savings">
        <span class="lame-price-summary__line-label">Saving on MRP</span>
        <span class="lame-price-summary__line-value lame-cart-summary-line__value lame-price-summary__savings-value">
          {%- if saving_on_mrp > 0 -%}
            - {{ saving_on_mrp | money }}
          {%- else -%}
            {{ 0 | money }}
          {%- endif -%}
        </span>
      </div>

      {%- unless has_membership_product -%}
        <div class="lame-price-summary__line lame-cart-summary-line">
          <span class="lame-price-summary__line-label">Subtotal</span>
          <span class="lame-price-summary__line-value lame-cart-summary-line__value">{{ cart.items_subtotal_price | money }}</span>
        </div>

        {%- if cart.cart_level_discount_applications.size > 0 -%}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="lame-price-summary__line lame-cart-summary-line lame-price-summary__line--savings">
              <span class="lame-price-summary__line-label cart-discounts__label">
                {{- 'icon-discount.svg' | inline_asset_content -}}
                {{ discount.title | escape }}
              </span>
              <span class="lame-price-summary__line-value lame-cart-summary-line__value lame-price-summary__savings-value">
                - {{ discount.total_allocated_amount | money }}
              </span>
            </div>
          {%- endfor -%}
        {%- endif -%}

        <div class="lame-price-summary__line lame-cart-summary-line">
          <span class="lame-price-summary__line-label">Shipping</span>
          <span class="lame-price-summary__line-value lame-cart-summary-line__value">
            {%- if is_elite_pro -%}
              <span class="lame-price-summary__shipping-free">FREE</span>
            {%- else -%}
              Calculated at checkout
            {%- endif -%}
          </span>
        </div>
      {%- endunless -%}

      <div class="cart-totals__item cart-totals__total lame-price-summary__line lame-cart-summary-line lame-price-summary__line--total" role="status">
        <span class="cart-totals__total-label lame-price-summary__line-label lame-price-summary__total-label cart-primary-typography">Order Total</span>
        <span class="lame-price-summary__total-value-wrap">
          <text-component
            ref="cartTotal"
            value="{{ total_price | strip_html }}"
            class="cart-totals__total-value lame-price-summary__line-value lame-price-summary__total-value cart-secondary-typography"
            data-testid="cart-total-value"
            data-cart-subtotal
          >
            {{ total_price }}
          </text-component>
        </span>
      </div>
    </div>
  </div>
</div>

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography"></div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              class="details"
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          # Evaluate the boolean expression for the disclosure state
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            class="details"
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">{{ 'content.discount' | t }}</span>

              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component',
          children: cart_discount_accordion_children,
          class: 'cart-discount'
        %}
      {% endif %}
    </div>
  {% endif %}



  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
    {%- unless has_membership_product -%}
    <div class="cart-totals__item cart-totals__tax-note cart-primary-typography">
      {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
    </div>
    {%- endunless -%}
  </div>
</div>

{%- unless cart.empty? -%}
  {% render 'lame-cart-trust', compact: true %}
{%- endunless -%}

{%- liquid
  assign lame_checkout_login_required = false
  if shop.customer_accounts_enabled and customer == blank
    assign lame_checkout_login_required = true
    capture lame_checkout_login_url
      render 'lame-customer-auth-url', type: 'login', return_url: routes.cart_url
    endcapture
    capture lame_checkout_register_url
      render 'lame-customer-auth-url', type: 'register', return_url: routes.cart_url
    endcapture
  endif

  assign customer_phone = customer.phone | default: customer.default_address.phone
  assign lame_cart_phone_check = cart.attributes['Phone']
  if lame_cart_phone_check == blank and customer_phone != blank
    assign lame_cart_phone_check = customer_phone
  endif
-%}

<div class="cart__ctas">
  {%- if lame_checkout_login_required -%}
    <p class="cart__login-notice cart-primary-typography">{{ 'lame_customer.checkout_login_required' | t }}</p>
    <a
      id="checkout"
      href="{{ lame_checkout_login_url }}"
      class="cart__checkout-button button"
    >
      <span class="button-text">
        {{ 'lame_customer.checkout_sign_in' | t }}
      </span>
    </a>
    <p class="cart__login-register cart-primary-typography">
      {{ 'lame_customer.create_account_html' | t: link: lame_checkout_register_url }}
    </p>
  {%- else -%}
    {%- unless cart.empty? -%}
      {%- liquid
        assign phone_uid = section_id | default: 'cart'
        assign phone_input_id = 'CartPhoneInput-' | append: phone_uid
        assign phone_error_id = 'CartPhoneError-' | append: phone_uid
      -%}

      <div class="cart-phone" data-cart-phone-wrapper>
        <label for="{{ phone_input_id }}" class="cart-phone__label cart-primary-typography">
          <span>Mobile number</span>
          <span class="cart-phone__required" aria-hidden="true">*</span>
        </label>
        <div class="cart-phone__field">
          <input
            type="tel"
            inputmode="numeric"
            id="{{ phone_input_id }}"
            class="cart-phone__input"
            name="attributes[Phone]"
            form="cart-form"
            value="{{ lame_cart_phone_check | escape }}"
            placeholder="10-digit mobile number"
            autocomplete="tel"
            maxlength="16"
            required
            aria-required="true"
            aria-invalid="false"
            aria-describedby="{{ phone_error_id }}"
            data-cart-phone-input
          >
        </div>
        <p
          id="{{ phone_error_id }}"
          class="cart-phone__error"
          role="alert"
          style="display: none;"
          data-cart-phone-error
        >
          Enter a valid 10-digit mobile number
        </p>
      </div>

      <style>
        .cart-phone {
          width: 100%;
          margin-block: 0 0.625rem;
          box-sizing: border-box;
          text-align: left;
        }

        .cart-phone__label {
          display: flex;
          align-items: center;
          gap: 4px;
          font-size: 0.8125rem;
          font-weight: 600;
          color: var(--lame-cart-ink, #141414);
          margin-bottom: 0.375rem;
          letter-spacing: 0.01em;
        }

        .cart-phone__required {
          color: #dc2626;
          font-size: 0.875rem;
          line-height: 1;
        }

        .cart-phone__field {
          position: relative;
          width: 100%;
          box-sizing: border-box;
        }

        .cart-phone__input {
          width: 100%;
          height: 2.75rem;
          padding: 0 0.875rem;
          background: #ffffff;
          border: 1px solid rgb(var(--brand-gold, 212 175 55) / 0.38);
          border-radius: var(--lame-cart-radius, 12px);
          font-family: var(--lame-font-body, var(--font-body--family, sans-serif));
          font-size: 0.9375rem;
          color: var(--lame-cart-ink, #141414);
          box-sizing: border-box;
          transition: border-color 0.15s ease, box-shadow 0.15s ease;
        }

        .cart-phone__input::placeholder {
          color: rgb(var(--color-foreground-rgb, 20 20 20) / 0.45);
          font-size: 0.875rem;
        }

        .cart-phone__input:focus {
          outline: none;
          border-color: var(--lame-cart-gold-strong, #c1971f);
          box-shadow: 0 0 0 3px rgb(212 175 55 / 0.18);
        }

        .cart-phone__input.has-error,
        .cart-phone__input[aria-invalid="true"] {
          border-color: #dc2626;
          box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.12);
        }

        .cart-phone__error {
          color: #dc2626;
          font-size: 0.75rem;
          font-weight: 500;
          margin: 0.35rem 0 0 0;
          line-height: 1.35;
          text-align: left;
        }

        .cart__checkout-button[disabled],
        .cart__checkout-button[aria-disabled="true"],
        .cart__secondary-button[disabled],
        .cart__secondary-button[aria-disabled="true"] {
          opacity: 0.55;
          cursor: not-allowed;
        }
      </style>

      <script>
        (function() {
          if (window.__LAME_CART_PHONE_INITIALIZED__) {
            if (window.lameCartPhoneSync) {
              window.lameCartPhoneSync();
            }
            return;
          }
          window.__LAME_CART_PHONE_INITIALIZED__ = true;

          const STORAGE_KEY = 'lame_cart_phone';
          let currentSavePromise = null;
          let pendingPhoneVal = null;
          let pendingResolvers = [];
          let lastSavedPhone = null;

          function validateIndianMobile(val) {
            if (!val) return { valid: false, clean: '' };
            const str = String(val).trim();
            let digits = str.replace(/[\s\-\(\)]/g, '');
            if (digits.startsWith('+91')) {
              digits = digits.slice(3);
            } else if (digits.startsWith('+')) {
              return { valid: false, clean: '' };
            } else if (digits.startsWith('0') && digits.length === 11) {
              digits = digits.slice(1);
            } else if (digits.startsWith('91') && digits.length === 12) {
              digits = digits.slice(2);
            }
            const isValid = /^[6-9]\d{9}$/.test(digits);
            return { valid: isValid, clean: isValid ? digits : '' };
          }

          function getInputs() {
            return Array.from(document.querySelectorAll('[data-cart-phone-input]'));
          }

          function getErrors() {
            return Array.from(document.querySelectorAll('[data-cart-phone-error]'));
          }

          function getCheckoutButtons() {
            return Array.from(document.querySelectorAll('#checkout, .cart__checkout-button, .cart__secondary-button, button[name="checkout"]'));
          }

          function getActivePhoneValue() {
            const inputs = getInputs();
            for (let i = 0; i < inputs.length; i++) {
              if (inputs[i].value && inputs[i].value.trim()) {
                return inputs[i].value.trim();
              }
            }
            try {
              const stored = sessionStorage.getItem(STORAGE_KEY);
              if (stored) return stored;
            } catch (e) {}
            return '';
          }

          function setCheckoutButtonsState(isValid) {
            const buttons = getCheckoutButtons();
            buttons.forEach(function(btn) {
              const isCartEmpty = btn.hasAttribute('data-cart-empty') || (btn.form && btn.form.hasAttribute('data-cart-empty'));
              if (isValid && !isCartEmpty) {
                btn.removeAttribute('disabled');
                btn.setAttribute('aria-disabled', 'false');
              } else {
                btn.setAttribute('disabled', 'disabled');
                btn.setAttribute('aria-disabled', 'true');
              }
            });

            const additionalCta = document.querySelectorAll('.additional-checkout-buttons');
            additionalCta.forEach(function(el) {
              if (isValid) {
                el.style.pointerEvents = '';
                el.style.opacity = '';
              } else {
                el.style.pointerEvents = 'none';
                el.style.opacity = '0.5';
              }
            });
          }

          function setErrorState(show, customMessage) {
            const errors = getErrors();
            const inputs = getInputs();
            errors.forEach(function(err) {
              if (show) {
                err.textContent = customMessage || 'Enter a valid 10-digit mobile number';
                err.style.display = 'block';
              } else {
                err.style.display = 'none';
              }
            });
            inputs.forEach(function(inp) {
              if (show) {
                inp.classList.add('has-error');
                inp.setAttribute('aria-invalid', 'true');
              } else {
                inp.classList.remove('has-error');
                inp.setAttribute('aria-invalid', 'false');
              }
            });
          }

          function savePhoneAttribute(phoneVal) {
            if (!phoneVal) {
              return Promise.resolve(false);
            }

            if (phoneVal === lastSavedPhone && !currentSavePromise) {
              return Promise.resolve(true);
            }

            if (currentSavePromise) {
              pendingPhoneVal = phoneVal;
              return new Promise(function(resolve) {
                pendingResolvers.push(resolve);
              });
            }

            return executeSave(phoneVal);
          }

          async function executeSave(phoneVal) {
            currentSavePromise = (async function() {
              let success = false;
              try {
                const noteTextarea = document.querySelector('textarea[name="note"]#cart-note') || document.querySelector('textarea[name="note"]');
                const updatePayload = {
                  attributes: {
                    'Phone': phoneVal
                  }
                };
                if (noteTextarea && typeof noteTextarea.value === 'string') {
                  updatePayload.note = noteTextarea.value;
                }

                const response = await fetch('/cart/update.js', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                  },
                  body: JSON.stringify(updatePayload)
                });

                if (response.ok) {
                  lastSavedPhone = phoneVal;
                  try {
                    sessionStorage.setItem(STORAGE_KEY, phoneVal);
                  } catch (e) {}
                  success = true;
                } else {
                  success = false;
                  setErrorState(true, 'Could not save your number, please try again');
                  setCheckoutButtonsState(false);
                }
              } catch (err) {
                console.warn('[Cart Phone] Failed to save phone attribute:', err);
                success = false;
                setErrorState(true, 'Could not save your number, please try again');
                setCheckoutButtonsState(false);
              }
              return success;
            })();

            const result = await currentSavePromise;
            currentSavePromise = null;

            if (pendingPhoneVal !== null) {
              const nextVal = pendingPhoneVal;
              pendingPhoneVal = null;
              const resolvers = pendingResolvers;
              pendingResolvers = [];

              let nextResult = false;
              if (nextVal === lastSavedPhone) {
                nextResult = true;
              } else {
                nextResult = await executeSave(nextVal);
              }
              resolvers.forEach(function(resolve) {
                resolve(nextResult);
              });
              return nextResult;
            }

            return result;
          }

          function syncState(sourceInput) {
            const activeVal = sourceInput ? sourceInput.value : getActivePhoneValue();
            const res = validateIndianMobile(activeVal);

            const inputs = getInputs();
            inputs.forEach(function(inp) {
              if (inp !== sourceInput) {
                if (res.clean && inp.value !== res.clean) {
                  inp.value = res.clean;
                } else if (!res.clean && inp.value !== activeVal) {
                  inp.value = activeVal;
                }
              }
            });

            if (res.valid) {
              setErrorState(false);
              setCheckoutButtonsState(true);
              try {
                sessionStorage.setItem(STORAGE_KEY, res.clean);
              } catch (e) {}
            } else {
              setCheckoutButtonsState(false);
            }
          }

          function restoreAndCheck() {
            let stored = '';
            try {
              stored = sessionStorage.getItem(STORAGE_KEY) || '';
            } catch (e) {}

            const inputs = getInputs();
            inputs.forEach(function(inp) {
              if (!inp.value && stored) {
                inp.value = stored;
              }
              const val = inp.value;
              const res = validateIndianMobile(val);
              if (res.valid && res.clean && inp.value !== res.clean) {
                inp.value = res.clean;
              }
            });

            const activeVal = getActivePhoneValue();
            const res = validateIndianMobile(activeVal);
            if (res.valid) {
              setErrorState(false);
              setCheckoutButtonsState(true);
              if (res.clean !== lastSavedPhone) {
                savePhoneAttribute(res.clean);
              }
            } else {
              setCheckoutButtonsState(false);
            }
          }

          window.lameCartPhoneSync = restoreAndCheck;

          document.addEventListener('input', function(e) {
            if (e.target && e.target.matches('[data-cart-phone-input]')) {
              const res = validateIndianMobile(e.target.value);
              if (res.valid) {
                setErrorState(false);
                setCheckoutButtonsState(true);
                try {
                  sessionStorage.setItem(STORAGE_KEY, res.clean);
                } catch (err) {}
              } else {
                setCheckoutButtonsState(false);
              }
              syncState(e.target);
            }
          });

          document.addEventListener('focusout', function(e) {
            if (e.target && e.target.matches('[data-cart-phone-input]')) {
              const res = validateIndianMobile(e.target.value);
              if (res.valid) {
                e.target.value = res.clean;
                setErrorState(false);
                setCheckoutButtonsState(true);
                savePhoneAttribute(res.clean);
                syncState(e.target);
              } else {
                setErrorState(true, 'Enter a valid 10-digit mobile number');
                setCheckoutButtonsState(false);
              }
            }
          });

          document.addEventListener('click', async function(e) {
            const checkoutBtn = e.target.closest('#checkout, .cart__checkout-button, .cart__secondary-button, button[name="checkout"]');
            if (!checkoutBtn) return;
            if (checkoutBtn.tagName === 'A') return;

            const activeVal = getActivePhoneValue();
            const res = validateIndianMobile(activeVal);

            if (!res.valid) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              setErrorState(true, 'Enter a valid 10-digit mobile number');
              setCheckoutButtonsState(false);
              const inputs = getInputs();
              if (inputs.length > 0) {
                inputs[0].focus();
                inputs[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
              }
              return false;
            }

            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            checkoutBtn.setAttribute('disabled', 'disabled');
            checkoutBtn.setAttribute('aria-disabled', 'true');

            const savedOk = await savePhoneAttribute(res.clean);
            if (!savedOk) {
              setErrorState(true, 'Could not save your number, please try again');
              setCheckoutButtonsState(false);
              checkoutBtn.removeAttribute('disabled');
              checkoutBtn.removeAttribute('aria-disabled');
              return false;
            }

            try {
              const verifyRes = await fetch('/cart.js', {
                method: 'GET',
                cache: 'no-store',
                headers: {
                  'Accept': 'application/json',
                  'X-Requested-With': 'XMLHttpRequest'
                }
              });
              if (!verifyRes.ok) throw new Error('Cart verify failed');
              const cartData = await verifyRes.json();
              const confirmedPhone = cartData && cartData.attributes && cartData.attributes['Phone'];
              if (confirmedPhone !== res.clean) {
                throw new Error('Phone attribute mismatch');
              }
            } catch (verifyErr) {
              console.warn('[Cart Phone] Verification failed:', verifyErr);
              setErrorState(true, 'Could not save your number, please try again');
              setCheckoutButtonsState(false);
              checkoutBtn.removeAttribute('disabled');
              checkoutBtn.removeAttribute('aria-disabled');
              return false;
            }

            // Navigate to checkout with prefill parameter while preserving cart session
            const checkoutUrl = '/checkout?checkout[shipping_address][phone]=' + encodeURIComponent('+91' + res.clean);
            window.location.href = checkoutUrl;
          }, true);

          document.addEventListener('keydown', async function(e) {
            if (e.key === 'Enter') {
              const isPhoneInput = e.target && e.target.matches('[data-cart-phone-input]');
              const isCartForm = e.target && e.target.closest('#cart-form, .cart-drawer, .cart-page');
              if (isPhoneInput || isCartForm) {
                const activeVal = getActivePhoneValue();
                const res = validateIndianMobile(activeVal);
                if (!res.valid) {
                  e.preventDefault();
                  e.stopPropagation();
                  e.stopImmediatePropagation();
                  setErrorState(true, 'Enter a valid 10-digit mobile number');
                  setCheckoutButtonsState(false);
                  const inputs = getInputs();
                  if (inputs.length > 0) {
                    inputs[0].focus();
                  }
                  return false;
                } else if (isPhoneInput || e.target.closest('button[name="checkout"]')) {
                  e.preventDefault();
                  e.stopPropagation();
                  e.stopImmediatePropagation();
                  if (isPhoneInput) {
                    e.target.value = res.clean;
                  }
                  setErrorState(false);
                  setCheckoutButtonsState(false);

                  const savedOk = await savePhoneAttribute(res.clean);
                  if (!savedOk) {
                    setErrorState(true, 'Could not save your number, please try again');
                    setCheckoutButtonsState(false);
                    return false;
                  }

                  try {
                    const verifyRes = await fetch('/cart.js', {
                      method: 'GET',
                      cache: 'no-store',
                      headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                      }
                    });
                    if (!verifyRes.ok) throw new Error('Cart verify failed');
                    const cartData = await verifyRes.json();
                    const confirmedPhone = cartData && cartData.attributes && cartData.attributes['Phone'];
                    if (confirmedPhone !== res.clean) {
                      throw new Error('Phone attribute mismatch');
                    }
                  } catch (verifyErr) {
                    console.warn('[Cart Phone] Verification failed:', verifyErr);
                    setErrorState(true, 'Could not save your number, please try again');
                    setCheckoutButtonsState(false);
                    return false;
                  }

                  // Navigate to checkout with prefill parameter while preserving cart session
                  const checkoutUrl = '/checkout?checkout[shipping_address][phone]=' + encodeURIComponent('+91' + res.clean);
                  window.location.href = checkoutUrl;
                }
              }
            }
          }, true);

          document.addEventListener('DOMContentLoaded', restoreAndCheck);
          document.addEventListener('cart:update', function() { setTimeout(restoreAndCheck, 50); });
          document.addEventListener('cart:add', function() { setTimeout(restoreAndCheck, 50); });
          document.addEventListener('dialog:open', function() { setTimeout(restoreAndCheck, 20); });

          restoreAndCheck();
        })();
      </script>
    {%- endunless -%}

    <button
      type="submit"
      id="checkout"
      class="cart__checkout-button button"
      name="checkout"
      {% if cart == empty or lame_cart_phone_check == blank %}
        disabled
        aria-disabled="true"
      {% endif %}
      {% if cart == empty %}
        data-cart-empty="true"
      {% endif %}
      form="cart-form"
    >
      <span class="button-text">
        {%- if template.name == 'cart' -%}
          <svg class="cart__checkout-lock" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7 11V8a5 5 0 0 1 10 0v3" stroke="currentColor" stroke-width="1.6" fill="none"/>
            <rect x="5" y="11" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/>
          </svg>
          {{ 'lame_cart.proceed_checkout' | t }}
        {%- else -%}
          {{ 'content.checkout' | t }}
        {%- endif -%}
      </span>
    </button>

    {%- if template.name == 'cart' -%}
      <button
        type="submit"
        class="cart__secondary-button"
        name="checkout"
        {% if cart == empty or lame_cart_phone_check == blank %}
          disabled
          aria-disabled="true"
        {% endif %}
        {% if cart == empty %}
          data-cart-empty="true"
        {% endif %}
        form="cart-form"
      >
        {{ 'lame_cart.buy_now' | t }}
      </button>
    {%- endif -%}

    {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
      <div
        class="
          additional-checkout-buttons
          {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
        "
      >
        {{ content_for_additional_checkout_buttons }}
      </div>
    {% endif %}
  {%- endif -%}
</div>

{% stylesheet %}
  .lame-price-summary {
    width: 100%;
    margin-block-end: var(--gap-md, 1rem);
  }

  .lame-price-summary__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: #6b0f46;
    margin: 0 0 0.75rem 0;
    letter-spacing: -0.01em;
    width: 100%;
    text-align: left;
  }

  .lame-price-summary__card {
    background: var(--color-card-background, #ffffff);
    border: 1px solid rgba(107, 15, 70, 0.16);
    border-radius: 12px;
    padding: 1rem 1.125rem;
    box-shadow: 0 2px 8px rgba(107, 15, 70, 0.04);
    width: 100%;
  }

  .lame-price-summary__lines {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .lame-price-summary__line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: #4b5563;
  }

  .lame-price-summary__line-label {
    color: #4b5563;
    font-weight: 400;
  }

  .lame-price-summary__line-value {
    color: #111827;
    font-weight: 600;
  }

  .lame-price-summary__savings-value {
    color: #15803d !important;
    font-weight: 600 !important;
  }

  .lame-price-summary__shipping-free {
    color: #15803d !important;
    font-weight: 700 !important;
    letter-spacing: 0.02em;
  }

  .lame-price-summary__line--total {
    margin-top: 0.375rem;
    padding-top: 0.75rem;
    border-top: 1px dashed rgba(107, 15, 70, 0.25);
  }

  .lame-price-summary__total-label {
    font-size: 1.05rem;
    font-weight: 700;
    color: #6b0f46 !important;
  }

  .lame-price-summary__total-value-wrap .cart-totals__total-value {
    font-size: 1.2rem;
    font-weight: 700;
    color: #6b0f46 !important;
  }

  /* Elite Pro Benefits Received Green Box */
  .elite-pro-benefits-box {
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    border-radius: 12px;
    padding: 0.875rem 1rem;
    margin-bottom: 0.875rem;
    box-shadow: 0 2px 6px rgba(22, 163, 74, 0.08);
    width: 100%;
  }

  .elite-pro-benefits-box__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    font-weight: 700;
    color: #15803d;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .elite-pro-benefits-box__icon {
    color: #c9a24b;
    flex-shrink: 0;
  }

  .elite-pro-benefits-box__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .elite-pro-benefits-box__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.825rem;
    line-height: 1.4;
    color: #166534;
    font-weight: 500;
  }

  .elite-pro-benefits-box__check {
    color: #16a34a;
    flex-shrink: 0;
  }

  /* Membership Notice */
  .cart-membership-notice {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #fdf4f7;
    border: 1px solid rgba(107, 15, 70, 0.2);
    border-left: 3.5px solid #6b0f46;
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
    margin-bottom: 0.875rem;
    font-size: 0.8rem;
    line-height: 1.4;
    color: #6b0f46;
    font-weight: 500;
    width: 100%;
  }

  .cart-membership-notice__icon {
    color: #c9a24b;
    flex-shrink: 0;
  }

  .cart-totals {
    border-block-start: none !important;
    padding-block-start: 0 !important;
  }
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid var(--color-border);
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid var(--color-border);
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid var(--color-border);
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: clamp(25px, var(--height-buy-buttons), 55px);
    padding-inline: var(--padding-4xl);
  }

  .cart__login-notice,
  .cart__login-register {
    width: 100%;
    margin: 0;
    font-size: var(--font-size--2xs);
    line-height: 1.45;
    text-align: center;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart__login-register a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)) {
    border-block-start: var(--style-border-width) solid var(--color-border);
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }
{% endstylesheet %}
