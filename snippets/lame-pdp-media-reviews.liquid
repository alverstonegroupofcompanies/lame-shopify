{% doc %}
  Compact customer reviews panel for under the product gallery.
  Uses Shopify review metafields (populated by Judge.me / other review apps).

  @param {object} product - Product resource
{% enddoc %}

{% liquid
  assign rating_obj = product.metafields.reviews.rating.value
  assign rating = rating_obj.rating
  assign scale_max = rating_obj.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0
  assign rating_count_num = rating_count | plus: 0

  if rating == blank and product.metafields.judgeme.badge != blank
    assign has_judgeme_badge = true
  else
    assign has_judgeme_badge = false
  endif

  assign show_panel = false
  if rating != blank and rating_count_num > 0
    assign show_panel = true
  elsif has_judgeme_badge
    assign show_panel = true
  elsif request.design_mode
    assign show_panel = true
    assign rating = 4.8
    assign scale_max = 5
    assign rating_count_num = 128
  endif

  if rating != blank
    assign rating_display = rating | round: 1
    assign filled = rating | floor
    assign decimal = rating | modulo: 1
    assign half_index = 0
    if decimal >= 0.3
      assign half_index = filled | plus: 1
    endif
  endif
%}

{% if show_panel %}
  <aside class="lame-pdp-media-reviews" aria-label="Customer reviews">
    <div class="lame-pdp-media-reviews__inner">
      {% if has_judgeme_badge and rating == blank %}
        <div class="lame-pdp-media-reviews__judgeme">
          {{ product.metafields.judgeme.badge }}
        </div>
      {% else %}
        <div class="lame-pdp-media-reviews__score">
          <span class="lame-pdp-media-reviews__number">{{ rating_display }}</span>
          <div class="lame-pdp-media-reviews__stars" aria-hidden="true">
            {% for i in (1..scale_max) %}
              {% if i <= filled %}
                <span class="lame-pdp-media-reviews__star is-full">★</span>
              {% elsif i == half_index %}
                <span class="lame-pdp-media-reviews__star is-half">★</span>
              {% else %}
                <span class="lame-pdp-media-reviews__star">★</span>
              {% endif %}
            {% endfor %}
          </div>
          <p class="lame-pdp-media-reviews__count">
            {% if rating_count_num == 1 %}
              1 customer review
            {% else %}
              {{ rating_count_num }} customer reviews
            {% endif %}
          </p>
        </div>
      {% endif %}

      <a class="lame-pdp-media-reviews__cta" href="#lame-pdp-reviews">
        Read reviews
        <span aria-hidden="true">↓</span>
      </a>
    </div>
  </aside>
{% endif %}
