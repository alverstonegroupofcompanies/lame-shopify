{%- doc -%}
  Quick navigation cards for the customer account dashboard.

  @param {boolean} [show_wishlist] - Show wishlist tile when theme wishlist is enabled
{%- enddoc -%}

<nav class="lame-profile__quick-nav" aria-label="{{ 'lame_customer.dashboard_nav' | t }}">
  <a href="#profile-details" class="lame-profile__quick-card">
    <span class="lame-profile__quick-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.25"/><path d="M5.5 19c0-3.2 2.9-5.25 6.5-5.25S18.5 15.8 18.5 19" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
    </span>
    <span class="lame-profile__quick-label">{{ 'content.account_profile' | t }}</span>
  </a>

  <a href="#orders" class="lame-profile__quick-card">
    <span class="lame-profile__quick-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M4 7.5h16l-1.4 10.2a1.5 1.5 0 0 1-1.48 1.3H6.88a1.5 1.5 0 0 1-1.48-1.3L4 7.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/><path d="M9 11V8a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
    </span>
    <span class="lame-profile__quick-label">{{ 'customer.orders.title' | t }}</span>
  </a>

  {% if show_wishlist %}
    <a href="#wishlist" class="lame-profile__quick-card">
      <span class="lame-profile__quick-icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z" fill-rule="evenodd" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/></svg>
      </span>
      <span class="lame-profile__quick-label">{{ 'lame_wishlist.title' | t }}</span>
      <span class="lame-profile__quick-badge" data-account-wishlist-count hidden>0</span>
    </a>
  {% endif %}

  <a href="#addresses" class="lame-profile__quick-card">
    <span class="lame-profile__quick-icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 21s6-5.2 6-10.5a6 6 0 1 0-12 0C6 15.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.25"/><circle cx="12" cy="10.5" r="2" stroke="currentColor" stroke-width="1.25"/></svg>
    </span>
    <span class="lame-profile__quick-label">{{ 'customer.addresses.title' | t }}</span>
  </a>
</nav>
