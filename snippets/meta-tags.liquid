{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign lame_home_seo_title = 'My Lamstone | Luxury Skincare & Cosmetics in Kerala'
  assign lame_home_seo_description = 'Discover My Lamstone — luxury skincare and premium cosmetics from Kerala, South India. Trusted beauty rituals, radiant skin care, and refined self-care for every day.'
  assign lame_brand_name = 'My Lamstone'

  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_site_name = shop.name
  assign document_title = page_title
  assign meta_description = page_description

  if request.page_type == 'index'
    assign og_title = lame_home_seo_title
    assign og_description = lame_home_seo_description
    assign og_site_name = lame_brand_name
    assign document_title = lame_home_seo_title
    assign meta_description = lame_home_seo_description
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_image = page_image
  if og_image == blank and request.page_type == 'product' and product.featured_media
    assign og_image = product.featured_media.preview_image
  endif
  if og_image == blank and settings.social_sharing_image != blank
    assign og_image = settings.social_sharing_image
  endif
  if og_image == blank and settings.logo != blank
    assign og_image = settings.logo
  endif
%}

<meta
  property="og:site_name"
  content="{{ og_site_name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_image -%}
  {%- assign og_image_url = og_image | image_url: width: 1200 -%}
  <meta
    property="og:image"
    content="http:{{ og_image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image_url }}"
  >
  <meta
    property="og:image:width"
    content="1200"
  >
  <meta
    property="og:image:alt"
    content="{{ og_title | escape }}"
  >
  <meta
    name="twitter:image"
    content="https:{{ og_image_url }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ document_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless request.page_type == 'index' or document_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if meta_description %}
  <meta
    name="description"
    content="{{ meta_description | escape }}"
  >
{% endif %}
