{%- liquid
  assign block_type = block_type | default: 'slide'
  assign carousel_modifier = carousel_modifier | default: 'desktop'
  assign accessibility_label = accessibility_label | default: 'Homepage hero banner'
  assign slideshow_slide_size = slideshow_slide_size | default: 'large'

  assign slide_count = 0
  for block in section.blocks
    if block.type == block_type and block.settings.image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor

  assign show_arrows = false
  if slide_count > 1
    assign show_arrows = true
  endif

  assign slideshow_class = 'lame-home-hero__carousel lame-home-hero__carousel--' | append: carousel_modifier
  if slide_count == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif

  assign prioritize_first_slide = prioritize_first_slide | default: true
-%}

{%- if slide_count > 0 -%}
  {% capture slides %}
    {%- assign slide_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type != block_type or block.settings.image == blank -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign slide_loading = 'lazy'
        assign slide_fetchpriority = 'auto'
        if slide_index == 0 and prioritize_first_slide
          assign slide_loading = 'eager'
          assign slide_fetchpriority = 'high'
        endif

        if carousel_modifier == 'mobile'
          assign slide_widths = '400,600,750,828,1080'
          assign slide_sizes = '100vw'
          assign slide_max_width = 1080
        else
          assign slide_widths = '832, 1200, 1600, 1920, 2560, 3840'
          assign slide_sizes = '100vw'
          assign slide_max_width = 3840
        endif
      -%}
      {%- capture slide_children -%}
        <div class="slide__image-container">
          {%- if block.settings.link != blank -%}
            <a
              href="{{ block.settings.link }}"
              class="lame-home-hero__slide-link"
              {% if block.settings.open_in_new_tab %}
                target="_blank" rel="noopener"
              {% endif %}
            >
          {%- endif -%}
          {{
            block.settings.image
            | image_url: width: slide_max_width
            | image_tag:
              class: 'slide__image',
              loading: slide_loading,
              fetchpriority: slide_fetchpriority,
              widths: slide_widths,
              sizes: slide_sizes,
              alt: block.settings.image.alt | default: accessibility_label | escape
          }}
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endcapture -%}
      {% render 'slideshow-slide',
        index: slide_index,
        children: slide_children,
        attributes: block.shopify_attributes,
        slide_size: slideshow_slide_size,
        media_fit: 'cover',
        navigate_to_slide: false
      %}
      {%- assign slide_index = slide_index | plus: 1 -%}
    {%- endfor -%}
  {% endcapture %}

  <div class="slideshow-section lame-home-hero__frame lame-home-hero__frame--{{ carousel_modifier }}">
    {% render 'slideshow',
      class: slideshow_class,
      slides: slides,
      slide_count: slide_count,
      slide_size: slideshow_slide_size,
      show_arrows: show_arrows,
      icon_style: 'arrow',
      icon_shape: 'circle',
      arrows_position: 'center',
      autoplay: autoplay,
      autoplay_speed: autoplay_speed
    %}
  </div>
{%- endif -%}
