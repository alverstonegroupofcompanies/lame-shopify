{%- doc -%}
  Reference-style mobile drawer main navigation.
  @param {object} linklist
  @param {object} block_settings
{%- enddoc -%}

{%- assign animation_index = 0 -%}
{%- for link in linklist.links -%}
  {%- liquid
    assign menu_link_title = link.title
    assign menu_link_title_down = link.title | downcase
    if menu_link_title_down == 'our products' or menu_link_title_down == 'shop'
      assign menu_link_title = 'Beauty'
    endif
    assign is_brands_link = false
    if menu_link_title_down == 'home' or menu_link_title_down == 'homepage' or menu_link_title_down == 'brand' or menu_link_title_down == 'brands'
      assign menu_link_title = 'Brands'
      assign is_brands_link = true
    endif
    assign drawer_link_url = link.url
    if is_brands_link and link.url == '/'
      assign drawer_link_url = routes.all_products_collection_url
    endif
    assign animation_index = animation_index | plus: 1
  -%}
  <li
    class="menu-drawer__list-item lame-drawer-nav__item{% if is_brands_link %} lame-drawer-nav__item--brands{% endif %}"
    style="--menu-drawer-animation-index: {{ animation_index }};"
  >
    {%- if link.links != blank or is_brands_link -%}
      <details
        id="Details-menu-drawer-menu-item-{{ forloop.index }}"
        class="menu-drawer__menu-container"
      >
        <summary
          id="HeaderDrawer-{{ link.handle }}"
          class="menu-drawer__menu-item menu-drawer__menu-item--mainlist lame-drawer-nav__row focus-inset{% if link.child_active or link.active %} menu-drawer__menu-item--active{% endif %}"
          on:click="#HeaderMenuDrawer/open/submenu"
        >
          {% render 'lame-drawer-nav-icon', handle: link.handle %}
          <span class="menu-drawer__menu-item-text wrap-text"{% if is_brands_link %} style="color: #1a472a; font-weight: 700;"{% endif %}>{{ menu_link_title | escape }}</span>
          <span class="lame-drawer-nav__trail">
            <span class="svg-wrapper icon-caret icon-caret--forward lame-drawer-nav__chevron" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </span>
        </summary>
        <div
          id="link-{{ link.handle | escape }}"
          class="menu-drawer__submenu has-submenu"
          tabindex="-1"
          style="--menu-drawer-animation-index: {{ animation_index }};"
        >
          <div class="menu-drawer__inner-submenu">
            <div class="menu-drawer__nav-buttons">
              <button
                class="button menu-drawer__back-button focus-inset"
                on:click="#HeaderMenuDrawer/back"
                aria-label="{{ 'actions.back_to' | t: title: menu_link_title }}"
              >
                <span class="svg-wrapper icon-caret icon-caret--backward">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
                <span class="menu-drawer__menu-item-text wrap-text">{{ menu_link_title | escape }}</span>
              </button>
              <button
                class="button button-unstyled close-button menu-drawer__close-button"
                type="button"
                aria-label="{{ 'actions.close' | t }}"
                on:click="#HeaderMenuDrawer/close"
              >
                <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
                  {{- 'icon-close.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
            {%- if is_brands_link -%}
              <ul class="menu-drawer__menu menu-drawer__menu--childlist lame-drawer-nav__submenu-list" role="list">
                <li class="menu-drawer__list-item lame-drawer-nav__item">
                  <a
                    href="{{ routes.all_products_collection_url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--child lame-drawer-nav__row lame-drawer-nav__row--sub focus-inset"
                    style="font-weight: 700; color: #1a472a;"
                  >
                    {% render 'lame-drawer-nav-icon', handle: 'brands' %}
                    <span class="menu-drawer__menu-item-text wrap-text">Explore All Brands &rarr;</span>
                  </a>
                </li>
                {%- assign has_drawer_custom_brands = false -%}
                {%- if menu_block and menu_block.blocks.size > 0 -%}
                  {%- for child_block in menu_block.blocks -%}
                    {%- if child_block.type == '_header-mega-brand' and child_block.settings.show_in_sidebar != false -%}
                      {%- assign has_drawer_custom_brands = true -%}
                      {%- liquid
                        assign brand_title = child_block.settings.title | default: child_block.settings.brand_name | default: 'Brand' | strip
                        assign brand_slug = brand_title | handleize
                        assign brand_url = child_block.settings.brand_url
                        if brand_url == blank
                          assign brand_title_enc = brand_title | url_encode
                          assign brand_url = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: brand_title_enc
                          if collections[brand_slug] != blank and collections[brand_slug].products_count > 0
                            assign brand_url = collections[brand_slug].url
                          endif
                        endif
                      -%}
                      <li class="menu-drawer__list-item lame-drawer-nav__item" {{ child_block.shopify_attributes }}>
                        <a
                          href="{{ brand_url }}"
                          class="menu-drawer__menu-item menu-drawer__menu-item--child lame-drawer-nav__row lame-drawer-nav__row--sub focus-inset"
                        >
                          <span class="menu-drawer__menu-item-text wrap-text">{{ brand_title }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- unless has_drawer_custom_brands -%}
                  {%- assign drawer_brands = "Maybelline New York|maybelline-new-york,Lakmé|lakme,M·A·C|mac,L'Oréal Paris|loreal-paris,Dove|dove,POND'S|ponds,Cetaphil|cetaphil,Dot & Key|dot-key,The Ordinary|the-ordinary,Plum|plum,Laneige|laneige,Beauty of Joseon|beauty-of-joseon,Fenty Beauty|fenty-beauty,CeraVe|cerave,Estée Lauder|estee-lauder,Pears|pears,FemiSafe|femisafe,JOVEES Herbal|jovees,Sebamed|sebamed,Biotique|biotique,Innisfree|innisfree,Lamstone Healthcare|lamstone" | split: ',' -%}
                  {%- for d_brand in drawer_brands -%}
                    {%- assign d_parts = d_brand | split: '|' -%}
                    {%- assign d_name = d_parts[0] -%}
                    {%- assign d_slug = d_parts[1] -%}
                    {%- assign d_encoded = d_name | url_encode -%}
                    {%- assign d_url = routes.all_products_collection_url | append: '?filter.p.vendor=' | append: d_encoded -%}
                    {%- if collections[d_slug] != blank and collections[d_slug].products_count > 0 -%}
                      {%- assign d_url = collections[d_slug].url -%}
                    {%- endif -%}
                    <li class="menu-drawer__list-item lame-drawer-nav__item">
                      <a
                        href="{{ d_url }}"
                        class="menu-drawer__menu-item menu-drawer__menu-item--child lame-drawer-nav__row lame-drawer-nav__row--sub focus-inset"
                      >
                        <span class="menu-drawer__menu-item-text wrap-text">{{ d_name }}</span>
                      </a>
                    </li>
                  {%- endfor -%}
                {%- endunless -%}
              </ul>
            {%- else -%}
              <ul class="menu-drawer__menu menu-drawer__menu--childlist lame-drawer-nav__submenu-list" role="list">
                {%- for childlink in link.links -%}
                  <li class="menu-drawer__list-item lame-drawer-nav__item">
                    <a
                      href="{{ childlink.url }}"
                      class="menu-drawer__menu-item menu-drawer__menu-item--child lame-drawer-nav__row lame-drawer-nav__row--sub focus-inset{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                      {% if childlink.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {% render 'lame-drawer-nav-icon', handle: childlink.handle %}
                      <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </details>
    {%- else -%}
      <a
        id="HeaderDrawer-{{ link.handle }}"
        href="{{ drawer_link_url }}"
        class="menu-drawer__menu-item menu-drawer__menu-item--mainlist lame-drawer-nav__row focus-inset{% if link.current and is_brands_link == false %} menu-drawer__menu-item--active{% endif %}"
        {% if link.current and is_brands_link == false %}
          aria-current="page"
        {% endif %}
      >
        {% render 'lame-drawer-nav-icon', handle: link.handle %}
        <span class="menu-drawer__menu-item-text wrap-text"{% if is_brands_link %} style="color: #1a472a; font-weight: 700;"{% endif %}>{{ menu_link_title | escape }}</span>
      </a>
    {%- endif -%}
  </li>
{%- endfor -%}
