{%- doc -%}
  Line icon for mobile drawer nav rows.
  @param {string} handle - Link handle or keyword
{%- enddoc -%}

{%- liquid
  assign icon_key = handle | downcase | strip | replace: ' ', '-'
-%}

<span class="lame-drawer-nav__icon" aria-hidden="true">
  {%- case icon_key -%}
    {%- when 'home', 'frontpage' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5Z"/></svg>
    {%- when 'shop', 'our-products', 'products', 'catalog' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
    {%- when 'skin-care', 'skincare' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c-4 6-7 10-7 14a7 7 0 0 0 14 0c0-4-3-8-7-14Z"/></svg>
    {%- when 'make-up', 'makeup' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 20h8"/><path d="M9 4h6l1 8a4 4 0 0 1-8 0l1-8Z"/></svg>
    {%- when 'hair-care', 'haircare', 'hair' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4c0 4 2 6 4 8 2-2 4-4 4-8"/><path d="M6 20c2-6 4-8 6-8s4 2 6 8"/></svg>
    {%- when 'new-arrivals', 'new', 'new-products' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v4"/><path d="m16.2 7.8 2.8-2.8"/><path d="M21 12h-4"/><path d="m16.2 16.2 2.8 2.8"/><path d="M12 17v4"/><path d="m4.9 19.1 2.8-2.8"/><path d="M3 12h4"/><path d="m4.9 4.9 2.8 2.8"/></svg>
    {%- when 'offers', 'sale', 'deals' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 12 9 23l-7-7 11-11 7 7Z"/><path d="M7 17l2 2"/></svg>
    {%- when 'account', 'my-account', 'profile' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c1.5-4 3.8-6 7-6s5.5 2 7 6"/></svg>
    {%- when 'orders', 'order' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4h10l2 4v12H5V8l2-4Z"/><path d="M9 12h6"/><path d="M9 16h4"/></svg>
    {%- when 'wishlist', 'favorites' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.6-7 10-7 10Z"/></svg>
    {%- when 'cart' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
    {%- when 'about', 'about-us' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c-4 6-7 10-7 14a7 7 0 0 0 14 0c0-4-3-8-7-14Z"/></svg>
    {%- when 'contact', 'contact-us' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4v2a4 4 0 0 1-4 4H9l-3 3v-3H8a4 4 0 0 1-4-4V8Z"/></svg>
    {%- when 'faq' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 4 1.8c0 1.7-2.5 2-2.5 3.7"/><path d="M12 17h.01"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
  {%- endcase -%}
</span>
