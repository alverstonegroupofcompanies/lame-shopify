{%- doc -%}
  Full-width trust strip for cart page (below recommendations).
{%- enddoc -%}

<div class="lame-cart-trust-bar" aria-label="{{ 'lame_cart.trust_aria' | t }}">
  <ul class="lame-cart-trust-bar__list" role="list">
    <li class="lame-cart-trust-bar__item">
      <span class="lame-cart-trust-bar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M3 7h11v8H3V7Z" stroke="currentColor" stroke-width="1.35"/><path d="M14 10h4l3 3v2h-7v-5Z" stroke="currentColor" stroke-width="1.35"/></svg>
      </span>
      <span class="lame-cart-trust-bar__label">{{ 'lame_cart.trust_bar_shipping' | t }}</span>
    </li>
    <li class="lame-cart-trust-bar__item">
      <span class="lame-cart-trust-bar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.35"/></svg>
      </span>
      <span class="lame-cart-trust-bar__label">{{ 'lame_cart.trust_bar_secure' | t }}</span>
    </li>
    <li class="lame-cart-trust-bar__item">
      <span class="lame-cart-trust-bar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M12 3v18M8 7h8a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h8" stroke="currentColor" stroke-width="1.35"/></svg>
      </span>
      <span class="lame-cart-trust-bar__label">{{ 'lame_cart.trust_bar_authentic' | t }}</span>
    </li>
    <li class="lame-cart-trust-bar__item">
      <span class="lame-cart-trust-bar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" width="22" height="22"><path d="M4 12h16M4 12l4-4M4 12l4 4" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/></svg>
      </span>
      <span class="lame-cart-trust-bar__label">{{ 'lame_cart.trust_bar_returns' | t }}</span>
    </li>
  </ul>
</div>
