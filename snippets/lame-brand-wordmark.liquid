    when 'femisafe', 'femi-safe'
      assign display_name = 'Femisafe'
      assign extra_class = 'lame-wm--femisafe'

    when 'fixderma'
      assign display_name = 'FIXDERMA'
      assign sub_title = 'COSMETICS'
      assign extra_class = 'lame-wm--fixderma'

    when 'garnier'
      assign display_name = 'GARNIER'
