-%}

<div class="lame-brand-wordmark {{ extra_class }}">
  <span class="lame-brand-wordmark__text">{{ display_name }}</span>
  {%- if sub_title != blank -%}
    <span class="lame-brand-wordmark__sub">{{ sub_title }}</span>
  {%- endif -%}
</div>
