{%- comment -%}
  Typographic Wordmark Logo for Brands Mega Menu.
  Renders authentic brand logo typography (font, weight, spacing, casing, and subtitles)
  matching real world beauty brand logos, eliminating boxy placeholder badges.

  @param {string} brand_key - Clean handle/key of brand
  @param {string} brand_label - Display name
{%- endcomment -%}

{%- liquid
  assign key = brand_key | default: '' | downcase | strip | replace: ' ', '-' | replace: "'", '' | replace: '’', '' | replace: '.', '' | replace: '·', ''
  assign display_name = brand_label | default: brand_key | strip
  assign sub_title = ''
  assign extra_class = ''

  case key
    when 'annina'
      assign display_name = 'ANNINA'
      assign sub_title = 'PARIS'
      assign extra_class = 'lame-wm--annina'

    when 'aroma-magic'
      assign display_name = 'aroma magic'
      assign sub_title = 'BLOSSOM KOCHHAR'
      assign extra_class = 'lame-wm--aroma-magic'

    when 'bath-body', 'bath-and-body'
      assign display_name = 'Bath & Body Works'
      assign extra_class = 'lame-wm--bath-body'

    when 'bioderma'
      assign display_name = 'BIODERMA'
      assign sub_title = 'LABORATOIRE DERMATOLOGIQUE'
      assign extra_class = 'lame-wm--bioderma'

    when 'biotique'
      assign display_name = 'BIOTIQUE'
      assign sub_title = 'ADVANCED AYURVEDA'
      assign extra_class = 'lame-wm--biotique'

    when 'bombay-shaving-company'
      assign display_name = 'BOMBAY SHAVING'
      assign sub_title = 'COMPANY'
      assign extra_class = 'lame-wm--bombay-shaving'

    when 'bp-color-pop', 'color-pop'
      assign display_name = 'BP COLOR POP'
      assign extra_class = 'lame-wm--color-pop'

    when 'cetaphil'
      assign display_name = 'Cetaphil'
      assign extra_class = 'lame-wm--cetaphil'

    when 'character'
      assign display_name = 'CHARACTER'
      assign sub_title = 'PARIS COSMETICS'
      assign extra_class = 'lame-wm--character'

    when 'dot-key', 'dot-and-key'
      assign display_name = 'dot & key'
      assign sub_title = 'SKINCARE'
      assign extra_class = 'lame-wm--dot-key'

    when 'dove'
      assign display_name = 'Dove'
      assign extra_class = 'lame-wm--dove'

    when 'dr-althea'
      assign display_name = 'Dr. Althea'
      assign sub_title = 'SEOUL'
      assign extra_class = 'lame-wm--dr-althea'

    when 'dr-rashel', 'drrashel'
      assign display_name = 'DR·RASHEL'
      assign extra_class = 'lame-wm--dr-rashel'

    when 'e18'
      assign display_name = 'E 1 8'
      assign sub_title = 'STUDIOS'
      assign extra_class = 'lame-wm--e18'

    when 'faces-canada'
