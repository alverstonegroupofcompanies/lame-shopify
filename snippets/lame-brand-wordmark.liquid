    when 'streax'
      assign display_name = 'streax'
      assign sub_title = 'PROFESSIONAL'
      assign extra_class = 'lame-wm--streax'

    when 'swiss-beauty'
      assign display_name = 'SWISS BEAUTY'
      assign extra_class = 'lame-wm--swiss-beauty'

    when 'the-body-shop', 'the-body-shop.'
      assign display_name = 'THE BODY SHOP'
      assign extra_class = 'lame-wm--the-body-shop'

    when 'the-face-shop'
      assign display_name = 'THE FACE SHOP'
      assign sub_title = 'NATURAL STORY'
      assign extra_class = 'lame-wm--the-face-shop'

    when 'tresemme'
      assign display_name = 'TRESemmé'
      assign sub_title = 'PROFESSIONAL'
