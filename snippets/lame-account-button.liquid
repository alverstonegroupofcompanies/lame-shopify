{%- doc -%}
  Account control with themed popover linking to profile and orders pages.

  @param {object} section - Header section (profile_page / orders_page settings)
  @param {string} [display_style] - icon or text
{%- enddoc -%}

{%- capture profile_url -%}{%- render 'lame-customer-profile-url', section: section -%}{%- endcapture -%}
{%- capture orders_url -%}{%- render 'lame-customer-orders-url', section: section -%}{%- endcapture -%}

<div class="lame-account header-actions__action{% if display_style == 'text' %} lame-account--text{% endif %}">
  {%- if customer -%}
    <details class="lame-account__details">
      <summary
        class="lame-account__trigger account-button"
        aria-label="{{ 'content.account_title' | t }}"
      >
        <span class="lame-account__avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0, 1 | upcase }}</span>
        <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
          {{ 'content.account_title' | t }}
        </span>
      </summary>
      <div
        class="lame-account__panel lame-account__panel--rich color-{{ settings.popover_color_scheme }}"
        role="menu"
      >
        <div class="lame-account__panel-head">
          <p class="lame-account__greeting">
            {{ 'lame_customer.account_greeting' | t: name: customer.first_name | default: customer.name }}
          </p>
          <p class="lame-account__email" title="{{ customer.email }}">{{ customer.email | truncate: 34 }}</p>
        </div>

        <div class="lame-account__panel-actions">
          <a class="lame-account__action-btn" href="{{ orders_url }}" role="menuitem">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7.5h16l-1.4 10.2a1.5 1.5 0 0 1-1.48 1.3H6.88a1.5 1.5 0 0 1-1.48-1.3L4 7.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
              <path d="M9 11V8a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <span>{{ 'customer.orders.title' | t }}</span>
          </a>
          <a class="lame-account__action-btn" href="{{ profile_url }}" role="menuitem">
            <span>{{ 'lame_customer.my_profile' | t }}</span>
          </a>
        </div>

        <ul class="lame-account__menu list-unstyled" role="list">
          {% if settings.lame_enable_wishlist %}
            <li role="none">
              <button type="button" class="lame-account__link" data-lame-wishlist-open role="menuitem">
                {{ 'lame_wishlist.title' | t }}
              </button>
            </li>
          {% endif %}
          <li role="none">
            <a class="lame-account__link" href="{{ profile_url }}#addresses" role="menuitem">
              {{ 'customer.addresses.title' | t }}
            </a>
          </li>
          <li role="none">
            <a class="lame-account__link lame-account__link--logout" href="{{ routes.account_logout_url }}" role="menuitem">
              {{ 'actions.log_out' | t }}
            </a>
          </li>
        </ul>
      </div>
    </details>
  {%- else -%}
    <a
      class="lame-account__trigger account-button"
      href="{{ routes.account_login_url }}"
      aria-label="{{ 'content.account_title' | t }}"
    >
      <span class="lame-account__icon-wrap {% if display_style != 'icon' %}desktop:hidden{% endif %}" aria-hidden="true">
        {% render 'lame-account-icon', size: 18, class: 'account-button__icon' %}
      </span>
      <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.account_title' | t }}
      </span>
    </a>
  {%- endif -%}
</div>
