{%- doc -%}
  Premium account menu — mobile slide-in drawer and desktop dropdown.

  @param {object} section - Header section (profile_page / orders_page settings)
  @param {string} [display_style] - icon or text
{%- enddoc -%}

{%- capture profile_url -%}{%- render 'lame-customer-profile-url', section: section -%}{%- endcapture -%}
{%- capture login_url -%}{%- render 'lame-customer-auth-url', type: 'login' -%}{%- endcapture -%}
{%- capture register_url -%}{%- render 'lame-customer-auth-url', type: 'register' -%}{%- endcapture -%}
{%- capture orders_url -%}{%- render 'lame-customer-orders-url', section: section -%}{%- endcapture -%}

{%- liquid
  assign wishlist_url = '/pages/wishlist'
  if pages['wishlist'] != blank
    assign wishlist_url = pages['wishlist'].url
  endif

  assign account_label = 'content.account_title' | t
  if section and section.settings.actions_account_label != blank
    assign account_label = section.settings.actions_account_label
  endif

  assign show_action_labels = true
  if section and section.settings.actions_show_labels == false
    assign show_action_labels = false
  endif

  assign action_label_class = 'lame-account__label header-actions__action-label mobile:hidden'
  unless show_action_labels
    assign action_label_class = 'lame-account__label header-actions__action-label hidden'
  endunless

  assign avatar_letter = ''
  if customer
    assign avatar_letter = customer.first_name | slice: 0, 1 | upcase
    if avatar_letter == blank
      assign avatar_letter = customer.email | slice: 0, 1 | upcase
    endif
  endif

  assign menu_id = 'lame-account-menu-header'
  if section.id != blank
    assign menu_id = 'lame-account-menu-' | append: section.id
  endif
-%}

<script
  type="module"
  src="{{ 'lame-account-menu.js' | asset_url }}"
  fetchpriority="low"
></script>

<account-menu-component class="lame-account header-actions__action header-actions__slot{% if display_style == 'text' %} lame-account--text{% endif %}">
  <button
    type="button"
    ref="trigger"
    class="lame-account__trigger account-button"
    aria-label="{{ account_label }}"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="{{ menu_id }}"
    on:click="/toggle"
  >
    <span class="lame-account__icon-wrap {% if display_style != 'icon' %}desktop:hidden{% endif %}" aria-hidden="true">
      {% if section and section.settings.actions_account_icon != blank %}
        {% render 'lame-header-action-icon',
          icon_type: 'account',
          custom_image: section.settings.actions_account_icon,
          class: 'account-button__icon header-actions__icon-image'
        %}
      {% else %}
        {% render 'lame-account-icon', size: 20, class: 'account-button__icon' %}
      {% endif %}
    </span>
    {%- if customer -%}
      <span class="visually-hidden">{{ customer.first_name | default: customer.email }}</span>
    {%- endif -%}
    <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
      {{ account_label }}
    </span>
    <span class="{{ action_label_class }}">{{ account_label }}</span>
  </button>

  <div
    ref="backdrop"
    class="lame-account__backdrop"
    aria-hidden="true"
    on:click="/close"
  ></div>

  <div
    ref="panel"
    id="{{ menu_id }}"
    class="lame-account__panel color-{{ settings.popover_color_scheme }}"
    role="menu"
    aria-labelledby="{{ menu_id }}-heading"
    aria-label="{{ 'content.account_title' | t }}"
  >
    <header class="lame-account__header">
      {%- if customer -%}
        <div class="lame-account__header-user">
          <div class="lame-account__user-avatar" aria-hidden="true">{{ avatar_letter }}</div>
          <div class="lame-account__user-meta">
            <p class="lame-account__heading" id="{{ menu_id }}-heading">
              {{ 'lame_customer.account_greeting' | t: name: customer.first_name | default: customer.name }}
            </p>
            <p class="lame-account__email" title="{{ customer.email }}">{{ customer.email }}</p>
          </div>
        </div>
      {%- else -%}
        <div class="lame-account__header-user lame-account__header-user--guest">
          <div class="lame-account__user-meta">
            <p class="lame-account__heading" id="{{ menu_id }}-heading">{{ 'lame_customer.drawer_guest_title' | t }}</p>
            <p class="lame-account__email">{{ 'lame_customer.drawer_guest_hint' | t }}</p>
          </div>
        </div>
      {%- endif -%}

      <button
        type="button"
        ref="closeButton"
        class="lame-account__close"
        aria-label="{{ 'actions.close_dialog' | t }}"
        on:click="/close"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M15.97 17.03a.75.75 0 1 0 1.06-1.06L13.06 12l3.97-3.97a.75.75 0 0 0-1.06-1.06L12 10.94 8.03 6.97a.75.75 0 0 0-1.06 1.06L10.94 12l-3.97 3.97a.75.75 0 1 0 1.06 1.06L12 13.06l3.97 3.97Z"/>
        </svg>
      </button>
    </header>

    <div class="lame-account__divider" role="separator" aria-hidden="true"></div>

    {%- if customer -%}
      <div class="lame-account__body">
        <div class="lame-account__quick-links" role="group" aria-label="{{ 'lame_customer.account_nav' | t }}">
          <a class="lame-account__quick-link" href="{{ orders_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <span class="lame-account__quick-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7.5h16l-1.4 10.2a1.5 1.5 0 0 1-1.48 1.3H6.88a1.5 1.5 0 0 1-1.48-1.3L4 7.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/><path d="M9 11V8a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
            </span>
            <span class="lame-account__quick-link-label">{{ 'lame_customer.my_orders' | t }}</span>
          </a>
          <a class="lame-account__quick-link" href="{{ profile_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <span class="lame-account__quick-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.25"/><path d="M5.5 19c0-3.2 2.9-5.25 6.5-5.25S18.5 15.8 18.5 19" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
            </span>
            <span class="lame-account__quick-link-label">{{ 'lame_customer.my_profile' | t }}</span>
          </a>
        </div>

        <ul class="lame-account__menu list-unstyled" role="none">
          <li role="none">
            <a class="lame-account__row" href="{{ wishlist_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
              <span class="lame-account__row-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393Z" fill-rule="evenodd" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/></svg>
              </span>
              <span class="lame-account__row-label">{{ 'lame_wishlist.title' | t }}</span>
              <span class="lame-account__row-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
          <li role="none">
            <a class="lame-account__row" href="{{ routes.account_addresses_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
              <span class="lame-account__row-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 21s6-5.2 6-10.5a6 6 0 1 0-12 0C6 15.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.25"/><circle cx="12" cy="10.5" r="2" stroke="currentColor" stroke-width="1.25"/></svg>
              </span>
              <span class="lame-account__row-label">{{ 'customer.addresses.title' | t }}</span>
              <span class="lame-account__row-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
          <li class="lame-account__menu-divider" role="separator" aria-hidden="true"></li>
          <li role="none">
            <a class="lame-account__row lame-account__row--logout" href="{{ routes.account_logout_url }}" role="menuitem" ref="menuitem[]">
              <span class="lame-account__row-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/><path d="M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <span class="lame-account__row-label">{{ 'actions.log_out' | t }}</span>
              <span class="lame-account__row-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
          </li>
        </ul>
      </div>
    {%- else -%}
      <div class="lame-account__body lame-account__body--guest">
        <div class="lame-account__auth">
          <a class="lame-account__auth-primary button" href="{{ login_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            {{ 'customer.log_in' | t }}
          </a>
          <a class="lame-account__auth-secondary button button-secondary" href="{{ register_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            {{ 'lame_customer.create_account' | t }}
          </a>
        </div>

        <div class="lame-account__quick-links" role="group" aria-label="{{ 'lame_customer.account_nav' | t }}">
          <a class="lame-account__quick-link" href="{{ orders_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <span class="lame-account__quick-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7.5h16l-1.4 10.2a1.5 1.5 0 0 1-1.48 1.3H6.88a1.5 1.5 0 0 1-1.48-1.3L4 7.5Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/><path d="M9 11V8a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
            </span>
            <span class="lame-account__quick-link-label">{{ 'lame_customer.my_orders' | t }}</span>
          </a>
          <a class="lame-account__quick-link" href="{{ profile_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <span class="lame-account__quick-link-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.25"/><path d="M5.5 19c0-3.2 2.9-5.25 6.5-5.25S18.5 15.8 18.5 19" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg>
            </span>
            <span class="lame-account__quick-link-label">{{ 'lame_customer.my_profile' | t }}</span>
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</account-menu-component>
