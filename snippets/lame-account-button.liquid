{%- doc -%}
  Plain account dropdown.

  @param {object} section - Header section (profile_page / orders_page settings)
  @param {string} [display_style] - icon or text
{%- enddoc -%}

{%- capture profile_url -%}{%- render 'lame-customer-profile-url', section: section -%}{%- endcapture -%}
{%- capture login_url -%}{%- render 'lame-customer-auth-url', type: 'login' -%}{%- endcapture -%}
{%- capture register_url -%}{%- render 'lame-customer-auth-url', type: 'register' -%}{%- endcapture -%}
{%- capture orders_url -%}{%- render 'lame-customer-orders-url', section: section -%}{%- endcapture -%}

{%- liquid
  assign wishlist_url = '/pages/wishlist'
  if pages['wishlist'] != blank
    assign wishlist_url = pages['wishlist'].url
  endif

  assign account_label = 'content.account_title' | t
  if section and section.settings.actions_account_label != blank
    assign account_label = section.settings.actions_account_label
  endif

  assign show_action_labels = true
  if section and section.settings.actions_show_labels == false
    assign show_action_labels = false
  endif

  assign action_label_class = 'lame-account__label header-actions__action-label mobile:hidden'
  unless show_action_labels
    assign action_label_class = 'lame-account__label header-actions__action-label hidden'
  endunless

  assign menu_id = 'lame-account-menu-header'
  if section.id != blank
    assign menu_id = 'lame-account-menu-' | append: section.id
  endif
-%}

<script
  type="module"
  src="{{ 'lame-account-menu.js' | asset_url }}"
  fetchpriority="low"
></script>

<account-menu-component
  class="lame-account header-actions__action header-actions__slot{% if display_style == 'text' %} lame-account--text{% endif %}"
  {% if section.id != blank %}
    data-section-id="{{ section.id }}"
  {% endif %}
  {% if customer %}
    data-customer-id="{{ customer.id }}"
  {% endif %}
>
  <button
    type="button"
    ref="trigger"
    class="lame-account__trigger account-button"
    aria-label="{{ account_label }}"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-controls="{{ menu_id }}"
    on:click="/toggle"
  >
    <span class="lame-account__icon-wrap {% if display_style != 'icon' %}desktop:hidden{% endif %}" aria-hidden="true">
      {% if section and section.settings.actions_account_icon != blank %}
        {% render 'lame-header-action-icon',
          icon_type: 'account',
          custom_image: section.settings.actions_account_icon,
          class: 'account-button__icon header-actions__icon-image'
        %}
      {% else %}
        {% render 'lame-account-icon', size: 22, class: 'account-button__icon' %}
      {% endif %}
    </span>
    {%- if customer -%}
      <span class="visually-hidden">{{ customer.first_name | default: customer.email }}</span>
    {%- endif -%}
    <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
      {{ account_label }}
    </span>
    <span class="{{ action_label_class }}">{{ account_label }}</span>
  </button>

  <div
    ref="backdrop"
    class="lame-account__backdrop"
    aria-hidden="true"
    on:click="/close"
  ></div>

  <div
    ref="panel"
    id="{{ menu_id }}"
    class="lame-account__panel lame-account__panel--plain"
    role="menu"
    {% if customer %}
      data-logged-in="true"
    {% endif %}
    aria-label="{{ 'content.account_title' | t }}"
  >
    <ul class="lame-account__menu list-unstyled" role="none">
      {%- if customer -%}
        <li class="lame-account__who" role="none">
          <p class="lame-account__heading" id="{{ menu_id }}-heading">
            {{ 'lame_customer.account_greeting' | t: name: customer.first_name | default: customer.name }}
          </p>
          <p class="lame-account__email">{{ customer.email }}</p>
        </li>
        <li role="none">
          <a class="lame-account__link" href="{{ wishlist_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <svg class="lame-account__link-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 16.2 4.2 10.6a3.4 3.4 0 0 1 4.8-4.8L10 6.8l1-1a3.4 3.4 0 0 1 4.8 4.8L10 16.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            <span>{{ 'lame_wishlist.title' | t }}</span>
          </a>
        </li>
        <li role="none">
          <a class="lame-account__link" href="{{ profile_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <svg class="lame-account__link-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="7" r="2.4" stroke="currentColor" stroke-width="1.4"/>
              <path d="M5.2 15.2c.6-2.2 2.4-3.4 4.8-3.4s4.2 1.2 4.8 3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <span>{{ 'lame_customer.account_settings' | t }}</span>
          </a>
        </li>
        <li role="none">
          <a class="lame-account__link" href="{{ orders_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            <svg class="lame-account__link-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3.6 6.2 5 7.6 7.6 4.8M3.6 10.2 5 11.6 7.6 8.8M3.6 14.2 5 15.6 7.6 12.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9.2 6.2h7.2M9.2 10.2h7.2M9.2 14.2h7.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
            <span>{{ 'lame_customer.orders' | t }}</span>
          </a>
        </li>
        <li role="none">
          <a class="lame-account__link" href="{{ routes.account_logout_url }}" role="menuitem" ref="menuitem[]">
            <span>{{ 'actions.log_out' | t }}</span>
          </a>
        </li>
      {%- else -%}
        <li role="none">
          <a class="lame-account__link" href="{{ login_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            {{- 'customer.log_in' | t -}}
          </a>
        </li>
        <li role="none">
          <a class="lame-account__link" href="{{ register_url }}" role="menuitem" ref="menuitem[]" on:click="/close">
            {{- 'lame_customer.create_account' | t -}}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</account-menu-component>
