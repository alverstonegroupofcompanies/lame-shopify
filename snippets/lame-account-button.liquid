{%- doc -%}
  Account control that links to the themed profile at /account instead of Shopify’s default account UI.

  @param {object} section - Header section (profile_page setting)
  @param {string} [display_style] - icon or text
{%- enddoc -%}

{%- capture profile_url -%}{%- render 'lame-customer-profile-url', section: section -%}{%- endcapture -%}

<div class="lame-account header-actions__action{% if display_style == 'text' %} lame-account--text{% endif %}">
  {%- if customer -%}
    <details class="lame-account__details">
      <summary
        class="lame-account__trigger account-button"
        aria-label="{{ 'content.account_title' | t }}"
      >
        <span class="lame-account__avatar" aria-hidden="true">{{ customer.first_name | default: customer.email | slice: 0, 1 | upcase }}</span>
        <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
          {{ 'content.account_title' | t }}
        </span>
      </summary>
      <div
        class="lame-account__panel color-{{ settings.popover_color_scheme }}"
        role="menu"
      >
        <ul class="lame-account__menu list-unstyled" role="list">
          <li role="none">
            <a class="lame-account__link" href="{{ profile_url }}" role="menuitem">
              {{ 'content.account_title' | t }}
            </a>
          </li>
          <li role="none">
            <a class="lame-account__link" href="{{ profile_url }}#orders" role="menuitem">
              {{ 'customer.orders.title' | t }}
            </a>
          </li>
          {% if settings.lame_enable_wishlist %}
            <li role="none">
              <button type="button" class="lame-account__link" data-lame-wishlist-open role="menuitem">
                {{ 'lame_wishlist.title' | t }}
              </button>
            </li>
          {% endif %}
          <li role="none">
            <a class="lame-account__link" href="{{ routes.account_addresses_url }}" role="menuitem">
              {{ 'customer.addresses.title' | t }}
            </a>
          </li>
          <li role="none">
            <a class="lame-account__link lame-account__link--logout" href="{{ routes.account_logout_url }}" role="menuitem">
              {{ 'actions.log_out' | t }}
            </a>
          </li>
        </ul>
      </div>
    </details>
  {%- else -%}
    <a
      class="lame-account__trigger account-button"
      href="{{ routes.account_login_url }}"
      aria-label="{{ 'content.account_title' | t }}"
    >
      <span class="lame-account__icon-wrap {% if display_style != 'icon' %}desktop:hidden{% endif %}" aria-hidden="true">
        {% render 'lame-account-icon', size: 18, class: 'account-button__icon' %}
      </span>
      <span class="account-button__text header-actions__text-style {% if display_style == 'icon' %}hidden{% else %}mobile:hidden{% endif %}">
        {{ 'content.account_title' | t }}
      </span>
    </a>
  {%- endif -%}
</div>
