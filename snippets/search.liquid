{%- doc -%}
  Renders the header search control.

  Single magnifying-glass icon that opens the shared #search-modal.
  No duplicate pill bar — one button, one modal.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
{%- enddoc -%}

{% unless style == 'none' %}
  <search-button
    class="search-action search-action--icon{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <button
      type="button"
      on:click="#search-modal/showDialog"
      class="lame-header-search-icon button-unstyled header-actions__action"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  search-button.search-action {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: inline-flex;
    align-items: center;
    position: relative;
    width: auto;
    min-width: 0;
  }

  .search-action--hidden-on-drawer {
    display: none;
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }
{% endstylesheet %}
