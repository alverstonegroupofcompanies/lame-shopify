{%- doc -%}
  Renders the header search control.

  Desktop: pill bar with live predictive results dropdown.
  Mobile/tablet: icon that opens the shared #search-modal.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.
  @param {string} [display_style] - The display style ('icon' or 'text').
{%- enddoc -%}

{% unless style == 'none' %}
  <script
    src="{{ 'predictive-search.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {{ 'lame-predictive-search.css' | asset_url | stylesheet_tag }}

  <search-button
    class="search-action search-action--icon search-action--pill{% if display_style == 'text' %} search-action--text{% endif %}{% if class != blank %} {{ class | strip }}{% endif %}"
  >
    <predictive-search-component
      class="lame-header-inline-search predictive-search"
      data-section-id="predictive-search"
      data-testid="search-component--header"
      role="search"
      aria-label="{{ 'content.search_input_label' | t }}"
      style="--product-corner-radius: {{ settings.product_corner_radius | default: 8 | append: 'px' }}; --card-corner-radius: {{ settings.card_corner_radius | default: 8 | append: 'px' }};"
    >
      <form
        class="lame-header-inline-search__form predictive-search-form"
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        ref="form"
        on:keydown="/onSearchKeyDown"
      >
        <div class="lame-header-search-pill lame-header-inline-search__bar">
          <label class="visually-hidden" for="HeaderSearchInput">
            {{ 'content.search_input_label' | t }}
          </label>
          <input
            id="HeaderSearchInput"
            class="lame-header-search-pill__input search-input"
            type="search"
            name="q"
            role="combobox"
            aria-expanded="false"
            aria-controls="header-predictive-search-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder="{{ 'lame_search.placeholder_nav' | t }}"
            ref="searchInput"
            on:input="/search"
            on:keydown="/onSearchKeyDown"
          >
          <input name="options[prefix]" type="hidden" value="last">
          <button
            type="button"
            class="button-unstyled lame-header-search-pill__reset"
            ref="resetButton"
            hidden
            on:click="/resetSearch"
            aria-label="{{ 'actions.clear' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{ 'icon-close.svg' | inline_asset_content }}
            </span>
          </button>
          <button
            type="submit"
            class="lame-header-search-pill__submit"
            aria-label="{{ 'content.search_input_label' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">
              {{ 'icon-search.svg' | inline_asset_content }}
            </span>
          </button>
        </div>

        <div class="lame-header-inline-search__dropdown predictive-search-form__content-wrapper">
          <div
            id="header-predictive-search-results"
            class="predictive-search-form__content"
            ref="predictiveSearchResults"
          >
            {% render 'predictive-search-empty-state',
              load_empty_state: true,
              shadow_opacity: 0.1,
              products_test_id: 'products-list-default--header'
            %}
          </div>
        </div>
      </form>
    </predictive-search-component>

    <button
      type="button"
      on:click="#search-modal/showDialog"
      class="lame-header-search-icon button-unstyled header-actions__action"
      aria-label="{{ 'content.search_input_label' | t }}"
      aria-haspopup="dialog"
    >
      <span class="svg-wrapper" aria-hidden="true">
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
  </search-button>
{% endunless %}

{% stylesheet %}
  search-button.search-action {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .search-action {
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: inline-flex;
    align-items: center;
    position: relative;
    width: auto;
    min-width: 0;
  }

  .search-action--hidden-on-drawer {
    display: none;
  }

  @media screen and (min-width: 750px) {
    [data-menu-style='drawer'] .search-action--hidden-on-drawer {
      display: none;
    }

    [data-menu-style='menu'] .search-action--hidden-on-menu {
      display: none;
    }
  }
{% endstylesheet %}
