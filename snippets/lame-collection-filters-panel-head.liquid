{%- doc -%}
  Sidebar heading for collection filters (replaces generic "REFINE" label).

  @param {number} [active_count] - Active filter count
{%- enddoc -%}

<div class="lame-collection-filters-head">
  <div class="lame-collection-filters-head__row">
    <h2 class="lame-collection-filters-head__title">{{ 'lame_collection.filters_title' | t }}</h2>
    <span class="lame-collection-filters-head__icon" aria-hidden="true">
      {{ 'icon-filter.svg' | inline_asset_content }}
    </span>
  </div>
  <p class="lame-collection-filters-head__subtitle">{{ 'lame_collection.filters_subtitle' | t }}</p>
  {% if active_count > 0 %}
    <p class="lame-collection-filters-head__active">
      {{ 'lame_collection.filters_active' | t: count: active_count }}
    </p>
  {% endif %}
</div>
