{%- doc -%}
  Sidebar heading for collection filters.

  @param {number} [active_count] - Active filter count
{%- enddoc -%}

<div class="lame-collection-filters-head">
  <h2 class="lame-collection-filters-head__title">{{ 'lame_collection.filters_title' | t }}</h2>
  {% if active_count > 0 %}
    <p class="lame-collection-filters-head__active">
      {{ 'lame_collection.filters_active' | t: count: active_count }}
    </p>
  {% endif %}
</div>
