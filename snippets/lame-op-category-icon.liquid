{%- doc -%}
  Category line icons for Our Products shop navigation chips.
  @param {string} handle - Collection handle or icon key
{%- enddoc -%}

{%- liquid
  assign icon_handle = handle | downcase | strip
-%}

<span class="lame-op-category-icon" aria-hidden="true">
  {%- case icon_handle -%}
    {%- when 'skin-care', 'skincare' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c-4 6-7 10-7 14a7 7 0 0 0 14 0c0-4-3-8-7-14Z"/><path d="M12 11v6"/></svg>
    {%- when 'bath-body', 'bath-and-body' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10h10l1 8H6l1-8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/><path d="M10 14h4"/></svg>
    {%- when 'fragrance' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v4H9z"/><path d="M10 7h4v14h-4z"/><path d="M8 11h8"/><path d="M12 3V1"/></svg>
    {%- when 'make-up', 'makeup' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h3v7H8z"/><path d="M11 6h5a2 2 0 0 1 2 2v2H11V6Z"/><path d="M9 10v11"/><circle cx="9" cy="21" r="1.2"/></svg>
    {%- when 'hair-care', 'haircare', 'hair' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4c0 4 2 6 4 8 2-2 4-4 4-8"/><path d="M6 20c2-6 4-8 6-8s4 2 6 8"/><path d="M12 12v4"/></svg>
    {%- when 'baby-mom', 'baby' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.2"/><path d="M6.5 20c1.2-3.8 3.2-5.5 5.5-5.5S16.3 16.2 17.5 20"/><path d="M9.2 8.2h.01M14.8 8.2h.01"/></svg>
    {%- when 'wellness' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.5-7 10-7 10Z"/></svg>
    {%- when 'herbal' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21V10"/><path d="M12 14c-4-1-7-4-8-8 5 0 8 2 8 6"/><path d="M12 12c4-1 7-4 8-8-5 0-8 2-8 6"/></svg>
    {%- when 'frontpage', 'all', 'our-products', 'products' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16l-1.2 12.5a1 1 0 0 1-1 .9H6.2a1 1 0 0 1-1-.9L4 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/><path d="M4 8h16"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 1.5"/></svg>
  {%- endcase -%}
</span>
