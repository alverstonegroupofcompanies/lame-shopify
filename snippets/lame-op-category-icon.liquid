{%- doc -%}
  Category line icons for Our Products shop navigation chips.
  Bold, filled silhouettes so each category reads at a glance.
  @param {string} handle - Collection handle or icon key
{%- enddoc -%}

{%- liquid
  assign icon_handle = handle | downcase | strip
-%}

<span class="lame-op-category-icon lame-op-category-icon--{{ icon_handle }}" aria-hidden="true">
  {%- case icon_handle -%}
    {%- when 'skin-care', 'skincare' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M12 2.8C9.1 7.1 5.5 11.6 5.5 16.1a6.5 6.5 0 0 0 13 0c0-4.5-3.6-9-6.5-13.3Z" fill="currentColor" opacity="0.18"/>
        <path d="M12 2.8C9.1 7.1 5.5 11.6 5.5 16.1a6.5 6.5 0 0 0 13 0c0-4.5-3.6-9-6.5-13.3Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M10 14.2c.7 1.5 2 2.4 3.5 2.6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- when 'bath-body', 'bath-and-body' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M8 10.5h8l1.1 10.2a1.2 1.2 0 0 1-1.2 1.3H8.1a1.2 1.2 0 0 1-1.2-1.3L8 10.5Z" fill="currentColor" opacity="0.18"/>
        <path d="M8 10.5h8l1.1 10.2a1.2 1.2 0 0 1-1.2 1.3H8.1a1.2 1.2 0 0 1-1.2-1.3L8 10.5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M10 10.5V7.8a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v2.7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        <path d="M12 5.8V3.6M12 3.6h2.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M9.8 14.2h4.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- when 'fragrance' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M8.5 9.5h7l1.2 11.2a1 1 0 0 1-1 1.1H8.3a1 1 0 0 1-1-1.1L8.5 9.5Z" fill="currentColor" opacity="0.18"/>
        <rect x="9.2" y="3.2" width="5.6" height="3.4" rx="1" stroke="currentColor" stroke-width="1.9"/>
        <path d="M10.2 6.6h3.6V9.5H10.2V6.6Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M8.5 9.5h7l1.2 11.2a1 1 0 0 1-1 1.1H8.3a1 1 0 0 1-1-1.1L8.5 9.5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M12 3.2V1.8M15.6 2.4c.9.4 1.5 1.1 1.8 2M8.4 2.4c-.9.4-1.5 1.1-1.8 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>

    {%- when 'make-up', 'makeup' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M9.2 11.2h5.6v9.5a1.2 1.2 0 0 1-1.2 1.2h-3.2a1.2 1.2 0 0 1-1.2-1.2v-9.5Z" fill="currentColor" opacity="0.18"/>
        <path d="M10.1 3.4c0-.7.6-1.3 1.3-1.3h.4c1.1 0 2 .9 2 2v3.3h-3.7V3.4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M9.2 7.4h5.6v3.8H9.2V7.4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M9.2 11.2h5.6v9.5a1.2 1.2 0 0 1-1.2 1.2h-3.2a1.2 1.2 0 0 1-1.2-1.2v-9.5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M10.4 14.8h3.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- when 'hair-care', 'haircare', 'hair' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="lame-op-category-icon__fill" cx="7.2" cy="7.2" r="2.7" fill="currentColor" opacity="0.18"/>
        <circle class="lame-op-category-icon__fill" cx="7.2" cy="16.8" r="2.7" fill="currentColor" opacity="0.18"/>
        <circle cx="7.2" cy="7.2" r="2.7" stroke="currentColor" stroke-width="1.9"/>
        <circle cx="7.2" cy="16.8" r="2.7" stroke="currentColor" stroke-width="1.9"/>
        <path d="M9.3 8.8 20.2 18.2M9.3 15.2 20.2 5.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        <path d="M12.8 12h.01" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/>
      </svg>

    {%- when 'baby-mom', 'baby' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="lame-op-category-icon__fill" cx="12" cy="13" r="7.2" fill="currentColor" opacity="0.18"/>
        <circle cx="12" cy="13" r="7.2" stroke="currentColor" stroke-width="1.9"/>
        <path d="M8.6 5.6c1-.9 2.2-1.4 3.4-1.4s2.4.5 3.4 1.4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        <circle cx="9.4" cy="12.4" r="1.05" fill="currentColor"/>
        <circle cx="14.6" cy="12.4" r="1.05" fill="currentColor"/>
        <path d="M10.2 16c.5.7 1.2 1.1 1.8 1.1s1.3-.4 1.8-1.1" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- when 'wellness' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M12 20.6S4.8 16.1 4.8 10.2A4.35 4.35 0 0 1 12 7.6a4.35 4.35 0 0 1 7.2 2.6c0 5.9-7.2 10.4-7.2 10.4Z" fill="currentColor" opacity="0.22"/>
        <path d="M12 20.6S4.8 16.1 4.8 10.2A4.35 4.35 0 0 1 12 7.6a4.35 4.35 0 0 1 7.2 2.6c0 5.9-7.2 10.4-7.2 10.4Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M8.6 11.4h2.1l1 1.8 1.7-3.4 1.1 1.6H15.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>

    {%- when 'herbal' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M5.5 18.5C5.5 11.2 11 5.2 19.5 4.5 18.8 13 12.8 18.5 5.5 18.5Z" fill="currentColor" opacity="0.18"/>
        <path d="M5.5 18.5C5.5 11.2 11 5.2 19.5 4.5 18.8 13 12.8 18.5 5.5 18.5Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M6.2 18.2 12 11.5M12 11.5c-1.4 1.8-2.2 3.8-2.5 5.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- when 'frontpage', 'all', 'our-products', 'products' -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path class="lame-op-category-icon__fill" d="M5.2 8.2h13.6l-1 12.1a1.4 1.4 0 0 1-1.4 1.3H7.6a1.4 1.4 0 0 1-1.4-1.3L5.2 8.2Z" fill="currentColor" opacity="0.18"/>
        <path d="M5.2 8.2h13.6l-1 12.1a1.4 1.4 0 0 1-1.4 1.3H7.6a1.4 1.4 0 0 1-1.4-1.3L5.2 8.2Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M9.2 8.2V6.4a2.8 2.8 0 0 1 5.6 0v1.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
        <path d="M9.6 12.2h4.8" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>

    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle class="lame-op-category-icon__fill" cx="12" cy="12" r="8.2" fill="currentColor" opacity="0.16"/>
        <circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.9"/>
        <path d="M12 8.2v4.2l2.4 1.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
  {%- endcase -%}
</span>
