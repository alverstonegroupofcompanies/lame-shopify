{%- doc -%}
  Wishlist toggle for Our Products collection cards (beside add to cart).

  @param {object} product - Product object
{%- enddoc -%}

{%- liquid
  assign lame_wl_image = ''
  assign lame_wl_price = ''
  if product.featured_media
    assign lame_wl_image = product.featured_media.preview_image | image_url: width: 480
  endif
  assign lame_wl_price = product.price_min | money
-%}

<button
  type="button"
  class="lame-wishlist-toggle lame-op-wishlist-btn"
  aria-label="{{ 'lame_wishlist.toggle' | t }}"
  aria-pressed="false"
  data-lame-wishlist-toggle
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-url="{{ product.url }}"
  data-product-title="{{ product.title | escape }}"
  data-product-image="{{ lame_wl_image }}"
  data-product-price="{{ lame_wl_price | escape }}"
>
  <span class="lame-wishlist-toggle__icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="none" focusable="false">
      <path
        class="lame-wishlist-toggle__outline"
        d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
        fill-rule="evenodd"
        stroke="currentColor"
        stroke-width="1.35"
        stroke-linejoin="round"
      />
    </svg>
  </span>
</button>
