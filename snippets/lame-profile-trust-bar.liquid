{%- doc -%}
  Trust badges row at the bottom of the profile page.
{%- enddoc -%}

<div class="lame-acct-trust" role="region" aria-label="{{ 'lame_cart.trust_aria' | t }}">
  <ul class="lame-acct-trust__list" role="list">
    <li class="lame-acct-trust__item">
      <span class="lame-acct-trust__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3 4 7v5c0 4.4 3.4 8.5 8 9.5 4.6-1 8-5.1 8-9.5V7l-8-4Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="lame-acct-trust__label">{{ 'lame_customer.trust_genuine' | t }}</span>
    </li>
    <li class="lame-acct-trust__item">
      <span class="lame-acct-trust__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.2"/><path d="M7 7V5a5 5 0 0 1 10 0v2" stroke="currentColor" stroke-width="1.2"/></svg>
      </span>
      <span class="lame-acct-trust__label">{{ 'lame_customer.trust_payments' | t }}</span>
    </li>
    <li class="lame-acct-trust__item">
      <span class="lame-acct-trust__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 12h16M12 4v16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M7 7h10v10H7z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
      </span>
      <span class="lame-acct-trust__label">{{ 'lame_customer.trust_returns' | t }}</span>
    </li>
    <li class="lame-acct-trust__item">
      <span class="lame-acct-trust__icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 6.5h16v11H4z" stroke="currentColor" stroke-width="1.2"/><path d="M4 9.5 12 14l8-4.5" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/></svg>
      </span>
      <span class="lame-acct-trust__label">{{ 'lame_customer.trust_support' | t }}</span>
    </li>
  </ul>
</div>
