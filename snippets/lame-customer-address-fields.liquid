{% doc %}
  Renders address form fields for customer address forms.

  @param {object} form - The address form object from {% form 'customer_address' %}
  @param {string} prefix - ID prefix for fields (e.g. 'New' or address id)
{% enddoc %}

<div class="lame-profile__field-row">
  <div class="lame-profile__field">
    <label for="AddressFirstName_{{ prefix }}">{{ 'customer.addresses.first_name' | t }}</label>
    <input
      type="text"
      id="AddressFirstName_{{ prefix }}"
      name="address[first_name]"
      value="{{ form.first_name }}"
      autocomplete="given-name"
      class="lame-profile__input"
    >
  </div>
  <div class="lame-profile__field">
    <label for="AddressLastName_{{ prefix }}">{{ 'customer.addresses.last_name' | t }}</label>
    <input
      type="text"
      id="AddressLastName_{{ prefix }}"
      name="address[last_name]"
      value="{{ form.last_name }}"
      autocomplete="family-name"
      class="lame-profile__input"
    >
  </div>
</div>

<div class="lame-profile__field">
  <label for="AddressCompany_{{ prefix }}">{{ 'customer.addresses.company' | t }}</label>
  <input
    type="text"
    id="AddressCompany_{{ prefix }}"
    name="address[company]"
    value="{{ form.company }}"
    autocomplete="organization"
    class="lame-profile__input"
  >
</div>

<div class="lame-profile__field">
  <label for="AddressAddress1_{{ prefix }}">{{ 'customer.addresses.address1' | t }}</label>
  <input
    type="text"
    id="AddressAddress1_{{ prefix }}"
    name="address[address1]"
    value="{{ form.address1 }}"
    autocomplete="address-line1"
    class="lame-profile__input"
  >
</div>

<div class="lame-profile__field">
  <label for="AddressAddress2_{{ prefix }}">{{ 'customer.addresses.address2' | t }}</label>
  <input
    type="text"
    id="AddressAddress2_{{ prefix }}"
    name="address[address2]"
    value="{{ form.address2 }}"
    autocomplete="address-line2"
    class="lame-profile__input"
  >
</div>

<div class="lame-profile__field-row">
  <div class="lame-profile__field">
    <label for="AddressCity_{{ prefix }}">{{ 'customer.addresses.city' | t }}</label>
    <input
      type="text"
      id="AddressCity_{{ prefix }}"
      name="address[city]"
      value="{{ form.city }}"
      autocomplete="address-level2"
      class="lame-profile__input"
    >
  </div>
  <div class="lame-profile__field">
    <label for="AddressZip_{{ prefix }}">{{ 'customer.addresses.zip' | t }}</label>
    <input
      type="text"
      id="AddressZip_{{ prefix }}"
      name="address[zip]"
      value="{{ form.zip }}"
      autocomplete="postal-code"
      class="lame-profile__input"
    >
  </div>
</div>

<div class="lame-profile__field-row">
  <div class="lame-profile__field">
    <label for="AddressCountry_{{ prefix }}">{{ 'customer.addresses.country' | t }}</label>
    <select
      id="AddressCountry_{{ prefix }}"
      name="address[country]"
      data-default="{{ form.country }}"
      data-address-country-select
      {% if prefix != 'New' %}
        data-form-id="{{ prefix }}"
      {% endif %}
      autocomplete="country"
      class="lame-profile__input lame-profile__select"
    >
      {{ all_country_option_tags }}
    </select>
  </div>
  <div id="AddressProvinceContainer_{{ prefix }}" class="lame-profile__field">
    <label for="AddressProvince_{{ prefix }}">{{ 'customer.addresses.province' | t }}</label>
    <select
      id="AddressProvince_{{ prefix }}"
      name="address[province]"
      data-default="{{ form.province }}"
      autocomplete="address-level1"
      class="lame-profile__input lame-profile__select"
    ></select>
  </div>
</div>

<div class="lame-profile__field">
  <label for="AddressPhone_{{ prefix }}">{{ 'customer.addresses.phone' | t }}</label>
  <input
    type="tel"
    id="AddressPhone_{{ prefix }}"
    name="address[phone]"
    value="{{ form.phone }}"
    autocomplete="tel"
    class="lame-profile__input"
  >
</div>

<label class="lame-profile__checkbox">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
