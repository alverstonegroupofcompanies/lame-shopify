{%- doc -%}
  Full-width Our Products catalog banner — image only.
{%- enddoc -%}

{%- liquid
  assign image_alt = image_alt | default: 'Our Products'
-%}

<section class="lame-op-mini-banner lame-op-mini-banner--tall lame-op-mini-banner--image-only" aria-label="{{ image_alt | escape }}">
  <div class="lame-op-mini-banner__surface">
    <img
      class="lame-op-mini-banner__image"
      src="{{ 'lame-our-products-banner-v2.png' | asset_url }}"
      alt="{{ image_alt | escape }}"
      width="1600"
      height="520"
      loading="eager"
      fetchpriority="high"
    >
  </div>
</section>
