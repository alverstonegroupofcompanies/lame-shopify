{%- doc -%}
  Mobile and tablet fixed bottom navigation tab bar (Nykaa style).
  Rendered on mobile / tablet screens <= 989px.
{%- enddoc -%}

<nav class="lame-mobile-bottom-bar mobile:flex desktop:hidden" aria-label="Quick mobile navigation" data-lame-mobile-bottom-bar>
  <!-- 1. Home Tab -->
  <a
    href="{{ routes.root_url }}"
    class="lame-mobile-bottom-bar__tab{% if template.name == 'index' %} is-active{% endif %}"
    {% if template.name == 'index' %}aria-current="page"{% endif %}
  >
    <div class="lame-mobile-bottom-bar__icon-wrap">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="{% if template.name == 'index' %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
        <polyline points="9 22 9 12 15 12 15 22"/>
      </svg>
    </div>
    <span class="lame-mobile-bottom-bar__label">Home</span>
  </a>

  <!-- 2. Shop Tab -->
  {%- liquid
    assign is_shop_active = false
    if template.name == 'collection'
      assign is_shop_active = true
    endif
  -%}
  <a
    href="{{ routes.all_products_collection_url }}"
    class="lame-mobile-bottom-bar__tab{% if is_shop_active %} is-active{% endif %}"
    {% if is_shop_active %}aria-current="page"{% endif %}
  >
    <div class="lame-mobile-bottom-bar__icon-wrap">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="{% if is_shop_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="7" height="7" x="3" y="3" rx="1.5"/>
        <rect width="7" height="7" x="14" y="3" rx="1.5"/>
        <rect width="7" height="7" x="14" y="14" rx="1.5"/>
        <rect width="7" height="7" x="3" y="14" rx="1.5"/>
      </svg>
    </div>
    <span class="lame-mobile-bottom-bar__label">Shop</span>
  </a>

  <!-- 3. Offers Tab -->
  <a
    href="/collections/all?sort_by=best-selling"
    class="lame-mobile-bottom-bar__tab"
  >
    <div class="lame-mobile-bottom-bar__icon-wrap">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 2l2.4 4.8 5.3.8-3.8 3.7.9 5.3L12 16.1l-4.8 2.5.9-5.3-3.8-3.7 5.3-.8L12 2z"/>
      </svg>
    </div>
    <span class="lame-mobile-bottom-bar__label">Offers</span>
  </a>

  <!-- 4. Account Tab -->
  {%- liquid
    assign is_account_active = false
    if template.name contains 'customer' or template.name == 'account'
      assign is_account_active = true
    endif
  -%}
  <a
    href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
    class="lame-mobile-bottom-bar__tab{% if is_account_active %} is-active{% endif %}"
    {% if is_account_active %}aria-current="page"{% endif %}
  >
    <div class="lame-mobile-bottom-bar__icon-wrap">
      <svg width="21" height="21" viewBox="0 0 24 24" fill="{% if is_account_active %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
        <circle cx="12" cy="7" r="4"/>
      </svg>
    </div>
    <span class="lame-mobile-bottom-bar__label">Account</span>
  </a>
</nav>
