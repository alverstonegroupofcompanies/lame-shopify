{%- doc -%}
  Our Products catalog card — listing style (tags, price, optional sale bar).

  @param {object} product
  @param {object} section
  @param {boolean} [show_wishlist]
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign can_quick_add = false
  if product.has_only_default_variant and variant.available
    assign can_quick_add = true
  endif
  assign show_wishlist = show_wishlist | default: true

  assign lame_discount_percent = 0
  assign compare_at = variant.compare_at_price
  assign price_amount = variant.price
  if compare_at > price_amount and compare_at > 0
    assign lame_discount_percent = compare_at | minus: price_amount | times: 100.0 | divided_by: compare_at | round
  endif

  assign tags_down = product.tags | join: ',' | downcase
  assign is_featured = false
  assign is_new = false
  assign is_bestseller = false
  if tags_down contains 'featured'
    assign is_featured = true
  endif
  if tags_down contains 'new'
    assign is_new = true
  endif
  if tags_down contains 'bestseller' or tags_down contains 'best seller' or tags_down contains 'best-seller'
    assign is_bestseller = true
  endif

  assign promo_label = blank
  if product.metafields.custom.promo_label.value != blank
    assign promo_label = product.metafields.custom.promo_label.value
  else
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'best of' or tag_down contains 'most reordered'
        assign promo_label = tag
        break
      endif
    endfor
  endif

  assign variant_count = product.variants.size
  assign form_id = 'CatalogCard-Form-' | append: section.id | append: '-' | append: product.id
  assign show_sale_bar = false
  if lame_discount_percent >= 15
    assign show_sale_bar = true
  endif
-%}

<article class="lame-catlog-card{% unless product.available %} is-sold-out{% endunless %}">
  <div class="lame-catlog-card__top">
    <div class="lame-catlog-card__tags">
      {% unless product.available %}
        <span class="lame-catlog-card__tag lame-catlog-card__tag--soldout">SOLD OUT</span>
      {% elsif is_bestseller %}
        <span class="lame-catlog-card__tag lame-catlog-card__tag--bestseller">BESTSELLER</span>
      {% elsif is_new %}
        <span class="lame-catlog-card__tag lame-catlog-card__tag--new">NEW</span>
      {% elsif is_featured %}
        <span class="lame-catlog-card__tag lame-catlog-card__tag--featured">FEATURED</span>
      {% endif %}
    </div>

    {% if show_wishlist and settings.lame_enable_wishlist %}
      <div class="lame-catlog-card__wish">
        {% render 'lame-our-products-wishlist-btn', product: product %}
      </div>
    {% endif %}
  </div>

  <a href="{{ product.url }}" class="lame-catlog-card__media">
    {% if product.featured_media %}
      {{
        product.featured_media
        | image_url: width: 720
        | image_tag:
          class: 'lame-catlog-card__image',
          loading: 'lazy',
          widths: '240,320,400,540,720',
          sizes: '(min-width: 990px) 22vw, (min-width: 750px) 36vw, 46vw',
          alt: product.featured_media.alt | default: product.title
      }}
    {% else %}
      <div class="lame-catlog-card__image lame-catlog-card__image--placeholder" aria-hidden="true"></div>
    {% endif %}
  </a>

  <div class="lame-catlog-card__body">
    <h3 class="lame-catlog-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="lame-catlog-card__price-row">
      {% if compare_at > price_amount %}
        <span class="lame-catlog-card__mrp">{{ compare_at | money }}</span>
        <span class="lame-catlog-card__price">{{ price_amount | money }}</span>
        {% if lame_discount_percent > 0 %}
          <span class="lame-catlog-card__off">{{ lame_discount_percent }}% Off</span>
        {% endif %}
      {% else %}
        <span class="lame-catlog-card__price">{{ price_amount | money }}</span>
      {% endif %}
    </div>

    <div class="lame-catlog-card__actions">
      {% if can_quick_add %}
        <product-form-component
          class="lame-catlog-card__form-wrap"
          data-section-id="{{ section.id }}"
          data-product-id="{{ product.id }}"
          data-product-url="{{ product.url }}"
        >
          {%- form 'product', product, id: form_id, class: 'lame-catlog-card__form' -%}
            <input type="hidden" name="id" value="{{ variant.id }}" ref="variantId">
            <button type="submit" name="add" class="lame-catlog-card__atc">
              <span class="lame-catlog-card__atc-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6 5 3H2"/></svg>
              </span>
              <span>{{ 'actions.add_to_cart' | t }}</span>
            </button>
          {%- endform -%}
        </product-form-component>
      {% elsif product.available == false %}
        <span class="lame-catlog-card__atc is-disabled">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
      {% else %}
        <a href="{{ product.url }}" class="lame-catlog-card__atc">
          <span class="lame-catlog-card__atc-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6 5 3H2"/></svg>
          </span>
          <span>{{ 'lame_category_shop.view_product' | t }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</article>
