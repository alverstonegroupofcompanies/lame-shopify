{%- doc -%}
  Small line icon for shop mega menu category links.
  @param {string} handle - Collection or link handle
{%- enddoc -%}

{%- liquid
  assign icon_handle = handle | downcase | strip
-%}

<span class="lame-shop-mega__icon" aria-hidden="true">
  {%- case icon_handle -%}
    {%- when 'skin-care', 'skincare' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3c-4 6-7 10-7 14a7 7 0 0 0 14 0c0-4-3-8-7-14Z"/><path d="M12 11v6"/></svg>
    {%- when 'bath-body', 'bath-and-body' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 10h10l1 8H6l1-8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg>
    {%- when 'fragrance' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 3h6v4H9z"/><path d="M10 7h4v14h-4z"/><path d="M8 11h8"/></svg>
    {%- when 'make-up', 'makeup' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3"/><path d="M6 21c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>
    {%- when 'hair-care', 'haircare', 'hair' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4c0 4 2 6 4 8 2-2 4-4 4-8"/><path d="M6 20c2-6 4-8 6-8s4 2 6 8"/></svg>
    {%- when 'baby-mom', 'baby' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="7" r="3"/><path d="M6 20c1.5-4 3.5-6 6-6s4.5 2 6 6"/></svg>
    {%- when 'wellness' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 5.5-7 10-7 10Z"/></svg>
    {%- when 'frontpage', 'all', 'our-products', 'products' -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16l-1 12H5L4 7Z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
  {%- endcase -%}
</span>
