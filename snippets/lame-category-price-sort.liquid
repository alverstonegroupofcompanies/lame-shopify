{%- doc -%}
  Toolbar for individual category collection pages: result count, price range,
  brand filter, sort, and clear.

  @param {object} collection - Collection
  @param {object} paginate - Paginate object
{%- enddoc -%}

{%- liquid
  assign range_start = paginate.current_offset | plus: 1
  assign range_end = paginate.current_offset | plus: paginate.page_size
  if range_end > paginate.items
    assign range_end = paginate.items
  endif

  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign sort_form_action = collection.url
  if collection.current_type != blank or collection.current_vendor != blank
    assign sort_form_action = collection.url | append: '/'
  endif

  assign active_price_range = 'all'
  assign active_vendor = blank

  for filter in collection.filters
    if filter.type == 'price_range'
      assign price_min = filter.min_value.value | default: 0 | plus: 0
      assign price_max = filter.max_value.value | default: 0 | plus: 0

      if price_max == 400 and price_min <= 0
        assign active_price_range = '0-400'
      elsif price_min == 400 and price_max == 800
        assign active_price_range = '400-800'
      elsif price_min == 800 and price_max == 1200
        assign active_price_range = '800-1200'
      endif
    endif

    if filter.param_name == 'filter.p.vendor'
      for value in filter.active_values
        assign active_vendor = value.value
      endfor
    endif
  endfor

  assign brand_count = 0
  assign vendors_sorted = collection.all_vendors | sort
-%}

<div class="lame-category-shop__toolbar">
  <p class="lame-category-shop__count" role="status">
    {{ 'lame_category_shop.showing_range' | t: from: range_start, to: range_end, total: paginate.items }}
  </p>

  <lame-category-filters class="lame-category-shop__filters">
    <div class="lame-category-shop__filters-panel">
      <form
        class="lame-category-shop__filter-form"
        method="get"
        action="{{ sort_form_action }}"
        data-lame-category-filter-form
      >
        <div class="lame-category-shop__price-hidden" data-price-hidden-inputs hidden>
          {%- if active_price_range != 'all' -%}
            {%- assign active_range_parts = active_price_range | split: '-' -%}
            <input type="hidden" name="filter.v.price.gte" value="{{ active_range_parts[0] }}">
            <input type="hidden" name="filter.v.price.lte" value="{{ active_range_parts[1] }}">
          {%- endif -%}
        </div>

        {%- comment -%} Preserve other active filters except vendor and price {%- endcomment -%}
        {%- for filter in collection.filters -%}
          {%- unless filter.type == 'price_range' or filter.param_name == 'filter.p.vendor' -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
          {%- endunless -%}
        {%- endfor -%}

        {%- if collection.current_type != blank -%}
          <input type="hidden" name="q" value="{{ collection.current_type | escape }}">
        {%- endif -%}

        <div class="lame-category-shop__filter-group lame-category-shop__filter-group--price">
          <label class="lame-category-shop__filter-label" for="lame-category-price-{{ collection.id }}">
            {{ 'lame_category_shop.filter_price' | t }}
          </label>
          <select
            id="lame-category-price-{{ collection.id }}"
            class="lame-category-shop__price-select"
            data-price-filter
            data-auto-submit
          >
            {%- assign price_ranges = 'all,0-400,400-800,800-1200' | split: ',' -%}
            {%- for range_key in price_ranges -%}
              {%- liquid
                assign range_label = blank
                case range_key
                  when 'all'
                    assign range_label = 'lame_category_shop.price_all'
                  when '0-400'
                    assign range_label = 'lame_category_shop.price_range_low'
                  when '400-800'
                    assign range_label = 'lame_category_shop.price_range_mid'
                  when '800-1200'
                    assign range_label = 'lame_category_shop.price_range_high'
                endcase
              -%}
              <option value="{{ range_key }}" {% if active_price_range == range_key %}selected{% endif %}>
                {{ range_label | t }}
              </option>
            {%- endfor -%}
          </select>
        </div>

        <div class="lame-category-shop__filter-group lame-category-shop__filter-group--brand">
          <label class="lame-category-shop__filter-label" for="lame-category-brand-{{ collection.id }}">
            {{ 'lame_category_shop.filter_brand' | t }}
          </label>
          <select
            id="lame-category-brand-{{ collection.id }}"
            class="lame-category-shop__brand-select"
            name="filter.p.vendor"
            data-auto-submit
          >
            <option value="">{{ 'lame_category_shop.brand_all' | t }}</option>
            {%- for vendor_name in vendors_sorted -%}
              {%- assign vendor_name_stripped = vendor_name | strip -%}
              {%- if vendor_name_stripped != blank -%}
                {%- assign brand_count = brand_count | plus: 1 -%}
                {%- liquid
                  assign display_label = vendor_name_stripped
                  assign label_down = vendor_name_stripped | downcase
                  if label_down contains 'lamstone'
                    assign display_label = 'Lamstone Healthcare'
                  endif
                -%}
                <option
                  value="{{ vendor_name_stripped | escape }}"
                  {% if active_vendor == vendor_name_stripped %}selected{% endif %}
                >
                  {{ display_label | escape }}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>

        <div class="lame-category-shop__filter-group lame-category-shop__filter-group--sort">
          <label class="lame-category-shop__filter-label" for="lame-category-sort-{{ collection.id }}">
            {{ 'lame_category_shop.sort_label' | t }}
          </label>
          <select
            id="lame-category-sort-{{ collection.id }}"
            class="lame-category-shop__sort-select"
            name="sort_by"
            data-auto-submit
          >
            <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>
              {{ 'lame_category_shop.sort_price_low' | t }}
            </option>
            <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>
              {{ 'lame_category_shop.sort_price_high' | t }}
            </option>
          </select>
        </div>

        <button
          type="button"
          class="lame-category-shop__clear-btn{% if active_vendor == blank and active_price_range == 'all' %} is-hidden{% endif %}"
          data-clear-filters
          {% if active_vendor == blank and active_price_range == 'all' %}
            hidden
          {% endif %}
        >
          {{ 'lame_category_shop.clear_filters' | t }}
        </button>
      </form>
    </div>
  </lame-category-filters>
</div>

<script
  src="{{ 'lame-category-filters.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
