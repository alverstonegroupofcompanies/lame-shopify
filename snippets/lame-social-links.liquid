{%- doc -%}
  Shared social links for header + drawer.
  Reads URLs from a settings object (section or block) using a setting prefix.

  @param {object} [block] - Block with social URL settings (uses block.settings)
  @param {object} [settings] - Settings object to read from (section.settings or block.settings)
  @param {string} [setting_prefix] - Prefix before *_url keys (default: drawer_)
  @param {string} [class] - Extra class on the root
  @param {string} [heading] - Optional section heading
  @param {string} [text] - Optional supporting text
  @param {boolean} [show_labels] - Show text labels next to icons (default: true)
  @param {boolean} [icon_only] - Compact icon buttons without labels
{%- enddoc -%}

{%- liquid
  assign prefix = setting_prefix | default: 'drawer_'
  assign show_labels = show_labels | default: true, allow_false: true
  assign icon_only = icon_only | default: false
  assign social_settings = settings

  if social_settings == blank and block != blank
    assign social_settings = block.settings
  endif

  if icon_only
    assign show_labels = false
  endif

  assign key_x = prefix | append: 'twitter_url'
  assign key_yt = prefix | append: 'youtube_url'
  assign key_ig = prefix | append: 'instagram_url'
  assign key_fb = prefix | append: 'facebook_url'
  assign key_threads = prefix | append: 'threads_url'
  assign key_wa = prefix | append: 'whatsapp_url'

  assign url_x = social_settings[key_x] | strip
  assign url_yt = social_settings[key_yt] | strip
  assign url_ig = social_settings[key_ig] | strip
  assign url_fb = social_settings[key_fb] | strip
  assign url_threads = social_settings[key_threads] | strip
  assign url_wa = social_settings[key_wa] | strip

  assign has_links = false
  if url_x != blank or url_yt != blank or url_ig != blank or url_fb != blank or url_threads != blank or url_wa != blank
    assign has_links = true
  endif
-%}

{%- if has_links -%}
  <div class="lame-social-links{% if class != blank %} {{ class }}{% endif %}{% if icon_only %} lame-social-links--icons{% endif %}">
    {%- if heading != blank -%}
      <p class="lame-social-links__heading">{{ heading | escape }}</p>
    {%- endif -%}
    {%- if text != blank -%}
      <p class="lame-social-links__text">{{ text | escape }}</p>
    {%- endif -%}
    <ul class="lame-social-links__list" role="list">
      {%- if url_x != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_x }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="X"
            {% if icon_only %}title="X"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'twitter' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">X</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
      {%- if url_yt != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_yt }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            {% if icon_only %}title="YouTube"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'youtube' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">YouTube</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
      {%- if url_ig != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_ig }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            {% if icon_only %}title="Instagram"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'instagram' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">Instagram</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
      {%- if url_fb != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_fb }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            {% if icon_only %}title="Facebook"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'facebook' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">Facebook</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
      {%- if url_threads != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_threads }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Threads"
            {% if icon_only %}title="Threads"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'threads' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">Threads</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
      {%- if url_wa != blank -%}
        <li>
          <a
            class="lame-social-links__link"
            href="{{ url_wa }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp Channel"
            {% if icon_only %}title="WhatsApp Channel"{% endif %}
          >
            <span class="lame-social-links__icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" focusable="false" fill="currentColor">
                {%- render 'icon', icon: 'whatsapp' -%}
              </svg>
            </span>
            {%- if show_labels -%}<span class="lame-social-links__label">WhatsApp</span>{%- endif -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}
