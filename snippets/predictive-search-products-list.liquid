{%- doc -%}
  Renders the predictive search products list for empty state and recently viewed products

  @param {string} title - title of the result list
  @param {object[]} products - array of products
  @param {string[]} [order_ids] - array of product ids
  @param {number} [limit] - limit of products to display
  @param {string} [products_test_id] - a playwright test id, used to differentiate empty state from 'real' search results
  @param {boolean} [use_lame_cards] - Use Lame compact search cards
{%- enddoc -%}
{%- liquid
  assign recently_viewed_title_text = 'content.recently_viewed_products' | t
  if use_lame_cards == blank
    assign use_lame_cards = true
  endif
  assign list_class = 'predictive-search-results__list predictive-search-results__wrapper-products list-unstyled'
  if title == recently_viewed_title_text and use_lame_cards
    assign list_class = list_class | append: ' lame-search-carousel'
  endif
-%}
<div
  id="predictive-search-products"
  class="predictive-search-results__products"
  {% if products_test_id %}
    data-testid="{{ products_test_id }}"
  {% endif %}
>
  {% if title == recently_viewed_title_text %}
    <div
      class="recently-viewed-wrapper lame-search-section lame-search-section--recent"
      ref="recentlyViewedWrapper"
    >
      <h4
        class="predictive-search-results__title lame-search-section__header"
        ref="recentlyViewedTitle[]"
      >
        <span class="lame-search-section__title">
          {{ title }}
        </span>
        <button
          class="predictive-search-results__clear button button-unstyled lame-search-section__link"
          type="button"
          on:click="/clearRecentlyViewedProducts"
        >
          {{ 'lame_search.clear_all' | t }}
        </button>
      </h4>
      <ul class="{{ list_class }}">
        {% liquid
          assign limit = limit | default: 8
        %}
        {% if order_ids != blank %}
          {% for _id in order_ids %}
            {% assign int_id = _id | times: 1 %}
            {% assign product = products | find: 'id', int_id %}
            {% if product != blank %}
              <li
                class="predictive-search-results__card predictive-search-results__card--product"
                ref="recentlyViewedItems[]"
              >
                {% if use_lame_cards %}
                  {% render 'lame-predictive-search-product-card', product: product, section: section %}
                {% else %}
                  {% render 'resource-card',
                    resource_type: 'product',
                    resource: product,
                    image_width: 500,
                    image_hover: true,
                    image_aspect_ratio: '1 / 1'
                  %}
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        {% else %}
          {% for product in products limit: limit %}
            <li
              class="predictive-search-results__card predictive-search-results__card--product"
              ref="recentlyViewedItems[]"
            >
              {% if use_lame_cards %}
                {% render 'lame-predictive-search-product-card', product: product, section: section %}
              {% else %}
                {% render 'resource-card',
                  resource_type: 'product',
                  resource: product,
                  image_width: 500,
                  image_hover: true,
                  image_aspect_ratio: '1 / 1'
                %}
              {% endif %}
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  {% else %}
    <h4 class="predictive-search-results__title">
      {{ title }}
    </h4>
    <ul class="{{ list_class }}">
      {% liquid
        assign limit = limit | default: 8
      %}
      {% for product in products limit: limit %}
        <li
          class="predictive-search-results__card predictive-search-results__card--product"
          ref="resultsItems[]"
        >
          {% if use_lame_cards %}
            {% render 'lame-predictive-search-product-card', product: product, section: section %}
          {% else %}
            {% render 'resource-card',
              resource_type: 'product',
              resource: product,
              image_width: 500,
              image_hover: true,
              image_aspect_ratio: '1 / 1'
            %}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
</div>
