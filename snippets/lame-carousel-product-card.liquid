{%- doc -%}
  Carousel product card — used by Best Sellers and other product carousels.
  Matches standard catalog product card design.
{%- enddoc -%}

{%- if product != blank -%}
  {% render 'lame-flash-deal-card',
    product: product,
    badge_label: offer_badge_text,
    add_to_cart_label: add_to_cart_label,
    sold_out_label: sold_out_label
  %}
{%- else -%}
{%- liquid
  assign is_custom = false
  if product == blank and custom_title != blank
    assign is_custom = true
  endif

  if is_custom
    assign card_title = custom_title
    assign card_brand = custom_brand | default: 'Sebamed'
    assign card_subtitle = custom_subtitle
    assign card_badge = custom_badge
    assign card_rating = custom_rating | default: '4.8'
    assign card_reviews = custom_reviews | default: '150+'
    assign card_price = custom_price
    assign card_compare = custom_compare_price
    assign card_url = custom_link
    if card_url == blank
      assign brand_down = card_brand | downcase
      if brand_down contains 'sebamed'
        assign card_url = routes.all_products_collection_url | append: '?filter.p.vendor=SebaMed'
      elsif brand_down contains 'vaseline'
        assign card_url = routes.all_products_collection_url | append: '?filter.p.vendor=Vaseline'
      else
        assign card_url = routes.all_products_collection_url
      endif
    endif

    assign card_image_markup = ''
    if custom_image != blank
      capture card_image_markup
        echo custom_image | image_url: width: 600 | image_tag: class: 'lame-carousel-card__image', loading: 'lazy', widths: '200,300,400,500,600', sizes: '(min-width: 990px) 18vw, (min-width: 750px) 28vw, 42vw', alt: card_title | escape
      endcapture
    elsif custom_fallback_asset != blank
      assign fallback_asset_url = custom_fallback_asset | asset_url
      capture card_image_markup
        echo '<img class="lame-carousel-card__image" src="'
        echo fallback_asset_url
        echo '" alt="'
        echo card_title | escape
        echo '" width="600" height="600" loading="lazy">'
      endcapture
    endif
  else
    assign selected_variant = product.selected_or_first_available_variant
    assign compare_at = selected_variant.compare_at_price
    assign price_amount = selected_variant.price
    capture lame_sale_raw
      render 'lame-product-sale-data', product: product
    endcapture
    assign lame_sale_parts = lame_sale_raw | split: '|'
    assign discount_percent = lame_sale_parts[0] | strip | plus: 0
    assign lame_effective_compare = lame_sale_parts[1] | strip | plus: 0
    assign lame_on_sale_flag = lame_sale_parts[2] | strip | plus: 0
    assign lame_sale_badge_label = lame_sale_parts[3] | strip
    assign lame_sale_price = lame_sale_parts[4] | strip | plus: 0
    assign on_sale = false
    if lame_on_sale_flag == 1
      assign on_sale = true
    endif
    if on_sale and lame_effective_compare > 0
      assign compare_at = lame_effective_compare
    endif
    if on_sale and lame_sale_price > 0 and lame_sale_price < compare_at
      assign price_amount = lame_sale_price
    endif

    assign card_title = product.title
    assign card_brand = product.vendor | default: ''
    assign card_subtitle = ''
    assign card_url = product.url
    assign card_price = price_amount | money
    if on_sale
      assign card_compare = compare_at | money
      if lame_sale_badge_label != blank
        assign card_badge = lame_sale_badge_label
      elsif discount_percent > 0
        assign card_badge = discount_percent | append: '% OFF'
      endif
    endif
    assign card_rating = '4.8'
    assign card_reviews = '120+'
  endif

  if offer_badge_text != blank
    assign card_badge = offer_badge_text
  endif

  assign add_label = add_to_cart_label | default: 'Add to Cart'
  assign sold_label = sold_out_label | default: 'Sold Out'
-%}

<article class="lame-carousel-card{% if is_custom %} lame-carousel-card--curated{% endif %}">
  <div class="lame-carousel-card__media">
    <a href="{{ card_url }}" class="lame-carousel-card__media-link" aria-label="{{ card_title | escape }}">
      {%- if is_custom -%}
        {%- if card_image_markup != blank -%}
          {{ card_image_markup }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-carousel-card__image placeholder-svg' }}
        {%- endif -%}
      {%- else -%}
        {%- if product.featured_media -%}
          {{
            product.featured_media
            | image_url: width: 600
            | image_tag:
              class: 'lame-carousel-card__image',
              loading: 'lazy',
              widths: '200,300,400,500,600',
              sizes: '(min-width: 990px) 18vw, (min-width: 750px) 28vw, 42vw',
              alt: product.featured_media.alt | default: product.title | escape
          }}
        {%- else -%}
          {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-carousel-card__image placeholder-svg' }}
        {%- endif -%}
      {%- endif -%}
    </a>

    {%- if show_offer_badge and card_badge != blank -%}
      <span class="lame-carousel-card__offer">{{ card_badge | escape }}</span>
    {%- endif -%}
  </div>

  <div class="lame-carousel-card__content">
    {%- if card_brand != blank -%}
      <span class="lame-carousel-card__brand">{{ card_brand | escape }}</span>
    {%- endif -%}

    <h3 class="lame-carousel-card__title">
      <a href="{{ card_url }}">{{ card_title | escape }}</a>
    </h3>

    {%- if card_subtitle != blank -%}
      <p class="lame-carousel-card__subtitle">{{ card_subtitle | escape }}</p>
    {%- endif -%}

    <div class="lame-carousel-card__rating-row">
      <span class="lame-carousel-card__stars" aria-hidden="true">★★★★★</span>
      <span class="lame-carousel-card__rating-score">{{ card_rating }}</span>
      <span class="lame-carousel-card__reviews-count">({{ card_reviews }})</span>
    </div>

    <p class="lame-carousel-card__price-row">
      <span class="lame-carousel-card__price-current">{{ card_price }}</span>
      {%- if card_compare != blank -%}
        <span class="lame-carousel-card__price-compare"><s>{{ card_compare }}</s></span>
      {%- endif -%}
      {%- if card_badge != blank -%}
        <span class="lame-carousel-card__price-off">{{ card_badge }}</span>
      {%- endif -%}
    </p>

    {%- if is_custom -%}
      <div class="lame-carousel-card__atc-form">
        <a
          href="{{ card_url }}"
          class="lame-carousel-card__atc lame-carousel-card__atc--link"
          data-curated-atc
          data-brand="{{ card_brand | escape }}"
          data-title="{{ card_title | escape }}"
        >
          {{ add_label }}
        </a>
        <span class="lame-carousel-card__atc-status" aria-live="polite"></span>
      </div>
    {%- elsif selected_variant -%}
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        class="lame-carousel-card__atc-form"
        data-lame-carousel-atc
      >
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
        <input type="hidden" name="quantity" value="{{ lame_bogo_qty | strip }}">
        <button
          type="submit"
          class="lame-carousel-card__atc"
          {% unless product.available %}
            disabled
          {% endunless %}
        >
          {% if product.available %}
            {{ add_label }}
          {% else %}
            {{ sold_label }}
          {% endif %}
        </button>
        <span class="lame-carousel-card__atc-status" aria-live="polite"></span>
      </form>
    {%- endif -%}
  </div>
</article>
{%- endif -%}
