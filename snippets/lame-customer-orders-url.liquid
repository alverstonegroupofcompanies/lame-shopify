{%- doc -%}
  Outputs the themed customer orders page URL.

  @param {object} [section] - Header section with orders_page setting
{%- enddoc -%}

{%- liquid
  assign lame_orders_url = ''
  if section != blank and section.settings.orders_page != blank
    assign lame_orders_url = section.settings.orders_page.url
  elsif pages['my-orders'] != blank
    assign lame_orders_url = pages['my-orders'].url
  endif

  if lame_orders_url == blank
    capture lame_profile_url
      render 'lame-customer-profile-url', section: section
    endcapture
    assign lame_orders_url = lame_profile_url
  endif
-%}{{- lame_orders_url -}}
