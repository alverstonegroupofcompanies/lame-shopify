{% comment %}
  MyLamstone Tawk.to polish
  - Branded launcher (forest + gold + Jost)
  - Lifted above bottom
  - Colors / fonts / auto-replies inside the chat panel are controlled in Tawk Admin
{% endcomment %}

{{ 'lame-tawk-chat.css' | asset_url | stylesheet_tag }}

<button
  type="button"
  class="lame-tawk-launcher is-hidden"
  id="lame-tawk-launcher"
  aria-label="Chat with MyLamstone"
  hidden
>
  <span class="lame-tawk-launcher__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" focusable="false">
      <path d="M4.5 6.5h15a1.5 1.5 0 0 1 1.5 1.5v7a1.5 1.5 0 0 1-1.5 1.5H13l-3.2 3.1v-3.1H4.5A1.5 1.5 0 0 1 3 15V8a1.5 1.5 0 0 1 1.5-1.5Z"/>
      <path d="M8 10.25h8M8 13h5"/>
    </svg>
  </span>
  <span class="lame-tawk-launcher__copy">
    <span class="lame-tawk-launcher__eyebrow">MyLamstone</span>
    <span class="lame-tawk-launcher__label">Chat with us</span>
  </span>
</button>

<script>
  window.Tawk_API = window.Tawk_API || {};
  window.Tawk_LoadStart = window.Tawk_LoadStart || new Date();

  window.Tawk_API.customStyle = {
    zIndex: 2147483000,
    visibility: {
      desktop: {
        position: 'br',
        xOffset: 18,
        yOffset: {% if template.name == 'product' %}100{% else %}88{% endif %}
      },
      mobile: {
        position: 'br',
        xOffset: 12,
        yOffset: {% if template.name == 'product' %}128{% else %}96{% endif %}
      },
      bubble: {
        rotate: '0deg',
        xOffset: -12,
        yOffset: 0
      }
    }
  };

  document.documentElement.classList.add('lame-tawk-ready');

  (function () {
    var launcher = document.getElementById('lame-tawk-launcher');
    if (!launcher) return;

    var showLauncher = function () {
      document.body.classList.add('lame-tawk-custom-launcher', 'lame-tawk-hide-bubble');
      launcher.hidden = false;
      launcher.classList.remove('is-hidden');
    };

    var hideLauncher = function () {
      launcher.classList.add('is-hidden');
      window.setTimeout(function () {
        if (launcher.classList.contains('is-hidden')) launcher.hidden = true;
      }, 180);
    };

    var openChat = function () {
      try {
        if (typeof window.Tawk_API.maximize === 'function') {
          window.Tawk_API.maximize();
          hideLauncher();
          return;
        }
      } catch (e) {}
      hideLauncher();
    };

    launcher.addEventListener('click', openChat);

    var prevOnLoad = window.Tawk_API.onLoad;
    window.Tawk_API.onLoad = function () {
      if (typeof prevOnLoad === 'function') {
        try {
          prevOnLoad();
        } catch (e) {}
      }

      document.body.classList.add('lame-tawk-api-positioned');
      showLauncher();

      try {
        if (typeof window.Tawk_API.setAttributes === 'function') {
          window.Tawk_API.setAttributes(
            {
              store: {{ shop.name | json }},
              page: {{ request.path | json }}
            },
            function () {}
          );
        }
      } catch (e) {}

      try {
        var tries = 0;
        var timer = window.setInterval(function () {
          tries += 1;
          var iframe =
            document.querySelector("iframe[title='chat widget']") ||
            document.querySelector("iframe[title*='Tawk']") ||
            document.querySelector("iframe[title*='tawk']");

          if (!iframe) {
            if (tries > 40) window.clearInterval(timer);
            return;
          }

          var doc = iframe.contentDocument || (iframe.contentWindow && iframe.contentWindow.document);
          if (!doc || !doc.head) {
            if (tries > 40) window.clearInterval(timer);
            return;
          }

          if (doc.getElementById('lame-tawk-theme')) {
            window.clearInterval(timer);
            return;
          }

          var font = doc.createElement('link');
          font.rel = 'stylesheet';
          font.href =
            'https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap';

          var style = doc.createElement('style');
          style.id = 'lame-tawk-theme';
          style.textContent =
            'body,button,input,textarea{font-family:Jost,system-ui,sans-serif!important;}' +
            'h1,h2,h3,.tawk-header-title{font-family:"Cormorant Garamond",Georgia,serif!important;letter-spacing:-0.02em;}' +
            '.tawk-button,.tawk-button-circle,.tawk-min-container button{' +
            'box-shadow:0 10px 28px rgb(21 66 48 / 0.22)!important;border-radius:999px!important;}' +
            '.tawk-button{background:linear-gradient(145deg,#1f5a40,#154230)!important;}' +
            '.tawk-chat-panel,.tawk-card{border-radius:18px!important;}' +
            '.tawk-chat-panel{border:1px solid rgb(193 151 31 / 0.28)!important;}' +
            'button.tawk-button-primary,.tawk-button-primary{background:#154230!important;border-color:#154230!important;}' +
            'a{color:#154230!important;}';

          doc.head.appendChild(font);
          doc.head.appendChild(style);
          window.clearInterval(timer);
        }, 250);
      } catch (e) {}
    };

    window.Tawk_API.onChatMaximized = function () {
      hideLauncher();
    };

    window.Tawk_API.onChatMinimized = function () {
      showLauncher();
    };

    window.Tawk_API.onChatHidden = function () {
      showLauncher();
    };
  })();
</script>
