{% comment %}
  MyLamstone Tawk.to polish — position only.
  Appearance colors / greeting live in Tawk Admin. No custom overlay button.
{% endcomment %}

{{ 'lame-tawk-chat.css' | asset_url | stylesheet_tag }}

<script>
  window.Tawk_API = window.Tawk_API || {};
  window.Tawk_LoadStart = window.Tawk_LoadStart || new Date();

  /* Lift default Tawk bubble above the bottom edge */
  window.Tawk_API.customStyle = {
    zIndex: 2147483000,
    visibility: {
      desktop: {
        position: 'br',
        xOffset: 18,
        yOffset: {% if template.name == 'product' %}100{% else %}88{% endif %}
      },
      mobile: {
        position: 'br',
        xOffset: 12,
        yOffset: {% if template.name == 'product' %}128{% else %}96{% endif %}
      },
      bubble: {
        rotate: '0deg',
        xOffset: -12,
        yOffset: 0
      }
    }
  };

  window.Tawk_API.onLoad = function () {
    document.body.classList.add('lame-tawk-api-positioned');

    try {
      if (typeof window.Tawk_API.setAttributes === 'function') {
        window.Tawk_API.setAttributes(
          {
            store: {{ shop.name | json }},
            page: {{ request.path | json }}
          },
          function () {}
        );
      }
    } catch (e) {}
  };
</script>
