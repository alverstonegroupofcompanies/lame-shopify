{%- comment -%}
  Our Products right column — 3 images (scrolls with page).
  @param blocks - section blocks (type: image)
  @param column_width - number (px)
  @param image_gap - number (px)
  @param top_spacing - number (px)
  @param aria_label - string
{%- endcomment -%}

{%- if blocks != blank and blocks.size > 0 -%}
<div
  class="lame-op-side-images"
  style="--lame-op-side-width: {{ column_width | default: 180 }}px; --lame-op-side-top: {{ top_spacing | default: 0 }}px; --lame-op-side-gap: {{ image_gap | default: 16 }}px;"
>
  <aside class="lame-op-side-images__aside" aria-label="{{ aria_label | default: 'Promotional images' | escape }}">
    <div class="lame-op-side-images__column">
      {%- for block in blocks -%}
        <div class="lame-op-side-images__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="lame-op-side-images__link">
          {%- endif -%}

          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 600
              | image_tag:
                class: 'lame-op-side-images__img',
                loading: 'lazy',
                widths: '180, 240, 300, 360, 480, 600',
                sizes: '(min-width: 1200px) var(--lame-op-side-width, 180px), 0px',
                alt: block.settings.image_alt | escape
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'lame-op-side-images__placeholder' }}
          {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </aside>
</div>
{%- endif -%}
