{%- doc -%}
  Estimated delivery date (today + N days). Auto-updates via JS.

  @param {string} [variant] - 'line' (cart item) | 'inline' (summary) | 'trust' (PDP trust row)
  @param {number} [days] - Offset in days from today (default 7)
{%- enddoc -%}

{%- liquid
  assign eta_days = days | default: 7
  assign start_ts = 'now' | date: '%s'
  assign day_seconds = eta_days | times: 86400
  assign end_ts = start_ts | plus: day_seconds
  assign end_label = end_ts | date: '%d %b'
  assign eta_variant = variant | default: 'line'

  assign current_product = closest.product | default: product
  assign current_variant = current_product.selected_or_first_available_variant
  assign is_non_physical = false
  if current_product != blank
    if current_variant != blank and current_variant.requires_shipping == false
      assign is_non_physical = true
    elsif current_product.requires_shipping == false
      assign is_non_physical = true
    endif
    assign p_h = current_product.handle | downcase
    if p_h == 'elite-pro-6-months' or p_h contains 'elite-pro' or p_h contains 'platform-fee'
      assign is_non_physical = true
    endif
    for tag in current_product.tags
      assign tag_down = tag | downcase
      if tag_down == 'membership' or tag_down == 'digital' or tag_down contains 'non-physical'
        assign is_non_physical = true
        break
      endif
    endfor
  endif
  if request.path contains 'elite-pro-6-months'
    assign is_non_physical = true
  endif
-%}

{%- if is_non_physical and eta_variant == 'trust' -%}
  <script>
    (function(){
      var el = document.currentScript;
      if (el) {
        var item = el.closest('.lame-pdp-trust-row__item');
        if (item) item.style.display = 'none';
        var row = el.closest('.lame-pdp-trust-row');
        if (row) {
          row.style.setProperty('display', 'flex', 'important');
          row.style.setProperty('align-items', 'center', 'important');
          row.style.setProperty('justify-content', 'flex-start', 'important');
          row.style.setProperty('gap', '0', 'important');
          var lastItem = row.querySelector('.lame-pdp-trust-row__item:last-child');
          if (lastItem && lastItem !== item) lastItem.style.display = 'none';
        }
      }
    })();
  </script>
{%- elsif eta_variant == 'trust' -%}
  <span
    class="lame-delivery-eta lame-delivery-eta--trust"
    data-lame-delivery-eta
    data-days="{{ eta_days }}"
    data-mode="date"
  >
    <strong>
      {{ 'lame_cart.delivery_eta_by' | t }}
      <span data-lame-delivery-eta-date>{{ end_label }}</span>
    </strong>
  </span>
{%- elsif eta_variant == 'inline' -%}
  <span
    class="lame-delivery-eta lame-delivery-eta--inline"
    data-lame-delivery-eta
    data-days="{{ eta_days }}"
    data-mode="date"
  >
    {{ 'lame_cart.delivery_eta_by' | t }}
    <span data-lame-delivery-eta-date>{{ end_label }}</span>
  </span>
{%- else -%}
  <p
    class="lame-delivery-eta"
    data-lame-delivery-eta
    data-days="{{ eta_days }}"
    data-mode="date"
  >
    <span class="lame-delivery-eta__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" width="14" height="14" focusable="false">
        <path d="M3 7h11v8H3V7Z" stroke="currentColor" stroke-width="1.35"/>
        <path d="M14 10h4l3 3v2h-7v-5Z" stroke="currentColor" stroke-width="1.35"/>
        <circle cx="7" cy="17" r="1.75" stroke="currentColor" stroke-width="1.35"/>
        <circle cx="17" cy="17" r="1.75" stroke="currentColor" stroke-width="1.35"/>
      </svg>
    </span>
    <span class="lame-delivery-eta__text">
      {{ 'lame_cart.delivery_eta_by' | t }}
      <span data-lame-delivery-eta-date>{{ end_label }}</span>
    </span>
  </p>
{%- endif -%}
