{%- doc -%}
  Wishlist panel on the customer account page (opens global wishlist drawer when enabled).
{%- enddoc -%}

<section id="wishlist" class="lame-acct-card lame-profile__panel" aria-labelledby="ProfileWishlistHeading">
  <div class="lame-acct-card__head">
    <h2 id="ProfileWishlistHeading" class="lame-acct-card__title">{{ 'lame_wishlist.title' | t }}</h2>
    {% if settings.lame_enable_wishlist %}
      <button type="button" class="lame-acct-text-btn" data-lame-wishlist-open>
        {{ 'lame_customer.open_wishlist' | t }}
      </button>
    {% endif %}
  </div>

  <div class="lame-profile__card-body lame-profile__wishlist-preview" data-account-wishlist-preview>
    <div class="lame-profile__empty-state lame-profile__empty-state--compact" data-account-wishlist-empty>
      <span class="lame-profile__empty-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 20 20" fill="none">
          <path
            d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
            fill-rule="evenodd"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <p class="lame-profile__empty-title" data-account-wishlist-empty-title>{{ 'lame_wishlist.empty' | t }}</p>
      <p class="lame-profile__empty-desc">{{ 'lame_wishlist.device_only_hint' | t }}</p>
      {% if settings.lame_enable_wishlist %}
        <button type="button" class="button lame-profile__btn-primary" data-lame-wishlist-open>
          {{ 'lame_wishlist.open_drawer' | t }}
        </button>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="button lame-profile__btn-primary">
          {{ 'lame_customer.shop_now' | t }}
        </a>
      {% endif %}
    </div>

    <div class="lame-profile__wishlist-filled" data-account-wishlist-filled hidden>
      <ul class="lame-profile__wishlist-list" data-account-wishlist-list role="list"></ul>
      {% if settings.lame_enable_wishlist %}
        <button type="button" class="button lame-profile__btn-primary" data-lame-wishlist-open>
          {{ 'lame_customer.open_wishlist' | t }}
        </button>
      {% endif %}
    </div>
  </div>
</section>
