{%- doc -%}
  Wishlist panel on the customer account page (opens global wishlist drawer when enabled).
{%- enddoc -%}

<section id="wishlist" class="lame-profile__panel lame-profile__card" aria-labelledby="ProfileWishlistHeading">
  <div class="lame-profile__card-header">
    <h2 id="ProfileWishlistHeading" class="lame-profile__card-title">{{ 'lame_wishlist.title' | t }}</h2>
    {% if settings.lame_enable_wishlist %}
      <button type="button" class="lame-profile__link-btn" data-lame-wishlist-open>
        {{ 'lame_customer.open_wishlist' | t }}
      </button>
    {% endif %}
  </div>

  <div class="lame-profile__wishlist-preview" data-account-wishlist-preview>
    <div class="lame-profile__empty-state lame-profile__empty-state--compact">
      <span class="lame-profile__empty-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><path d="M12 20.5s-6.5-4-8.8-7.6C1.4 10.2 2.2 7 5.2 7c1.8 0 3 1.1 3.6 2.1.6-1 1.8-2.1 3.6-2.1 3 0 3.8 3.2 1.4 5.9C15.2 16.5 12 20.5 12 20.5Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></svg>
      </span>
      <p class="lame-profile__empty-title" data-account-wishlist-empty-title>{{ 'lame_wishlist.empty' | t }}</p>
      <p class="lame-profile__empty-desc">{{ 'lame_wishlist.device_only_hint' | t }}</p>
      {% if settings.lame_enable_wishlist %}
        <button type="button" class="button lame-profile__btn-primary" data-lame-wishlist-open>
          {{ 'lame_wishlist.open_drawer' | t }}
        </button>
      {% else %}
        <a href="{{ routes.all_products_collection_url }}" class="button lame-profile__btn-primary">
          {{ 'lame_customer.shop_now' | t }}
        </a>
      {% endif %}
    </div>
  </div>
</section>
