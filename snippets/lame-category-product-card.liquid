{%- doc -%}
  Compact cosmetic grid card for category collection pages.

  @param {object} product
  @param {object} section - Parent section (product form)
  @param {string} collection_handle - Collection handle for accent modifier
  @param {boolean} [show_wishlist] - Show wishlist toggle on image
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant | default: product.variants.first
  assign can_quick_add = false
  if product.has_only_default_variant and variant.available
    assign can_quick_add = true
  endif
  assign show_wishlist = show_wishlist | default: true

  assign price_amount = variant.price
  assign compare_at = variant.compare_at_price | default: 0

  if product != blank
    capture lame_sale_raw
      render 'lame-product-sale-data', product: product
    endcapture
    assign lame_sale_parts = lame_sale_raw | split: '|'
    assign lame_effective_compare = lame_sale_parts[1] | strip | plus: 0
    assign lame_on_sale_flag = lame_sale_parts[2] | strip | plus: 0
    assign lame_sale_price = lame_sale_parts[4] | strip | plus: 0
    if compare_at == 0 and lame_on_sale_flag == 1 and lame_effective_compare > 0
      assign compare_at = lame_effective_compare
    endif
    if lame_on_sale_flag == 1 and lame_sale_price > 0 and lame_sale_price < compare_at
      assign price_amount = lame_sale_price
    endif
  endif

  assign has_discount = false
  assign discount_percent = 0
  if compare_at > price_amount and compare_at > 0
    assign discount_percent = compare_at | minus: price_amount | times: 100.0 | divided_by: compare_at | round
    if discount_percent > 0
      assign has_discount = true
    endif
  endif

  assign card_label = product.vendor | strip
  if card_label == blank and product.metafields.custom.brand.value != blank
    assign card_label = product.metafields.custom.brand.value | strip
  endif
  if card_label == blank
    assign card_label = product.type
  endif

  assign is_bogo = false
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'buy 1 get 1 free' or tag_down == 'buy1get1free' or tag_down == 'bogo' or tag_down contains 'buy 1 get 1'
      assign is_bogo = true
      break
    endif
  endfor
-%}

<article class="lame-cat-card lame-cat-card--{{ collection_handle }}">
  <div class="lame-cat-card__media">
    <a href="{{ product.url }}" class="lame-cat-card__media-link" aria-label="{{ product.title | escape }}">
      {% if product.featured_media %}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            class: 'lame-cat-card__image',
            loading: 'lazy',
            widths: '200,300,400,500,600',
            sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 46vw',
            alt: product.featured_media.alt | default: product.title
        }}
      {% else %}
        <div class="lame-cat-card__image lame-cat-card__image--placeholder" aria-hidden="true"></div>
      {% endif %}
    </a>

    <div class="lame-cat-card__badges">
      {% unless variant.available %}
        <span class="lame-cat-card__badge lame-cat-card__badge--soldout">Sold out</span>
      {% endunless %}
      {% if is_bogo %}
        <span class="lame-cat-card__badge lame-cat-card__badge--promo">Buy 1 Get 1 Free</span>
      {% endif %}
      {% if has_discount %}
        <span class="lame-cat-card__badge lame-cat-card__badge--discount lame-discount-badge">
          {{ discount_percent }}% OFF
        </span>
      {% endif %}
    </div>

    {% if show_wishlist %}
      <div class="lame-cat-card__wish">
        {% render 'lame-category-wishlist-btn', product: product %}
      </div>
    {% endif %}
  </div>

  <div class="lame-cat-card__body">
    {% if card_label != blank %}
      <p class="lame-cat-card__label">{{ card_label | escape }}</p>
    {% else %}
      <p class="lame-cat-card__label lame-cat-card__label--empty" aria-hidden="true">&#8203;</p>
    {% endif %}

    <h3 class="lame-cat-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="lame-cat-card__price">
      {% render 'price', product_resource: product, show_sale_price_first: true %}
    </div>

    <div class="lame-cat-card__actions">
      <div class="lame-cat-card__action-row">
        {%- liquid
          assign is_elite_pro = false
          if product != blank
            assign p_handle_down = product.handle | downcase
            assign p_title_down = product.title | downcase
            if p_handle_down == 'elite-pro-6-months' or p_title_down contains 'elite pro'
              assign is_elite_pro = true
            endif
          endif
        -%}
        {% if is_elite_pro %}
          <a href="{{ product.url }}" class="lame-cat-card__btn" style="text-decoration: none;">
            <span class="lame-cat-card__btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
            </span>
            <span class="lame-cat-card__btn-label">{{ 'lame_category_shop.view_product' | t | default: 'View product' }}</span>
          </a>
        {% elsif variant.available %}
          {%- assign cat_form_id = 'CategoryCard-Form-' | append: product.id -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            on:submit="/handleSubmit"
          >
            <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
            {%- form 'product', product, id: cat_form_id, class: 'lame-cat-card__form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" ref="variantId">
              {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
              <input type="hidden" name="quantity" value="{{ lame_bogo_qty | strip }}">
              <button
                type="submit"
                name="add"
                ref="addToCartButton"
                class="lame-cat-card__btn"
                aria-label="{{ 'actions.add_to_cart' | t | default: 'Add to cart' | escape }}"
              >
                <span class="lame-cat-card__btn-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </span>
                <span class="lame-cat-card__btn-label">{{ 'actions.add_to_cart' | t | default: 'Add to cart' }}</span>
              </button>
            {%- endform -%}
          </product-form-component>
        {% else %}
          <button type="button" class="lame-cat-card__btn lame-cat-card__btn--outline" disabled>
            <span class="lame-cat-card__btn-label">{{ 'products.product.sold_out' | t | default: 'Sold out' }}</span>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</article>
