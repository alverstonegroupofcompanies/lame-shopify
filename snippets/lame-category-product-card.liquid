{%- doc -%}
  Compact cosmetic grid card for category collection pages.

  @param {object} product
  @param {object} section - Parent section (product form)
  @param {string} collection_handle - Collection handle for accent modifier
  @param {boolean} [show_wishlist] - Show wishlist toggle on image
{%- enddoc -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign can_quick_add = false
  if product.has_only_default_variant and variant.available
    assign can_quick_add = true
  endif
  assign show_wishlist = show_wishlist | default: true

  assign lame_discount_percent = 0
  assign compare_at = variant.compare_at_price
  assign price_amount = variant.price
  if compare_at > price_amount
    assign lame_discount_percent = compare_at | minus: price_amount | times: 100.0 | divided_by: compare_at | round
  endif

  assign card_label = product.vendor | strip
  if card_label == blank and product.metafields.custom.brand.value != blank
    assign card_label = product.metafields.custom.brand.value | strip
  endif
  if card_label == blank
    assign card_label = product.type
  endif

  assign is_bogo = false
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'buy 1 get 1 free' or tag_down == 'buy1get1free' or tag_down == 'bogo' or tag_down contains 'buy 1 get 1'
      assign is_bogo = true
      break
    endif
  endfor
-%}

<article class="lame-cat-card lame-cat-card--{{ collection_handle }}">
  <div class="lame-cat-card__media">
    <a href="{{ product.url }}" class="lame-cat-card__media-link">
      {% if product.featured_media %}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            class: 'lame-cat-card__image',
            loading: 'lazy',
            widths: '200,300,400,500,600',
            sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 30vw, 46vw',
            alt: product.featured_media.alt | default: product.title
        }}
      {% else %}
        <div class="lame-cat-card__image lame-cat-card__image--placeholder" aria-hidden="true"></div>
      {% endif %}
    </a>

    <div class="lame-cat-card__badges">
      {% if is_bogo %}
        <span class="lame-cat-card__badge lame-cat-card__badge--promo">Buy 1 Get 1 Free</span>
      {% endif %}
      {% if lame_discount_percent > 0 %}
        <span class="lame-cat-card__badge">-{{ lame_discount_percent }}%</span>
      {% endif %}
    </div>

  </div>

  <div class="lame-cat-card__body">
    {% if card_label != blank %}
      <p class="lame-cat-card__label">{{ card_label | escape }}</p>
    {% else %}
      <p class="lame-cat-card__label lame-cat-card__label--empty" aria-hidden="true">&#8203;</p>
    {% endif %}

    <h3 class="lame-cat-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="lame-cat-card__price">
      {% render 'price', product_resource: product, show_sale_price_first: true %}
    </div>

    <div class="lame-cat-card__actions">
      <div class="lame-cat-card__action-row">
        {% if can_quick_add %}
          {%- assign cat_form_id = 'CategoryCard-Form-' | append: product.id -%}
          <product-form-component
            data-section-id="{{ section.id }}"
            data-product-id="{{ product.id }}"
            data-product-url="{{ product.url }}"
          >
            {%- form 'product', product, id: cat_form_id, class: 'lame-cat-card__form' -%}
              <input type="hidden" name="id" value="{{ variant.id }}" ref="variantId">
              {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
              <input type="hidden" name="quantity" value="{{ lame_bogo_qty | strip }}">
              <button type="submit" name="add" class="lame-cat-card__btn">
                {{ 'actions.add_to_cart' | t }}
              </button>
            {%- endform -%}
          </product-form-component>
        {% else %}
          <a href="{{ product.url }}" class="lame-cat-card__btn lame-cat-card__btn--outline">
            {{ 'lame_category_shop.view_product' | t }}
          </a>
        {% endif %}

        {% if show_wishlist %}
          {% render 'lame-category-wishlist-btn', product: product %}
        {% endif %}
      </div>
    </div>
  </div>
</article>
