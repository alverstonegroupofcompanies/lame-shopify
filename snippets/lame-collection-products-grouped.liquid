{%- doc -%}
  Collection products grouped by brand (normalized vendor).

  @param {object} collection
  @param {object} section
  @param {object} paginate
{%- enddoc -%}

{% liquid
  assign brand_slugs_pipe = '|'
  assign brand_labels_json = ''

  for product in collection.products
    assign raw_vendor = product.vendor | strip
    assign raw_down = raw_vendor | downcase

    if raw_vendor == blank
      assign brand_slug = 'other'
      assign brand_label = 'Other'
    elsif raw_down contains 'lamstone'
      assign brand_slug = 'lamstone-healthcare'
      assign brand_label = 'Lamstone Healthcare'
    else
      assign brand_slug = raw_vendor | handleize
      assign brand_label = raw_vendor
    endif

    assign slug_token = '|' | append: brand_slug | append: '|'
    unless brand_slugs_pipe contains slug_token
      assign brand_slugs_pipe = brand_slugs_pipe | append: brand_slug | append: '|'
      assign brand_labels_json = brand_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
    endunless
  endfor

  assign brand_slugs = brand_slugs_pipe | split: '|'
%}

{% for brand_slug in brand_slugs %}
  {% if brand_slug == blank %}
    {% continue %}
  {% endif %}

  {% liquid
    assign brand_label = brand_slug
    assign label_chunks = brand_labels_json | split: '||'
    for chunk in label_chunks
      assign chunk_slug = chunk | split: '::' | first
      if chunk_slug == brand_slug
        assign brand_label = chunk | split: '::' | last
        break
      endif
    endfor

    assign brand_product_count = 0
    for product in collection.products
      assign raw_vendor = product.vendor | strip
      assign raw_down = raw_vendor | downcase
      if raw_vendor == blank
        assign product_slug = 'other'
      elsif raw_down contains 'lamstone'
        assign product_slug = 'lamstone-healthcare'
      else
        assign product_slug = raw_vendor | handleize
      endif
      if product_slug == brand_slug
        assign brand_product_count = brand_product_count | plus: 1
      endif
    endfor
  %}

  {% if brand_product_count > 0 %}
    <section
      class="lame-collection-brand-section"
      id="brand-{{ brand_slug }}"
      aria-labelledby="brand-heading-{{ section.id }}-{{ brand_slug }}"
    >
      <header class="lame-collection-brand-section__header">
        <div class="lame-collection-brand-section__heading">
          <h2
            class="lame-collection-brand-section__title"
            id="brand-heading-{{ section.id }}-{{ brand_slug }}"
          >
            {{ brand_label }}
          </h2>
          <p class="lame-collection-brand-section__count">
            {{ 'lame_collection.brand_product_count' | t: count: brand_product_count }}
          </p>
        </div>
      </header>

      <ul
        class="product-grid product-grid--{{ section.id }} product-grid--{{ section.settings.layout_type }} lame-collection-brand-section__grid{% if section.settings.mobile_product_card_size == 'large' %} product-grid-mobile--large{% endif %}"
        data-testid="product-grid-brand-{{ brand_slug }}"
        role="list"
      >
        {% assign item_index = 0 %}
        {% for product in collection.products %}
          {% liquid
            assign raw_vendor = product.vendor | strip
            assign raw_down = raw_vendor | downcase
            if raw_vendor == blank
              assign product_slug = 'other'
            elsif raw_down contains 'lamstone'
              assign product_slug = 'lamstone-healthcare'
            else
              assign product_slug = raw_vendor | handleize
            endif
          %}
          {% if product_slug == brand_slug %}
            <li
              id="{{ section.id }}-{{ product.id }}"
              class="product-grid__item product-grid__item--premium product-grid__item--{{ item_index }}"
              data-page="{{ paginate.current_page }}"
              data-product-id="{{ product.id }}"
              data-brand="{{ brand_label | escape }}"
              ref="cards[]"
            >
              {% render 'lame-shop-product-card', product: product, section: section %}
            </li>
            {% assign item_index = item_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  {% endif %}
{% endfor %}
