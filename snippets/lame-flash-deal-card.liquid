{%- doc -%}
  Product card — shared by homepage Best Selling / New Arrivals and Our Products shop.

  @param {object} product
  @param {string} [badge_label] - Fallback discount badge text
  @param {string} add_to_cart_label
  @param {string} [sold_out_label]
  @param {string} [review_count_fallback]
  @param {string} [save_label_prefix]
  @param {boolean} [show_wishlist] - Our Products only; keeps homepage ATC unchanged
{%- enddoc -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign compare_at = selected_variant.compare_at_price
  assign price = selected_variant.price
  assign on_sale = false
  assign card_badge = ''
  assign savings_amount = 0
  assign show_wishlist = show_wishlist | default: false

  capture lame_sale_raw
    render 'lame-product-sale-data', product: product
  endcapture
  assign lame_sale_parts = lame_sale_raw | split: '|'
  assign discount_percent = lame_sale_parts[0] | strip | plus: 0
  assign lame_effective_compare = lame_sale_parts[1] | strip | plus: 0
  assign lame_on_sale_flag = lame_sale_parts[2] | strip | plus: 0
  assign lame_sale_badge_label = lame_sale_parts[3] | strip
  assign lame_sale_price = lame_sale_parts[4] | strip | plus: 0

  if compare_at > price
    assign on_sale = true
    if discount_percent == 0
      assign discount_percent = compare_at | minus: price | times: 100 | divided_by: compare_at
    endif
    if lame_sale_badge_label != blank
      assign card_badge = lame_sale_badge_label
    else
      assign card_badge = discount_percent | append: '% OFF'
    endif
    assign savings_amount = compare_at | minus: price
  elsif lame_on_sale_flag == 1
    assign on_sale = true
    if lame_sale_badge_label != blank
      assign card_badge = lame_sale_badge_label
    elsif discount_percent > 0
      assign card_badge = discount_percent | append: '% OFF'
    endif
    if lame_effective_compare > 0
      assign compare_at = lame_effective_compare
    endif
    if lame_sale_price > 0 and lame_sale_price < compare_at
      assign price = lame_sale_price
    endif
    assign savings_amount = compare_at | minus: price
  elsif badge_label != blank
    assign card_badge = badge_label
  endif

  if settings.currency_code_enabled
    assign display_price = price | money_with_currency
    assign display_compare = compare_at | money_with_currency
    assign display_savings = savings_amount | money_with_currency
  else
    assign display_price = price | money
    assign display_compare = compare_at | money
    assign display_savings = savings_amount | money
  endif

  assign sold_out_label = sold_out_label | default: 'Sold out'
  assign save_label_prefix = save_label_prefix | default: 'You Save'

  assign render_wishlist = false
  if show_wishlist and settings.lame_enable_wishlist
    assign render_wishlist = true
  endif
-%}

<article class="lame-flash-card{% if render_wishlist %} lame-flash-card--with-wishlist{% endif %}">
  <div class="lame-flash-card__media">
    {%- if card_badge != blank -%}
      <span class="lame-flash-card__badge">{{ card_badge | escape }}</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="lame-flash-card__media-link" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            class: 'lame-flash-card__image',
            loading: 'lazy',
            widths: '200,300,400,500,600',
            sizes: '(min-width: 990px) 20vw, (min-width: 750px) 24vw, calc((100vw - 3rem) / 2)',
            alt: product.title
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-flash-card__image placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  <div class="lame-flash-card__body">
    <h3 class="lame-flash-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="lame-flash-card__price-row">
      <span class="lame-flash-card__price">{{ display_price }}</span>
      {%- if on_sale -%}
        <span class="lame-flash-card__compare">{{ display_compare }}</span>
        {%- if discount_percent > 0 -%}
          <span class="lame-flash-card__discount">{{ discount_percent }}% off</span>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- if selected_variant -%}
      <div class="lame-flash-card__actions">
        <form method="post" action="{{ routes.cart_add_url }}" class="lame-flash-card__form" data-lame-home-atc>
          <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
          <input type="hidden" name="quantity" value="{{ lame_bogo_qty | strip }}">
          <button
            type="submit"
            class="lame-flash-card__atc"
            aria-label="{% if product.available %}{{ add_to_cart_label | default: 'Add to cart' }}{% else %}{{ sold_out_label }}{% endif %}"
            {% unless product.available %}disabled{% endunless %}
          >
            {%- if product.available -%}
              <span class="lame-flash-card__atc-label">{{ add_to_cart_label | default: 'Add to cart' }}</span>
            {%- else -%}
              {{ sold_out_label }}
            {%- endif -%}
          </button>
        </form>
        {%- if render_wishlist -%}
          {% render 'lame-our-products-wishlist-btn', product: product %}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
