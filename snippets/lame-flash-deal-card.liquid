{%- doc -%}
  Flash sale product card — sale layout with savings badge and add to cart.

  @param {object} product
  @param {string} [badge_label] - Fallback discount badge text
  @param {string} add_to_cart_label
  @param {string} [sold_out_label]
  @param {string} [review_count_fallback]
  @param {string} [save_label_prefix]
{%- enddoc -%}

{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign compare_at = selected_variant.compare_at_price
  assign price = selected_variant.price
  assign on_sale = false
  assign card_badge = ''
  assign savings_amount = 0

  if compare_at > price
    assign on_sale = true
    assign discount_percent = compare_at | minus: price | times: 100 | divided_by: compare_at
    assign card_badge = discount_percent | append: '% OFF'
    assign savings_amount = compare_at | minus: price
  elsif badge_label != blank
    assign card_badge = badge_label
  endif

  assign review_count = product.metafields.reviews.rating_count.value | default: product.metafields.custom.review_count.value
  if review_count == blank and review_count_fallback != blank
    assign review_count = review_count_fallback
  endif

  if settings.currency_code_enabled
    assign display_price = price | money_with_currency
    assign display_compare = compare_at | money_with_currency
    assign display_savings = savings_amount | money_with_currency
  else
    assign display_price = price | money
    assign display_compare = compare_at | money
    assign display_savings = savings_amount | money
  endif

  assign sold_out_label = sold_out_label | default: 'Sold out'
  assign save_label_prefix = save_label_prefix | default: 'You Save'
-%}

<article class="lame-flash-card">
  <div class="lame-flash-card__media">
    {%- if card_badge != blank -%}
      <span class="lame-flash-card__badge">{{ card_badge | escape }}</span>
    {%- endif -%}

    <a href="{{ product.url }}" class="lame-flash-card__media-link" tabindex="-1" aria-hidden="true">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag:
            class: 'lame-flash-card__image',
            loading: 'lazy',
            widths: '200,300,400,500,600',
            sizes: '(min-width: 1200px) 280px, (min-width: 750px) 24vw, 78vw',
            alt: product.title
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'lame-flash-card__image placeholder-svg' }}
      {%- endif -%}
    </a>
  </div>

  <div class="lame-flash-card__body">
    <h3 class="lame-flash-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    <div class="lame-flash-card__price-row">
      {%- if on_sale -%}
        <span class="lame-flash-card__compare">{{ display_compare }}</span>
      {%- endif -%}
      <span class="lame-flash-card__price">{{ display_price }}</span>
    </div>

    {%- if on_sale and savings_amount > 0 -%}
      <span class="lame-flash-card__save">
        <svg class="lame-flash-card__save-icon" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20 12v8H4V12" stroke="currentColor" stroke-width="1.5" fill="none"/>
          <path d="M12 3 20 7v5H4V7l8-4Z" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linejoin="round"/>
        </svg>
        {{ save_label_prefix }} {{ display_savings }}
      </span>
    {%- endif -%}

    <div class="lame-flash-card__rating" aria-hidden="true">
      <span class="lame-flash-card__stars">
        {%- for i in (1..5) -%}&#9733;{%- endfor -%}
      </span>
      {%- if review_count != blank -%}
        <span class="lame-flash-card__reviews">({{ review_count }})</span>
      {%- endif -%}
    </div>

    {%- if selected_variant -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="lame-flash-card__form" data-lame-home-atc>
        <input type="hidden" name="id" value="{{ selected_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="lame-flash-card__atc" {% unless product.available %}disabled{% endunless %}>
          <svg class="lame-flash-card__atc-icon" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M6 6h14l-1.2 8H7.4L6 6Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <path d="M9 6V5a3 3 0 0 1 6 0v1" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
          {%- if product.available -%}
            {{ add_to_cart_label | default: 'Add to cart' }}
          {%- else -%}
            {{ sold_out_label }}
          {%- endif -%}
        </button>
      </form>
    {%- endif -%}
  </div>
</article>
