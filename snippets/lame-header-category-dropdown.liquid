{%- doc -%}
  Shop by category mega menu for the header / nav search bar.
  @param {object} menu - Main navigation linklist
  @param {object} section - Header section
  @param {string} [label] - Button label (defaults to translation)
{%- enddoc -%}

{%- liquid
  assign category_label = label
  if category_label == blank
    assign category_label = 'lame_search.shop_by_category' | t
  endif
-%}

{%- liquid
  comment
    icon_key|label|collection handle (blank uses icon_key)|fallback url
  endcomment
  assign category_rows = 'all|Products|all|/collections/all,skin-care|Skin Care|skin-care|/collections/skin-care,make-up|Make-up|make-up|/collections/make-up,hair-care|Hair care|frontpage|/collections/frontpage,bath-body|Bath & Body|bath-body|/collections/bath-body,fragrance|Fragrance|fragrance|/collections/fragrance,baby-mom|Mom & baby|baby-mom|/collections/baby-mom,wellness|Wellness|wellness|/collections/wellness,feminine|Feminine Hygiene||/search?q=feminine&type=product,combos|Combos||/search?q=combo&type=product,top-deals|Top Deals||/collections/all?sort_by=best-selling,shop-more|Shop More|our-products|/collections/our-products' | split: ','
-%}

<div class="lame-header-shop-category" data-lame-category-dropdown>
  <button
    type="button"
    class="lame-header-shop-category-btn"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="LameHeaderCategoryPanel"
    data-lame-category-trigger
  >
    <span class="lame-header-shop-category-btn__text">{{ category_label }}</span>
    <span class="lame-header-shop-category-btn__caret" aria-hidden="true">▾</span>
  </button>

  <div
    id="LameHeaderCategoryPanel"
    class="lame-header-shop-category-panel lame-header-shop-category-panel--mega"
    role="region"
    aria-label="{{ 'lame_search.shop_by_category' | t }}"
    hidden
    data-lame-category-panel
  >
    <ul class="lame-header-shop-category-panel__list list-unstyled" role="list">
      {%- for row in category_rows -%}
        {%- liquid
          assign parts = row | split: '|'
          assign icon_key = parts[0]
          assign item_label = parts[1]
          assign collection_handle = parts[2]
          assign fallback_url = parts[3]
          if collection_handle == blank
            assign collection_handle = icon_key
          endif
          assign category_collection = collections[collection_handle]
          assign item_url = fallback_url
          if category_collection != blank
            assign item_url = category_collection.url
          endif
        -%}
        <li class="lame-header-shop-category-panel__item">
          <a href="{{ item_url }}" class="lame-header-shop-category-panel__link">
            <span class="lame-header-shop-category-panel__icon" aria-hidden="true">
              {% render 'lame-op-category-icon', handle: icon_key %}
            </span>
            <span class="lame-header-shop-category-panel__label">{{ item_label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<script src="{{ 'lame-header-category-dropdown.js' | asset_url }}" type="module" fetchpriority="low"></script>
