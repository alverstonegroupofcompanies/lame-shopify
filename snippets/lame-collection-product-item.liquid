{%- doc -%}
  Single product grid item for collection pages (optional; main-collection inlines this markup).

  @param {object} product
  @param {object} section
  @param {number} paginate_current_page
  @param {number} item_index
{%- enddoc -%}

<li
  id="{{ section.id }}-{{ product.id }}"
  class="product-grid__item product-grid__item--premium product-grid__item--{{ item_index }}"
  data-page="{{ paginate_current_page }}"
  data-product-id="{{ product.id }}"
  data-brand="{{ product.vendor | escape }}"
  ref="cards[]"
>
  {% render 'lame-category-product-card',
    product: product,
    section: section,
    collection_handle: collection.handle,
    show_wishlist: section.settings.show_wishlist
  %}
</li>
