{%- doc -%}
  Our Products — centered catalog page title. Filters live in the left sidebar.

  @param {object} collection - Collection
  @param {string} [heading] - Override heading
  @param {string} [subtitle] - Optional subtitle
{%- enddoc -%}

{%- liquid
  assign page_heading = heading
  if page_heading == blank and collection != blank
    assign page_heading = collection.title
  endif
  if page_heading == blank
    assign page_heading = 'Our Products'
  endif
-%}

<header class="lame-op-page__head lame-our-products-page-head lame-op-page__head--catalog">
  <h1 class="lame-op-page__title lame-our-products-page-head__title">{{ page_heading | escape }}</h1>
  {%- if subtitle != blank -%}
    <p class="lame-op-page__subtitle">{{ subtitle | escape }}</p>
  {%- endif -%}
</header>
