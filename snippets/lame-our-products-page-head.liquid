{%- doc -%}
  Our Products catalog page title — “Buy {collection} Online (count)”.

  @param {object} collection - Collection
  @param {string} [heading] - Override heading
  @param {string} [subtitle] - Optional subtitle
{%- enddoc -%}

{%- liquid
  assign page_heading = heading
  if page_heading == blank and collection != blank
    assign page_heading = collection.title
  endif
  if page_heading == blank
    assign page_heading = 'Our Products'
  endif

  assign product_count = 0
  if collection != blank
    assign product_count = collection.products_count
  endif
-%}

<header class="lame-op-page__head lame-our-products-page-head lame-op-page__head--catalog lame-op-page__head--sidebar">
  <p class="lame-op-page__eyebrow">Our Products</p>
  <h1 class="lame-op-page__title lame-our-products-page-head__title">
    <span class="lame-op-page__title-text">Buy {{ page_heading | escape }} Online</span>
    {%- if product_count > 0 -%}
      <span class="lame-op-page__title-count">({{ product_count }})</span>
    {%- endif -%}
  </h1>
  {%- if subtitle != blank -%}
    <p class="lame-op-page__subtitle">{{ subtitle | escape }}</p>
  {%- endif -%}
</header>
