{%- comment -%}
  Icon system for Lamé Radiant Beauty Page:
  Categories, botanical flourishes, and brand emblems.
{%- endcomment -%}
{%- case icon -%}
  {%- when 'leaf-flourish' -%}
    <svg class="lame-radiant-icon lame-radiant-icon--flourish" viewBox="0 0 48 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M24 16C24 16 20 10 13 11C11.5 11.2 9 12 7 13M24 16C24 16 28 10 35 11C36.5 11.2 39 12 41 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M24 6C24 6 21.5 11 24 16C26.5 11 24 6 24 6Z" fill="currentColor"/>
      <path d="M19 10C17 9 14 9.5 12 11.5C13.5 12.5 16 12 18 11L19 10Z" fill="currentColor" opacity="0.85"/>
      <path d="M29 10C31 9 34 9.5 36 11.5C34.5 12.5 32 12 30 11L29 10Z" fill="currentColor" opacity="0.85"/>
    </svg>

  {%- when 'leaf-accent' -%}
    <svg class="lame-radiant-icon lame-radiant-icon--leaf" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M12 3C8 6 6 11 8 16C9.5 19.5 12 21 12 21C12 21 14.5 19.5 16 16C18 11 16 6 12 3Z" fill="currentColor"/>
      <path d="M12 7V18" stroke="#ffffff" stroke-width="1" stroke-linecap="round" opacity="0.4"/>
    </svg>

  {%- when 'branch-divider' -%}
    <svg class="lame-radiant-icon lame-radiant-icon--branch" viewBox="0 0 120 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <line x1="0" y1="10" x2="42" y2="10" stroke="currentColor" stroke-width="1" opacity="0.45"/>
      <line x1="78" y1="10" x2="120" y2="10" stroke="currentColor" stroke-width="1" opacity="0.45"/>
      <path d="M60 4C57 7.5 57 12.5 60 16C63 12.5 63 7.5 60 4Z" fill="currentColor"/>
      <path d="M52 8C49 8.5 47 10.5 48 12.5C50 12 52.5 10.5 53 9L52 8Z" fill="currentColor" opacity="0.85"/>
      <path d="M68 8C71 8.5 73 10.5 72 12.5C70 12 67.5 10.5 67 9L68 8Z" fill="currentColor" opacity="0.85"/>
    </svg>

  {%- when 'all-products', 'leaf' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M16 5C10.5 9 8 16 11 22C13 26 16 27 16 27C16 27 19 26 21 22C24 16 21.5 9 16 5Z" fill="currentColor"/>
      <path d="M16 10V24M16 14C18 13 19.5 11.5 20 10M16 17C14 16 12.5 14.5 12 13M16 20C17.5 19.5 19 18.5 19.5 17" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round" opacity="0.6"/>
    </svg>

  {%- when 'skincare', 'skin-care' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Cream Jar -->
      <rect x="9" y="8" width="14" height="4" rx="2" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <path d="M8 14C8 13.4 8.4 13 9 13H23C23.6 13 24 13.4 24 14V21C24 23.2 22.2 25 20 25H12C9.8 25 8 23.2 8 21V14Z" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <path d="M10 18H22" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.45"/>
      <circle cx="16" cy="18" r="1.5" fill="currentColor" opacity="0.7"/>
    </svg>

  {%- when 'makeup', 'make-up' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Lipstick -->
      <rect x="12" y="16" width="8" height="10" rx="1.5" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <rect x="13.5" y="12" width="5" height="4" stroke="currentColor" stroke-width="1.3" fill="none"/>
      <path d="M13.5 12V8.5C13.5 8.5 14.5 6 16 6C17.5 6 18.5 8.5 18.5 12" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.25"/>
      <line x1="12" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="1.2" opacity="0.45"/>
    </svg>

  {%- when 'haircare', 'hair-care' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Face profile & flowing hair -->
      <path d="M19.5 9.5C17.5 7.5 14.5 7 12.5 8.5C10.5 10 9.8 12.5 10.2 15C10.6 17.5 10 20.5 8.5 22.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      <path d="M13.5 12C15 12 16.5 12.8 17 14.2L17.5 15.5H19C19 16.5 18.5 17.2 17.8 17.8C18.2 19 17.5 20.5 16 21C14.8 21.5 13.5 21 13 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M17 9.5C19.5 10 22 12 22.5 14.5C23 17 22.2 20 21 22.5C20 24.5 18 25.5 16 25" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>

  {%- when 'bath-body', 'bath-and-body' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Pump bottle dispenser -->
      <rect x="11" y="14" width="10" height="12" rx="2.5" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <path d="M14 14V11H18V14" stroke="currentColor" stroke-width="1.4"/>
      <path d="M16 11V8H19.5C20.3 8 21 8.7 21 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <path d="M13.5 8H17.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="14" y1="18" x2="18" y2="18" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.45"/>
    </svg>

  {%- when 'fragrance' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Perfume bottle with faceted cut -->
      <path d="M12 14L10 18V24C10 25.1 10.9 26 12 26H20C21.1 26 22 25.1 22 24V18L20 14H12Z" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <rect x="13.5" y="11" width="5" height="3" stroke="currentColor" stroke-width="1.3" fill="none"/>
      <rect x="14.5" y="7" width="3" height="4" rx="1" stroke="currentColor" stroke-width="1.4" fill="currentColor" fill-opacity="0.25"/>
      <path d="M14 18.5H18" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.5"/>
    </svg>

  {%- when 'baby-care', 'baby' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Baby face -->
      <circle cx="16" cy="17" r="7.5" stroke="currentColor" stroke-width="1.6" fill="none"/>
      <!-- Curl on top -->
      <path d="M16 9.5C16 8 17.5 7.5 18 8.5C18.5 9.5 17 10 16 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      <!-- Eyes & smile -->
      <circle cx="13.5" cy="16.5" r="1" fill="currentColor"/>
      <circle cx="18.5" cy="16.5" r="1" fill="currentColor"/>
      <path d="M14.5 19.5C15 20.5 17 20.5 17.5 19.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>

  {%- when 'wellness' -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <!-- Heart with pulse line -->
      <path d="M16 25C16 25 9 19.8 9 14C9 11.2 11.2 9 14 9C15.2 9 16.3 9.4 17.1 10.2L16 11.3L14.9 10.2C15.7 9.4 16.8 9 18 9C20.8 9 23 11.2 23 14C23 19.8 16 25 16 25Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/>
      <!-- Pulse line -->
      <path d="M11 15H13.5L14.5 13L16 17.5L17.5 14L18.5 15H21" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>

  {%- else -%}
    <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.6"/>
      <path d="M16 11V21M11 16H21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
