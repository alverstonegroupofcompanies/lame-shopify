{%- doc -%}
  Premium account icon for header and drawer.

  @param {string} [class] - Additional classes
  @param {number} [size] - Icon size in px (default 20)
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 24
-%}

<svg
  class="lame-account-icon lucide lucide-user{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
  <circle cx="12" cy="7" r="4"/>
</svg>
