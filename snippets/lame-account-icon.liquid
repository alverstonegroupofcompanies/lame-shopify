{%- doc -%}
  Premium account icon for header and drawer.

  @param {string} [class] - Additional classes
  @param {number} [size] - Icon size in px (default 20)
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 20
-%}

<svg
  class="lame-account-icon{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="12" cy="8" r="3.25" stroke="currentColor" stroke-width="1.35"/>
  <path
    d="M5.5 19.25c0-3.45 2.9-5.75 6.5-5.75s6.5 2.3 6.5 5.75"
    stroke="currentColor"
    stroke-width="1.35"
    stroke-linecap="round"
  />
</svg>
