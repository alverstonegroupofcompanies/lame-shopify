{%- doc -%}
  Premium account icon for header and drawer.

  @param {string} [class] - Additional classes
  @param {number} [size] - Icon size in px (default 20)
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 22
-%}

<svg
  class="lame-account-icon{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 20 20"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="10" cy="6.7" r="2.7" stroke="currentColor" stroke-width="1.35"/>
  <path
    d="M4.6 16c0-2.9 2.4-4.8 5.4-4.8s5.4 1.9 5.4 4.8"
    stroke="currentColor"
    stroke-width="1.35"
    stroke-linecap="round"
  />
</svg>
