{%- doc -%}
  Inline SVG icons for the premium footer.
  @param {string} name - icon key
{%- enddoc -%}

{%- assign icon_name = name | default: 'arrow' -%}

<svg class="footer-icon-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
  {%- case icon_name -%}
    {%- when 'phone' -%}
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    {%- when 'email' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="M3 7l9 6 9-6"/>
    {%- when 'location' -%}
      <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/>
      <circle cx="12" cy="10" r="2.5"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5l3 2"/>
    {%- when 'home' -%}
      <path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6"/>
      <path d="M20 20l-3-3"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.5"/>
      <path d="M6 19c0-3.3 2.7-6 6-6s6 2.7 6 6"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="6" height="6" rx="1"/>
      <rect x="14" y="4" width="6" height="6" rx="1"/>
      <rect x="4" y="14" width="6" height="6" rx="1"/>
      <rect x="14" y="14" width="6" height="6" rx="1"/>
    {%- when 'mail' -%}
      <path d="M4 6h16v12H4z"/>
      <path d="m4 7 8 5 8-5"/>
      <path d="M12 12v6"/>
    {%- when 'sparkle' -%}
      <path d="M12 3l1.4 4.2L18 8l-4.2 1.4L12 14l-1.4-4.6L6 8l4.6-.8L12 3z"/>
      <path d="M19 14l.8 2.4L22 17l-2.2.6L19 20l-.8-2.4L16 17l2.2-.6L19 14z"/>
    {%- when 'external' -%}
      <path d="M14 5h5v5"/>
      <path d="M10 14 19 5"/>
      <path d="M19 10v5a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h5"/>
    {%- when 'map-pin' -%}
      <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11z"/>
      <circle cx="12" cy="10" r="2"/>
    {%- when 'send' -%}
      <path d="m22 2-11 11"/>
      <path d="M22 2 15 22l-4-9-9-4 20-7z"/>
    {%- else -%}
      <path d="M5 12h14"/>
      <path d="m13 6 6 6-6 6"/>
  {%- endcase -%}
</svg>
