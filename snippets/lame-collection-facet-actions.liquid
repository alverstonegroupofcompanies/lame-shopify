{%- doc -%}
  Apply / Clear actions for vertical collection filters.

  @param {string} results_url - URL when filters cleared
  @param {boolean} is_active - Any active filters
  @param {string} section_id - Section id for form reference
{%- enddoc -%}

<div class="lame-collection-facet-actions">
  <button
    type="submit"
    class="button lame-collection-facet-actions__apply"
    form="FacetFiltersForm--{{ section_id }}-desktop"
  >
    {{ 'lame_collection.apply_filters' | t }}
  </button>

  <facet-remove-component
    class="lame-collection-facet-actions__clear-wrap"
    data-url="{{ results_url }}"
    active-class="lame-collection-facet-actions__clear--active"
  >
    <button
      type="button"
      class="button button-secondary lame-collection-facet-actions__clear{% if is_active %} lame-collection-facet-actions__clear--active{% endif %}"
      ref="clearButton"
      on:click="/removeFilter?form=FacetFiltersForm--{{ section_id }}-desktop"
      on:keydown="/removeFilter?form=FacetFiltersForm--{{ section_id }}-desktop"
      {% unless is_active %}disabled{% endunless %}
    >
      {{ 'lame_collection.clear_filters' | t }}
    </button>
  </facet-remove-component>
</div>
