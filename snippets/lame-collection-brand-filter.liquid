{%- doc -%}
  Brand dropdown filter for collection pages.
  Uses Shopify vendor facet when enabled; otherwise client-side filtering via JS.

  @param {object} collection - Collection object
  @param {object} [products] - Products on the current page (for fallback list)
  @param {boolean} [grouped_by_brand] - Deprecated; filter URLs always used for selection
{%- enddoc -%}

{% liquid
  assign vendor_filter = blank
  assign active_vendor = blank
  assign active_brand_slug = blank

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      for value in filter.active_values
        assign active_vendor = value.label
        assign raw_down = active_vendor | downcase
        if raw_down contains 'lamstone'
          assign active_brand_slug = 'lamstone-healthcare'
        else
          assign active_brand_slug = active_vendor | handleize
        endif
        break
      endfor
      break
    endif
  endfor

  assign fallback_slugs_pipe = '|'
  assign fallback_labels_json = ''

  if vendor_filter == blank
    for vendor_name in shop.vendors
      assign raw_vendor = vendor_name | strip
      assign raw_down = raw_vendor | downcase

      if raw_vendor != blank
        if raw_down contains 'lamstone'
          assign brand_slug = 'lamstone-healthcare'
          assign brand_label = 'Lamstone Healthcare'
        else
          assign brand_slug = raw_vendor | handleize
          assign brand_label = raw_vendor
        endif

        assign slug_token = '|' | append: brand_slug | append: '|'
        unless fallback_slugs_pipe contains slug_token
          assign fallback_slugs_pipe = fallback_slugs_pipe | append: brand_slug | append: '|'
          assign fallback_labels_json = fallback_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
        endunless
      endif
    endfor
  endif

  if vendor_filter == blank and fallback_slugs_pipe == '|' and products != blank
    for product in products
      assign raw_vendor = product.vendor | strip
      assign raw_down = raw_vendor | downcase

      if raw_vendor != blank
        if raw_down contains 'lamstone'
          assign brand_slug = 'lamstone-healthcare'
          assign brand_label = 'Lamstone Healthcare'
        else
          assign brand_slug = raw_vendor | handleize
          assign brand_label = raw_vendor
        endif

        assign slug_token = '|' | append: brand_slug | append: '|'
        unless fallback_slugs_pipe contains slug_token
          assign fallback_slugs_pipe = fallback_slugs_pipe | append: brand_slug | append: '|'
          assign fallback_labels_json = fallback_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
        endunless
      endif
    endfor
  endif

  assign use_client_filter = false
  if vendor_filter == blank and fallback_slugs_pipe != '|'
    assign use_client_filter = true
  endif
%}

{% if vendor_filter != blank or fallback_slugs_pipe != '|' %}
  <div class="lame-collection-brand-nav" aria-label="{{ 'lame_collection.shop_by_brand' | t }}">
    <label class="lame-collection-brand-nav__label" for="lame-brand-filter-{{ collection.id }}">
      {{ 'lame_collection.shop_by_brand' | t }}
    </label>
    <div class="lame-collection-brand-nav__control">
      <select
        id="lame-brand-filter-{{ collection.id }}"
        class="lame-collection-brand-nav__select"
        name="brand"
        data-brand-filter
        {% if use_client_filter %}data-client-filter{% endif %}
        data-collection-url="{{ collection.url }}"
      >
        <option
          value=""
          data-brand-slug=""
          data-filter-url="{{ collection.url }}"
          {% if active_vendor == blank %}selected{% endif %}
        >
          {{ 'lame_collection.all_brands' | t }}
        </option>

        {% if vendor_filter != blank %}
          {% for value in vendor_filter.values %}
            {% liquid
              assign value_brand_slug = value.label | handleize
              assign value_brand_down = value.label | downcase
              if value_brand_down contains 'lamstone'
                assign value_brand_slug = 'lamstone-healthcare'
              endif
            %}
            <option
              value="{{ value_brand_slug }}"
              data-brand-slug="{{ value_brand_slug }}"
              data-filter-url="{{ value.url_to_add }}"
              {% if value.active %}selected{% endif %}
              {% if value.count == 0 %}disabled{% endif %}
            >
              {{ value.label }}{% if value.count > 0 %} ({{ value.count }}){% endif %}
            </option>
          {% endfor %}
        {% else %}
          {% assign fallback_slugs = fallback_slugs_pipe | split: '|' %}
          {% for brand_slug in fallback_slugs %}
            {% if brand_slug != blank %}
              {% liquid
                assign brand_label = brand_slug
                assign label_chunks = fallback_labels_json | split: '||'
                for chunk in label_chunks
                  if chunk contains brand_slug
                    assign brand_label = chunk | split: '::' | last
                    break
                  endif
                endfor
              %}
              <option
                value="{{ brand_slug }}"
                data-brand-slug="{{ brand_slug }}"
                data-filter-url="{{ collection.url }}?filter.p.vendor={{ brand_label | url_encode }}"
                {% if active_vendor == brand_label %}selected{% endif %}
              >
                {{ brand_label }}
              </option>
            {% endif %}
          {% endfor %}
        {% endif %}
      </select>
    </div>
  </div>
{% endif %}
