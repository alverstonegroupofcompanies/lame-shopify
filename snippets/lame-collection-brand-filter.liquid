{%- doc -%}
  Brand quick-filter pills for collection pages.
  Uses Shopify vendor facet when enabled; otherwise normalized vendors from the current page.

  @param {object} collection - Collection object
  @param {object} [products] - Products on the current page (for fallback list)
{%- enddoc -%}

{% liquid
  assign vendor_filter = blank
  assign active_vendor = blank

  for filter in collection.filters
    if filter.param_name == 'filter.p.vendor'
      assign vendor_filter = filter
      for value in filter.active_values
        assign active_vendor = value.label
        break
      endfor
      break
    endif
  endfor

  assign fallback_slugs_pipe = '|'
  assign fallback_labels_json = ''

  if vendor_filter == blank and products != blank
    for product in products
      assign raw_vendor = product.vendor | strip
      assign raw_down = raw_vendor | downcase

      if raw_vendor == blank
        continue
      endif

      if raw_down contains 'lamstone'
        assign brand_slug = 'lamstone-healthcare'
        assign brand_label = 'Lamstone Healthcare'
      else
        assign brand_slug = raw_vendor | handleize
        assign brand_label = raw_vendor
      endif

      assign slug_token = '|' | append: brand_slug | append: '|'
      unless fallback_slugs_pipe contains slug_token
        assign fallback_slugs_pipe = fallback_slugs_pipe | append: brand_slug | append: '|'
        assign fallback_labels_json = fallback_labels_json | append: brand_slug | append: '::' | append: brand_label | append: '||'
      endunless
    endfor
  endif
%}

{% if vendor_filter != blank or fallback_slugs_pipe != '|' %}
  <nav class="lame-collection-brand-nav" aria-label="{{ 'lame_collection.shop_by_brand' | t }}">
    <p class="lame-collection-brand-nav__label">{{ 'lame_collection.shop_by_brand' | t }}</p>
    <ul class="lame-collection-brand-nav__list" role="list">
      <li class="lame-collection-brand-nav__item">
        <a
          href="{{ collection.url }}"
          class="lame-collection-brand-nav__pill{% if active_vendor == blank %} lame-collection-brand-nav__pill--active{% endif %}"
        >
          {{ 'lame_collection.all_brands' | t }}
        </a>
      </li>

      {% if vendor_filter != blank %}
        {% for value in vendor_filter.values %}
          <li class="lame-collection-brand-nav__item">
            <a
              href="{{ value.url_to_add }}"
              class="lame-collection-brand-nav__pill{% if value.active %} lame-collection-brand-nav__pill--active{% endif %}"
              {% if value.count == 0 %}aria-disabled="true"{% endif %}
            >
              <span class="lame-collection-brand-nav__name">{{ value.label }}</span>
              <span class="lame-collection-brand-nav__count">({{ value.count }})</span>
            </a>
          </li>
        {% endfor %}
      {% else %}
        {% assign fallback_slugs = fallback_slugs_pipe | split: '|' %}
        {% for brand_slug in fallback_slugs %}
          {% if brand_slug != blank %}
            {% liquid
              assign brand_label = brand_slug
              assign label_chunks = fallback_labels_json | split: '||'
              for chunk in label_chunks
                if chunk contains brand_slug
                  assign brand_label = chunk | split: '::' | last
                  break
                endif
              endfor
            %}
            <li class="lame-collection-brand-nav__item">
              <a
                href="{{ collection.url }}?filter.p.vendor={{ brand_label | url_encode }}"
                class="lame-collection-brand-nav__pill{% if active_vendor == brand_label %} lame-collection-brand-nav__pill--active{% endif %}"
              >
                <span class="lame-collection-brand-nav__name">{{ brand_label }}</span>
              </a>
            </li>
          {% endif %}
        {% endfor %}
      {% endif %}
    </ul>
    {% if vendor_filter == blank and fallback_slugs_pipe != '|' %}
      <p class="lame-collection-brand-nav__hint">{{ 'lame_collection.brand_nav_hint' | t }}</p>
    {% endif %}
  </nav>
{% endif %}
