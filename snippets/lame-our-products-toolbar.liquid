{%- doc -%}
  Collection toolbar: result count + sort (Our Products template).

  @param {object} collection - Collection
  @param {object} paginate - Paginate object
  @param {object} section - Section
  @param {boolean} [enable_sorting]
  @param {boolean} [enable_grid_density]
{%- enddoc -%}

{%- liquid
  assign range_start = paginate.current_offset | plus: 1
  assign range_end = paginate.current_offset | plus: paginate.page_size
  if range_end > paginate.items
    assign range_end = paginate.items
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = active_filter_count | default: 0
-%}

<div class="lame-our-products-toolbar">
  <div class="lame-our-products-toolbar__row">
    <p class="lame-our-products-toolbar__count" role="status">
      {{ 'lame_our_products.showing_range' | t: from: range_start, to: range_end, total: paginate.items }}
    </p>
    <div class="lame-our-products-toolbar__actions">
      {% if enable_filtering %}
        <button
          type="button"
          class="lame-our-products-toolbar__filters button button-unstyled button-unstyled--with-icon"
          on:click="#filters-drawer/showDialog"
          aria-haspopup="dialog"
        >
          <span class="svg-wrapper" aria-hidden="true">
            {{ 'icon-filter.svg' | inline_asset_content }}
          </span>
          <span class="lame-our-products-toolbar__filters-label">{{ 'actions.show_filters' | t }}</span>
          {% if active_filter_count > 0 %}
            <span class="lame-our-products-toolbar__filters-count" aria-label="{{ 'accessibility.filter_count' | t: count: active_filter_count }}">
              {{ active_filter_count }}
            </span>
          {% endif %}
        </button>
      {% endif %}
      {% if enable_sorting %}
        {% render 'sorting',
          results: collection,
          sort_by: sort_by,
          filter_style: 'horizontal',
          suffix: 'our-products',
          sort_position: 'desktop',
          should_use_select_on_mobile: false,
          section_id: section.id
        %}
      {% endif %}
      {% if enable_grid_density %}
        {% render 'grid-density-controls', viewport: 'desktop' %}
      {% endif %}
    </div>
  </div>
</div>
