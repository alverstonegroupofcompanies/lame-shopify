{%- doc -%}
  Default or custom header action icon.

  @param {string} icon_type - account, wishlist, or cart
  @param {image} [custom_image] - Optional image from theme editor
  @param {string} [class] - Optional class on the icon element
  @param {number} [size] - Icon size in pixels for default SVG icons
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 22
  assign icon_class = class | default: 'header-actions__icon-image'
-%}

{%- if custom_image != blank -%}
  {{
    custom_image
    | image_url: width: 160
    | image_tag:
      class: icon_class,
      widths: '40,80,160',
      sizes: '20px',
      loading: 'eager',
      width: icon_size,
      height: icon_size,
      alt: ''
  }}
{%- else -%}
  {%- case icon_type -%}
    {%- when 'wishlist' -%}
      <svg
        class="{{ icon_class }}"
        width="{{ icon_size }}"
        height="{{ icon_size }}"
        viewBox="0 0 24 24"
        fill="none"
        focusable="false"
        aria-hidden="true"
      >
        <path
          d="M12 20.25S3.75 15.1 3.75 9.6A4.35 4.35 0 0 1 12 7.35 4.35 4.35 0 0 1 20.25 9.6c0 5.5-8.25 10.65-8.25 10.65Z"
          fill="none"
          stroke="currentColor"
          stroke-width="var(--icon-stroke-width, 1.6)"
          stroke-linejoin="round"
        />
      </svg>
    {%- when 'cart' -%}
      <svg
        class="{{ icon_class }}"
        width="{{ icon_size }}"
        height="{{ icon_size }}"
        viewBox="0 0 24 24"
        fill="none"
        focusable="false"
        aria-hidden="true"
      >
        <path
          d="M7.5 8.25V7.1a4.5 4.5 0 0 1 9 0v1.15"
          stroke="currentColor"
          stroke-width="var(--icon-stroke-width, 1.6)"
          stroke-linecap="round"
        />
        <path
          d="M6.2 8.25h11.6l-.95 10.1a1.7 1.7 0 0 1-1.69 1.5H8.84a1.7 1.7 0 0 1-1.69-1.5L6.2 8.25Z"
          stroke="currentColor"
          stroke-width="var(--icon-stroke-width, 1.6)"
          stroke-linejoin="round"
        />
      </svg>
    {%- when 'account' -%}
      {% render 'lame-account-icon', size: icon_size, class: icon_class %}
  {%- endcase -%}
{%- endif -%}
