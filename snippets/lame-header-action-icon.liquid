{%- doc -%}
  Default or custom header action icon.

  @param {string} icon_type - account, wishlist, or cart
  @param {image} [custom_image] - Optional image from theme editor
  @param {string} [class] - Optional class on the icon element
  @param {number} [size] - Icon size in pixels for default SVG icons
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_class = class | default: 'header-actions__icon-image'
-%}

{%- if custom_image != blank -%}
  {{
    custom_image
    | image_url: width: 160
    | image_tag:
      class: icon_class,
      widths: '40,80,160',
      sizes: '24px',
      loading: 'eager',
      width: icon_size,
      height: icon_size,
      alt: ''
  }}
{%- else -%}
  {%- case icon_type -%}
    {%- when 'wishlist' -%}
      <svg
        class="{{ icon_class }} lucide lucide-heart"
        width="{{ icon_size }}"
        height="{{ icon_size }}"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
        aria-hidden="true"
      >
        <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
      </svg>
    {%- when 'cart' -%}
      <svg
        class="{{ icon_class }} lucide lucide-shopping-bag"
        width="{{ icon_size }}"
        height="{{ icon_size }}"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        focusable="false"
        aria-hidden="true"
      >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
        <path d="M3 6h18"/>
        <path d="M16 10a4 4 0 0 1-8 0"/>
      </svg>
    {%- when 'account' -%}
      {% render 'lame-account-icon', size: icon_size, class: icon_class %}
  {%- endcase -%}
{%- endif -%}
