{%- doc -%}
  Our Products — replace-style pagination (next / previous only, no infinite scroll).

  @param {object} paginate - Shopify paginate object
  @param {string} [on_click_handler] - results-list handler for section morph (replaces grid)
{%- enddoc -%}

{%- if paginate.pages > 1 -%}
<nav
  class="lame-collection-pagination"
  aria-label="{{ 'content.pagination.nav_label' | t }}"
  data-current-page="{{ paginate.current_page }}"
>
  <div class="lame-collection-pagination__actions">
    {%- if paginate.previous -%}
      {%- assign prev_params = paginate.previous.url | split: '?' | last -%}
      <a
        href="{{ paginate.previous.url }}"
        class="lame-collection-pagination__btn lame-collection-pagination__btn--prev button-unstyled"
        rel="prev"
        {% if on_click_handler != blank %}
          on:click="{{ on_click_handler }}?{{ prev_params }}"
        {% endif %}
      >
        <span class="lame-collection-pagination__icon" aria-hidden="true">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </span>
        <span class="lame-collection-pagination__label">{{ 'lame_our_products.previous' | t }}</span>
      </a>
    {%- else -%}
      <span
        class="lame-collection-pagination__btn lame-collection-pagination__btn--prev lame-collection-pagination__btn--disabled"
        aria-disabled="true"
      >
        <span class="lame-collection-pagination__icon" aria-hidden="true">
          {{- 'icon-chevron-left.svg' | inline_asset_content -}}
        </span>
        <span class="lame-collection-pagination__label">{{ 'lame_our_products.previous' | t }}</span>
      </span>
    {%- endif -%}

    <span class="lame-collection-pagination__status" aria-live="polite">
      {{ 'lame_our_products.page_of' | t: current: paginate.current_page, pages: paginate.pages }}
    </span>

    {%- if paginate.next -%}
      {%- assign next_params = paginate.next.url | split: '?' | last -%}
      <a
        href="{{ paginate.next.url }}"
        class="lame-collection-pagination__btn lame-collection-pagination__btn--next button-unstyled"
        rel="next"
        {% if on_click_handler != blank %}
          on:click="{{ on_click_handler }}?{{ next_params }}"
        {% endif %}
      >
        <span class="lame-collection-pagination__label">{{ 'lame_our_products.next' | t }}</span>
        <span class="lame-collection-pagination__icon" aria-hidden="true">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </span>
      </a>
    {%- else -%}
      <span
        class="lame-collection-pagination__btn lame-collection-pagination__btn--next lame-collection-pagination__btn--disabled"
        aria-disabled="true"
      >
        <span class="lame-collection-pagination__label">{{ 'lame_our_products.next' | t }}</span>
        <span class="lame-collection-pagination__icon" aria-hidden="true">
          {{- 'icon-chevron-right.svg' | inline_asset_content -}}
        </span>
      </span>
    {%- endif -%}
  </div>
</nav>
{%- endif -%}
