{%- doc -%}
  Free-shipping progress banner for cart page.
  @param {number} [threshold_cents] - Free shipping threshold in cents (default 99900 = ₹999)
{%- enddoc -%}

{%- liquid
  assign threshold = threshold_cents | default: 99900
  assign cart_total = cart.total_price
  assign remaining = threshold | minus: cart_total
  if remaining < 0
    assign remaining = 0
  endif
  assign progress = cart_total | times: 100 | divided_by: threshold
  if progress > 100
    assign progress = 100
  endif
-%}

{%- unless cart.empty? -%}
  <div class="lame-cart-shipping-banner" role="status">
    <span class="lame-cart-shipping-banner__icon" aria-hidden="true">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" focusable="false">
        <path d="M12 2C8 6 4 8 4 12a8 8 0 1 0 16 0c0-4-4-6-8-10Z" stroke="currentColor" stroke-width="1.4"/>
        <path d="M12 8v8M9 11h6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    </span>
    <div class="lame-cart-shipping-banner__content">
      {%- if remaining == 0 -%}
        <p class="lame-cart-shipping-banner__text lame-cart-shipping-banner__text--success">
          {{ 'lame_cart.free_shipping_unlocked' | t }}
        </p>
      {%- else -%}
        <p class="lame-cart-shipping-banner__text">
          {{ 'lame_cart.free_shipping_remaining' | t: amount: remaining | money }}
        </p>
      {%- endif -%}
      <div class="lame-cart-shipping-banner__track" aria-hidden="true">
        <span class="lame-cart-shipping-banner__fill" style="width: {{ progress }}%;"></span>
      </div>
    </div>
  </div>
{%- endunless -%}
