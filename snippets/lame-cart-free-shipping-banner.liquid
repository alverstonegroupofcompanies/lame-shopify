{%- doc -%}
  Free-shipping progress banner for cart page.
  @param {number} [threshold_cents] - Free shipping threshold in cents (default 99900 = ₹999)
{%- enddoc -%}

{%- liquid
  assign threshold = threshold_cents | default: 99900
  assign cart_total = cart.total_price
  assign remaining = threshold | minus: cart_total
  if remaining < 0
    assign remaining = 0
  endif
  assign progress = cart_total | times: 100 | divided_by: threshold
  if progress > 100
    assign progress = 100
  endif
  assign remaining_money = remaining | money
  assign threshold_money = threshold | money
  assign cart_total_money = cart_total | money
  assign unlocked = false
  if remaining == 0
    assign unlocked = true
  endif
-%}

{%- unless cart.empty? -%}
  <div
    class="lame-cart-shipping-banner{% if unlocked %} lame-cart-shipping-banner--unlocked{% endif %}"
    role="status"
    aria-live="polite"
  >
    <div class="lame-cart-shipping-banner__card">
      <div class="lame-cart-shipping-banner__top">
        <div class="lame-cart-shipping-banner__icon-wrap" aria-hidden="true">
          {%- if unlocked -%}
            <svg class="lame-cart-shipping-banner__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" focusable="false">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8 12.5l2.5 2.5L16 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {%- else -%}
            <svg class="lame-cart-shipping-banner__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" focusable="false">
              <path d="M3 7h11v8H3V7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M14 10h4l3 3v2h-7v-5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="7" cy="17" r="1.75" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17" cy="17" r="1.75" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          {%- endif -%}
        </div>

        <div class="lame-cart-shipping-banner__copy">
          {%- if unlocked -%}
            <p class="lame-cart-shipping-banner__title">{{ 'lame_cart.free_shipping_unlocked' | t }}</p>
            <p class="lame-cart-shipping-banner__meta">Enjoy complimentary delivery on this order.</p>
          {%- else -%}
            <p class="lame-cart-shipping-banner__title">You're almost there!</p>
            <p class="lame-cart-shipping-banner__meta">
              Add <span class="lame-cart-shipping-banner__amount">{{ remaining_money }}</span> more for
              <span class="lame-cart-shipping-banner__highlight">free delivery</span>
            </p>
          {%- endif -%}
        </div>

        {%- unless unlocked -%}
          <div class="lame-cart-shipping-banner__chip" aria-hidden="true">
            <span class="lame-cart-shipping-banner__chip-label">Goal</span>
            <span class="lame-cart-shipping-banner__chip-value">{{ threshold_money }}</span>
          </div>
        {%- endunless -%}
      </div>

      <div class="lame-cart-shipping-banner__progress" aria-hidden="true">
        <div class="lame-cart-shipping-banner__progress-labels">
          <span class="lame-cart-shipping-banner__progress-current">{{ cart_total_money }}</span>
          {%- unless unlocked -%}
            <span class="lame-cart-shipping-banner__progress-goal">{{ threshold_money }}</span>
          {%- endunless -%}
        </div>
        <div class="lame-cart-shipping-banner__track">
          <span class="lame-cart-shipping-banner__fill" style="--progress: {{ progress }}%;"></span>
        </div>
      </div>
    </div>
  </div>
{%- endunless -%}
