{%- doc -%}
  Payment method labels shown below order summary on cart page.
{%- enddoc -%}

<div class="lame-cart-payments">
  <p class="lame-cart-payments__label">{{ 'lame_cart.we_accept' | t }}</p>
  <ul class="lame-cart-payments__list" role="list">
    <li class="lame-cart-payments__item">Visa</li>
    <li class="lame-cart-payments__item">Mastercard</li>
    <li class="lame-cart-payments__item">UPI</li>
    <li class="lame-cart-payments__item">{{ 'lame_cart.payment_netbanking' | t }}</li>
    <li class="lame-cart-payments__item">{{ 'lame_cart.payment_wallets' | t }}</li>
  </ul>
</div>
