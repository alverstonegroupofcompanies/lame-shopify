{%- comment -%}
  LAMÉ — Luxury Floating "Review Us" & Community Widget
  - Deep emerald & champagne gold aesthetic
  - Ambient gold pulse & shimmer micro-animations
  - Smooth spring popover with branded SVG cards (Google, Instagram, WhatsApp)
  - Smart footer collision prevention (auto-lifts when scrolling near footer to avoid covering "EXPLORE")
  - Accessible: click outside to close, ESC key support, ARIA attributes
{%- endcomment -%}

<style>
  /* -------------------------------------------------------------
     LAMÉ FLOATING REVIEW WIDGET — LUXURY STYLING & ANIMATIONS
  ------------------------------------------------------------- */
  .lam-fab-wrap {
    position: fixed;
    left: max(20px, env(safe-area-inset-left));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 998;
    font-family: var(--font-body-family, 'Jost', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none; /* children re-enable */
  }

  /* Trigger Button */
  .lam-fab-btn {
    pointer-events: auto;
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 20px 11px 16px;
    background: linear-gradient(135deg, #072318 0%, #0d3829 55%, #051b12 100%);
    color: #ffffff;
    border: 1px solid rgba(212, 175, 55, 0.45);
    border-radius: 999px;
    cursor: pointer;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    box-shadow:
      0 10px 26px rgba(4, 20, 14, 0.4),
      0 0 0 1px rgba(212, 175, 55, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Ambient Gold Pulse Ring */
  .lam-fab-btn::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    border: 1.5px solid rgba(212, 175, 55, 0.5);
    opacity: 0;
    pointer-events: none;
    animation: lamPulseRing 3.8s cubic-bezier(0.24, 0, 0.38, 1) infinite;
  }

  /* Glossy Shimmer Sweep */
  .lam-fab-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 60%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.22) 50%,
      transparent
    );
    transform: skewX(-22deg);
    pointer-events: none;
    border-radius: 999px;
    animation: lamShimmerSweep 5.5s ease-in-out infinite;
  }

  @keyframes lamPulseRing {
    0% {
      transform: scale(0.96);
      opacity: 0;
    }
    30% {
      opacity: 0.8;
    }
    70% {
      transform: scale(1.15);
      opacity: 0;
    }
    100% {
      transform: scale(1.15);
      opacity: 0;
    }
  }

  @keyframes lamShimmerSweep {
    0%, 65% {
      left: -120%;
    }
    85%, 100% {
      left: 180%;
    }
  }

  /* Button Hover & Active */
  .lam-fab-btn:hover {
    transform: translateY(-2px) scale(1.02);
    border-color: rgba(212, 175, 55, 0.8);
    background: linear-gradient(135deg, #092c1f 0%, #124835 55%, #072318 100%);
    box-shadow:
      0 14px 32px rgba(4, 20, 14, 0.55),
      0 0 20px rgba(212, 175, 55, 0.35),
      0 0 0 1px rgba(212, 175, 55, 0.5);
  }

  .lam-fab-btn:active {
    transform: translateY(0) scale(0.98);
  }

  /* Star Icon container */
  .lam-fab-icon-box {
    position: relative;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .lam-fab-star-icon,
  .lam-fab-close-icon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 18px;
    height: 18px;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.25s ease;
  }

  .lam-fab-star-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    filter: drop-shadow(0 1px 3px rgba(212, 175, 55, 0.6));
  }

  .lam-fab-close-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
    color: #e5c07b;
  }

  /* Text inside button */
  .lam-fab-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    line-height: 1;
  }

  .lam-fab-rating-pill {
    display: inline-flex;
    align-items: center;
    padding: 2px 6px;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid rgba(212, 175, 55, 0.38);
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    color: #ffd778;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  /* When Open: Button active state */
  .lam-fab-wrap.is-open .lam-fab-btn {
    background: linear-gradient(135deg, #10382b 0%, #061e14 100%);
    border-color: rgba(212, 175, 55, 0.7);
    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.45),
      0 0 16px rgba(212, 175, 55, 0.25);
  }

  .lam-fab-wrap.is-open .lam-fab-star-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .lam-fab-wrap.is-open .lam-fab-close-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  /* -------------------------------------------------------------
     POPOVER MENU PANEL
  ------------------------------------------------------------- */
  .lam-fab-popover {
    pointer-events: none;
    position: absolute;
    bottom: calc(100% + 14px);
    left: 0;
    width: 310px;
    max-width: calc(100vw - 36px);
    background: rgba(7, 28, 20, 0.96);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 20px;
    padding: 16px;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.95);
    transform-origin: bottom left;
    transition:
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.28s;
  }

  .lam-fab-wrap.is-open .lam-fab-popover {
    pointer-events: auto;
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Popover Header */
  .lam-fab-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid rgba(212, 175, 55, 0.16);
  }

  .lam-fab-head-title {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .lam-fab-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #d4af37;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .lam-fab-stars-cluster {
    display: inline-flex;
    gap: 2px;
    color: #ffc107;
    font-size: 10px;
    line-height: 1;
  }

  .lam-fab-heading {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .lam-fab-dismiss-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #c9d5d0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .lam-fab-dismiss-btn:hover {
    background: rgba(212, 175, 55, 0.2);
    border-color: rgba(212, 175, 55, 0.4);
    color: #ffd778;
    transform: rotate(90deg);
  }

  /* Menu Items List */
  .lam-fab-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Card Item */
  .lam-fab-item {
    display: block;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: 14px;
    padding: 11px 13px;
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    transition:
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
    opacity: 0;
    transform: translateY(8px);
  }

  /* Staggered entrance */
  .lam-fab-wrap.is-open .lam-fab-item:nth-child(1) {
    animation: lamItemIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) 0.04s forwards;
  }
  .lam-fab-wrap.is-open .lam-fab-item:nth-child(2) {
    animation: lamItemIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) 0.09s forwards;
  }
  .lam-fab-wrap.is-open .lam-fab-item:nth-child(3) {
    animation: lamItemIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) 0.14s forwards;
  }

  @keyframes lamItemIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .lam-fab-item:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(212, 175, 55, 0.55);
    transform: translateY(-2px) translateX(2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  /* Icon Badges */
  .lam-fab-badge {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .lam-fab-badge--google {
    background: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .lam-fab-badge--instagram {
    background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
    box-shadow: 0 2px 8px rgba(214, 36, 159, 0.35);
  }

  .lam-fab-badge--instagram svg {
    color: #ffffff;
  }

  .lam-fab-badge--whatsapp {
    background: #25d366;
    box-shadow: 0 2px 8px rgba(37, 211, 102, 0.35);
  }

  .lam-fab-item:hover .lam-fab-badge {
    transform: scale(1.1) rotate(-4deg);
  }

  /* Item Info */
  .lam-fab-info {
    flex: 1;
    min-width: 0;
  }

  .lam-fab-name {
    margin: 0;
    font-size: 13.5px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .lam-fab-desc {
    margin: 2px 0 0;
    font-size: 11.5px;
    color: #a3bbb2;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Action Arrow */
  .lam-fab-arrow {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(212, 175, 55, 0.12);
    border: 1px solid rgba(212, 175, 55, 0.25);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffd778;
    flex-shrink: 0;
    transition: transform 0.22s ease, background 0.22s ease;
  }

  .lam-fab-item:hover .lam-fab-arrow {
    transform: translateX(3px);
    background: rgba(212, 175, 55, 0.35);
    color: #ffffff;
  }

  /* Mobile Tweaks */
  @media screen and (max-width: 749px) {
    .lam-fab-wrap {
      left: max(16px, env(safe-area-inset-left));
      bottom: max(16px, env(safe-area-inset-bottom));
    }

    .lam-fab-btn {
      padding: 10px 17px 10px 14px;
      font-size: 13px;
    }

    .lam-fab-popover {
      width: 290px;
      padding: 14px;
    }

    .lam-fab-item {
      padding: 9px 11px;
      gap: 10px;
    }

    .lam-fab-badge {
      width: 34px;
      height: 34px;
    }
  }
</style>

