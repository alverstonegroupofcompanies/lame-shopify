<script>
  (function () {
    const wrap = document.getElementById('lamFabWrap');
    const trigger = document.getElementById('lamFabTrigger');
    const dismiss = document.getElementById('lamFabDismiss');
    if (!wrap || !trigger) return;

    function toggleMenu(forceState) {
      const willOpen = typeof forceState === 'boolean' ? forceState : !wrap.classList.contains('is-open');
      wrap.classList.toggle('is-open', willOpen);
      trigger.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      toggleMenu();
    });

    if (dismiss) {
      dismiss.addEventListener('click', function (e) {
        e.stopPropagation();
        toggleMenu(false);
      });
    }

    // Click outside to close
    document.addEventListener('click', function (e) {
      if (wrap.classList.contains('is-open') && !wrap.contains(e.target)) {
        toggleMenu(false);
      }
    });

    // Escape key to close
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && wrap.classList.contains('is-open')) {
        toggleMenu(false);
        trigger.focus();
      }
    });

    // -------------------------------------------------------------
    // SMART FOOTER COLLISION AVOIDANCE
    // When the user scrolls down near the footer, lift the widget
    // smoothly so it never overlaps footer columns like "EXPLORE"
    // -------------------------------------------------------------
    let ticking = false;
    function updateFabPosition() {
      ticking = false;
      const footer = document.querySelector('.footer-premium') || document.querySelector('footer');
      if (!footer || !wrap) return;

      const footerRect = footer.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const baseMargin = window.innerWidth <= 749 ? 16 : 20;

      // If footer top has entered the viewport above the button's bottom threshold
      if (footerRect.top < viewportHeight - baseMargin) {
        const overlap = (viewportHeight - baseMargin) - footerRect.top;
        wrap.style.transform = `translate3d(0, -${Math.max(0, overlap + 10)}px, 0)`;
      } else {
        wrap.style.transform = 'translate3d(0, 0, 0)';
      }
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateFabPosition);
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    // Run once on load
    updateFabPosition();
  })();
</script>
