{%- doc -%}
  Elite Pro Membership Slide - Luxury Text Overlay & Member Benefits
  Renders interactive, customizable HTML text over the membership banner image.
{%- enddoc -%}

{%- liquid
  assign elite_heading = block.settings.elite_heading | default: 'MyLamstone Elite Pro Membership'
  assign elite_tagline = block.settings.elite_tagline | default: 'Shop More. Save More. Feel Special.'
  assign elite_badge = block.settings.elite_badge | default: 'SPECIAL ACCESS PASS'
  assign elite_offer = block.settings.elite_offer_text | default: 'Join for ₹199 / 6 months'
  assign elite_btn = block.settings.elite_btn_text | default: 'Join Elite Pro →'
  assign elite_link = block.settings.elite_btn_link
  if elite_link == blank
    assign elite_link = link
  endif
  if elite_link == blank or elite_link == '/products/elite-pro-6-months'
    assign elite_link = '/pages/elite-pro'
  endif
  assign elite_desc = block.settings.elite_description | default: 'Privileges curated exclusively to elevate your beauty & wellness shopping experience.'

  assign b1_t = block.settings.elite_b1_title | default: 'Free Gifts on Orders Above ₹899'
  assign b1_d = block.settings.elite_b1_desc | default: 'Delight in complimentary luxury beauty miniatures and gifts on eligible orders.'

  assign b2_t = block.settings.elite_b2_title | default: 'Refer & Reward'
  assign b2_d = block.settings.elite_b2_desc | default: 'Invite friends and earn exciting reward points when they place their first order.'

  assign b3_t = block.settings.elite_b3_title | default: 'Welcome Gift'
  assign b3_d = block.settings.elite_b3_desc | default: 'A special welcome treat credited right upon your Elite Pro membership activation.'

  assign b4_t = block.settings.elite_b4_title | default: 'Easy Cash on Delivery'
  assign b4_d = block.settings.elite_b4_desc | default: 'Seamless, reliable cash on delivery with zero hassle and priority verification.'

  assign b5_t = block.settings.elite_b5_title | default: 'Member-Only Offers'
  assign b5_d = block.settings.elite_b5_desc | default: 'Enjoy exclusive deals, special discounts and privileges available only to Elite Pro members.'

  assign b6_t = block.settings.elite_b6_title | default: 'Birthday Treat'
  assign b6_d = block.settings.elite_b6_desc | default: 'Celebrate your special day with a delightful birthday surprise from MyLamstone.'

  assign fallback_elite_bg = 'lame-elite-pro-winter-banner.jpg' | asset_url
  assign final_elite_bg = bg_image | default: fallback_elite_bg
-%}

<div class="lame-elite-hero">
  <!-- Clickable background anchor -->
  <a href="{{ elite_link }}" class="lame-elite-hero__bg-hitarea" aria-label="{{ elite_heading | escape }}"></a>

  <!-- Background graphic -->
  <div class="lame-elite-hero__bg">
    <img
      src="{{ final_elite_bg }}"
      alt="{{ elite_heading | escape }}"
      class="lame-elite-hero__img"
      loading="lazy"
      decoding="async"
    >
    <div class="lame-elite-hero__veil" aria-hidden="true"></div>
  </div>

  <!-- Content Layer -->
  <div class="lame-elite-hero__content">
    <div class="lame-elite-hero__header">
      <h2 class="lame-elite-hero__title">{{ elite_heading }}</h2>
      <p class="lame-elite-hero__tagline">{{ elite_tagline }}</p>
    </div>

    <!-- Special Access Pass (Unboxed & Open Modern Layout) -->
    <div class="lame-elite-hero__offer-bar">
      <div class="lame-elite-hero__offer-info">
        <div class="lame-elite-hero__badge-line">
          <span class="lame-elite-hero__crown-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
              <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5zm14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
            </svg>
          </span>
          <span class="lame-elite-hero__badge">{{ elite_badge }}</span>
        </div>
        <div class="lame-elite-hero__price">{{ elite_offer }}</div>
      </div>

      <a href="{{ elite_link }}" class="lame-elite-hero__btn">
        <span>{{ elite_btn }}</span>
        <svg class="lame-elite-hero__btn-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Description -->
    <p class="lame-elite-hero__desc">{{ elite_desc }}</p>

    <!-- Desktop Member Benefits (6-item clean grid) -->
    <div class="lame-elite-hero__benefits lame-elite-hero__benefits--desktop">
      <div class="lame-elite-hero__benefits-label">MEMBER BENEFITS</div>
      <div class="lame-elite-hero__benefits-grid">
        <div class="lame-elite-hero__benefit-card" title="{{ b1_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 12 20 22 4 22 4 12"></polyline>
              <rect x="2" y="7" width="20" height="5"></rect>
              <line x1="12" y1="22" x2="12" y2="7"></line>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b1_t }}</span>
        </div>

        <div class="lame-elite-hero__benefit-card" title="{{ b2_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b2_t }}</span>
        </div>

        <div class="lame-elite-hero__benefit-card" title="{{ b3_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b3_t }}</span>
        </div>

        <div class="lame-elite-hero__benefit-card" title="{{ b4_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b4_t }}</span>
        </div>

        <div class="lame-elite-hero__benefit-card" title="{{ b5_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b5_t }}</span>
        </div>

        <div class="lame-elite-hero__benefit-card" title="{{ b6_d }}">
          <span class="lame-elite-hero__benefit-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path>
              <path d="M4 16s2-1 4 0 4 0 4 0 2-1 4 0 4 0 4 0"></path>
              <line x1="2" y1="21" x2="22" y2="21"></line>
              <line x1="12" y1="7" x2="12" y2="11"></line>
              <circle cx="12" cy="4" r="1" fill="currentColor"></circle>
            </svg>
          </span>
          <span class="lame-elite-hero__benefit-name">{{ b6_t }}</span>
        </div>
      </div>
    </div>

    <!-- Mobile Member Benefits (Minimal Smooth Cycling Perks Ticker) -->
    <div class="lame-elite-hero__benefits-mobile">
      <div class="lame-elite-hero__mobile-perks-head">
        <span class="lame-elite-hero__mobile-perks-tag">MEMBER PERKS</span>
      </div>
      <div class="lame-elite-hero__mobile-ticker" data-elite-mobile-ticker>
        <div class="lame-elite-hero__ticker-pill is-active">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b1_t }}</span>
        </div>
        <div class="lame-elite-hero__ticker-pill">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b2_t }}</span>
        </div>
        <div class="lame-elite-hero__ticker-pill">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"></circle><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b3_t }}</span>
        </div>
        <div class="lame-elite-hero__ticker-pill">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b4_t }}</span>
        </div>
        <div class="lame-elite-hero__ticker-pill">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b5_t }}</span>
        </div>
        <div class="lame-elite-hero__ticker-pill">
          <span class="lame-elite-hero__ticker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path><line x1="2" y1="21" x2="22" y2="21"></line></svg>
          </span>
          <span class="lame-elite-hero__ticker-text">{{ b6_t }}</span>
        </div>
      </div>
    </div>
  </div>
</div>
