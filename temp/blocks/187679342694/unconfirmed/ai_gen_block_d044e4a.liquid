{% doc %}
  @prompt
    add some thing like running in loop offers and our product code or somethign an example for cosmetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-looping-offers-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
    display: block;
  }

  .ai-looping-offers-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_spacing }}px;
    animation: ai-looping-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-looping-offers-{{ ai_gen_id }}:hover .ai-looping-offers-track-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }

  .ai-looping-offers-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
    white-space: nowrap;
    flex-shrink: 0;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
  }

  .ai-looping-offers-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
  }

  .ai-looping-offers-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  @keyframes ai-looping-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-looping-offers-item-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }

    .ai-looping-offers-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<looping-offers-{{ ai_gen_id }} class="ai-looping-offers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-looping-offers-track-{{ ai_gen_id }}">
    {% for i in (1..2) %}
      {% if block.settings.offer_1 != blank %}
        <div class="ai-looping-offers-item-{{ ai_gen_id }}">
          <span class="ai-looping-offers-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span>{{ block.settings.offer_1 }}</span>
        </div>
      {% endif %}

      {% if block.settings.offer_2 != blank %}
        <div class="ai-looping-offers-item-{{ ai_gen_id }}">
          <span class="ai-looping-offers-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span>{{ block.settings.offer_2 }}</span>
        </div>
      {% endif %}

      {% if block.settings.offer_3 != blank %}
        <div class="ai-looping-offers-item-{{ ai_gen_id }}">
          <span class="ai-looping-offers-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span>{{ block.settings.offer_3 }}</span>
        </div>
      {% endif %}

      {% if block.settings.offer_4 != blank %}
        <div class="ai-looping-offers-item-{{ ai_gen_id }}">
          <span class="ai-looping-offers-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span>{{ block.settings.offer_4 }}</span>
        </div>
      {% endif %}

      {% if block.settings.offer_5 != blank %}
        <div class="ai-looping-offers-item-{{ ai_gen_id }}">
          <span class="ai-looping-offers-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
            </svg>
          </span>
          <span>{{ block.settings.offer_5 }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</looping-offers-{{ ai_gen_id }}>

<script>
  (function() {
    class LoopingOffers{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-looping-offers-track-{{ ai_gen_id }}');
      }
    }

    customElements.define('looping-offers-{{ ai_gen_id }}', LoopingOffers{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Looping offers banner",
  "settings": [
    {
      "type": "header",
      "content": "Offers"
    },
    {
      "type": "text",
      "id": "offer_1",
      "label": "Offer 1",
      "default": "FREE SHIPPING ON ORDERS OVER ₹999"
    },
    {
      "type": "text",
      "id": "offer_2",
      "label": "Offer 2",
      "default": "USE CODE: GLOW20 FOR 20% OFF"
    },
    {
      "type": "text",
      "id": "offer_3",
      "label": "Offer 3",
      "default": "BUY 2 GET 1 FREE ON SERUMS"
    },
    {
      "type": "text",
      "id": "offer_4",
      "label": "Offer 4",
      "default": "CRUELTY-FREE & VEGAN CERTIFIED"
    },
    {
      "type": "text",
      "id": "offer_5",
      "label": "Offer 5",
      "default": "NEW ARRIVALS EVERY WEEK"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#faf6e9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#c9a227"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "label": "Icon spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "item_spacing",
      "label": "Item spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Looping offers banner"
    }
  ]
}
{% endschema %}
