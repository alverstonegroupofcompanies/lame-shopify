{
  "_comment": "Apply via Shopify Admin → Settings → Checkout → Customize, or checkoutBrandingUpsert GraphQL. Replace CHECKOUT_PROFILE_ID and LOGO_IMAGE_URL.",
  "checkoutProfileId": "gid://shopify/CheckoutProfile/CHECKOUT_PROFILE_ID",
  "checkoutBrandingInput": {
    "designSystem": {
      "colors": {
        "global": {
          "accent": "#C9971F",
          "brand": "#141414",
          "critical": "#8B0000",
          "decorative": "#D4AF37",
          "info": "#2F4F3A",
          "success": "#2F4F3A",
          "warning": "#C9971F"
        },
        "schemes": {
          "scheme1": {
            "base": {
              "background": "#F8F5EE",
              "text": "#141414"
            },
            "control": {
              "background": "#FFFFFF",
              "border": "#D4AF3759",
              "text": "#141414"
            },
            "primaryButton": {
              "background": "#C9971F",
              "border": "#C9971F",
              "text": "#FFFFFF",
              "hover": {
                "background": "#6D5616",
                "border": "#6D5616",
                "text": "#FFFFFF"
              }
            },
            "secondaryButton": {
              "background": "transparent",
              "border": "#141414",
              "text": "#141414",
              "hover": {
                "background": "#D4AF3714",
                "border": "#C9971F",
                "text": "#141414"
              }
            }
          },
          "scheme2": {
            "base": {
              "background": "#FFFFFF",
              "text": "#141414"
            },
            "control": {
              "background": "#F8F5EE",
              "border": "#DFDFDF",
              "text": "#141414"
            },
            "primaryButton": {
              "background": "#141414",
              "border": "#141414",
              "text": "#F8F5EE",
              "hover": {
                "background": "#C9971F",
                "border": "#C9971F",
                "text": "#141414"
              }
            }
          }
        }
      },
      "typography": {
        "primary": {
          "name": "Belleza",
          "loadingStrategy": "SWAP",
          "base": {
            "sources": "local('Belleza'), local('Belleza Regular')"
          }
        },
        "secondary": {
          "name": "Cormorant Garamond",
          "loadingStrategy": "SWAP",
          "base": {
            "sources": "local('Cormorant Garamond')"
          }
        }
      },
      "cornerRadius": {
        "base": 8,
        "small": 6,
        "large": 12
      }
    },
    "customizations": {
      "global": {
        "cornerRadius": "BASE",
        "typography": {
          "letterCase": "NONE"
        }
      },
      "header": {
        "alignment": "CENTER",
        "position": "START",
        "logo": {
          "image": {
            "url": "LOGO_IMAGE_URL"
          },
          "maxWidth": 180
        }
      },
      "headingLevel1": {
        "typography": {
          "font": "SECONDARY",
          "size": "LARGE",
          "weight": "BASE"
        }
      },
      "headingLevel2": {
        "typography": {
          "font": "SECONDARY",
          "size": "MEDIUM",
          "weight": "BASE"
        }
      },
      "control": {
        "border": "FULL",
        "color": "SCHEME1",
        "cornerRadius": "BASE",
        "labelPosition": "TOP"
      },
      "textField": {
        "typography": {
          "font": "PRIMARY",
          "size": "BASE",
          "weight": "BASE"
        }
      },
      "select": {
        "typography": {
          "font": "PRIMARY",
          "size": "BASE",
          "weight": "BASE"
        }
      },
      "primaryButton": {
        "background": "SOLID",
        "blockPadding": "BASE",
        "border": "FULL",
        "cornerRadius": "LARGE",
        "inlinePadding": "LOOSE",
        "typography": {
          "font": "PRIMARY",
          "size": "BASE",
          "weight": "BOLD",
          "letterCase": "UPPER"
        }
      },
      "secondaryButton": {
        "background": "SOLID",
        "border": "FULL",
        "cornerRadius": "LARGE"
      },
      "main": {
        "section": {
          "colorScheme": "SCHEME1",
          "cornerRadius": "BASE",
          "padding": "BASE"
        }
      },
      "orderSummary": {
        "section": {
          "colorScheme": "SCHEME2",
          "cornerRadius": "BASE",
          "padding": "BASE"
        }
      },
      "footer": {
        "position": "END",
        "colorScheme": "SCHEME1"
      }
    }
  }
}
