  "html_defaults": {
    "share_information_about_your": "<p>Del oplysninger om dit brand med dine kunder. Beskriv et produkt, kom med meddelelser, eller byd kunder velkommen i din butik.</p>",
    "bestseller_h2": "<h2>Bestsellere</h2>",
