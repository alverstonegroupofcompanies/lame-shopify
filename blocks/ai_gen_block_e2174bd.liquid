{% doc %}
  @prompt
    need a gif banner her at top 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign secondary_image = block.settings.second_banner_image | default: block.settings.banner_image_2 %}

{% style %}
  /* Break parent section and containers out to 100% full viewport width with zero padding/margins */
  body.template-index .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}),
  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    margin-inline: 0 !important;
    padding: 0 !important;
    padding-inline: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow-x: clip !important;
  }

  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) .section {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    padding-block: 0 !important;
    padding-inline: 0 !important;
    min-height: 0 !important;
    grid-template-columns: 100% !important;
  }

  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) :is(.custom-section-content, .section-content-wrapper, .section > *) {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    padding-block: 0 !important;
    padding-inline: 0 !important;
    min-height: 0 !important;
  }

  /* Remove blank space between GIF banner and Home hero banner below it */
  body.template-index .content-for-layout > .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) + .shopify-section {
    margin-top: 0 !important;
    margin-block-start: 0 !important;
    padding-top: 0 !important;
    padding-block-start: 0 !important;
  }

  /* GIF banner block container: full bleed edge to edge */
  .ai-gif-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  .ai-gif-banner-container-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 0 !important;
  }

  .ai-gif-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  /* Alternating GIF / Banner slider */
  .ai-gif-banner-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .ai-gif-banner-slide-{{ ai_gen_id }} {
    transition: opacity 0.8s ease-in-out;
    will-change: opacity;
  }

  /* Slide 1 (GIF) remains in normal flow to keep exact responsive height on desktop and mobile */
  .ai-gif-banner-slide-gif-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 1;
    z-index: 1;
  }

  .ai-gif-banner-slide-gif-{{ ai_gen_id }}.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Slide 2 (Banner) overlays at exactly the same height and width */
  .ai-gif-banner-slide-banner-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0;
    z-index: 2;
    pointer-events: none;
  }

  .ai-gif-banner-slide-banner-{{ ai_gen_id }}.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-gif-banner-slide-{{ ai_gen_id }} {
      transition: none !important;
    }
  }

  /* Full-bleed responsive image/GIF */
  .ai-gif-banner-image-{{ ai_gen_id }} {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    min-width: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  .ai-gif-banner-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 250px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-gif-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-gif-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-gif-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 3;
  }

  .ai-gif-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 4;
    width: 90%;
    max-width: 800px;
  }

  .ai-gif-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-gif-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    line-height: 1.4;
  }

  .ai-gif-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .ai-gif-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-gif-banner-wrapper-{{ ai_gen_id }} {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .ai-gif-banner-image-{{ ai_gen_id }} {
      width: 100% !important;
      height: auto !important;
      max-width: 100% !important;
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .ai-gif-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-gif-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-gif-banner-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-gif-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gif-banner-container-{{ ai_gen_id }}">
    <div class="ai-gif-banner-wrapper-{{ ai_gen_id }}">
      {% if block.settings.banner_image != blank %}
        <div class="ai-gif-banner-slides-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.banner_image | image_url: width: 2000 }}"
            alt="{{ block.settings.banner_image.alt | default: 'GIF banner' | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ block.settings.banner_image.width }}"
            height="{{ block.settings.banner_image.height }}"
            class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
            data-src="{{ block.settings.banner_image | image_url: width: 2000 }}"
          >
          {% if secondary_image != blank %}
            <img
              src="{{ secondary_image | image_url: width: 2000 }}"
              alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
              loading="eager"
              width="{{ secondary_image.width | default: block.settings.banner_image.width }}"
              height="{{ secondary_image.height | default: block.settings.banner_image.height }}"
              class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-banner-{{ ai_gen_id }}"
            >
          {% endif %}
        </div>
      {% elsif secondary_image != blank %}
        <div class="ai-gif-banner-slides-{{ ai_gen_id }}">
          <img
            src="{{ secondary_image | image_url: width: 2000 }}"
            alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ secondary_image.width }}"
            height="{{ secondary_image.height }}"
            class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
          >
        </div>
      {% else %}
        <div class="ai-gif-banner-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-gif-banner-empty-state-{{ ai_gen_id }}">
            Next, add a GIF or image
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="ai-gif-banner-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.show_content %}
        <div class="ai-gif-banner-content-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-gif-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
          {% endif %}

          {% if block.settings.subheading != blank %}
            <p class="ai-gif-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
          {% endif %}

          {% if block.settings.button_text != blank and block.settings.button_link != blank %}
            <a href="{{ block.settings.button_link }}" class="ai-gif-banner-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% if block.settings.banner_image != blank and secondary_image != blank %}
  <script>
    (function() {
      function initBannerAlternator() {
        var container = document.querySelector('.ai-gif-banner-{{ ai_gen_id }}');
        if (!container) return;

        var gifImg = container.querySelector('.ai-gif-banner-slide-gif-{{ ai_gen_id }}');
        var bannerImg = container.querySelector('.ai-gif-banner-slide-banner-{{ ai_gen_id }}');

        if (!gifImg || !bannerImg) return;

        var showGif = true;

        function restartGifElement(img) {
          if (!img) return;
          var rawSrc = img.dataset.src || img.getAttribute('src');
          if (!img.dataset.src) {
            img.dataset.src = rawSrc;
          }
          var base = img.dataset.src;
          var clean = base.replace(/([?&])_t=\d+(&|$)/, function(m, p1, p2) {
            return p2 ? p1 : '';
          }).replace(/[?&]$/, '');
          var sep = clean.indexOf('?') !== -1 ? '&' : '?';
          img.src = clean + sep + '_t=' + Date.now();
        }

        function switchSlide() {
          if (showGif) {
            // Switch from GIF to Banner
            showGif = false;
            gifImg.classList.add('is-hidden');
            bannerImg.classList.add('is-active');
          } else {
            // Switch from Banner back to GIF
            showGif = true;
            // Restart GIF from frame 0 right as it fades in
            restartGifElement(gifImg);
            gifImg.classList.remove('is-hidden');
            bannerImg.classList.remove('is-active');
          }
        }

        var intervalId = setInterval(switchSlide, 10000);

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            clearInterval(intervalId);
          } else {
            clearInterval(intervalId);
            intervalId = setInterval(switchSlide, 10000);
          }
        });

        if (window.Shopify && window.Shopify.designMode) {
          document.addEventListener('shopify:section:unload', function(e) {
            if (container && container.closest('#shopify-section-' + e.detail?.sectionId)) {
              clearInterval(intervalId);
            }
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBannerAlternator);
      } else {
        initBannerAlternator();
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "GIF banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image or GIF",
      "info": "Upload a GIF or static image"
    },
    {
      "type": "image_picker",
      "id": "second_banner_image",
      "label": "Banner image",
      "info": "Second image to alternate with the GIF every 10 seconds"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "banner_height",
      "label": "Desktop height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "mobile_banner_height",
      "label": "Mobile height",
      "min": 150,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 300
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show content",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover amazing products"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button hover text color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "GIF banner"
    }
  ]
}
{% endschema %}
