{% doc %}
  @prompt
    Olive Young Luxury K-Beauty Peek Carousel Banner - Image Banners Only
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign valid_slides_count = 0

  assign img_1 = block.settings.banner_image
  assign link_1 = block.settings.banner_link
  if link_1 == blank
    assign link_1 = '/collections/all'
  endif
  if img_1 != blank
    assign valid_slides_count = valid_slides_count | plus: 1
  endif

  assign img_2 = block.settings.second_banner_image
  assign link_2 = block.settings.second_banner_link
  if link_2 == blank
    assign link_2 = '/collections/all'
  endif
  if img_2 != blank
    assign valid_slides_count = valid_slides_count | plus: 1
  endif

  assign enable_elite_overlay = block.settings.enable_elite_pro_overlay
  if enable_elite_overlay == nil
    assign enable_elite_overlay = true
  endif

  assign img_3 = block.settings.third_banner_image
  if block.settings.elite_pro_custom_bg != blank
    assign img_3 = block.settings.elite_pro_custom_bg
  endif

  assign link_3 = block.settings.third_banner_link
  if link_3 == blank or link_3 == '/products/elite-pro-6-months'
    assign link_3 = '/pages/elite-pro'
  endif

  assign has_slide_3 = false
  if block.settings.enable_third_banner != false
    if enable_elite_overlay
      if img_3 != blank
        assign elite_bg_asset = img_3 | image_url: width: 2400
      else
        assign elite_bg_asset = 'lame-elite-pro-bg.jpg' | asset_url
      endif
      assign valid_slides_count = valid_slides_count | plus: 1
      assign has_slide_3 = true
    elsif img_3 != blank
      assign valid_slides_count = valid_slides_count | plus: 1
      assign has_slide_3 = true
    endif
  endif

  assign img_4 = block.settings.fourth_banner_image
  assign link_4 = block.settings.fourth_banner_link
  if link_4 == blank
    assign link_4 = '/collections/all'
  endif
  if img_4 != blank and block.settings.enable_fourth_banner != false
    assign valid_slides_count = valid_slides_count | plus: 1
  else
    assign img_4 = blank
  endif

  assign img_5 = block.settings.fifth_banner_image
  assign link_5 = block.settings.fifth_banner_link
  if link_5 == blank
    assign link_5 = '/collections/all'
  endif
  if img_5 != blank and block.settings.enable_fifth_banner != false
    assign valid_slides_count = valid_slides_count | plus: 1
  else
    assign img_5 = blank
  endif

  assign img_6 = block.settings.sixth_banner_image
  assign link_6 = block.settings.sixth_banner_link
  if link_6 == blank
    assign link_6 = '/collections/all'
  endif
  if img_6 != blank and block.settings.enable_sixth_banner != false
    assign valid_slides_count = valid_slides_count | plus: 1
  else
    assign img_6 = blank
  endif

  assign slide_interval_s = block.settings.slide_duration | default: 8
  assign banner_h_desktop = block.settings.banner_height | default: 480
  assign banner_h_mobile = block.settings.mobile_banner_height | default: 260
  assign slide_width_pct = block.settings.desktop_width_percent | default: 60
  assign card_radius = block.settings.border_radius
  if card_radius == nil or card_radius == blank
    assign card_radius = 0
  endif
  assign img_fit = block.settings.image_fit | default: 'cover'

  assign maintain_ratio_mb = block.settings.maintain_aspect_ratio_mobile
  if maintain_ratio_mb == nil
    assign maintain_ratio_mb = true
  endif

  assign banner_aspect_ratio = block.settings.mobile_aspect_ratio
  if banner_aspect_ratio == blank or banner_aspect_ratio == 'auto'
    if img_1 != blank and img_1.aspect_ratio != blank and img_1.aspect_ratio > 0
      assign banner_aspect_ratio = img_1.aspect_ratio
    elsif img_2 != blank and img_2.aspect_ratio != blank and img_2.aspect_ratio > 0
      assign banner_aspect_ratio = img_2.aspect_ratio
    else
      assign banner_aspect_ratio = '1024 / 411'
    endif
  endif
-%}

<div class="ai-gif-banner-{{ ai_gen_id }} lame-oy-banner-section" style="--oy-banner-height-desktop: {{ banner_h_desktop }}px; --oy-banner-height-mobile: {{ banner_h_mobile }}px; --oy-slide-width-desktop: {{ slide_width_pct }}%; --oy-card-radius: {{ card_radius }}px; --oy-image-fit: {{ img_fit }}; --oy-slide-gap: 20px; --oy-banner-aspect-ratio: {{ banner_aspect_ratio }}; --oy-maintain-aspect-ratio-mobile: {% if maintain_ratio_mb %}1{% else %}0{% endif %};">
  {%- if valid_slides_count > 0 -%}
    <div class="lame-oy-carousel" id="LameOYCarousel-{{ ai_gen_id }}" data-autoplay="{{ slide_interval_s }}" data-slides-count="{{ valid_slides_count }}" role="region" aria-roledescription="carousel" aria-label="Featured Offers">
      <div class="lame-oy-viewport" data-oy-viewport>
        <div class="lame-oy-track" data-oy-track>
          {%- assign cur_idx = 0 -%}

          {%- if img_1 != blank -%}
            <div class="lame-oy-slide" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card">
                <a href="{{ link_1 }}" class="lame-oy-card__link" aria-label="{{ img_1.alt | default: 'Featured Banner' | escape }}">
                  <div class="lame-oy-card__graphic-fill">
                    <img
                      src="{{ img_1 | image_url: width: 2400 }}"
                      alt="{{ img_1.alt | default: 'Featured Banner' | escape }}"
                      class="lame-oy-card__graphic-img"
                      loading="eager"
                      decoding="async"
                      width="{{ img_1.width | default: 2400 }}"
                      height="{{ img_1.height | default: 800 }}"
                    >
                    {%- if block.settings.show_overlay -%}
                      <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if block.settings.show_content and block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="lame-oy-card__content-layer">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="lame-oy-card__heading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.heading_size | default: 48 }}px;">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="lame-oy-card__subheading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.subheading_size | default: 18 }}px;">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}

          {%- if img_2 != blank -%}
            <div class="lame-oy-slide" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card">
                <a href="{{ link_2 }}" class="lame-oy-card__link" aria-label="{{ img_2.alt | default: 'Featured Banner' | escape }}">
                  <div class="lame-oy-card__graphic-fill">
                    <img
                      src="{{ img_2 | image_url: width: 2400 }}"
                      alt="{{ img_2.alt | default: 'Featured Banner' | escape }}"
                      class="lame-oy-card__graphic-img"
                      loading="lazy"
                      decoding="async"
                      width="{{ img_2.width | default: 2400 }}"
                      height="{{ img_2.height | default: 800 }}"
                    >
                    {%- if block.settings.show_overlay -%}
                      <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if block.settings.show_content and block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="lame-oy-card__content-layer">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="lame-oy-card__heading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.heading_size | default: 48 }}px;">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="lame-oy-card__subheading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.subheading_size | default: 18 }}px;">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}

          {%- if has_slide_3 -%}
            <div class="lame-oy-slide lame-oy-slide--elite-pro" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card lame-oy-card--elite-pro">
                {%- if enable_elite_overlay -%}
                  {% render 'lame-elite-pro-banner-slide', block: block, link: link_3, bg_image: elite_bg_asset %}
                {%- else -%}
                  <a href="{{ link_3 }}" class="lame-oy-card__link" aria-label="{{ img_3.alt | default: 'Featured Banner' | escape }}">
                    <div class="lame-oy-card__graphic-fill">
                      <img
                        src="{{ img_3 | image_url: width: 2400 }}"
                        alt="{{ img_3.alt | default: 'Featured Banner' | escape }}"
                        class="lame-oy-card__graphic-img"
                        loading="lazy"
                        decoding="async"
                        width="{{ img_3.width | default: 2400 }}"
                        height="{{ img_3.height | default: 800 }}"
                      >
                      {%- if block.settings.show_overlay -%}
                        <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                      {%- endif -%}
                    </div>
                  </a>
                {%- endif -%}
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}

          {%- if img_4 != blank -%}
            <div class="lame-oy-slide" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card">
                <a href="{{ link_4 }}" class="lame-oy-card__link" aria-label="{{ img_4.alt | default: 'Featured Banner' | escape }}">
                  <div class="lame-oy-card__graphic-fill">
                    <img
                      src="{{ img_4 | image_url: width: 2400 }}"
                      alt="{{ img_4.alt | default: 'Featured Banner' | escape }}"
                      class="lame-oy-card__graphic-img"
                      loading="lazy"
                      decoding="async"
                      width="{{ img_4.width | default: 2400 }}"
                      height="{{ img_4.height | default: 800 }}"
                    >
                    {%- if block.settings.show_overlay -%}
                      <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if block.settings.show_content and block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="lame-oy-card__content-layer">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="lame-oy-card__heading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.heading_size | default: 48 }}px;">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="lame-oy-card__subheading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.subheading_size | default: 18 }}px;">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}

          {%- if img_5 != blank -%}
            <div class="lame-oy-slide" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card">
                <a href="{{ link_5 }}" class="lame-oy-card__link" aria-label="{{ img_5.alt | default: 'Featured Banner' | escape }}">
                  <div class="lame-oy-card__graphic-fill">
                    <img
                      src="{{ img_5 | image_url: width: 2400 }}"
                      alt="{{ img_5.alt | default: 'Featured Banner' | escape }}"
                      class="lame-oy-card__graphic-img"
                      loading="lazy"
                      decoding="async"
                      width="{{ img_5.width | default: 2400 }}"
                      height="{{ img_5.height | default: 800 }}"
                    >
                    {%- if block.settings.show_overlay -%}
                      <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if block.settings.show_content and block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="lame-oy-card__content-layer">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="lame-oy-card__heading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.heading_size | default: 48 }}px;">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="lame-oy-card__subheading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.subheading_size | default: 18 }}px;">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}

          {%- if img_6 != blank -%}
            <div class="lame-oy-slide" data-oy-slide data-index="{{ cur_idx }}" role="group" aria-roledescription="slide" aria-label="{{ cur_idx | plus: 1 }} of {{ valid_slides_count }}">
              <div class="lame-oy-card">
                <a href="{{ link_6 }}" class="lame-oy-card__link" aria-label="{{ img_6.alt | default: 'Featured Banner' | escape }}">
                  <div class="lame-oy-card__graphic-fill">
                    <img
                      src="{{ img_6 | image_url: width: 2400 }}"
                      alt="{{ img_6.alt | default: 'Featured Banner' | escape }}"
                      class="lame-oy-card__graphic-img"
                      loading="lazy"
                      decoding="async"
                      width="{{ img_6.width | default: 2400 }}"
                      height="{{ img_6.height | default: 800 }}"
                    >
                    {%- if block.settings.show_overlay -%}
                      <div class="lame-oy-card__overlay" style="background-color: {{ block.settings.overlay_color | default: '#000000' }}; opacity: {{ block.settings.overlay_opacity | default: 30 | divided_by: 100.0 }};" aria-hidden="true"></div>
                    {%- endif -%}
                    {%- if block.settings.show_content and block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="lame-oy-card__content-layer">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="lame-oy-card__heading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.heading_size | default: 48 }}px;">{{ block.settings.heading | escape }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="lame-oy-card__subheading" style="color: {{ block.settings.text_color | default: '#ffffff' }}; font-size: {{ block.settings.subheading_size | default: 18 }}px;">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            </div>
            {%- assign cur_idx = cur_idx | plus: 1 -%}
          {%- endif -%}
        </div>
      </div>

      {%- if valid_slides_count > 1 -%}
        <!-- Bottom Controls (Pill Dots Pagination - Counter & Arrows removed per request) -->
        <div class="lame-oy-controls">
          <div class="lame-oy-dots" role="tablist" aria-label="Carousel pagination">
            {%- for i in (1..valid_slides_count) -%}
              {%- assign dot_idx = i | minus: 1 -%}
              <button type="button" class="lame-oy-dot{% if dot_idx == 0 %} is-active{% endif %}" data-oy-dot="{{ dot_idx }}" aria-label="Go to slide {{ i }}">
                <span class="lame-oy-dot__fill" data-oy-dot-fill></span>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
    {%- if request.design_mode -%}
      <div class="lame-oy-empty-notice" style="padding: 40px 20px; text-align: center; background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 12px; margin: 20px auto; max-width: 800px;">
        <p style="margin: 0; color: #64748b; font-size: 15px;">Please add at least one banner image in block settings to display the Olive Young carousel banner.</p>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<style>
  body.template-index .shopify-section:has(.lame-oy-banner-section),
  .shopify-section:has(.lame-oy-banner-section) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: clip !important;
  }

  .lame-oy-banner-section {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin-inline: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    box-sizing: border-box;
  }

  .lame-oy-carousel {
    position: relative;
    width: 100%;
    overflow: hidden;
    touch-action: pan-y pinch-zoom;
  }

  .lame-oy-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 0;
  }

  .lame-oy-track {
    display: flex;
    align-items: center;
    gap: var(--oy-slide-gap, 20px);
    width: 100%;
    will-change: transform;
    transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lame-oy-slide {
    flex: 0 0 var(--oy-slide-width-desktop, 82%);
    width: var(--oy-slide-width-desktop, 82%);
    max-width: var(--oy-slide-width-desktop, 82%);
    box-sizing: border-box;
    transition: opacity 0.6s ease, transform 0.6s ease;
    opacity: 0.88;
    cursor: pointer;
  }

  .lame-oy-slide.is-active {
    opacity: 1;
    cursor: default;
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .lame-oy-track {
      gap: 16px;
    }
    .lame-oy-slide {
      flex: 0 0 84%;
      width: 84%;
      max-width: 84%;
    }
  }

  @media (max-width: 749px) {
    .lame-oy-carousel,
    .lame-oy-viewport {
      width: 100% !important;
      max-width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }
    .lame-oy-track {
      gap: 0px !important;
    }
    .lame-oy-slide {
      flex: 0 0 100% !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 100% !important;
      opacity: 1 !important;
      box-sizing: border-box !important;
    }
    .lame-oy-slide.is-active {
      opacity: 1 !important;
    }
  }

  .lame-oy-card {
    position: relative;
    width: 100% !important;
    height: var(--oy-banner-height-desktop, 480px) !important;
    border-radius: var(--oy-card-radius, 0px) !important;
    overflow: hidden !important;
    background-color: #f8fafc;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    container-type: inline-size;
    container-name: lame-card;
  }

  @media (min-width: 750px) and (max-width: 989px) {
    .lame-oy-card {
      height: clamp(340px, 40vw, 420px) !important;
    }
  }

  @media (max-width: 749px) {
    .lame-oy-card {
      width: 100% !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      min-height: 0 !important;
      max-height: none !important;
    }

    .lame-oy-banner-section[style*="--oy-maintain-aspect-ratio-mobile: 1"] .lame-oy-card,
    .lame-oy-card {
      height: auto !important;
      aspect-ratio: var(--oy-banner-aspect-ratio, 1024 / 411) !important;
    }

    .lame-oy-banner-section[style*="--oy-maintain-aspect-ratio-mobile: 0"] .lame-oy-card {
      height: var(--oy-banner-height-mobile, 260px) !important;
      aspect-ratio: unset !important;
    }
  }

  .lame-oy-card__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .lame-oy-card__graphic-fill {
    position: relative;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lame-oy-card__graphic-img {
    width: 100% !important;
    height: 100% !important;
    min-height: 100% !important;
    max-height: 100% !important;
    object-fit: var(--oy-image-fit, cover) !important;
    object-position: center !important;
    display: block !important;
    transition: transform 0.45s ease;
  }

  .lame-oy-card:hover .lame-oy-card__graphic-img {
    transform: scale(1.02);
  }

  .lame-oy-card__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .lame-oy-card__content-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(20px, 4vw, 40px);
    pointer-events: none;
  }

  .lame-oy-card__heading {
    margin: 0 0 8px 0;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .lame-oy-card__subheading {
    margin: 0;
    font-weight: 500;
    line-height: 1.35;
  }

  @media screen and (max-width: 749px) {
    .lame-oy-card__content-layer {
      padding: clamp(8px, 2.5cqi, 16px) clamp(10px, 3cqi, 20px) !important;
    }
    .lame-oy-card__heading {
      font-size: clamp(14px, 4.2cqi, 22px) !important;
      line-height: 1.15 !important;
      margin-bottom: 3px !important;
    }
    .lame-oy-card__subheading {
      font-size: clamp(9px, 2.4cqi, 12px) !important;
      line-height: 1.25 !important;
    }
    .lame-oy-controls {
      margin-top: 8px !important;
    }
    .lame-oy-dot {
      width: 14px;
      height: 3px;
    }
