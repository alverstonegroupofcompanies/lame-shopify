            if (pauseIcon) pauseIcon.style.display = 'inline-block';
            if (playIcon) playIcon.style.display = 'none';
            pauseBtn.setAttribute('aria-label', 'Pause slideshow');
          }
        });
      }

      // Touch / Swipe
      var startX = 0;
      var isDragging = false;
      var diffX = 0;

      viewport.addEventListener('touchstart', function(e) {
        startX = e.touches[0].clientX;
        isDragging = true;
        diffX = 0;
        stopAutoplay();
      }, { passive: true });

      viewport.addEventListener('touchmove', function(e) {
        if (!isDragging) return;
        diffX = e.touches[0].clientX - startX;
      }, { passive: true });

      viewport.addEventListener('touchend', function() {
        if (!isDragging) return;
        isDragging = false;
        if (diffX < -40) {
          next();
        } else if (diffX > 40) {
          prev();
        }
        restartAutoplay();
      });

      // Resize
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          updatePosition(false);
        }, 100);
      });

      // Elite Pro mobile perks ticker
      var mobileTickers = container.querySelectorAll('[data-elite-mobile-ticker]');
      mobileTickers.forEach(function(ticker) {
        var pills = Array.from(ticker.querySelectorAll('.lame-elite-hero__ticker-pill'));
        if (pills.length <= 1) return;
        var pIdx = 0;
        setInterval(function() {
          pills[pIdx].classList.remove('is-active');
          pIdx = (pIdx + 1) % pills.length;
          pills[pIdx].classList.add('is-active');
        }, 2600);
      });

      // Initial Render
      updatePosition(false);
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initOliveYoungCarousel);
    } else {
      initOliveYoungCarousel();
    }
  })();
</script>

