{% doc %}
  @prompt
    need a gif banner her at top 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign first_image = block.settings.banner_image %}
{% assign first_link = block.settings.banner_link %}
{% assign secondary_image = block.settings.second_banner_image | default: block.settings.banner_image_2 %}
{% assign second_link = block.settings.second_banner_link %}
{% assign third_image = block.settings.third_banner_image | default: block.settings.banner_image_3 %}
{% assign third_link = block.settings.third_banner_link | default: block.settings.banner_link_3 %}
{% if third_link == blank or third_link == '/products/elite-pro-6-months' %}
  {% assign third_link = '/pages/elite-pro' %}
{% endif %}
{% assign show_third_banner = block.settings.enable_third_banner %}
{% if show_third_banner == nil %}
  {% assign show_third_banner = true %}
{% endif %}
{% assign third_img_src = '' %}
{% if show_third_banner %}
  {% if third_image != blank %}
    {% assign third_img_src = third_image | image_url: width: 2000 %}
  {% else %}
    {% assign third_img_src = 'lame-elite-pro-banner.jpg' | asset_url %}
  {% endif %}
{% endif %}

{% assign fourth_image = block.settings.fourth_banner_image | default: block.settings.banner_image_4 %}
{% assign fourth_link = block.settings.fourth_banner_link | default: block.settings.banner_link_4 %}
{% assign show_fourth_banner = block.settings.enable_fourth_banner %}
{% if show_fourth_banner == nil %}
  {% assign show_fourth_banner = true %}
{% endif %}
{% assign fourth_img_src = '' %}
{% if show_fourth_banner and fourth_image != blank %}
  {% assign fourth_img_src = fourth_image | image_url: width: 2000 %}
{% endif %}

{% assign slide_count = 0 %}
{% if first_image != blank %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}
{% if secondary_image != blank %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}
{% if third_img_src != blank %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}
{% if fourth_img_src != blank %}
  {% assign slide_count = slide_count | plus: 1 %}
{% endif %}

{% assign slide_interval_s = block.settings.slide_duration | default: 10 %}

{% style %}
  /* Break parent section and containers out to 100% full viewport width with zero padding/margins */
  body.template-index .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}),
  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    margin-inline: 0 !important;
    padding: 0 !important;
    padding-inline: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    overflow-x: clip !important;
  }

  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) .section {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    padding-block: 0 !important;
    padding-inline: 0 !important;
    min-height: 0 !important;
    grid-template-columns: 100% !important;
  }

  .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) :is(.custom-section-content, .section-content-wrapper, .section > *) {
    grid-column: 1 / -1 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    padding-block: 0 !important;
    padding-inline: 0 !important;
    min-height: 0 !important;
  }

  /* Remove blank space between GIF banner and Home hero banner below it */
  body.template-index .content-for-layout > .shopify-section:has(.ai-gif-banner-{{ ai_gen_id }}) + .shopify-section {
    margin-top: 0 !important;
    margin-block-start: 0 !important;
    padding-top: 0 !important;
    padding-block-start: 0 !important;
  }

  /* GIF banner block container: full bleed edge to edge */
  .ai-gif-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  .ai-gif-banner-container-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    border-radius: 0 !important;
  }

  .ai-gif-banner-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
  }

  /* Alternating GIF / Banner slider */
  .ai-gif-banner-slides-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
  }

  .ai-gif-banner-slide-{{ ai_gen_id }} {
    transition: opacity 0.8s ease-in-out;
    will-change: opacity;
  }

  /* Slide 1 (GIF) remains in normal flow to keep exact responsive height on desktop and mobile */
  .ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }} {
    display: block !important;
    width: 100% !important;
    position: relative !important;
    text-decoration: none !important;
    transition: opacity 0.8s ease-in-out;
    will-change: opacity;
  }

  .ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }}.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .ai-gif-banner-slide-gif-{{ ai_gen_id }} {
    position: relative;
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 1;
    z-index: 1;
    transition: opacity 0.8s ease-in-out;
  }

  .ai-gif-banner-slide-gif-{{ ai_gen_id }}.is-hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  /* Subsequent slides (Banner 2, Banner 3 / Elite Pro, Banner 4) overlay at exactly the same height and width */
  .ai-gif-banner-slide-banner-{{ ai_gen_id }},
  .ai-gif-banner-slide-third-{{ ai_gen_id }},
  .ai-gif-banner-slide-fourth-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    opacity: 0 !important;
    z-index: 2 !important;
    pointer-events: none !important;
    text-decoration: none !important;
    cursor: pointer;
    transition: opacity 0.8s ease-in-out;
    will-change: opacity;
  }

  .ai-gif-banner-slide-banner-{{ ai_gen_id }} img,
  .ai-gif-banner-slide-third-{{ ai_gen_id }} img,
  .ai-gif-banner-slide-fourth-{{ ai_gen_id }} img {
    width: 100% !important;
    height: 100% !important;
    max-width: 100% !important;
    min-width: 100% !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    border: none !important;
  }

  .ai-gif-banner-slide-banner-{{ ai_gen_id }}.is-active,
  .ai-gif-banner-slide-third-{{ ai_gen_id }}.is-active,
  .ai-gif-banner-slide-fourth-{{ ai_gen_id }}.is-active {
    opacity: 1 !important;
    pointer-events: auto !important;
    z-index: 5 !important;
    cursor: pointer !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-gif-banner-slide-{{ ai_gen_id }},
    .ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }},
    .ai-gif-banner-slide-gif-{{ ai_gen_id }},
    .ai-gif-banner-slide-banner-{{ ai_gen_id }},
    .ai-gif-banner-slide-third-{{ ai_gen_id }},
    .ai-gif-banner-slide-fourth-{{ ai_gen_id }} {
      transition: none !important;
    }
  }

  /* Full-bleed responsive image/GIF */
  .ai-gif-banner-image-{{ ai_gen_id }} {
    width: 100% !important;
    height: auto !important;
    max-width: 100% !important;
    min-width: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    object-fit: cover !important;
    object-position: center !important;
    display: block !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  .ai-gif-banner-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    width: 100%;
    min-height: 250px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-gif-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-gif-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-gif-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
    z-index: 3;
  }

  .ai-gif-banner-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 6;
    width: 90%;
    max-width: 800px;
    pointer-events: none !important;
  }

  .ai-gif-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-gif-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    line-height: 1.4;
  }

  .ai-gif-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    transition: all 0.3s ease;
    pointer-events: auto !important;
  }

  .ai-gif-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-gif-banner-wrapper-{{ ai_gen_id }} {
      width: 100% !important;
      max-width: 100% !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .ai-gif-banner-image-{{ ai_gen_id }} {
      width: 100% !important;
      height: auto !important;
      max-width: 100% !important;
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .ai-gif-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-gif-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-gif-banner-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="ai-gif-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-gif-banner-container-{{ ai_gen_id }}">
    <div class="ai-gif-banner-wrapper-{{ ai_gen_id }}">
      {% if first_image != blank %}
        <div class="ai-gif-banner-slides-{{ ai_gen_id }}">
          {% if first_link != blank %}
            <a href="{{ first_link }}" class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }}">
              <img
                src="{{ first_image | image_url: width: 2000 }}"
                alt="{{ first_image.alt | default: 'GIF banner' | escape }}"
                loading="eager"
                fetchpriority="high"
                width="{{ first_image.width }}"
                height="{{ first_image.height }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
                data-src="{{ first_image | image_url: width: 2000 }}"
              >
            </a>
          {% else %}
            <img
              src="{{ first_image | image_url: width: 2000 }}"
              alt="{{ first_image.alt | default: 'GIF banner' | escape }}"
              loading="eager"
              fetchpriority="high"
              width="{{ first_image.width }}"
              height="{{ first_image.height }}"
              class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
              data-src="{{ first_image | image_url: width: 2000 }}"
            >
          {% endif %}

          {% if secondary_image != blank %}
            {% if second_link != blank %}
              <a href="{{ second_link }}" class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-banner-{{ ai_gen_id }}">
                <img
                  src="{{ secondary_image | image_url: width: 2000 }}"
                  alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
                  loading="eager"
                  width="{{ secondary_image.width | default: first_image.width }}"
                  height="{{ secondary_image.height | default: first_image.height }}"
                  class="ai-gif-banner-image-{{ ai_gen_id }}"
                >
              </a>
            {% else %}
              <img
                src="{{ secondary_image | image_url: width: 2000 }}"
                alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
                loading="eager"
                width="{{ secondary_image.width | default: first_image.width }}"
                height="{{ secondary_image.height | default: first_image.height }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-banner-{{ ai_gen_id }}"
              >
            {% endif %}
          {% endif %}

          {% if third_img_src != blank %}
            {% if third_link != blank %}
              <a
                href="{{ third_link }}"
                class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-third-{{ ai_gen_id }}"
                aria-label="MyLamstone Elite Pro Membership"
              >
                <img
                  src="{{ third_img_src }}"
                  alt="{{ third_image.alt | default: 'MyLamstone Elite Pro Membership' | escape }}"
                  loading="eager"
                  width="{{ third_image.width | default: 2000 }}"
                  height="{{ third_image.height | default: 500 }}"
                  class="ai-gif-banner-image-{{ ai_gen_id }}"
                >
              </a>
            {% else %}
              <img
                src="{{ third_img_src }}"
                alt="{{ third_image.alt | default: 'MyLamstone Elite Pro Membership' | escape }}"
                loading="eager"
                width="{{ third_image.width | default: 2000 }}"
                height="{{ third_image.height | default: 500 }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-third-{{ ai_gen_id }}"
              >
            {% endif %}
          {% endif %}

          {% if fourth_img_src != blank %}
            {% if fourth_link != blank %}
              <a
                href="{{ fourth_link }}"
                class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-fourth-{{ ai_gen_id }}"
                aria-label="Banner image 4"
              >
                <img
                  src="{{ fourth_img_src }}"
                  alt="{{ fourth_image.alt | default: 'Banner image 4' | escape }}"
                  loading="eager"
                  width="{{ fourth_image.width | default: 2000 }}"
                  height="{{ fourth_image.height | default: 500 }}"
                  class="ai-gif-banner-image-{{ ai_gen_id }}"
                >
              </a>
            {% else %}
              <img
                src="{{ fourth_img_src }}"
                alt="{{ fourth_image.alt | default: 'Banner image 4' | escape }}"
                loading="eager"
                width="{{ fourth_image.width | default: 2000 }}"
                height="{{ fourth_image.height | default: 500 }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-fourth-{{ ai_gen_id }}"
              >
            {% endif %}
          {% endif %}
        </div>
      {% elsif secondary_image != blank %}
        <div class="ai-gif-banner-slides-{{ ai_gen_id }}">
          {% if second_link != blank %}
            <a href="{{ second_link }}" class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }}">
              <img
                src="{{ secondary_image | image_url: width: 2000 }}"
                alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
                loading="eager"
                fetchpriority="high"
                width="{{ secondary_image.width }}"
                height="{{ secondary_image.height }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
              >
            </a>
          {% else %}
            <img
              src="{{ secondary_image | image_url: width: 2000 }}"
              alt="{{ secondary_image.alt | default: 'Banner image' | escape }}"
              loading="eager"
              fetchpriority="high"
              width="{{ secondary_image.width }}"
              height="{{ secondary_image.height }}"
              class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
            >
          {% endif %}
        </div>
      {% elsif third_img_src != blank %}
        <div class="ai-gif-banner-slides-{{ ai_gen_id }}">
          {% if third_link != blank %}
            <a href="{{ third_link }}" class="ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }}" aria-label="MyLamstone Elite Pro Membership">
              <img
                src="{{ third_img_src }}"
                alt="{{ third_image.alt | default: 'MyLamstone Elite Pro Membership' | escape }}"
                loading="eager"
                fetchpriority="high"
                width="{{ third_image.width | default: 2000 }}"
                height="{{ third_image.height | default: 500 }}"
                class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
              >
            </a>
          {% else %}
            <img
              src="{{ third_img_src }}"
              alt="{{ third_image.alt | default: 'MyLamstone Elite Pro Membership' | escape }}"
              loading="eager"
              fetchpriority="high"
              width="{{ third_image.width | default: 2000 }}"
              height="{{ third_image.height | default: 500 }}"
              class="ai-gif-banner-image-{{ ai_gen_id }} ai-gif-banner-slide-{{ ai_gen_id }} ai-gif-banner-slide-gif-{{ ai_gen_id }}"
            >
          {% endif %}
        </div>
      {% else %}
        <div class="ai-gif-banner-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-gif-banner-empty-state-{{ ai_gen_id }}">
            Next, add a GIF or image
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_overlay %}
        <div class="ai-gif-banner-overlay-{{ ai_gen_id }}"></div>
      {% endif %}

      {% if block.settings.show_content %}
        {% assign has_banner_content = false %}
        {% if block.settings.heading != blank or block.settings.subheading != blank %}
          {% assign has_banner_content = true %}
        {% elsif block.settings.button_text != blank and block.settings.button_link != blank %}
          {% assign has_banner_content = true %}
        {% endif %}
        {% if has_banner_content %}
          <div class="ai-gif-banner-content-{{ ai_gen_id }}">
            {% if block.settings.heading != blank %}
              <h2 class="ai-gif-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.subheading != blank %}
              <p class="ai-gif-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
            {% endif %}

            {% if block.settings.button_text != blank and block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="ai-gif-banner-button-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% if slide_count > 1 %}
  <script>
    (function() {
      function initBannerAlternator() {
        var container = document.querySelector('.ai-gif-banner-{{ ai_gen_id }}');
        if (!container) return;

        if (container.__bannerInterval) {
          clearInterval(container.__bannerInterval);
          container.__bannerInterval = null;
        }

        var gifSlide = container.querySelector('.ai-gif-banner-slide-gif-wrap-{{ ai_gen_id }}') || container.querySelector('.ai-gif-banner-slide-gif-{{ ai_gen_id }}');
        var gifImg = container.querySelector('img.ai-gif-banner-slide-gif-{{ ai_gen_id }}') || container.querySelector('.ai-gif-banner-slide-gif-{{ ai_gen_id }}');
        var bannerSlide = container.querySelector('.ai-gif-banner-slide-banner-{{ ai_gen_id }}');
        var thirdSlide = container.querySelector('.ai-gif-banner-slide-third-{{ ai_gen_id }}');
        var fourthSlide = container.querySelector('.ai-gif-banner-slide-fourth-{{ ai_gen_id }}');

        var slides = [];

        function restartGifElement(img) {
          if (!img) return;
          var rawSrc = img.dataset.src || img.getAttribute('src');
          if (!img.dataset.src) {
            img.dataset.src = rawSrc;
          }
          var base = img.dataset.src;
          var clean = base.replace(/([?&])_t=\d+(&|$)/, function(m, p1, p2) {
            return p2 ? p1 : '';
          }).replace(/[?&]$/, '');
          var sep = clean.indexOf('?') !== -1 ? '&' : '?';
          img.src = clean + sep + '_t=' + Date.now();
        }

        if (gifSlide) {
          slides.push({
            type: 'gif',
            el: gifSlide,
            show: function() {
              restartGifElement(gifImg);
              gifSlide.classList.remove('is-hidden');
            },
            hide: function() {
              gifSlide.classList.add('is-hidden');
            }
          });
        }

        if (bannerSlide) {
          slides.push({
            type: 'banner',
            el: bannerSlide,
            show: function() {
              bannerSlide.classList.add('is-active');
            },
            hide: function() {
              bannerSlide.classList.remove('is-active');
            }
          });
        }

        if (thirdSlide) {
          slides.push({
            type: 'third',
            el: thirdSlide,
            show: function() {
              thirdSlide.classList.add('is-active');
            },
            hide: function() {
              thirdSlide.classList.remove('is-active');
            }
          });
        }

        if (fourthSlide) {
          slides.push({
            type: 'fourth',
            el: fourthSlide,
            show: function() {
              fourthSlide.classList.add('is-active');
            },
            hide: function() {
              fourthSlide.classList.remove('is-active');
            }
          });
        }

        if (slides.length <= 1) return;

        var currentIndex = 0;
        var intervalDuration = {{ slide_interval_s }} * 1000;

        function switchSlide() {
          var prevIndex = currentIndex;
          currentIndex = (currentIndex + 1) % slides.length;

          slides[prevIndex].hide();
          slides[currentIndex].show();
        }

        container.__bannerInterval = setInterval(switchSlide, intervalDuration);

        document.addEventListener('visibilitychange', function() {
          if (document.hidden) {
            if (container.__bannerInterval) {
              clearInterval(container.__bannerInterval);
              container.__bannerInterval = null;
            }
          } else {
            if (container.__bannerInterval) clearInterval(container.__bannerInterval);
            container.__bannerInterval = setInterval(switchSlide, intervalDuration);
          }
        });

        if (window.Shopify && window.Shopify.designMode) {
          document.addEventListener('shopify:section:unload', function(e) {
            if (container && container.closest('#shopify-section-' + e.detail?.sectionId)) {
              if (container.__bannerInterval) {
                clearInterval(container.__bannerInterval);
                container.__bannerInterval = null;
              }
            }
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBannerAlternator);
      } else {
        initBannerAlternator();
      }
    })();
  </script>
{% endif %}

