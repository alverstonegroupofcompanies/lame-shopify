{%- assign line = block.settings.text | strip_html | strip -%}
{%- unless line == blank -%}
  <div
    class="lame-promo-top-bar__caption"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.link != blank -%}
      <a class="lame-promo-top-bar__caption-link" href="{{ block.settings.link }}">
        <span class="lame-promo-top-bar__caption-text">{{ block.settings.text }}</span>
      </a>
    {%- else -%}
      <span class="lame-promo-top-bar__caption-text">{{ block.settings.text }}</span>
    {%- endif -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Promo line",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Caption",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    }
  ]
}
{% endschema %}
