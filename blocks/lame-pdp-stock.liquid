{% liquid
  assign current_product = closest.product | default: product
  assign current_variant = current_product.selected_or_first_available_variant

  assign is_non_physical = false
  if current_product != blank
    if current_variant != blank and current_variant.requires_shipping == false
      assign is_non_physical = true
    elsif current_product.requires_shipping == false
      assign is_non_physical = true
    endif

    for tag in current_product.tags
      assign tag_down = tag | downcase
      if tag_down == 'membership' or tag_down == 'digital' or tag_down contains 'non-physical' or tag_down contains 'no-shipping'
        assign is_non_physical = true
        break
      endif
    endfor

    assign p_handle_down = current_product.handle | downcase
    assign p_title_down = current_product.title | downcase
    if p_handle_down == 'elite-pro-6-months' or p_title_down contains 'elite pro'
      assign is_non_physical = true
    endif

    assign p_type_down = current_product.type | downcase
    if p_type_down == 'membership' or p_type_down == 'digital' or p_type_down contains 'service'
      assign is_non_physical = true
    endif
  endif

  assign variant = current_variant
  assign in_stock = variant.available

  if variant.inventory_management == 'shopify' and variant.inventory_quantity <= 0 and variant.inventory_policy != 'continue'
    assign in_stock = false
  endif
%}

{%- unless is_non_physical -%}
<p
  class="lame-pdp-stock{% unless in_stock %} lame-pdp-stock--out{% endunless %}"
  {{ block.shopify_attributes }}
  role="status"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="lame-pdp-stock__icon">
    {% if in_stock %}
      <circle cx="12" cy="12" r="8" fill="currentColor"/>
    {% else %}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {% endif %}
  </svg>
  <span>
    {% if in_stock %}
      {{ block.settings.in_stock_text | default: 'In stock - Ready to ship' }}
    {% else %}
      {{ block.settings.out_of_stock_text | default: 'Out of stock' }}
    {% endif %}
  </span>
</p>
{%- endunless -%}

{% schema %}
{
  "name": "Stock status",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In stock message",
      "default": "In stock - Ready to ship"
    },
    {
      "type": "text",
      "id": "out_of_stock_text",
      "label": "Out of stock message",
      "default": "Out of stock"
    }
  ],
  "presets": [
    {
      "name": "Stock status",
      "category": "Product"
    }
  ]
}
{% endschema %}
