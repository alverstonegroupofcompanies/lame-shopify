{% doc %}
  @prompt
    Our Products all products display for adding to cart
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-products-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-products-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-products-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-products-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-products-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: calc(100% - 1.3rem);
    margin-inline: 0.65rem;
    margin-top: 0.65rem;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f5f5f5;
    border-radius: {{ block.settings.card_border_radius | times: 0.5 }}px;
  }

  .ai-product-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
  }

  .ai-product-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-card__image-link-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-card__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-card__title-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
  }

  .ai-product-card__title-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.product_title_hover_color }};
  }

  .ai-product-card__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 600;
    font-family: var(--price-font-family);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.03em;
  }

  .ai-product-card__price--compare-{{ ai_gen_id }} {
    text-decoration: line-through;
    opacity: 0.6;
    margin-left: 8px;
    font-size: {{ block.settings.price_size | times: 0.9 }}px;
  }

  .ai-product-card__form-{{ ai_gen_id }} {
    margin-top: auto;
  }

  .ai-product-card__button-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    line-height: 1.2;
  }

  .ai-product-card__button-inner-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  .ai-product-card__button-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-product-card__button-icon-{{ ai_gen_id }} svg {
    width: 1.35em;
    height: 1.35em;
    display: block;
  }

  .ai-product-card__button--display-text-{{ ai_gen_id }} .ai-product-card__button-icon-{{ ai_gen_id }} {
    display: none;
  }

  .ai-product-card__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-card__button-{{ ai_gen_id }}:disabled {
    background-color: {{ block.settings.button_disabled_background }};
    cursor: not-allowed;
    opacity: 0.6;
  }

  .ai-products-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-products-grid__empty-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }
{% endstyle %}

{% liquid
  assign ai_prods_on_collection = false
  if template.name == 'collection' and collection != blank
    assign ai_prods_on_collection = true
    assign ai_prods_list = collection.products
  else
    assign ai_prods_list = collections.all.products
  endif

  assign ai_use_collection_title = block.settings.use_collection_title | default: true
  assign ai_show_header = false
  assign ai_heading_text = ''
  if ai_prods_on_collection and ai_use_collection_title
    assign ai_show_header = true
    assign ai_heading_text = collection.title
  elsif block.settings.heading != blank
    assign ai_show_header = true
    assign ai_heading_text = block.settings.heading
  endif
%}

<products-grid-{{ ai_gen_id }} class="ai-products-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if ai_show_header %}
    <div class="ai-products-grid__header-{{ ai_gen_id }}">
      <h2 class="ai-products-grid__title-{{ ai_gen_id }}">{{ ai_heading_text }}</h2>
    </div>
  {% endif %}

  {% if ai_prods_list.size > 0 %}
    <div class="ai-products-grid__container-{{ ai_gen_id }}">
      {% for product in ai_prods_list limit: block.settings.products_limit %}
        {% liquid
          assign variant = product.selected_or_first_available_variant
          assign card_form_id = 'OurProducts-ProductForm-' | append: product.id | append: '-' | append: block.id
          assign card_form_class = 'ai-product-card__form-' | append: ai_gen_id
          assign atc_display = block.settings.add_to_cart_display | default: 'text'
          assign qty_default = 1
          if variant.quantity_rule.min
            assign qty_default = variant.quantity_rule.min
          endif
          assign button_label_plain = block.settings.button_text | strip_html | strip
          if button_label_plain == blank
            assign button_label_plain = 'Add to cart'
          endif
        %}
        <div class="ai-product-card-{{ ai_gen_id }}" data-product-id="{{ product.id }}">
          <div class="ai-product-card__image-wrapper-{{ ai_gen_id }}">
            <a
              href="{{ product.url }}"
              class="ai-product-card__image-link-{{ ai_gen_id }}"
              aria-label="{{ product.title | escape }}"
            >
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="ai-product-card__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                <div class="ai-product-card__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </a>
          </div>

          <div class="ai-product-card__content-{{ ai_gen_id }}">
            <h3 class="ai-product-card__title-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-product-card__title-link-{{ ai_gen_id }}">
                {{ product.title }}
              </a>
            </h3>

            <div class="ai-product-card__price-{{ ai_gen_id }}">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-card__price--compare-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>

            {% form 'product', product, id: card_form_id, class: card_form_class, data-type: 'add-to-cart-form' %}
              <input type="hidden" name="id" value="{{ variant.id }}">
              <input type="hidden" name="quantity" value="{{ qty_default }}">

              {% if product.available %}
                <button
                  type="submit"
                  class="ai-product-card__button-{{ ai_gen_id }} ai-product-card__button--display-{{ atc_display }}-{{ ai_gen_id }}"
                  {% unless variant.available %}disabled{% endunless %}
                  {% if atc_display == 'icon_only' %}
                    aria-label="{% if variant.available %}{{ button_label_plain | escape }}{% else %}{{ block.settings.sold_out_text | strip_html | strip | escape }}{% endif %}"
                  {% endif %}
                >
                  <span class="ai-product-card__button-inner-{{ ai_gen_id }}">
                    {% if atc_display != 'text' %}
                      <span class="ai-product-card__button-icon-{{ ai_gen_id }}" aria-hidden="true">
                        {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
                      </span>
                    {% endif %}
                    {% if atc_display != 'icon_only' %}
                      <span class="ai-product-card__button-label-{{ ai_gen_id }}">
                        {% if variant.available %}
                          {{ block.settings.button_text }}
                        {% else %}
                          {{ block.settings.sold_out_text }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </span>
                </button>
              {% else %}
                <button
                  type="button"
                  class="ai-product-card__button-{{ ai_gen_id }} ai-product-card__button--display-{{ atc_display }}-{{ ai_gen_id }}"
                  disabled
                  {% if atc_display == 'icon_only' %}
                    aria-label="{{ block.settings.sold_out_text | strip_html | strip | escape }}"
                  {% endif %}
                >
                  <span class="ai-product-card__button-inner-{{ ai_gen_id }}">
                    {% if atc_display != 'text' %}
                      <span class="ai-product-card__button-icon-{{ ai_gen_id }}" aria-hidden="true">
                        {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
                      </span>
                    {% endif %}
                    {% if atc_display != 'icon_only' %}
                      <span class="ai-product-card__button-label-{{ ai_gen_id }}">{{ block.settings.sold_out_text }}</span>
                    {% endif %}
                  </span>
                </button>
              {% endif %}
            {% endform %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-products-grid__empty-{{ ai_gen_id }}">
      {{ 'product-1' | placeholder_svg_tag }}
      {% if ai_prods_on_collection %}
        <p>{{ block.settings.empty_collection_text }}</p>
      {% else %}
        <p>No products available yet. Add products to your store to display them here.</p>
      {% endif %}
    </div>
  {% endif %}
</products-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductsGrid{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.forms = this.querySelectorAll('form[data-type="add-to-cart-form"]');
        this.setupFormHandlers();
      }

      setupFormHandlers() {
        this.forms.forEach((form) => {
          form.addEventListener('submit', this.handleAddToCart.bind(this));
        });
      }

      handleAddToCart(event) {
        event.preventDefault();
        const form = event.target;
        const button = form.querySelector('.ai-product-card__button-{{ ai_gen_id }}');
        if (!button || button.disabled) return;

        const originalInner = button.innerHTML;
        const originalAria = button.getAttribute('aria-label');

        const restoreMarkup = () => {
          button.innerHTML = originalInner;
          if (originalAria != null) {
            button.setAttribute('aria-label', originalAria);
          } else {
            button.removeAttribute('aria-label');
          }
        };

        let labelEl = button.querySelector('.ai-product-card__button-label-{{ ai_gen_id }}');

        button.disabled = true;
        if (labelEl) {
          labelEl.textContent = 'Adding...';
        }
        if (button.hasAttribute('aria-label')) {
          button.setAttribute('aria-label', 'Adding...');
        }

        const formData = new FormData(form);
        const variantId = formData.get('id');
        const qty = Number(formData.get('quantity')) || 1;
        const cardEl = form.closest('.ai-product-card-{{ ai_gen_id }}');
        const productId =
          (cardEl && cardEl.dataset && cardEl.dataset.productId) || '';

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
        })
          .then((response) =>
            response.json().then((data) => ({
              ok: response.ok,
              data,
            }))
          )
          .then(({ ok, data }) => {
            labelEl = button.querySelector('.ai-product-card__button-label-{{ ai_gen_id }}');

            const fail = (msg) => {
              if (labelEl) {
                labelEl.textContent = msg;
              } else if (button.hasAttribute('aria-label')) {
                button.setAttribute('aria-label', msg);
              }
              button.disabled = false;
              setTimeout(() => {
                restoreMarkup();
              }, 2500);
            };

            if (!ok || (data && data.status)) {
              const msg =
                (data && data.description && String(data.description)) ||
                (data && data.message && String(data.message)) ||
                'Could not add to cart';
              fail(msg);
              return;
            }

            if (labelEl) {
              labelEl.textContent = 'Added!';
            }
            if (button.hasAttribute('aria-label')) {
              button.setAttribute('aria-label', 'Added to cart');
            }

            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: data,
                  sourceId: variantId ? String(variantId) : '',
                  data: {
                    source: 'product-form-component',
                    itemCount: qty,
                    productId: productId ? String(productId) : undefined,
                    variantId: variantId ? String(variantId) : undefined,
                  },
                },
              })
            );

            setTimeout(() => {
              button.disabled = false;
              restoreMarkup();
            }, 2000);
          })
          .catch((error) => {
            console.error('Our products add to cart:', error);
            labelEl = button.querySelector('.ai-product-card__button-label-{{ ai_gen_id }}');
            if (labelEl) {
              labelEl.textContent = 'Error – try again';
            }
            if (button.hasAttribute('aria-label')) {
              button.setAttribute('aria-label', 'Error – try again');
            }
            button.disabled = false;
            setTimeout(restoreMarkup, 2000);
          });
      }
    }

    customElements.define('products-grid-{{ ai_gen_id }}', ProductsGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Our products",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products",
      "info": "On collection pages, you can use the collection name instead (see below)."
    },
    {
      "type": "checkbox",
      "id": "use_collection_title",
      "label": "On collection pages, use collection name as heading",
      "default": true,
      "info": "Lists only that collection’s products (e.g. Wellness). Turn off to always use the heading above."
    },
    {
      "type": "inline_richtext",
      "id": "empty_collection_text",
      "label": "Empty collection message",
      "default": "No products to show. They may be out of stock or not published to this collection."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Number of products",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 12
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "inline_richtext",
      "id": "sold_out_text",
      "label": "Sold out text",
      "default": "Sold Out"
    },
    {
      "type": "select",
      "id": "add_to_cart_display",
      "label": "Add to cart display",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "icon_only",
          "label": "Icon only"
        },
        {
          "value": "text_and_icon",
          "label": "Text and icon"
        }
      ],
      "default": "text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 8,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Product card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
