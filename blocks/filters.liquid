    position: sticky;
    bottom: 0;
    z-index: var(--facets-sticky-z-index);
    order: 1;
    display: flex;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--gap-sm);
    padding-block-start: var(--padding-xs);
    padding-block-end: var(--padding-md);
    padding-inline: var(--padding-lg);
    margin-top: auto;
    background-image: var(--to-top-gradient-background);
    background-color: var(--color-background);
  }

  /* Clear all button */
  .facets__clear-all {
    display: none;
    cursor: pointer;
    min-width: var(--facets-clear-all-min-width);
    flex-grow: 1;
    padding-block: var(--padding-lg);
    color: var(--button-color, inherit);
  }

  .facets__clear-all--active {
    display: block;
    opacity: 1;
    transform: translateY(0);
    transition: transform var(--animation-values), opacity var(--animation-values);
  }

  @starting-style {
    .facets__clear-all--active {
      opacity: 0;
      transform: translateY(100%);
    }
  }

  .facets__see-results {
    min-width: var(--facets-see-results-min-width);
    flex-grow: 1;
    padding-block: var(--padding-lg);
  }

  .facets-horizontal-remove {
    display: flex;
    align-items: center;
  }

  .facets-horizontal-remove--active::before {
    content: '';
    border-inline-start: var(--style-border-width) solid var(--color-border);
    height: var(--font-paragraph--size);
    position: absolute;
  }

  /* Collection page: vertical facet column + full-width grid alignment */
  @media screen and (min-width: 750px) {
    .collection-wrapper:has(.facets-block-wrapper--vertical:not(.hidden)) .facets-block-wrapper--vertical:not(#filters-drawer):not(.hidden) {
      position: sticky;
      top: calc(var(--header-height, 72px) + 12px);
      align-self: start;
      max-height: calc(100vh - var(--header-height, 72px) - 24px);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    /* Our Products: sticky is on .lame-op-page__sidebar (heading + filters) — no scroll box */
    .lame-op-page__sidebar .facets-block-wrapper--vertical:not(#filters-drawer):not(.hidden) {
      position: static;
      top: auto;
      max-height: none;
      overflow: visible;
    }

    .lame-op-page__sidebar {
      max-height: none;
      overflow: visible;
    }

    .collection-wrapper:has(.facets-block-wrapper--vertical) .facets.facets-controls-wrapper.facets--horizontal {
      justify-content: flex-end;
      gap: var(--gap-md);
    }

    .facets--vertical .facets__filters-wrapper > accordion-custom:first-of-type .sorting-filter::before {
      content: none;
      border: none;
      display: none;
    }
  }

  /* Collection: professional vertical filters — sans labels, tighter rhythm, usable price fields */
  .template-collection .facets-controls-wrapper.facets--horizontal,
  .template-collection .facets--vertical {
    font-family: var(--font-body--family);
  }

  .template-collection .facets--vertical .facets__label,
  .template-collection .facets--vertical .facets__summary,
  .template-collection .facets--vertical .sorting-filter__label,
  .template-collection .facets--vertical .sorting-filter__select {
    font-family: var(--font-body--family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    color: rgb(var(--color-foreground-rgb) / 0.92);
  }

  .template-collection .facets--vertical .facets__inputs {
    gap: var(--padding-sm);
  }

  .template-collection .facets--vertical .facets__summary {
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }

  .template-collection .facets--vertical .price-facet__input,
  .template-collection .facets--vertical .field.price-facet__field .field__input {
    min-height: 2.625rem;
    padding-block: 0.45rem;
    border-radius: 10px;
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 0.875rem;
  }

  .template-collection .facets--vertical .facets__inputs-wrapper--row {
    max-width: 100%;
  }

  .template-collection .facets--vertical .price-facet__highest-price {
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    line-height: 1.45;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    margin-top: 0.4rem;
  }
{% endstylesheet %}

{% schema %}
{
