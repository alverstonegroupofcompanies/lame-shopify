{% if block.settings.text != blank %}
  <p class="lame-pdp-trusted-by" {{ block.shopify_attributes }}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="lame-pdp-trusted-by__icon">
      <path d="M12 3 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-3Z" stroke="currentColor" stroke-width="1.35"/>
      <path d="M9 12.5 11 15l5-5.5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    </svg>
    <span>{{ block.settings.text }}</span>
  </p>
{% endif %}

{% schema %}
{
  "name": "Trusted by line",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Trusted by 10,000+ women across India"
    }
  ],
  "presets": [
    {
      "name": "Trusted by line",
      "category": "Product"
    }
  ]
}
{% endschema %}
