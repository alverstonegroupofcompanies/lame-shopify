{% doc %}
  @prompt
    add a neat shop by category section, 7 cards image only, auto slide one row, image should have rectangle shape also not too small big size miimum 450px card width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    overflow: hidden;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-carousel__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-category-carousel__header-{{ ai_gen_id }} .lame-section-heading__title {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__header-{{ ai_gen_id }} .lame-section-heading__title {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }
  }

  .ai-category-carousel__track-wrapper-{{ ai_gen_id }} {
    overflow: hidden;
    position: relative;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 1.65rem;
    height: 1.65rem;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border: 1px solid rgb(0 0 0 / 0.08);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.88);
    color: #111;
    cursor: pointer;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
    transition: opacity 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }}:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.96);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.12);
  }

  .ai-category-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} .svg-wrapper,
  .ai-category-carousel__nav-{{ ai_gen_id }} .svg-wrapper svg {
    width: 0.75rem;
    height: 0.75rem;
    display: block;
  }

  .ai-category-carousel__nav--prev-{{ ai_gen_id }} {
    left: 0.5rem;
  }

  .ai-category-carousel__nav--next-{{ ai_gen_id }} {
    right: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__nav-{{ ai_gen_id }} {
      width: 1.4rem;
      height: 1.4rem;
    }

    .ai-category-carousel__nav-{{ ai_gen_id }} .svg-wrapper,
    .ai-category-carousel__nav-{{ ai_gen_id }} .svg-wrapper svg {
      width: 0.65rem;
      height: 0.65rem;
    }

    .ai-category-carousel__nav--prev-{{ ai_gen_id }} {
      left: 0.25rem;
    }

    .ai-category-carousel__nav--next-{{ ai_gen_id }} {
      right: 0.25rem;
    }
  }

  .ai-category-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    min-width: {{ block.settings.card_width }}px;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-category-carousel__card-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.card_height }}px;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-category-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
    color: #ffffff;
    text-align: center;
  }

  .ai-category-carousel__title-{{ ai_gen_id }} {
    font-size: max(14px, {{ block.settings.card_title_size }}px);
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.6);
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 calc({{ block.settings.card_width }}px * 0.7);
      min-width: calc({{ block.settings.card_width }}px * 0.7);
    }

    .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
      height: calc({{ block.settings.card_height }}px * 0.7);
    }

  }
{% endstyle %}

<category-carousel-{{ ai_gen_id }} class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-category-carousel__header-{{ ai_gen_id }}">
        {% render 'lame-section-heading',
          title: block.settings.heading,
          alignment: block.settings.heading_alignment,
          size: 'large'
        %}
      </div>
    {% endif %}

    <div class="ai-category-carousel__track-wrapper-{{ ai_gen_id }}">
      {% unless block.settings.show_navigation_arrows == false %}
        <button
          type="button"
          class="ai-category-carousel__nav-{{ ai_gen_id }} ai-category-carousel__nav--prev-{{ ai_gen_id }} flip-x"
          aria-label="Previous categories"
          data-ai-carousel-prev
        >
          <span class="svg-wrapper icon-arrow">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </button>
        <button
          type="button"
          class="ai-category-carousel__nav-{{ ai_gen_id }} ai-category-carousel__nav--next-{{ ai_gen_id }}"
          aria-label="Next categories"
          data-ai-carousel-next
        >
          <span class="svg-wrapper icon-arrow">
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </span>
        </button>
      {% endunless %}
      <div class="ai-category-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..7) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign collection = block.settings[collection_key]
          %}

          <div class="ai-category-carousel__card-{{ ai_gen_id }}">
            {% if collection != blank %}
              <a href="{{ collection.url }}" class="ai-category-carousel__card-link-{{ ai_gen_id }}">
                <div class="ai-category-carousel__image-wrapper-{{ ai_gen_id }}">
                  {% if collection.image %}
                    <img
                      src="{{ collection.image | image_url: width: 800 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-category-carousel__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="600"
                    >
                  {% elsif collection.products.first and collection.products.first.featured_image %}
                    <img
                      src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                      alt="{{ collection.title | escape }}"
                      class="ai-category-carousel__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="800"
                      height="600"
                    >
                  {% else %}
                    <div class="ai-category-carousel__placeholder-{{ ai_gen_id }}">
                      {{ 'collection-apparel-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                  <div class="ai-category-carousel__overlay-{{ ai_gen_id }}">
                    <h3 class="ai-category-carousel__title-{{ ai_gen_id }}">{{ collection.title }}</h3>
                  </div>
                </div>
              </a>
            {% else %}
              <div class="ai-category-carousel__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-category-carousel__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
                <div class="ai-category-carousel__overlay-{{ ai_gen_id }}">
                  <h3 class="ai-category-carousel__title-{{ ai_gen_id }}">Category {{ i }}</h3>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</category-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-category-carousel__track-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-category-carousel__card-{{ ai_gen_id }}');
        this.currentIndex = 0;
        this.autoSlideInterval = null;
        this.autoSlideDelay = {{ block.settings.auto_slide_speed | times: 1000 }};
      }

      connectedCallback() {
        if (this.cards.length > 0) {
          this.cloneCards();
          this.startAutoSlide();
          this.setupHoverPause();
          this.setupNavButtons();
        }
      }

      setupNavButtons() {
        const prev = this.querySelector('[data-ai-carousel-prev]');
        const next = this.querySelector('[data-ai-carousel-next]');
        if (prev) {
          prev.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.slidePrev();
            this.restartAutoSlide();
          });
        }
        if (next) {
          next.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            this.slideNext();
            this.restartAutoSlide();
          });
        }
      }

      restartAutoSlide() {
        this.stopAutoSlide();
        this.startAutoSlide();
      }

      stepPx() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        return cardWidth + gap;
      }

      slidePrev() {
        if (this.cards.length === 0) return;
        if (this.currentIndex <= 0) {
          this.currentIndex = this.cards.length - 1;
        } else {
          this.currentIndex--;
        }
        const offset = this.stepPx() * this.currentIndex;
        this.track.style.transition = 'transform 0.5s ease';
        this.track.style.transform = `translateX(-${offset}px)`;
      }

      cloneCards() {
        const cardsArray = Array.from(this.cards);
        cardsArray.forEach(card => {
          const clone = card.cloneNode(true);
          this.track.appendChild(clone);
        });
      }

      startAutoSlide() {
        this.autoSlideInterval = setInterval(() => {
          this.slideNext();
        }, this.autoSlideDelay);
      }

      stopAutoSlide() {
        if (this.autoSlideInterval) {
          clearInterval(this.autoSlideInterval);
          this.autoSlideInterval = null;
        }
      }

      setupHoverPause() {
        this.addEventListener('mouseenter', () => {
          this.stopAutoSlide();
        });

        this.addEventListener('mouseleave', () => {
          this.startAutoSlide();
        });
      }

      slideNext() {
        this.currentIndex++;
        const offset = this.stepPx() * this.currentIndex;
        this.track.style.transition = 'transform 0.5s ease';
        this.track.style.transform = `translateX(-${offset}px)`;

        if (this.currentIndex >= this.cards.length) {
          setTimeout(() => {
            this.track.style.transition = 'none';
            this.currentIndex = 0;
            this.track.style.transform = 'translateX(0)';
            setTimeout(() => {
              this.track.style.transition = 'transform 0.5s ease';
            }, 50);
          }, 500);
        }
      }

      disconnectedCallback() {
        this.stopAutoSlide();
      }
    }

    customElements.define('category-carousel-{{ ai_gen_id }}', CategoryCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Shop by category",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
