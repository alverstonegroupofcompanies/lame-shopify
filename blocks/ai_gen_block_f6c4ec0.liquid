{% doc %}
  Shop by category — compact looping collection cards.
  Mobile: peek carousel. Tablet: ~2 cards. Desktop: ~4–5 cards.
{% enddoc %}
{% liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign category_count = 0
  for i in (1..7)
    assign collection_key = 'collection_' | append: i
    if block.settings[collection_key] != blank
      assign category_count = category_count | plus: 1
    endif
  endfor
  if category_count == 0
    assign category_count = 7
  endif
  assign auto_slide_speed = block.settings.auto_slide_speed | default: 4
  assign show_arrows = block.settings.show_navigation_arrows
%}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    --ai-category-gap: {{ block.settings.card_gap }}px;
    --ai-category-radius: {{ block.settings.card_border_radius }}px;
    --ai-category-card-w: min(72vw, 14.5rem);
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    margin-inline: auto;
    padding: clamp(0.85rem, 1.8vw, 1.35rem) 0;
    background-color: {{ block.settings.background_color }};
    box-sizing: border-box;
  }

  .ai-category-carousel__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    padding-inline: clamp(0.75rem, 2.5vw, 1.25rem);
    box-sizing: border-box;
  }

  .ai-category-carousel__header-{{ ai_gen_id }} {
    margin-bottom: clamp(0.7rem, 1.4vw, 1.1rem);
  }

  .ai-category-carousel__header-{{ ai_gen_id }} .lame-section-heading__title {
    font-size: clamp(1.15rem, 2.2vw, {{ block.settings.heading_size }}px);
    color: {{ block.settings.heading_color }};
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .ai-category-carousel__viewport-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-category-carousel__scroller-{{ ai_gen_id }} {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-category-carousel__scroller-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-category-carousel__track-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--ai-category-gap);
    width: max-content;
    padding-bottom: 0.15rem;
  }

  .ai-category-carousel__card-{{ ai_gen_id }} {
    flex: 0 0 var(--ai-category-card-w);
    width: var(--ai-category-card-w);
    max-width: var(--ai-category-card-w);
    min-width: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--ai-category-radius);
    border: 1px solid rgb(42 58 48 / 0.14);
    background: #fff;
    scroll-snap-align: start;
    box-shadow: 0 6px 16px rgb(26 22 20 / 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ai-category-carousel__card-{{ ai_gen_id }}:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 22px rgb(26 22 20 / 0.1);
    }
  }

  .ai-category-carousel__card-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 9.5rem;
    overflow: hidden;
    background: rgb(42 58 48 / 0.04);
  }

  .ai-category-carousel__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 55%;
    height: 55%;
    opacity: 0.3;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    z-index: 2;
    transform: translateY(-50%);
    width: 2.1rem;
    height: 2.1rem;
    border: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.95);
    color: #1a1614;
    box-shadow: 0 4px 14px rgb(26 22 20 / 0.14);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }} svg {
    width: 0.85rem;
    height: 0.85rem;
    display: block;
  }

  .ai-category-carousel__nav--prev-{{ ai_gen_id }} {
    left: 0.15rem;
  }

  .ai-category-carousel__nav--next-{{ ai_gen_id }} {
    right: 0.15rem;
  }

  .ai-category-carousel__nav-{{ ai_gen_id }}:hover {
    background: #fff;
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel-{{ ai_gen_id }} {
      --ai-category-gap: 0.65rem;
      --ai-category-card-w: min(70vw, 14rem);
    }

    .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
      max-height: 8.75rem;
    }

    .ai-category-carousel__nav-{{ ai_gen_id }} {
      display: none;
    }
  }

  /* Medium: two compact cards, never full-bleed */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ai-category-carousel-{{ ai_gen_id }} {
      --ai-category-gap: 0.75rem;
      --ai-category-card-w: min(42vw, 17rem);
    }

    .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
      max-height: 10rem;
    }
  }

  /* Desktop: compact cards, ~4–5 visible */
  @media screen and (min-width: 990px) {
    .ai-category-carousel-{{ ai_gen_id }} {
      --ai-category-gap: 0.85rem;
      --ai-category-card-w: min(14.5rem, 18.5vw);
    }

    .ai-category-carousel__container-{{ ai_gen_id }} {
      padding-inline: 0;
    }

    .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
      max-height: 11rem;
      aspect-ratio: 5 / 4;
    }
  }

  @media screen and (min-width: 1200px) {
    .ai-category-carousel-{{ ai_gen_id }} {
      --ai-category-card-w: min(13.75rem, 16vw);
    }

    .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
      max-height: 11.5rem;
    }
  }
{% endstyle %}

<div
  class="ai-category-carousel-{{ ai_gen_id }}"
  data-ai-category-carousel
  data-auto-slide-speed="{{ auto_slide_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-category-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-category-carousel__header-{{ ai_gen_id }}">
        {% render 'lame-section-heading',
          title: block.settings.heading,
          alignment: block.settings.heading_alignment,
          size: 'large'
        %}
      </div>
    {% endif %}

    <div class="ai-category-carousel__viewport-{{ ai_gen_id }}">
      {% if show_arrows %}
        <button
          type="button"
          class="ai-category-carousel__nav-{{ ai_gen_id }} ai-category-carousel__nav--prev-{{ ai_gen_id }}"
          data-ai-category-prev
          aria-label="Previous categories"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button
          type="button"
          class="ai-category-carousel__nav-{{ ai_gen_id }} ai-category-carousel__nav--next-{{ ai_gen_id }}"
          data-ai-category-next
          aria-label="Next categories"
        >
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}

      <div class="ai-category-carousel__scroller-{{ ai_gen_id }}" data-ai-category-scroller>
        <div class="ai-category-carousel__track-{{ ai_gen_id }}" data-ai-category-track>
          {% for i in (1..7) %}
            {% liquid
              assign collection_key = 'collection_' | append: i
              assign collection = block.settings[collection_key]
            %}
            {% if collection != blank %}
              <div class="ai-category-carousel__card-{{ ai_gen_id }}" data-ai-category-card>
                <a href="{{ collection.url }}" class="ai-category-carousel__card-link-{{ ai_gen_id }}">
                  <div class="ai-category-carousel__image-wrapper-{{ ai_gen_id }}">
                    {% if collection.image %}
                      <img
                        src="{{ collection.image | image_url: width: 640 }}"
                        alt="{{ collection.title | escape }}"
                        class="ai-category-carousel__image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="640"
                        height="480"
                      >
                    {% elsif collection.products.first and collection.products.first.featured_image %}
                      <img
                        src="{{ collection.products.first.featured_image | image_url: width: 640 }}"
                        alt="{{ collection.title | escape }}"
                        class="ai-category-carousel__image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="640"
                        height="480"
                      >
                    {% else %}
                      <div class="ai-category-carousel__placeholder-{{ ai_gen_id }}">
                        {{ 'collection-apparel-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                </a>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-ai-category-carousel')) {
      root = document.querySelector('.ai-category-carousel-{{ ai_gen_id }}[data-ai-category-carousel]');
    }
    if (!root) return;

    var track = root.querySelector('[data-ai-category-track]');
    var scroller = root.querySelector('[data-ai-category-scroller]');
    if (!track || !scroller) return;

    var cards = Array.prototype.slice.call(track.querySelectorAll('[data-ai-category-card]:not([data-clone])'));
    if (cards.length < 2) {
      cards = Array.prototype.slice.call(track.querySelectorAll('[data-ai-category-card]'));
    }
    if (cards.length < 2) return;

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var autoplayMs = Math.max(2, parseInt(root.getAttribute('data-auto-slide-speed') || '4', 10)) * 1000;
    var timer = null;
    var looping = false;
    var prevBtn = root.querySelector('[data-ai-category-prev]');
    var nextBtn = root.querySelector('[data-ai-category-next]');

    function clearClones() {
      track.querySelectorAll('[data-clone="true"]').forEach(function (node) {
        node.remove();
      });
    }

    function cloneForLoop() {
      clearClones();
      cards.forEach(function (card) {
        var clone = card.cloneNode(true);
        clone.setAttribute('data-clone', 'true');
        clone.setAttribute('aria-hidden', 'true');
        track.appendChild(clone);
      });
    }

    function cardStep() {
      var first = track.querySelector('[data-ai-category-card]');
      if (!first) return 0;
      var style = window.getComputedStyle(track);
      var gap = parseFloat(style.columnGap || style.gap || '0') || 0;
      return first.getBoundingClientRect().width + gap;
    }

    function normalizeLoop() {
      if (looping) return;
      var step = cardStep();
      if (!step) return;
      var max = step * cards.length;
      if (scroller.scrollLeft >= max - 2) {
        looping = true;
        scroller.scrollLeft = scroller.scrollLeft - max;
        requestAnimationFrame(function () {
          looping = false;
        });
      }
    }

    function advance(dir) {
      var step = cardStep();
      if (!step) return;
      scroller.scrollBy({ left: step * (dir || 1), behavior: 'smooth' });
    }

    function startAutoplay() {
      stopAutoplay();
      if (reduceMotion) return;
      timer = window.setInterval(function () {
        if (!document.hidden) advance(1);
      }, autoplayMs);
    }

    function stopAutoplay() {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    }

    cloneForLoop();
    scroller.addEventListener('scroll', normalizeLoop, { passive: true });
    scroller.addEventListener('pointerenter', stopAutoplay);
    scroller.addEventListener('pointerleave', startAutoplay);
    scroller.addEventListener('touchstart', stopAutoplay, { passive: true });
    scroller.addEventListener('touchend', startAutoplay, { passive: true });

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        stopAutoplay();
        advance(-1);
        startAutoplay();
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        stopAutoplay();
        advance(1);
        startAutoplay();
      });
    }

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });
    window.addEventListener('resize', normalizeLoop);
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "Shop by category",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    { "type": "collection", "id": "collection_1", "label": "Collection 1" },
    { "type": "collection", "id": "collection_2", "label": "Collection 2" },
    { "type": "collection", "id": "collection_3", "label": "Collection 3" },
    { "type": "collection", "id": "collection_4", "label": "Collection 4" },
    { "type": "collection", "id": "collection_5", "label": "Collection 5" },
    { "type": "collection", "id": "collection_6", "label": "Collection 6" },
    { "type": "collection", "id": "collection_7", "label": "Collection 7" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (unused — responsive)",
      "min": 450,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (unused — aspect ratio used)",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 350
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "label": "Auto-slide every",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_navigation_arrows",
      "label": "Show previous / next arrows",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1614"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Shop by category"
    }
  ]
}
{% endschema %}
