{% doc %}
  Shop by category — responsive grid of collection cards.
  Desktop/tablet: all cards in one scalable row.
  Mobile: 2 cards per row.
{% enddoc %}
{% liquid
  assign ai_gen_id = block.id | replace: '_', '' | downcase
  assign category_count = 0
  for i in (1..7)
    assign collection_key = 'collection_' | append: i
    if block.settings[collection_key] != blank
      assign category_count = category_count | plus: 1
    endif
  endfor
  if category_count == 0
    assign category_count = 7
  endif
%}

{% style %}
  .ai-category-carousel-{{ ai_gen_id }} {
    --ai-category-gap: {{ block.settings.card_gap }}px;
    --ai-category-cols: {{ category_count }};
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
    margin-inline: auto;
    padding: clamp(1.25rem, 2.5vw, 2rem) 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-category-carousel__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-category-carousel__header-{{ ai_gen_id }} .lame-section-heading__title {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__header-{{ ai_gen_id }} .lame-section-heading__title {
      font-size: calc({{ block.settings.heading_size }}px * 0.75);
    }
  }

  .ai-category-carousel__track-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ai-category-gap);
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-category-carousel__track-{{ ai_gen_id }} {
      grid-template-columns: repeat(var(--ai-category-cols), minmax(0, 1fr));
    }
  }

  .ai-category-carousel__card-{{ ai_gen_id }} {
    min-width: 0;
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid rgb(42 58 48 / 0.22);
    transition: transform 0.3s ease;
  }

  .ai-category-carousel__card-{{ ai_gen_id }}:hover {
    transform: translateY(-3px);
  }

  .ai-category-carousel__card-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-category-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: rgb(42 58 48 / 0.04);
  }

  .ai-category-carousel__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
  }

  .ai-category-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(6px, 1vw, 12px);
    display: flex;
    justify-content: flex-start;
    pointer-events: none;
  }

  .ai-category-carousel__cta-{{ ai_gen_id }} {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: clamp(0.22rem, 0.55vw, 0.35rem) clamp(0.4rem, 0.9vw, 0.6rem);
    border-radius: 999px;
    background: var(--lame-cta-bg-gradient, linear-gradient(135deg, #ff7043 0%, #ff5722 48%, #f4511e 100%));
    border: 1px solid var(--lame-cta-bg, #ff5722);
    color: #fff;
    font-size: clamp(0.5rem, 0.85vw, 0.7rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    box-shadow: var(--lame-cta-shadow, 0 6px 18px rgb(255 87 34 / 0.35));
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    max-width: calc(100% - 4px);
    white-space: nowrap;
  }

  .ai-category-carousel__cta-{{ ai_gen_id }} .svg-wrapper,
  .ai-category-carousel__cta-{{ ai_gen_id }} .svg-wrapper svg {
    width: clamp(0.45rem, 0.8vw, 0.75rem);
    height: clamp(0.45rem, 0.8vw, 0.75rem);
    display: block;
    flex-shrink: 0;
  }

  .ai-category-carousel__card-link-{{ ai_gen_id }}:hover .ai-category-carousel__cta-{{ ai_gen_id }} {
    background: linear-gradient(135deg, #ff8a65 0%, var(--lame-cta-bg-hover, #e64a19) 100%);
    border-color: var(--lame-cta-bg-hover, #e64a19);
  }

  @media screen and (max-width: 749px) {
    .ai-category-carousel__overlay-{{ ai_gen_id }} {
      padding: 10px 12px;
    }

    .ai-category-carousel__cta-{{ ai_gen_id }} {
      padding: 0.35rem 0.55rem;
      font-size: clamp(0.58rem, 2.6vw, 0.7rem);
      letter-spacing: 0.05em;
      box-shadow: 0 4px 12px rgb(0 0 0 / 0.12);
    }

    .ai-category-carousel__cta-{{ ai_gen_id }} .svg-wrapper,
    .ai-category-carousel__cta-{{ ai_gen_id }} .svg-wrapper svg {
      width: 0.65rem;
      height: 0.65rem;
    }
  }
{% endstyle %}

<div class="ai-category-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-category-carousel__header-{{ ai_gen_id }}">
        {% render 'lame-section-heading',
          title: block.settings.heading,
          alignment: block.settings.heading_alignment,
          size: 'large'
        %}
      </div>
    {% endif %}

    <div class="ai-category-carousel__track-{{ ai_gen_id }}">
      {% for i in (1..7) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
        %}
        {% if collection != blank %}
          <div class="ai-category-carousel__card-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-category-carousel__card-link-{{ ai_gen_id }}">
              <div class="ai-category-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if collection.image %}
                  <img
                    src="{{ collection.image | image_url: width: 800 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-category-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="600"
                  >
                {% elsif collection.products.first and collection.products.first.featured_image %}
                  <img
                    src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                    alt="{{ collection.title | escape }}"
                    class="ai-category-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="800"
                    height="600"
                  >
                {% else %}
                  <div class="ai-category-carousel__placeholder-{{ ai_gen_id }}">
                    {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
                <div class="ai-category-carousel__overlay-{{ ai_gen_id }}" aria-hidden="true">
                  <span class="ai-category-carousel__cta-{{ ai_gen_id }}">
                    Shop now
                    <span class="svg-wrapper icon-arrow">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  </span>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "collection",
      "id": "collection_6",
      "label": "Collection 6"
    },
    {
      "type": "collection",
      "id": "collection_7",
      "label": "Collection 7"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width (unused — cards scale to row)",
      "min": 450,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 450
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card height (unused — aspect ratio used)",
      "min": 300,
      "max": 600,
      "step": 50,
      "unit": "px",
      "default": 350
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card spacing",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Legacy carousel (unused)"
    },
    {
      "type": "range",
      "id": "auto_slide_speed",
      "label": "Slide speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_navigation_arrows",
      "label": "Show previous / next arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title size",
      "min": 12,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Shop by category"
    }
  ]
}
{% endschema %}
