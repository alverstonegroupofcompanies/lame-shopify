{% capture _lame_op_discard %}
  {% liquid
    assign lame_our_products_active = false
    if template.name == 'collection' and collection != blank
      if template.suffix == 'our-products'
        assign lame_our_products_active = true
      endif
      if collection.handle == 'all' or collection.handle == 'our-products' or collection.handle == 'products'
        assign lame_our_products_active = true
      endif
      if lame_our_products_active == false and section.settings.use_our_products_layout
        assign lame_our_products_active = true
      endif
      if lame_our_products_active == false
        assign lame_handles_raw = settings.lame_our_products_collection_handles | default: 'all,our-products,products'
        assign lame_handles = lame_handles_raw | split: ','
        for lame_handle_part in lame_handles
          assign lame_handle_trim = lame_handle_part | strip
          if lame_handle_trim != blank and collection.handle == lame_handle_trim
            assign lame_our_products_active = true
            break
          endif
        endfor
      endif
    endif
  %}
{% endcapture %}
{% liquid
  assign product = closest.product

  assign card_show_quick_add = false
  if lame_our_products_active
    assign card_show_quick_add = false
  elsif settings.quick_add or settings.mobile_quick_add
    assign card_show_quick_add = true
  endif

  assign lame_show_wishlist = false
  if settings.lame_enable_wishlist and lame_our_products_active and section.settings.show_wishlist and product != blank
    assign lame_show_wishlist = true
  endif

  assign lame_wl_image = ''
  assign lame_wl_price = ''
  if lame_show_wishlist and product != blank
    if product.featured_media
      assign lame_wl_image = product.featured_media.preview_image | image_url: width: 480
    endif
    assign lame_wl_price = product.price_min | money
  endif

  assign card_has_badge = false
  unless product == blank
    if product.available == false or product.compare_at_price > product.price
      assign card_has_badge = true
    endif
  endunless
%}

{% capture children %}
  {% unless product == blank %}
    {% if card_has_badge %}
      <div
        class="product-badges product-badges--{{ settings.badge_position }}"
        style="
          --badge-border-radius: {{ settings.badge_corner_radius }}px;
          --badge-font-family: var(--font-{{ settings.badge_font_family }}--family);
          --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight);
          --badge-text-transform: {{ settings.badge_text_transform }};
        "
      >
        <div
          class="
            product-badges__badge product-badges__badge--rectangle
            {% if product.available == false %} color-{{ settings.badge_sold_out_color_scheme }}{% else %} color-{{ settings.badge_sale_color_scheme }}{% endif %}
          "
        >
          {%- if product.available == false -%}
            {{ 'content.product_badge_sold_out' | t }}
          {%- else -%}
            {{ 'content.product_badge_sale' | t }}
          {%- endif -%}
        </div>
      </div>
    {% endif %}

    {% if card_show_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}

    {% if lame_show_wishlist %}
      <div class="product-card-gallery__corner-tr">
        <button
          type="button"
          class="lame-wishlist-toggle product-card-gallery__wishlist-btn"
          aria-label="{{ 'lame_wishlist.toggle' | t }}"
          aria-pressed="false"
          data-lame-wishlist-toggle
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          data-product-url="{{ product.url }}"
          data-product-title="{{ product.title | escape }}"
          data-product-image="{{ lame_wl_image }}"
          data-product-price="{{ lame_wl_price | escape }}"
        >
          <span class="lame-wishlist-toggle__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" focusable="false">
              <path
                class="lame-wishlist-toggle__outline"
                d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
                fill-rule="evenodd"
                stroke="currentColor"
                stroke-width="1.35"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        </button>
      </div>
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% comment %} Zoomed-out grid preview strip {% endcomment %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">{{ 'content.product_card_placeholder' | t }}</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% stylesheet %}
  .product-card-gallery__corner-tr {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    z-index: calc(var(--layer-raised, 2) + 2);
    pointer-events: auto;
  }

  .product-card-gallery__wishlist-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    background: rgb(var(--color-background-rgb) / 0.9);
    color: rgb(var(--color-foreground-rgb) / 0.5);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.08);
    backdrop-filter: blur(10px);
    transition:
      transform 0.25s ease,
      color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .product-card-gallery__wishlist-btn:hover {
    transform: scale(1.05);
    color: rgb(var(--color-primary-rgb));
  }

  .product-card-gallery__wishlist-btn.is-active {
    color: rgb(var(--color-primary-rgb));
  }

  .product-card-gallery__wishlist-btn.is-active .lame-wishlist-toggle__outline {
    fill: rgb(var(--color-primary-rgb));
    stroke: rgb(var(--color-primary-rgb));
  }
{% endstylesheet %}

