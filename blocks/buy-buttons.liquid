
{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = closest.product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy

  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  assign can_add_to_cart = false
  assign add_to_cart_text = 'products.product.unavailable' | t

  if variant
    if variant.quantity_rule.min > variant.inventory_quantity and inventory_managed and inventory_policy == 'deny'
      assign quantity_rule_soldout = true
    endif

    if variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'products.product.add_to_cart' | t
    elsif inventory_managed and inventory_quantity <= 0 and inventory_policy == 'deny' or quantity_rule_soldout
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.sold_out' | t
    else
      assign can_add_to_cart = false
      assign add_to_cart_text = 'products.product.unavailable' | t
    endif
  endif

  capture lame_our_products_active_capture
    render 'lame-our-products-active', section: section
  endcapture
  assign lame_our_products_active = false
  if lame_our_products_active_capture contains 'true'
    assign lame_our_products_active = true
  endif

  assign is_elite_pro = false
  if product != blank
    assign p_handle_down = product.handle | downcase
    assign p_title_down = product.title | downcase
    if p_handle_down == 'elite-pro-6-months' or p_title_down contains 'elite pro'
      assign is_elite_pro = true
    endif
  endif

  assign elite_in_cart = false
  if is_elite_pro
    for item in cart.items
      assign item_h = item.product.handle | downcase
      assign item_t = item.product.title | downcase
      if item_h == 'elite-pro-6-months' or item_t contains 'elite pro'
        assign elite_in_cart = true
        break
      endif
    endfor
  endif

  if is_elite_pro and elite_in_cart
    assign can_add_to_cart = false
    assign add_to_cart_text = 'Already in cart'
  endif
%}

<span
  class="buy-buttons-block buy-buttons-block--{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
        {%- comment -%} Unique per product (and section) so multiple cards on collection grids do not duplicate form IDs {%- endcomment -%}
        {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id | append: '-' | append: product.id -%}
        {%- capture lame_bogo_qty -%}{% render 'lame-bogo-add-qty', product: product %}{%- endcapture -%}
        {%- assign lame_bogo_qty = lame_bogo_qty | strip | plus: 0 -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="{% if is_elite_pro %}1{% elsif lame_bogo_qty > 1 %}{{ lame_bogo_qty }}{% elsif product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
      data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        {%- if is_elite_pro -%}
          <input type="hidden" name="quantity" value="1">
        {%- endif -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section, block: block -%}
          <span class="buy-buttons-block__bar">
        {%- endif -%}
        {%- if is_elite_pro -%}
          <div class="elite-pro-birthday-field">
            <label
              for="EliteProBirthday-{{ section.id }}-{{ product.id }}"
              class="elite-pro-birthday-field__label"
            >
              Birthday <span class="elite-pro-birthday-field__required" aria-hidden="true">*</span>
            </label>
            <div class="elite-pro-birthday-field__input-wrapper">
              <input
                type="date"
                id="EliteProBirthday-{{ section.id }}-{{ product.id }}"
                name="properties[Birthday]"
                required
                max="{{ 'now' | date: '%Y-%m-%d' }}"
                class="elite-pro-birthday-field__input"
                {% if elite_in_cart %}disabled{% endif %}
              >
            </div>
            <p
              id="EliteProBirthdayError-{{ section.id }}-{{ product.id }}"
              class="elite-pro-birthday-error"
              style="margin: 6px 0 0; font-size: 13px; font-weight: 600; color: #dc2626; display: none;"
              role="alert"
            >
              Please enter your birthday first.
            </p>
            <p class="elite-pro-birthday-field__note">
              We use this only to send your birthday gift.
            </p>
          </div>

          {%- if elite_in_cart -%}
            <div class="elite-pro-in-cart-banner" role="status">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Elite Pro is already in your cart (maximum 1 membership per order).</span>
            </div>
          {%- endif -%}

          <style>
            .elite-pro-birthday-field {
              width: 100%;
              margin-block-end: clamp(1rem, 1.8vw, 1.25rem);
            }
            .elite-pro-birthday-field__label {
              display: block;
              font-size: clamp(0.8125rem, 1.2vw, 0.875rem);
              font-weight: 600;
              color: var(--color-foreground, #111827);
              margin-block-end: 0.4rem;
              letter-spacing: 0.01em;
            }
            .elite-pro-birthday-field__required {
              color: #e11d48;
              margin-left: 0.2rem;
            }
            .elite-pro-birthday-field__input-wrapper {
              position: relative;
              width: 100%;
            }
            .elite-pro-birthday-field__input {
              width: 100%;
              height: 48px;
              padding: 0 1rem;
              font-size: clamp(0.875rem, 1.2vw, 0.9375rem);
              font-family: inherit;
              color: var(--color-foreground, #111827);
              background-color: var(--color-background, #ffffff);
              border: 1px solid rgba(var(--color-foreground-rgb, 17, 24, 39), 0.2);
              border-radius: var(--button-border-radius, 8px);
              box-sizing: border-box;
              outline: none;
              transition: border-color 0.2s ease, box-shadow 0.2s ease;
            }
            .elite-pro-birthday-field__input:focus {
              border-color: #6b0f46;
              box-shadow: 0 0 0 1px #6b0f46;
            }
            .elite-pro-birthday-field__input.is-invalid {
              border-color: #dc2626 !important;
              box-shadow: 0 0 0 1px #dc2626 !important;
            }
            .elite-pro-birthday-field__input:disabled {
              background-color: rgba(var(--color-foreground-rgb, 17, 24, 39), 0.05);
              cursor: not-allowed;
              opacity: 0.7;
            }
            .elite-pro-birthday-field__note {
              margin: 0.35rem 0 0;
              font-size: 0.75rem;
              color: rgba(var(--color-foreground-rgb, 17, 24, 39), 0.65);
              line-height: 1.4;
            }
            .elite-pro-in-cart-banner {
              width: 100%;
              padding: 0.75rem 1rem;
              margin-block-end: 1rem;
              background: #fdf2f8;
              border: 1px solid #f472b6;
              border-radius: var(--button-border-radius, 8px);
              color: #831843;
              font-size: 0.875rem;
              font-weight: 500;
              display: flex;
              align-items: center;
              gap: 0.5rem;
            }
            .elite-pro-in-cart-banner svg {
              flex-shrink: 0;
              color: #db2777;
            }
          </style>
        {%- endif -%}
        <div
          class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
          style="{% render 'spacing-style', settings: block_settings %}"
          ref="productFormButtons"
        >
          {%- unless block_settings.gift_card_form and product.gift_card? -%}
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">
                {{- 'icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
          {%- endunless -%}

          {%- liquid
            assign has_quantity_rules = false
            if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
              assign has_quantity_rules = true
            endif
          -%}

          {%- if has_quantity_rules -%}
            {%- assign cart_quantity = cart | item_count_for_variant: variant.id -%}
            <div
              class="quantity-label"
              ref="quantityLabel"
            >
              {{ 'products.product.quantity' | t }}
              <span
                class="quantity-label__cart-count{% if cart_quantity == 0 %} hidden{% endif %}"
                ref="quantityLabelCartCount"
                >({{ cart_quantity }}
                {{ 'products.product.in_cart' | t }})</span
              >
            </div>
          {%- endif -%}

          {%- unless is_elite_pro -%}
            {% content_for 'block', type: 'quantity', id: 'quantity' %}
          {%- endunless -%}

          {%- if has_quantity_rules -%}
            <div
              class="quantity-rules"
              ref="quantityRules"
            >
              {%- if variant.quantity_rule.increment > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_increments' | t: increment: variant.quantity_rule.increment }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.min > 1 -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_minimum' | t: minimum: variant.quantity_rule.min }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.max != null -%}
                <span class="quantity-rules__item">
                  {{ 'products.product.quantity_maximum' | t: maximum: variant.quantity_rule.max }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if product.quantity_price_breaks_configured? and variant.quantity_price_breaks.size > 0 -%}
            {%- liquid
              assign use_currency = settings.currency_code_enabled_product_pages
            -%}
            <volume-pricing
              class="volume-pricing"
              data-section-id="{{ section.id }}"
              ref="volumePricing"
            >
              <span class="volume-pricing__title">{{ 'content.volume_pricing' | t }}</span>
              <div class="volume-pricing__table">
                <div class="volume-pricing__row volume-pricing__row--even">
                  <span>{{ variant.quantity_rule.min }}+</span>
                  <span>
                    {%- if use_currency -%}
                      {{- variant.price | money_with_currency | strip -}}
                    {%- else -%}
                      {{- variant.price | money | strip -}}
                    {%- endif -%}
                    /{{ 'content.each_abbreviation' | t -}}
                  </span>
                </div>
                {%- for price_break in variant.quantity_price_breaks limit: 2 -%}
                  {%- liquid
                    assign row_index = forloop.index
                    if row_index == 1
                      assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                    else
                      assign row_class = 'volume-pricing__row volume-pricing__row--even'
                    endif
                  -%}
                  <div class="{{ row_class }}">
                    <span>{{ price_break.minimum_quantity }}+</span>
                    <span>
                      {%- if use_currency -%}
                        {{- price_break.price | money_with_currency | strip -}}
                      {%- else -%}
                        {{- price_break.price | money | strip -}}
                      {%- endif -%}
                      /{{ 'content.each_abbreviation' | t -}}
                    </span>
                  </div>
                {%- endfor -%}

                {%- if variant.quantity_price_breaks.size > 2 -%}
                  <div class="volume-pricing__collapsible-wrapper">
                    {%- for price_break in variant.quantity_price_breaks offset: 2 -%}
                      {%- liquid
                        assign collapsed_index = forloop.index
                        assign total_index = collapsed_index | plus: 2
                        assign modulo_result = total_index | modulo: 2
                        if modulo_result == 1
                          assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                        else
                          assign row_class = 'volume-pricing__row volume-pricing__row--even'
                        endif
                      -%}
                      <div class="{{ row_class }}">
                        <span>{{ price_break.minimum_quantity }}+</span>
                        <span>
                          {%- if use_currency -%}
                            {{- price_break.price | money_with_currency | strip -}}
                          {%- else -%}
                            {{- price_break.price | money | strip -}}
                          {%- endif -%}
                          /{{ 'content.each_abbreviation' | t -}}
                        </span>
                      </div>
                    {%- endfor -%}
                  </div>

                  <button
                    type="button"
                    class="volume-pricing__toggle button-unstyled"
                    ref="volumePricingToggle"
                    on:click="/toggleExpanded"
                  >
                    <span class="volume-pricing__toggle-text">
                      <span class="volume-pricing__show-more">+ {{ 'actions.show_more' | t }}</span>
                      <span class="volume-pricing__show-less">- {{ 'actions.show_less' | t }}</span>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            </volume-pricing>
          {%- endif -%}
          {%- liquid
            assign lame_op_actions_row = false
            if lame_our_products_active and product != blank
              assign lame_op_actions_row = true
            endif
          -%}

          {%- if lame_op_actions_row -%}
            <div class="lame-op-card__actions">
          {%- endif -%}

          {% content_for 'block',
            type: 'add-to-cart',
            id: 'add-to-cart',
            can_add_to_cart: can_add_to_cart,
            add_to_cart_text: add_to_cart_text
          %}

          {%- if settings.lame_enable_wishlist
            and section.settings.show_wishlist
            and product != blank
            and lame_our_products_active
          -%}
            {% render 'lame-our-products-wishlist-btn', product: product %}
          {%- endif -%}

          {%- if lame_op_actions_row -%}
            </div>
          {%- endif -%}

          {%- if is_elite_pro -%}
            <div class="elite-pro-buynow-guard" style="position: relative; width: 100%;">
              {% content_for 'block',
                type: 'accelerated-checkout',
                id: 'accelerated-checkout',
                can_add_to_cart: true,
                form_obj: form
              %}
              <button
                type="button"
                class="elite-pro-buynow-guard__overlay"
                aria-label="Enter your birthday first"
                style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 10; background: transparent; border: 0; cursor: pointer; display: block;"
              ></button>
            </div>
            <p class="elite-pro-buynow-guard__msg" style="margin: 6px 0 0; font-size: 13px; font-weight: 600; color: #dc2626; display: none;">
              Please enter your birthday first.
            </p>
          {%- else -%}
            {% content_for 'block',
              type: 'accelerated-checkout',
              id: 'accelerated-checkout',
              can_add_to_cart: can_add_to_cart,
              form_obj: form
            %}
          {%- endif -%}
        </div>
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          </span>
        {%- endif -%}
      {%- if is_elite_pro -%}
          <script>
            (function() {
              function initEliteProGuard() {
                var form = document.getElementById('{{ product_form_id }}') ||
                           (document.currentScript && document.currentScript.closest('form')) ||
                           document.querySelector('product-form-component[data-product-id="{{ product.id }}"] form');
                if (!form) return;

                var dateInput = form.querySelector('input[name="properties[Birthday]"]');
                var birthdayError = form.querySelector('.elite-pro-birthday-error');
                var overlay = form.querySelector('.elite-pro-buynow-guard__overlay');
                var buyNowMsg = form.querySelector('.elite-pro-buynow-guard__msg');
                var atcBtn = form.querySelector('button[name="add"], .add-to-cart-button');
                var inCart = {{ elite_in_cart | json }};

                function setAtcText(text) {
                  if (!atcBtn) return;
                  var textSpan = atcBtn.querySelector('.add-to-cart-text__content span span') ||
                                 atcBtn.querySelector('.add-to-cart-text__content') ||
                                 atcBtn.querySelector('.add-to-cart-text');
                  if (textSpan) {
                    textSpan.textContent = text;
                  }
                }

                function hasValidBirthday() {
                  return Boolean(dateInput && dateInput.value && dateInput.value.trim().length > 0);
                }

                function showBirthdayError() {
                  if (birthdayError) birthdayError.style.display = 'block';
                  if (buyNowMsg) buyNowMsg.style.display = 'block';
                  if (dateInput) {
                    dateInput.classList.add('is-invalid');
                    dateInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    dateInput.focus();
                    if (typeof dateInput.reportValidity === 'function') {
                      dateInput.reportValidity();
                    }
                  }
                }

                function clearBirthdayError() {
                  if (birthdayError) birthdayError.style.display = 'none';
                  if (buyNowMsg) buyNowMsg.style.display = 'none';
                  if (dateInput) {
                    dateInput.classList.remove('is-invalid');
                  }
                }

                function updateUI(cartHasElite) {
                  if (typeof cartHasElite === 'boolean') {
                    inCart = cartHasElite;
                  }

                  var banner = form.querySelector('.elite-pro-in-cart-banner');
                  if (inCart) {
                    if (dateInput) dateInput.disabled = true;
                    if (atcBtn) {
                      atcBtn.disabled = true;
                      atcBtn.setAttribute('aria-disabled', 'true');
                      setAtcText('Already in cart');
                    }
                    if (overlay) {
                      overlay.style.display = 'block';
                      overlay.style.cursor = 'not-allowed';
                      overlay.setAttribute('aria-label', 'Already in cart');
                    }
                    clearBirthdayError();
                    if (banner) banner.style.display = 'flex';
                  } else {
                    if (dateInput) dateInput.disabled = false;
                    if (banner) banner.style.display = 'none';

                    if (atcBtn) {
                      atcBtn.disabled = false;
                      atcBtn.removeAttribute('aria-disabled');
                      setAtcText('Add to cart');
                    }

                    if (hasValidBirthday()) {
                      if (overlay) overlay.style.display = 'none';
                      clearBirthdayError();
                    } else {
                      if (overlay) {
                        overlay.style.display = 'block';
                        overlay.style.cursor = 'pointer';
                        overlay.setAttribute('aria-label', 'Please enter your birthday first');
                      }
                    }
                  }
                }

                if (dateInput) {
                  function onDateInput() {
                    if (hasValidBirthday()) {
                      clearBirthdayError();
                      if (overlay && !inCart) overlay.style.display = 'none';
                    } else {
                      if (overlay && !inCart) overlay.style.display = 'block';
                    }
                  }
                  dateInput.addEventListener('input', onDateInput);
                  dateInput.addEventListener('change', onDateInput);
                }

                if (overlay) {
                  overlay.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (inCart) return;
                    showBirthdayError();
                  });
                }

                function interceptAtc(e) {
                  if (inCart) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                  }
                  if (!hasValidBirthday()) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    showBirthdayError();
                    return false;
                  }
                }

                if (atcBtn) {
                  atcBtn.addEventListener('click', interceptAtc, true);
                  atcBtn.addEventListener('pointerdown', function(e) {
                    if (!inCart && !hasValidBirthday()) {
                      e.stopPropagation();
                    }
                  }, true);
                }

                // Global capture on window ensures submit is stopped before Horizon document listener
                function onGlobalSubmit(e) {
                  var target = e.target;
                  if (target === form || (form && form.contains(target))) {
                    if (inCart) {
                      e.preventDefault();
                      e.stopImmediatePropagation();
                      return false;
                    }
                    if (!hasValidBirthday()) {
                      e.preventDefault();
                      e.stopImmediatePropagation();
                      showBirthdayError();
                      return false;
                    }
                  }
                }
                window.addEventListener('submit', onGlobalSubmit, true);

                // Global capture on click blocks ATC / sticky ATC when birthday is missing
                function onGlobalClick(e) {
                  var target = e.target;
                  if (!target) return;
                  var btn = target.closest('button[name="add"], .add-to-cart-button, .sticky-add-to-cart__button');
                  if (btn && (form.contains(btn) || btn.closest('sticky-add-to-cart'))) {
                    if (inCart) {
                      e.preventDefault();
                      e.stopImmediatePropagation();
                      return false;
                    }
                    if (!hasValidBirthday()) {
                      e.preventDefault();
                      e.stopImmediatePropagation();
                      showBirthdayError();
                      return false;
                    }
                  }
                }
                window.addEventListener('click', onGlobalClick, true);

                function checkCartStatus() {
                  fetch('/cart.js', { headers: { Accept: 'application/json' } })
                    .then(function(res) { return res.json(); })
                    .then(function(cart) {
                      var found = false;
                      if (cart && Array.isArray(cart.items)) {
                        found = cart.items.some(function(item) {
                          var h = (item.handle || '').toLowerCase();
                          var t = (item.product_title || item.title || '').toLowerCase();
                          return h === 'elite-pro-6-months' || t.indexOf('elite pro') !== -1;
                        });
                      }
                      updateUI(found);
                    })
                    .catch(function(err) {
                      console.error('Error checking cart for Elite Pro:', err);
                    });
                }

                updateUI(inCart);
                checkCartStatus();

                document.addEventListener('cart:update', checkCartStatus);
                document.addEventListener('cart:add', checkCartStatus);
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initEliteProGuard);
              } else {
                initEliteProGuard();
              }
            })();
          </script>
        {%- endif -%}
      {%- endform -%}
    </product-form-component>
  {%- else -%}
    <div class="product-form-buttons">
      <button
        type="submit"
        name="add"
        class="button"
        disabled
      >
        {{ 'blocks.sold_out' | t }}
      </button>
    </div>
  {%- endif -%}
</span>

{% if block_settings.show_pickup_availability and lame_our_products_active == false %}
  <script
    src="{{ 'local-pickup.js' | asset_url }}"
    type="module"
  ></script>

  {%- assign pick_up_availabilities = closest.product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <local-pickup
    class="spacing-style product__pickup-availabilities"
    {% if pick_up_availabilities.size == 0 %}
      hidden
    {% endif %}
    data-section-id="{{ section.id }}"
    data-product-url="{{ closest.product.url }}"
    data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}"
    style="{% render 'spacing-style', settings: block_settings %}"
    ref="localPickupButton"
  >
    {% if can_add_to_cart %}
      <dialog-component>
        <div class="pickup-availability__row">
          <div class="pickup-availability__column">
            <span class="svg-wrapper">
              {% if pick_up_availabilities.first.available %}
                {{- 'icon-available.svg' | inline_asset_content -}}
              {% else %}
                {{- 'icon-unavailable.svg' | inline_asset_content -}}
              {% endif %}
            </span>
          </div>
          <div class="pickup-availability__column">
            {% if pick_up_availabilities.first.available %}
              <p class="pickup-location__text-sm">
                {{ 'content.pickup_available_at_html' | t: location: pick_up_availabilities.first.location.name }}
              </p>
              <p class="pickup-location__text-xs">
                {{ 'content.pickup_ready_in' | t: pickup_time: pick_up_availabilities.first.pick_up_time }}
              </p>
            {% else %}
              <p class="pickup-location__text-sm">
                {{ 'content.pickup_not_available' | t }}
              </p>
            {% endif %}
            <button
              on:click="/showDialog"
              class="button-unstyled pickup-location__button"
            >
              {{ 'actions.view_store_information' | t }}
            </button>
          </div>
        </div>
        <dialog
          ref="dialog"
          class="dialog-modal dialog-drawer pickup-location__dialog color-{{ settings.drawer_color_scheme }}"
          scroll-lock
          aria-labelledby="pickup-dialog-heading"
          data-testid="pickup-location-dialog"
        >
          <h2
            id="pickup-dialog-heading"
            class="visually-hidden"
          >
            {{ 'actions.view_store_information' | t }}
          </h2>
          <div class="pickup-availability__dialog-row pickup-availability__header-container">
            <div class="pickup-availability__column">
              <h4 class="pickup-location__h4">{{ closest.product.title }}</h4>
              {% unless closest.product.has_only_default_variant %}
                <p class="pickup-location__text-sm">
                  {{ closest.product.selected_or_first_available_variant.title }}
                </p>
              {% endunless %}
            </div>
            <button
              ref="closeButton"
              on:click="/closeDialog"
              class="button button-unstyled close-button pickup-location__close-button"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
          {% for pick_up_availability in pick_up_availabilities %}
            <div class="pickup-location__wrapper">
              <p class="pickup-location__text-bold">{{ pick_up_availability.location.name }}</p>
              <div class="pickup-location__address-wrapper">
                <span class="pickup-location__availability-wrapper">
                  {% if pick_up_availability.available %}
                    {{- 'icon-available.svg' | inline_asset_content -}}
                    {% assign pickup_time = pick_up_availability.pick_up_time | downcase %}
                    {{ 'content.pickup_available_in' | t: pickup_time: pickup_time }}
                  {% else %}
                    {{- 'icon-unavailable.svg' | inline_asset_content -}}
                    {{ 'content.pickup_not_available' | t }}
                  {% endif %}
                </span>
                <address class="pickup-location__address">
                  {{ pick_up_availability.location.address | format_address }}
                  {{ pick_up_availability.location.address.phone }}
                </address>
              </div>
            </div>
          {% endfor %}
        </dialog>
      </dialog-component>
    {% endif %}
  </local-pickup>
{% endif %}

