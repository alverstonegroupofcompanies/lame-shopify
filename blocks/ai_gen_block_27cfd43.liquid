{% doc %}
  @prompt
    add a section tat keep loops with offers and sales for cosmetics but shoulnt overflow outside must be inside the view area
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cosmetics-offers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding }}px 0;
  }

  .ai-cosmetics-offers__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-cosmetics-offers__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    animation: ai-cosmetics-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    will-change: transform;
  }

  .ai-cosmetics-offers__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-cosmetics-offers__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: {{ block.settings.item_padding }}px {{ block.settings.item_padding | times: 1.5 }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    white-space: nowrap;
  }

  .ai-cosmetics-offers__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-cosmetics-offers__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: {{ block.settings.icon_color }};
  }

  .ai-cosmetics-offers__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
  }

  .ai-cosmetics-offers__highlight-{{ ai_gen_id }} {
    color: {{ block.settings.highlight_color }};
    font-weight: 700;
  }

  @keyframes ai-cosmetics-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-cosmetics-offers-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-cosmetics-offers__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }

    .ai-cosmetics-offers__icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<cosmetics-offers-{{ ai_gen_id }} class="ai-cosmetics-offers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-cosmetics-offers__wrapper-{{ ai_gen_id }}">
    <div class="ai-cosmetics-offers__track-{{ ai_gen_id }}">
      {% liquid
        assign offers = ''
        if block.settings.offer_1 != blank
          assign offers = offers | append: block.settings.offer_1 | append: '||'
        endif
        if block.settings.offer_2 != blank
          assign offers = offers | append: block.settings.offer_2 | append: '||'
        endif
        if block.settings.offer_3 != blank
          assign offers = offers | append: block.settings.offer_3 | append: '||'
        endif
        if block.settings.offer_4 != blank
