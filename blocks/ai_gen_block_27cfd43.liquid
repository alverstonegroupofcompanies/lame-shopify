    },
    {
      "type": "richtext",
      "id": "offer_5",
      "label": "Offer 5",
      "default": "<p><strong>Free shipping</strong> on online orders above ₹999</p>"
    },
    {
      "type": "richtext",
      "id": "offer_6",
      "label": "Offer 6",
      "default": "<p>We're just getting started — <strong>fresh deals every week</strong></p>"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
