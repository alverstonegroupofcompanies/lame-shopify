<script>
  (function() {
    class CosmeticsOffers{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-cosmetics-offers__track-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        if (this.track) {
          this.track.setAttribute('role', 'marquee');
          this.track.setAttribute('aria-live', 'off');
        }
      }
    }

    customElements.define('cosmetics-offers-{{ ai_gen_id }}', CosmeticsOffers{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
