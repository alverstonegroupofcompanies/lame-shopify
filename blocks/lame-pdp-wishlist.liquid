{% liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign show_wishlist = false
  if settings.lame_enable_wishlist and product != blank
    assign show_wishlist = true
  endif

  if show_wishlist
    assign wl_image = product.featured_image | image_url: width: 600
    if product.selected_or_first_available_variant.featured_image
      assign wl_image = product.selected_or_first_available_variant.featured_image | image_url: width: 600
    endif
    assign wl_price = product.selected_or_first_available_variant.price | money
  endif
%}

{% if show_wishlist %}
  <div
    class="pdp-wishlist-row"
    {{ block.shopify_attributes }}
  >
    <button
      type="button"
      class="lame-wishlist-toggle pdp-wishlist-btn"
      aria-label="{{ 'lame_wishlist.toggle' | t }}"
      aria-pressed="false"
      data-lame-wishlist-toggle
      data-product-id="{{ product.id }}"
      data-product-handle="{{ product.handle }}"
      data-product-url="{{ product.url }}"
      data-product-title="{{ product.title | escape }}"
      data-product-image="{{ wl_image }}"
      data-product-price="{{ wl_price | escape }}"
    >
      <span class="lame-wishlist-toggle__icon" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" focusable="false">
          <path
            class="lame-wishlist-toggle__outline"
            d="M10 5.2393L8.5149 3.77392C6.79996 2.08174 4.01945 2.08174 2.30451 3.77392C0.589562 5.4661 0.589563 8.2097 2.30451 9.90188L10 17.4952L17.6955 9.90188C19.4104 8.2097 19.4104 5.4661 17.6955 3.77392C15.9805 2.08174 13.2 2.08174 11.4851 3.77392L10 5.2393ZM10.765 3.06343C12.8777 0.978857 16.3029 0.978856 18.4155 3.06343C20.5282 5.148 20.5282 8.52779 18.4155 10.6124L10.72 18.2057C10.3224 18.5981 9.67763 18.5981 9.27996 18.2057L1.58446 10.6124C-0.528154 8.52779 -0.528154 5.14801 1.58446 3.06343C3.69708 0.978859 7.12233 0.978858 9.23495 3.06343L10 3.81832L10.765 3.06343Z"
            fill-rule="evenodd"
            stroke="currentColor"
            stroke-width="1.35"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span>{{ 'lame_wishlist.toggle' | t }}</span>
    </button>
  </div>
{% endif %}

{% schema %}
{
  "name": "Wishlist button",
  "tag": null,
  "settings": []
}
{% endschema %}
