<div class="lame-pdp-delivery" {{ block.shopify_attributes }}>
  <div class="lame-pdp-delivery__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
      <path d="M3 7h11v8H3V7Z" stroke="currentColor" stroke-width="1.35"/>
      <path d="M14 10h4l3 3v2h-7v-5Z" stroke="currentColor" stroke-width="1.35"/>
      <circle cx="7" cy="17" r="1.75" stroke="currentColor" stroke-width="1.35"/>
      <circle cx="17" cy="17" r="1.75" stroke="currentColor" stroke-width="1.35"/>
    </svg>
  </div>
  <div class="lame-pdp-delivery__copy">
    {% if block.settings.heading != blank %}
      <p class="lame-pdp-delivery__title">{{ block.settings.heading | escape }}</p>
    {% endif %}
    {% if block.settings.message != blank %}
      <p class="lame-pdp-delivery__text">{{ block.settings.message | escape }}</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Delivery note",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "Fast, friendly delivery"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Most orders arrive in 2–4 business days across India. Free shipping on orders above ₹999 — we’ll keep you updated every step of the way."
    }
  ],
  "presets": [
    {
      "name": "Delivery note",
      "category": "Product"
    }
  ]
}
{% endschema %}
