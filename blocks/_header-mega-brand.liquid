{% comment %}
  Theme block for Brands Mega Menu brand item (logo, title, link, and category tab).
  Managed via Shopify Theme Editor under Header -> Header Menu.
{% endcomment %}

{% schema %}
{
  "name": "Brand (Mega Menu)",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Dove",
      "info": "Display name of the brand"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Brand Logo Image",
      "info": "Upload custom logo image (PNG/SVG/JPG). If left empty, the built-in logo SVG is used."
    },
    {
      "type": "url",
      "id": "brand_url",
      "label": "Brand Page Link",
      "info": "Custom link. If left blank, automatically directs to /collections/all?filter.p.vendor=[Brand Name]"
    },
    {
      "type": "select",
      "id": "tab",
      "label": "Category Tab",
      "options": [
        {
          "value": "popular",
          "label": "Popular"
        },
        {
          "value": "luxe",
          "label": "Luxe"
        },
        {
          "value": "exclusive",
          "label": "Only at Lamstone"
        },
        {
          "value": "new",
          "label": "New Launches"
        }
      ],
      "default": "popular"
    },
    {
      "type": "checkbox",
      "id": "show_in_sidebar",
      "label": "Show in TOP BRANDS list",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_in_grid",
      "label": "Show in Logo Grid",
      "default": true
    }
  ]
}
{% endschema %}
