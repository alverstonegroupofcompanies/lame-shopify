{% liquid
  assign is_elite_pro = false
  if closest.product != blank
    assign p_handle_down = closest.product.handle | downcase
    assign p_title_down = closest.product.title | downcase
    if p_handle_down == 'elite-pro-6-months' or p_title_down contains 'elite pro'
      assign is_elite_pro = true
    endif
  endif
%}

{%- if is_elite_pro -%}
  <input type="hidden" name="quantity" value="1">
{%- else -%}
  {% render 'quantity-selector', product: closest.product %}
{%- endif -%}

{% schema %}
{
  "name": "t:names.quantity",
  "tag": null
}
{% endschema %}
