{% doc %}
  @prompt
    Hero Banner, full width, image-only slides, arrow navigation only. Image required.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{%- liquid
  assign slide_count = 0
  if block.settings.image != blank
    assign slide_count = slide_count | plus: 1
  endif
  if block.settings.image_2 != blank
    assign slide_count = slide_count | plus: 1
  endif
  if block.settings.image_3 != blank
    assign slide_count = slide_count | plus: 1
  endif
  if block.settings.image_4 != blank
    assign slide_count = slide_count | plus: 1
  endif

  assign show_arrows = false
  if slide_count > 1
    assign show_arrows = true
  endif

  assign slideshow_class = 'ai-hero-banner__carousel-' | append: ai_gen_id
  if slide_count == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
-%}

{% style %}
  .ai-hero-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    --ai-hero-min-height: clamp(280px, 52vh, 720px);
  }

  .ai-hero-banner-{{ ai_gen_id }} .slideshow-section {
    width: 100%;
    overflow: hidden;
  }

  .ai-hero-banner-{{ ai_gen_id }} slideshow-slides {
    min-height: var(--ai-hero-min-height);
  }

  .ai-hero-banner-{{ ai_gen_id }} slideshow-slide {
    width: 100%;
    flex: 0 0 100%;
  }

  .ai-hero-banner-{{ ai_gen_id }} .slide__image-container {
    display: flex;
    width: 100%;
    min-height: var(--ai-hero-min-height);
    overflow: hidden;
    position: relative;
  }

  .ai-hero-banner-{{ ai_gen_id }} .slide__image,
  .ai-hero-banner-{{ ai_gen_id }} .slide__image-container img {
    width: 100%;
    height: 100%;
    min-height: var(--ai-hero-min-height);
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  .ai-hero-banner-{{ ai_gen_id }} slideshow-arrows {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    z-index: 2;
    padding-inline: clamp(0.35rem, 2vw, 1rem);
  }

  .ai-hero-banner-{{ ai_gen_id }} slideshow-arrows .slideshow-control {
    pointer-events: auto;
    background: rgb(255 255 255 / 0.88);
    border: 1px solid rgb(0 0 0 / 0.08);
    color: #111;
  }

  .ai-hero-banner-placeholder-{{ ai_gen_id }} {
    min-height: var(--ai-hero-min-height);
    display: grid;
    place-items: center;
    padding: 2rem;
    text-align: center;
    background: #f4f4f4;
    color: #666;
    font-size: 0.9rem;
  }
{% endstyle %}

<div
  class="ai-hero-banner-{{ ai_gen_id }}"
  data-testid="hero-slideshow"
  {{ block.shopify_attributes }}
>
  {%- if slide_count == 0 -%}
    <div class="ai-hero-banner-placeholder-{{ ai_gen_id }}">
      {%- if request.design_mode -%}
        <p>Banner image is required. Upload image 1, then add image 2+ for arrow navigation.</p>
      {%- endif -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {%- else -%}
    {% capture slides %}
      {%- assign slide_index = 0 -%}
      {%- for i in (1..4) -%}
        {%- liquid
          assign slide_image = block.settings.image
          if i == 2
            assign slide_image = block.settings.image_2
          elsif i == 3
            assign slide_image = block.settings.image_3
          elsif i == 4
            assign slide_image = block.settings.image_4
          endif
        -%}
        {%- if slide_image == blank -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign slide_loading = 'lazy'
          assign slide_fetchpriority = 'auto'
          if slide_index == 0
            assign slide_loading = 'eager'
            assign slide_fetchpriority = 'high'
          endif
        -%}
        {%- capture slide_children -%}
          <div class="slide__image-container">
            {{
              slide_image
              | image_url: width: 3840
              | image_tag:
                class: 'slide__image',
                loading: slide_loading,
                fetchpriority: slide_fetchpriority,
                widths: '832, 1200, 1600, 1920, 2560, 3840',
                sizes: '100vw',
                alt: slide_image.alt | escape
            }}
          </div>
        {%- endcapture -%}
        {% render 'slideshow-slide',
          index: slide_index,
          children: slide_children,
          slide_size: 'large',
          navigate_to_slide: false
        %}
        {%- assign slide_index = slide_index | plus: 1 -%}
      {%- endfor -%}
    {% endcapture %}

    <div class="slideshow-section">
      {% render 'slideshow',
        class: slideshow_class,
        slides: slides,
        slide_count: slide_count,
        slide_size: 'large',
        show_arrows: show_arrows,
        icon_style: 'arrows_large',
        icon_shape: 'circle',
        arrows_position: 'center',
        autoplay: block.settings.autoplay,
        autoplay_speed: block.settings.autoplay_speed
      %}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero banner",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image 1",
      "info": "Required"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2",
      "info": "Add for arrow navigation"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}

