{% comment %}
  Settings-only nested theme block for header menu link label/icon overrides.
  Looked up from the parent menu via lame-header-menu-link-content.
{% endcomment %}

{% schema %}
{
  "name": "Menu link",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Match a link from your navigation menu by its title or handle (e.g. Shop, home, contact)."
    },
    {
      "type": "text",
      "id": "link_match",
      "label": "Link title or handle"
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Custom label",
      "info": "Leave blank to use the navigation link title."
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    }
  ]
}
{% endschema %}
